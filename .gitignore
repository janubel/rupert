# Dependencies
**/node_modules

# Secrets — never commit
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Build output
build/
dist/
!web/public/dist/
web/public/dist/*
!web/public/dist/.keep
legacy/build/
legacy/node_modules/
.turbo/

