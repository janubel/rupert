legacy/prisma/dev.sqlite
legacy/prisma/dev.sqlite-journal
web/storage/*.sqlite*
web/db/*.sqlite*

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Rails generated types
.react-router/
node_modules/.cache/
