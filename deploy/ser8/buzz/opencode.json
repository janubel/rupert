{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "model": "opencode/deepseek-v4-flash",
  "default_agent": "buzz",
  "agent": {
    "chat": {
      "mode": "primary",
      "description": "Text only. Every tool is denied; used by Ask Rupert and the text-only Buzz runner.",
      "permission": {
        "*": "deny"
      }
    },
    "buzz": {
      "mode": "primary",
      "description": "The @rupert agent in Buzz: replies with the buzz CLI, reads Rupert through the read-only report scripts, files reports through the intake script. Nothing else.",
      "permission": {
        "*": "deny",
        "bash": {
          "*": "deny",
          "buzz messages send *": "allow",
          "bin/rails runner scripts/quick_reports.rb": "allow",
          "bin/rails runner scripts/quick_reports.rb *": "allow",
          "bin/rails runner scripts/sales_report.rb": "allow",
          "bin/rails runner scripts/sales_report.rb *": "allow",
          "bin/rails runner scripts/feedback_intake.rb *": "allow",
          "*<*": "deny",
          "bin/rails runner scripts/feedback_intake.rb *<<*": "allow",
          "*>*": "deny",
          "*$*": "deny",
          "*<* /*": "deny",
          "*</*": "deny",
          "*<~*": "deny",
          "*<.*": "deny"
        }
      }
    }
  }
}
