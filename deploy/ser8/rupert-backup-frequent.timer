# SER8 (Incus container "rupert"): install next to rupert-backup-frequent.service, then:
#   systemctl daemon-reload && systemctl enable --now rupert-backup-frequent.timer
# Every 5 minutes, on the clock. The existing 6-hourly rupert-backup.timer and the in-app Drive backup are unchanged.
[Unit]
Description=Rupert frequent rolling database snapshot (every 5 minutes)

[Timer]
OnCalendar=*:0/5
AccuracySec=5s
Persistent=false

[Install]
WantedBy=timers.target
