# /etc/rupert-agent/agent.env (0644, no secrets). The secrets are in /etc/rupert-agent/secrets.env (0600 root):
#   BUZZ_PRIVATE_KEY=<64 hex>    the agent's Nostr key
#   RUPERT_MCP_TOKEN=rupert_...  scoped token from System -> API access
#   OPENCODE_API_KEY=...         the model key (Zen or Go)
BUZZ_RELAY_URL=wss://buzz-herbalhealers.rupertpos.com
RUPERT_MCP_URL=https://herbalhealers.rupertpos.com/mcp
OPENCODE_CONFIG=/etc/rupert-agent/opencode.json
XDG_CONFIG_HOME=/var/lib/rupert-agent/config
XDG_DATA_HOME=/var/lib/rupert-agent/data
XDG_CACHE_HOME=/var/lib/rupert-agent/cache
XDG_STATE_HOME=/var/lib/rupert-agent/state
# The model provider is reached through the allow-list proxy; the relay and Rupert go direct (static /etc/hosts entries).
HTTPS_PROXY=http://10.96.131.4:3128
HTTP_PROXY=http://10.96.131.4:3128
NO_PROXY=buzz-herbalhealers.rupertpos.com,herbalhealers.rupertpos.com,127.0.0.1,localhost
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
