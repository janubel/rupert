# SER8 (Incus container "rupert"): install to /etc/systemd/system/rupert-web.service and `systemctl enable --now rupert-web`.
# systemd reads /etc/rupert.env (root-only) before dropping to the rupert user. Same layout as rupert-jobs-ser8.service.
# The TLS proxy (Caddy on the host) forwards to port 3000; Puma binds to all container interfaces.
[Unit]
Description=Rupert web server (Puma)
After=network.target

[Service]
Type=simple
User=rupert
Group=rupert
WorkingDirectory=/opt/rupert/web
EnvironmentFile=/etc/rupert.env
Environment=RAILS_ENV=production
Environment=RAILS_LOG_TO_STDOUT=1
Environment=PORT=3000
Environment=PATH=/opt/rbenv/versions/4.0.6/bin:/opt/rbenv/shims:/opt/rbenv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/rbenv/versions/4.0.6/bin/bundle exec puma -C config/puma.rb
# Puma re-execs itself on SIGUSR2 for a near-zero-downtime restart (see docs/ops/release-process.md).
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
