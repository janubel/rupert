#!/usr/bin/env bash
# Runs on the SER8 host (user timer, every 15 minutes). Read-only: it never restarts or changes anything.
# Exits non-zero (so the unit shows up in `systemctl --user --failed`, like rupert-sync-watch) when:
#   - the rupert-core service does not answer, or its own health says "degraded" (a scheduled sync is overdue),
#   - the newest container backup, or the newest host copy of it, is older than MAX_BACKUP_AGE_MIN (default 420 = 6 h + margin),
#   - API requests in the last hour exceed BUDGET_WARN_PCT percent (default 80) of the hourly budget for a provider.
# The health call happens inside the container with a read-only token that never leaves it.
# Test it like rupert-sync-watch: MAX_BACKUP_AGE_MIN=0 or BUDGET_WARN_PCT=0 forces a failure.
set -uo pipefail
MAX_BACKUP_AGE_MIN="${MAX_BACKUP_AGE_MIN:-420}"
BUDGET_WARN_PCT="${BUDGET_WARN_PCT:-80}"
HOST_BACKUPS="${HOST_BACKUPS:-$HOME/rupert-core-backups}"

problems=()
add() { problems+=("$*"); }

SUMMARY=$(incus exec rupert-core -- python3 -I - <<'PY' 2>/dev/null
import json, time, urllib.request
try:
    tok = open("/root/.config/rupert-core/watch-token").read().strip()
    req = urllib.request.Request("http://127.0.0.1:8798/api/v1/health", headers={"Authorization": "Bearer " + tok})
    h = json.load(urllib.request.urlopen(req, timeout=10))
    b = json.load(open("/var/backups/rupert-core/status.json"))
    t = h["tenant"]
    print(json.dumps({"ok": True, "status": h["status"], "git_rev": h["git_rev"], "budget": t["hourly_budget"],
        "providers": {k: {"overdue": v["overdue"], "ok_age_s": v["last_ok_age_secs"], "last_hour": v["requests_last_hour"], "every": v["scheduled_every_secs"]} for k, v in t["providers"].items()},
        "backup_age_min": (int(time.time()) - b["created_epoch"]) // 60}))
except Exception as e:
    print(json.dumps({"ok": False, "error": str(e)[:200]}))
PY
)
if [ -z "$SUMMARY" ]; then add "cannot run the health check inside the rupert-core container (container down?)"; SUMMARY='{"ok": false}'; fi

# Turn the summary into checks. If this step fails for ANY reason, that is itself a problem: a monitor must never
# report success because it could not read its own inputs.
PARSED=$(python3 -I - "$SUMMARY" "$MAX_BACKUP_AGE_MIN" "$BUDGET_WARN_PCT" <<'PY'
import json, shlex, sys
s = json.loads(sys.argv[1]); maxage = int(sys.argv[2]); warn = int(sys.argv[3])
out = []
def add(m): out.append("add " + shlex.quote(m))
if not s.get("ok"):
    add("rupert-core health unavailable: " + str(s.get("error", "no answer")))
else:
    if s["status"] != "ok": add("rupert-core reports status " + s["status"])
    for p, v in s["providers"].items():
        if v["overdue"]: add(f"{p}: scheduled sync overdue (last good sync {v['ok_age_s']} s ago, every {v['every']} s)")
        if s["budget"] and v["last_hour"] * 100 > s["budget"] * warn: add(f"{p}: {v['last_hour']} requests in the last hour is over {warn}% of the budget {s['budget']}")
    if s["backup_age_min"] >= maxage: add(f"newest container backup is {s['backup_age_min']} min old (limit {maxage})")
    out.append("echo " + shlex.quote(f"ok: {s['status']} build {s['git_rev']}, backup {s['backup_age_min']} min old, requests last hour " + ", ".join(f"{p} {v['last_hour']}" for p, v in s['providers'].items()) + f" of {s['budget']}"))
out.append("HEALTH_SEEN=1")
print("\n".join(out))
PY
) || { add "could not interpret the health summary from the container"; PARSED=""; }
HEALTH_SEEN=0
eval "$PARSED"
[ "$HEALTH_SEEN" = 1 ] || add "no usable health data was obtained"

NEWEST=$(ls -d "$HOST_BACKUPS"/20*Z 2>/dev/null | tail -1)
if [ -z "$NEWEST" ]; then add "no host copy of any backup in $HOST_BACKUPS"; else
  STAMP=$(basename "$NEWEST"); EPOCH=$(date -u -d "${STAMP:0:4}-${STAMP:4:2}-${STAMP:6:2} ${STAMP:9:2}:${STAMP:11:2}:${STAMP:13:2}" +%s 2>/dev/null || echo 0)
  AGE=$(( ($(date +%s) - EPOCH) / 60 ))
  [ "$AGE" -ge "$MAX_BACKUP_AGE_MIN" ] && add "newest host copy $STAMP is $AGE min old (limit $MAX_BACKUP_AGE_MIN)"
  echo "host copy: $STAMP ($AGE min old)"
fi

if [ "${#problems[@]}" -gt 0 ]; then
  printf 'PROBLEM: %s\n' "${problems[@]}" >&2
  exit 1
fi
