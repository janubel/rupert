[Unit]
Description=Rupert core backup (consistent SQLite snapshots)
After=rupert-core.service

[Service]
Type=oneshot
User=rupertcore
Group=rupertcore
ExecStart=/usr/local/sbin/rupert-core-backup
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rupert-core /var/backups/rupert-core
PrivateTmp=true
ProtectHome=true
