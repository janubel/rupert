#!/usr/bin/python3 -I
"""Consistent backup of Rupert core state (central.db + one SQLite file per tenant).

Each database is copied with VACUUM INTO (a transactionally consistent snapshot taken while the service keeps
running), checked with PRAGMA integrity_check, gzip-compressed and recorded in MANIFEST.json together with its
SHA-256 and per-table row counts. The run directory is built under a .partial name and renamed only when
complete, so a half-written backup is never mistaken for a good one. Old runs are pruned.

The master key (RUPERT_MASTER_KEY) is deliberately NOT included: a backup alone cannot decrypt stored provider
credentials. Keep the key in a separate escrow.

Environment (defaults in brackets): RUPERT_DATA [/var/lib/rupert-core], RUPERT_BACKUP_DIR [/var/backups/rupert-core],
RUPERT_BACKUP_KEEP [32]. Run as the service user so file ownership never drifts.
"""
import datetime, gzip, hashlib, json, os, re, shutil, socket, sqlite3, sys, time

DATA = os.environ.get("RUPERT_DATA", "/var/lib/rupert-core")
OUT = os.environ.get("RUPERT_BACKUP_DIR", "/var/backups/rupert-core")
KEEP = int(os.environ.get("RUPERT_BACKUP_KEEP", "32"))
RUN_RE = re.compile(r"^\d{8}T\d{6}Z$")


def log(**kw):
    print(json.dumps({"ts": int(time.time()), "tag": "rupert-core-backup", **kw}), flush=True)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def table_counts(conn):
    names = [r[0] for r in conn.execute("select name from sqlite_master where type='table' and name not like 'sqlite_%' order by name")]
    return {n: conn.execute(f'select count(*) from "{n}"').fetchone()[0] for n in names}


def snapshot(src, dest_gz, work):
    snap = os.path.join(work, "snapshot.db")
    if os.path.exists(snap):
        os.remove(snap)
    c = sqlite3.connect(f"file:{src}?mode=rw", uri=True, timeout=60)
    try:
        c.execute("VACUUM INTO ?", (snap,))
    finally:
        c.close()
    s = sqlite3.connect(snap)
    try:
        verdict = s.execute("PRAGMA integrity_check").fetchone()[0]
        if verdict != "ok":
            raise RuntimeError(f"integrity_check failed for {src}: {verdict}")
        counts = table_counts(s)
    finally:
        s.close()
    with open(snap, "rb") as f, gzip.open(dest_gz, "wb", compresslevel=6) as g:
        shutil.copyfileobj(f, g)
    os.remove(snap)
    return counts


def main():
    os.umask(0o077)
    sources = [("central.db", os.path.join(DATA, "central.db"))]
    tdir = os.path.join(DATA, "tenants")
    if os.path.isdir(tdir):
        sources += [(f"tenants/{n}", os.path.join(tdir, n)) for n in sorted(os.listdir(tdir)) if n.endswith(".db")]
    if not os.path.exists(sources[0][1]):
        raise SystemExit(f"no central.db under {DATA}")
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    os.makedirs(OUT, mode=0o700, exist_ok=True)
    part = os.path.join(OUT, f".partial-{stamp}")
    shutil.rmtree(part, ignore_errors=True)
    os.makedirs(os.path.join(part, "tenants"))
    started = time.time()
    try:
        entries = []
        for rel, src in sources:
            gz = os.path.join(part, rel + ".gz")
            counts = snapshot(src, gz, part)
            entries.append({"file": rel + ".gz", "db": rel, "bytes": os.path.getsize(gz), "sha256": sha256(gz), "tables": counts})
        manifest = {"format": 1, "created": stamp, "host": socket.gethostname(), "source": DATA, "files": entries}
        with open(os.path.join(part, "MANIFEST.json"), "w") as f:
            json.dump(manifest, f, indent=1, sort_keys=True)
        final = os.path.join(OUT, stamp)
        os.rename(part, final)
    except BaseException:
        shutil.rmtree(part, ignore_errors=True)
        raise
    total = sum(e["bytes"] for e in entries)
    status = {"dir": stamp, "created_epoch": int(time.time()), "databases": len(entries), "bytes": total}
    tmp = os.path.join(OUT, ".status.tmp")
    with open(tmp, "w") as f:
        json.dump(status, f)
    os.rename(tmp, os.path.join(OUT, "status.json"))
    runs = sorted(d for d in os.listdir(OUT) if RUN_RE.match(d) and os.path.isdir(os.path.join(OUT, d)))
    pruned = runs[:-KEEP] if KEEP > 0 else []
    for d in pruned:
        shutil.rmtree(os.path.join(OUT, d), ignore_errors=True)
    log(event="backup-ok", dir=stamp, databases=len(entries), bytes=total, seconds=round(time.time() - started, 2), kept=len(runs) - len(pruned), pruned=len(pruned))


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:
        log(event="backup-failed", error=str(e)[:300])
        sys.exit(1)
