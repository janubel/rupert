<% content_for :title, "Sign in" %>
<div class="mx-auto max-w-sm pt-10">
  <div class="card card-pad">
    <div class="mb-6 text-center">
      <%= render "shared/rupert_face", size: 96, css_class: "mx-auto mb-3" %>
      <h1 class="font-display text-2xl text-ink">Rupert</h1>
      <p class="mt-1 text-sm text-mocha">Sign in to continue</p>
      <p class="mt-3 rounded-xl bg-haze px-3 py-2 text-left text-xs leading-relaxed text-mocha">
        <span class="font-semibold text-ink">First time here?</span>
        Sign in with Google if your company domain is enabled — you'll get a employee account automatically. Otherwise, ask your admin to grant you access.
      </p>
      <p class="mt-3 text-sm text-mocha"><%= link_to "Request a private company workspace", signup_path, class: "font-semibold text-olive hover:underline" %></p>
    </div>

    <% if GoogleOauthService.configured? %>
      <%= link_to google_auth_path, class: "btn-primary w-full justify-center", data: { turbo: false } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0">
          <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z"/>
          <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/>
          <path fill="currentColor" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z"/>
          <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z"/>
        </svg>
        Continue with Google
      <% end %>
      <div class="flex items-center gap-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-taupe">
        <span class="h-px flex-1 bg-fog"></span>
        or
        <span class="h-px flex-1 bg-fog"></span>
      </div>
    <% end %>

    <%= form_with url: login_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, "Email", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
        <%= f.email_field :email, autocomplete: "email", required: true, autofocus: true, class: "input" %>
      </div>
      <div>
        <%= f.label :password, "Password", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: "input" %>
      </div>
      <%= f.submit "Sign in", class: "btn-primary w-full justify-center" %>
    <% end %>
  </div>
</div>
