<% content_for :title, "Customer CRM" %>
<div class="space-y-6">
  <section>
    <h1 class="page-title">Customer CRM</h1>
    <p class="mt-1 text-sm text-mocha">Contacts, relationship history, and follow-ups.</p>
  </section>
  <section class="card card-pad max-w-2xl" role="alert">
    <h2 class="font-display text-lg text-ink">Your access level doesn't include customers</h2>
    <p class="mt-2 text-sm text-mocha">You're signed in as <strong><%= navigation_role_name(Current.user) %></strong>. Viewing customer records needs the <em>customers.read</em> permission, which store administrators, managers, cashiers and readers have by default.</p>
    <p class="mt-2 text-sm text-mocha">If you need it, ask a store administrator to update your access under Team → Permissions.</p>
    <%= link_to "Back to start", navigation_start_path, class: "btn-ghost mt-4" %>
  </section>
</div>
