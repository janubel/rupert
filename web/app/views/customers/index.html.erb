<% content_for :title, "Customer CRM" %>
<div class="space-y-6">
  <section class="flex items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Customer CRM</h1>
      <p class="mt-1 text-sm text-mocha">Contacts, relationship history, and follow-ups across your connected sources.</p>
    </div>
    <% if Current.user.can?("customers.write") && Current.user.can?("sync.write") %>
      <%= button_to "Sync customers now", sync_directory_customers_path, class: "btn-ghost btn-sm" %>
    <% end %>
    <% if Current.user.can?("customers.write") %>
      <%= link_to "Add customer", new_customer_path, class: "btn-primary" %>
    <% end %>
  </section>

  <%= render "shared/directory_sync_status", kind: "customers" %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="stat">
      <p class="stat-label">Customers</p>
      <p class="stat-value mt-1"><%= @pagy.count %></p>
      <p class="mt-1 text-xs text-taupe">native profiles · matching contact details do not merge identities</p>
    </div>
  </section>

  <section class="card card-pad">
    <h2 class="font-display text-lg">Follow-ups due <span class="pill-clay"><%= @due_count %></span></h2>
    <p class="text-xs text-taupe">Due today and overdue · <%= link_to 'Show due customers', customers_path(due: '1'), class: 'hover:underline' %></p>
    <% @due_follow_ups.each do |task| %>
      <p class="mt-2 text-sm"><%= link_to task.customer.name, customer_path(task.customer), class: 'font-semibold hover:underline' %> · <%= task.title %> · <%= task.due_on %> · <%= task.owner&.display_name || 'Unassigned' %></p>
    <% end %>
    <% if @due_count.zero? %><p class="mt-2 text-sm text-taupe">No follow-ups due.</p><% end %>
  </section>

  <%= search_form_for @q, url: customers_path, class: "flex flex-wrap items-center gap-3" do |f| %>
    <%= f.search_field :first_name_or_last_name_or_preferred_name_or_email_or_phone_cont, placeholder: "Search name, email, phone…", aria_label: "Search customers", class: "search w-64" %>
    <%= f.search_field :tags_cont, placeholder: 'Filter tags', aria_label: 'Filter tags', class: 'search w-40' %>
    <%= select_tag :status, options_for_select([['All relationships', '']] + Core::Customer::CRM_STATUSES.map { |v| [v.titleize, v] }, params[:status]), class: 'select w-auto', aria: { label: 'Relationship filter' } %>
    <%= select_tag :source, options_for_select([['All sources', '']] + Core::Customer::SOURCES.map { |v| [directory_label(v), v] }, params[:source]), class: 'select w-auto', aria: { label: 'Source filter' } %>
    <%= select_tag :owner, options_for_select([['All assignments', ''], ['Assigned to me', 'mine'], ['Unassigned', 'unassigned']], params[:owner]), class: 'select w-auto', aria: { label: 'Assignment filter' } %>
    <%= hidden_field_tag :due, '1' if params[:due] == '1' %>
    <%= f.submit "Search", class: "btn-ghost btn-sm" %>
    <%= link_to "Reset", customers_path, class: "text-xs font-semibold text-olive hover:underline" %>
  <% end %>

  <% if Current.user.can?('customers.write') %><%= link_to 'Export filtered contacts (CSV)', export_customers_path(request.query_parameters.except('page')), class: 'btn-ghost btn-sm', data: { turbo: false } %><% end %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Name</th>
            <th scope="col" class="th">Email</th>
            <th scope="col" class="th">Phone</th>
            <th scope="col" class="th">Source / relationship</th>
            <th scope="col" class="th text-right">Orders</th>
            <th scope="col" class="th text-right">Lifetime</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @customers.empty? %>
            <tr>
              <td colspan="6" class="empty-row">No customers yet — run a sync to import them.</td>
            </tr>
          <% end %>
          <% @customers.each do |customer| %>
            <tr class="hover:bg-cream">
              <td class="td font-medium text-ink"><%= link_to customer.name, customer_path(customer), class: "hover:text-olive hover:underline" %></td>
              <td class="td text-mocha"><%= customer.email.presence || "—" %></td>
              <td class="td text-mocha"><%= customer.phone.presence || "—" %></td>
              <td class="td"><span class="pill-taupe capitalize"><%= directory_label(customer.source) %></span><p class="mt-1 text-xs"><%= customer.crm_status.titleize %> · <%= customer.tags.presence || "No tags" %></p></td>
              <td class="td text-right text-mocha"><%= @order_counts[customer.id] || 0 %></td>
              <td class="td text-right font-medium text-ink"><%= customer_money(@lifetime_totals.select { |(id, _), _| id == customer.id }.to_h { |(_, currency), total| [currency, total] }) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="border-t border-fog px-5 py-3 text-xs text-taupe">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  </div>
</div>
