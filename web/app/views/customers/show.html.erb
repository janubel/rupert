<% content_for :title, @customer.name %>
<% can_write = Current.user.can?('customers.write') %>
<% quick = [] %>
<% quick << ['Call', "tel:#{@customer.phone}"] if @customer.phone.present? %>
<% quick << ['Email', "mailto:#{@customer.email}"] if @customer.email.present? %>
<% quick += [['Log interaction', '#log-interaction'], ['Schedule follow-up', '#schedule-follow-up']] if can_write %>
<div class="space-y-6">
  <%= page_header @customer.name, eyebrow: "Customer · #{directory_label(@customer.source)}" do %>
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Quick actions">
      <%= customer_status_pill(@customer) %>
      <%= customer_tag_pills(@customer) %>
      <%= page_menu(quick) %>
      <% if can_write %><%= link_to 'Edit', edit_customer_path(@customer), class: 'btn-primary' %><% end %>
    </div>
  <% end %>

  <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Customer summary">
    <div class="stat"><p class="stat-label">Orders</p><p class="stat-value mt-1"><%= @customer.orders.count %></p></div>
    <div class="stat"><p class="stat-label">Lifetime spend</p><p class="stat-value mt-1"><%= customer_money(@customer.lifetime_totals) %></p></div>
    <div class="stat"><p class="stat-label">Last order</p><p class="stat-value-sm mt-1"><%= @last_order_at ? l(@last_order_at, format: :short) : '—' %></p></div>
    <div class="stat">
      <p class="stat-label">Open follow-ups</p>
      <p class="stat-value mt-1"><%= @open_follow_up_count %></p>
      <% if @overdue_follow_up_count.positive? %><p class="mt-1 text-xs font-semibold text-rose"><%= @overdue_follow_up_count %> overdue</p><% end %>
    </div>
  </section>

  <section class="section-card" aria-label="Details">
    <dl class="facts">
      <div><dt>Email</dt><dd><%= @customer.email.presence || '—' %></dd></div>
      <div><dt>Phone</dt><dd><%= @customer.phone.presence || '—' %></dd></div>
      <div><dt>Assigned to</dt><dd><%= @customer.owner&.display_name || 'Unassigned' %></dd></div>
      <div><dt>Customer since</dt><dd><%= l(@customer.created_at.to_date, format: :long) %></dd></div>
      <div><dt>Source reference</dt><dd class="text-xs text-mocha"><%= directory_label(@customer.source) %> · <%= @customer.external_id %></dd></div>
      <div><dt>Directory status</dt><dd class="text-xs text-mocha"><%= customer_directory_status(@customer) %><% unless @customer.source == 'manual' %> · last full read <%= @customer.source_synced_at ? l(@customer.source_synced_at, format: :long) : 'never' %><% end %></dd></div>
    </dl>
  </section>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-1">
      <section class="section-card" aria-label="Notes">
        <%= section_heading 'Notes' do %>
          <% if can_write %><%= link_to 'Edit notes', edit_customer_path(@customer, anchor: 'customer_notes'), class: 'btn-ghost btn-sm' %><% end %>
        <% end %>
        <p class="whitespace-pre-wrap text-sm text-mocha"><%= @customer.notes.presence || 'No notes yet.' %></p>
      </section>

      <section class="section-card" aria-label="Follow-ups">
        <%= section_heading 'Follow-ups' %>
        <% if @follow_ups.empty? %><p class="text-sm text-taupe">Nothing scheduled.<%= ' Schedule the first follow-up below.' if can_write %></p><% end %>
        <ul class="divide-y divide-fog">
          <% @follow_ups.each do |task| %>
            <% state, pill = follow_up_state(task) %>
            <li class="py-3 text-sm">
              <p class="font-semibold <%= 'text-taupe line-through' if task.completed_at %>"><%= task.title %></p>
              <p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-taupe"><span class="<%= pill %>"><%= state %></span> <%= l(task.due_on, format: :long) %> · <%= task.owner&.display_name || 'Unassigned' %></p>
              <% if can_write %><%= button_to (task.completed_at ? 'Reopen' : 'Mark done'), customer_follow_up_path(@customer, task), method: :patch, params: { event: task.completed_at ? 'reopen' : 'complete' }, class: 'btn-ghost btn-sm mt-2', form: { 'aria-label': "#{task.completed_at ? 'Reopen' : 'Complete'} follow-up #{task.title}" } %><% end %>
            </li>
          <% end %>
        </ul>
        <%== pagy_nav(@follow_ups_pagy) if @follow_ups_pagy.pages > 1 %>
        <% if can_write %>
          <%= form_with url: customer_follow_ups_path(@customer), scope: :follow_up, id: 'schedule-follow-up', class: 'space-y-3 border-t border-fog pt-4' do |f| %>
            <%= section_heading 'Schedule a follow-up', level: :h3 %>
            <div><%= f.label :title, 'What needs doing?', class: 'field-label' %><%= f.text_field :title, required: true, maxlength: 500, class: 'input' %></div>
            <div><%= f.label :due_on, 'Due date', class: 'field-label' %><%= f.date_field :due_on, required: true, value: Date.current, class: 'input' %></div>
            <div><%= f.label :owner_id, 'Assigned to', class: 'field-label' %><%= f.select :owner_id, @owners.map { |u| [u.display_name, u.id] }, { include_blank: 'Unassigned', selected: @customer.owner_id || Current.user.id }, class: 'select w-full' %></div>
            <%= f.submit 'Save follow-up', class: 'btn-primary' %>
          <% end %>
        <% end %>
      </section>
    </div>

    <div class="space-y-4 lg:col-span-2">
      <section id="timeline" class="section-card" aria-label="Activity timeline">
        <%= section_heading 'Activity timeline', hint: 'Conversations and contact history, newest first.' %>
        <% if can_write %>
          <%= form_with url: customer_interactions_path(@customer), scope: :interaction, id: 'log-interaction', class: 'space-y-3 rounded-card bg-haze/60 p-4' do |f| %>
            <%= section_heading 'Log an interaction', level: :h3 %>
            <div class="grid gap-3 sm:grid-cols-4">
              <div class="sm:col-span-1"><%= f.label :kind, 'Type', class: 'field-label' %><%= f.select :kind, CustomerInteraction::KINDS.map { |k| [k.titleize, k] }, {}, class: 'select w-full' %></div>
              <div class="sm:col-span-3"><%= f.label :body, 'What happened?', class: 'field-label' %><%= f.text_area :body, required: true, maxlength: 10_000, rows: 3, class: 'input' %></div>
            </div>
            <%= f.submit 'Save interaction', class: 'btn-primary' %>
          <% end %>
        <% end %>
        <% if @interactions.empty? %><p class="text-sm text-taupe">No interactions recorded yet.<%= ' Log your first call, email or note above.' if can_write %></p><% end %>
        <ol class="space-y-4 border-l border-fog pl-5">
          <% @interactions.each do |entry| %>
            <li class="relative">
              <span class="absolute -left-[1.55rem] top-1 h-2.5 w-2.5 rounded-pill bg-olive" aria-hidden="true"></span>
              <p class="text-xs text-taupe"><span class="pill-taupe"><%= CustomersHelper::INTERACTION_LABELS.fetch(entry.kind, entry.kind.titleize) %></span> <%= entry.author&.display_name || 'Former user' %> · <time datetime="<%= entry.created_at.iso8601 %>"><%= l(entry.created_at, format: :long) %></time></p>
              <p class="mt-1 whitespace-pre-wrap text-sm"><%= entry.body %></p>
            </li>
          <% end %>
        </ol>
        <%== pagy_nav(@interactions_pagy) if @interactions_pagy.pages > 1 %>
      </section>

      <section class="section-card" aria-label="Order history">
        <%= section_heading 'Order history' %>
        <% if @orders.empty? %><p class="text-sm text-taupe">No orders yet.</p><% end %>
        <ul class="divide-y divide-fog">
          <% @orders.each do |order| %>
            <li class="flex flex-wrap items-center justify-between gap-2 py-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-ink"><%= link_to order.display_number, order_path(order), class: 'text-olive-deep hover:underline' %></p>
                <p class="text-xs text-taupe"><%= l(order.occurred_at, format: :short) %> · <span class="capitalize"><%= order.channel %></span></p>
              </div>
              <div class="flex items-center gap-3">
                <span class="<%= %w[paid fulfilled].include?(order.status) ? 'pill-fern' : 'pill-clay' %>"><%= order.status.to_s.humanize %></span>
                <span class="num text-sm font-medium text-ink"><%= customer_money({ order.currency => order.gross_cents }) %></span>
              </div>
            </li>
          <% end %>
        </ul>
        <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
      </section>
    </div>
  </div>
</div>
