<% content_for :title, @customer.name %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title"><%= @customer.name %></h1>
      <p class="mt-1 text-sm text-mocha">
        <span class="pill-taupe capitalize"><%= directory_label(@customer.source) %></span>
        <% if @customer.email.present? %><span class="ml-2"><%= @customer.email %></span><% end %>
        <% if @customer.phone.present? %><span class="ml-2"><%= @customer.phone %></span><% end %>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Back to customers", customers_path, class: "btn-ghost btn-sm" %>
      <% if Current.user.can?("customers.write") %>
        <%= link_to "Edit", edit_customer_path(@customer), class: "btn-ghost btn-sm" %>
      <% end %>
    </div>
  </section>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="stat">
      <p class="stat-label">Orders</p>
      <p class="stat-value mt-1"><%= @customer.orders.count %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Lifetime value</p>
      <p class="stat-value mt-1"><%= customer_money(@customer.lifetime_totals) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Last order</p>
      <p class="stat-value-sm mt-1"><%= @last_order_at ? l(@last_order_at, format: :short) : "—" %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Member since</p>
      <p class="stat-value-sm mt-1"><%= l(@customer.created_at.to_date, format: :long) %></p>
    </div>
  </section>

  <section class="card card-pad">
    <p class="text-sm"><strong><%= @customer.crm_status.titleize %></strong> · <%= @customer.tags.presence || 'No tags' %> · Assigned to <%= @customer.owner&.display_name || 'Unassigned' %></p>
    <p class="mt-2 text-xs text-taupe">Native profile: <%= directory_label(@customer.source) %> · <%= @customer.external_id %></p>
    <p class="mt-1 text-xs text-taupe">Last full directory read: <%= @customer.source == 'manual' ? 'Added manually' : @customer.source_synced_at ? l(@customer.source_synced_at, format: :long) : 'Not verified' %></p>
  </section>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="card card-pad lg:col-span-1">
      <h2 class="font-display text-lg text-ink">Notes</h2>
      <p class="mt-2 whitespace-pre-wrap text-sm text-mocha"><%= @customer.notes.presence || "No notes yet." %></p>
    </div>

    <div class="card card-pad lg:col-span-2">
      <h2 class="font-display text-lg text-ink">Order history</h2>
      <div class="mt-3 divide-y divide-fog">
        <% if @orders.empty? %>
          <p class="py-3 text-sm text-taupe">No orders yet.</p>
        <% end %>
        <% @orders.each do |order| %>
          <div class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ink"><%= link_to order.display_number, order_path(order), class: "hover:text-olive hover:underline" %></p>
              <p class="text-xs text-taupe"><%= l(order.occurred_at, format: :short) %> · <span class="capitalize"><%= order.channel %></span></p>
            </div>
            <div class="flex items-center gap-3">
              <span class="<%= %w[paid fulfilled].include?(order.status) ? "pill-fern" : "pill-clay" %>"><%= order.status %></span>
              <span class="text-sm font-medium text-ink"><%= customer_money({ order.currency => order.gross_cents }) %></span>
            </div>
          </div>
        <% end %>
      </div>
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="card card-pad">
      <h2 class="font-display text-lg">Follow-ups</h2>
      <% @follow_ups.each do |task| %>
        <div class="border-b border-fog py-3 text-sm">
          <p class="font-semibold"><%= task.title %></p>
          <p class="text-xs text-taupe"><%= task.completed_at ? 'Completed' : task.due_on < Date.current ? 'Overdue' : 'Open' %> · <%= task.due_on %> · <%= task.owner&.display_name || 'Unassigned' %></p>
          <% if Current.user.can?('customers.write') %><%= button_to task.completed_at ? 'Reopen' : 'Mark complete', customer_follow_up_path(@customer, task), method: :patch, params: { event: task.completed_at ? 'reopen' : 'complete' }, class: 'btn-ghost btn-sm mt-2' %><% end %>
        </div>
      <% end %>
      <%== pagy_nav(@follow_ups_pagy) if @follow_ups_pagy.pages > 1 %>
      <% if Current.user.can?('customers.write') %>
        <%= form_with url: customer_follow_ups_path(@customer), scope: :follow_up, class: 'mt-4 space-y-3' do |f| %>
          <div><%= f.label :title, 'Follow-up', class: 'block text-sm' %><%= f.text_field :title, required: true, maxlength: 500, class: 'input' %></div>
          <div><%= f.label :due_on, 'Due date', class: 'block text-sm' %><%= f.date_field :due_on, required: true, value: Date.current, class: 'input' %></div>
          <div><%= f.label :owner_id, 'Assigned to', class: 'block text-sm' %><%= f.select :owner_id, @owners.map { |u| [u.display_name, u.id] }, { include_blank: 'Unassigned', selected: @customer.owner_id || Current.user.id }, class: 'select' %></div>
          <%= f.submit 'Schedule follow-up', class: 'btn-primary' %>
        <% end %>
      <% end %>
    </section>
    <section class="card card-pad">
      <h2 class="font-display text-lg">Interaction history</h2>
      <p class="text-xs text-taupe">Record conversations here. Email entries log past contact.</p>
      <% @interactions.each do |entry| %>
        <article class="border-b border-fog py-3">
          <p class="text-xs text-taupe"><%= entry.kind.titleize %> · <%= entry.author&.display_name || 'Former user' %> · <%= l(entry.created_at, format: :long) %></p>
          <p class="mt-1 whitespace-pre-wrap text-sm"><%= entry.body %></p>
        </article>
      <% end %>
      <%== pagy_nav(@interactions_pagy) if @interactions_pagy.pages > 1 %>
      <% if Current.user.can?('customers.write') %>
        <%= form_with url: customer_interactions_path(@customer), scope: :interaction, class: 'mt-4 space-y-3' do |f| %>
          <div><%= f.label :kind, 'Contact type', class: 'block text-sm' %><%= f.select :kind, CustomerInteraction::KINDS.map { |k| [k.titleize, k] }, {}, class: 'select' %></div>
          <div><%= f.label :body, 'Notes', class: 'block text-sm' %><%= f.text_area :body, required: true, maxlength: 10_000, rows: 4, class: 'input' %></div>
          <%= f.submit 'Record interaction', class: 'btn-primary' %>
        <% end %>
      <% end %>
    </section>
  </div>
</div>
