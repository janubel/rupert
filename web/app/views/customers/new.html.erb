<% content_for :title, "Add customer" %>
<div class="space-y-6">
  <nav aria-label="Breadcrumb" class="text-xs text-taupe"><%= link_to "Customers", customers_path, class: "font-semibold text-olive hover:underline" %> <span aria-hidden="true">/</span> <span aria-current="page">Add customer</span></nav>
  <section>
    <h1 class="page-title">Add customer</h1>
    <p class="mt-1 text-sm text-mocha">Create a manual walk-in or phone-order customer. Only a name, email or phone is needed to find them later.</p>
  </section>
  <div class="card card-pad max-w-2xl">
    <%= render "form", customer: @customer %>
  </div>
</div>
