<% content_for :title, 'My pay' %>
<%= page_header 'My pay', subtitle: 'Estimated earnings and finalized payslips.' %>
<section class="card card-pad space-y-3"><h2 class="card-title">This week</h2><p class="stat-value"><%= number_to_currency(@summary.gross_cents / 100.0) %></p><p class="text-sm text-mocha">Estimated gross · <%= number_with_precision(@summary.hours, precision: 2, strip_insignificant_zeros: true) %>h · <%= @examples.rate.label %></p><p class="text-xs text-mocha">Before deductions. Draft hours still need review; your manager confirms payment dates. All amounts here are examples.</p><%= link_to 'Open hours and pay report', employee_preview_reports_path, class: 'btn-ghost btn-sm' %></section>
<%= render 'employee_workspace/payslips' %>
<%= link_to 'Report a pay problem', employee_preview_reports_path(anchor: 'problems'), class: 'text-sm text-olive underline' %>
