<% content_for :title, 'My time clock' %>
<section><h1 class="page-title">Time clock</h1><p class="mt-1 text-sm text-mocha">Clock your own work and request corrections for review.</p></section>
<section class="card card-pad space-y-3"><h2 class="text-lg font-semibold">You are clocked out.</h2><button type="button" disabled class="btn-primary opacity-60">Clock in</button><p class="text-sm text-mocha">Clocking is disabled in preview.</p></section>
<section class="space-y-3"><h2 class="text-lg font-semibold">Your latest shifts</h2>
  <% @shifts.each_with_index do |shift, index| %><article class="card card-pad space-y-3"><p class="font-semibold"><%= l(shift.started_at, format: '%b %-d, %Y · %-I:%M %p') %> – <%= l(shift.ended_at, format: '%-I:%M %p %Z') %></p><p class="text-sm text-mocha"><%= number_with_precision(shift.hours, precision: 2) %> hours</p><details><summary class="cursor-pointer text-sm text-olive">Request a time correction</summary><fieldset disabled class="mt-3 space-y-3"><div><label for="preview-in-<%= index %>" class="field-label">Correct clock-in</label><input id="preview-in-<%= index %>" type="datetime-local" value="<%= shift.started_at.strftime('%Y-%m-%dT%H:%M') %>" class="input w-full"></div><div><label for="preview-out-<%= index %>" class="field-label">Correct clock-out</label><input id="preview-out-<%= index %>" type="datetime-local" value="<%= shift.ended_at.strftime('%Y-%m-%dT%H:%M') %>" class="input w-full"></div><div><label for="preview-reason-<%= index %>" class="field-label">Reason for correction</label><textarea id="preview-reason-<%= index %>" rows="2" class="input w-full"></textarea></div><button type="button" class="btn-ghost">Request review</button></fieldset><p class="mt-2 text-sm text-mocha">Example form · Sending is disabled in preview.</p></details></article><% end %>
</section>
