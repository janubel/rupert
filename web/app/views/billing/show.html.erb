<% content_for :title, 'Your Rupert subscription' %>
<div class="mx-auto max-w-4xl space-y-6"><section class="card card-pad space-y-3"><p class="text-xs uppercase tracking-wide">Your workspace</p><h1 class="page-title">Grow with Rupert.</h1>
<p>Account access is free. Your current subscription: <strong><%= @subscription&.status || 'free' %></strong>.</p>
<% if params[:checkout] %><p role="status">We are waiting for Stripe to confirm your subscription. Returning here does not confirm a payment. Refresh to see the latest status.</p><% end %>
<p class="text-sm">Payments are processed by Stripe using the CSP Cyber Security Pilot billing account. Taxes may apply.</p>
<% unless RupertBilling.configured? %><p role="status">Paid checkout is being configured. You can continue using your free account.</p><% end %></section>
<% unless @subscription&.stripe_subscription_id.present? %><section class="grid gap-4 md:grid-cols-2">
<% [['monthly', 'Monthly', '$499', 'Billed monthly.'], ['referral_year', 'Referred by a customer', '$249.50', '50% off for 12 months with an eligible customer code. A 12-month commitment, billed monthly: $2,994 total before tax. Then $499/month.']].each do |plan, title, price, description| %>
<article class="card card-pad space-y-4"><h2 class="font-display text-xl"><%= title %></h2><p class="text-3xl"><%= price %><span class="text-sm"> USD / month</span></p><p><%= description %></p>
<%= form_with url: billing_checkout_path, data: {turbo: false}, class: 'space-y-3' do |f| %><%= hidden_field_tag :plan, plan %>
<% if plan == 'referral_year' %><%= label_tag :referral_code, 'Customer referral code' %><%= text_field_tag :referral_code, nil, required: true, maxlength: 40, class: 'input' %><% end %>
<label class="flex gap-2"><%= check_box_tag :accepted, '1', false, required: true %><span>I agree to <%= description %> Billing terms version <%= RupertBilling::TERMS_VERSION %>.</span></label>
<%= f.submit 'Continue to secure checkout', class: 'btn-primary', disabled: !RupertBilling.configured? %><% end %></article><% end %></section><% else %>
<section class="card card-pad space-y-3"><h2 class="font-display text-xl">Subscription details</h2><p><%= @subscription.plan.humanize %> · Last confirmed <%= @subscription.last_synced_at&.utc&.iso8601 || 'Awaiting confirmation' %></p>
<% if @subscription.commitment_ends_at %><p>Annual commitment ends <%= @subscription.commitment_ends_at.to_date %>. Contact support for payment-method updates or billing help during your commitment.</p><% end %>
<%= button_to 'Manage billing', billing_portal_path, class: 'btn-primary', data: {turbo: false} %>
<% if @subscription.paid? %><%= button_to 'Get my referral code', billing_referral_path, class: 'btn-ghost' %><% end %>
<% if @referral %><p>Your referral code: <strong><%= @referral.code %></strong></p><% end %></section><% end %>
<section class="card card-pad"><h2 class="font-display text-xl">You control customer support access</h2><p>Choose an administrator, grant temporary read access, and revoke it whenever you need.</p><%= link_to 'Manage support access', support_access_path, class: 'btn-ghost mt-3' %></section>
<%= link_to 'Open workspace', root_path, class: 'btn-ghost' %></div>
