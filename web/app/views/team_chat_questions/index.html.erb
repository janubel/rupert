<%# Test questions: the question sets that score the bots, as this workspace asks them (TeamChatQuestionsController). %>
<% check_text = ->(check) { check.is_a?(Hash) ? ([check['tool'] || check[:tool]] + (check['args'] || check[:args] || {}).map { |key, value| "#{key}=#{value}" }).join(' ') : check.to_s } %>
<% set_label = { 'default' => 'General', 'finance' => 'Finance', 'cross' => 'Across areas' } %>
<%= page_header 'Test questions', subtitle: 'The questions each bot is graded on. Reword them, add your own or take one out to test what matters to your books; the built-in set always stays available.' do %>
  <%= link_to 'Open Model scores', team_chat_scores_path, class: 'btn-ghost' %>
<% end %>

<%= page_tabs(@sets.map { |name| [set_label.fetch(name, name.humanize), team_chat_questions_path(set: name), name == @set] }, label: 'Question sets') %>

<section class="card card-pad mt-4 flex flex-wrap items-end gap-3" aria-label="Run these questions">
  <div class="min-w-0 flex-1">
    <h2 class="font-semibold"><%= pluralize(@items.size, 'question') %> in this set</h2>
    <p class="text-sm text-mocha">
      <% if @edits.any? %>Edited for this workspace: runs are scored as <code><%= @run_set %></code>, apart from the built-in set.<% else %>As shipped with Rupert.<% end %>
      Each answer is graded 1–5 by DeepSeek against what the listed tools return.
    </p>
  </div>
  <% if @running %>
    <p class="text-sm text-mocha" role="status">A test run is going: <%= @running.label %>, started <%= time_ago_in_words(@running.started_at) %> ago.</p>
  <% else %>
    <%= form_with url: run_team_chat_questions_path(set: @set), method: :post, class: 'flex flex-wrap items-end gap-2' do %>
      <label class="text-sm"><span class="field-label">Bot</span><%= select_tag :agent, options_for_select(@bots, 'rupert'), class: 'select' %></label>
      <%= submit_tag 'Run these questions', class: 'btn-primary' %>
    <% end %>
  <% end %>
</section>

<% if @runs.any? %>
  <p class="mt-3 text-sm text-mocha">Latest runs of this version:
    <% @runs.first(4).each_with_index do |run, index| %><%= ' · ' if index.positive? %><%= run.label %> <%= run.avg_grade ? "#{run.avg_grade.to_f.round(1)}/5" : run.status %><% end %>.
  </p>
<% end %>

<div class="card mt-4 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="border-b border-fog bg-haze/60">
        <tr><th scope="col" class="th">ID</th><th scope="col" class="th">Question and a good answer</th><th scope="col" class="th">Right answer from</th><th scope="col" class="th">Source</th><th scope="col" class="th"><span class="sr-only">Actions</span></th></tr>
      </thead>
      <tbody class="divide-y divide-fog">
        <% @items.each do |item| %>
          <% edit = @edits[item.id] %>
          <% builtin = @builtin.key?(item.id) %>
          <tr id="q-<%= item.id %>" class="align-top">
            <td class="td font-mono text-xs"><%= item.id %><div class="text-taupe"><%= item.cadence %></div></td>
            <td class="td"><strong class="text-ink"><%= item.question %></strong><% if item.expect %><p class="mt-1 text-xs text-mocha"><%= item.expect %></p><% end %></td>
            <td class="td text-xs"><%= safe_join(item.checks.map { |check| tag.code(check_text.call(check)) }, tag.br) %><% if item.checks.empty? %><span class="text-taupe">No tool: tests honesty</span><% end %></td>
            <td class="td"><span class="<%= edit ? 'pill-clay' : 'pill-taupe' %>"><%= edit ? (builtin ? 'Edited' : 'Added') : 'Built-in' %></span></td>
            <td class="td">
              <details class="text-left">
                <summary class="btn-ghost btn-sm cursor-pointer">Edit</summary>
                <%= render 'form', url: team_chat_question_path(item.id, set: @set), method: :patch, item: item, check_text: check_text, tools: @tools, submit: 'Save' %>
              </details>
              <% if edit && builtin %>
                <%= button_to 'Restore', team_chat_question_path(item.id, set: @set), method: :delete, class: 'btn-ghost btn-sm', form: { data: { turbo_confirm: 'Go back to the built-in wording?' } } %>
              <% elsif edit %>
                <%= button_to 'Remove', team_chat_question_path(item.id, set: @set), method: :delete, class: 'btn-ghost btn-sm', form: { data: { turbo_confirm: 'Remove this question?' } } %>
              <% else %>
                <%= button_to 'Remove', remove_team_chat_question_path(item.id, set: @set), method: :post, class: 'btn-ghost btn-sm', form: { data: { turbo_confirm: 'Leave this question out of the set? Restore brings it back.' } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @removed.any? %>
  <section class="mt-4" aria-label="Removed built-in questions">
    <h2 class="font-semibold">Left out of this set</h2>
    <ul class="mt-2 space-y-1 text-sm">
      <% @removed.each do |item| %>
        <li class="flex flex-wrap items-center gap-2"><code><%= item.id %></code> <span class="text-mocha"><%= item.question %></span>
          <%= button_to 'Restore', team_chat_question_path(item.id, set: @set), method: :delete, class: 'btn-ghost btn-sm' %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<details class="card card-pad mt-4">
  <summary class="cursor-pointer font-semibold">Add question</summary>
  <%= render 'form', url: team_chat_questions_path(set: @set), method: :post, item: nil, check_text: check_text, tools: @tools, submit: 'Add' %>
</details>
