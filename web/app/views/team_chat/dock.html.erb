<turbo-frame id="chat_dock">
  <div class="chat-dock-head">
    <h2 class="chat-dock-title">Team chat</h2>
    <div class="chat-dock-tools">
      <%= link_to team_chat_path, class: 'chat-dock-icon', title: 'Open full team chat', aria: { label: 'Open full team chat' }, data: { turbo_frame: '_top' } do %>⤢<% end %>
      <button type="button" class="chat-dock-icon" data-action="chat-dock#close" title="Close" aria-label="Close team chat">✕</button>
    </div>
  </div>
  <nav class="chat-dock-rooms" aria-label="Rooms">
    <%# Private rooms in the dock: Rupert's and the bots' (test-run rooms open from Model scores). %>
    <% @rooms.reject(&:hidden?).reject { |room| room.direct? && !room.rupert_room? && !room.bot_room? }
             .sort_by { |room| [room.rupert_room? ? 0 : (room.bot_room? ? 1 : 2), -(room.last_message_at || room.created_at).to_i] }.each do |room| %>
      <% unread = room.unread %>
      <% mentions = room.mentions %>
      <%= link_to team_chat_dock_room_path(room), class: "chat-dock-room #{'has-unread' if unread.positive? || mentions.positive?}", data: { chat_dock_room: room.slug } do %>
        <% if room.direct? %>
          <span class="chat-rail-bot" aria-hidden="true"><%= room.avatar_letter %></span><span class="chat-dock-room-name"><%= room.display_name %> <small>direct</small></span>
        <% elsif room.dm? %>
          <% partner = room.dm_partner(Current.user) %>
          <span class="chat-rail-person" <%= presence_attrs(partner) %> style="background:<%= TeamChat::Message::COLORS[partner&.id.to_i % TeamChat::Message::COLORS.size] %>" aria-hidden="true"><%= partner&.display_name.to_s.split(/\s+/).first(2).map { |word| word[0] }.join.upcase %></span><span class="chat-dock-room-name"><%= partner&.display_name || 'Direct message' %> <small>direct</small></span>
        <% else %>
          <span class="chat-hash" aria-hidden="true">#</span><span class="chat-dock-room-name"><%= room.name %></span>
        <% end %>
        <% if mentions.positive? %><span class="chat-unread is-mention">@<%= mentions %></span><% elsif unread.positive? %><span class="chat-unread"><%= unread > 99 ? '99+' : unread %></span><% end %>
      <% end %>
    <% end %>
  </nav>
  <p class="chat-dock-foot">Mention <strong>@rupert</strong><%= ", #{TeamChat::LocalAgents.all.map { |agent| "@#{agent.handle}" }.join(', ')}" if TeamChat::LocalAgents.enabled? %> in any room to ask about the business. <%= link_to 'Model scores', team_chat_scores_path, data: { turbo_frame: '_top' }, class: 'underline' %></p>
</turbo-frame>
