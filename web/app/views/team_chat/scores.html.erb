<%= page_header 'Model scores', subtitle: "Which models people like in team chat (👍 and 👎 over the last #{pluralize(@days, 'day')}), and how each did in the test runs." do %>
  <%= link_to 'Back to team chat', team_chat_path, class: 'btn-ghost' %>
<% end %>

<div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
  <span class="text-mocha">Period:</span>
  <% [7, 30, 90].each do |days| %>
    <%= link_to "#{days} days", team_chat_scores_path(days: days), class: (@days == days ? 'pill-fern' : 'pill-taupe'), aria: { current: (@days == days ? 'page' : nil) } %>
  <% end %>
  <span class="ml-auto text-xs text-taupe">@rupert currently answers with <strong><%= @current.label %></strong>.</span>
</div>

<section class="mb-6" id="leaderboard">
  <div class="flex flex-wrap items-baseline gap-2">
    <h2 class="font-display text-lg text-ink">Leaderboard</h2>
    <span class="text-sm text-mocha">Each model’s latest test runs, scored out of 100 per part of Rupert. A score is the average grade as a percentage (4.6/5 = 92).</span>
  </div>
  <% if @leaderboard.empty? %>
    <p class="mt-2 text-sm text-mocha">No test runs yet.</p>
  <% else %>
    <div class="card mt-2 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-fog bg-haze/60">
            <tr>
              <th scope="col" class="th">#</th>
              <th scope="col" class="th">Model</th>
              <% TeamChat::Leaderboard::COLUMNS.each do |key, label| %>
                <th scope="col" class="th text-right"><%= label %></th>
              <% end %>
              <th scope="col" class="th text-right">Overall</th>
              <th scope="col" class="th text-right">Avg time</th>
              <th scope="col" class="th text-right">Questions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-fog">
            <% @leaderboard.each_with_index do |row, index| %>
              <tr class="hover:bg-cream <%= 'bg-haze/40' if row.leader %>">
                <td class="td text-taupe"><%= index + 1 %></td>
                <td class="td whitespace-nowrap">
                  <% if row.leader %><span title="Top of the leaderboard">🏆</span><% end %>
                  <strong class="text-ink">@<%= row.handle %></strong>
                  <span class="text-xs text-taupe"><%= row.model %> · <%= row.where %></span>
                </td>
                <% TeamChat::Leaderboard::COLUMNS.each_key do |key| %>
                  <% cell = row.cells[key] %>
                  <td class="td whitespace-nowrap text-right <%= 'font-semibold text-fern' if cell&.best %>" title="<%= cell ? pluralize(cell.count, 'question') : 'not tested' %>">
                    <%= cell ? cell.score : '—' %><% if cell&.best %> 🥇<% end %>
                  </td>
                <% end %>
                <td class="td text-right font-semibold"><%= row.overall %></td>
                <td class="td text-right"><%= row.avg_seconds ? "#{row.avg_seconds} s" : '—' %></td>
                <td class="td text-right text-xs text-taupe" title="<%= row.sets.map { |set| set == 'default' ? 'general' : set }.join(', ') %>"><%= row.graded %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-2 text-xs text-taupe">🏆 needs at least <%= TeamChat::Leaderboard::MIN_QUESTIONS %> graded questions; 🥇 marks the best score in each column (at least <%= TeamChat::Leaderboard::MIN_COLUMN %> questions). Hover a score for how many questions it covers. Question sets: general, finance and cross-discipline.</p>
  <% end %>
</section>

<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="border-b border-fog bg-haze/60">
        <tr>
          <th scope="col" class="th">Agent · model</th>
          <th scope="col" class="th text-right">Liked</th>
          <th scope="col" class="th text-right">👍</th>
          <th scope="col" class="th text-right">👎</th>
          <th scope="col" class="th text-right">Replies</th>
          <th scope="col" class="th text-right">Failed</th>
          <th scope="col" class="th text-right">Typical wait</th>
          <th scope="col" class="th text-right">Slowest</th>
          <th scope="col" class="th text-right" title="Answers that took over <%= TeamChat::ModelScores::SLOW_SECONDS / 60 %> minutes. The goal is none.">Over 2 min</th>
          <th scope="col" class="th text-right">Tools / reply</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-fog">
        <% if @rows.empty? %>
          <tr><td colspan="10" class="empty-row">No assistant replies in this period yet. Ask @rupert or a local @agent something in team chat.</td></tr>
        <% end %>
        <% @rows.each do |row| %>
          <tr class="hover:bg-cream">
            <td class="td font-medium text-ink"><%= row.label %><% if row.engine.present? %> <span class="text-xs text-taupe"><%= row.engine.tr('_', ' ') %></span><% end %></td>
            <td class="td text-right font-semibold"><%= row.liked_percent ? "#{row.liked_percent}%" : '—' %></td>
            <td class="td text-right"><%= row.up %></td>
            <td class="td text-right"><%= row.down %></td>
            <td class="td text-right"><%= row.replies %></td>
            <td class="td text-right <%= 'text-rose' if row.failed.positive? %>"><%= row.failed %></td>
            <td class="td text-right"><%= row.median_seconds ? "#{row.median_seconds} s" : '—' %></td>
            <td class="td text-right"><%= row.slowest_seconds ? "#{row.slowest_seconds} s" : '—' %></td>
            <td class="td text-right <%= 'text-rose font-semibold' if row.slow.to_i.positive? %>"><%= row.slow.to_i %><% if row.slow_percent %> <span class="text-xs text-taupe">(<%= row.slow_percent %>%)</span><% end %></td>
            <td class="td text-right"><%= row.tools_per_reply %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<p class="mt-3 text-xs text-taupe">Each person has one vote per reply; pressing the same thumb again takes it back. "Liked" is 👍 out of all votes. Rows with few votes are not yet a fair comparison.</p>

<section class="mt-6" id="test-runs">
  <div class="flex flex-wrap items-baseline gap-2">
    <h2 class="font-display text-lg text-ink">Test runs</h2>
    <span class="text-sm text-mocha">A fixed set of questions asked to one bot in its own test room (#test-liquid, #test-qwen, ...), each answer graded 1–5 by DeepSeek against Rupert’s own data.</span>
  </div>
  <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
    <span class="text-mocha">Questions:</span>
    <%= link_to 'All', team_chat_scores_path(days: @days, anchor: 'test-runs'), class: (@run_set ? 'pill-taupe' : 'pill-fern') %>
    <% @run_sets.each do |set| %>
      <%= link_to set, team_chat_scores_path(days: @days, set: set, anchor: 'test-runs'), class: (@run_set == set ? 'pill-fern' : 'pill-taupe') %>
    <% end %>
    <span class="ml-auto flex flex-wrap gap-2 text-mocha">
      <% TeamChat::Room.open.channels.where('slug LIKE ?', 'test-%').order(:slug).each do |room| %>
        <%= link_to "##{room.slug}", team_chat_room_path(room), class: 'underline' %>
      <% end %>
    </span>
  </div>
  <% if @runs.empty? %>
    <p class="mt-2 text-sm text-mocha">No test runs yet. They start with <code>bin/rails team_chat:battery AGENT=liquid</code> on the server.</p>
  <% else %>
    <div class="card mt-2 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-fog bg-haze/60">
            <tr>
              <th scope="col" class="th">When</th>
              <th scope="col" class="th">Bot · model</th>
              <th scope="col" class="th">Questions</th>
              <th scope="col" class="th text-right">Grade</th>
              <th scope="col" class="th">By topic</th>
              <th scope="col" class="th text-right">Avg time</th>
              <th scope="col" class="th text-right">Slowest</th>
              <th scope="col" class="th text-right" title="Answers with a $ or % figure not found in Rupert's data">Flagged</th>
              <th scope="col" class="th">Build</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-fog">
            <% @runs.each do |run| %>
              <% grade = run.avg_grade&.to_f %>
              <tr class="hover:bg-cream align-top">
                <td class="td whitespace-nowrap"><%= run.started_at&.strftime('%b %-d %H:%M') %><% unless run.display_status == 'done' %> <span class="pill-taupe"><%= run.display_status %></span><% end %></td>
                <td class="td font-medium text-ink"><%= run.label %></td>
                <td class="td"><%= run.set_name %> · <%= run.answered %>/<%= run.questions %></td>
                <td class="td text-right font-semibold <%= grade.nil? ? '' : (grade >= 4.3 ? 'text-fern' : (grade < 3.5 ? 'text-rose' : '')) %>"><%= grade ? format('%.1f', grade) : '—' %></td>
                <td class="td text-xs text-mocha"><%= run.cadence_scores.map { |topic, score| "#{topic} #{score || '—'}" }.join(' · ') %></td>
                <td class="td text-right"><%= run.avg_seconds ? "#{run.avg_seconds.round(1)} s" : '—' %></td>
                <td class="td text-right <%= 'text-rose' if run.max_seconds.to_f > TeamChat::ModelScores::SLOW_SECONDS %>"><%= run.max_seconds ? "#{run.max_seconds.round} s" : '—' %></td>
                <td class="td text-right"><%= run.flagged %></td>
                <td class="td text-xs text-taupe"><%= run.revision.presence || '—' %></td>
              </tr>
              <tr>
                <td colspan="9" class="px-4 pb-2">
                  <details>
                    <summary class="cursor-pointer text-xs text-mocha">Questions and grades</summary>
                    <table class="mt-1 w-full text-xs">
                      <tbody class="divide-y divide-fog">
                        <% run.results_list.each do |row| %>
                          <tr class="align-top">
                            <td class="py-1 pr-2 text-taupe"><%= row['cadence'] %></td>
                            <td class="py-1 pr-2 text-ink"><%= row['message_id'] && run.room ? link_to(row['question'], team_chat_room_path(run.room, message: row['message_id']), class: 'hover:underline') : row['question'] %></td>
                            <td class="py-1 pr-2 font-semibold <%= row['grade'].to_i <= 2 ? 'text-rose' : (row['grade'].to_i >= 5 ? 'text-fern' : '') %>"><%= row['grade'] || '—' %></td>
                            <td class="py-1 pr-2 whitespace-nowrap"><%= row['seconds'] ? "#{row['seconds']} s" : '—' %></td>
                            <td class="py-1 pr-2 text-taupe"><%= Array(row['tools']).join(', ').presence || '—' %></td>
                            <td class="py-1 text-mocha"><%= row['verdict'] %><% if Array(row['unverified']).any? %> <span class="text-rose">⚠ <%= Array(row['unverified']).join(', ') %></span><% end %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </details>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-2 text-xs text-taupe">A model already tested on the same questions and Rupert build is skipped; run with FORCE=1 to test again.</p>
  <% end %>
</section>

<section class="mt-6">
  <h2 class="font-display text-lg text-ink">Answers over 2 minutes</h2>
  <p class="mt-1 text-sm text-mocha">The goal is every answer within <%= TeamChat::ModelScores::SLOW_SECONDS / 60 %> minutes. These took longer (local models include loading time after a break).</p>
  <% if @slow.empty? %>
    <p class="mt-2 text-sm text-fern">None in this period. 🎯</p>
  <% else %>
    <ul class="mt-2 divide-y divide-fog rounded-xl border border-fog bg-paper">
      <% @slow.each do |row| %>
        <li class="flex items-baseline gap-3 px-4 py-2 text-sm">
          <span class="w-16 shrink-0 text-right font-semibold text-rose"><%= row.seconds >= 90 ? "#{row.seconds / 60}m #{row.seconds % 60}s" : "#{row.seconds}s" %></span>
          <div class="min-w-0">
            <p class="truncate text-ink"><%= link_to row.question.presence || 'Open the reply', team_chat_room_path(row.room, message: row.id, thread: row.parent_id), class: 'hover:underline' %></p>
            <p class="text-xs text-taupe">@<%= row.agent %> · <%= row.model.presence || 'unknown model' %> · <%= row.tools.join(', ').presence || 'no tools' %> · #<%= row.room.slug %><%= ' · test run' if row.battery %> · <%= time_ago_in_words(row.created_at) %> ago</p>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="mt-6">
  <h2 class="font-display text-lg text-ink">Why people rated</h2>
  <% if @notes.empty? %>
    <p class="mt-2 text-sm text-mocha">No notes yet. After a 👍 or 👎, people can add a short reason; they show up here.</p>
  <% else %>
    <ul class="mt-2 divide-y divide-fog rounded-xl border border-fog bg-paper">
      <% @notes.each do |note| %>
        <li class="flex gap-3 px-4 py-2 text-sm">
          <span aria-label="<%= note.value.positive? ? 'Helpful' : 'Not helpful' %>"><%= note.value.positive? ? '👍' : '👎' %></span>
          <div class="min-w-0">
            <p class="text-ink"><%= note.reason %></p>
            <p class="text-xs text-taupe">@<%= note.agent %> · <%= note.model.presence || 'unknown model' %> · <%= note.user&.display_name %> · <%= time_ago_in_words(note.updated_at) %> ago</p>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
