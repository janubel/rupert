<% content_for :title, "#{@room.direct? || @room.dm? ? @room.display_name(Current.user) : "##{@room.name}"} · Team chat" %>
<% me = Current.user %>
<% my_initials = me.display_name.to_s.split(/\s+/).first(2).map { |word| word[0] }.join.upcase.presence || 'U' %>
<% channels = @rooms.select(&:channel?) %>
<% direct = @rooms.find(&:rupert_room?) %>
<% room_order = TeamChat::Router.room_agents.map(&:handle) %>
<% bot_rooms = @rooms.select { |room| room.bot_room? && room_order.include?(room.bot_handle) }.sort_by { |room| room_order.index(room.bot_handle) } %>
<% dms = @rooms.select(&:dm?).map { |room| [room, room.dm_partner(me)] }.select(&:last) %>
<% dm_partner = @room.dm_partner(me) if @room.dm? %>
<% room_label = @room.direct? ? @room.display_name : (dm_partner ? dm_partner.display_name : "##{@room.name}") %>
<% content_for :wide_page, true %>
<div class="chat-app"
     data-controller="team-chat"
     data-team-chat-url-value="<%= team_chat_messages_path(@room) %>"
     data-team-chat-room-url-value="<%= team_chat_room_path(@room) %>"
     data-team-chat-room-value="<%= @room.slug %>"
     data-team-chat-direct-value="<%= @room.direct? %>"
     data-team-chat-post-max-value="<%= TeamChat::Message::BODY_MAX %>"
     data-team-chat-title-value="<%= content_for(:title) %>"
     data-team-chat-people-value="<%= @people.to_json %>"
     data-team-chat-agents-value="<%= (@local_agents || []).to_json %>"
     data-team-chat-me-value="<%= me.display_name %>"
     data-team-chat-emoji-value="<%= TeamChat::Reaction::EMOJI.to_json %>"
     data-team-chat-file-max-value="<%= TeamChat::Attachment::MAX_BYTES %>"
     data-team-chat-file-count-value="<%= TeamChat::Attachment::MAX_PER_MESSAGE %>">
  <aside class="chat-rail" aria-label="Team chat rooms">
    <div class="chat-workspace">
      <span class="chat-workspace-mark" aria-hidden="true">R</span>
      <div class="chat-workspace-text">
        <h1 class="chat-workspace-name">Team chat</h1>
        <p>Administrators · with @rupert</p>
      </div>
    </div>

    <label class="chat-filter">
      <span class="sr-only">Find a room</span>
      <input type="search" placeholder="Find a room" data-team-chat-target="filter" data-action="input->team-chat#filterRooms" autocomplete="off">
    </label>

    <nav class="chat-rail-section" aria-label="Rooms" <%= tour_anchor('chat-rooms') %>>
      <div class="chat-rail-head">
        <p class="chat-rail-label">Direct</p>
        <button type="button" class="chat-rail-add" data-action="team-chat#openNewDm" aria-label="New direct message" title="New direct message">+</button>
      </div>
      <% if direct %>
        <%= link_to team_chat_room_path(direct), class: "chat-rail-room #{'is-active' if direct == @room}", aria: { current: (direct == @room ? 'page' : nil) },
              data: { team_chat_target: 'roomLink', slug: direct.slug, name: 'rupert' } do %>
          <span class="chat-rail-bot" aria-hidden="true">R</span>
          <span class="chat-rail-room-name">Rupert</span>
          <span class="chat-unread" data-unread hidden></span>
        <% end %>
      <% end %>
      <%# Each bot's own room: everything typed there goes to that bot, no @ needed. %>
      <% bot_rooms.each do |room| %>
        <%= link_to team_chat_room_path(room), class: "chat-rail-room #{'is-active' if room == @room}", aria: { current: (room == @room ? 'page' : nil) },
              title: room.topic, data: { team_chat_target: 'roomLink', slug: room.slug, name: room.bot_handle } do %>
          <span class="chat-rail-bot" aria-hidden="true"><%= room.avatar_letter %></span>
          <span class="chat-rail-room-name"><%= room.display_name %></span>
          <span class="chat-unread" data-unread hidden></span>
        <% end %>
      <% end %>
      <%# Every other admin is listed; a click opens (or starts) the direct message. %>
      <% dm_rooms = dms.to_h { |room, partner| [partner.id, room] } %>
      <% teammates = TeamChat::Post.mentionable.reject { |person| person.id == me.id } %>
      <% repeated = teammates.map(&:display_name).tally.select { |_name, count| count > 1 }.keys %>
      <% teammates.each do |person| %>
        <% initials = person.display_name.split(/\s+/).first(2).map { |word| word[0] }.join.upcase %>
        <% label = repeated.include?(person.display_name) ? "#{person.display_name} (#{person.email.to_s.split('@').first})" : person.display_name %>
        <% if (room = dm_rooms[person.id]) %>
          <%= link_to team_chat_room_path(room), class: "chat-rail-room #{'is-active' if room == @room}", aria: { current: (room == @room ? 'page' : nil) },
                title: "#{person.display_name} · #{person.email}", data: { team_chat_target: 'roomLink', slug: room.slug, name: label } do %>
            <span class="chat-rail-person" <%= presence_attrs(person) %> style="background:<%= TeamChat::Message::COLORS[person.id % TeamChat::Message::COLORS.size] %>" aria-hidden="true"><%= initials %></span>
            <span class="chat-rail-room-name"><%= label %></span>
            <span class="chat-unread" data-unread hidden></span>
          <% end %>
        <% else %>
          <%= button_to team_chat_dms_path, params: { user_id: person.id }, class: 'chat-rail-room chat-rail-room-button', title: "Message #{person.display_name} · #{person.email}",
                form: { class: 'chat-rail-form', data: { turbo: false, team_chat_target: 'roomLink', slug: "new-dm-#{person.id}", name: label } } do %>
            <span class="chat-rail-person" <%= presence_attrs(person) %> style="background:<%= TeamChat::Message::COLORS[person.id % TeamChat::Message::COLORS.size] %>" aria-hidden="true"><%= initials %></span>
            <span class="chat-rail-room-name"><%= label %></span>
          <% end %>
        <% end %>
      <% end %>

      <div class="chat-rail-head">
        <p class="chat-rail-label">Rooms</p>
        <button type="button" class="chat-rail-add" data-action="team-chat#openNewRoom" aria-label="New room" title="New room">+</button>
      </div>
      <% hidden_channels, shown_channels = channels.partition(&:hidden?) %>
      <% shown_channels.each do |room| %>
        <%= render 'team_chat/rail_channel', room: room %>
      <% end %>
      <% if hidden_channels.any? %>
        <details class="chat-rail-hidden" <%= 'open' if hidden_channels.include?(@room) %>>
          <summary class="chat-rail-label">Hidden rooms (<%= hidden_channels.size %>)</summary>
          <% hidden_channels.each do |room| %>
            <%= render 'team_chat/rail_channel', room: room %>
          <% end %>
        </details>
      <% end %>
    </nav>

    <% presence_rules = TeamChat::Presence.policy %>
    <% presence_mode = TeamChat::Presence.mode_for(me, presence_rules) %>
    <div class="chat-rail-user">
      <span class="chat-avatar" <%= presence_attrs(me) %> aria-hidden="true"><%= my_initials %></span>
      <div class="chat-rail-user-text">
        <strong><%= me.display_name %></strong>
        <button type="button" class="chat-presence-button" data-action="team-chat#openPresence" data-team-chat-target="presenceLabel">
          <%= TeamChat::Presence.shown?(me, presence_rules) ? 'Shown as active' : 'Activity hidden' %> · change
        </button>
        <span title="<%= @model.disclosure %>">Rupert: <%= @model.label %> · <%= link_to 'Model scores', team_chat_scores_path, class: 'underline' %></span>
      </div>
    </div>
  </aside>

  <main class="chat-main">
    <header class="chat-head">
      <div class="chat-head-title">
        <h2><% if @room.direct? %><span class="chat-rail-bot" aria-hidden="true"><%= @room.avatar_letter %></span><%= room_label %><% elsif dm_partner %><span class="chat-rail-person" <%= presence_attrs(dm_partner) %> style="background:<%= TeamChat::Message::COLORS[dm_partner.id % TeamChat::Message::COLORS.size] %>" aria-hidden="true"><%= dm_partner.display_name.split(/\s+/).first(2).map { |word| word[0] }.join.upcase %></span><%= dm_partner.display_name %><% else %><span class="chat-hash">#</span><%= @room.name %><% end %></h2>
        <p data-team-chat-target="topic"><%= @room.dm? ? "#{dm_partner&.email} · Direct message: only the two of you read it. Mention @rupert to bring him in." : (@room.topic.presence || 'No topic yet.') %></p>
        <div class="chat-tabs" role="tablist" aria-label="Show">
          <button type="button" role="tab" class="chat-tab is-active" aria-selected="true" data-tab="messages" data-action="team-chat#showTab">Messages</button>
          <button type="button" role="tab" class="chat-tab" aria-selected="false" data-tab="media" data-action="team-chat#showTab" <%= tour_anchor('chat-media') %>>Media</button>
        </div>
      </div>
      <div class="chat-head-tools">
        <details class="chat-bots chat-help" <%= tour_anchor('chat-help') %>>
          <summary class="chat-bots-button" aria-label="How team chat works">?</summary>
          <div class="chat-bots-panel" role="note">
            <p class="chat-bots-intro"><strong>Team chat in 20 seconds</strong></p>
            <ul class="chat-help-list">
              <li><strong>Rooms</strong> on the left; <strong>Direct</strong> to message one person.</li>
              <li>Type <strong>@</strong> to mention someone or a bot. <strong>@rupert</strong> answers fast from the cloud; <strong>@qwen</strong> and <strong>@gemma</strong> run privately here; <strong>@all</strong> asks every bot side by side.</li>
              <li>Hover (or tap) a message to <strong>↩ Reply</strong> to it, start a <strong>💬 Thread</strong>, react, pin, copy its link or edit yours. Replying to a bot asks it again. Paste or drop photos; find them later under <strong>Media</strong>.</li>
              <li><strong>↑</strong> in the message box brings back what you sent before; <strong>↓</strong> goes forward again.</li>
              <li>Rate bot replies 👍/👎 and say why. Changes a bot proposes wait for <strong>Approve</strong>.</li>
            </ul>
            <div class="chat-help-actions">
              <button type="button" class="btn-primary btn-sm" onclick="this.closest('.chat-help').querySelector('dialog').showModal()">▶ Watch the demo</button>
              <button type="button" class="btn-ghost btn-sm" onclick="this.closest('details').open = false; window.dispatchEvent(new Event('rupert:start-tour'))">Take the tour</button>
              <%= link_to 'Lesson', learning_path('team_chat'), class: 'btn-ghost btn-sm' %>
            </div>
          </div>
          <dialog class="chat-dialog chat-video-dialog" aria-label="Team chat demo">
            <video controls preload="none" playsinline src="/videos/team-chat-demo.mp4"></video>
            <div class="chat-dialog-actions"><button type="button" class="btn-ghost btn-sm" onclick="const d = this.closest('dialog'); d.querySelector('video').pause(); d.close()">Close</button></div>
          </dialog>
        </details>
        <details class="chat-bots" <%= tour_anchor('chat-bots') %>>
          <summary class="chat-bots-button" aria-label="Bot key: which bots can answer here">🤖 <span>Bots</span></summary>
          <div class="chat-bots-panel" role="note">
            <p class="chat-bots-intro">Mention a bot with @ to ask it, or <strong>@all</strong> to ask every bot and compare their answers side by side. Each uses Rupert’s tools with your permissions, and changes wait for your Approve.</p>
            <dl>
              <% TeamChat::LocalAgents.key.each do |bot| %>
                <div class="chat-bots-row">
                  <dt><strong>@<%= bot[:handle] %></strong> <span class="chat-bots-where is-<%= bot[:where] == 'cloud' ? 'cloud' : 'local' %>"><%= bot[:where] == 'cloud' ? 'cloud' : 'local' %></span></dt>
                  <dd><span class="chat-bots-model"><%= bot[:model] %></span> — <%= bot[:purpose] %>
                    <% if bot[:leader] %><span class="chat-bots-best">🏆 #1 on the <%= link_to 'leaderboard', team_chat_scores_path(anchor: 'leaderboard'), class: 'underline' %></span><% end %>
                    <% if bot[:best_for_money] %><span class="chat-bots-best">💰 Best local bot for money questions</span><% end %>
                    <% if bot[:scores].present? %>
                      <span class="chat-bots-scores">Tested: <%= bot[:scores].sort.map { |set, score| "#{set == 'default' ? 'general' : set} #{format('%.1f', score)}/5" }.join(' · ') %></span>
                    <% end %>
                  </dd>
                </div>
              <% end %>
            </dl>
            <p class="chat-bots-foot">Local models load on first use and unload after 10 idle minutes, so the first answer after a break is slower. Each reply shows how long it took; <%= link_to 'Model scores', team_chat_scores_path, class: 'underline' %> compares them.</p>
            <p class="chat-bots-foot"><%= link_to '📊 Scorecard: every test run', team_chat_scores_path(anchor: 'test-runs'), class: 'underline' %></p>
          </div>
        </details>
        <% if @room.channel? %>
          <span class="chat-member-stack" aria-label="People in this room">
            <% @members.first(6).each do |member| %>
              <% initials = member.display_name.to_s.split(/\s+/).first(2).map { |word| word[0] }.join.upcase %>
              <span class="chat-member-avatar" <%= presence_attrs(member) %> style="background:<%= TeamChat::Message::COLORS[member.id % TeamChat::Message::COLORS.size] %>" title="<%= member.display_name %> · <%= member.email %>"><%= initials %></span>
            <% end %>
            <span class="chat-member-avatar is-bot" title="Rupert">R</span>
          </span>
          <label class="chat-mode">
            <span>Rupert answers</span>
            <select class="select select-sm" data-action="change->team-chat#saveMode" aria-label="When Rupert answers in this room">
              <% TeamChat::Room::ASSISTANT_MODES.each do |value, label| %>
                <option value="<%= value %>" <%= 'selected' if @room.assistant_mode == value %>><%= label %></option>
              <% end %>
            </select>
          </label>
          <details class="chat-menu">
            <summary class="btn-ghost btn-sm" aria-label="Room options">⋯</summary>
            <div class="chat-menu-panel">
              <button type="button" class="chat-menu-item" data-action="team-chat#editTopic">Edit topic</button>
              <%= button_to (@membership.hidden? ? 'Show in my list' : 'Hide from my list'), team_chat_visibility_path(@room), method: :patch,
                    params: { hidden: !@membership.hidden? }, class: 'chat-menu-item', form: { data: { turbo: false } },
                    title: 'Only changes your own room list. Hidden rooms stay one click away under Hidden rooms.' %>
              <% unless @room.slug == TeamChat::Room::MAIN_SLUG %>
                <%= button_to 'Archive room', team_chat_room_path(@room), method: :patch, params: { archived: true }, class: 'chat-menu-item is-danger',
                      form: { data: { turbo_confirm: "Archive ##{@room.name}? Its messages are kept but it leaves the list." } } %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </header>

    <div class="chat-pins" data-team-chat-target="pins" hidden></div>
    <section class="chat-media" data-team-chat-target="media" data-url="<%= team_chat_media_path(@room) %>" aria-label="Photos and files in <%= room_label %>" hidden>
      <div class="chat-media-bar">
        <label class="chat-media-search">
          <span class="sr-only">Search photos and files</span>
          <input type="search" placeholder="Search by file name, message or who posted it" data-team-chat-target="mediaSearch" data-action="input->team-chat#searchMedia" autocomplete="off">
        </label>
        <div class="chat-media-kinds" role="group" aria-label="Kind">
          <% [['all', 'All'], ['images', 'Photos'], ['files', 'Files']].each do |value, label| %>
            <button type="button" class="chat-tab <%= 'is-active' if value == 'all' %>" aria-pressed="<%= value == 'all' %>" data-kind="<%= value %>" data-action="team-chat#mediaKind"><%= label %></button>
          <% end %>
        </div>
      </div>
      <p class="chat-hint" data-team-chat-target="mediaStatus">Loading…</p>
      <div class="chat-media-grid" data-team-chat-target="mediaGrid"></div>
      <button type="button" class="btn-ghost btn-sm chat-more" data-team-chat-target="mediaMore" data-action="team-chat#moreMedia" hidden>Show older</button>
    </section>
    <section class="chat-body" aria-label="Messages">
      <div class="chat-log-wrap">
        <div class="chat-log" <%= tour_anchor('chat-messages') %> data-team-chat-target="log" data-action="scroll->team-chat#onScroll" role="log" aria-live="polite" aria-relevant="additions" tabindex="0"
             aria-label="Messages in <%= @room.direct? ? "your room with #{room_label}" : room_label %>">
          <button type="button" class="btn-ghost btn-sm chat-more" data-team-chat-target="more" data-action="team-chat#loadEarlier" hidden>Load earlier messages</button>
          <p class="chat-hint" data-team-chat-target="loading">Loading messages…</p>
          <div class="chat-empty" data-team-chat-target="empty" hidden>
            <% if @room.direct? %>
              <p class="chat-empty-title">Ask <%= room_label %> anything about the business.</p>
            <% else %>
              <p class="chat-empty-title">This is the start of <%= room_label %>.</p>
              <p>Say hello, or write <strong>@rupert</strong> with a question about sales, stock, tasks or how Rupert works.</p>
            <% end %>
          </div>
          <div data-team-chat-list></div>
        </div>
        <button type="button" class="chat-jump" data-team-chat-target="jump" data-action="team-chat#scrollToEnd" hidden>New messages ↓</button>
      </div>

      <form class="chat-compose" <%= tour_anchor('chat-composer') %> data-busy="false" data-team-chat-target="form" data-action="submit->team-chat#send dragover->team-chat#dragOver dragleave->team-chat#dragLeave drop->team-chat#drop">
        <p class="chat-typing" data-team-chat-target="typing" aria-live="polite" hidden></p>
      <p class="chat-error" data-team-chat-target="notice" role="alert" hidden></p>
        <%= render 'team_chat/suggestions', room: @room %>
        <div class="chat-composer">
          <label for="chat-input" class="sr-only">Message</label>
          <ul class="chat-suggest" data-team-chat-target="suggest" role="listbox" hidden></ul>
          <div class="chat-files" data-team-chat-target="files" hidden></div>
          <textarea id="chat-input" class="chat-input" rows="1" maxlength="<%= TeamChat::Message::BODY_MAX %>" data-team-chat-target="input"
                    data-action="input->team-chat#input keydown->team-chat#keydown paste->team-chat#paste" autocomplete="off"
                    placeholder="<%= @room.direct? ? "Ask #{room_label}…" : "Message #{room_label}" %>"></textarea>
          <div class="chat-composer-bar">
            <span class="chat-composer-hint">
              <% if @room.direct? %><%= room_label %> answers every message here.<% elsif @room.assistant_mode == 'off' %>Rupert is off in this room.<% else %>Write <strong>@rupert</strong> to ask him.<% end %>
              @ to mention · Enter sends · Shift+Enter new line · ↑ ↓ your earlier messages · paste or drop images.
            </span>
            <span class="chat-composer-actions">
              <label class="chat-attach" title="Add images or files">
                <span aria-hidden="true">📎</span><span class="sr-only">Add images or files</span>
                <input type="file" multiple accept="image/png,image/jpeg,image/gif,image/webp,application/pdf,.csv,.txt" data-team-chat-target="fileInput" data-action="change->team-chat#pickFiles" hidden>
              </label>
              <button type="submit" class="chat-send" data-team-chat-target="send" aria-label="Send message" disabled>↑</button>
            </span>
          </div>
        </div>
        <p class="chat-disclosure"><%= @model.disclosure %>
          <% if TeamChat::DriveStore.available? %>
            Files are saved to your Google Drive (<%= TeamChat::DriveStore.connection.account_email %>), in “Rupert Team Chat”.
          <% elsif RetentionDrive.configured? && Current.user.can?('settings.write') %>
            Files are kept in Rupert. <%= link_to 'Connect Google Drive', retention_drive_path, class: 'underline' %> to keep them in your own Drive.
          <% end %>
        </p>
      </form>
    </section>
  </main>

  <aside class="chat-thread" data-team-chat-target="thread" aria-label="Thread" hidden>
    <header class="chat-thread-head">
      <h3>Thread</h3>
      <button type="button" class="btn-ghost btn-sm" data-action="team-chat#closeThread" aria-label="Close thread">✕</button>
    </header>
    <div class="chat-thread-log" data-team-chat-target="threadLog"></div>
    <form class="chat-compose" data-busy="false" data-action="submit->team-chat#sendThread">
      <div class="chat-composer">
        <label for="chat-thread-input" class="sr-only">Reply in thread</label>
        <ul class="chat-suggest" data-team-chat-target="threadSuggest" role="listbox" hidden></ul>
        <textarea id="chat-thread-input" class="chat-input" rows="1" maxlength="<%= TeamChat::Message::BODY_MAX %>" data-team-chat-target="threadInput"
                  data-action="input->team-chat#threadInputChanged keydown->team-chat#threadKeydown" placeholder="Reply…" autocomplete="off"></textarea>
        <div class="chat-composer-bar">
          <span class="chat-composer-hint">@rupert works here too.</span>
          <button type="submit" class="chat-send" data-team-chat-target="threadSend" aria-label="Send reply" disabled>↑</button>
        </div>
      </div>
    </form>
  </aside>

  <dialog class="chat-dialog" data-team-chat-target="presence" aria-labelledby="chat-presence-title"
          data-url="<%= team_chat_presence_path %>" data-policy-url="<%= team_chat_presence_policy_path %>">
    <div class="chat-dialog-form">
      <h3 id="chat-presence-title" class="font-display text-lg">Recently active</h3>
      <p class="text-sm text-mocha">A green dot shows who used Rupert in the last <%= TeamChat::Presence::ACTIVE_FOR.in_minutes.to_i %> minutes; a ring, within the hour. Hover a dot for the time.</p>
      <label class="chat-presence-choice">
        <input type="checkbox" data-team-chat-target="presenceToggle" data-action="change->team-chat#togglePresence"
               <%= 'checked' if TeamChat::Presence.shown?(me, presence_rules) %> <%= 'disabled' unless presence_mode == 'choice' %>>
        <span>Show others when I’m active</span>
      </label>
      <% unless presence_mode == 'choice' %>
        <p class="text-xs text-taupe">Your workspace <%= presence_mode == 'on' ? 'always shows' : 'never shows' %> activity<%= " for #{me.role.to_s.humanize.downcase.pluralize}" if presence_rules['roles'].key?(me.role.to_s) %>, so this is set for you.</p>
      <% end %>
      <% if TeamChat::Presence.manage?(me) %>
        <form class="chat-presence-policy" data-action="submit->team-chat#savePresencePolicy">
          <h4 class="field-label">Workspace rule <span class="text-taupe">(administrators)</span></h4>
          <label class="field">
            <span class="field-label">Everyone</span>
            <select name="everyone" class="select select-sm">
              <% TeamChat::Presence::MODES.each do |value, label| %>
                <option value="<%= value %>" <%= 'selected' if presence_rules['everyone'] == value %>><%= label %></option>
              <% end %>
            </select>
          </label>
          <%# Only roles whose people can open team chat (today: administrators). %>
          <% roles_here = TeamChat::Post.mentionable.map(&:role).uniq.compact.sort_by { |role| User.roles.keys.index(role).to_i } %>
          <% roles_here.each do |role| %>
            <label class="field chat-presence-role">
              <span class="field-label"><%= role.humanize.pluralize %></span>
              <select name="roles[<%= role %>]" class="select select-sm">
                <option value="same">Same as everyone</option>
                <% TeamChat::Presence::MODES.each do |value, label| %>
                  <option value="<%= value %>" <%= 'selected' if presence_rules['roles'][role] == value %>><%= label %></option>
                <% end %>
              </select>
            </label>
          <% end %>
          <p class="text-xs text-taupe">“Always shown” or “Never shown” overrides what each person chose.</p>
          <div class="chat-dialog-actions"><button type="submit" class="btn-primary btn-sm">Save rule</button></div>
        </form>
      <% end %>
      <div class="chat-dialog-actions"><button type="button" class="btn-ghost" data-action="team-chat#closePresence">Close</button></div>
    </div>
  </dialog>

  <dialog class="chat-dialog" data-team-chat-target="newDm" aria-labelledby="chat-new-dm-title">
    <div class="chat-dialog-form">
      <h3 id="chat-new-dm-title" class="font-display text-lg">Direct message</h3>
      <% people = TeamChat::Post.mentionable.reject { |person| person.id == me.id } %>
      <% if people.empty? %>
        <p class="text-sm text-mocha">Nobody else uses team chat yet. Direct messages are between people who can open team chat (administrators for now).</p>
      <% end %>
      <div class="chat-dm-people">
        <% people.each do |person| %>
          <%= button_to team_chat_dms_path, params: { user_id: person.id }, class: 'chat-dm-person', form: { data: { turbo: false } } do %>
            <span class="chat-rail-person" <%= presence_attrs(person) %> style="background:<%= TeamChat::Message::COLORS[person.id % TeamChat::Message::COLORS.size] %>" aria-hidden="true"><%= person.display_name.split(/\s+/).first(2).map { |word| word[0] }.join.upcase %></span>
            <span><%= person.display_name %> <span class="chat-dm-email"><%= person.email %></span></span>
          <% end %>
        <% end %>
      </div>
      <div class="chat-dialog-actions"><button type="button" class="btn-ghost" data-action="team-chat#closeNewDm">Close</button></div>
    </div>
  </dialog>

  <dialog class="chat-dialog" data-team-chat-target="newRoom" aria-labelledby="chat-new-room-title">
    <%= form_with url: team_chat_rooms_path, method: :post, class: 'chat-dialog-form' do |form| %>
      <h3 id="chat-new-room-title" class="font-display text-lg">New room</h3>
      <label class="field">
        <span class="field-label">Name</span>
        <%= form.text_field :name, required: true, maxlength: TeamChat::Room::NAME_MAX, class: 'input', placeholder: 'e.g. inventory', autocomplete: 'off' %>
      </label>
      <label class="field">
        <span class="field-label">Topic <span class="text-taupe">(optional)</span></span>
        <%= form.text_field :topic, maxlength: TeamChat::Room::TOPIC_MAX, class: 'input', placeholder: 'What this room is for', autocomplete: 'off' %>
      </label>
      <label class="field">
        <span class="field-label">Rupert answers</span>
        <%= form.select :assistant_mode, TeamChat::Room::ASSISTANT_MODES.map { |value, label| [label, value] }, { selected: 'mentions' }, class: 'select' %>
      </label>
      <div class="chat-dialog-actions">
        <button type="button" class="btn-ghost" data-action="team-chat#closeNewRoom">Cancel</button>
        <%= form.submit 'Create room', class: 'btn-primary' %>
      </div>
    <% end %>
  </dialog>
</div>
