<% content_for :title, @stock_request.reference %>
<% record = @stock_request %>
<% can_write = Current.user.can?('inventory.write') %>
<% menu = [] %>
<% if can_write && %w[pending allocated].include?(record.status) %>
  <% menu << ['Cancel request and release its hold', transition_stock_request_path(record), { method: :post, params: { event: 'cancelled', request_token: SecureRandom.uuid }, data: { turbo_confirm: 'Cancel this request? Confirm that no stock has left its location.' } }] %>
<% end %>
<% status_pill = case record.status when 'completed' then 'pill-fern' when 'cancelled' then 'pill-taupe' when 'pending' then 'pill-clay' else 'pill-olive' end %>
<div class="space-y-6">
  <%= page_header record.reference, subtitle: "#{record.request_kind.humanize} · #{record.source_pool.item_label}", menu: menu do %>
    <% if can_write && !record.transfer? && record.status == 'pending' %>
      <%= button_to 'Allocate stock', transition_stock_request_path(record), params: { event: 'allocated', request_token: SecureRandom.uuid }, class: 'btn-primary', form_class: 'contents' %>
    <% end %>
  <% end %>

  <dl class="facts">
    <div><dt>Status</dt><dd><span class="<%= status_pill %>"><%= record.status.humanize %></span></dd></div>
    <div><dt>Source</dt><dd><%= record.source_pool.source.capitalize %> · <%= record.source_pool.location_name %></dd></div>
    <% if record.destination_pool %><div><dt>Destination</dt><dd><%= record.destination_pool.location_name %></dd></div><% end %>
    <div><dt>Requested</dt><dd class="num text-left"><%= record.quantity %></dd></div>
    <div><dt><%= record.transfer? ? 'Received' : 'Fulfilled' %><%= define('received_quantity') %></dt><dd class="num text-left"><%= record.received_quantity %></dd></div>
    <div><dt>Due</dt><dd><%= record.due_on || 'Not set' %></dd></div>
    <div><dt>Native item<%= define(record.transfer? ? 'transfer' : 'backorder') %></dt><dd class="font-mono text-xs"><%= record.source_pool.source_item_id %></dd></div>
    <div><dt>Recorded by</dt><dd><%= record.created_by %></dd></div>
  </dl>

  <% if can_write %>
    <% event = record.transfer? && record.status == 'allocated' ? 'dispatched' : record.transfer? && record.status == 'dispatched' ? 'received' : !record.transfer? && record.status == 'allocated' ? 'fulfilled' : nil %>
    <% if event %>
      <% noun = event == 'received' ? 'receipt' : event == 'dispatched' ? 'dispatch' : 'fulfillment' %>
      <section class="section-card">
        <%= section_heading "Record #{noun}", hint: "Confirm the physical movement and stock adjustment in #{record.source_pool.source.capitalize}, then refresh source stock in Rupert. This records your confirmation and leaves platform quantities unchanged." %>
        <%= form_with url: transition_stock_request_path(record), class: 'space-y-4' do %>
          <%= hidden_field_tag :event, event %><%= hidden_field_tag :request_token, SecureRandom.uuid %>
          <% if event == 'received' %><div><label class="field-label" for="quantity">Units arriving in this receipt</label><%= number_field_tag :quantity, record.outstanding_quantity, min: 1, max: record.outstanding_quantity, step: 1, required: true, class: 'input' %></div><% end %>
          <div><label class="field-label" for="reference">Source stock adjustment reference</label><%= text_field_tag :reference, nil, maxlength: 500, required: true, class: 'input' %></div>
          <div><label class="field-label" for="adjusted_at">Adjustment time (<%= Time.zone.name %>)</label><%= datetime_local_field_tag :adjusted_at, nil, step: 1, required: true, class: 'input' %></div>
          <label class="flex items-start gap-2 text-sm text-ink"><%= check_box_tag :confirmed, '1', false, required: true, class: 'accent-olive mt-1' %><span>I confirm the physical <%= event == 'received' ? 'receipt at the destination' : event == 'dispatched' ? 'dispatch from the source' : 'fulfillment of all allocated units' %> and the corresponding source stock adjustment.</span></label>
          <div class="form-actions"><%= submit_tag "Save #{noun}", class: 'btn-primary', name: nil %></div>
        <% end %>
      </section>
    <% end %>
  <% end %>

  <section class="section-card">
    <%= section_heading 'Event history' %>
    <% if @events.empty? %>
      <p class="text-sm text-taupe">No events yet.</p>
    <% end %>
    <ul class="divide-y divide-fog">
      <% @events.each do |event| %>
        <li class="py-3 first:pt-0">
          <p class="font-medium text-ink"><%= event.action.humanize %> · <%= event.quantity %> units</p>
          <p class="text-xs text-taupe"><%= event.actor %> · <%= l(event.created_at, format: :short) %></p>
          <% if event.reference %><p class="break-words text-sm">Reference: <%= event.reference %></p><p class="text-xs text-mocha">Source adjusted: <%= l(event.source_adjusted_at, format: :short) %> · Source refreshed: <%= l(event.source_refreshed_at, format: :short) %></p><% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>
