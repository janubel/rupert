<% transfer = @attributes['request_kind'] != 'backorder' %>
<% content_for :title, transfer ? 'Add transfer' : 'Add backorder' %>
<div class="page-narrow space-y-6">
  <%= page_header (transfer ? 'Add transfer' : 'Add backorder'), subtitle: (transfer ? 'Transfers reserve stock now for one exact native item.' : 'Backorders record waiting demand for one exact native item and allocate later.') %>
  <%= fold_explainer('Each request tracks one exact native item; different sources keep independent stock. Stock and freshness are checked when allocating, and the same native item must have a mirrored pool at any destination.', class: 'text-sm text-mocha') %>
  <% if @error %><div class="flash flash-alert" role="alert"><%= @error %></div><% end %>

  <%= form_with url: new_stock_request_path, method: :get, class: 'toolbar' do %>
    <%= hidden_field_tag :kind, @attributes['request_kind'] %>
    <div class="toolbar-field"><%= label_tag :q, 'Find item', class: 'field-label' %><%= search_field_tag :q, @query, class: 'input', placeholder: 'SKU or name' %></div>
    <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary', name: nil %></div>
  <% end %>

  <%= form_with url: stock_requests_path, class: 'card card-pad space-y-4' do %>
    <%= hidden_field_tag :request_token, @token %>
    <%= hidden_field_tag 'stock_request[request_kind]', @attributes['request_kind'] %>
    <fieldset class="space-y-4">
      <legend class="card-title">Stock pool</legend>
      <div>
        <label class="field-label" for="stock_request_inventory_level_id">Source / fulfillment pool</label>
        <select name="stock_request[inventory_level_id]" id="stock_request_inventory_level_id" class="input" required><option value="">Choose source, location and item</option>
          <% @levels.each do |level| %><% item = level.source == 'shopify' ? level.shopify_variant : level.square_variation %>
            <option value="<%= level.id %>" <%= 'selected' if @attributes['inventory_level_id'] == level.id %>><%= [level.source.capitalize, level.location&.name, item&.sku, item && (level.source == 'shopify' ? item.title : item.name), item&.id].compact.join(' · ') %></option>
          <% end %>
        </select>
        <p class="mt-1 text-xs text-taupe">Up to 100 matching pools shown.</p>
      </div>
      <% if transfer %>
        <div>
          <label class="field-label" for="stock_request_destination_location_id">Destination location</label>
          <%= select_tag 'stock_request[destination_location_id]', options_from_collection_for_select(@locations, :id, :name, @attributes['destination_location_id']), include_blank: 'Choose another location in the same source', required: true, class: 'input', id: 'stock_request_destination_location_id' %>
        </div>
      <% end %>
    </fieldset>
    <fieldset class="space-y-4">
      <legend class="card-title">Request</legend>
      <div class="grid gap-4 sm:grid-cols-3">
        <div><label class="field-label" for="stock_request_quantity">Quantity</label><%= number_field_tag 'stock_request[quantity]', @attributes['quantity'], min: 1, step: 1, required: true, class: 'input', id: 'stock_request_quantity' %></div>
        <div><label class="field-label" for="stock_request_reference">Order / transfer reference</label><%= text_field_tag 'stock_request[reference]', @attributes['reference'], maxlength: 200, required: true, class: 'input', id: 'stock_request_reference' %></div>
        <div><label class="field-label" for="stock_request_due_on">Due date <span class="font-normal text-taupe">(optional)</span></label><%= date_field_tag 'stock_request[due_on]', @attributes['due_on'], class: 'input', id: 'stock_request_due_on' %></div>
      </div>
    </fieldset>
    <div class="form-actions">
      <%= submit_tag 'Save', class: 'btn-primary', name: nil %>
      <%= link_to 'Cancel', stock_requests_path(kind: @attributes['request_kind']), class: 'btn-ghost' %>
    </div>
  <% end %>
</div>
