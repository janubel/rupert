<% content_for :title, @kind == 'transfer' ? 'Stock transfers' : 'Backorders' %>
<div class="space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :stock %>
  <%= page_header @kind == 'transfer' ? 'Stock transfers' : 'Backorders' do %>
    <%= link_to "New #{@kind}", new_stock_request_path(kind: @kind), class: 'btn-primary' if Current.user.can?('inventory.write') %>
  <% end %>
  <div class="text-sm text-mocha"><%= @kind == 'transfer' ? 'Reserve one native item at its source location, record dispatch, then receive it at the destination. Partial receipts stay in transit until every unit arrives.' : 'Record demand at a fulfillment location, allocate available stock, then confirm fulfillment. Waiting demand does not hold stock.' %><%= define(@kind == 'transfer' ? 'transfer' : 'backorder') %><%= define('allocation') %></div>
  <%= form_with url: stock_requests_path, method: :get, class: 'flex flex-wrap gap-3 items-end' do %>
    <%= hidden_field_tag :kind, @kind %><label>Status<%= select_tag :status, options_for_select(%w[pending allocated dispatched completed cancelled].map { |s| [s.humanize, s] }, params[:status]), include_blank: 'All statuses', class: 'input' %></label><%= submit_tag 'Filter', class: 'btn-ghost' %>
  <% end %>
  <div class="card overflow-x-auto"><table class="w-full text-sm"><thead><tr><% [['Reference / due', nil], ['Item / source', 'native_id'], ['From / fulfillment', 'pool'], ['Destination', nil], ['Quantity / received', 'received_quantity'], ['Status', nil]].each do |label, term| %><th scope="col" class="th"><%= label %><%= define(term) if term %></th><% end %></tr></thead><tbody class="divide-y divide-fog">
    <% @requests.each do |record| %><tr><td class="td"><%= link_to record.reference, record, class: 'font-medium hover:underline' %><br><%= record.due_on || 'No due date' %></td><td class="td"><%= record.source_pool.item_label %><br><%= record.source_pool.source.capitalize %></td><td class="td"><%= record.source_pool.location_name %></td><td class="td"><%= record.destination_pool&.location_name || '—' %></td><td class="td"><%= record.quantity %> / <%= record.received_quantity %></td><td class="td"><%= record.status.humanize %></td></tr><% end %>
    <% if @requests.empty? %><tr><td colspan="6" class="empty-row">No <%= @kind.pluralize %> match.</td></tr><% end %>
  </tbody></table></div>
  <% if @pagy.pages > 1 %><%== @pagy.series_nav %><% end %>
</div>
