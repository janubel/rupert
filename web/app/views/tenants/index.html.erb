<% content_for :title, "Tenants" %>
<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="page-title">Tenants</h1>
    <p class="mt-1 text-sm text-mocha">Workspaces on this instance</p>
  </div>
  <%= link_to "New tenant", new_tenant_path, class: "btn-primary" %>
</div>

<div class="card overflow-hidden">
  <table class="w-full">
    <thead class="border-b border-fog bg-haze/50">
      <tr>
        <th scope="col" class="th">Name</th>
        <th scope="col" class="th">Subdomain</th>
        <th scope="col" class="th">Status</th>
        <th scope="col" class="th">Plan</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-fog">
      <% if @tenants.empty? %>
        <tr>
          <td colspan="4" class="td py-10 text-center text-taupe">No tenants yet — create the first workspace to get started.</td>
        </tr>
      <% end %>
      <% @tenants.each do |tenant| %>
        <tr>
          <td class="td font-medium text-ink"><%= tenant.name %></td>
          <td class="td text-sm text-mocha"><%= link_to "#{tenant.subdomain}.#{request.domain}", root_url(subdomain: tenant.subdomain, only_path: false), class: "text-olive hover:underline" %></td>
          <td class="td"><span class="<%= tenant.status == "active" ? "pill-fern" : "pill-taupe" %>"><span class="dot <%= tenant.status == "active" ? "bg-fern" : "bg-taupe" %>"></span><%= tenant.status %></span></td>
          <td class="td text-sm text-mocha"><%= tenant.plan %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
