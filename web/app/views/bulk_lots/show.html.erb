<% content_for :title, "#{@material.name} · #{@lot.code}" %>
<div class="space-y-6">
  <section><%= link_to @material.name, bulk_material_path(@material), class: 'text-sm text-olive hover:underline' %><h1 class="page-title mt-2">Lot <%= @lot.code %></h1><p class="mt-1 text-sm text-mocha">Remaining: <strong><%= bulk_mass_label(@lot.balance_mg, @material.unit) %></strong></p><% if @lot.note.present? %><p class="mt-1 text-sm text-mocha"><%= @lot.note %></p><% end %></section>
  <p class="card card-pad text-sm text-mocha">Sales do not automatically consume this ledger. Product-to-gram mappings and Google Sheets synchronization are pending; record each use with its reference.</p>
  <% if @movement.errors.any? %><div role="alert" class="card card-pad text-rose"><%= @movement.errors.full_messages.to_sentence %></div><% end %>
  <% if Current.user.can?('inventory.write') %>
    <%= form_with model: @movement, url: bulk_material_bulk_lot_bulk_movements_path(@material, @lot), class: 'card card-pad space-y-4' do |form| %>
      <h2 class="font-display text-xl">Record movement</h2>
      <%= form.hidden_field :request_token %>
      <div class="grid gap-4 sm:grid-cols-3">
        <div><%= form.label :kind, 'Movement', class: 'field-label' %><%= form.select :kind, [['Use material', 'consume'], ['Receive more', 'receipt'], ['Signed correction', 'adjustment']], {}, class: 'input' %></div>
        <div><%= label_tag 'bulk_movement_quantity', 'Weight', class: 'field-label' %><%= text_field_tag 'bulk_movement[quantity]', @movement.input_quantity, required: true, inputmode: 'decimal', class: 'input' %></div>
        <div><%= label_tag 'bulk_movement_unit', 'Unit', class: 'field-label' %><%= select_tag 'bulk_movement[unit]', options_for_select(BulkMass::FACTORS.keys, @movement.input_unit), class: 'input' %></div>
      </div>
      <div><%= form.label :reference, 'Use / receipt / correction reference', class: 'field-label' %><%= form.text_field :reference, required: true, maxlength: 200, class: 'input' %></div>
      <p class="text-xs text-taupe">Use and receipts take a positive weight. Corrections take a signed weight (+ adds, − removes). Corrections append a new record; earlier movements stay intact. Inputs round half-up to integer milligrams; no movement may make this lot negative.</p>
      <%= form.submit 'Record movement', class: 'btn-primary' %>
    <% end %>
  <% end %>
  <div class="card overflow-x-auto"><table class="w-full text-sm">
    <thead class="border-b border-fog bg-haze/60"><tr><% ['Recorded', 'Movement', 'Entered weight', 'Change (mg)', 'Reference', 'By'].each do |label| %><th class="th" scope="col"><%= label %></th><% end %></tr></thead>
    <tbody class="divide-y divide-fog"><% @movements.each do |movement| %><tr><td class="td"><%= l(movement.created_at, format: :short) %></td><td class="td"><%= movement.kind.humanize %></td><td class="td"><%= movement.input_quantity %> <%= movement.input_unit %></td><td class="td font-mono"><%= movement.delta_mg.positive? ? '+' : '' %><%= number_with_delimiter(movement.delta_mg) %></td><td class="td"><%= movement.reference %></td><td class="td text-xs"><%= movement.created_by %></td></tr><% end %></tbody>
  </table></div>
  <% if @pagy.pages > 1 %><%== @pagy.series_nav %><% end %>
</div>
