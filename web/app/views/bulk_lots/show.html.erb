<% content_for :title, "#{@material.name} · #{@lot.code}" %>
<div class="space-y-6">
  <%= page_header "Lot #{@lot.code}", subtitle: "#{@material.name} · remaining #{bulk_mass_label(@lot.balance_mg, @material.unit)}" %>
  <dl class="facts">
    <div><dt>Material</dt><dd><%= link_to @material.name, bulk_material_path(@material), class: 'text-olive-deep hover:underline' %></dd></div>
    <div><dt>Remaining<%= define('lot_balance') %></dt><dd><%= bulk_mass_label(@lot.balance_mg, @material.unit) %></dd></div>
    <div><dt>First received</dt><dd><%= l(@lot.created_at, format: :short) %></dd></div>
    <% if @lot.note.present? %><div><dt>Note</dt><dd><%= @lot.note %></dd></div><% end %>
  </dl>
  <%= fold_explainer('Sales do not automatically consume this ledger. Product-to-gram mappings and Google Sheets synchronization are pending; record each use with its reference.', class: 'text-sm text-mocha') %>
  <% if @movement.errors.any? %><div role="alert" class="flash flash-alert"><%= @movement.errors.full_messages.to_sentence %></div><% end %>
  <% if Current.user.can?('inventory.write') %>
    <section class="section-card">
      <%= section_heading 'Record movement', hint: 'Use and receipts take a positive weight; corrections take a signed weight (+ adds, − removes).' %>
      <%= form_with model: @movement, url: bulk_material_bulk_lot_bulk_movements_path(@material, @lot), class: 'space-y-4' do |form| %>
        <%= form.hidden_field :request_token %>
        <div class="grid gap-4 sm:grid-cols-3">
          <div><%= form.label :kind, 'Movement', class: 'field-label' %><%= form.select :kind, [['Use material', 'consume'], ['Receive more', 'receipt'], ['Signed correction', 'adjustment']], {}, class: 'input' %></div>
          <div><%= label_tag 'bulk_movement_quantity', 'Weight', class: 'field-label' %><%= text_field_tag 'bulk_movement[quantity]', @movement.input_quantity, required: true, inputmode: 'decimal', class: 'input' %></div>
          <div><%= label_tag 'bulk_movement_unit', 'Unit', class: 'field-label' %><%= select_tag 'bulk_movement[unit]', options_for_select(BulkMass::FACTORS.keys, @movement.input_unit), class: 'input' %></div>
        </div>
        <div><%= form.label :reference, 'Use / receipt / correction reference', class: 'field-label' %><%= form.text_field :reference, required: true, maxlength: 200, class: 'input' %></div>
        <p class="text-xs text-taupe">Corrections append a new record; earlier movements stay intact. Inputs round half-up to integer milligrams; no movement may make this lot negative.</p>
        <div class="form-actions"><%= form.submit 'Save', class: 'btn-primary', name: nil %></div>
      <% end %>
    </section>
  <% end %>
  <div class="card overflow-hidden">
    <div class="table-region" role="region" tabindex="0" aria-label="Lot ledger">
      <table class="table">
        <thead><tr><% [['Recorded', false], ['Movement', false], ['Entered weight', true], ['Change (mg)', true], ['Reference', false], ['By', false]].each do |label, numeric| %><th class="th<%= ' num' if numeric %>" scope="col"><%= label %></th><% end %></tr></thead>
        <tbody>
          <% @movements.each do |movement| %><tr><td class="td"><%= l(movement.created_at, format: :short) %></td><td class="td"><%= movement.kind.humanize %></td><td class="td num"><%= movement.input_quantity %> <%= movement.input_unit %></td><td class="td num font-mono"><%= movement.delta_mg.positive? ? '+' : '' %><%= number_with_delimiter(movement.delta_mg) %></td><td class="td"><%= movement.reference %></td><td class="td text-xs"><%= movement.created_by %></td></tr><% end %>
          <% if @movements.empty? %><tr><td class="empty-row" colspan="6">No movements yet.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy.pages > 1 %><div class="text-xs text-taupe"><%== @pagy.series_nav %></div><% end %>
</div>
