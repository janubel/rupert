<% content_for :title, "Cart · #{@share.name}" %>
<div class="space-y-8">
  <%= page_header 'Your cart', subtitle: "#{@share.name} · prices include your vendor discount and bulk tiers.", eyebrow: 'Warehouse sale' do %>
    <% if @cart.items.any? %><%= link_to 'Proceed to checkout', warehouse_checkout_path(@share.token), class: 'btn-primary btn-lg' %><% end %>
  <% end %>

  <% if @cart.items.empty? %>
    <div class="card">
      <%= empty_state 'Your cart is empty', hint: 'Browse the catalog and add products to start an order.' do %>
        <%= link_to 'Browse the catalog', warehouse_sale_path(@share.token), class: 'btn-primary' %>
      <% end %>
    </div>
  <% else %>
    <section class="card card-pad space-y-4" aria-label="Cart items">
      <% @cart.items.each do |item| %>
        <div class="flex flex-wrap items-center gap-4 border-b border-fog pb-4 last:border-b-0 last:pb-0">
          <div class="min-w-0 flex-1">
            <p class="truncate font-medium text-ink"><%= item.title %></p>
            <p class="text-xs text-taupe"><%= number_to_currency(item.unit_price) %> each</p>
          </div>
          <% unless @cart.payment_locked? %>
            <div class="flex items-center gap-2">
              <%= form_tag warehouse_cart_item_path(@share.token, item.id), method: :patch, class: 'flex items-center gap-2' do %>
                <%= number_field_tag 'quantity', item.quantity, id: "quantity_#{item.id}", min: 0, max: [item.available_quantity, WarehouseCartItem::MAX_QUANTITY].min, class: 'input w-20', aria: { label: "Quantity of #{item.title}" } %>
                <%= submit_tag 'Save', class: 'btn-ghost btn-sm' %>
              <% end %>
              <%= button_to 'Remove', warehouse_cart_remove_item_path(@share.token, item.id), method: :delete, class: 'btn-ghost btn-sm' %>
            </div>
          <% end %>
          <p class="num w-24 text-right font-semibold text-ink"><%= number_to_currency(item.line_price) %></p>
        </div>
      <% end %>

      <div class="flex items-center justify-between pt-2">
        <p class="text-sm text-mocha"><%= @cart.item_count %> units</p>
        <p class="num text-lg font-semibold text-ink">Total <%= number_to_currency(@cart.total_cents / 100.0) %></p>
      </div>
    </section>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <%= link_to 'Keep browsing', warehouse_sale_path(@share.token), class: 'btn-ghost' %>
      <%= link_to 'Proceed to checkout', warehouse_checkout_path(@share.token), class: 'btn-primary' %>
    </div>
  <% end %>
</div>
