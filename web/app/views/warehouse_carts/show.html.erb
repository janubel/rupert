<% content_for :title, "Cart · #{@share.name}" %>
<section class="space-y-8">
  <header class="border-b border-fog pb-6">
    <p class="eyebrow text-olive">Warehouse sale</p>
    <h1 class="mt-2 font-display text-4xl text-ink md:text-5xl">Your cart</h1>
    <p class="mt-3 max-w-xl text-mocha"><%= @share.name %> · prices below include your vendor discount and bulk tiers.</p>
  </header>

  <% if @cart.items.empty? %>
    <div class="card card-pad">
      <p class="py-4 text-center text-taupe">Your cart is empty.</p>
      <div class="text-center">
        <%= link_to "Browse the catalog", warehouse_sale_path(@share.token), class: "btn-primary" %>
      </div>
    </div>
  <% else %>
    <div class="card card-pad space-y-4">
      <% @cart.items.each do |item| %>
        <div class="flex items-center gap-4 border-b border-fog pb-4 last:border-b-0 last:pb-0">
          <div class="min-w-0 flex-1">
            <p class="truncate font-medium text-ink"><%= item.title %></p>
            <p class="text-xs text-taupe"><%= number_to_currency(item.unit_price) %> each</p>
          </div>
          <% unless @cart.payment_locked? %>
          <div class="flex items-center gap-2">
            <%= form_tag warehouse_cart_item_path(@share.token, item.id), method: :patch, class: "flex items-center gap-2" do %>
              <%= number_field_tag "quantity", item.quantity, min: 0, max: [item.available_quantity, WarehouseCartItem::MAX_QUANTITY].min, class: "input w-20" %>
              <%= submit_tag "Update", class: "btn-ghost btn-sm" %>
            <% end %>
            <%= button_to "Remove", warehouse_cart_remove_item_path(@share.token, item.id), method: :delete, class: "btn-ghost btn-sm" %>
          </div>
          <% end %>
          <p class="w-24 text-right font-semibold text-ink"><%= number_to_currency(item.line_price) %></p>
        </div>
      <% end %>

      <div class="flex items-center justify-between pt-2">
        <p class="text-sm text-mocha"><%= @cart.item_count %> units</p>
        <p class="text-lg font-semibold text-ink">Total <%= number_to_currency(@cart.total_cents / 100.0) %></p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <%= link_to "Keep browsing", warehouse_sale_path(@share.token), class: "btn-ghost" %>
      <%= link_to "Proceed to checkout", warehouse_checkout_path(@share.token), class: "btn-primary" %>
    </div>
  <% end %>
</section>
