<% content_for :title, "Receipt #{@checkout.reference}" %>
<div class="mx-auto max-w-xl space-y-4"><h1 class="page-title"><%= @checkout.demo? ? 'Demo receipt' : 'Receipt' %> · <%= @checkout.paid? ? 'Paid' : @checkout.status.humanize %></h1><p class="text-sm"><%= @checkout.location.name %> · <%= @checkout.reference %></p><section class="card card-pad space-y-3"><% @checkout.lines.each do |line| %><p><%= line['title'] %> · <%= line['quantity'] %> × <%= line['unit_price'] %></p><% end %><% { 'Subtotal' => @checkout.subtotal_cents, 'Tax' => @checkout.tax_cents, 'Tip' => @checkout.tip_cents, 'Total' => @checkout.total_cents, 'Cash received' => @checkout.cash_received_cents, 'Change' => @checkout.change_cents }.each do |label, value| %><% unless value.nil? %><p class="flex justify-between"><span><%= label %></span><strong><%= ctrax_money(value) %></strong></p><% end %><% end %></section><p class="text-sm"><%= @checkout.demo? ? 'Demonstration only. No payment or inventory movement was made.' : "Tender: #{@checkout.tender}. A paid receipt is issued only after cash collection or verified gateway approval." %></p><% if %w[ready declined].include?(@checkout.status) %><%= button_to 'Cancel unpaid checkout', cancel_pos_checkout_path(@checkout), method: :post, class: 'btn-ghost', data: { turbo: false } %><% end %><% if @checkout.unresolved? %><%= button_to 'Recheck gateway payment', reconcile_pos_checkout_path(@checkout), method: :post, class: 'btn-ghost', data: { turbo: false } %><% end %><h2 class="font-semibold">Stock updates</h2><% @checkout.pos_stock_allocations.each do |allocation| %><p class="text-sm">Variant #<%= allocation.variant_id %> · <%= allocation.quantity %> units · <%= allocation.status.humanize %></p><% end %><%= link_to 'Cashier', ctrax_pos_path(location_id: @checkout.location_id, display_id: (@checkout.pos_display_session.active? && @checkout.user_id == Current.user.id ? @checkout.pos_display_session_id : nil)), class: 'btn-primary' %></div>
