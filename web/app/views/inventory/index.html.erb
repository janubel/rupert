<% content_for :title, "Inventory" %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Inventory</h1>
      <p class="mt-1 max-w-2xl text-sm text-mocha">Stock held at each location. Shopify and Square are separate locations with independent inventories — different numbers across columns are normal, not an error.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Download PDF", pdf_inventory_index_path, class: "btn-ghost", data: { turbo: false }, title: "Printable snapshot with per-location stock and sync timestamps" %>
      <%= link_to "Recommend SKU download", recommended_skus_inventory_index_path, class: "btn-ghost", data: { turbo: false }, title: "Download proposed unique SKUs for every SKU shared across different products (plan only — no changes made)" %>
      <%= link_to "Movement history", movements_inventory_index_path, class: "btn-ghost" %>
      <%= link_to "Manual counts", inventory_counts_path, class: "btn-ghost" %>
      <%= link_to "New count", new_inventory_count_path, class: "btn-primary" %>
    </div>
  </section>

  <%= form_tag inventory_index_path, method: :get, class: "max-w-sm" do %>
    <input type="search" name="q" value="<%= @q %>" placeholder="Search products or SKUs…" aria-label="Search products or SKUs" class="search w-full" autocomplete="off">
  <% end %>

  <% cached_fragment("inventory/table/v2", q: @q, page: @pagy.page) do %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Product / Variant</th>
            <th scope="col" class="th">SKU</th>
            <th scope="col" class="th text-right">Price</th>
            <% @stock_locations.each do |location| %>
              <th scope="col" class="th text-right" title="<%= location.source == "shopify" ? "Shopify" : "Square" %> — <%= location.name %>">
                <span class="block truncate max-w-[7rem] ml-auto"><%= location.name %></span>
                <span class="block text-[9px] font-normal normal-case tracking-normal text-taupe"><%= location.source %></span>
              </th>
            <% end %>
            <th scope="col" class="th text-right">Total on hand</th>
            <th scope="col" class="th text-right">Catalog</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @products.empty? %>
            <tr>
              <td class="empty-row" colspan="<%= 6 + @stock_locations.length %>"><%= @q.present? ? "Nothing matches that search." : "No products mirrored yet — run a sync." %></td>
            </tr>
          <% end %>
          <% @products.each do |product| %>
            <% variants = product.variants.sort_by(&:title)
                 .reject { |v| qty = @variant_qtys.dig(v.id, :shopify_qty) || 0; !v.tracked && @variant_qtys.dig(v.id, :link).nil? && qty <= 0 }
                 .sort_by { |v| [v.tracked ? 0 : 1, v.title] } %>
            <% variants.each do |variant| %>
              <% info = @variant_qtys.fetch(variant.id, {}) %>
              <% untracked = !variant.tracked %>
              <% shopify_qty = info[:shopify_qty] || 0 %>
              <% shopify_by_location = info[:shopify_by_location] || {} %>
              <% square_by_location = info[:square_by_location] %>
              <% square_qty = info[:square_qty] %>
              <tr class="hover:bg-cream <%= untracked ? "bg-haze/60 opacity-70" : "" %>">
                <td class="td">
                  <div class="flex items-center gap-3">
                    <% if (thumb = product.thumbnail_url) %>
                      <%= image_tag thumb, alt: product.title, loading: "lazy", class: "h-10 w-10 shrink-0 rounded-lg border border-fog bg-haze object-cover" %>
                    <% else %>
                      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-fog bg-haze font-display text-base text-taupe"><%= product.title.first.upcase %></span>
                    <% end %>
                    <div class="min-w-0">
                      <p class="truncate font-medium text-ink"><%= link_to variant.title, shopify_variant_path(variant), class: "hover:text-olive hover:underline" %></p>
                      <p class="truncate text-xs text-taupe"><%= product.title %></p>
                      <% if untracked %>
                        <span class="mt-1 inline-flex items-center gap-1">
                          <span class="pill-taupe">untracked</span>
                          <span class="text-xs text-taupe">surplus duplicate — not synced/reconciled</span>
                        </span>
                      <% end %>
                      <% if (size = info[:size]) %>
                        <span class="mt-1 inline-flex flex-wrap items-center gap-1.5">
                          <span class="pill-olive">size <%= size[:grams] %>g</span>
                          <% if size[:root].nil? %>
                            <span class="pill-taupe">no root set</span>
                          <% elsif size[:pending] %>
                            <span class="pill-rose">pending → <%= size[:pending].target_quantity %></span>
                          <% elsif size[:target] == square_qty %>
                            <span class="pill-fern">in sync · <%= size[:target] %></span>
                          <% else %>
                            <span class="pill-taupe">target <%= size[:target] %> · root <%= number_with_precision(size[:root], precision: 1) %>g</span>
                          <% end %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="td font-mono text-xs text-mocha"><%= variant.sku.presence || "—" %></td>
                <td class="td text-right font-medium text-ink"><%= number_to_currency(variant.price) %></td>
                <% @stock_locations.each do |location| %>
                  <td class="td text-right">
                    <% if location.source == "shopify" %>
                      <span class="<%= (shopify_by_location[location.id] || 0).zero? ? "text-taupe" : "font-medium text-ink" %>"><%= shopify_by_location[location.id] || 0 %></span>
                    <% elsif square_by_location %>
                      <% qty = square_by_location[location.id] %>
                      <% if qty.nil? %>
                        <span class="text-fog">·</span>
                      <% else %>
                        <span class="<%= qty.zero? ? "text-taupe" : "font-medium text-ink" %>"><%= qty %><%= info[:shared] && qty.positive? ? "†" : "" %></span>
                      <% end %>
                    <% else %>
                      <span class="text-fog">·</span>
                    <% end %>
                  </td>
                <% end %>
                <td class="td text-right">
                  <span class="font-semibold text-ink"><%= shopify_qty %></span>
                  <span class="text-taupe">shop</span>
                  <% if square_qty.nil? %>
                    <span class="text-xs text-taupe">· not carried</span>
                  <% else %>
                    <span class="mx-0.5 text-fog">|</span>
                    <span class="font-semibold text-ink"><%= square_qty %><%= info[:shared] && square_qty.positive? ? "†" : "" %></span>
                    <span class="text-taupe">pos</span>
                  <% end %>
                </td>
                <td class="td text-right">
                  <% case info[:status] %>
                  <% when "matched" %>
                    <span class="pill-fern">matched</span>
                  <% when "mismatched" %>
                    <%= link_to "mismatched", reconcile_index_path, class: "pill-clay hover:underline", title: "Same item, different SKU per platform — review on Catalog Links" %>
                  <% else %>
                    <span class="pill-taupe">unlinked</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% end %>
  <p class="px-1 text-xs text-taupe">† Shared Square stock — one Square variation is linked to more than one Shopify variant, so its quantity can't be attributed to a single row. A middle dot means the item isn't carried at that location.</p>

  <% if @pagy.pages > 1 %>
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-taupe">
      <span>Showing products <%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %>.</span>
      <%== pagy_nav(@pagy) %>
    </div>
  <% elsif @q.blank? && @products.length >= 40 %>
    <p class="text-xs text-taupe">All products shown.</p>
  <% end %>
</div>
