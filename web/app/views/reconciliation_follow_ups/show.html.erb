<% content_for :title, 'Reconciliation follow-up' %>
<div class="mx-auto max-w-4xl space-y-6">
  <header><p class="text-xs font-semibold uppercase tracking-widest text-mocha">Follow-up #<%= @follow_up.id %> · <%= ReconciliationFollowUp::CATEGORIES[@follow_up.category] %></p><h1 class="page-title mt-2 break-words"><%= @follow_up.title %></h1><div class="mt-4 flex flex-wrap gap-2"><%= link_to 'All follow-ups', reconciliation_follow_ups_path, class: 'btn-ghost' %><%= link_to 'Review covered day', daily_reconciliations_path(day: @follow_up.period_from.iso8601), class: 'btn-ghost' %><%= link_to 'Find retained reports', reconciliation_documents_path(source: @follow_up.source, from: @follow_up.period_from.iso8601, to: @follow_up.period_to.iso8601), class: 'btn-ghost' %><% if Current.user.can?('reports.write') %><%= link_to 'Add original report', daily_reconciliations_path(day: @follow_up.period_from.iso8601, request: @follow_up.id, anchor: 'upload-document'), class: 'btn-primary' %><% end %></div></header>
  <section class="card card-pad space-y-3"><p class="text-sm"><strong><%= reconciliation_source(@follow_up.source) %></strong> · <%= @follow_up.document_kind.humanize %> · <%= @follow_up.period_from.strftime('%b %-d, %Y') %> through <%= @follow_up.period_to.strftime('%b %-d, %Y') %></p><% if @follow_up.document_kind == 'register_control' %><p class="text-sm"><%= @follow_up.currency %> · <%= @locations.find { |loc| loc.id == @follow_up.location_id }&.name || @follow_up.location_id.presence || 'Unassigned records only' %><%= @follow_up.metric.present? ? " · #{@follow_up.metric.humanize}" : '' %></p><% end %><p class="text-sm"><%= ReconciliationFollowUp::STATUSES[@follow_up.status] %> · due <%= @follow_up.due_on.strftime('%b %-d, %Y') %> · <%= @follow_up.owner&.display_name || 'Unassigned' %><%= @follow_up.overdue? ? ' · OVERDUE' : '' %></p><p class="whitespace-pre-wrap break-words text-sm"><%= @follow_up.notes %></p><% if @follow_up.document %><%= link_to "Linked evidence ##{@follow_up.document.id}: #{@follow_up.document.filename}", document_daily_reconciliation_path(@follow_up.document), class: 'block break-words text-sm text-olive underline' %><p class="text-xs text-mocha">This links retained evidence; later corrections or source changes still require review.</p><% end %></section>
  <% if @report_changed %><p role="status" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm">The covered-day report has changed since this investigation was opened. Review its latest evidence before closing.</p><% end %>
  <% if @follow_up.errors.any? %><div role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm"><%= @follow_up.errors.full_messages.to_sentence %></div><% end %>
  <% if Current.user.can?('reports.write') %><section class="card card-pad space-y-4"><h2 class="font-display text-xl">Record progress or close the follow-up</h2><%= form_with model: @follow_up, scope: :follow_up, class: 'space-y-4' do |f| %>
    <%= f.hidden_field :lock_version, value: @follow_up.lock_version %><details class="rounded-xl border border-haze p-3"><summary class="cursor-pointer text-sm font-semibold">Rename follow-up</summary><div class="mt-3"><%= f.label :title, 'Follow-up title', class: 'block text-sm' %><%= f.text_field :title, value: reconciliation_follow_up_value(@follow_up, :title), required: true, maxlength: 200, class: 'input' %></div></details>
    <div class="grid gap-4 sm:grid-cols-3"><div><%= f.label :status, 'Status', class: 'block text-sm' %><%= f.select :status, ReconciliationFollowUp::STATUSES.map { |key, name| [name, key] }, { selected: reconciliation_follow_up_value(@follow_up, :status) }, class: 'input' %></div><div><%= f.label :owner_id, 'Owner', class: 'block text-sm' %><%= f.select :owner_id, @owners.map { |user| [user.display_name, user.id] }, { include_blank: 'Unassigned', selected: reconciliation_follow_up_value(@follow_up, :owner_id) }, class: 'input' %></div><div><%= f.label :due_on, 'Due date', class: 'block text-sm' %><%= f.date_field :due_on, value: reconciliation_follow_up_value(@follow_up, :due_on), required: true, class: 'input' %></div></div>
    <div><%= f.label :document_id, 'Link retained evidence (optional)', class: 'block text-sm' %><%= f.select :document_id, @matching_documents.map { |doc| ["##{doc.id} · #{doc.filename}", doc.id] }, { include_blank: 'No linked evidence', selected: reconciliation_follow_up_value(@follow_up, :document_id) }, class: 'input' %><p class="mt-1 text-xs text-mocha">Latest 100 matching vault originals by source, kind, period and control scope. Native CSV coverage must be checked in the original; retain a covered original in the vault to link it here.</p></div>
    <div><%= f.label :notes, 'Progress note / closing reason', class: 'block text-sm' %><%= f.text_area :notes, value: @entered_values&.dig('notes') || (@follow_up.errors.any? ? @follow_up.notes : ''), required: true, maxlength: 4000, rows: 4, class: 'input' %></div><%= f.submit 'Save progress', class: 'btn-primary' %>
  <% end %><p class="text-xs text-mocha">Closing records your decision and explanation. A file upload does not automatically close a request or mark a difference reconciled. Earlier notes remain below.</p></section><% end %>
  <section class="space-y-4"><h2 class="font-display text-xl">Retained follow-up history</h2><% @events.each do |event| %><% detail = event.details %><article class="card card-pad space-y-3"><div class="flex flex-wrap justify-between gap-2"><p class="text-sm font-semibold"><%= ReconciliationFollowUp::STATUSES[detail['status']] %> · <%= detail['actor_name'] %></p><p class="text-xs text-mocha"><%= event.created_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %></p></div><p class="text-xs text-mocha">Due <%= Date.iso8601(detail['due_on']).strftime('%b %-d, %Y') %> · <%= detail['owner_name'].presence || 'Unassigned' %><%= detail['document_id'] ? " · evidence ##{detail['document_id']}" : '' %></p><% if detail['title'].present? && detail['title'] != @follow_up.title %><p class="text-xs text-mocha">Title at this update: <%= detail['title'] %></p><% end %><p class="whitespace-pre-wrap break-words text-sm"><%= detail['notes'] %></p></article><% end %><%== pagy_nav(@events_pagy) if @events_pagy.pages > 1 %></section>
</div>
