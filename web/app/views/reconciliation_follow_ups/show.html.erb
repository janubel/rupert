<% content_for :title, @follow_up.title %>
<% can_write = Current.user.can?('reports.write')
   status_pill = if @follow_up.overdue? then ['pill-rose', 'Overdue']
                 elsif @follow_up.status == 'closed' then ['pill-fern', ReconciliationFollowUp::STATUSES['closed']]
                 elsif @follow_up.status == 'waiting' then ['pill-clay', ReconciliationFollowUp::STATUSES['waiting']]
                 else ['pill-olive', ReconciliationFollowUp::STATUSES[@follow_up.status]] end
   menu = []
   menu << ['Back to day close', financial_close_path(day: @close_day.iso8601, anchor: 'close-follow-ups')] if @close_day
   menu << ['Open covered day', daily_reconciliations_path(day: @follow_up.period_from.iso8601)]
   menu << ['Find retained reports', reconciliation_documents_path(reconciliation_library_request_context(@follow_up, @close_day))]
   menu << ['Open days', overview_reconciliation_follow_ups_path]
   menu << ['Follow-ups', reconciliation_follow_ups_path] %>
<div class="page-medium space-y-6">
  <%= page_header @follow_up.title, subtitle: "Follow-up ##{@follow_up.id} · #{ReconciliationFollowUp::CATEGORIES[@follow_up.category]} · #{reconciliation_due_label(@follow_up)} #{@follow_up.due_on.strftime('%b %-d, %Y')}.", menu: menu do %>
    <% if can_write %><%= link_to 'Add original report', daily_reconciliations_path(day: @follow_up.period_from.iso8601, request: @follow_up.id, close_day: @close_day&.iso8601, anchor: 'upload-document'), class: 'btn-primary' %><% end %>
  <% end %>
  <%= render 'return_queue' if @return_queue_filters %>

  <section class="section-card" aria-label="Follow-up details">
    <div class="card-head"><div><h2 class="section-title">Details</h2></div><span class="<%= status_pill.first %>"><%= status_pill.last %></span></div>
    <dl class="facts">
      <div><dt>Source</dt><dd><%= reconciliation_source(@follow_up.source) %></dd></div>
      <div><dt>Document</dt><dd><%= @follow_up.document_kind.humanize %></dd></div>
      <div><dt>Covers</dt><dd><%= @follow_up.period_from.strftime('%b %-d, %Y') %><%= " – #{@follow_up.period_to.strftime('%b %-d, %Y')}" if @follow_up.period_to != @follow_up.period_from %></dd></div>
      <% if @follow_up.document_kind == 'register_control' %><div><dt>Control scope</dt><dd><%= @follow_up.currency %> · <%= @locations.find { |loc| loc.id == @follow_up.location_id }&.name || @follow_up.location_id.presence || 'Unassigned records only' %><%= @follow_up.metric.present? ? " · #{@follow_up.metric.humanize}" : '' %></dd></div><% end %>
      <div><dt>Status</dt><dd><%= ReconciliationFollowUp::STATUSES[@follow_up.status] %></dd></div>
      <div><dt>Due</dt><dd><%= @follow_up.due_on.strftime('%b %-d, %Y') %></dd></div>
      <div><dt>Owner</dt><dd><%= @follow_up.owner&.display_name || 'Unassigned' %></dd></div>
      <div><dt>Evidence</dt><dd><% if @follow_up.document %><%= link_to "##{@follow_up.document.id} · #{@follow_up.document.filename}", document_daily_reconciliation_path(@follow_up.document), class: 'font-semibold text-olive-deep hover:underline' %><% else %>No original linked<% end %></dd></div>
    </dl>
    <p class="whitespace-pre-wrap break-words text-sm"><%= @follow_up.notes %></p>
    <% if @follow_up.document %><p class="text-xs text-mocha">Linked evidence is retained; later corrections or source changes still require review.</p><% end %>
  </section>

  <% if @report_changed %><p role="status" class="rounded-card border border-warn-edge bg-warn-bg p-4 text-sm">The covered-day report has changed since this investigation was opened. Review its latest evidence before closing.</p><% end %>
  <% if @follow_up.errors.any? %><p role="alert" class="flash flash-alert"><%= @follow_up.errors.full_messages.to_sentence %></p><% end %>

  <% if can_write %>
    <section id="record-progress" class="section-card scroll-mt-48 md:scroll-mt-32" aria-labelledby="record-progress-title">
      <div class="card-head"><div><h2 id="record-progress-title" class="section-title">Record progress or close the follow-up</h2><p class="card-hint">Saved in Rupert only. No email or message is sent.</p></div></div>
      <%= form_with model: @follow_up, scope: :follow_up, class: 'space-y-4', data: { controller: 'reconciliation-follow-up-form', busy: false } do |f| %>
        <% @return_queue_filters&.each do |key, value| %><%= hidden_field_tag "queue[#{key}]", value %><% end %>
        <% if @close_day %><%= hidden_field_tag :close_day, @close_day.iso8601 %><% end %>
        <%= f.hidden_field :lock_version, value: @follow_up.lock_version %>
        <details class="explainer rounded-card border border-fog p-3"><summary class="explainer-summary text-sm font-semibold">Rename follow-up</summary><div class="mt-3"><%= f.label :title, 'Follow-up title', class: 'field-label' %><%= f.text_field :title, value: reconciliation_follow_up_value(@follow_up, :title), required: true, maxlength: 200, class: 'input' %></div></details>
        <div class="grid gap-4 sm:grid-cols-3">
          <div><%= f.label :status, 'Status', class: 'field-label' %><%= f.select :status, ReconciliationFollowUp::STATUSES.map { |key, name| [name, key] }, { selected: reconciliation_follow_up_value(@follow_up, :status) }, class: 'select', data: { reconciliation_follow_up_form_target: 'status', action: 'change->reconciliation-follow-up-form#syncDecision' } %></div>
          <div><%= f.label :owner_id, 'Owner', class: 'field-label' %><%= f.select :owner_id, @owners.map { |user| [user.display_name, user.id] }, { include_blank: 'Unassigned', selected: reconciliation_follow_up_value(@follow_up, :owner_id) }, class: 'select' %></div>
          <div><%= f.label :due_on, 'Due date', class: 'field-label' %><%= f.date_field :due_on, value: reconciliation_follow_up_value(@follow_up, :due_on), required: true, class: 'input', data: { reconciliation_follow_up_form_target: 'due' } %><%= render 'due_shortcuts' %></div>
        </div>
        <fieldset class="space-y-3 rounded-card border border-fog bg-paper p-4"><legend class="px-1 text-sm font-semibold">What happens next?</legend>
          <div class="flex flex-wrap gap-2"><% [['open', 'Keep investigating'], ['waiting', 'Waiting on report'], ['closed', 'Resolve follow-up']].each do |value, label| %><button type="button" class="btn-ghost btn-sm aria-pressed:bg-olive aria-pressed:text-white" aria-pressed="<%= reconciliation_follow_up_value(@follow_up, :status) == value %>" data-decision="<%= value %>" data-action="reconciliation-follow-up-form#chooseDecision"><%= label %></button><% end %></div>
          <p class="text-sm" role="status" data-reconciliation-follow-up-form-target="decision">Choose a status above, then record what changed and save. To resolve, select Closed by reviewer and explain the decision.</p>
          <p class="text-xs text-mocha">Evidence is optional for a documented exception. Resolving this follow-up does not approve a financial close or reconcile a source difference.</p>
        </fieldset>
        <% if @suggested_document_id %><p role="status" class="rounded-card border border-success-edge bg-success-bg p-3 text-sm">Your retained original is selected below. Review it, add a progress note and save to link it. Nothing has been linked or closed yet.</p>
        <% elsif @evidence_suggestion_missing %><p role="status" class="rounded-card border border-warn-edge bg-warn-bg p-3 text-sm">That original does not match this request or is unavailable in this workspace. Check its source, kind, covered dates and control scope, then choose a matching original. No link was changed.</p><% end %>
        <% if @matching_documents.any? %>
          <section class="space-y-3" aria-label="Recent matching originals">
            <h3 class="card-title">Recent matching originals</h3>
            <div class="grid gap-3 sm:grid-cols-2">
              <% @matching_documents.first(4).each do |doc| %><article class="min-w-0 space-y-2 rounded-card border border-fog p-3"><p class="break-words text-sm font-semibold"><%= doc.filename %></p><p class="text-xs text-mocha">Covers <%= doc.period_from.strftime('%b %-d, %Y') %> – <%= doc.period_to.strftime('%b %-d, %Y') %> · retained <%= doc.created_at.in_time_zone.strftime('%b %-d, %Y') %></p><div class="flex flex-wrap gap-2"><%= link_to 'Download original', document_daily_reconciliation_path(doc), class: 'btn-ghost btn-sm' %><button type="button" class="btn-ghost btn-sm aria-pressed:bg-olive aria-pressed:text-white" aria-pressed="false" data-action="reconciliation-follow-up-form#chooseEvidence" data-evidence-id="<%= doc.id %>">Use this original</button></div></article><% end %>
            </div>
          </section>
        <% else %>
          <p class="rounded-card border border-fog bg-haze p-3 text-sm">No matching vault original found. Use Add original report above, or find an existing retained file. A native export needs its coverage checked and a covered original retained before it can be linked.</p>
        <% end %>
        <div><%= f.label :document_id, 'Link retained evidence (optional)', class: 'field-label' %><%= f.select :document_id, @matching_documents.map { |doc| ["##{doc.id} · #{doc.filename}", doc.id] }, { include_blank: 'No linked evidence', selected: reconciliation_follow_up_value(@follow_up, :document_id) }, class: 'select', data: { reconciliation_follow_up_form_target: 'evidence', action: 'change->reconciliation-follow-up-form#syncEvidence' } %><p class="mt-1 text-xs text-mocha">Recent vault originals by source, kind, period and control scope, plus any original selected for review or already linked. Native CSV coverage must be checked in the original; retain a covered original in the vault to link it here.</p></div>
        <p class="text-xs text-mocha" role="status" data-reconciliation-follow-up-form-target="chosen">Choose evidence, then save a progress note to link it. Nothing is sent to anyone.</p>
        <div><%= f.label :notes, 'Progress note / closing reason', class: 'field-label' %><%= f.text_area :notes, value: @entered_values&.dig('notes') || (@follow_up.errors.any? ? @follow_up.notes : ''), required: true, maxlength: 4000, rows: 4, class: 'input', placeholder: 'What changed, who owns the next step, and when will you check again?', data: { reconciliation_follow_up_form_target: 'notes' } %></div>
        <div class="form-actions"><%= f.submit 'Save progress', class: 'btn-primary' %><% if @return_queue_filters %><%= f.button 'Save and return to selected queue', type: 'submit', name: 'return_to', value: 'queue', class: 'btn-ghost' %><% end %><% if @close_day %><%= f.button 'Save and return to financial close', type: 'submit', name: 'return_to', value: 'close', class: 'btn-ghost' %><% end %><% if @follow_up.overdue? %><%= f.button 'Save and return to overdue queue', type: 'submit', name: 'return_to', value: 'overdue', class: 'btn-ghost' %><% end %></div>
        <% if @follow_up.overdue? %><%= render 'next_overdue', form: f, item: @next_overdue %><% end %>
      <% end %>
      <p class="text-xs text-mocha">Closing records your decision and explanation. A file upload does not automatically close a request or mark a difference reconciled. Earlier notes remain below.</p>
    </section>
  <% end %>

  <section class="space-y-3" aria-labelledby="follow-up-history">
    <div class="card-head"><div><h2 id="follow-up-history" class="section-title">History</h2><p class="card-hint">Every status change, assignment and note, newest first.</p></div></div>
    <% @events.each do |event| %><% detail = event.details %><article class="section-card"><div class="card-head"><p class="text-sm font-semibold"><%= ReconciliationFollowUp::STATUSES[detail['status']] %> · <%= detail['actor_name'] %></p><p class="text-xs text-mocha"><%= event.created_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %></p></div><p class="text-xs text-mocha">Due <%= Date.iso8601(detail['due_on']).strftime('%b %-d, %Y') %> · <%= detail['owner_name'].presence || 'Unassigned' %><%= detail['document_id'] ? " · evidence ##{detail['document_id']}" : '' %></p><% if detail['title'].present? && detail['title'] != @follow_up.title %><p class="text-xs text-mocha">Title at this update: <%= detail['title'] %></p><% end %><p class="whitespace-pre-wrap break-words text-sm"><%= detail['notes'] %></p></article><% end %>
    <%== @events_pagy.series_nav if @events_pagy.pages > 1 %>
  </section>
</div>
