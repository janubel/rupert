<% content_for :title, 'Reconciliation follow-up' %>
<div class="mx-auto max-w-4xl space-y-6 operations-workspace">

  <header><p class="text-xs font-semibold uppercase tracking-widest text-mocha">Follow-up #<%= @follow_up.id %> · <%= ReconciliationFollowUp::CATEGORIES[@follow_up.category] %></p><h1 class="page-title mt-2 break-words"><%= @follow_up.title %></h1><div class="mt-4 flex flex-wrap gap-2"><% if @close_day %><%= link_to 'Back to day close', financial_close_path(day: @close_day.iso8601, anchor: 'close-follow-ups'), class: 'btn-ghost' %><% end %><%= link_to 'Across days', overview_reconciliation_follow_ups_path, class: 'btn-ghost' %><%= link_to 'All follow-ups', reconciliation_follow_ups_path, class: 'btn-ghost' %><%= link_to 'Review covered day', daily_reconciliations_path(day: @follow_up.period_from.iso8601), class: 'btn-ghost' %><%= link_to 'Find retained reports', reconciliation_documents_path(reconciliation_library_request_context(@follow_up, @close_day)), class: 'btn-ghost' %><% if Current.user.can?('reports.write') %><%= link_to 'Add original report', daily_reconciliations_path(day: @follow_up.period_from.iso8601, request: @follow_up.id, close_day: @close_day&.iso8601, anchor: 'upload-document'), class: 'btn-primary' %><% end %></div></header>
  <%= render 'return_queue' if @return_queue_filters %>
  <section class="card card-pad space-y-3"><p class="text-sm"><strong><%= reconciliation_source(@follow_up.source) %></strong> · <%= @follow_up.document_kind.humanize %> · <%= @follow_up.period_from.strftime('%b %-d, %Y') %> through <%= @follow_up.period_to.strftime('%b %-d, %Y') %></p><% if @follow_up.document_kind == 'register_control' %><p class="text-sm"><%= @follow_up.currency %> · <%= @locations.find { |loc| loc.id == @follow_up.location_id }&.name || @follow_up.location_id.presence || 'Unassigned records only' %><%= @follow_up.metric.present? ? " · #{@follow_up.metric.humanize}" : '' %></p><% end %><p class="text-sm"><%= ReconciliationFollowUp::STATUSES[@follow_up.status] %> · due <%= @follow_up.due_on.strftime('%b %-d, %Y') %> · <%= @follow_up.owner&.display_name || 'Unassigned' %><%= @follow_up.overdue? ? ' · OVERDUE' : '' %></p><p class="whitespace-pre-wrap break-words text-sm"><%= @follow_up.notes %></p><% if @follow_up.document %><%= link_to "Linked evidence ##{@follow_up.document.id}: #{@follow_up.document.filename}", document_daily_reconciliation_path(@follow_up.document), class: 'block break-words text-sm text-olive underline' %><p class="text-xs text-mocha">This links retained evidence; later corrections or source changes still require review.</p><% end %></section>
  <% if @report_changed %><p role="status" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm">The covered-day report has changed since this investigation was opened. Review its latest evidence before closing.</p><% end %>
  <% if @follow_up.errors.any? %><div role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm"><%= @follow_up.errors.full_messages.to_sentence %></div><% end %>
  <% if Current.user.can?('reports.write') %><section id="record-progress" class="card card-pad scroll-mt-48 md:scroll-mt-32 space-y-4"><h2 class="font-display text-xl">Record progress or close the follow-up</h2><%= form_with model: @follow_up, scope: :follow_up, class: 'space-y-4', data: { controller: 'reconciliation-follow-up-form', busy: false } do |f| %>
    <% @return_queue_filters&.each do |key, value| %><%= hidden_field_tag "queue[#{key}]", value %><% end %>
    <% if @close_day %><%= hidden_field_tag :close_day, @close_day.iso8601 %><% end %><%= f.hidden_field :lock_version, value: @follow_up.lock_version %><details class="rounded-xl border border-haze p-3"><summary class="cursor-pointer text-sm font-semibold">Rename follow-up</summary><div class="mt-3"><%= f.label :title, 'Follow-up title', class: 'field-label' %><%= f.text_field :title, value: reconciliation_follow_up_value(@follow_up, :title), required: true, maxlength: 200, class: 'input' %></div></details>
    <div class="grid gap-4 sm:grid-cols-3"><div><%= f.label :status, 'Status', class: 'field-label' %><%= f.select :status, ReconciliationFollowUp::STATUSES.map { |key, name| [name, key] }, { selected: reconciliation_follow_up_value(@follow_up, :status) }, class: 'input', data: { reconciliation_follow_up_form_target: 'status', action: 'change->reconciliation-follow-up-form#syncDecision' } %></div><div><%= f.label :owner_id, 'Owner', class: 'field-label' %><%= f.select :owner_id, @owners.map { |user| [user.display_name, user.id] }, { include_blank: 'Unassigned', selected: reconciliation_follow_up_value(@follow_up, :owner_id) }, class: 'input' %></div><div><%= f.label :due_on, 'Due date', class: 'field-label' %><%= f.date_field :due_on, value: reconciliation_follow_up_value(@follow_up, :due_on), required: true, class: 'input', data: { reconciliation_follow_up_form_target: 'due' } %><%= render 'due_shortcuts' %></div></div>
    <fieldset class="rounded-xl border border-fog bg-paper p-4 space-y-3"><legend class="px-1 text-sm font-semibold">What happens next?</legend><div class="flex flex-wrap gap-2"><% [['open', 'Keep investigating'], ['waiting', 'Waiting on report'], ['closed', 'Resolve follow-up']].each do |value, label| %><button type="button" class="btn-ghost btn-sm aria-pressed:bg-olive aria-pressed:text-white" aria-pressed="<%= reconciliation_follow_up_value(@follow_up, :status) == value %>" data-decision="<%= value %>" data-action="reconciliation-follow-up-form#chooseDecision"><%= label %></button><% end %></div><p class="text-sm" role="status" data-reconciliation-follow-up-form-target="decision">Choose a status above, then record what changed and save. To resolve, select Closed by reviewer and explain the decision.</p><p class="text-xs text-mocha">Evidence is optional for a documented exception. Resolving this follow-up does not approve a financial close or reconcile a source difference.</p></fieldset>
    <% if @suggested_document_id %><p role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm">Your retained original is selected below. Review it, add a progress note and save to link it. Nothing has been linked or closed yet.</p><% elsif @evidence_suggestion_missing %><p role="status" class="rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm">That original does not match this request or is unavailable in this workspace. Check its source, kind, covered dates and control scope, then choose a matching original. No link was changed.</p><% end %>
    <% if @matching_documents.any? %><section class="space-y-3" aria-label="Recent matching originals"><h3 class="font-semibold">Recent matching originals</h3><div class="grid gap-3 sm:grid-cols-2"><% @matching_documents.first(4).each do |doc| %><article class="rounded-xl border border-fog p-3 space-y-2 min-w-0"><p class="break-words text-sm font-semibold"><%= doc.filename %></p><p class="text-xs text-mocha">Covers <%= doc.period_from.strftime('%b %-d, %Y') %> – <%= doc.period_to.strftime('%b %-d, %Y') %> · retained <%= doc.created_at.in_time_zone.strftime('%b %-d, %Y') %></p><div class="flex flex-wrap gap-2"><%= link_to 'Download to review', document_daily_reconciliation_path(doc), class: 'btn-ghost btn-sm' %><button type="button" class="btn-ghost btn-sm aria-pressed:bg-olive aria-pressed:text-white" aria-pressed="false" data-action="reconciliation-follow-up-form#chooseEvidence" data-evidence-id="<%= doc.id %>">Use this original</button></div></article><% end %></div></section><% else %><p class="rounded-xl border border-fog bg-haze p-3 text-sm">No matching vault original found. Use Add original report above, or find an existing retained file. A native export needs its coverage checked and a covered original retained before it can be linked.</p><% end %>
    <div><%= f.label :document_id, 'Link retained evidence (optional)', class: 'field-label' %><%= f.select :document_id, @matching_documents.map { |doc| ["##{doc.id} · #{doc.filename}", doc.id] }, { include_blank: 'No linked evidence', selected: reconciliation_follow_up_value(@follow_up, :document_id) }, class: 'input', data: { reconciliation_follow_up_form_target: 'evidence', action: 'change->reconciliation-follow-up-form#syncEvidence' } %><p class="mt-1 text-xs text-mocha">Recent vault originals by source, kind, period and control scope, plus any original selected for review or already linked. Native CSV coverage must be checked in the original; retain a covered original in the vault to link it here.</p></div>
    <p class="text-xs text-mocha" role="status" data-reconciliation-follow-up-form-target="chosen">Choose evidence, then save a progress note to link it. Nothing is sent to anyone.</p>
    <div><%= f.label :notes, 'Progress note / closing reason', class: 'field-label' %><%= f.text_area :notes, value: @entered_values&.dig('notes') || (@follow_up.errors.any? ? @follow_up.notes : ''), required: true, maxlength: 4000, rows: 4, class: 'input', placeholder: 'What changed, who owns the next step, and when will you check again?', data: { reconciliation_follow_up_form_target: 'notes' } %></div><p class="text-xs text-mocha">Saved in Rupert only. No email or message is sent.</p><div class="flex flex-wrap gap-2"><%= f.submit 'Save progress', class: 'btn-primary' %><% if @return_queue_filters %><%= f.button 'Save and return to selected queue', type: 'submit', name: 'return_to', value: 'queue', class: 'btn-ghost' %><% end %><% if @close_day %><%= f.button 'Save and return to financial close', type: 'submit', name: 'return_to', value: 'close', class: 'btn-ghost' %><% end %><% if @follow_up.overdue? %><%= f.button 'Save and return to overdue queue', type: 'submit', name: 'return_to', value: 'overdue', class: 'btn-ghost' %><% end %></div>
    <% if @follow_up.overdue? %><%= render 'next_overdue', form: f, item: @next_overdue %><% end %>
  <% end %><p class="text-xs text-mocha">Closing records your decision and explanation. A file upload does not automatically close a request or mark a difference reconciled. Earlier notes remain below.</p></section><% end %>
  <section class="space-y-4"><h2 class="font-display text-xl">Retained follow-up history</h2><% @events.each do |event| %><% detail = event.details %><article class="card card-pad space-y-3"><div class="flex flex-wrap justify-between gap-2"><p class="text-sm font-semibold"><%= ReconciliationFollowUp::STATUSES[detail['status']] %> · <%= detail['actor_name'] %></p><p class="text-xs text-mocha"><%= event.created_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %></p></div><p class="text-xs text-mocha">Due <%= Date.iso8601(detail['due_on']).strftime('%b %-d, %Y') %> · <%= detail['owner_name'].presence || 'Unassigned' %><%= detail['document_id'] ? " · evidence ##{detail['document_id']}" : '' %></p><% if detail['title'].present? && detail['title'] != @follow_up.title %><p class="text-xs text-mocha">Title at this update: <%= detail['title'] %></p><% end %><p class="whitespace-pre-wrap break-words text-sm"><%= detail['notes'] %></p></article><% end %><%== pagy_nav(@events_pagy) if @events_pagy.pages > 1 %></section>
</div>
