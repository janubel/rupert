<div class="mt-2 flex flex-wrap gap-2" aria-label="Choose next check date"><% [['Today', Date.current], ['Tomorrow', Date.tomorrow], ['In 3 days', Date.current + 3]].each do |label, day| %><button type="button" class="btn-ghost btn-sm" data-action="reconciliation-follow-up-form#setDue" data-date="<%= day.iso8601 %>"><%= label %></button><% end %></div>
