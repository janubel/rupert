<% content_for :title, 'New reconciliation follow-up' %>
<div class="mx-auto max-w-3xl space-y-5"><h1 class="page-title">Track a missing report or difference</h1><p class="text-sm text-mocha">Name the missing report or difference to investigate, choose an owner and set a due date. Original source context stays fixed after saving; progress and closing notes keep a history.</p><p class="rounded-xl border border-fog bg-paper p-3 text-sm">Saved in Rupert only. No email or message is sent.</p>
  <% if @follow_up.errors.any? %><div role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm"><%= @follow_up.errors.full_messages.to_sentence %></div><% end %>
  <%= form_with model: @follow_up, scope: :follow_up, class: 'card card-pad space-y-4', data: { controller: 'reconciliation-request-form reconciliation-follow-up-form' } do |f| %>
    <%= f.hidden_field :submission_key %><%= f.hidden_field :metric %>
    <div><%= f.label :title, 'Follow-up title', class: 'block text-sm font-semibold' %><%= f.text_field :title, required: true, maxlength: 200, placeholder: 'October bank statement needed', class: 'input' %></div>
    <div class="grid gap-4 sm:grid-cols-2"><div><%= f.label :category, 'Purpose', class: 'block text-sm' %><%= f.select :category, ReconciliationFollowUp::CATEGORIES.map { |key, name| [name, key] }, {}, class: 'input' %></div><div><%= f.label :source, 'Source', class: 'block text-sm' %><%= f.select :source, ReconciliationLibrary::SOURCE_NAMES.except('rupert').map { |key, name| [name, key] }, {}, class: 'input' %></div><div><%= f.label :document_kind, 'Expected document kind', class: 'block text-sm' %><%= f.select :document_kind, ReconciliationFollowUp::DOCUMENT_KINDS.map { |kind| [kind.humanize, kind] }, {}, class: 'input', data: { reconciliation_request_form_target: 'kind', action: 'change->reconciliation-request-form#update' } %></div><div><%= f.label :period_from, 'Covered period starts', class: 'block text-sm' %><%= f.date_field :period_from, required: true, class: 'input', data: { reconciliation_request_form_target: 'from', action: 'change->reconciliation-request-form#update' } %></div><div><%= f.label :period_to, 'Covered period ends', class: 'block text-sm' %><%= f.date_field :period_to, required: true, class: 'input', data: { reconciliation_request_form_target: 'to' } %></div></div>
    <details class="rounded-xl border border-haze p-4" data-reconciliation-request-form-target="scope" <%= 'open' if @follow_up.document_kind == 'register_control' %>><summary class="cursor-pointer text-sm font-semibold">Currency &amp; location for a register control</summary><div class="mt-4 space-y-4"><div><%= f.label :currency, 'Control currency', class: 'block text-sm' %><%= f.text_field :currency, maxlength: 3, pattern: '[A-Z]{3}', placeholder: 'USD', class: 'input', data: { reconciliation_request_form_target: 'currency' } %></div><div><%= f.label :location_id, 'Control location', class: 'block text-sm' %><%= f.select :location_id, @locations.map { |loc| ["#{loc.name} · #{reconciliation_source(loc.source)}", loc.id] } + (@follow_up.location_id.present? && @locations.none? { |loc| loc.id == @follow_up.location_id } ? [["Recorded pool #{@follow_up.location_id}", @follow_up.location_id]] : []), { include_blank: 'Unassigned records only' }, class: 'input', data: { reconciliation_request_form_target: 'location' } %></div></div></details>
    <p class="text-xs text-mocha">Use the covered dates on the original. Register controls need a single business day, currency and exact location.</p>
    <div class="grid gap-4 sm:grid-cols-2"><div><%= f.label :owner_id, 'Owner', class: 'block text-sm' %><%= f.select :owner_id, @owners.map { |user| [user.display_name, user.id] }, { include_blank: 'Unassigned' }, class: 'input' %></div><div><%= f.label :due_on, 'Due date', class: 'block text-sm' %><%= f.date_field :due_on, required: true, class: 'input', data: { reconciliation_follow_up_form_target: 'due' } %><%= render 'due_shortcuts' %></div></div>
    <div><%= f.label :notes, 'Request details / next step', class: 'block text-sm' %><%= f.text_area :notes, required: true, maxlength: 4000, rows: 4, class: 'input', placeholder: 'Who will provide the original? What will you check next?', data: { reconciliation_follow_up_form_target: 'notes' } %></div><div class="flex flex-wrap gap-2"><%= f.submit 'Save in Rupert', class: 'btn-primary' %><%= link_to 'Cancel', reconciliation_follow_ups_path, class: 'btn-ghost' %></div>
  <% end %>
</div>
