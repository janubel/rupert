<% content_for :title, 'Add follow-up' %>
<div class="page-narrow space-y-6">
  <%= page_header 'Add follow-up', subtitle: 'Name the missing report or difference to investigate, choose an owner and set a due date.' %>
  <%= fold_explainer('Saved in Rupert only. No email or message is sent. Original source context stays fixed after saving; progress and closing notes keep a history.', class: 'text-sm text-mocha') %>
  <% if @follow_up.errors.any? %><p role="alert" class="flash flash-alert"><%= @follow_up.errors.full_messages.to_sentence %></p><% end %>
  <%= form_with model: @follow_up, scope: :follow_up, class: 'card card-pad space-y-5', data: { controller: 'reconciliation-request-form reconciliation-follow-up-form' } do |f| %>
    <% if @close_day %><%= hidden_field_tag :close_day, @close_day.iso8601 %><p class="text-sm text-mocha">Returns to the day close for <%= @close_day.strftime('%b %-d, %Y') %> after recording progress.</p><% end %>
    <%= f.hidden_field :submission_key %><%= f.hidden_field :metric %>
    <fieldset class="space-y-4">
      <legend class="card-title">What is missing</legend>
      <div><%= f.label :title, 'Follow-up title', class: 'field-label' %><%= f.text_field :title, required: true, maxlength: 200, placeholder: 'October bank statement needed', class: 'input' %></div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><%= f.label :category, 'Purpose', class: 'field-label' %><%= f.select :category, ReconciliationFollowUp::CATEGORIES.map { |key, name| [name, key] }, {}, class: 'select' %></div>
        <div><%= f.label :source, 'Source', class: 'field-label' %><%= f.select :source, ReconciliationLibrary::SOURCE_NAMES.except('rupert').map { |key, name| [name, key] }, {}, class: 'select' %></div>
        <div><%= f.label :document_kind, 'Expected document kind', class: 'field-label' %><%= f.select :document_kind, ReconciliationFollowUp::DOCUMENT_KINDS.map { |kind| [kind.humanize, kind] }, {}, class: 'select', data: { reconciliation_request_form_target: 'kind', action: 'change->reconciliation-request-form#update' } %></div>
        <div><%= f.label :period_from, 'Covered period starts', class: 'field-label' %><%= f.date_field :period_from, required: true, class: 'input', data: { reconciliation_request_form_target: 'from', action: 'change->reconciliation-request-form#update' } %></div>
        <div><%= f.label :period_to, 'Covered period ends', class: 'field-label' %><%= f.date_field :period_to, required: true, class: 'input', data: { reconciliation_request_form_target: 'to' } %></div>
      </div>
      <details class="explainer rounded-card border border-fog p-4" data-reconciliation-request-form-target="scope" <%= 'open' if @follow_up.document_kind == 'register_control' %>><summary class="explainer-summary text-sm font-semibold">Currency and location for a register control</summary><div class="mt-4 space-y-4"><div><%= f.label :currency, 'Control currency', class: 'field-label' %><%= f.text_field :currency, maxlength: 3, pattern: '[A-Z]{3}', placeholder: 'USD', class: 'input', data: { reconciliation_request_form_target: 'currency' } %></div><div><%= f.label :location_id, 'Control location', class: 'field-label' %><%= f.select :location_id, @locations.map { |loc| ["#{loc.name} · #{reconciliation_source(loc.source)}", loc.id] } + (@follow_up.location_id.present? && @locations.none? { |loc| loc.id == @follow_up.location_id } ? [["Recorded pool #{@follow_up.location_id}", @follow_up.location_id]] : []), { include_blank: 'Unassigned records only' }, class: 'select', data: { reconciliation_request_form_target: 'location' } %></div></div></details>
      <p class="text-xs text-mocha">Use the covered dates on the original. Register controls need a single business day, currency and exact location.</p>
    </fieldset>
    <fieldset class="space-y-4">
      <legend class="card-title">Who and when</legend>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><%= f.label :owner_id, 'Owner', class: 'field-label' %><%= f.select :owner_id, @owners.map { |user| [user.display_name, user.id] }, { include_blank: 'Unassigned' }, class: 'select' %></div>
        <div><%= f.label :due_on, 'Due date', class: 'field-label' %><%= f.date_field :due_on, required: true, class: 'input', data: { reconciliation_follow_up_form_target: 'due' } %><%= render 'due_shortcuts' %></div>
      </div>
      <div><%= f.label :notes, 'Request details / next step', class: 'field-label' %><%= f.text_area :notes, required: true, maxlength: 4000, rows: 4, class: 'input', placeholder: 'Who will provide the original? What will you check next?', data: { reconciliation_follow_up_form_target: 'notes' } %></div>
    </fieldset>
    <div class="form-actions"><%= f.submit 'Save', class: 'btn-primary' %><%= link_to 'Cancel', reconciliation_follow_ups_path, class: 'btn-ghost' %></div>
  <% end %>
</div>
