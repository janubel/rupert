<% close_context = local_assigns[:close_day]&.iso8601
   pill = if item.overdue? then ['pill-rose', 'Overdue']
          elsif item.status == 'closed' then ['pill-fern', ReconciliationFollowUp::STATUSES['closed']]
          elsif item.status == 'waiting' then ['pill-clay', ReconciliationFollowUp::STATUSES['waiting']]
          else ['pill-olive', ReconciliationFollowUp::STATUSES[item.status]] end %>
<article class="section-card min-w-0 <%= 'border-warn-edge' if item.overdue? %>">
  <div class="card-head">
    <div>
      <p class="eyebrow text-taupe"><%= reconciliation_source(item.source) %> · <%= ReconciliationFollowUp::CATEGORIES[item.category] %></p>
      <%= content_tag(local_assigns[:heading_tag] || :h2, class: 'card-title break-words') do %><%= link_to item.title, reconciliation_follow_up_path(item, close_day: close_context, queue: local_assigns[:queue_filters]), class: 'text-olive-deep hover:underline' %><% end %>
    </div>
    <span class="<%= pill.first %>"><%= pill.last %></span>
  </div>
  <p class="text-sm font-semibold"><%= reconciliation_due_label(item) %> · <%= item.due_on.strftime('%b %-d, %Y') %></p>
  <p class="text-sm"><%= item.owner&.display_name || 'Needs an owner' %> · <%= ReconciliationFollowUp::STATUSES[item.status] %></p>
  <p class="text-xs text-mocha"><%= item.period_from.strftime('%b %-d, %Y') %><%= item.period_to != item.period_from ? " – #{item.period_to.strftime('%b %-d, %Y')}" : '' %> · <%= item.document_kind.humanize %><%= item.currency.present? ? " · #{item.currency}" : '' %> · <%= item.document_id ? 'Original linked' : 'No original linked' %></p>
  <div class="rounded-card bg-haze p-3"><p class="text-xs font-semibold text-mocha">Latest next step / progress note</p><p class="mt-1 break-words whitespace-pre-line text-sm"><%= truncate(item.notes, length: 240) %></p></div>
  <div class="flex flex-wrap items-center gap-2">
    <% if Current.user.can?('reports.write') && item.status != 'closed' %><%= link_to 'Record progress', reconciliation_follow_up_path(item, close_day: close_context, queue: local_assigns[:queue_filters], anchor: 'record-progress'), class: 'btn-ghost btn-sm' %><% else %><%= link_to 'Open follow-up', reconciliation_follow_up_path(item, close_day: close_context, queue: local_assigns[:queue_filters]), class: 'btn-ghost btn-sm' %><% end %>
    <% if item.document_id %><%= link_to 'Download linked original', document_daily_reconciliation_path(item.document_id), class: 'btn-ghost btn-sm' %>
    <% else %><%= link_to 'Find retained original', reconciliation_documents_path(reconciliation_library_request_context(item, local_assigns[:close_day])), class: 'btn-ghost btn-sm' %><% if Current.user.can?('reports.write') && item.status != 'closed' %><%= link_to 'Add original', daily_reconciliations_path(request: item.id, close_day: close_context, anchor: 'upload-document'), class: 'btn-ghost btn-sm' %><% end %><% end %>
    <%= link_to 'Open covered day', daily_reconciliations_path(day: item.period_from.iso8601), class: 'text-xs font-semibold text-olive-deep hover:underline' %>
  </div>
</article>
