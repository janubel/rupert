<% content_for :title, 'Report requests & follow-ups' %>
<div class="space-y-6">
  <header class="flex flex-wrap justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-mocha">Money · Follow-through</p><h1 class="page-title mt-2">Report requests &amp; follow-ups</h1><p class="mt-2 text-sm text-mocha">Keep missing reports and difference investigations visible across business days.</p></div><div class="flex flex-wrap gap-2"><%= link_to 'Daily reconciliation', daily_reconciliations_path(day: @day&.iso8601), class: 'btn-ghost' %><%= link_to 'Document library', reconciliation_documents_path, class: 'btn-ghost' %><% if Current.user.can?('reports.write') %><%= link_to 'New follow-up', new_reconciliation_follow_up_path, class: 'btn-primary' %><% end %></div></header>
  <div class="grid grid-cols-2 gap-4"><%= link_to reconciliation_follow_ups_path(status: 'active'), class: 'card card-pad' do %><p class="text-sm">Open or waiting · all dates</p><p class="mt-1 font-display text-2xl"><%= @open_count %></p><% end %><%= link_to reconciliation_follow_ups_path(status: 'overdue'), class: 'card card-pad' do %><p class="text-sm">Overdue · all dates</p><p class="mt-1 font-display text-2xl"><%= @overdue_count %></p><% end %></div>
  <details class="card card-pad space-y-4" <%= 'open' if @status != 'active' || @source || @owner_filter || @day %>><summary class="cursor-pointer text-sm font-semibold">Filter by status, source, owner or business day</summary>
  <%= form_with url: reconciliation_follow_ups_path, method: :get, class: 'grid items-end gap-4 sm:grid-cols-2 lg:grid-cols-5', role: 'search' do |f| %>
    <div><%= f.label :status, 'Follow-up status', class: 'block text-sm' %><%= f.select :status, [['Open or waiting', 'active'], ['Open', 'open'], ['Waiting', 'waiting'], ['Overdue', 'overdue'], ['Closed', 'closed'], ['All statuses', 'all']], { selected: @status }, class: 'input' %></div>
    <div><%= f.label :source, 'Source', class: 'block text-sm' %><%= f.select :source, ReconciliationLibrary::SOURCE_NAMES.except('rupert').map { |key, name| [name, key] }, { include_blank: 'All sources', selected: @source }, class: 'input' %></div>
    <div><%= f.label :owner, 'Assigned to', class: 'block text-sm' %><%= f.select :owner, [['Me', 'mine'], ['Unassigned', 'unassigned']], { include_blank: 'Anyone', selected: @owner_filter }, class: 'input' %></div>
    <div><%= f.label :day, 'Covers business day', class: 'block text-sm' %><%= f.date_field :day, value: @day, class: 'input' %></div><div class="flex flex-wrap gap-2"><%= f.submit 'Filter follow-ups', class: 'btn-primary' %><%= link_to 'Clear', reconciliation_follow_ups_path, class: 'btn-ghost' %></div>
  <% end %></details>
  <p class="text-sm" role="status"><%= @pagy.count %> matching follow-ups · earliest due first</p>
  <div class="grid gap-4 md:grid-cols-2"><% @follow_ups.each do |item| %><%= render 'card', item: item %><% end %></div>
  <% if @follow_ups.empty? %><div class="card card-pad"><h2 class="font-display text-xl">No follow-ups match this view</h2><p class="mt-2 text-sm text-mocha">Change the filters or create a request for each report you expect. This queue shows saved requests.</p></div><% end %>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  <p class="text-xs text-mocha">Follow-ups are saved in Rupert. Status changes, assignments and notes remain in their history. Closing records a reviewer's decision; it does not assert a match or change source transactions.</p>
</div>
