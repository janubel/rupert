<% content_for :title, 'Report requests & follow-ups' %>
<div class="space-y-6">
  <header class="flex flex-wrap justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-mocha">Money · Follow-through</p><h1 class="page-title mt-2">Report requests &amp; follow-ups</h1><p class="mt-2 text-sm text-mocha">Keep missing reports and difference investigations visible across business days.</p></div><div class="flex flex-wrap gap-2"><%= link_to 'Across days', overview_reconciliation_follow_ups_path, class: 'btn-ghost' %><%= link_to 'Daily reconciliation', daily_reconciliations_path(day: @day&.iso8601), class: 'btn-ghost' %><%= link_to 'Document library', reconciliation_documents_path, class: 'btn-ghost' %><% if Current.user.can?('reports.write') %><%= link_to 'New follow-up', new_reconciliation_follow_up_path, class: 'btn-primary' %><% end %></div></header>
  <% if @original %><section class="card card-pad space-y-3" aria-label="Original coverage filter"><h2 class="font-semibold break-words">Follow-ups matching <%= @original.filename %></h2><p class="text-sm text-mocha">Same source and document kind, with the full requested period covered<%= @original.kind == 'register_control' ? ', currency and location matched' : '' %>. Review the contents before linking.</p><div class="flex flex-wrap gap-2"><%= link_to 'Review original', document_daily_reconciliation_path(@original), class: 'btn-ghost btn-sm' %><%= link_to 'Remove original filter', reconciliation_follow_ups_path(request.query_parameters.except('original', 'page')), class: 'btn-ghost btn-sm' %></div></section><% end %>
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-5" aria-label="Follow-up shortcuts across all dates">
    <% [['Open or waiting', @open_count, {}], ['Overdue', @overdue_count, { status: 'overdue' }], ['Due today', @today_count, { status: 'today' }], ['Unassigned', @unassigned_count, { owner: 'unassigned' }], ['Reports without a linked original', @missing_file_count, { category: 'missing_report', evidence: 'missing' }]].each do |label, count, filters| %><%= link_to reconciliation_follow_ups_path(filters), class: "card card-pad #{filters[:status] == 'overdue' && count.positive? ? 'border-amber-300 bg-amber-50' : ''}" do %><p class="text-sm"><%= label %> · all dates</p><p class="mt-1 font-display text-2xl"><%= count %></p><% end %><% end %>
  </div>
  <nav class="flex flex-wrap gap-2" aria-label="Follow-up purpose"><% [['All purposes', nil], ['Missing reports', 'missing_report'], ['Difference investigations', 'difference']].each do |label, category| %><%= link_to label, reconciliation_follow_ups_path(request.query_parameters.except('page').merge('category' => category)), class: @category == category ? 'btn-primary btn-sm' : 'btn-ghost btn-sm', aria: { current: @category == category ? 'page' : nil } %><% end %></nav>
  <details class="card card-pad space-y-4" <%= 'open' if @status != 'active' || @source || @owner_filter || @day || @category || @evidence_filter %>><summary class="cursor-pointer text-sm font-semibold">Filter by status, source, owner, evidence or business day</summary>
  <%= form_with url: reconciliation_follow_ups_path, method: :get, class: 'grid items-end gap-4 sm:grid-cols-2 lg:grid-cols-5', role: 'search' do |f| %>
    <%= f.hidden_field :original, value: @original.id if @original %>
    <div><%= f.label :status, 'Follow-up status', class: 'block text-sm' %><%= f.select :status, [['Open or waiting', 'active'], ['Open', 'open'], ['Waiting', 'waiting'], ['Overdue', 'overdue'], ['Due today', 'today'], ['Closed', 'closed'], ['All statuses', 'all']], { selected: @status }, class: 'input' %></div>
    <div><%= f.label :source, 'Source', class: 'block text-sm' %><%= f.select :source, ReconciliationLibrary::SOURCE_NAMES.except('rupert').map { |key, name| [name, key] }, { include_blank: 'All sources', selected: @source }, class: 'input' %></div>
    <div><%= f.label :owner, 'Assigned to', class: 'block text-sm' %><%= f.select :owner, [['Me', 'mine'], ['Unassigned', 'unassigned']], { include_blank: 'Anyone', selected: @owner_filter }, class: 'input' %></div>
    <div><%= f.label :category, 'Purpose', class: 'block text-sm' %><%= f.select :category, ReconciliationFollowUp::CATEGORIES.map { |key, name| [name, key] }, { include_blank: 'All purposes', selected: @category }, class: 'input' %></div>
    <div><%= f.label :evidence, 'Retained evidence', class: 'block text-sm' %><%= f.select :evidence, [['No original linked', 'missing']], { include_blank: 'Any evidence state', selected: @evidence_filter }, class: 'input' %></div>
    <div><%= f.label :day, 'Covers business day', class: 'block text-sm' %><%= f.date_field :day, value: @day, class: 'input' %></div><div class="flex flex-wrap gap-2"><%= f.submit 'Filter follow-ups', class: 'btn-primary' %><%= link_to 'Clear', reconciliation_follow_ups_path, class: 'btn-ghost' %></div>
  <% end %></details>
  <p class="text-sm" role="status"><%= @pagy.count %> matching follow-ups · earliest due first<%= " · covers #{@day.strftime('%b %-d, %Y')}" if @day %><%= " · #{reconciliation_source(@source)}" if @source %><%= " · #{ReconciliationFollowUp::CATEGORIES[@category]}" if @category %><%= ' · no original linked' if @evidence_filter %></p><p class="text-xs text-mocha">Shortcut counts cover all dates; the list uses your selected filters. A file may already be retained but not linked to its request.</p>
  <div class="grid gap-4 md:grid-cols-2"><% @follow_ups.each do |item| %><%= render 'card', item: item, close_day: @day %><% end %></div>
  <% if @follow_ups.empty? %><div class="card card-pad"><h2 class="font-display text-xl">No follow-ups match this view</h2><p class="mt-2 text-sm text-mocha">Change the filters or create a request for each report you expect. This queue shows saved requests.</p></div><% end %>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  <p class="text-xs text-mocha">Follow-ups are saved in Rupert. Status changes, assignments and notes remain in their history. Closing records a reviewer's decision; it does not assert a match or change source transactions.</p>
</div>
