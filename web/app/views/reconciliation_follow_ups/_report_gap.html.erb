<article class="section-card min-w-0 border-warn-edge">
  <div class="card-head"><div><h3 class="card-title"><%= reconciliation_source(row[:source]) %> · <%= row[:currency].presence || 'Unknown currency' %></h3><p class="card-hint"><%= row[:day].strftime('%A, %b %-d, %Y') %> · <%= @locations_by_id[row[:location_id]]&.name || row[:location_id].presence || 'Unassigned records only' %></p></div><span class="pill-clay">Not requested</span></div>
  <div class="flex flex-wrap gap-2"><%= link_to 'Find retained reports', reconciliation_documents_path(reconciliation_missing_control_search(row, row[:day])), class: 'btn-ghost btn-sm' %><% if Current.user.can?('reports.write') && ReconciliationDocument::SOURCES.excluding('rupert').include?(row[:source]) && row[:currency].to_s.match?(/\A[A-Z]{3}\z/) %><%= link_to 'Track missing report', new_reconciliation_follow_up_path(reconciliation_follow_up_context(row, row[:day], category: 'missing_report')), class: 'btn-ghost btn-sm' %><% end %><%= link_to 'Open day', daily_reconciliations_path(day: row[:day].iso8601, anchor: 'missing-controls'), class: 'btn-ghost btn-sm' %></div>
</article>
