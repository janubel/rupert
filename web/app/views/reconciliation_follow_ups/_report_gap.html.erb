<article class="rounded-xl border border-amber-300 bg-paper p-4 space-y-3 min-w-0">
  <div class="flex flex-wrap items-start justify-between gap-2"><div><h3 class="font-semibold"><%= reconciliation_source(row[:source]) %> · <%= row[:currency].presence || 'Unknown currency' %></h3><p class="mt-1 text-sm"><%= row[:day].strftime('%A, %b %-d, %Y') %></p><p class="mt-1 break-words text-xs text-mocha"><%= @locations_by_id[row[:location_id]]&.name || row[:location_id].presence || 'Unassigned records only' %></p></div><span class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-950">Not requested</span></div>
  <div class="flex flex-wrap gap-2"><%= link_to 'Find retained reports', reconciliation_documents_path(source: ReconciliationLibrary::SOURCE_NAMES.key?(row[:source]) ? row[:source] : nil, from: row[:day].iso8601, to: row[:day].iso8601), class: 'btn-ghost btn-sm' %><% if Current.user.can?('reports.write') && ReconciliationDocument::SOURCES.excluding('rupert').include?(row[:source]) && row[:currency].to_s.match?(/\A[A-Z]{3}\z/) %><%= link_to 'Track missing report', new_reconciliation_follow_up_path(reconciliation_follow_up_context(row, row[:day], category: 'missing_report')), class: 'btn-primary btn-sm' %><% end %><%= link_to 'Review day', daily_reconciliations_path(day: row[:day].iso8601, anchor: 'missing-controls'), class: 'btn-ghost btn-sm' %></div>
</article>
