<% content_for :title, 'Reconciliation across days' %>
<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-mocha">Money · Across days</p><h1 class="page-title mt-2">What still needs attention?</h1><p class="mt-2 text-sm text-mocha">Compare close checks, review and retained versions across seven business dates. Keep report requests moving across all dates. Tracking stays in Rupert; no email or message is sent.</p><p class="mt-2 text-xs text-mocha"><%= @overview.starting_on.strftime('%b %-d, %Y') %> – <%= @overview.ending_on.strftime('%b %-d, %Y') %> · <a href="#business-days" class="text-olive underline">Change dates</a></p></div><div class="flex flex-wrap gap-2"><%= link_to 'All follow-ups', reconciliation_follow_ups_path, class: 'btn-ghost' %><%= link_to 'Document library', reconciliation_documents_path, class: 'btn-ghost' %><% if Current.user.can?('reports.write') %><%= link_to 'Track an expected report', new_reconciliation_follow_up_path, class: 'btn-primary' %><% end %></div></header>
  <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Attention overview">
    <a href="#business-days" class="card card-pad"><p class="text-sm">Dates with report / follow-up issues · selected week</p><p class="mt-1 font-display text-2xl"><%= @overview.days_needing_attention %> <span class="text-sm">of 7</span></p></a>
    <a href="#report-gaps" class="card card-pad <%= @overview.untracked_reports.any? ? 'border-amber-300 bg-amber-50' : '' %>"><p class="text-sm font-semibold">Register reports to request · selected dates</p><p class="mt-1 font-display text-2xl"><%= @overview.untracked_reports.size %></p></a>
    <%= link_to reconciliation_follow_ups_path(status: 'overdue'), class: "card card-pad #{@overdue_count.positive? ? 'border-amber-300 bg-amber-50' : ''}" do %><p class="text-sm">Overdue follow-ups · all dates</p><p class="mt-1 font-display text-2xl"><%= @overdue_count %></p><% end %>
    <%= link_to reconciliation_follow_ups_path(status: 'today'), class: 'card card-pad' do %><p class="text-sm">Due today · all dates</p><p class="mt-1 font-display text-2xl"><%= @today_count %></p><% end %>
  </section>
  <% if @next_follow_ups.any? %><section id="priority-follow-ups" class="scroll-mt-48 md:scroll-mt-32 space-y-4" aria-labelledby="next-follow-ups"><div class="flex flex-wrap justify-between gap-3"><div><h2 id="next-follow-ups" class="font-display text-2xl">Follow up next · all dates</h2><p class="mt-1 text-sm text-mocha">Overdue first, then due today and upcoming. Includes requests outside the selected week.</p></div><%= link_to 'Open full queue', reconciliation_follow_ups_path, class: 'btn-ghost' %></div><div class="grid gap-4 md:grid-cols-2"><%= render partial: 'card', collection: @next_follow_ups, as: :item, locals: { heading_tag: :h3 } %></div></section><% end %>
  <section id="report-gaps" class="scroll-mt-48 md:scroll-mt-32 space-y-4" aria-labelledby="report-gaps-title">
    <div><h2 id="report-gaps-title" class="font-display text-2xl">Register reports to request</h2><p class="mt-1 text-sm text-mocha">Recorded pools with no current register control and no open report request in the selected seven dates. Check retained files first. Oldest date first.</p></div>
    <% if @overview.untracked_reports.any? %><div class="grid gap-3 lg:grid-cols-3"><%= render partial: 'report_gap', collection: @overview.untracked_reports.first(3), as: :row %></div>
      <% if @overview.untracked_reports.size > 3 %><details class="card card-pad"><summary class="cursor-pointer font-semibold">Show <%= pluralize(@overview.untracked_reports.size - 3, 'more report gap') %></summary><div class="mt-4 grid gap-3 lg:grid-cols-3"><%= render partial: 'report_gap', collection: @overview.untracked_reports.drop(3), as: :row %></div></details><% end %>
    <% else %><p class="card card-pad text-sm">No unrequested register-control gaps in the selected dates. Check open follow-ups and track any other invoices or statements you expect.</p><% end %>
  </section>
  <section id="business-days" class="scroll-mt-48 md:scroll-mt-32 space-y-4" aria-labelledby="business-days-title">
    <div><h2 id="business-days-title" class="font-display text-2xl">Business dates at a glance</h2><p class="mt-1 text-sm text-mocha"><%= @overview.starting_on.strftime('%b %-d, %Y') %> – <%= @overview.ending_on.strftime('%b %-d, %Y') %> · Eastern time · live local records</p></div>
    <div class="card card-pad flex flex-wrap items-end justify-between gap-3"><%= form_with url: overview_reconciliation_follow_ups_path, method: :get, class: 'flex flex-wrap items-end gap-3' do |f| %><div><%= f.label :ending_on, 'Seven days ending', class: 'block text-sm font-semibold' %><%= f.date_field :ending_on, value: @overview.ending_on, required: true, class: 'input' %></div><%= f.submit 'Show dates', class: 'btn-primary' %><% end %><nav class="flex flex-wrap gap-2" aria-label="Week navigation"><%= link_to 'Previous 7 days', overview_reconciliation_follow_ups_path(ending_on: (@overview.ending_on - 7).iso8601), class: 'btn-ghost btn-sm' %><%= link_to 'Through yesterday', overview_reconciliation_follow_ups_path, class: 'btn-ghost btn-sm' %><%= link_to 'Include today', overview_reconciliation_follow_ups_path(ending_on: Date.current.iso8601), class: 'btn-ghost btn-sm' %><%= link_to 'Next 7 days', overview_reconciliation_follow_ups_path(ending_on: (@overview.ending_on + 7).iso8601), class: 'btn-ghost btn-sm' %></nav></div>
    <nav class="grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7" aria-label="Jump to a business date">
      <% @overview.days.reverse.each do |entry| %><%= link_to "#day-#{entry[:day].iso8601}", class: "rounded-xl border bg-paper p-3 #{entry[:counts].values.any?(&:positive?) || entry[:overdue].positive? ? 'border-amber-300' : 'border-fog'}" do %><p class="text-sm font-semibold"><%= entry[:day].strftime('%a %-d') %></p><p class="mt-2 text-xs">Missing: <%= entry[:counts][:missing_controls] %></p><p class="mt-1 text-xs">Issues: <%= entry[:counts].values_at(:variances, :unavailable, :conflicts).sum %></p><p class="mt-1 text-xs">Overdue: <%= entry[:overdue] %></p><p class="mt-1 text-xs"><%= entry[:close][:review] %></p><p class="mt-1 text-xs"><%= entry[:close][:package_id] ? (entry[:close][:package_current] ? 'Package current' : 'Package changed') : 'No close package' %></p><% end %><% end %>
    </nav>
    <% @overview.days.each do |entry| %>
      <% day = entry[:day]; counts = entry[:counts]; issues = counts[:variances] + counts[:unavailable] + counts[:conflicts] %>
      <article id="day-<%= day.iso8601 %>" class="card card-pad min-w-0 scroll-mt-48 md:scroll-mt-32 space-y-4" aria-label="Business date <%= day.iso8601 %>">
        <div class="flex flex-wrap items-start justify-between gap-3"><div><h3 class="font-display text-xl"><%= day.strftime('%A, %b %-d') %><%= ' · Today, still in progress' if day == Date.current %></h3><p class="mt-1 text-xs text-mocha"><%= entry[:untracked].positive? ? "#{pluralize(entry[:untracked], 'register report')} without an open request" : 'No untracked register-report gaps in recorded pools' %></p></div><%= link_to 'Review day', daily_reconciliations_path(day: day.iso8601, anchor: 'attention-items'), class: 'btn-ghost btn-sm' %></div>
        <%= render 'financial_close/date_status', entry: entry %>
        <div class="flex flex-wrap gap-2 text-sm"><%= link_to "Missing controls · #{counts[:missing_controls]}", daily_reconciliations_path(day: day.iso8601, anchor: 'missing-controls'), class: "rounded-full border px-3 py-2 #{counts[:missing_controls].positive? ? 'border-amber-300 bg-amber-50 text-amber-950' : 'border-fog'}" %><%= link_to "Comparison issues · #{issues}", daily_reconciliations_path(day: day.iso8601, comparison: 'attention', anchor: 'control-comparisons'), class: "rounded-full border px-3 py-2 #{issues.positive? ? 'border-amber-300 bg-amber-50 text-amber-950' : 'border-fog'}" %><%= link_to "Open follow-ups · #{entry[:follow_ups]}", reconciliation_follow_ups_path(day: day.iso8601), class: 'rounded-full border border-fog px-3 py-2' %></div>
        <% if issues.positive? %><p class="text-xs text-mocha"><%= counts[:variances] %> differences · <%= counts[:unavailable] %> unavailable comparisons · <%= counts[:conflicts] %> conflicting controls. Open the day for amounts by currency.</p><% end %>
        <% entry[:missing].first(3).each do |row| %><div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-fog p-3"><div><p class="text-sm font-semibold"><%= reconciliation_source(row[:source]) %> · <%= row[:currency].presence || 'Unknown currency' %></p><p class="text-xs text-mocha"><%= @locations_by_id[row[:location_id]]&.name || row[:location_id].presence || 'Unassigned records only' %> · control not supplied</p></div><% if row[:request_id] %><%= link_to 'Open existing request', reconciliation_follow_up_path(row[:request_id]), class: 'btn-ghost btn-sm' %><% elsif Current.user.can?('reports.write') && ReconciliationDocument::SOURCES.excluding('rupert').include?(row[:source]) && row[:currency].to_s.match?(/\A[A-Z]{3}\z/) %><%= link_to 'Track missing report', new_reconciliation_follow_up_path(reconciliation_follow_up_context(row, day, category: 'missing_report')), class: 'btn-primary btn-sm' %><% else %><%= link_to 'Find retained reports', reconciliation_documents_path(from: day.iso8601, to: day.iso8601), class: 'btn-ghost btn-sm' %><% end %></div><% end %>
        <% if entry[:missing].size > 3 %><%= link_to "See all #{entry[:missing].size} missing register controls", daily_reconciliations_path(day: day.iso8601, anchor: 'missing-controls'), class: 'text-sm text-olive underline' %><% end %>
        <% if counts.values.all?(&:zero?) && entry[:follow_ups].zero? %><p class="text-sm text-mocha">No control gaps, comparison issues or saved open requests found in this view. This does not confirm that all expected reports have arrived.</p><% end %>
      </article>
    <% end %>
    <p class="text-xs text-mocha">Missing controls come from recorded source/currency/location pools. Expected bank statements, invoices and other reports need an explicit request. A monthly request appears on each covered date; it remains one request. No amounts or overlapping reports are summed. This view does not certify a day as complete.</p>
  </section>

</div>
