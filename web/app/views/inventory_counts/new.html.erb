<% count = @count %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Manual count sheet</h1>
      <p class="mt-1 text-sm text-mocha">
        <% if @prepared %>
          Every SKU is pre-filled with its current system quantity. Fill in the <em>Counted</em> column with what's physically on hand, then submit for approval.
        <% else %>
          Record what's physically on hand per SKU. Approved counts are kept as audit worksheets — they do not change inventory (Square is the source of truth until Rupert takes over).
        <% end %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <% if @prepared %>
        <%= link_to "Start blank sheet", new_inventory_count_path(prepared: 0), class: "btn-ghost btn-sm" %>
      <% else %>
        <%= link_to "Prepared sheet", new_inventory_count_path, class: "btn-ghost btn-sm" %>
      <% end %>
    </div>
  </section>

  <%= form_tag inventory_counts_path, method: :post, class: "space-y-6", data: { controller: "count-sheet", action: "keydown->count-sheet#advanceOnEnter" } do %>
    <div class="card card-pad space-y-4">
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <label class="mb-1 block text-sm font-medium text-ink">Date &amp; time counted</label>
          <%= datetime_field_tag "inventory_count[countedAt]", count.countedAt&.strftime("%Y-%m-%dT%H:%M"), class: "input" %>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-ink">Location <span class="text-taupe">(optional)</span></label>
          <select name="inventory_count[locationId]" class="input">
            <option value="">— no specific location —</option>
            <% @locations.each do |loc| %>
              <option value="<%= loc.id %>" <%= "selected" if count.locationId == loc.id %>><%= loc.name %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-ink">Note <span class="text-taupe">(optional)</span></label>
          <input type="text" name="inventory_count[note]" value="<%= count.note %>" placeholder="e.g. end-of-week stocktake" class="input">
        </div>
      </div>
    </div>

    <% if @prepared %>
      <div class="card overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-fog px-5 py-3">
          <h2 class="font-display text-xl text-ink">Inventory sheet</h2>
          <span class="text-xs text-taupe"><%= @count.items.size %> SKUs</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm" id="count-table">
            <thead class="border-b border-fog bg-haze/60">
              <tr>
                <th scope="col" class="th">SKU</th>
                <th scope="col" class="th">Product</th>
                <th scope="col" class="th">Variant</th>
                <th scope="col" class="th text-right">System</th>
                <th scope="col" class="th text-right w-28">Counted <span class="font-normal normal-case text-taupe">(override)</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-fog">
              <% @count.items.each_with_index do |item, index| %>
                <tr data-row>
                  <td class="td font-mono text-xs text-mocha"><%= item.sku %></td>
                  <td class="td text-ink"><%= item.shopify_variant&.product&.title || "—" %></td>
                  <td class="td text-mocha"><%= item.shopify_variant&.title || "—" %></td>
                  <td class="td text-right text-mocha"><%= item.quantity %></td>
                  <td class="td">
                    <input type="number" name="items[<%= index %>][quantity]" min="0" value="<%= item.quantity %>"
                      class="input w-24 text-right" autocomplete="off" data-count-input>
                    <input type="hidden" name="items[<%= index %>][sku]" value="<%= item.sku %>">
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <p class="border-t border-fog px-5 py-3 text-xs text-taupe">
          Tip: press <kbd class="rounded bg-haze px-1">Enter</kbd> to jump to the next row's count. Rows left at their system quantity record no change on approval.
        </p>
      </div>
    <% else %>
      <div class="card card-pad">
        <div class="flex items-baseline justify-between">
          <h2 class="font-display text-xl text-ink">Counted items</h2>
          <button type="button" data-action="click->count-sheet#addRow" class="btn-ghost btn-sm">Add row</button>
        </div>
        <div data-count-sheet-target="rows" data-action="click->count-sheet#removeRow" class="mt-3 space-y-2">
          <% count.items.each do |item| %>
            <%= render "item_row", item: item %>
          <% end %>
        </div>
        <p class="mt-3 text-xs text-taupe">Type a SKU (autocomplete offers known SKUs) and the counted quantity.</p>
      </div>
    <% end %>

    <div class="flex items-center gap-3">
      <%= submit_tag "Save draft", class: "btn-primary" %>
      <%= link_to "Cancel", inventory_counts_path, class: "btn-ghost" %>
    </div>
  <% end %>

  <% unless @prepared %>
    <datalist id="known-skus">
      <% @skus.each do |sku| %>
        <option value="<%= sku %>"></option>
      <% end %>
    </datalist>

    <template data-count-sheet-target="template">
      <div data-row class="flex items-center gap-2">
        <input type="text" name="items[][sku]" list="known-skus" placeholder="SKU" class="input flex-1 font-mono" autocomplete="off">
        <input type="number" name="items[][quantity]" min="0" placeholder="Qty" class="input w-24">
        <button type="button" data-remove-row class="text-xs font-medium text-taupe hover:text-rose">Remove</button>
      </div>
    </template>
  <% end %>
</div>

