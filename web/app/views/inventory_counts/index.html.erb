<% content_for :title, 'Physical counts' %>
<div class="space-y-6">
  <%= page_header 'Physical counts', subtitle: 'Count worksheets kept for review.',
        menu: (Current.user.can?('inventory.write') ? [['Start scan count', new_inventory_count_path(prepared: 0, start_scanning: 1)]] : nil) do %>
    <% if Current.user.can?('inventory.write') %>
      <%= link_to 'Add count', new_inventory_count_path, class: 'btn-primary', data: { tour: 'start' } %>
    <% end %>
  <% end %>

  <div class="toolbar-band">
    <%= form_tag inventory_counts_path, method: :get, class: 'toolbar', data: { tour: 'status' } do %>
      <div class="toolbar-field">
        <%= label_tag :status, 'Status', class: 'field-label' %>
        <%= select_tag :status, options_for_select([['All statuses', ''], ['Draft', 'draft'], ['Pending', 'pending'], ['Approved', 'approved'], ['Rejected', 'rejected']], params[:status].to_s), class: 'input' %>
      </div>
      <div class="toolbar-actions">
        <%= submit_tag 'Apply', class: 'btn-primary', name: nil %>
        <%= link_to 'Clear', inventory_counts_path, class: 'btn-ghost' %>
      </div>
    <% end %>
  </div>

  <div class="card overflow-hidden" <%= tour_anchor('table') %>>
    <div class="table-region" role="region" tabindex="0" aria-label="Physical counts">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Counted at</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th num">Items</th>
            <th scope="col" class="th num">Total qty</th>
            <th scope="col" class="th">Location</th>
            <th scope="col" class="th">By</th>
            <th scope="col" class="th"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @counts.empty? %>
            <tr>
              <td colspan="7" class="empty-row">
                <%= params[:status].present? ? 'No counts with that status.' : 'No counts yet.' %>
                <% if params[:status].present? %><%= link_to 'Show all counts', inventory_counts_path, class: 'ml-2 font-semibold text-olive-deep underline' %><% elsif Current.user.can?('inventory.write') %><%= link_to 'Add your first count', new_inventory_count_path, class: 'ml-2 font-semibold text-olive-deep underline' %><% end %>
              </td>
            </tr>
          <% end %>
          <% @counts.each do |count| %>
            <tr>
              <td class="td whitespace-nowrap text-mocha"><%= l(count.countedAt, format: :short) %></td>
              <td class="td">
                <span class="<%= count.draft? ? 'pill-taupe' : count.pending? ? 'pill-clay' : count.approved? ? 'pill-fern' : 'pill-rose' %>"><%= count.status.humanize %></span>
              </td>
              <td class="td num text-mocha"><%= count.items.count %></td>
              <td class="td num font-medium text-ink"><%= count.total_quantity %></td>
              <td class="td text-mocha"><%= count.location&.name || '—' %></td>
              <td class="td text-mocha"><%= count.createdBy.presence || '—' %></td>
              <td class="td text-right">
                <%= link_to 'Open', inventory_count_path(count), class: 'btn-ghost btn-sm' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <details class="explainer">
    <summary class="explainer-summary">What approving a count does</summary>
    <p class="mt-1 text-sm text-mocha">C-Trax is the retail physical-count reference. A worksheet compares what was counted with the stored mirror at submission; approving keeps it as an audit record and writes nothing to Shopify, Square or C-Trax.</p>
  </details>
</div>
