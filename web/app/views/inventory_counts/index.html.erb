<% content_for :title, "Inventory counts" %>
<div class="space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :stock %>
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Manual counts</h1>
      <p class="mt-1 text-sm text-mocha">Physical count worksheets retained for review. C-Trax is the retail physical-count reference. Approval records the count in Rupert without changing platform inventory.</p>
    </div>
    <% if Current.user.can?('inventory.write') %>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Start scan count", new_inventory_count_path(prepared: 0, start_scanning: 1), class: "btn-primary" %>
        <%= link_to "New count sheet", new_inventory_count_path, class: "btn-ghost" %>
      </div>
    <% end %>
  </section>

  <div class="flex flex-wrap items-center gap-2 text-sm">
    <% { "" => "All", "draft" => "Draft", "pending" => "Pending", "approved" => "Approved", "rejected" => "Rejected" }.each do |status, label| %>
      <%= link_to label, inventory_counts_path(status: status.presence),
        class: (params[:status].to_s == status ? "rounded-full bg-olive px-3.5 py-1.5 font-medium text-cream" : "rounded-full px-3.5 py-1.5 font-medium text-mocha hover:bg-haze hover:text-ink") %>
    <% end %>
  </div>

  <div class="card overflow-hidden">
    <div class="operations-table-region" role="region" tabindex="0" aria-label="Inventory Counts table">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Counted at</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th">Items</th>
            <th scope="col" class="th text-right">Total qty</th>
            <th scope="col" class="th">Location</th>
            <th scope="col" class="th">By</th>
            <th scope="col" class="th"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @counts.empty? %>
            <tr>
              <td colspan="7" class="td py-8 text-center">
                <p class="text-taupe">No counts yet.</p>
                <% if Current.user.can?('inventory.write') %><%= link_to "Start a manual inventory", new_inventory_count_path, class: "btn-primary btn-sm mt-2" %><% end %>
              </td>
            </tr>
          <% end %>
          <% @counts.each do |count| %>
            <tr class="hover:bg-cream">
              <td class="td whitespace-nowrap text-mocha"><%= l(count.countedAt, format: :short) %></td>
              <td class="td">
                <span class="<%= count.draft? ? "pill-taupe" : count.pending? ? "pill-clay" : count.approved? ? "pill-fern" : "pill-rose" %>"><%= count.status %></span>
              </td>
              <td class="td text-mocha"><%= count.items.count %></td>
              <td class="td text-right font-medium text-ink"><%= count.total_quantity %></td>
              <td class="td text-mocha"><%= count.location&.name || "—" %></td>
              <td class="td text-mocha"><%= count.createdBy.presence || "—" %></td>
              <td class="td text-right">
                <%= link_to "View", inventory_count_path(count), class: "text-xs font-semibold text-olive hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
