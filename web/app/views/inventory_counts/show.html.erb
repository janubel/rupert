<% count = @count %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="page-title">Manual count</h1>
        <span class="<%= count.draft? ? "pill-taupe" : count.pending? ? "pill-clay" : count.approved? ? "pill-fern" : "pill-rose" %>"><%= count.status %></span>
      </div>
      <p class="mt-1 text-sm text-mocha">
        Counted <%= l(count.countedAt, format: :long) %> · <%= count.location&.name || "no location" %> ·
        recorded by <%= count.createdBy.presence || "—" %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if count.draft? && Current.user.can?('inventory.write') %>
        <%= link_to "Scan count", scan_inventory_count_path(count), class: "btn-primary" %>
        <%= link_to "Edit", edit_inventory_count_path(count), class: "btn-ghost" %>
        <%= button_to "Submit for approval", submit_inventory_count_path(count), method: :post, class: "btn-primary", data: { turbo: false } %>
        <%= button_to "Delete", inventory_count_path(count), method: :delete, class: "btn-ghost", data: { confirm: "Delete this draft count?" } %>
      <% elsif count.pending? && Current.user.can?('inventory.write') %>
        <%= button_to "Approve count", approve_inventory_count_path(count), method: :post, class: "btn-primary", data: { confirm: "Approve this count? It is recorded for audit and does not change inventory — Square is the source of truth." } %>
        <%= button_to "Reject", reject_inventory_count_path(count), method: :post, class: "btn-ghost", data: { turbo: false } %>
      <% elsif count.rejected? && Current.user.can?('inventory.write') %>
        <%= button_to "Reopen as draft", reopen_inventory_count_path(count), method: :post, class: "btn-ghost", data: { turbo: false } %>
      <% end %>
    </div>
  </section>

  <% if count.note.present? %>
    <p class="rounded-xl bg-haze px-4 py-3 text-sm text-mocha"><%= count.note %></p>
  <% end %>

  <% if count.approved? %>
    <p class="flash flash-notice">
      Approved <%= l(count.approvedAt, format: :long) %> as an audit record. Overrides are disabled until
      Rupert becomes the source of truth — Square is the source of truth today, so counted quantities do
      not change inventory.
    </p>
  <% end %>

  <p class="text-sm text-mocha">Comparisons use the stored mirror at submission for one platform, location and item. Missing or ambiguous pools have no numerical delta. A mirror comparison does not verify current platform stock, native location provenance or sync completeness. Legacy Shopify rows may contain an aggregate assigned to the primary location.</p>

  <div class="card overflow-hidden">
    <div class="card-pad pb-3">
      <h2 class="font-display text-xl text-ink">Counted items</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Item</th>
            <th scope="col" class="th text-right">Counted</th>
            <th scope="col" class="th text-right">Mirrored stock</th>
            <th scope="col" class="th text-right">Delta</th>
            <th scope="col" class="th">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if count.items.empty? %>
            <tr>
              <td class="empty-row">No items recorded.</td>
            </tr>
          <% end %>
          <% count.items.order(:sku).each do |item| %>
            <tr class="hover:bg-cream">
              <td class="td">
                <div class="flex items-center gap-3">
                  <% if item.inventory_thumbnail %>
                    <%= image_tag item.inventory_thumbnail, alt: item.sku, loading: "lazy", class: "h-10 w-10 shrink-0 rounded-lg border border-fog bg-haze object-cover" %>
                  <% else %>
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-fog bg-haze font-display text-base text-taupe"><%= item.sku.first.upcase %></span>
                  <% end %>
                  <div class="min-w-0">
                    <p class="truncate font-medium text-ink"><%= item.inventory_title.presence || item.sku %></p>
                    <p class="font-mono text-xs text-taupe"><%= item.sku %></p>
                  </div>
                </div>
              </td>
              <td class="td text-right font-medium text-ink"><%= item.quantity %></td>
              <td class="td text-right text-mocha">
                <p><%= item.previousQuantity.presence || "—" %></p>
                <p class="mt-1 max-w-xs text-xs text-taupe"><%= item.comparison_label %></p>
                <% if item.comparison['status'] == 'matched' %>
                  <p class="mt-1 text-xs text-taupe">Item <%= item.comparison['source_item_id'] %> · mirror <%= item.comparison['mirrored_at'] || "time unavailable" %></p>
                <% end %>
              </td>
              <td class="td text-right">
                <% if item.delta.nil? %>
                  <span class="text-taupe">—</span>
                <% else %>
                  <span class="<%= item.delta.zero? ? "text-taupe" : item.delta.positive? ? "text-fern" : "text-rose" %>">
                    <%= item.delta.positive? ? "+#{item.delta}" : item.delta %>
                  </span>
                <% end %>
              </td>
              <td class="td">
                <% if item.applied? %>
                  <span class="pill-fern">applied</span>
                <% elsif count.approved? %>
                  <span class="pill-taupe">recorded</span>
                <% elsif item.shopifyVariantId.present? || item.squareVariationId.present? %>
                  <span class="pill-taupe">linked</span>
                <% else %>
                  <span class="pill-rose">unlinked</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
