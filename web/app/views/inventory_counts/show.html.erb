<% count = @count %>
<% content_for :title, "Count · #{l(count.countedAt, format: :short)}" %>
<% can_write = Current.user.can?('inventory.write') %>
<% menu = [] %>
<% if count.draft? && can_write %>
  <% menu << ['Edit', edit_inventory_count_path(count)] %>
  <% menu << ['Remove', inventory_count_path(count), { method: :delete, data: { turbo_confirm: 'Remove this draft count?' } }] %>
<% elsif count.pending? && can_write %>
  <% menu << ['Reject', reject_inventory_count_path(count), { method: :post, data: { turbo: false } }] %>
<% elsif count.rejected? && can_write %>
  <% menu << ['Reopen as draft', reopen_inventory_count_path(count), { method: :post, data: { turbo: false } }] %>
<% end %>
<div class="space-y-6">
  <%= page_header "Count · #{l(count.countedAt, format: :short)}", subtitle: "#{count.location&.name || 'No location'} · recorded by #{count.createdBy.presence || '—'}", menu: menu do %>
    <% if count.draft? && can_write %>
      <%= link_to 'Scan count', scan_inventory_count_path(count), class: 'btn-ghost' %>
      <%= button_to 'Submit for approval', submit_inventory_count_path(count), method: :post, class: 'btn-primary', form_class: 'contents', data: { turbo: false } %>
    <% elsif count.pending? && can_write %>
      <%= button_to 'Approve', approve_inventory_count_path(count), method: :post, class: 'btn-primary', form_class: 'contents', data: { turbo_confirm: 'Approve this count? It is recorded for audit and does not change platform inventory.' } %>
    <% end %>
  <% end %>

  <dl class="facts">
    <div><dt>Status</dt><dd><span class="<%= count.draft? ? 'pill-taupe' : count.pending? ? 'pill-clay' : count.approved? ? 'pill-fern' : 'pill-rose' %>"><%= count.status.humanize %></span></dd></div>
    <div><dt>Counted</dt><dd><%= l(count.countedAt, format: :long) %></dd></div>
    <div><dt>Location</dt><dd><%= count.location&.name || 'No location' %></dd></div>
    <div><dt>Recorded by</dt><dd><%= count.createdBy.presence || '—' %></dd></div>
    <% if count.approved? %><div><dt>Approved</dt><dd><%= l(count.approvedAt, format: :long) %></dd></div><% end %>
    <% if count.note.present? %><div><dt>Note</dt><dd><%= count.note %></dd></div><% end %>
  </dl>

  <% if count.approved? %>
    <p class="flash flash-notice" role="status">Approved as an audit record. Counted quantities do not change platform inventory.</p>
  <% end %>

  <%= fold_explainer('Comparisons freeze one source, location and item at submission. New Shopify comparisons use signed native on-hand snapshots less than one hour old with matching catalog identity; available stock and legacy aggregates are excluded. Missing or ambiguous pools have no numerical delta. Historical comparisons retain their original labeled basis. Stored observations do not guarantee current shelf stock or reserve stock against other sales.', class: 'text-sm text-mocha') %>

  <% items = count.items.order(:sku).to_a; known = items.reject { |item| item.delta.nil? } %>
  <div class="card overflow-hidden">
    <div class="card-pad pb-3">
      <%= section_heading 'Counted items', hint: "#{items.size} #{'item'.pluralize(items.size)}" %>
      <% if items.any? %>
        <%= explain_calculation(title: 'Net variance for this sheet', id: 'count-variance',
              formula: 'Counted − mirrored comparison, item by item, for items with a matched comparison; items without one have no numerical delta.',
              rows: [['Items on the sheet', items.size], ['Items with a matched comparison', known.size], ['Items without a numerical delta', items.size - known.size],
                     ['Counted units (matched items)', known.sum(&:quantity)], ['Comparison units (matched items)', known.sum(&:previousQuantity)],
                     ['Net variance', known.empty? ? '—' : format('%+d', known.sum(&:delta))]],
              note: 'A positive variance means more units were counted than the source mirror showed. Approving records the count for audit; no platform quantity changes.',
              term: 'variance', lesson: 'counts') %>
      <% end %>
    </div>
    <div class="table-region" role="region" tabindex="0" aria-label="Counted items">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Item</th>
            <th scope="col" class="th num">Counted<%= define('counted') %></th>
            <th scope="col" class="th num">Mirrored stock<%= define('comparison_quantity') %></th>
            <th scope="col" class="th num">Delta<%= define('variance') %></th>
            <th scope="col" class="th">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if items.empty? %>
            <tr>
              <td colspan="5" class="empty-row">No items recorded. <% if count.draft? && can_write %>Scan or edit the sheet to add items.<% end %></td>
            </tr>
          <% end %>
          <% items.each do |item| %>
            <tr>
              <td class="td">
                <div class="flex items-center gap-3">
                  <% if item.inventory_thumbnail %>
                    <%= image_tag item.inventory_thumbnail, alt: item.sku, loading: 'lazy', class: 'h-10 w-10 shrink-0 rounded-control border border-fog bg-haze object-cover' %>
                  <% else %>
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-control border border-fog bg-haze font-display text-base text-taupe"><%= item.sku.first.upcase %></span>
                  <% end %>
                  <div class="min-w-0">
                    <p class="truncate font-medium text-ink"><%= item.inventory_title.presence || item.sku %></p>
                    <p class="font-mono text-xs text-taupe"><%= item.sku %></p>
                  </div>
                </div>
              </td>
              <td class="td num font-medium text-ink"><%= item.quantity %></td>
              <td class="td num text-mocha">
                <p><%= item.previousQuantity.presence || '—' %></p>
                <p class="mt-1 max-w-xs text-xs text-taupe"><%= item.comparison_label %></p>
                <% if item.comparison['status'] == 'matched' %>
                  <p class="mt-1 text-xs text-taupe">Item <%= item.comparison['source_item_id'] %> · mirror <%= item.comparison['mirrored_at'] || 'time unavailable' %></p>
                <% end %>
              </td>
              <td class="td num">
                <% if item.delta.nil? %>
                  <span class="text-taupe">—</span>
                <% else %>
                  <span class="<%= item.delta.zero? ? 'text-taupe' : item.delta.positive? ? 'text-fern' : 'text-rose' %>">
                    <%= item.delta.positive? ? "+#{item.delta}" : item.delta %>
                  </span>
                <% end %>
              </td>
              <td class="td">
                <% if item.applied? %>
                  <span class="pill-fern">Applied</span>
                <% elsif count.approved? %>
                  <span class="pill-taupe">Recorded</span>
                <% elsif item.shopifyVariantId.present? || item.squareVariationId.present? || item.comparison['status'] == 'matched' %>
                  <span class="pill-taupe">Linked</span>
                <% else %>
                  <span class="pill-rose">Unlinked</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
