<% content_for :title, "Projects" %>
<% filters = [["Active work", nil], ["Planned", "planned"], ["Active", "active"], ["On hold", "on_hold"], ["Completed", "completed"], ["Archived", "archived"]] %>
<div class="space-y-6">
  <%= page_header 'Projects', subtitle: 'Plan work, track tasks and hit goals.', menu: [['Getting started', projects_getting_started_path]] do %>
    <% if Current.user.can?("projects.write") %>
      <%= link_to "Add project", new_projects_project_path, class: "btn-primary" %>
    <% end %>
  <% end %>

  <section class="grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label="Project counts">
    <div class="stat"><p class="stat-label">Active projects</p><p class="stat-value"><%= @status_counts["active"].to_i %></p></div>
    <div class="stat"><p class="stat-label">Open tasks</p><p class="stat-value"><%= @open_tasks %></p></div>
    <%= link_to projects_tasks_path(due: "overdue"), class: "stat block hover:border-taupe" do %>
      <p class="stat-label">Overdue tasks</p><p class="stat-value <%= "text-rose" if @overdue_tasks.positive? %>"><%= @overdue_tasks %></p>
    <% end %>
    <%= link_to projects_tasks_path(due: "week"), class: "stat block hover:border-taupe" do %>
      <p class="stat-label">Due this week</p><p class="stat-value"><%= @due_this_week %></p>
    <% end %>
  </section>

  <%= form_with url: projects_projects_path, method: :get, class: "toolbar", data: { controller: "auto-submit" } do %>
    <div class="toolbar-field"><%= label_tag :q, "Search", class: "field-label" %><%= search_field_tag :q, params[:q], placeholder: "Project name", class: "search w-full" %></div>
    <div class="toolbar-field"><%= label_tag :status, "Status", class: "field-label" %><%= select_tag :status, options_for_select(filters.map { |label, key| [key && @status_counts[key].to_i.positive? ? "#{label} (#{@status_counts[key]})" : label, key] }, @status), class: "select w-full", data: { action: "change->auto-submit#submit" } %></div>
    <div class="toolbar-field"><%= label_tag :sort, "Sort", class: "field-label" %><%= select_tag :sort, options_for_select([["Recently updated", "updated"], ["Due date", "due"], ["Name", "name"]], params[:sort]), class: "select w-full", data: { action: "change->auto-submit#submit" } %></div>
    <div class="toolbar-actions"><%= submit_tag "Apply", class: "btn-primary" %><%= link_to "Clear", projects_projects_path, class: "btn-ghost" %></div>
  <% end %>

  <% if @projects.empty? %>
    <%= empty_state(params[:q].present? || @status ? "No projects match." : "No projects yet.", hint: (params[:q].present? || @status ? "Clear the search or pick another status." : "Add your first project to start tracking tasks and goals.")) do %>
      <% if Current.user.can?("projects.write") && params[:q].blank? && @status.nil? %><%= link_to "Add project", new_projects_project_path, class: "btn-primary" %><% end %>
    <% end %>
  <% else %>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <% @projects.each do |project| %>
      <%= link_to project, class: "card card-pad group block transition hover:-translate-y-0.5 hover:border-taupe hover:shadow-md" do %>
        <div class="flex items-start justify-between gap-2">
          <h3 class="card-title min-w-0 truncate group-hover:text-olive-deep"><%= project.name %></h3>
          <%= project_status_pill(project) %>
        </div>
        <p class="mt-1 line-clamp-2 text-sm text-mocha"><%= project.description.presence || "No description." %></p>
        <div class="mt-4">
          <div class="mb-1.5 flex items-center justify-between text-xs text-taupe">
            <span><%= project.task_counts["done"] %> of <%= project.task_total %> tasks</span>
            <span class="font-semibold text-ink"><%= project.progress_pct %>%</span>
          </div>
          <%= render "projects/shared/progress_bar", counts: project.task_counts %>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
          <%= project_health_pill(project) %>
          <% if project.overdue_count.positive? %><span class="font-semibold text-rose"><%= project.overdue_count %> overdue</span><% end %>
          <% if project.task_counts["blocked"].positive? %><span class="text-rose"><%= project.task_counts["blocked"] %> blocked</span><% end %>
          <% if project.due_on %>
            <span class="ml-auto <%= project.due_on < Date.current && !project.completed? ? "font-semibold text-rose" : "text-taupe" %>">
              <%= project.completed? ? "Finished" : project.due_on < Date.current ? "Due #{l(project.due_on, format: :short)}" : "#{pluralize(project.days_left, "day")} left" %>
            </span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
  <% end %>

  <%== @pagy.series_nav if @pagy.pages > 1 %>
</div>
