<% content_for :title, "Projects" %>
<div class="space-y-6">
  <section class="flex items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Projects</h1>
      <p class="mt-1 text-sm text-mocha">Plan work, track tasks, and hit goals.</p>
    </div>
    <% if Current.user.can?("projects.write") %>
      <%= link_to "New project", new_projects_project_path, class: "btn-primary" %>
    <% end %>
  </section>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% if @projects.empty? %>
      <div class="card card-pad col-span-full text-sm text-taupe">No projects yet — create one to start tracking tasks and goals.</div>
    <% end %>
    <% @projects.each do |project| %>
      <%= link_to project, class: "card card-pad block hover:border-taupe" do %>
        <div class="flex items-center justify-between gap-2">
          <h3 class="truncate font-display text-lg text-ink"><%= project.name %></h3>
          <span class="<%= project.completed? ? "pill-fern" : project.archived? ? "pill-taupe" : project.active? ? "pill-olive" : "pill-clay" %>"><%= project.status %></span>
        </div>
        <p class="mt-1 line-clamp-2 text-sm text-mocha"><%= project.description.presence || "No description." %></p>
        <div class="mt-3">
          <div class="mb-1 flex items-center justify-between text-xs text-taupe">
            <span><%= project.tasks.completed.count %>/<%= project.tasks.count %> tasks</span>
            <span><%= project.progress_pct %>%</span>
          </div>
          <div class="h-1.5 overflow-hidden rounded-full bg-haze">
            <div class="h-full rounded-full bg-olive" style="width: <%= project.progress_pct %>%"></div>
          </div>
        </div>
        <% if project.due_on %><p class="mt-2 text-xs text-taupe">Due <%= l(project.due_on, format: :long) %></p><% end %>
      <% end %>
    <% end %>
  </div>

  <div class="text-xs text-taupe"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
</div>
