<% content_for :title, "Approved request" %>
<div class="page-medium space-y-5">
  <%= page_header "Approved request", subtitle: "The saved request and exact change approved for this task." do %>
    <%= link_to "Back to task", projects_task_path(@task, anchor: "history"), class: "btn-ghost" %>
  <% end %>
  <section class="card card-pad space-y-3">
    <h2 class="font-display text-lg text-ink"><%= @task.title %></h2>
    <p class="text-sm text-mocha"><%= @approval.proposal['summary'] %></p>
    <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
      <div><dt class="text-xs text-taupe">Requested by</dt><dd><%= @approval.provenance['requester_name'].presence || "Not recorded" %></dd></div>
      <div><dt class="text-xs text-taupe">Approved by</dt><dd><%= @approval.decided_by_name.presence || "Not recorded" %></dd></div>
      <div><dt class="text-xs text-taupe">Approved</dt><dd><% if @approval.decided_at %><time datetime="<%= @approval.decided_at.iso8601(6) %>"><%= task_activity_timestamp(@approval.decided_at) %></time><% else %>Not recorded<% end %></dd></div>
    </dl>
  </section>
  <section class="card card-pad">
    <h2 class="font-display text-lg text-ink">Approved change</h2>
    <dl class="mt-3 space-y-3 text-sm">
      <% @approval.proposal.fetch('arguments', {}).each do |name, value| %>
        <div><dt class="text-xs text-taupe"><%= name.to_s.humanize %></dt><dd class="whitespace-pre-wrap break-words text-ink"><%= value.is_a?(String) ? value : JSON.generate(value) %></dd></div>
      <% end %>
    </dl>
  </section>
  <section class="card card-pad">
    <h2 class="font-display text-lg text-ink">Original message</h2>
    <% if @show_original %>
      <p class="mt-3 whitespace-pre-wrap break-words text-sm text-ink"><%= @approval.provenance['last_chat'].presence || "Not recorded" %></p>
    <% else %>
      <p class="mt-3 text-sm text-mocha">Only the requester, approver, and people with access to the source chat can view the original message.</p>
    <% end %>
  </section>
</div>
