<section id="history" class="card card-pad">
  <h2 class="font-display text-lg text-ink">History</h2>
  <ul class="mt-3 space-y-1.5 text-sm">
    <% @history.each do |entry| %>
      <li class="flex flex-wrap gap-x-2 text-mocha">
        <span class="w-24 shrink-0 text-xs text-taupe"><%= l(entry.created_at.in_time_zone, format: :short) %></span>
        <span><strong class="text-ink"><%= entry.actor_name %></strong> <%= entry.action.delete_prefix("task_").humanize.downcase %><%= " — #{entry.details}" if entry.details.present? %></span>
      </li>
    <% end %>
    <% if @history.empty? %><li class="text-taupe">Nothing recorded yet.</li><% end %>
  </ul>
</section>
