<% content_for :title, "Tasks" %>
<% own_tasks = Current.user.employee? %>
<% can_write = own_tasks || Current.user.can?("projects.write") %>
<div class="space-y-5">
  <%= page_header own_tasks ? "My tasks" : "Tasks", subtitle: own_tasks ? "Your assigned work. Update notes or move tasks between columns as you work." : "Everything in flight across projects. Drag cards between columns to update their status.", eyebrow: 'Work' do %>
    <%= link_to "Getting started", projects_getting_started_path, class: "btn-ghost btn-sm", data: { tour: 'guide' } %>
    <div class="inline-flex rounded-full bg-haze p-1" role="group" aria-label="View" <%= tour_anchor('views') %>>
      <%= link_to "Board", tasks_filter_path(view: nil), class: "nav-pill nav-pill-idle-sm #{"nav-pill-active-sm" if @view == "board"}" %>
      <%= link_to "List", tasks_filter_path(view: "list"), class: "nav-pill nav-pill-idle-sm #{"nav-pill-active-sm" if @view == "list"}" %>
      <%= link_to "Calendar", tasks_filter_path(view: "calendar"), class: "nav-pill nav-pill-idle-sm #{"nav-pill-active-sm" if @view == "calendar"}" %>
    </div>
    <%= link_to "Export CSV", tasks_export_path, class: "btn-ghost btn-sm" unless own_tasks %>
    <%= link_to "Projects", projects_projects_path, class: "btn-ghost btn-sm" unless own_tasks %>
  <% end %>

  <section class="grid grid-cols-2 gap-3 sm:grid-cols-4" data-live-region="stats" <%= tour_anchor('stats') %>>
    <%= link_to tasks_filter_path(status: nil, due: nil, mine: nil), class: "stat block hover:border-taupe" do %>
      <p class="stat-label">Open</p><p class="stat-value"><%= @open_count %></p>
    <% end %>
    <%= link_to tasks_filter_path(status: "blocked"), class: "stat block hover:border-taupe" do %>
      <p class="stat-label">Blocked</p><p class="stat-value <%= "!text-rose" if @blocked_count.positive? %>"><%= @blocked_count %></p>
    <% end %>
    <%= link_to tasks_filter_path(due: "overdue"), class: "stat block hover:border-taupe" do %>
      <p class="stat-label">Overdue</p><p class="stat-value <%= "!text-rose" if @overdue_count.positive? %>"><%= @overdue_count %></p>
    <% end %>
    <%= link_to tasks_filter_path(status: "done"), class: "stat block hover:border-taupe" do %>
      <p class="stat-label">Done</p><p class="stat-value"><%= @done_count %></p>
    <% end %>
  </section>

  <%= form_with url: projects_tasks_path, method: :get, class: "flex flex-wrap items-center gap-2", data: { controller: "auto-submit", tour: 'filters' } do %>
    <%= hidden_field_tag :view, @view if @view != "board" %>
    <%= hidden_field_tag :month, params[:month] if params[:month].present? %>
    <%= hidden_field_tag :label, params[:label] if params[:label].present? %>
    <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
    <%= search_field_tag :q, params[:q], placeholder: "Search tasks…", class: "search w-56", "aria-label": "Search tasks" %>
    <%= select_tag :project_id, options_from_collection_for_select(@projects, :id, :name, params[:project_id]), include_blank: "All projects", class: "select", "aria-label": "Project", data: { action: "change->auto-submit#submit" } %>
    <%= select_tag :priority, options_for_select(Projects::Task::PRIORITIES.map { |p| [p.capitalize, p] }, params[:priority]), include_blank: "Any priority", class: "select", "aria-label": "Priority", data: { action: "change->auto-submit#submit" } %>
    <%= link_to "Mine (#{@mine_count})", tasks_filter_path(mine: params[:mine] == "1" ? nil : "1"), class: "nav-pill nav-pill-idle-sm border border-fog #{"nav-pill-active-sm" if params[:mine] == "1"}" %>
    <%= link_to "Overdue", tasks_filter_path(due: params[:due] == "overdue" ? nil : "overdue"), class: "nav-pill nav-pill-idle-sm border border-fog #{"nav-pill-active-sm" if params[:due] == "overdue"}" %>
    <%= link_to "Due this week", tasks_filter_path(due: params[:due] == "week" ? nil : "week"), class: "nav-pill nav-pill-idle-sm border border-fog #{"nav-pill-active-sm" if params[:due] == "week"}" %>
    <% if params[:label].present? %><span class="rounded-full bg-haze px-2.5 py-1 text-xs font-medium text-ink">Label: <%= params[:label] %></span><% end %>
    <% if tasks_filtered? %>
      <%= link_to "Clear", projects_tasks_path(view: (@view == "board" ? nil : @view)), class: "text-xs font-semibold text-olive hover:underline" %>
    <% end %>
    <noscript><%= submit_tag "Filter", class: "btn-ghost btn-sm" %></noscript>
  <% end %>

  <% if can_write && !own_tasks %>
    <%= render "projects/shared/quick_add", projects: @projects, assign_self: true %>
  <% end %>

  <% if @view == "board" %>
    <% if @board_total > Projects::TasksController::BOARD_LIMIT %>
      <p class="text-sm text-mocha" role="status">Showing <%= Projects::TasksController::BOARD_LIMIT %> of <%= @board_total %> matching tasks. <%= link_to "View all in the list", tasks_filter_path(view: "list"), class: "font-semibold text-olive hover:underline" %> or narrow the filters.</p>
    <% end %>
    <% if @columns.values.all?(&:empty?) %>
      <div class="card card-pad py-10 text-center">
        <p class="font-display text-lg text-ink"><%= tasks_filtered? ? "No tasks match these filters." : "A clean slate." %></p>
        <p class="mt-1 text-sm text-taupe"><%= tasks_filtered? ? "Try clearing a filter." : (own_tasks ? "Tasks assigned to you will appear here." : "Add your first task above, or open a project to plan it.") %></p>
      </div>
    <% else %>
      <%= render "projects/shared/board", columns: @columns, assignees: @assignees, show_project: true, can_write: can_write %>
    <% end %>
  <% elsif @view == "calendar" %>
    <%= render "projects/tasks/calendar" %>
  <% else %>
    <div class="space-y-2">
      <% if @tasks.empty? %>
        <div class="card card-pad text-sm text-taupe">No tasks match.</div>
      <% end %>
      <% @tasks.each do |task| %>
        <div class="card flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div class="flex min-w-0 flex-1 items-start gap-3">
            <span class="mt-1.5"><%= priority_dot(task.priority) %></span>
            <div class="min-w-0">
              <p class="<%= task.done? ? "text-taupe line-through" : "font-medium text-ink" %>"><%= link_to task.title, projects_task_path(task), class: "hover:underline" %></p>
              <% if task.description.present? %><p class="mt-0.5 text-sm text-mocha"><%= task.description %></p><% end %>
              <p class="mt-1 text-xs text-taupe">
                <% if task.project %>
                  <% if own_tasks %><span><%= task.project.name %></span><% else %><%= link_to task.project.name, task.project, class: "font-semibold text-olive hover:underline" %><% end %> ·
                <% end %>
                <% if task.due_on %><span class="<%= due_class(task) %>"><%= task.due_label %></span> · <% end %>
                <% if (name = @assignees[task.assignee_id.to_s]) %><%= name %> · <% end %>
                Updated <%= time_ago_in_words(task.updated_at) %> ago
              </p>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <% if can_write %>
              <% if task.may_start? %><%= button_to "Start", transition_projects_task_path(task, event: "start"), method: :post, class: "btn-ghost btn-sm" %><% end %>
              <% if task.may_finish? %><%= button_to "Done", transition_projects_task_path(task, event: "finish"), method: :post, class: "btn-primary btn-sm" %><% end %>
              <% if task.may_block? && !task.done? %><%= button_to "Block", transition_projects_task_path(task, event: "block"), method: :post, class: "btn-ghost btn-sm" %><% end %>
              <% if task.may_reopen? %><%= button_to "Reopen", transition_projects_task_path(task, event: "reopen"), method: :post, class: "btn-ghost btn-sm" %><% end %>
            <% end %>
            <%= task_status_pill(task) %>
          </div>
        </div>
      <% end %>
    </div>
    <div class="text-xs text-taupe"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
  <% end %>
</div>
