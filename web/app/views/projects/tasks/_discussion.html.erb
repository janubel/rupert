<section id="discussion" class="card card-pad">
  <h2 class="font-display text-lg text-ink">Discussion</h2>
  <ol class="mt-3 space-y-3">
    <% @comments.each do |comment| %>
      <li class="rounded-xl bg-haze/60 p-3">
        <p class="text-xs text-taupe"><strong class="text-ink"><%= @people[comment.user_id.to_s] || "Someone" %></strong> · <%= time_ago_in_words(comment.created_at) %> ago</p>
        <p class="mt-1 whitespace-pre-line text-sm text-ink"><%= comment.body %></p>
      </li>
    <% end %>
    <% if @comments.empty? %><li class="text-sm text-taupe">No comments yet.</li><% end %>
  </ol>
  <% if @can_edit %>
    <%= form_with scope: :comment, url: projects_task_comments_path(@task), class: "mt-3 space-y-2" do |f| %>
      <%= f.text_area :body, rows: 3, class: "input !rounded-2xl", placeholder: "Add an update or question…", "aria-label": "Comment", required: true, maxlength: Projects::TaskComment::MAX_LENGTH %>
      <%= f.submit "Comment", class: "btn-primary btn-sm" %>
    <% end %>
  <% end %>
</section>
