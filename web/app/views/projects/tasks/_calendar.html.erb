<%# Month grid of tasks by due date. Needs @month, @calendar_days, @calendar_tasks, @undated_count, @assignees. %>
<% today = Date.current %>
<section class="card card-pad" aria-label="Task calendar">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-1">
      <%= link_to "‹", tasks_filter_path(month: (@month - 1.month).strftime("%Y-%m")), class: "btn-ghost btn-sm", "aria-label": "Previous month" %>
      <h2 class="min-w-[9rem] text-center font-display text-lg text-ink"><%= @month.strftime("%B %Y") %></h2>
      <%= link_to "›", tasks_filter_path(month: (@month + 1.month).strftime("%Y-%m")), class: "btn-ghost btn-sm", "aria-label": "Next month" %>
    </div>
    <div class="flex items-center gap-3 text-xs text-taupe">
      <% if @undated_count.positive? %><span><%= pluralize(@undated_count, "open task") %> without a due date</span><% end %>
      <%= link_to "This month", tasks_filter_path(month: nil), class: "font-semibold text-olive hover:underline" %>
    </div>
  </div>
  <div class="grid grid-cols-7 gap-px overflow-hidden rounded-xl border border-fog bg-fog text-xs">
    <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |name| %><div class="bg-haze px-2 py-1 font-semibold text-mocha"><%= name %></div><% end %>
    <% @calendar_days.each do |day| %>
      <% tasks = @calendar_tasks[day].to_a %>
      <div class="min-h-[5.5rem] bg-paper p-1.5 <%= "opacity-50" if day.month != @month.month %>">
        <p class="<%= day == today ? "inline-grid h-5 w-5 place-items-center rounded-full bg-olive font-semibold text-cream" : "text-taupe" %>"><%= day.day %></p>
        <ul class="mt-1 space-y-0.5">
          <% tasks.first(3).each do |task| %>
            <li class="truncate">
              <%= link_to task.title, projects_task_path(task), title: "#{task.title} · #{status_label(task.status)}",
                    class: "block truncate rounded px-1 py-0.5 #{task.done? ? "bg-fern/15 text-taupe line-through" : task.overdue? ? "bg-rose/15 text-rose" : "bg-olive/10 text-ink"} hover:underline" %>
            </li>
          <% end %>
          <% if tasks.size > 3 %><li class="px-1 text-taupe">+<%= tasks.size - 3 %> more</li><% end %>
        </ul>
      </div>
    <% end %>
  </div>
</section>
