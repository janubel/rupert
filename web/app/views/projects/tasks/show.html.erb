<% content_for :title, @task.title %>
<% employee = Current.user.employee? %>
<div class="space-y-5">
  <nav class="text-xs text-taupe" aria-label="Breadcrumb">
    <%= link_to(employee ? "My tasks" : "Tasks", projects_tasks_path, class: "font-semibold text-olive hover:underline") %> <span aria-hidden="true">/</span>
    <% if @task.project && !employee %><%= link_to @task.project.name, @task.project, class: "font-semibold text-olive hover:underline" %> <span aria-hidden="true">/</span><% elsif @task.project %><%= @task.project.name %> <span aria-hidden="true">/</span><% end %>
    <%= @task.title.truncate(48) %>
  </nav>

  <section class="card card-pad">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0 max-w-3xl">
        <div class="flex flex-wrap items-center gap-2">
          <%= priority_dot(@task.priority) %>
          <h1 class="page-title <%= "line-through text-taupe" if @task.done? %>"><%= @task.title %></h1>
          <%= task_status_pill(@task) %>
        </div>
        <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-mocha">
          <span>Assignee: <strong class="text-ink"><%= @people[@task.assignee_id.to_s] || "Unassigned" %></strong></span>
          <% if @task.start_on %><span>Starts <%= l(@task.start_on, format: :long) %></span><% end %>
          <% if @task.due_on %><span class="<%= due_class(@task) %>"><%= @task.due_label %> · <%= l(@task.due_on, format: :long) %></span><% end %>
          <span>Priority: <%= @task.priority.capitalize %></span>
          <% if recurrence_label(@task) %><span title="A new copy is created when this one is finished">↻ <%= recurrence_label(@task) %></span><% end %>
          <% if @task.estimate_minutes %><span>Estimate <%= duration_label(@task.estimate_minutes) %> · logged <%= duration_label(@task.time_entries.sum(&:minutes)) %></span><% end %>
        </p>
        <% if @task.labels.any? %><p class="mt-2 flex flex-wrap gap-1.5"><%= label_chips(@task) %></p><% end %>
        <% if @task.description.present? %><p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-ink"><%= @task.description %></p><% end %>
      </div>
      <% if @can_edit %>
        <div class="flex flex-wrap items-center gap-2">
          <% if @task.may_start? %><%= button_to (@task.done? || @task.blocked? ? "Restart" : "Start"), transition_projects_task_path(@task, event: "start"), method: :post, class: "btn-ghost btn-sm" %><% end %>
          <% if @task.may_finish? %><%= button_to "Mark done", transition_projects_task_path(@task, event: "finish"), method: :post, class: "btn-primary btn-sm" %><% end %>
          <% if @task.may_reopen? && !@task.blocked? %><%= button_to "Reopen", transition_projects_task_path(@task, event: "reopen"), method: :post, class: "btn-ghost btn-sm" %><% end %>
          <% if @task.may_reopen? && @task.blocked? %><%= button_to "Unblock", transition_projects_task_path(@task, event: "reopen"), method: :post, class: "btn-ghost btn-sm" %><% end %>
        </div>
      <% end %>
    </div>

    <% if @waiting_on.any? %>
      <div class="mt-4 rounded-xl border border-clay/40 bg-clay/10 p-3 text-sm text-ink" role="status">
        <strong>Waiting on</strong>
        <%= safe_join(@waiting_on.map { |blocker| link_to(blocker.title, projects_task_path(blocker), class: "font-semibold text-olive hover:underline") }, ", ") %>.
        It can start once those are done.
      </div>
    <% end %>

    <% if @task.blocked? %>
      <div class="mt-4 rounded-xl border border-rose/40 bg-rose/10 p-3 text-sm text-ink">
        <p><strong>Blocked.</strong> <%= @task.blocked_reason.presence || "No reason recorded yet." %></p>
        <% if @can_edit %>
          <%= form_with url: transition_projects_task_path(@task, event: "block"), method: :post, class: "mt-2 flex flex-wrap items-center gap-2" do %>
            <%= text_field_tag :reason, @task.blocked_reason, placeholder: "What is needed to continue?", class: "input min-w-[16rem] flex-1", "aria-label": "Why is this blocked?" %>
            <%= submit_tag "Update reason", class: "btn-ghost btn-sm" %>
          <% end %>
        <% end %>
      </div>
    <% elsif @can_edit && !@task.done? %>
      <%= form_with url: transition_projects_task_path(@task, event: "block"), method: :post, class: "mt-4 flex flex-wrap items-center gap-2" do %>
        <%= text_field_tag :reason, nil, placeholder: "Stuck? Say what is needed, then block", class: "input min-w-[16rem] flex-1", "aria-label": "Reason for blocking" %>
        <%= submit_tag "Block task", class: "btn-ghost btn-sm" %>
      <% end %>
    <% end %>
  </section>

  <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-5">
      <%= render "projects/tasks/checklist" %>
      <%= render "projects/tasks/discussion" %>
      <%= render "projects/tasks/history" %>
    </div>
    <div class="space-y-5">
      <%= render "projects/tasks/waiting" %>
      <%= render "projects/tasks/time" %>
      <%= render "projects/tasks/files" %>
      <% if @can_edit %>
        <details class="card card-pad" <%= "open" if @task.errors.any? %>>
          <summary class="cursor-pointer font-display text-lg text-ink">Edit task</summary>
          <%= form_with model: @task, scope: :task, url: projects_task_path(@task), method: :patch, class: "mt-3 space-y-3" do |f| %>
            <%= f.text_field :title, class: "input", "aria-label": "Title", required: true %>
            <%= f.text_area :description, rows: 4, class: "input !rounded-2xl", placeholder: "Notes", "aria-label": "Notes" %>
            <% unless employee %>
              <div class="grid grid-cols-2 gap-2">
                <%= f.select :priority, Projects::Task::PRIORITIES.map { |p| [p.capitalize, p] }, {}, class: "select", "aria-label": "Priority" %>
                <%= f.select :recurrence, Projects::Task::RECURRENCES.invert.to_a, { include_blank: "Does not repeat" }, class: "select", "aria-label": "Repeats" %>
                <div><label class="mb-1 block text-xs font-semibold text-mocha" for="task_start_on">Start</label><%= f.date_field :start_on, class: "select w-full" %></div>
                <div><label class="mb-1 block text-xs font-semibold text-mocha" for="task_due_on">Due</label><%= f.date_field :due_on, class: "select w-full" %></div>
              </div>
              <%= f.select :assignee_id, project_person_options(@task.assignee_id), { include_blank: "Unassigned" }, class: "select w-full", "aria-label": "Assignee" %>
              <%= f.select :project_id, options_from_collection_for_select(Projects::Project.where.not(status: "archived").order(:name), :id, :name, @task.project_id), { include_blank: "No project" }, class: "select w-full", "aria-label": "Project" %>
              <%= f.text_field :labels_text, class: "input", placeholder: "Labels, comma separated", "aria-label": "Labels" %>
              <%= f.text_field :estimate_hours, class: "input", placeholder: "Estimate in hours (e.g. 2.5)", "aria-label": "Estimate in hours" %>
            <% end %>
            <%= f.submit "Save", class: "btn-primary btn-sm" %>
          <% end %>
          <% if @can_manage %>
            <%= button_to "Delete task", projects_task_path(@task), method: :delete, form: { data: { turbo_confirm: "Delete this task and its comments, files and time?" } }, class: "btn-ghost btn-sm mt-3 !text-rose" %>
          <% end %>
        </details>
      <% end %>
    </div>
  </div>
</div>
