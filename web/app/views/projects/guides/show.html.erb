<% content_for :title, "Projects and tasks getting started" %>
<% employee = Current.user.employee? %>
<% can_manage = Current.user.can?("projects.write") %>
<div class="page-medium space-y-6">
  <%= page_header 'Getting started', subtitle: "A quick guide for #{Current.tenant.name} to plan work, assign tasks and keep progress up to date." do %>
    <%= link_to(employee ? "Open My tasks" : "Open tasks", projects_tasks_path, class: "btn-primary") %>
  <% end %>

  <% if can_manage %>
    <section id="managers" class="section-card">
      <%= section_heading 'For managers: create a project and assign work' %>
      <ol class="list-decimal space-y-3 pl-5 text-sm leading-relaxed text-mocha">
        <li>Open <%= link_to "Projects", projects_projects_path, class: "font-semibold text-olive-deep underline" %> and select <%= link_to "Add project", new_projects_project_path, class: "font-semibold text-olive-deep underline" %>.</li>
        <li>Enter a <strong>Name</strong>, describe <strong>What does done look like?</strong>, and choose an <strong>Owner</strong> and optional <strong>Due date</strong>. Click <strong>Save</strong>.</li>
        <li>On the project page, enter a task title. Choose its <strong>Priority</strong>, optional <strong>Due date</strong> and <strong>Assignee</strong>, then click <strong>Add task</strong>.</li>
        <li>To add notes or change an assignment, open <strong>Edit</strong> on the task card, make your changes and click <strong>Save</strong>.</li>
        <li>Track completion on the project board and progress bar. Click <strong>Start</strong> when the project is ready to begin.</li>
      </ol>
      <p class="rounded-card bg-haze p-3 text-sm text-mocha">The project owner and task assignee are separate choices. <strong>Each employee task needs an Assignee.</strong> Unassigned tasks do not appear in employees’ lists. If someone is missing from the selector, ask an administrator to check their active account in this workspace.</p>
    </section>
  <% end %>

  <section id="employees" class="section-card">
    <%= section_heading 'For employees: find and update your work' %>
    <ol class="list-decimal space-y-3 pl-5 text-sm leading-relaxed text-mocha">
      <li>Sign in with your own account and select <strong>My tasks</strong> in the navigation.</li>
      <li>Use <strong>Board</strong> or <strong>List</strong> to see your assigned tasks. Search and filters help narrow the list.</li>
      <li>On the board, use a task’s status dropdown. Status changes save automatically. List view also provides <strong>Start</strong>, <strong>Done</strong>, <strong>Block</strong> and <strong>Reopen</strong> buttons.</li>
      <li>On the board, open <strong>Edit</strong> to update the title or notes, then click <strong>Save</strong>.</li>
    </ol>
    <dl class="facts rounded-card bg-haze p-3">
      <div><dt>In progress</dt><dd>You’ve started the work.</dd></div>
      <div><dt>Blocked</dt><dd>You need help to continue. Add a note explaining what you need.</dd></div>
      <div><dt>Done</dt><dd>The work is complete.</dd></div>
      <div><dt>To do</dt><dd>Reopen or return the task to the queue.</dd></div>
    </dl>
    <p class="text-sm text-mocha">Employees can manage only their own assigned tasks in their workspace. Managers handle reassignment, priority, due dates, creation and deletion.</p>
    <% if !employee && !can_manage %><p class="text-sm text-mocha">Your account has read-only project access. You can view work, but a manager must make changes.</p><% end %>
  </section>

  <section class="section-card">
    <%= section_heading 'Can’t find a task?', level: :h3 %>
    <p class="text-sm leading-relaxed text-mocha">Clear your filters, reload the page and ask your manager to confirm the task is assigned to your account. Tasks reassigned to someone else leave your list when it refreshes.</p>
  </section>
</div>
