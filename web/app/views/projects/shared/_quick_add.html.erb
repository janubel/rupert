<%# Single-line task entry. locals: project (optional, fixed), projects (picker options when no fixed project) %>
<% project = local_assigns[:project] %>
<%= form_with model: Projects::Task.new, scope: :task, url: projects_tasks_path, class: "card card-pad" do |f| %>
  <%= hidden_field_tag :project_id, project.id if project %>
  <div class="flex flex-wrap items-center gap-2">
    <%= f.text_field :title, placeholder: "Add a task and press Enter…", class: "input min-w-56 flex-1", required: true, "aria-label": "Task title" %>
    <%= f.select :priority, Projects::Task::PRIORITIES, { selected: "medium" }, class: "select", "aria-label": "Priority" %>
    <%= f.date_field :due_on, class: "select", "aria-label": "Due date" %>
    <%= f.select :assignee_id, project_person_options(local_assigns[:assign_self] ? Current.user.id : nil), { include_blank: "Unassigned" }, class: "select", "aria-label": "Assignee" %>
    <% if !project && local_assigns[:projects] %>
      <%= f.select :project_id, options_from_collection_for_select(projects, :id, :name, params[:project_id]), { include_blank: "No project" }, class: "select max-w-48", "aria-label": "Project" %>
    <% end %>
    <%= f.submit "Add task", class: "btn-primary btn-sm" %>
  </div>
<% end %>
