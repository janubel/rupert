<% content_for :title, 'Start free with Rupert' %>
<div class="mx-auto max-w-xl pt-10"><section class="card card-pad space-y-5">
<p class="text-xs uppercase tracking-wide">Your business, connected</p><h1 class="page-title">Meet your new back office.</h1>
<p>Create your account free with Google. No card required. You can choose a paid subscription from your workspace.</p>
<%= form_with scope: :registration, url: start_path, data: {turbo: false}, class: 'space-y-4' do |f| %>
<div><%= f.label :workspace_name, 'Business name', class: 'field-label' %><%= f.text_field :workspace_name, required: true, maxlength: 160, class: 'input' %></div>
<div><%= f.label :requested_subdomain, 'Workspace address', class: 'field-label' %><%= f.text_field :requested_subdomain, required: true, minlength: 2, maxlength: 63, pattern: '[a-z0-9][a-z0-9-]*[a-z0-9]', class: 'input', autocapitalize: 'none' %></div>
<p class="text-sm">Google verifies your email before we create your account. Connecting a business provider is a separate permission you control.</p>
<%= f.submit 'Create free account with Google', class: 'btn-primary' %><% end %>
<%= link_to 'Already a customer? Sign in', login_path, class: 'underline' %></section></div>
