<% attention = @attention || ReconciliationAttention.new(@report) %>
<% counts = attention.counts %>
<% can_write = Current.user.can?('reports.write') %>
<section id="attention-items" class="space-y-4">
  <% if @follow_up_overdue_count.to_i.positive? %><div class="flex flex-wrap items-center justify-between gap-3 rounded-card border border-warn-edge bg-warn-bg p-4"><p class="text-sm font-semibold"><%= pluralize(@follow_up_overdue_count, 'overdue follow-up') %> across all dates</p><%= link_to 'Work overdue follow-ups', reconciliation_follow_ups_path(status: 'overdue'), class: 'btn-primary btn-sm' %></div><% end %>
  <div class="card-head"><div><h2 class="section-title">What needs attention</h2><div class="card-hint">Start with differences and gaps. Matching metrics and supporting evidence stay available below.<%= define('control') %><%= define('unavailable') %></div></div><div class="card-head-actions"><%= link_to 'Across days', overview_reconciliation_follow_ups_path, class: 'btn-ghost btn-sm' %><%= link_to 'All follow-ups', reconciliation_follow_ups_path, class: 'btn-ghost btn-sm' %></div></div>
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4"><% [['Differences', counts[:variances], 'variances'], ['Unavailable comparisons', counts[:unavailable], 'unavailable'], ['Conflicting controls', counts[:conflicts], 'conflicts']].each do |label, count, filter| %><%= link_to daily_reconciliations_path(day: @report.day.iso8601, comparison: filter, anchor: 'control-comparisons'), class: 'stat block' do %><p class="stat-label"><%= label %></p><p class="stat-value mt-1 <%= 'text-rose' if count.positive? %>"><%= count %></p><% end %><% end %><a href="#missing-controls" class="stat block"><p class="stat-label">Missing register controls</p><p class="stat-value mt-1 <%= 'text-rose' if counts[:missing_controls].positive? %>"><%= counts[:missing_controls] %></p></a></div>
  <div class="grid gap-4 md:grid-cols-2">
    <% attention.differences.first(8).each do |row| %><article class="section-card min-w-0 border-warn-edge"><div class="card-head"><h3 class="card-title"><%= reconciliation_source(row[:source]) %> · <%= row[:currency] %> · <%= row[:metric].humanize %></h3><span class="pill-clay"><%= row[:status] == 'Variance' ? 'Difference' : row[:status] %></span></div><p class="text-xs text-mocha"><%= (@locations_by_id || {})[row[:location_id]]&.name || row[:location_id].presence || 'Unassigned records only' %></p>
      <% if row[:delta_cents] %><dl class="facts"><div><dt>Source report<%= define('control') %></dt><dd class="num text-left"><%= reconciliation_money(row[:expected_cents]) %></dd></div><div><dt>Rupert records</dt><dd class="num text-left"><%= reconciliation_money(row[:actual_cents]) %></dd></div></dl><p class="stat-value-sm num text-left"><%= reconciliation_difference(row[:delta_cents]) %> <%= row[:currency] %></p><p class="text-sm"><%= row[:delta_cents].positive? ? 'Rupert is above the source report.' : 'Rupert is below the source report.' %> Difference = Rupert minus source.</p>
      <% elsif row[:status] == 'Conflicting controls' %><p class="text-sm">More than one current control covers this exact pool. Inspect the originals and withdraw an accidental duplicate or correct the applicable report.</p>
      <% else %><p class="text-sm">This scope or metric has no comparable canonical amount. Check the source evidence and import coverage; unavailable amounts are not zero.</p><% end %>
      <div class="flex flex-wrap gap-2"><%= link_to 'Inspect evidence', daily_reconciliations_path(day: @report.day.iso8601, anchor: "evidence-#{row[:document_ids].first}"), class: 'btn-ghost btn-sm' %><% if can_write %><%= link_to 'Track follow-up', new_reconciliation_follow_up_path(reconciliation_follow_up_context(row, @report.day)), class: 'btn-ghost btn-sm' %><% end %></div></article><% end %>
  </div>
  <% if attention.differences.size > 8 %><%= link_to "See all #{attention.differences.size} attention metrics", daily_reconciliations_path(day: @report.day.iso8601, comparison: 'attention', anchor: 'control-comparisons'), class: 'text-sm font-semibold text-olive-deep hover:underline' %><% elsif attention.differences.empty? %><p class="rounded-card border border-fog bg-paper p-4 text-sm"><%= @report.comparisons.empty? ? 'No source totals have been compared yet. Add a control or track an expected report.' : 'The supplied comparable metrics match. Check missing controls and requested reports before recording your review.' %></p><% end %>
  <div id="missing-controls" class="space-y-3"><div class="card-head"><div><h3 class="card-title">Recorded activity without a current register control</h3><p class="card-hint">One source, currency and location per prompt. Track expected invoices or statements as separate report requests.</p></div></div>
    <% attention.missing_controls.each do |row| %><div class="section-card flex flex-wrap items-center justify-between gap-3"><div><p class="font-semibold"><%= reconciliation_source(row[:source]) %> · <%= row[:currency].presence || 'Unknown currency' %></p><p class="mt-1 text-xs text-mocha"><%= (@locations_by_id || {})[row[:location_id]]&.name || row[:location_id].presence || 'Unassigned records only' %> · recorded activity, no current register control</p></div><div class="flex flex-wrap gap-2"><%= link_to 'Find retained reports', reconciliation_documents_path(reconciliation_missing_control_search(row, @report.day)), class: 'btn-ghost btn-sm' %><% if can_write && ReconciliationDocument::SOURCES.excluding('rupert').include?(row[:source]) && row[:currency].to_s.match?(/\A[A-Z]{3}\z/) %><%= link_to 'Add control', daily_reconciliations_path(day: @report.day.iso8601, control_for: attention.control_key(row), anchor: 'upload-document'), class: 'btn-ghost btn-sm' %><%= link_to 'Track missing report', new_reconciliation_follow_up_path(reconciliation_follow_up_context(row, @report.day, category: 'missing_report')), class: 'btn-ghost btn-sm' %><% end %></div></div><% end %>
    <% if attention.missing_controls.empty? %><p class="text-sm text-mocha">No recorded pools without controls in this report. Expected bank statements, invoices or other reports can still be tracked as requests.</p><% end %>
  </div>
  <div class="space-y-3"><div class="card-head"><div><h3 class="card-title">Open follow-ups covering this day</h3></div><div class="card-head-actions"><%= link_to "All open follow-ups (#{@follow_up_open_count || ReconciliationFollowUp.active.count})", reconciliation_follow_ups_path, class: 'btn-ghost btn-sm' %></div></div><div class="grid gap-4 md:grid-cols-2"><%= render partial: 'reconciliation_follow_ups/card', collection: (@day_follow_ups || ReconciliationFollowUp.covering(@report.day).active.includes(:owner).order(:due_on, :id).limit(6)), as: :item, locals: { heading_tag: :h4, close_day: @report.day } %></div><div class="flex flex-wrap gap-2"><%= link_to 'Open all follow-ups for this day', reconciliation_follow_ups_path(day: @report.day.iso8601), class: 'btn-ghost btn-sm' %><% if can_write %><%= link_to 'Track another expected report', new_reconciliation_follow_up_path(period_from: @report.day.iso8601, period_to: @report.day.iso8601), class: 'btn-ghost btn-sm' %><% end %></div></div>
</section>
