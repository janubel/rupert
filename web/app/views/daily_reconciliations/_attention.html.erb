<% attention = @attention || ReconciliationAttention.new(@report) %>
<% counts = attention.counts %>
<% can_write = Current.user.can?('reports.write') %>
<section id="attention-items" class="scroll-mt-48 md:scroll-mt-32 space-y-4">
  <% if @follow_up_overdue_count.to_i.positive? %><div class="rounded-xl border border-amber-300 bg-amber-50 p-4 flex flex-wrap items-center justify-between gap-3"><p class="text-sm font-semibold text-amber-950"><%= pluralize(@follow_up_overdue_count, 'overdue follow-up') %> across all dates</p><%= link_to 'Work overdue follow-ups', reconciliation_follow_ups_path(status: 'overdue'), class: 'btn-primary btn-sm' %></div><% end %>
  <div class="flex flex-wrap items-end justify-between gap-3"><div><h2 class="font-display text-2xl">What needs attention</h2><p class="mt-1 text-sm text-mocha">Start with differences and gaps. Matching metrics and supporting evidence stay available below.</p></div><%= link_to 'Across days', overview_reconciliation_follow_ups_path, class: 'btn-ghost' %><%= link_to 'All report requests & follow-ups', reconciliation_follow_ups_path, class: 'btn-ghost' %></div>
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4"><% [['Differences', counts[:variances], 'variances'], ['Unavailable comparisons', counts[:unavailable], 'unavailable'], ['Conflicting controls', counts[:conflicts], 'conflicts']].each do |label, count, filter| %><%= link_to daily_reconciliations_path(day: @report.day.iso8601, comparison: filter, anchor: 'control-comparisons'), class: "card card-pad #{count.positive? ? 'border-amber-300' : ''}" do %><p class="text-sm font-semibold"><%= label %></p><p class="mt-1 font-display text-2xl"><%= count %></p><% end %><% end %><a href="#missing-controls" class="card card-pad"><p class="text-sm font-semibold">Missing register controls</p><p class="mt-1 font-display text-2xl"><%= counts[:missing_controls] %></p></a></div>
  <div class="grid gap-4 md:grid-cols-2">
    <% attention.differences.first(8).each do |row| %><article class="card card-pad min-w-0 space-y-3 border-amber-300"><div class="flex flex-wrap justify-between gap-2"><h3 class="font-semibold"><%= reconciliation_source(row[:source]) %> · <%= row[:currency] %> · <%= row[:metric].humanize %></h3><span class="text-xs font-semibold"><%= row[:status] == 'Variance' ? 'Difference' : row[:status] %></span></div><p class="text-xs text-mocha"><%= (@locations_by_id || {})[row[:location_id]]&.name || row[:location_id].presence || 'Unassigned records only' %></p>
      <% if row[:delta_cents] %><div class="grid grid-cols-2 gap-3"><div><p class="text-xs text-mocha">Source report</p><p class="font-semibold tabular-nums"><%= reconciliation_money(row[:expected_cents]) %></p></div><div><p class="text-xs text-mocha">Rupert records</p><p class="font-semibold tabular-nums"><%= reconciliation_money(row[:actual_cents]) %></p></div></div><p class="font-display text-2xl tabular-nums"><%= reconciliation_difference(row[:delta_cents]) %> <%= row[:currency] %></p><p class="text-sm"><%= row[:delta_cents].positive? ? 'Rupert is above the source report.' : 'Rupert is below the source report.' %> Difference = Rupert minus source.</p>
      <% elsif row[:status] == 'Conflicting controls' %><p class="text-sm">More than one current control covers this exact pool. Inspect the originals and withdraw an accidental duplicate or correct the applicable report.</p>
      <% else %><p class="text-sm">This scope or metric has no comparable canonical amount. Check the source evidence and import coverage; unavailable amounts are not zero.</p><% end %>
      <div class="flex flex-wrap gap-2"><%= link_to 'Inspect evidence', daily_reconciliations_path(day: @report.day.iso8601, anchor: "evidence-#{row[:document_ids].first}"), class: 'btn-ghost btn-sm' %><% if can_write %><%= link_to 'Track follow-up', new_reconciliation_follow_up_path(reconciliation_follow_up_context(row, @report.day)), class: 'btn-ghost btn-sm' %><% end %></div></article><% end %>
  </div>
  <% if attention.differences.size > 8 %><%= link_to "See all #{attention.differences.size} attention metrics ↓", daily_reconciliations_path(day: @report.day.iso8601, comparison: 'attention', anchor: 'control-comparisons'), class: 'text-sm font-semibold text-olive underline' %><% elsif attention.differences.empty? %><p class="rounded-xl border border-fog bg-paper p-4 text-sm"><%= @report.comparisons.empty? ? 'No source totals have been compared yet. Add a control or track an expected report.' : 'The supplied comparable metrics match. Check missing controls and requested reports before recording your review.' %></p><% end %>
  <div id="missing-controls" class="scroll-mt-48 md:scroll-mt-32 space-y-3"><h3 class="font-semibold">Recorded activity without a current register control</h3><p class="text-xs text-mocha">One source, currency and location per prompt. Track expected invoices or statements as separate report requests.</p>
    <% attention.missing_controls.each do |row| %><div class="card card-pad flex flex-wrap items-center justify-between gap-3"><div><p class="font-semibold"><%= reconciliation_source(row[:source]) %> · <%= row[:currency].presence || 'Unknown currency' %></p><p class="mt-1 text-xs text-mocha"><%= (@locations_by_id || {})[row[:location_id]]&.name || row[:location_id].presence || 'Unassigned records only' %> · recorded activity, no current register control</p></div><div class="flex flex-wrap gap-2"><%= link_to 'Find retained reports', reconciliation_documents_path(source: ReconciliationLibrary::SOURCE_NAMES.key?(row[:source]) ? row[:source] : nil, from: @report.day.iso8601, to: @report.day.iso8601), class: 'btn-ghost btn-sm' %><% if can_write && ReconciliationDocument::SOURCES.excluding('rupert').include?(row[:source]) && row[:currency].to_s.match?(/\A[A-Z]{3}\z/) %><%= link_to 'Add control', daily_reconciliations_path(day: @report.day.iso8601, control_for: attention.control_key(row), anchor: 'upload-document'), class: 'btn-ghost btn-sm' %><%= link_to 'Track missing report', new_reconciliation_follow_up_path(reconciliation_follow_up_context(row, @report.day, category: 'missing_report')), class: 'btn-primary btn-sm' %><% end %></div></div><% end %>
    <% if attention.missing_controls.empty? %><p class="text-sm text-mocha">No recorded pools without controls in this report. Expected bank statements, invoices or other reports can still be tracked as requests.</p><% end %>
  </div>
  <div class="space-y-3"><div class="flex flex-wrap justify-between gap-3"><h3 class="font-semibold">Open follow-ups covering this day</h3><%= link_to "All open follow-ups (#{@follow_up_open_count || ReconciliationFollowUp.active.count})", reconciliation_follow_ups_path, class: 'text-sm text-olive underline' %></div><div class="grid gap-4 md:grid-cols-2"><%= render partial: 'reconciliation_follow_ups/card', collection: (@day_follow_ups || ReconciliationFollowUp.covering(@report.day).active.includes(:owner).order(:due_on, :id).limit(6)), as: :item, locals: { heading_tag: :h4 } %></div><div class="flex flex-wrap gap-2"><%= link_to 'View all follow-ups for this day', reconciliation_follow_ups_path(day: @report.day.iso8601), class: 'btn-ghost btn-sm' %><% if can_write %><%= link_to 'Track another expected report', new_reconciliation_follow_up_path(period_from: @report.day.iso8601, period_to: @report.day.iso8601), class: 'btn-ghost btn-sm' %><% end %></div></div>
</section>
