<% money = ->(cents) { reconciliation_money(cents) }
   can_write = Current.user.can?('reports.write')
   review = @report.latest_review
   review_current = review && review.report_digest == @report.digest
   comparisons = @report.comparisons
   attention = @attention.differences.size
   day_param = @report.day.iso8601
   menu = []
   menu << ['Add document', '#upload-document'] if can_write
   menu << ['Download CSV', daily_reconciliations_path(format: :csv, day: day_param)]
   menu << ['Register summary', register_summary_reports_path(day: day_param)]
   menu << ['Source reports', money_reconciliations_path(date: day_param)]
   menu << ['Source documents', reconciliation_documents_path(from: day_param, to: day_param)]
   menu << ['Drive copies', retention_drive_path]
   [['Attention and follow-ups', '#attention-items'], ['Review day', '#review-day'], ['Source evidence', '#source-evidence'], ['Documents', '#documents'], ['Review and history', '#review-history']].each { |label, anchor| menu << [label, anchor] } %>
<div class="space-y-6">
  <%= page_header 'Daily reconciliation', subtitle: "#{@report.day.strftime('%A, %B %-d, %Y')} · check the day against its source reports, keep the originals, and record anything that needs follow-up.", menu: menu do %>
    <%= link_to 'Day close', financial_close_path(day: day_param), class: 'btn-primary' %>
  <% end %>
  <% if @form_error %><div role="alert" tabindex="-1" id="reconciliation-error" class="flash flash-alert"><p class="font-semibold"><%= @form_error %></p><p class="mt-1">Your entered text is still below. <%= link_to 'Return to the form', "##{@error_section}", class: 'font-semibold underline' %><%= @error_section == 'upload-document' ? ' Select the original file again before submitting.' : '' %></p></div><% end %>

  <%= form_with url: daily_reconciliations_path, method: :get, class: 'toolbar' do |f| %>
    <div class="toolbar-field"><%= f.label :day, 'Business day', class: 'field-label' %><%= f.date_field :day, value: @report.day, required: true, class: 'input' %></div>
    <nav class="toolbar-actions" aria-label="Business days">
      <%= f.submit 'Apply', class: 'btn-primary' %>
      <%= link_to 'Previous day', daily_reconciliations_path(day: (@report.day - 1).iso8601), class: 'btn-ghost' %>
      <%= link_to 'Next day', daily_reconciliations_path(day: (@report.day + 1).iso8601), class: 'btn-ghost' %>
      <%= link_to 'Yesterday', daily_reconciliations_path(day: Date.yesterday.iso8601), class: 'btn-ghost' %>
      <%= link_to 'Today', daily_reconciliations_path(day: Date.current.iso8601), class: 'btn-ghost' %>
    </nav>
  <% end %>

  <section class="grid grid-cols-2 gap-3 xl:grid-cols-4" aria-label="Daily review overview">
    <div class="stat"><p class="stat-label">Your review</p><p class="stat-value-sm mt-1"><%= !review ? 'Not reviewed' : !review_current ? 'Changed since review' : review.status.humanize %></p><p class="mt-1 text-xs text-taupe"><%= review ? "Last note #{review.created_at.in_time_zone.strftime('%b %-d, %-I:%M %p')}" : 'Record a review after checking the evidence.' %></p></div>
    <div class="stat"><p class="stat-label">Source comparisons</p><p class="stat-value-sm mt-1"><%= comparisons.empty? ? 'No controls yet' : (attention.zero? ? 'No differences to resolve' : "#{attention} need attention") %></p><p class="mt-1 text-xs text-taupe"><%= comparisons.count { |row| row[:status] == 'Matched recorded total' } %> matching metrics · native checks below</p></div>
    <a href="#documents" class="stat block"><p class="stat-label">Documents for this day</p><p class="stat-value-sm mt-1"><%= @report.documents.size %></p><p class="mt-1 text-xs text-taupe">Originals and supporting report versions</p></a>
    <%= link_to retention_drive_path, class: 'stat block' do %><p class="stat-label">Drive copies</p><p class="stat-value-sm mt-1"><%= @drive_connection&.connected? && @drive_connection.enabled ? (@drive_connection.last_error.present? ? 'Needs attention' : 'Automatic copies on') : 'Setup pending' %></p><p class="mt-1 text-xs text-taupe"><%= @drive_verified || 0 %> verified copies · originals retained in Rupert</p><% end %>
  </section>

  <%= render 'shared/daily_close_summary', day: @report.day %>
  <%= render 'shared/finance_source_coverage', coverage: @report.source_coverage %>
  <%= render 'daily_reconciliations/attention' %>

  <div id="review-day" class="card-head"><div><h2 class="section-title">1. Review the day</h2><p class="card-hint">Compare one source, location and currency at a time. Missing imports are not zero-sales days.</p></div></div>
  <details class="explainer card card-pad text-sm"><summary class="explainer-summary font-semibold">How the numbers relate</summary><div class="mt-3 space-y-2">
    <p>Day boundaries use <%= Time.zone.name %>. Order totals use order dates, tenders use payment dates, and refunds use refund dates. Source, currency and location stay separate.</p>
    <p>Sales, gateway payments and processor deposits can describe the same money. Review each layer separately. A matched recorded total does not prove a complete day or bank settlement. Shopify tenders may be inferred from order totals.</p>
    <p>Missing amounts stay unavailable. Attach invoices, daily reports, statements and fee reports below. Tips, fees and deposits entered from documents remain source observations when Rupert has no comparable field.</p>
  </div></details>
  <section class="table-region card" tabindex="0" role="region" aria-label="Reconciliation table, scroll horizontally for all columns"><table class="table">
    <caption class="p-4 text-left font-semibold">Recorded sales and tenders</caption>
    <thead><tr><% [['Source / location', false], ['Currency', false], ['Orders', true], ['Order total', true], ['Cash received', true], ['Card received', true], ['Refunds', true], ['Tenders less refunds', true], ['Payment coverage issues', true]].each do |label, numeric| %><th scope="col" class="th <%= 'num' if numeric %>"><%= label %></th><% end %></tr></thead>
    <tbody><% @report.register.rows.each do |row| %>
      <tr><td class="td"><%= reconciliation_source(row[:source]) %><br><span class="text-xs"><%= (@locations_by_id || {})[row[:location_id]]&.name || row[:location_id].presence || 'Unassigned' %></span></td><td class="td"><%= row[:currency].presence || 'Unknown' %></td><td class="td num"><%= row[:orders] %></td>
        <% [row[:order_total_cents], row[:tenders].fetch('cash', 0), row[:tenders].fetch('card', 0), row[:refund_cents], row[:net_tender_cents]].each do |amount| %><td class="td num"><%= money.call(amount) %></td><% end %>
        <td class="td num"><%= DailyRegisterSummary::COVERAGE_KEYS.sum { |key| row[key] } %></td></tr>
    <% end %><% if @report.register.rows.empty? %><tr><td class="empty-row" colspan="9">No recorded sales or tender activity. This does not establish a zero-sales day.</td></tr><% end %></tbody>
  </table></section>

  <section id="control-comparisons" class="space-y-3">
    <%= page_tabs([['Needs attention', 'attention'], ['Differences', 'variances'], ['Unavailable', 'unavailable'], ['Conflicts', 'conflicts'], ['Matched', 'matched'], ['All metrics', 'all']].map { |label, value| [label, daily_reconciliations_path(day: day_param, comparison: value, anchor: 'control-comparisons'), (@comparison_filter || 'attention') == value] }, label: 'Comparison filters') %>
    <p class="text-xs text-mocha">Differences appear first, grouped by currency and largest absolute difference within each currency. CSV downloads include every metric.</p>
    <div class="table-region card" tabindex="0" role="region" aria-label="Source control comparisons, scroll horizontally for all columns"><table class="table">
      <caption class="p-4 text-left font-semibold">Source control comparisons · <%= (@comparison_rows || ReconciliationAttention.new(@report).differences).size %> shown of <%= @report.comparisons.size %> metrics</caption>
      <thead><tr><% [['Source / location', false], ['Currency', false], ['Metric', false], ['Source report', true], ['Rupert records', true], ['Rupert minus source', true], ['Result', false], ['Evidence', false]].each do |label, numeric| %><th scope="col" class="th <%= 'num' if numeric %>"><%= label %></th><% end %></tr></thead>
      <tbody><% (@comparison_rows || ReconciliationAttention.new(@report).differences).each do |row| %><tr><td class="td"><%= reconciliation_source(row[:source]) %> / <%= (@locations_by_id || {})[row[:location_id]]&.name || row[:location_id].presence || 'Unassigned' %></td><td class="td"><%= row[:currency] %></td><td class="td"><%= row[:metric].humanize %></td>
        <% [:expected_cents, :actual_cents, :delta_cents].each do |key| %><td class="td num"><%= key == :delta_cents ? reconciliation_difference(row[key]) : money.call(row[key]) %></td><% end %>
        <td class="td"><span class="<%= reconciliation_tone(row[:status]) %>"><%= row[:status] %></span></td><td class="td"><% row[:document_ids].each do |id| %><%= link_to "##{id}", daily_reconciliations_path(day: day_param, anchor: "evidence-#{id}"), class: 'font-semibold text-olive-deep hover:underline' %> <% end %></td></tr>
      <% end %><% if (@comparison_rows || ReconciliationAttention.new(@report).differences).empty? %><tr><td class="empty-row" colspan="8">No metrics match this view. Choose All metrics to inspect supplied controls, or check the missing-control prompts above.</td></tr><% end %></tbody>
    </table></div>
  </section>

  <section class="section-card">
    <%= section_heading 'Import freshness', hint: 'Latest import completion is not confirmation that every transaction for this day was imported.', level: :h3 %>
    <dl class="facts">
      <% @report.register.source_freshness.each do |source, state| %><div><dt><%= reconciliation_source(source) %></dt><dd><%= state[:finished_at]&.in_time_zone&.strftime('%b %-d at %-I:%M %p %Z') || 'No source-confirmed successful import' %></dd></div><% end %>
    </dl>
  </section>

  <div id="source-evidence" class="card-head"><div><h2 class="section-title">Source evidence</h2><p class="card-hint">Open a source to inspect its observations and native controls. These layers may describe the same money.</p></div></div>
  <details class="card"><summary class="disclosure-trigger p-4 font-semibold">C-Trax store-day controls <span class="pill-taupe ml-2"><%= "#{@report.ctrax.size} store days" %></span></summary>
  <section class="table-region" tabindex="0" role="region" aria-label="Source evidence table, scroll horizontally for all columns"><table class="table">
    <caption class="p-4 text-left font-semibold">C-Trax store-day controls — native orders and register evidence</caption>
    <thead><tr><% [['Store / timezone', false], ['Currency', false], ['Check', false], ['Recorded', true], ['Source control', true], ['Difference', true], ['Review', false]].each do |label, numeric| %><th scope="col" class="th <%= 'num' if numeric %>"><%= label %></th><% end %></tr></thead>
    <tbody><% @report.ctrax.each do |snapshot| %><% detail = Ctrax::Reconciliation.new(snapshot) %>
      <% detail.checks.each do |check| %><tr><td class="td"><%= snapshot.location.name %><br><%= snapshot.timezone %></td><td class="td"><%= snapshot.currency %></td><td class="td"><%= check[:label] %></td>
        <% [:actual, :expected, :delta].each do |key| %><td class="td num"><%= check[:monetary] ? money.call(check[key]) : (check[key].nil? ? 'Unavailable' : check[key]) %></td><% end %>
        <td class="td"><%= snapshot.reviewed? ? 'Current source review' : 'Needs source review' %></td></tr><% end %>
      <% detail.warnings.each do |warning| %><tr><td class="td" colspan="7"><%= warning %></td></tr><% end %>
      <% if Current.user.can?('sales.read') %><tr><td class="td" colspan="7"><%= link_to 'Open C-Trax receipts and cash-session checks', ctrax_day_path(snapshot), class: 'font-semibold text-olive-deep hover:underline' %></td></tr><% end %>
    <% end %><% if @report.ctrax.empty? %><tr><td class="empty-row" colspan="7">No stored C-Trax day for this date. Native store-day boundaries use the store timezone shown here.</td></tr><% end %></tbody>
  </table></section>
  </details>
  <details class="card"><summary class="disclosure-trigger p-4 font-semibold">SwipeSimple native observations <span class="pill-taupe ml-2"><%= "#{@report.swipesimple.size} tender groups" %></span></summary>
  <section class="table-region" tabindex="0" role="region" aria-label="Source evidence table, scroll horizontally for all columns"><table class="table">
    <caption class="p-4 text-left font-semibold">SwipeSimple native observations — separate from canonical sales</caption>
    <thead><tr><% [['Merchant account', false], ['Currency', false], ['Tender', false], ['Sales', true], ['Refunds', true], ['Net', true], ['Sale tips', true], ['Refund tips', true], ['Excluded rows', true]].each do |label, numeric| %><th scope="col" class="th <%= 'num' if numeric %>"><%= label %></th><% end %></tr></thead>
    <tbody><% @report.swipesimple.each do |row| %><tr><td class="td"><%= row[:account] %></td><td class="td"><%= row[:currency] %></td><td class="td"><%= row[:tender].presence || 'Unknown' %></td>
      <% [:sale_cents, :refund_cents, :net_cents, :sale_tip_cents, :refund_tip_cents].each do |key| %><td class="td num"><%= money.call(row[key]) %></td><% end %><td class="td num"><%= row[:excluded_rows] %></td></tr><% end %>
      <% if @report.swipesimple.empty? %><tr><td class="empty-row" colspan="9">No native transaction observations for this day.</td></tr><% end %></tbody>
  </table><p class="p-4 text-xs"><% if Current.user.can?('sales.read') %><%= link_to 'SwipeSimple daily close', swipesimple_days_path(date: day_param), class: 'font-semibold text-olive-deep hover:underline' %> · <% end %><%= link_to 'SwipeSimple reporting and native imports', swipesimple_reports_path(day: day_param), class: 'font-semibold text-olive-deep hover:underline' %></p></section>
  </details>
  <details class="card"><summary class="disclosure-trigger p-4 font-semibold">Authorize.net API settlement observations <span class="pill-taupe ml-2"><%= "#{@report.gateway.size} groups" %></span></summary>
  <section class="table-region" tabindex="0" role="region" aria-label="Source evidence table, scroll horizontally for all columns"><table class="table">
    <caption class="p-4 text-left font-semibold">Authorize.net API observations by settlement day — not additional sales</caption>
    <thead><tr><% ['Environment', 'Gateway', 'Currency', 'Status', 'Type', 'Count', 'Settlement amount'].each do |label| %><th scope="col" class="th"><%= label %></th><% end %></tr></thead>
    <tbody><% @report.gateway.each do |row| %><tr><% row.each do |value| %><td class="td"><%= value.nil? ? 'Unknown' : value %></td><% end %></tr><% end %>
      <% if @report.gateway.empty? %><tr><td class="empty-row" colspan="7">No API settlement observations for this day. Retained portal exports are listed below.</td></tr><% end %></tbody>
  </table></section>
  </details>
  <details class="card"><summary class="disclosure-trigger p-4 font-semibold">Authorize.net portal observations <span class="pill-taupe ml-2"><%= "#{@report.portal.size} transactions" %></span></summary>
  <section class="table-region" tabindex="0" role="region" aria-label="Source evidence table, scroll horizontally for all columns"><table class="table">
    <caption class="p-4 text-left font-semibold">Authorize.net portal observations submitted or settled on this day — separate from the API</caption>
    <thead><tr><% [['Gateway / transaction', false], ['Currency', false], ['Status / type', false], ['Submitted at', false], ['Settled at', false], ['Settlement amount', true], ['Original export', false]].each do |label, numeric| %><th scope="col" class="th <%= 'num' if numeric %>"><%= label %></th><% end %></tr></thead>
    <tbody><% @report.portal.each do |row| %><tr><td class="td"><%= row['gateway_id'] %> / <%= row['transaction_id'] %></td><td class="td"><%= row['currency'] %></td><td class="td"><%= row['status'] %> / <%= row['transaction_type'] %></td><td class="td"><%= row['submitted_at'] %></td><td class="td"><%= row['settled_at'].presence || 'Unknown' %></td><td class="td num"><%= money.call(row['settlement_cents']) %></td><td class="td"><%= link_to "Export ##{row['export_id']}", native_document_daily_reconciliations_path(source: 'authorize_net', id: row['export_id']), class: 'font-semibold text-olive-deep hover:underline' %></td></tr><% end %>
    <% if @report.portal.empty? %><tr><td class="empty-row" colspan="7">No retained portal observations submitted or settled on this day.</td></tr><% end %></tbody>
  </table></section>
  </details>
  <details class="card"><summary class="disclosure-trigger p-4 font-semibold">NAB / IRIS reports <span class="pill-taupe ml-2"><%= "#{@report.iris.size} snapshots" %></span></summary>
  <section class="space-y-3 p-4"><h3 class="card-title">NAB / IRIS reports covering this day</h3>
    <p class="text-sm">Windows may overlap. Batch amounts do not establish net bank funding. Native files imported after this release appear in the document vault below.</p>
    <% @report.iris.each do |report| %><p class="text-sm">Snapshot #<%= report.id %> · <%= report.report_kind.humanize %> · <%= report.window_from %> to <%= report.window_to %> · <%= report.status %> · observed <%= report.observed_at.iso8601 %></p><% end %>
    <% if @report.iris.empty? %><p class="text-sm">No stored snapshot covers this day.</p><% end %>
    <p class="text-xs">Up to 50 latest snapshots. <%= link_to 'NAB / IRIS reporting and imports', pos_connection_path('iris_reporting'), class: 'font-semibold text-olive-deep hover:underline' %></p>
  </section>
  </details>

  <section id="documents" class="space-y-4">
    <div class="card-head"><div><h2 class="section-title">2. Keep the originals</h2><p class="card-hint">Documents covering <%= @report.day.strftime('%B %-d, %Y') %>. Earlier versions remain available.</p></div><div class="card-head-actions"><%= link_to 'Open source documents', reconciliation_documents_path, class: 'btn-ghost btn-sm' %></div></div>
    <div class="grid gap-4 md:grid-cols-2">
      <%= render partial: 'reconciliation_documents/document', collection: @report.documents.reverse, as: :doc, locals: { successors: @successors || {}, copies: @drive_copies || {} } %>
    </div>
    <% if @report.documents.empty? %>
      <%= empty_state 'No documents attached to this day yet', hint: 'Add a daily report, invoice, bank statement or fee report. Keep its original file so every comparison has evidence.' do %>
        <% if can_write %><%= link_to 'Add document', '#upload-document', class: 'btn-ghost' %><% end %>
      <% end %>
    <% end %>
    <p class="text-xs text-mocha">Originals and review notes have no automatic deletion. Your encrypted Rupert copy stays available while a Drive upload is pending.</p>
  </section>
  <% if can_write %>
    <section id="upload-document" class="section-card" aria-labelledby="upload-document-title">
      <div class="card-head"><div><h2 id="upload-document-title" class="section-title"><%= @evidence_values&.dig('supersedes_id').present? ? "Correct control ##{@evidence_values['supersedes_id']}" : 'Add a report, invoice or statement' %></h2><p class="card-hint">Start with the original file and its covered dates. Source totals are optional unless you choose Register control.</p></div></div>
      <% if @evidence_values&.dig('supersedes_id').present? %><div class="rounded-card bg-cream p-4 text-sm"><p class="font-semibold">The previous original will stay in the library.</p><p>Attach the replacement report and enter its totals. Keep the same source, dates, currency and location.</p><%= link_to 'Cancel correction', daily_reconciliations_path(day: day_param, anchor: 'documents'), class: 'mt-2 inline-block font-semibold text-olive-deep hover:underline' %></div><% end %>
      <% if @request %><div class="space-y-2 rounded-card border border-fog bg-paper p-4"><p class="text-sm font-semibold">Original for follow-up #<%= @request.id %>: <%= @request.title %></p><p class="text-sm text-mocha">After upload, review the original and save a progress note to link it. You choose whether to keep investigating, wait or resolve.</p><%= link_to 'Back to this follow-up', reconciliation_follow_up_path(@request, close_day: @close_day&.iso8601, anchor: 'record-progress'), class: 'text-sm font-semibold text-olive-deep hover:underline' %></div><% end %>
      <%= form_with url: daily_reconciliations_path, multipart: true, scope: :evidence, class: 'space-y-4', data: { controller: 'reconciliation-form' } do |f| %>
        <%= hidden_field_tag :day, day_param %><%= hidden_field_tag :request_id, @request.id if @request %><%= hidden_field_tag :close_day, @close_day.iso8601 if @close_day %>
        <fieldset class="space-y-4">
          <legend class="card-title">Original</legend>
          <div class="grid gap-4 md:grid-cols-2">
            <div><%= f.label :source, 'Source', class: 'field-label' %><%= f.select :source, ReconciliationDocument::SOURCES.excluding('rupert').map { |s| [reconciliation_source(s), s] }, { selected: reconciliation_form_value(:source, 'other') }, class: 'select' %></div>
            <div><%= f.label :kind, 'Document kind', class: 'field-label' %><%= f.select :kind, (ReconciliationDocument::KINDS - ReconciliationDocument::GENERATED_KINDS).map { |s| [reconciliation_source(s), s] }, { selected: reconciliation_form_value(:kind, 'source_export') }, class: 'select', data: { reconciliation_form_target: 'kind', action: 'change->reconciliation-form#update' } %></div>
            <div><%= f.label :period_from, 'Period starts', class: 'field-label' %><%= f.date_field :period_from, value: reconciliation_form_value(:period_from, @report.day), required: true, class: 'input', data: { reconciliation_form_target: 'from', action: 'change->reconciliation-form#update' } %></div>
            <div><%= f.label :period_to, 'Period ends', class: 'field-label' %><%= f.date_field :period_to, value: reconciliation_form_value(:period_to, @report.day), required: true, class: 'input', data: { reconciliation_form_target: 'to' } %></div>
          </div>
          <div><%= label_tag :file, 'Original document · CSV, PDF, PNG, JPEG, JSON or TXT · up to 8 MiB', class: 'field-label' %><%= file_field_tag :file, required: true, accept: '.csv,.pdf,.png,.jpg,.jpeg,.json,.txt', class: 'input', data: { reconciliation_form_target: 'file', action: 'change->reconciliation-form#fileChanged' } %><p class="mt-1 text-xs text-mocha" role="status" data-reconciliation-form-target="fileStatus">One original file, up to 8 MiB. Its bytes and checksum are retained.</p></div>
          <div><%= f.label :note, 'Source context / explanation', class: 'field-label' %><%= f.text_area :note, value: reconciliation_form_value(:note), maxlength: 4000, rows: 3, class: 'input' %></div>
        </fieldset>
        <details class="explainer rounded-card border border-fog p-4" data-reconciliation-form-target="totals"><summary class="explainer-summary text-sm font-semibold">Source totals and corrections</summary><div class="mt-4 space-y-4"><div class="grid gap-4 md:grid-cols-2">
          <div><%= f.label :currency, 'Currency (required for controls)', class: 'field-label' %><%= f.text_field :currency, value: reconciliation_form_value(:currency), placeholder: 'USD', maxlength: 3, pattern: '[A-Z]{3}', class: 'input', data: { reconciliation_form_target: 'currency' } %></div>
          <div><%= f.label :location_id, 'Location to compare', class: 'field-label' %><%= f.select :location_id, (@locations || []).map { |location| ["#{location.name} · #{reconciliation_source(location.source)}", location.id] } + (reconciliation_form_value(:location_id).present? && (@locations || []).none? { |loc| loc.id == reconciliation_form_value(:location_id) } ? [["Recorded pool #{reconciliation_form_value(:location_id)}", reconciliation_form_value(:location_id)]] : []), { include_blank: 'Unassigned records only', selected: reconciliation_form_value(:location_id) }, class: 'select' %></div>
        </div>
        <p class="text-sm">Choose Register control to compare totals from a single-day report. Enter only amounts that share the metric definition and scope above: order total by order date, cash/card receipts by payment date, refunds by refund date. Refund amounts are positive. Leave missing amounts blank. Other document kinds are retained as supporting evidence.</p>
        <div class="grid gap-4 md:grid-cols-3"><% ReconciliationEvidence::AMOUNTS.each do |key| %><div><%= f.label key, "#{key.humanize} (currency units)", class: 'field-label' %><%= f.text_field key, value: reconciliation_form_value(key), inputmode: 'decimal', placeholder: '123.45 or blank', class: 'input' %></div><% end %></div>
        <%= f.hidden_field :supersedes_id, value: reconciliation_form_value(:supersedes_id) %>
        </div></details>
        <div class="form-actions"><%= f.submit 'Save document', class: 'btn-primary', data: { turbo_submits_with: 'Saving…' } %></div>
      <% end %>
    </section>
    <details id="withdraw-control" class="explainer card card-pad" <%= 'open' if @error_section == 'withdraw-control' %>><summary class="explainer-summary font-semibold">Withdraw a mistaken control</summary><div class="mt-4 space-y-3">
      <p class="text-sm">Use this for an accidental duplicate or a control that should not be compared. Its original file, totals and your explanation remain in the vault.</p>
      <%= form_with url: withdraw_daily_reconciliations_path, class: 'space-y-3' do |f| %>
        <%= f.hidden_field :day, value: day_param %>
        <div><%= f.label :evidence_id, 'Choose the current control', class: 'field-label' %><%= f.select :evidence_id, @report.controls.map { |doc| ["##{doc.id} · #{reconciliation_source(doc.source)} · #{doc.filename}", doc.id] }, { include_blank: 'Select a control', selected: @withdraw_values&.dig('evidence_id') }, required: true, class: 'select' %></div>
        <div><%= f.label :reason, 'Reason for withdrawal', class: 'field-label' %><%= f.text_area :reason, value: @withdraw_values&.dig('reason'), required: true, maxlength: 4000, rows: 3, class: 'input' %></div>
        <div class="form-actions"><%= f.submit 'Withdraw control and keep evidence', class: 'btn-danger' %></div>
      <% end %>
    </div></details>
    <section id="review-history" class="section-card" aria-labelledby="review-history-title">
      <div class="card-head"><div><h2 id="review-history-title" class="section-title">3. Archive and review this report</h2><p class="card-hint">Reviewed records your assessment, including any unresolved differences. It does not change source data. A changed report requires a fresh review.</p></div><div class="card-head-actions"><%= button_to 'Keep a permanent report version', archive_daily_reconciliations_path(day: day_param), class: 'btn-ghost btn-sm' %></div></div>
      <%= form_with url: review_daily_reconciliations_path, class: 'space-y-3' do |f| %>
        <%= f.hidden_field :day, value: day_param %><%= f.hidden_field :report_digest, value: @report.digest %>
        <div><%= f.label :status, 'Review status', class: 'field-label' %><%= f.select :status, [['Needs attention', 'needs_attention'], ['Reviewed', 'reviewed']], { selected: @review_values&.dig('status') || 'needs_attention' }, class: 'select' %></div>
        <div><%= f.label :notes, 'Review notes / unresolved differences', class: 'field-label' %><%= f.text_area :notes, value: @review_values&.dig('notes'), required: true, maxlength: 4000, rows: 4, class: 'input' %></div>
        <div class="form-actions"><%= f.submit 'Save review', class: 'btn-primary', data: { turbo_submits_with: 'Saving…' } %></div>
      <% end %>
    </section>
  <% end %>
  <section id="<%= can_write ? 'retained-review-history' : 'review-history' %>" class="section-card">
    <%= section_heading 'Report archive and review history', hint: 'At 07:15 Eastern each day, Rupert archives the previous seven business days. Identical reports reuse their archive; changed reports keep a new version. Older days can be archived on demand.', level: :h3 do %><%= link_to 'Browse all report archives', reconciliation_documents_path(category: 'archives', from: day_param, to: day_param), class: 'btn-ghost btn-sm' %><% end %>
    <% if @archives.empty? && @reviews.empty? %><p class="text-sm text-mocha">No saved report or review for this date yet.</p><% end %>
    <% @archives.each do |doc| %><div class="flex flex-wrap items-center justify-between gap-2 rounded-card border border-fog p-3"><%= link_to "Report ##{doc.id} · #{doc.created_at.in_time_zone.strftime('%b %-d at %-I:%M %p %Z')}", document_daily_reconciliation_path(doc), class: 'text-sm font-semibold text-olive-deep hover:underline' %><span class="<%= doc.metadata['report_digest'] == @report.digest ? 'pill-fern' : 'pill-taupe' %>"><%= doc.metadata['report_digest'] == @report.digest ? 'Matches current report' : 'Earlier report version' %></span></div><% end %>
    <% @reviews.each do |review_entry| %><article class="rounded-card border border-fog p-4"><div class="flex flex-wrap justify-between gap-2"><p class="text-sm font-semibold"><span class="<%= reconciliation_tone(review_entry.report_digest == @report.digest ? review_entry.status : 'changed') %>"><%= review_entry.status.humanize %></span> · <%= review_entry.report_digest == @report.digest ? 'Current report version' : 'Changed since review' %></p><p class="text-xs"><%= review_entry.created_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %> · <%= review_entry.reviewed_by&.name.presence || 'Former user' %></p></div><p class="mt-3 whitespace-pre-wrap text-sm"><%= review_entry.notes %></p></article><% end %>
  </section>
  <details class="explainer card card-pad"><summary class="explainer-summary font-semibold">Browse existing native export library</summary><div class="mt-4 space-y-3">
    <%= link_to 'Search all native exports in the library', reconciliation_documents_path(category: 'native_exports'), class: 'text-sm font-semibold text-olive-deep hover:underline' %>
    <p class="text-sm">The latest 20 exports per source, across all dates. Export time is not the transaction period. Download an original to verify its covered dates.</p>
    <% @swipesimple_exports.each do |doc| %><p class="text-sm"><%= link_to "SwipeSimple #{doc.kind} ##{doc.id} · received #{doc.exported_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z')}", native_document_daily_reconciliations_path(source: 'swipesimple', id: doc.id), class: 'font-semibold text-olive-deep hover:underline' %></p><% end %>
    <% @authorize_exports.each do |doc| %><p class="text-sm"><%= link_to "Authorize.net #{doc.kind} ##{doc.id} · received #{doc.exported_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z')}", native_document_daily_reconciliations_path(source: 'authorize_net', id: doc.id), class: 'font-semibold text-olive-deep hover:underline' %></p><% end %>
  </div></details>
</div>
