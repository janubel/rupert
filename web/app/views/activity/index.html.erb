<%# Activity: a List page (docs/ui-standards.md §4) over the audit trail. %>
<div class="space-y-6">
  <%= page_header 'Activity', subtitle: "Who did what, and when: #{number_with_delimiter(@pagy.count)} matching action#{@pagy.count == 1 ? '' : 's'}, newest first.",
                  menu: [['Download CSV', activity_path(request.query_parameters.merge(format: :csv)), { data: { turbo: false } }]] %>
  <p class="text-xs text-taupe">Entries are kept for seven years.</p>

  <%= form_tag activity_path, method: :get, class: "toolbar" do %>
    <div class="toolbar-field">
      <label class="field-label" for="group">Show</label>
      <%= select_tag :group, options_for_select([["Everything", ""]] + ActivityController::GROUPS.map { |key, (label, _)| [label, key] }, params[:group]), class: "input" %>
    </div>
    <div class="toolbar-field">
      <label class="field-label" for="q">Search</label>
      <input type="search" id="q" name="q" value="<%= params[:q] %>" placeholder="Person, action or detail" class="input">
    </div>
    <div class="toolbar-field">
      <label class="field-label" for="from">From</label>
      <%= date_field_tag :from, params[:from], class: "input" %>
    </div>
    <div class="toolbar-field">
      <label class="field-label" for="to">To</label>
      <%= date_field_tag :to, params[:to], class: "input" %>
    </div>
    <div class="toolbar-actions">
      <%= submit_tag "Apply", class: "btn-primary", name: nil %>
      <%= link_to "Clear", activity_path, class: "btn-ghost" %>
    </div>
  <% end %>

  <div class="table-region" role="region" tabindex="0" aria-label="Activity">
    <table class="table">
      <thead>
        <tr>
          <th scope="col" class="th">When</th>
          <th scope="col" class="th">Who</th>
          <th scope="col" class="th">Action</th>
          <th scope="col" class="th">Subject</th>
          <th scope="col" class="th">Details</th>
        </tr>
      </thead>
      <tbody>
        <% if @activities.empty? %>
          <tr><td colspan="5" class="td empty-row">No matching activity. Clear the filters or widen the dates.</td></tr>
        <% end %>
        <% @activities.each do |a| %>
          <tr>
            <td class="td whitespace-nowrap text-mocha"><%= l(a.created_at, format: :short) %></td>
            <td class="td font-medium text-ink"><%= a.actor_name %></td>
            <td class="td"><span class="pill-taupe"><%= a.action.tr("_", " ") %></span></td>
            <td class="td text-mocha">
              <% if a.subject_type.present? && a.subject_type != 'NilClass' %>
                <span class="text-xs text-taupe"><%= a.subject_type.demodulize.underscore %></span>
                <% if a.subject_label %><span class="ml-1 font-medium text-ink"><%= a.subject_label %></span><% end %>
              <% else %>
                <span class="text-taupe">—</span>
              <% end %>
            </td>
            <td class="td max-w-xs truncate text-xs text-taupe" title="<%= a.details %>"><%= a.details.presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %>
    <div class="text-xs text-taupe"><%== @pagy.series_nav %></div>
  <% end %>
</div>
