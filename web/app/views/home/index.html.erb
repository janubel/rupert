<%# Dashboard: the Overview template (docs/ui-standards.md §4). The greeting is the h1; widgets follow in the saved order. %>
<% content_for :title, "Dashboard" %>
<% presenter = DashboardPresenter.new(user: Current.user) %>
<% widgets = @widgets || DashboardWidget.entries({}, user: Current.user) %>
<div class="space-y-8" data-controller="dashboard-customizer <%= "live-sync" if Current.user.can?("sync.read") %>" data-live-sync-interval-value="30000" data-action="click->dashboard-customizer#onClick change->dashboard-customizer#onChange">
  <div>
    <%= page_header "#{time_based_greeting}.", subtitle: 'Sales, daily close and stock in one view of your business.', eyebrow: l(Time.current, format: :long) do %>
      <button type="button" aria-expanded="false" aria-controls="dashboard-layout-editor" data-dashboard-customizer-target="toggle" data-action="click->dashboard-customizer#toggleEditor" class="btn-ghost" <%= tour_anchor('customize') %>>Customize</button>
      <% if Current.user.can?("sync.write") %>
        <%= form_tag syncs_path, method: :post, class: 'inline' do %>
          <%= submit_tag "Sync now", class: "btn-primary", data: { turbo_submits_with: "Syncing…" } %>
        <% end %>
      <% end %>
    <% end %>
    <% if Current.user.can?("sync.read") %><div class="mt-2"><%= render "shared/last_sync", sync: presenter.last_sync %></div><% end %>
  </div>

  <%= render 'shared/learning_welcome' %>
  <% if Current.user.can?("sync.read") %>
    <%= render "syncs/banner" %>
  <% end %>

  <section id="dashboard-layout-editor" data-dashboard-customizer-target="panel" class="section-card hidden">
    <%= section_heading 'Customize dashboard', hint: 'Show or hide widgets and set their order. Your layout is saved to your profile.' do %>
      <button type="button" data-dashboard-customizer-target="done" data-action="click->dashboard-customizer#closeEditor" class="btn-ghost btn-sm">Done</button>
    <% end %>
    <ul data-dashboard-customizer-target="list" class="space-y-2">
      <% widgets.each do |widget, visible| %>
        <li data-editor-key="<%= widget.key %>" class="flex items-center gap-3 rounded-control bg-haze px-4 py-2.5">
          <span class="flex flex-col text-xs leading-tight text-taupe">
            <button type="button" data-move="<%= widget.key %>" data-dir="up" class="hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-olive" title="Move <%= widget.label %> up" aria-label="Move <%= widget.label %> up"><%= content_tag :span, "▲" %></button>
            <button type="button" data-move="<%= widget.key %>" data-dir="down" class="hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-olive" title="Move <%= widget.label %> down" aria-label="Move <%= widget.label %> down">▼</button>
          </span>
          <label class="flex flex-1 items-center gap-2.5 text-sm text-ink">
            <input type="checkbox" data-visible="<%= widget.key %>" <%= visible ? "checked" : "" %> class="checkbox accent-olive">
            <%= widget.label %>
          </label>
        </li>
      <% end %>
    </ul>
    <div class="form-actions">
      <button type="button" data-dashboard-customizer-target="save" data-action="click->dashboard-customizer#save" class="btn-primary">Save layout</button>
      <button type="button" data-dashboard-customizer-target="reset" data-action="click->dashboard-customizer#reset" class="btn-ghost">Reset to default</button>
      <span role="status" aria-live="polite" data-dashboard-customizer-target="status" class="text-xs text-mocha"></span>
    </div>
  </section>

  <%= render "home/daily_actions" %>
  <div id="dashboard-widgets" class="space-y-8">
    <% widgets.each do |widget, visible| %>
      <section id="dashboard-widget-<%= widget.key %>" data-widget-key="<%= widget.key %>" <%= visible ? "" : "hidden" %> <%= tour_anchor(widget.key) if %w[stats attention].include?(widget.key) %>>
        <%= render widget.partial, presenter: presenter %>
      </section>
    <% end %>
  </div>
  <% if Current.user.can?("sync.read") %><%= render "home/source_sync_status" %><% end %>
</div>
