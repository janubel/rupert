<% content_for :title, "Dashboard" %>
<% presenter = DashboardPresenter.new(user: Current.user) %>
<% widgets = @widgets || DashboardWidget.entries({}, user: Current.user) %>
<div class="space-y-8" data-controller="<%= "live-sync" if Current.user.can?("sync.read") %>" data-action="mousedown->dashboard-customizer#onMouseDown">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow mb-2 text-olive"><%= l(Time.current, format: :long) %></p>
      <h1 class="font-display text-4xl text-ink md:text-5xl"><%= time_based_greeting %>.</h1>
      <p class="mt-3 max-w-xl text-mocha">Daily business at a glance — sales, orders, and inventory health across Shopify and Square.</p>
    </div>
    <div class="flex flex-col items-end gap-2">
      <div class="flex items-center gap-2">
        <button type="button" data-dashboard-customizer-target="toggle" data-action="click->dashboard-customizer#toggleEditor" class="btn-ghost btn-sm">Customize</button>
        <% if Current.user.can?("sync.write") %>
        <%= form_tag syncs_path, method: :post do %>
          <%= submit_tag "Sync now", class: "btn-primary", data: { turbo_submits_with: "Syncing…" } %>
        <% end %>
        <% end %>
      </div>
      <% if Current.user.can?("sync.read") %><%= render "shared/last_sync", sync: presenter.last_sync %><% end %>
    </div>
  </section>

  <% if Current.user.can?("sync.read") %>
    <%= render "syncs/banner" %>
    <%= render "home/source_sync_status" %>
  <% end %>

  <section data-controller="dashboard-customizer" data-dashboard-customizer-target="panel" class="card card-pad hidden">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-xl text-ink">Customize dashboard</h2>
      <button type="button" data-dashboard-customizer-target="done" data-action="click->dashboard-customizer#setCustomizingValue:false" class="btn-ghost btn-sm">Done</button>
    </div>
    <p class="mt-1 text-xs text-taupe">Show or hide widgets and set their order. Your layout is saved to your profile.</p>
    <ul data-dashboard-customizer-target="list" class="mt-4 space-y-2">
      <% widgets.each do |widget, visible| %>
        <li data-editor-key="<%= widget.key %>" class="flex items-center gap-3 rounded-xl bg-haze px-4 py-2.5">
          <span class="flex flex-col text-[10px] leading-tight text-taupe">
            <button type="button" data-move="<%= widget.key %>" data-dir="up" class="hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-olive" title="Move <%= widget.label %> up" aria-label="Move <%= widget.label %> up"><%= content_tag :span, "▲" %></button>
            <button type="button" data-move="<%= widget.key %>" data-dir="down" class="hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-olive" title="Move <%= widget.label %> down" aria-label="Move <%= widget.label %> down">▼</button>
          </span>
          <label class="flex flex-1 items-center gap-2.5 text-sm text-ink">
            <input type="checkbox" data-visible="<%= widget.key %>" <%= visible ? "checked" : "" %> class="accent-olive">
            <%= widget.label %>
          </label>
        </li>
      <% end %>
    </ul>
    <div class="mt-4 flex items-center gap-3">
      <button type="button" data-dashboard-customizer-target="save" data-action="click->dashboard-customizer#save" class="btn-primary">Save layout</button>
      <button type="button" data-dashboard-customizer-target="reset" data-action="click->dashboard-customizer#reset" class="btn-ghost">Reset to default</button>
      <span data-dashboard-customizer-target="status" class="text-xs text-mocha"></span>
    </div>
  </section>

  <% cached_fragment("dashboard/widgets", user_id: Current.user.id, permissions: Current.user.permissions_signature) do %>
    <div id="dashboard-widgets" class="space-y-8">
      <% widgets.each do |widget, visible| %>
        <section data-widget-key="<%= widget.key %>" <%= visible ? "" : "hidden" %>>
          <%= render widget.partial, presenter: presenter %>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
