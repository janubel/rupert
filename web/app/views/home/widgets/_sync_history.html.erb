<div class="section-card">
  <%= section_heading 'Sync history' %>
  <% if presenter.recent_syncs.empty? %>
    <%= empty_state 'No syncs recorded', hint: 'Run one from the Sync page.' %>
  <% else %>
    <ul class="divide-y divide-fog">
      <% presenter.recent_syncs.each do |sync| %>
        <li class="flex items-center justify-between gap-4 py-3">
          <div class="min-w-0">
            <p class="truncate text-sm font-medium text-ink"><%= sync.source || sync.mode %> sync</p>
            <p class="text-xs text-taupe"><%= l(sync.startedAt, format: :short) %></p>
          </div>
          <span class="<%= sync.success? ? "pill-fern" : sync.failed? ? "pill-rose" : "pill-taupe" %>"><%= sync.status %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
