<div class="section-card">
  <%= section_heading 'Needs attention' %>
  <% items = attention_items(presenter) %>
  <% if items.empty? %>
    <%= empty_state 'All quiet', hint: 'Nothing needs attention right now.' %>
  <% else %>
    <ul class="divide-y divide-fog">
      <% items.each do |item| %>
        <li class="flex items-center justify-between gap-4 py-3">
          <div class="min-w-0">
            <p class="truncate text-sm font-medium text-ink"><%= item[:label] %></p>
            <p class="text-xs text-taupe"><%= item[:note] %></p>
          </div>
          <span class="<%= item[:pill] %> shrink-0"><%= item[:value] %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
