<%# Thirty days of bank movement at a glance; the Cash flow page has the full picture. Reads only statement lines. %>
<% report = CashFlowReport.from_params({ range: '30d' }); series = report.bank_series %>
<div class="card card-pad">
  <div class="flex items-baseline justify-between gap-2">
    <h2 class="font-display text-xl text-ink">Cash flow · last 30 days</h2>
    <%= link_to 'Open Cash flow', finance_cash_flow_path, class: 'text-xs text-olive underline' %>
  </div>
  <% if report.bank_line_count.zero? %>
    <p class="mt-3 rounded-xl bg-haze px-4 py-3 text-sm text-taupe">No bank statement lines in the last 30 days. <%= link_to 'Import a statement', bank_statements_path, class: 'underline' %> to see money in and out here.</p>
  <% else %>
    <dl class="mt-4 grid grid-cols-3 gap-4">
      <div class="rounded-xl bg-haze px-4 py-3"><dt class="text-xs font-medium text-mocha">Into the bank</dt><dd class="font-display text-2xl text-ink" title="<%= finance_money_text(report.cash_in_cents) %>"><%= cash_flow_compact(report.cash_in_cents) %></dd></div>
      <div class="rounded-xl bg-haze px-4 py-3"><dt class="text-xs font-medium text-mocha">Out of the bank</dt><dd class="font-display text-2xl text-ink" title="<%= finance_money_text(report.cash_out_cents) %>"><%= cash_flow_compact(report.cash_out_cents) %></dd></div>
      <div class="rounded-xl bg-haze px-4 py-3"><dt class="text-xs font-medium text-mocha">Net</dt><dd class="font-display text-2xl <%= report.net_cents.negative? ? 'money-negative' : 'text-ink' %>" title="<%= finance_money_text(report.net_cents) %>"><%= cash_flow_compact(report.net_cents) %></dd>
        <dd class="mt-1"><%= cash_flow_sparkline(series[:cumulative], width: 140, height: 28) %></dd></div>
    </dl>
    <p class="mt-3 text-xs text-taupe"><%= pluralize(report.bank_line_count, 'statement line') %> through <%= report.bank_data_through.strftime('%b %-d') %><% if report.pending_count.positive? %> · <%= link_to "#{report.pending_count} need a decision", bank_statements_path, class: 'underline' %><% end %>.</p>
  <% end %>
</div>
