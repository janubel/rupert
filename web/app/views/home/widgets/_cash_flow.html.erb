<%# Thirty days of bank movement at a glance; the Cash flow page has the full picture. Reads only statement lines. %>
<% report = CashFlowReport.from_params({ range: '30d' }); series = report.bank_series %>
<div class="section-card">
  <%= section_heading 'Cash flow · last 30 days' do %>
    <%= link_to 'Open cash flow', finance_cash_flow_path, class: 'btn-ghost btn-sm' %>
  <% end %>
  <% if report.bank_line_count.zero? %>
    <%= empty_state 'No bank statement lines in the last 30 days', hint: 'Import a statement to see money in and out here.' do %><%= link_to 'Import a statement', bank_statements_path, class: 'btn-ghost btn-sm' %><% end %>
  <% else %>
    <dl class="facts">
      <div><dt>Into the bank</dt><dd class="stat-value-sm" title="<%= finance_money_text(report.cash_in_cents) %>"><%= cash_flow_compact(report.cash_in_cents) %></dd></div>
      <div><dt>Out of the bank</dt><dd class="stat-value-sm" title="<%= finance_money_text(report.cash_out_cents) %>"><%= cash_flow_compact(report.cash_out_cents) %></dd></div>
      <div><dt>Net</dt><dd class="stat-value-sm <%= report.net_cents.negative? ? 'money-negative' : '' %>" title="<%= finance_money_text(report.net_cents) %>"><%= cash_flow_compact(report.net_cents) %></dd>
        <dd class="mt-1"><%= cash_flow_sparkline(series[:cumulative], width: 140, height: 28) %></dd></div>
    </dl>
    <p class="text-xs text-taupe"><%= pluralize(report.bank_line_count, 'statement line') %> through <%= report.bank_data_through.strftime('%b %-d') %><% if report.pending_count.positive? %> · <%= link_to "#{report.pending_count} need a decision", bank_statements_path, class: 'underline' %><% end %>.</p>
  <% end %>
</div>
