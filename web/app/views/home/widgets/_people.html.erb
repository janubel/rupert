<div class="card card-pad">
  <div class="flex items-baseline justify-between">
    <h2 class="font-display text-xl text-ink">People</h2>
    <% if Current.user.can?("hr.read") %>
      <%= link_to "All", people_employees_path, class: "text-xs font-semibold text-olive hover:underline" %>
    <% end %>
  </div>

  <% if Current.user.can?("hr.read") %>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div>
        <p class="stat-label">Active</p>
        <p class="stat-value mt-0.5"><%= People::Employee.active.count %></p>
      </div>
      <div>
        <p class="stat-label">On leave</p>
        <p class="stat-value mt-0.5"><%= People::Employee.where(status: "on_leave").count %></p>
      </div>
      <% if Current.user.can?("leave.read") %>
      <div>
        <p class="stat-label">Leave pending</p>
        <p class="stat-value mt-0.5"><%= People::LeaveRequest.pending.count %></p>
      </div>
      <% end %>
      <% if Current.user.can?("timesheets.read") %>
      <div>
        <p class="stat-label">To approve</p>
        <p class="stat-value mt-0.5"><%= People::Timesheet.awaiting_review.count %></p>
      </div>
      <% end %>
    </div>

    <% if Current.user.can?("timesheets.read") %>
    <div class="mt-4">
      <h3 class="text-sm font-display text-ink">Timesheets awaiting review</h3>
      <% People::Timesheet.awaiting_review.includes(:employee).recent(4).each do |timesheet| %>
        <div class="flex items-center justify-between gap-3 py-2 text-sm">
          <%= link_to "#{timesheet.employee&.name} · #{timesheet.period_label}", people_timesheet_path(timesheet), class: "truncate font-medium text-ink hover:text-olive hover:underline" %>
          <span class="shrink-0 text-xs text-taupe"><%= number_with_precision(timesheet.total_hours, precision: 1) %>h</span>
        </div>
      <% end %>
      <% if People::Timesheet.awaiting_review.count.zero? %>
        <p class="py-2 text-sm text-taupe">No timesheets waiting — all caught up.</p>
      <% end %>
    </div>
    <% end %>
  <% else %>
    <p class="mt-4 text-sm text-taupe">You don't have access to the People modules. Ask a manager or admin to grant it.</p>
  <% end %>
</div>
