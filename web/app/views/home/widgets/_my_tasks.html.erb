<% mine = Projects::Task.assigned_to(Current.user.id).unfinished %>
<% overdue = mine.overdue.count %>
<div class="card card-pad">
  <div class="flex items-baseline justify-between">
    <h2 class="font-display text-xl text-ink">My tasks</h2>
    <%= link_to "All", projects_tasks_path(mine: "1"), class: "text-xs font-semibold text-olive hover:underline" %>
  </div>
  <% if overdue.positive? %><p class="mt-1 text-xs font-semibold text-rose"><%= pluralize(overdue, "task") %> overdue</p><% end %>
  <ul class="mt-3 divide-y divide-fog">
    <% mine.includes(:project).by_priority.limit(6).each do |task| %>
      <li class="flex items-center gap-2 py-2.5">
        <%= priority_dot(task.priority) %>
        <%= link_to task.title, projects_task_path(task), class: "min-w-0 flex-1 truncate text-sm font-medium text-ink hover:underline" %>
        <% if task.due_on %><span class="shrink-0 text-xs <%= due_class(task) %>"><%= task.due_label %></span><% end %>
      </li>
    <% end %>
    <% if mine.none? %><li class="py-3 text-sm text-taupe">Nothing assigned to you.</li><% end %>
  </ul>
</div>
