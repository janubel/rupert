<section class="card" aria-label="Today by channel">
  <div class="card-pad pb-3"><%= section_heading 'Today by channel', hint: "Recorded sales · #{Time.zone.now.strftime('%Z')}" %></div>
  <% if presenter.sales_warnings.any? %>
    <div class="flash flash-alert mx-5 mb-3 text-sm" role="status"><p class="font-semibold">Sales coverage needs review</p><ul class="mt-1 list-disc space-y-1 pl-5"><% presenter.sales_warnings.each do |warning| %><li><%= warning %></li><% end %></ul></div>
  <% end %>
  <dl class="row-list border-t border-fog">
    <% presenter.today_groups.each do |source, gross, count| %>
      <% freshness = presenter.sales_freshness.fetch(source, {}) %>
      <div class="row-item" data-sales-source="<%= source %>">
        <div class="min-w-0">
          <dt class="font-semibold text-ink"><%= DashboardSales::LABELS.fetch(source, source.humanize) %></dt>
          <% if freshness.any? %>
            <dd class="text-xs text-taupe">Last pulled <% if freshness[:pulled_at] %><time datetime="<%= freshness[:pulled_at].iso8601 %>"><%= freshness[:pulled_at].in_time_zone.strftime('%b %-d, %-I:%M %p') %></time><% else %>never<% end %><% if count.zero? %> · No sales imported for today<% end %></dd>
          <% elsif count.zero? %>
            <dd class="text-xs text-taupe">No sales imported for today</dd>
          <% end %>
        </div>
        <dd class="row-item-end">
          <span class="text-xs text-mocha"><%= pluralize(count, 'recorded order') %></span>
          <span class="num retail-money font-semibold text-ink"><%= number_to_currency(gross.to_i / 100.0) %></span>
          <% if source == 'ctrax' %><%= link_to 'Daily close', ctrax_days_path, class: 'btn-ghost btn-sm' %><% end %>
        </dd>
      </div>
    <% end %>
  </dl>
  <%= tag.div(fold_explainer('Paid orders and completed C-Trax sales. Payment reports, invoices and bank deposits are not added. C-Trax tips stay separate; source refunds need separate review.', class: 'text-sm text-mocha'), class: 'row-list-foot') %>
</section>
