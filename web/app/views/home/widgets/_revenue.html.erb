<div class="section-card">
  <%= section_heading 'Revenue · last 30 days', hint: 'Daily gross' %>
  <%# A flat zero line with 0 / 0.5 / 1 axes says nothing; show the chart only once there are sales. %>
  <% if presenter.ledger_groups.any? %>
    <div>
      <%= area_chart presenter.revenue_series, height: "220px", legend: false, colors: chart_color(:olive_deep), library: { scales: { x: { ticks: { maxTicksLimit: 8 } } } } %>
    </div>
    <dl class="facts">
      <% presenter.ledger_groups.each do |source, gross, count| %>
        <div>
          <dt class="capitalize"><%= DashboardSales::LABELS.fetch(source, source.humanize) %></dt>
          <dd class="stat-value-sm"><%= number_to_currency(gross.to_i / 100.0) %></dd>
          <dd class="text-xs text-taupe"><%= count %> orders</dd>
        </div>
      <% end %>
    </dl>
  <% else %>
    <%= empty_state 'No recorded sales in the last 30 days', hint: 'Sales appear here after the next source pull.' %>
  <% end %>
</div>
