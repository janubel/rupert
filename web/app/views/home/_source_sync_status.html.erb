<section id="source-sync-status" aria-label="Source sync status" class="space-y-3">
  <%= section_heading 'Sources', hint: 'How fresh each source is. Payment and deposit sources never add to sales.' do %>
    <% if Current.user.can?('settings.read') %><%= link_to 'Credentials & sync', connections_path, class: 'btn-ghost btn-sm' %><% end %>
  <% end %>
  <div class="card">
    <ul class="row-list">
    <% SourceSyncStatus.all.each do |source| %>
      <% syncing = SourceSyncStatus::ACTIVE_BADGES.include?(source[:badge]) %>
      <li class="row-item source-row" data-source="<%= source[:key] %>">
        <div class="min-w-0 flex-1">
          <p class="flex flex-wrap items-baseline gap-x-2"><span class="font-semibold text-ink"><%= source[:label] %></span> <span class="text-xs text-taupe"><%= { 'ctrax' => 'Native retail sales & stock', 'shopify' => 'Online sales & stock', 'square' => 'POS sales & stock', 'swipesimple' => 'Payment evidence only', 'authorize_net' => 'Payment evidence only', 'bank' => 'Deposit evidence only', 'google_backup' => 'Recovery backup' }.fetch(source[:key]) %></span></p>
        <p class="text-xs text-mocha"><%= source[:mode] == 'backup' ? 'Last successful backup:' : source[:key] == 'ctrax' ? 'Last stock pull:' : 'Last successful pull:' %> <% if source[:last_at] %><time datetime="<%= source[:last_at].iso8601 %>"><%= source[:last_at].in_time_zone.strftime('%b %-d, %-I:%M %p %Z') %></time><% else %>None yet<% end %></p>
        <% if source[:key] == 'ctrax' %>
          <p class="text-xs text-mocha">Last sales pull: <% if source[:sales_last_at] %><time datetime="<%= source[:sales_last_at].iso8601 %>"><%= source[:sales_last_at].in_time_zone.strftime('%b %-d, %-I:%M %p %Z') %></time><% else %>None yet<% end %> · <strong><%= source[:sales_badge] %></strong></p>
          <% if source[:sales_date] %><p class="text-xs text-mocha">Sales through business date <%= source[:sales_date] %></p><% end %>
        <% end %>
        <% if source[:latest_sale_at] %><p class="text-xs text-mocha">Latest stored sale: <%= source[:latest_sale_at].in_time_zone.strftime('%b %-d, %Y') %></p><% end %>
        <details class="explainer" data-source-details="<%= source[:key] %>">
          <summary class="explainer-summary">Schedule and actions</summary>
          <p class="mt-3 text-sm text-mocha"><%= source[:detail] %></p>
          <p class="mt-1 text-xs text-taupe"><%= source[:schedule] %></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% permitted = Current.user.can?('sync.write') && (source[:key] != 'ctrax' || Current.user.can?('inventory.write')) %>
            <% if permitted && source[:ready] %>
              <% sync_path = %w[shopify square].include?(source[:key]) ? source_syncs_path(source: source[:key]) : source_sync_path(source[:key]) %>
              <%= button_to(source[:mode] == 'portal' ? 'Import portal export' : 'Sync now', sync_path, class: 'btn-primary btn-sm', form: { data: { turbo: false } }) %>
            <% end %>
            <% if source[:key] == 'bank' && Current.user.can?('settings.read') %>
              <%= link_to 'Deposit reports and imports', pos_connection_path('iris_reporting'), class: 'btn-ghost btn-sm' %>
            <% elsif source[:key] == 'google_backup' && Current.user.super_admin? %>
              <%= link_to 'Backup settings', settings_path(anchor: 'drive'), class: 'btn-ghost btn-sm' %>
            <% end %>
            <% if source[:key] == 'swipesimple' && Current.user.can?('settings.read') %>
              <%= link_to 'Login and schedule', pos_connection_path('swipesimple'), class: 'btn-ghost btn-sm' %>
            <% end %>
            <% if source[:key] == 'swipesimple' && Current.user.can?('sync.write') %>
              <%= link_to 'Import CSV', swipesimple_reports_path(anchor: 'import'), class: 'btn-ghost btn-sm' %>
              <%= link_to 'Open exports', 'https://swipesimple.com/transactions', class: 'btn-ghost btn-sm', target: '_blank', rel: 'noopener noreferrer' %>
            <% elsif source[:key] == 'authorize_net' && source[:mode] == 'portal' && Current.user.can?('sync.write') %>
              <%= link_to 'Open sales portal', 'https://new.authorize.net/smb2/merchant/TransactionManagement/ManageTransactions', class: 'btn-ghost btn-sm', target: '_blank', rel: 'noopener noreferrer' %>
            <% end %>
          </div>
        </details>
        </div>
        <span class="<%= syncing ? 'pill-fern' : source[:badge] == 'Error' ? 'pill-rose' : 'pill-taupe' %> shrink-0 self-start"><%= source[:key] == 'ctrax' ? "Stock: #{source[:badge]}" : source[:badge] %></span>
      </li>
    <% end %>
    </ul>
  </div>
</section>
