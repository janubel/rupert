<% content_for :title, 'My time' %>
<% if !Current.user %>
  <section class="card card-pad space-y-4">
    <h1 class="page-title">My time</h1>
    <p class="text-mocha">Your hours, pay and time off, together.</p>
    <%= link_to 'Sign in', login_path, class: 'btn-primary' %>
    <p class="text-sm text-mocha">First time here or need a new password? Ask your manager for a private sign-in link.</p>
  </section>
<% elsif !@worker %>
  <section class="card card-pad space-y-4">
    <h1 class="page-title">My time</h1>
    <p>Ask an administrator to link your employee record to see your hours, pay and time off.</p>
    <% if Current.user.can_manage_accounts? %>
      <%= link_to 'Preview employee view', employee_app_path(preview: 1), class: 'btn-primary' %>
      <p class="text-sm text-mocha">Preview uses example data and makes no changes.</p>
    <% end %>
  </section>
<% else %>
  <section class="flex flex-wrap items-end justify-between gap-3">
    <div><p class="eyebrow text-olive-deep"><%= Date.current.strftime('%A, %B %-d') %></p><h1 class="page-title">Hi, <%= @worker.first_name %></h1></div>
    <%= link_to 'My time clock', personal_time_clock_path, class: 'text-sm text-olive underline' %>
  </section>
  <% if !@preview && Current.user.can_use_pos? %>
    <nav aria-label="Daily work" class="flex flex-wrap gap-2"><%= link_to 'Open retail POS', ctrax_pos_path, class: 'btn-primary' %><%= link_to 'My time clock', personal_time_clock_path, class: 'btn-ghost' %></nav>
  <% end %>
  <section class="card card-pad flex flex-wrap items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold"><%= @open_shift ? 'You’re clocked in' : @worker.on_leave? ? 'You’re on leave' : 'Ready for your day?' %></h2>
      <% if @open_shift %>
        <p class="mt-1 text-2xl font-semibold tabular-nums" data-controller="elapsed-time" data-elapsed-time-start-value="<%= @open_shift.started_at.iso8601 %>"><span data-elapsed-time-target="duration"><%= number_with_precision(@open_shift.hours, precision: 2) %>h</span></p>
        <p class="text-sm text-mocha">Since <%= l(@open_shift.started_at, format: '%-I:%M %p %Z') %></p>
      <% else %><p class="mt-1 text-sm text-mocha"><%= @worker.on_leave? ? 'Your time records and time-off requests are still here.' : 'Clock in when you start working.' %></p><% end %>
    </div>
    <% if @preview %><button type="button" disabled class="btn-primary opacity-60">Clock in</button>
    <% elsif @open_shift %><%= button_to 'Clock out', clock_out_time_clock_path, params: { shift_id: @open_shift.id }, class: 'btn-primary', data: { turbo: false } %>
    <% elsif @worker.active? %><%= button_to 'Clock in', clock_in_time_clock_path, params: { request_token: SecureRandom.uuid }, class: 'btn-primary', data: { turbo: false } %><% end %>
  </section>
  <section class="card card-pad space-y-5">
    <div class="flex flex-wrap justify-between gap-2"><h2 class="font-display text-xl">This week</h2><span class="text-sm text-mocha"><%= @summary.from.strftime('%b %-d') %> – <%= @summary.to.strftime('%b %-d') %></span></div>
    <%= render 'shared/square_timecard_sync' unless @preview %>
    <div class="grid grid-cols-2 gap-4">
      <div class="stat"><p class="stat-label">Timesheet hours</p><p class="stat-value mt-2 tabular-nums"><%= number_with_precision(@summary.hours, precision: 2, strip_insignificant_zeros: true) %><span class="text-lg"> h</span></p></div>
      <div class="stat"><p class="stat-label">Estimated gross pay</p><p class="stat-value mt-2 tabular-nums"><%= @summary.gross_cents.nil? ? '—' : number_to_currency(@summary.gross_cents / 100.0) %></p></div>
    </div>
    <div class="grid grid-cols-7 gap-1 text-center">
      <% (@summary.from..@summary.to).each do |day| %>
        <div class="rounded-xl px-1 py-3 <%= day == Date.current ? 'bg-olive/10' : 'bg-haze/50' %>"><p class="text-xs text-mocha"><%= day.strftime('%a') %></p><p class="mt-1 font-semibold"><%= day.day %></p><p class="mt-1 text-xs"><%= @summary.daily_hours(day).positive? ? "#{number_with_precision(@summary.daily_hours(day), precision: 2, strip_insignificant_zeros: true)}h" : '—' %></p></div>
      <% end %>
    </div>
    <% if (rate = @summary.rate_for(Date.current)) %><p class="text-sm text-mocha">Pay cycle: <%= rate.pay_frequency.humanize %> · Your manager confirms payment dates.</p><% end %>
    <p class="text-xs text-mocha"><%= @summary.gross_cents.nil? ? 'An hourly pay estimate needs a pay rate for every recorded day. Salary pay appears in your finalized payslips.' : 'Before deductions, based on recorded hours. Rupert timesheets still need review; Square history does not confirm payment.' %></p>
    <% unless @preview %>
      <div class="flex flex-wrap items-center gap-3"><%= button_to @timesheet ? 'Open this week’s timesheet' : 'Start this week’s timesheet', employee_week_path, class: 'btn-primary', data: { turbo: false } %><%= link_to 'All my timesheets', people_timesheets_path, class: 'text-sm text-olive underline' %></div>
      <% if @summary.clock_hours.positive? %><p class="text-sm text-mocha"><%= number_with_precision(@summary.clock_hours, precision: 2) %>h clocked this week. Import finished shifts into your draft timesheet to include them.</p><% end %>
      <% if @timesheet&.review_note.present? %><p class="rounded-xl bg-haze p-3 text-sm"><strong>Review comment:</strong> <%= @timesheet.review_note %></p><% end %>
    <% else %><div class="flex flex-wrap items-center gap-3"><%= link_to 'Open this week’s timesheet', employee_preview_timesheet_path('current'), class: 'btn-primary' %><%= link_to 'All my timesheets', employee_preview_timesheets_path, class: 'text-sm text-olive underline' %></div><% end %>
  </section>
  <section class="grid gap-3 sm:grid-cols-2">
    <div class="card card-pad space-y-2"><h2 class="font-display text-xl">Time off</h2><p class="text-sm text-mocha"><%= @next_leave ? "#{@next_leave.leave_type.titleize} · #{@next_leave.starts_on.strftime('%b %-d')} – #{@next_leave.ends_on.strftime('%b %-d')} · #{@next_leave.status.humanize}" : 'Plan a vacation, request a day off or check your calendar.' %></p><%= link_to 'Calendar & requests', personal_time_off_path, class: 'text-sm text-olive underline' %></div>
    <div class="card card-pad space-y-2"><h2 class="font-display text-xl">My reports</h2><p class="text-sm text-mocha">Check hours, estimated pay and finalized payslips. Download your hours when you need them.</p><%= link_to 'View my reports', personal_reports_path, class: 'text-sm text-olive underline' %></div>
  </section>
  <p class="text-sm text-mocha">Need help with time or pay? <%= link_to 'Report a problem or correction', personal_reports_path(anchor: 'problems'), class: 'text-olive underline' %>.</p>
<% end %>
