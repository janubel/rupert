<div id="sync-runs" class="section-card" <%= tour_anchor('runs') %>>
  <%= section_heading 'Sync runs' %>
  <div class="table-region" role="region" tabindex="0" aria-label="Sync runs">
    <table class="table">
      <thead>
        <tr>
          <th scope="col" class="th">Started</th>
          <th scope="col" class="th">Mode</th>
          <th scope="col" class="th">Source</th>
          <th scope="col" class="th">Status</th>
        </tr>
      </thead>
      <tbody>
        <% if @runs.empty? %>
          <tr>
            <td class="td empty-row" colspan="4">
              No syncs recorded yet.
              <%= button_to "Sync now", syncs_path, method: :post, class: "btn-primary btn-sm mt-2" %>
            </td>
          </tr>
        <% end %>
        <% @runs.each do |run| %>
          <tr>
            <td class="td whitespace-nowrap text-mocha"><%= l(run.startedAt, format: :short) %></td>
            <td class="td text-mocha"><%= run.mode %></td>
            <td class="td text-mocha"><%= run.source.presence || "—" %></td>
            <td class="td">
              <span class="<%= run.success? ? "pill-fern" : run.failed? ? "pill-rose" : "pill-taupe" %>"><%= run.status %></span>
              <% if run.error.present? %>
                <p class="mt-1 max-w-xs text-xs text-rose"><%= run.error.truncate(120) %></p>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
