<%# Sync: a List page of sync runs with the live banner (docs/ui-standards.md §4). %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="space-y-6" data-controller="live-sync">
  <div <%= tour_anchor('run') %>>
    <%= page_header 'Sync', subtitle: 'Every scheduled and manual pull from Shopify and Square.',
                    menu: [['Sync Square only', source_syncs_path(source: 'square'), { method: :post }], ['Sync Shopify only', source_syncs_path(source: 'shopify'), { method: :post }]] do %>
      <%= form_tag syncs_path, method: :post, class: "inline" do %>
        <%= submit_tag "Sync now", class: "btn-primary", data: { turbo_submits_with: 'Syncing…' } %>
      <% end %>
    <% end %>
  </div>

  <%= render "syncs/banner" %>

  <section class="grid gap-4 lg:grid-cols-2">
    <%= render "syncs/runs" %>

    <div class="section-card" <%= tour_anchor('movements') %>>
      <%= section_heading 'Recent inventory activity' %>
      <% if @recent_movements.empty? %>
        <%= empty_state 'No inventory movements yet', hint: 'They appear after a sync runs.' %>
      <% else %>
        <ul class="space-y-2.5">
          <% @recent_movements.each do |movement| %>
            <li class="flex items-start gap-3">
              <span class="pill-taupe shrink-0"><%= movement.source %></span>
              <div class="min-w-0">
                <p class="truncate text-sm text-ink"><%= movement.reason %></p>
                <p class="text-xs text-taupe"><%= movement.sku.presence || "—" %> · <%= movement.quantityBefore %> → <%= movement.quantityAfter %> · <%= time_ago_in_words(movement.createdAt) %> ago</p>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </section>

  <%= render "syncs/swipesimple_import" if Current.user.can?("sync.write") %>

  <section class="grid gap-4 lg:grid-cols-2">
    <%= render "syncs/push_guard" %>
    <%= render "syncs/zelle_import" if Current.user.can?("sync.write") %>
  </section>
</div>
