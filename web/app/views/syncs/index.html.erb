<% content_for :title, "Sync" %>
<div class="space-y-6" data-controller="live-sync">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Sync</h1>
      <p class="mt-1 text-sm text-mocha">Every pull from Shopify and Square is recorded here. Syncs run on a schedule and can be triggered manually.</p>
    </div>
    <div class="flex gap-2">
      <%= form_tag syncs_path, method: :post, class: "inline" do %>
        <%= submit_tag "Sync everything", class: "btn-primary" %>
      <% end %>
      <%= form_tag source_syncs_path, method: :post, class: "inline" do %>
        <%= hidden_field_tag :source, "square" %>
        <%= submit_tag "Square only", class: "btn-ghost btn-sm" %>
      <% end %>
      <%= form_tag source_syncs_path, method: :post, class: "inline" do %>
        <%= hidden_field_tag :source, "shopify" %>
        <%= submit_tag "Shopify only", class: "btn-ghost btn-sm" %>
      <% end %>
    </div>
  </section>

  <%= render "syncs/banner" %>

  <%= render "syncs/push_guard" %>

  <% if Current.user.can?("sync.write") %>
    <section class="card card-pad">
      <h2 class="font-display text-xl text-ink">Import SwipeSimple sales (CSV)</h2>
      <p class="mt-2 text-xs text-taupe">SwipeSimple has no public API, so sales come in through the CSV export from its Reporting Dashboard. Imports are idempotent — running the same file again won't duplicate anything.</p>

      <%= form_tag import_swipesimple_syncs_path, id: "swipesimple", method: :post, multipart: true, class: "mt-4 space-y-3" do %>
        <div class="flex flex-wrap items-center gap-3">
          <label class="btn-ghost cursor-pointer">
            Choose CSV file
            <input type="file" name="file" accept=".csv,text/csv,text/plain" class="hidden" required>
          </label>
          <span class="text-xs text-taupe">or paste below</span>
        </div>
        <textarea name="text" rows="5" placeholder="Order,Date,Item,SKU,Qty,Unit Price,Total,Payment,Customer&#10;1001,2026-07-01,Honey Sticks,TEA-50,2,14.00,28.00,Card,Alex Morgan" aria-label="Paste SwipeSimple CSV export here" class="input !rounded-2xl font-mono text-xs"></textarea>
        <div class="flex items-center gap-3">
          <%= submit_tag "Import sales", class: "btn-primary btn-sm" %>
        </div>
      <% end %>

      <p class="mt-4 text-xs text-taupe">Recognized columns (aliases accepted): <code class="rounded bg-haze px-1 py-0.5 font-mono">Order / Invoice / Receipt</code> · <code class="rounded bg-haze px-1 py-0.5 font-mono">Date / Date/Time</code> · <code class="rounded bg-haze px-1 py-0.5 font-mono">Item / Product</code> · <code class="rounded bg-haze px-1 py-0.5 font-mono">SKU</code> · <code class="rounded bg-haze px-1 py-0.5 font-mono">Qty</code> · <code class="rounded bg-haze px-1 py-0.5 font-mono">Unit Price</code> · <code class="rounded bg-haze px-1 py-0.5 font-mono">Total</code> · <code class="rounded bg-haze px-1 py-0.5 font-mono">Payment</code> · <code class="rounded bg-haze px-1 py-0.5 font-mono">Customer</code>. Rows without an order id are treated as a single-item sale.</p>
    </section>
  <% end %>

  <section class="grid gap-4 lg:grid-cols-2">
    <%= render "syncs/runs" %>

    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Recent inventory activity</h2>
      <ul class="mt-4 space-y-2.5">
        <% if @recent_movements.empty? %>
          <li class="py-3 text-sm text-taupe">No inventory movements yet — they appear after a sync runs.</li>
        <% end %>
        <% @recent_movements.each do |movement| %>
          <li class="flex items-start gap-3">
            <span class="pill-taupe shrink-0"><%= movement.source %></span>
            <div class="min-w-0">
              <p class="truncate text-sm text-ink"><%= movement.reason %></p>
              <p class="text-xs text-taupe"><%= movement.sku.presence || "—" %> · <%= movement.quantityBefore %> → <%= movement.quantityAfter %> · <%= time_ago_in_words(movement.createdAt) %> ago</p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
</div>
