<section class="section-card" id="zelle">
  <%= section_heading 'Zelle bank CSV', hint: 'Kept as its own unverified source.' do %>
    <%= link_to 'Import a Zelle bank CSV', zelle_reports_path(anchor: 'import'), class: 'btn-ghost btn-sm' %>
  <% end %>
  <p class="text-sm text-mocha">Zelle has no merchant API and Rupert never signs in to a bank. Import a bank-statement CSV you downloaded yourself; it is not added to SwipeSimple totals.</p>
</section>
