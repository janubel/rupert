<% content_for :title, 'Review material use' %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="page-narrow space-y-6">
  <%= page_header 'Review material use', subtitle: "#{@order.display_number} · #{@line.name} · #{@line.quantity} sold units" %>
  <dl class="facts">
    <div><dt>Source line</dt><dd class="font-mono text-xs"><%= @line.source_line_id %></dd></div>
    <div><dt>Source variant</dt><dd class="font-mono text-xs"><%= @line.source_variant_id %></dd></div>
    <div><dt>Recipe basis</dt><dd>Imported Shopify order creation time <%= @order.occurred_at.iso8601 %></dd></div>
    <div><dt>Snapshot imported</dt><dd><%= @order.updated_at.iso8601 %></dd></div>
  </dl>
  <p class="text-sm text-mocha">The order creation time is not a verified payment or production timestamp; verify delayed-payment orders before recording use.</p>
  <% if @recipe && !@plan %>
    <%= form_with url: preview_bulk_consumptions_path, scope: :bulk_consumption, data: { turbo: false }, class: 'card card-pad space-y-4' do |f| %>
      <%= f.hidden_field :order_id, value: @order.id %><%= f.hidden_field :source_line_id, value: @line.source_line_id %>
      <fieldset class="space-y-4">
        <legend class="card-title">Recipe v<%= @recipe.version %> · <%= @recipe.bulk_material.name %></legend>
        <p class="text-sm text-mocha"><%= number_with_precision(@recipe.grams, precision: 3, strip_insignificant_zeros: true) %> g per unit · effective <%= @recipe.effective_from.iso8601 %>.</p>
        <div><%= f.label :lot_id, 'Material lot used', class: 'field-label' %><%= f.select :lot_id, @lots.map { |lot| ["#{lot.code} · #{bulk_mass_label(lot.balance_mg)} available", lot.id] }, { selected: @lot_id, include_blank: 'Choose lot' }, required: true, class: 'input' %></div>
        <% if @lots_limited %><p class="text-xs text-taupe">First 200 lots shown; review the material's lot list for additional lots.</p><% end %>
      </fieldset>
      <div class="form-actions"><%= f.submit 'Preview deduction', class: 'btn-primary', name: nil %><%= link_to 'Cancel', bulk_consumptions_path, class: 'btn-ghost' %></div>
    <% end %>
  <% elsif !@recipe %>
    <%= empty_state 'No recipe was effective for this exact variant at the imported sale time', hint: 'Add a recipe version that was effective at that time, then review this line again.' do %>
      <%= link_to 'Open bulk recipes', bulk_recipes_path, class: 'btn-primary' %>
    <% end %>
  <% end %>
  <% if @plan %>
    <section class="section-card">
      <%= section_heading "Reviewed deduction · #{@plan.lot.code}", level: :h2 %>
      <p class="text-sm"><%= @plan.quantity %> units × <%= @plan.recipe.grams.to_s('F') %> g = <strong><%= bulk_mass_label(@plan.required_mg) %></strong> of <%= @plan.recipe.bulk_material.name %>.</p>
      <p class="text-sm text-mocha">Lot currently contains <%= bulk_mass_label(@plan.available_mg) %>. The balance and source snapshot are checked again when recorded.</p>
      <% if @plan.shortage_mg.positive? %><p class="flash flash-alert" role="alert">Shortage: <%= bulk_mass_label(@plan.shortage_mg) %>. Saving is blocked; verify stock, receipts and the actual lot.</p>
      <% else %><%= form_with url: bulk_consumptions_path, scope: :bulk_consumption, class: 'space-y-3' do |f| %><%= f.hidden_field :preview_token, value: @preview_token %><label class="flex items-start gap-2 text-sm text-ink"><%= f.check_box :confirmed, { required: true, class: 'accent-olive mt-1' }, '1', '0' %><span>I verified this exact source sale, recipe version and actual material lot.</span></label><p class="text-xs text-taupe">Review expires after 15 minutes. A changed selection requires another preview. This records use in Rupert's local bulk ledger.</p><div class="form-actions"><%= f.submit 'Save material use', class: 'btn-primary', name: nil %><%= link_to 'Choose another lot', new_bulk_consumption_path(order_id: @order.id, source_line_id: @line.source_line_id), class: 'btn-ghost' %></div><% end %><% end %>
      <% if @plan.shortage_mg.positive? %><div class="form-actions"><%= link_to 'Choose another lot', new_bulk_consumption_path(order_id: @order.id, source_line_id: @line.source_line_id), class: 'btn-ghost' %><%= link_to 'Cancel', bulk_consumptions_path, class: 'btn-ghost' %></div><% end %>
    </section>
  <% end %>
</div>
