<% content_for :title, @chat_title || 'Team chat' %>
<%= page_header(@chat_title || 'Team chat', subtitle: 'Your Buzz workspace, mirrored here: channels, recent messages and a composer.') do %>
  <%= link_to 'Open in Buzz', BuzzConnect.chat_url, class: 'btn-primary', aria: { label: 'Open this channel in the Buzz app' } if @state == :ready && BuzzConnect.chat_url %>
<% end %>
<%= render 'buzz/tabs', current: (@chat_tab || :chat) %>
<% if @state == :ready %>
  <% can_admin = Current.user.can?('settings.write') %>
  <% can_read = Current.user.can?('buzz.read') %>
  <% user_initials = Current.user.display_name.to_s.split(/\s+/).first(2).map { |word| word[0] }.join.upcase.presence || 'U' %>
  <div class="buzz-app"
       data-controller="buzz-chat"
       data-buzz-chat-url-value="<%= @chat_messages_path || buzz_chat_messages_path %>"
       data-buzz-chat-channel-value="<%= @channel.id %>"
       data-buzz-chat-can-post-value="<%= @can_post %>"
       data-buzz-chat-post-max-value="<%= BuzzChat::POST_MAX %>">
    <aside class="buzz-rail" aria-label="Buzz workspace">
      <div class="buzz-workspace">
        <span class="buzz-workspace-mark" aria-hidden="true">B</span>
        <div class="buzz-workspace-text">
          <p class="buzz-workspace-name">Buzz</p>
          <p>Buzz workspace</p>
        </div>
      </div>

      <label class="buzz-search">
        <span class="sr-only">Search channels</span>
        <input type="search" placeholder="Search channels" data-buzz-chat-target="search" data-action="input->buzz-chat#filter">
        <kbd>⌘K</kbd>
      </label>

      <nav class="buzz-rail-nav" aria-label="Buzz sections">
        <% if can_read %>
          <%= link_to buzz_path, class: 'buzz-rail-link' do %><%= navigation_icon('chat') %><span>Agent &amp; setup</span><% end %>
          <%= link_to buzz_chat_path, class: 'buzz-rail-link', aria: { current: (@chat_tab == :chat ? 'page' : nil) } do %><%= navigation_icon('chat') %><span>Team chat</span><% end %>
        <% end %>
        <% if can_admin %>
          <%= link_to admin_buzz_mirror_path, class: 'buzz-rail-link', aria: { current: (@chat_tab == :mirror ? 'page' : nil) } do %><%= navigation_icon('chat') %><span>Admin mirror</span><% end %>
        <% end %>
      </nav>

      <div class="buzz-rail-section">
        <p class="buzz-rail-label">Channels</p>
        <% (@channels.presence || [@channel]).each do |channel| %>
          <%= link_to "#{@chat_base_path}?channel=#{ERB::Util.url_encode(channel.id)}",
                class: "buzz-rail-channel #{'is-active' if channel.id == @channel.id}",
                aria: { current: (channel.id == @channel.id ? 'page' : nil) } do %>
            <span class="buzz-hash">#</span>
            <span class="buzz-rail-channel-name"><%= channel.name %></span>
            <% if channel.members.to_i.positive? %><span class="buzz-rail-channel-count"><%= channel.members %></span><% end %>
          <% end %>
        <% end %>
      </div>

      <div class="buzz-rail-user">
        <span class="buzz-avatar" aria-hidden="true"><%= user_initials %></span>
        <div class="buzz-rail-user-text">
          <strong><%= Current.user.display_name %></strong>
          <span>Administrator</span>
        </div>
      </div>
    </aside>

    <main class="buzz-main">
      <header class="buzz-channel-head">
        <div class="buzz-channel-title">
          <h2><span class="buzz-hash">#</span><%= @channel.name %></h2>
          <p><%= @channel.about.presence || 'Channel' %></p>
        </div>
        <div class="buzz-channel-tools">
          <span class="buzz-status" data-buzz-chat-target="status" data-tone="ok" role="status" aria-live="polite">Connecting to Buzz…</span>
          <% if Array(@members).any? %>
            <span class="buzz-member-stack" aria-label="Channel members">
              <% Array(@members).each do |member| %>
                <span class="buzz-member-avatar" style="background:<%= member.color %>" title="<%= member.name %>" aria-label="<%= member.name %>"><%= member.initials %></span>
              <% end %>
              <% if @member_overflow.to_i.positive? %><span class="buzz-member-more" title="More members">+<%= @member_overflow %></span><% end %>
            </span>
          <% end %>
          <span class="buzz-members" title="Channel members"><%= pluralize(@channel.members, 'member') %></span>
        </div>
      </header>

      <section class="buzz-chat" aria-label="Channel messages">
        <div class="buzz-log-wrap">
          <div class="buzz-log" data-buzz-chat-target="log" data-action="scroll->buzz-chat#onScroll" role="log" aria-live="polite" aria-relevant="additions" aria-label="Messages in #<%= @channel.name %>" tabindex="0">
            <button type="button" class="btn-ghost btn-sm buzz-more" data-buzz-chat-target="more" data-action="buzz-chat#loadEarlier" hidden>Load earlier messages</button>
            <p class="buzz-hint" data-buzz-chat-target="loading">Loading messages…</p>
            <p class="buzz-hint" data-buzz-chat-target="empty" hidden>No messages yet. Say hello below.</p>
            <div data-buzz-chat-list></div>
          </div>
          <button type="button" class="buzz-jump" data-buzz-chat-target="jump" data-action="buzz-chat#scrollToEnd" hidden>New messages ↓</button>
        </div>

        <% if @can_post %>
          <form class="buzz-compose" data-buzz-chat-target="form" data-action="submit->buzz-chat#send">
            <p class="buzz-error" data-buzz-chat-target="notice" role="alert" hidden></p>
            <div class="buzz-reply" data-buzz-chat-target="reply" hidden>
              <span>Replying in thread to <strong data-buzz-chat-target="replyName"></strong></span>
              <button type="button" class="buzz-reply-cancel" data-action="buzz-chat#cancelReply">Cancel</button>
            </div>
            <div class="buzz-composer">
              <label for="buzz-message" class="sr-only">Message #<%= @channel.name %></label>
              <textarea id="buzz-message" class="buzz-input" rows="1" maxlength="<%= BuzzChat::POST_MAX + 200 %>" placeholder="Message #<%= @channel.name %>"
                        data-buzz-chat-target="input" data-action="input->buzz-chat#input keydown->buzz-chat#keydown" autocomplete="off"></textarea>
              <div class="buzz-composer-bar">
                <span class="buzz-composer-hint">Posting as <strong><%= Current.user.display_name.to_s.first(40) %> via Rupert</strong> &middot; mention <strong>@rupert</strong> for help &middot; paste an image link to show it inline</span>
                <button type="submit" class="buzz-send" data-buzz-chat-target="send" aria-label="Send message" disabled>↑</button>
              </div>
            </div>
            <p class="buzz-count" data-buzz-chat-target="count" hidden></p>
          </form>
        <% else %>
          <p class="buzz-compose buzz-hint">You can read this channel. Ask an administrator for permission to post.</p>
        <% end %>
      </section>
    </main>
  </div>
<% else %>
  <section class="card card-pad" role="status">
    <h2 class="section-title"><%= @state == :unconfigured ? 'Team chat is not set up yet' : 'No channel chosen yet' %></h2>
    <p class="mt-2 text-sm text-mocha">
      <% if @state == :unconfigured %>
        Rupert needs a Buzz relay address and the agent's identity before it can show the channel.
      <% else %>
        The relay is set but no channel is, so there is nothing to show yet.
      <% end %>
      <% if @can_configure %>
        Set it in <%= link_to 'Settings → Buzz agent', settings_path(anchor: 'buzz'), class: 'underline' %>.
      <% else %>
        Ask an administrator to set it up in Settings.
      <% end %>
      You can still <%= link_to 'connect your own device', buzz_path, class: 'underline' %> to Buzz.
    </p>
  </section>
<% end %>
