<%# Team chat: the live Buzz channel through the Rupert agent. %>
<% content_for :title, 'Team chat' %>
<div class="page-medium space-y-4">
  <%= page_header 'Team chat', eyebrow: 'Team chat · Buzz', subtitle: 'The team’s Buzz channel, shown through the Rupert agent.' do %>
    <%= link_to 'Open in Buzz', BuzzConnect.chat_url, class: 'btn-ghost', aria: { label: 'Open this channel in the Buzz app' } if @state == :ready && BuzzConnect.chat_url %>
  <% end %>
  <%= render 'buzz/tabs', current: :chat %>

  <% if @state == :ready %>
    <section class="card buzz-chat" aria-label="Team chat"
             data-controller="buzz-chat" data-buzz-chat-url-value="<%= buzz_chat_messages_path %>"
             data-buzz-chat-can-post-value="<%= @can_post %>" data-buzz-chat-post-max-value="<%= BuzzChat::POST_MAX %>">
      <header class="buzz-chat-head">
        <div class="min-w-0">
          <p class="buzz-status" data-buzz-chat-target="status" data-tone="ok" role="status" aria-live="polite">Connecting to Buzz…</p>
        </div>
      </header>

      <p class="buzz-disclosure">Everyone in the channel reads what is posted, and channel membership is wider than Rupert permissions, so keep customer personal details, pay and keys out of it. Rupert keeps a copy of recent messages for <%= BuzzChat::RETENTION.in_days.to_i %> days.</p>

      <div class="buzz-log-wrap">
        <div class="buzz-log" data-buzz-chat-target="log" data-action="scroll->buzz-chat#onScroll" role="log" aria-live="polite" aria-relevant="additions" aria-label="Team chat messages" tabindex="0">
          <button type="button" class="btn-ghost btn-sm buzz-more" data-buzz-chat-target="more" data-action="buzz-chat#loadEarlier" hidden>Load earlier messages</button>
          <p class="buzz-hint" data-buzz-chat-target="loading">Loading…</p>
          <p class="buzz-hint" data-buzz-chat-target="empty" hidden>No messages yet. Say hello below.</p>
          <div data-buzz-chat-list></div>
        </div>
        <button type="button" class="buzz-jump" data-buzz-chat-target="jump" data-action="buzz-chat#scrollToEnd" hidden>New messages ↓</button>
      </div>

      <% if @can_post %>
        <form class="buzz-compose" data-buzz-chat-target="form" data-action="submit->buzz-chat#send">
          <p class="buzz-error" data-buzz-chat-target="notice" role="alert" hidden></p>
          <div class="buzz-compose-row">
            <label for="buzz-message" class="sr-only">Message to the team</label>
            <textarea id="buzz-message" class="input buzz-input" rows="1" maxlength="<%= BuzzChat::POST_MAX + 200 %>" placeholder="Message the team"
                      data-buzz-chat-target="input" data-action="input->buzz-chat#input keydown->buzz-chat#keydown" autocomplete="off"></textarea>
            <button type="submit" class="btn-primary shrink-0" data-buzz-chat-target="send" disabled>Send</button>
          </div>
          <p class="buzz-count" data-buzz-chat-target="count" hidden></p>
          <p class="buzz-hint">Appears in Buzz as <strong><%= Current.user.display_name.to_s.first(40) %> via Rupert</strong>, from the Rupert agent. Enter sends, Shift+Enter adds a line. The agent does not answer messages posted here; ask it in Buzz, or use Ask Rupert for help.</p>
        </form>
      <% else %>
        <p class="buzz-compose buzz-hint">You can read the team chat. Ask an administrator for permission to post.</p>
      <% end %>
    </section>
  <% else %>
    <section role="status">
      <%= empty_state(@state == :unconfigured ? 'Team chat is not set up yet' : 'No channel chosen yet',
                      hint: @state == :unconfigured ? "Rupert needs a Buzz relay address and the agent's identity before it can show the channel." : 'The relay is set but no channel is, so there is nothing to show yet.') do %>
        <p class="text-sm text-mocha">
          <% if @can_configure %>
            Set it in <%= link_to 'Settings → Buzz agent', settings_path(anchor: 'buzz'), class: 'underline' %>.
          <% else %>
            Ask an administrator to set it up in Settings.
          <% end %>
          You can still <%= link_to 'connect your own device', buzz_path, class: 'underline' %> to Buzz.
        </p>
      <% end %>
    </section>
  <% end %>
</div>
