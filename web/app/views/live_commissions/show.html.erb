<%= turbo_frame_tag 'live-commissions' do %>
  <section class="card card-pad space-y-4">
    <div class="flex flex-wrap justify-between gap-3"><h2 class="font-display text-xl">Shift commissions · today</h2><%= link_to 'Match gateway payments', authorize_net_sale_links_path, class: 'btn-ghost btn-sm', data: { turbo_frame: '_top' } %><%= link_to 'Review date range', commission_preview_time_clock_path, class: 'btn-ghost btn-sm', data: { turbo_frame: '_top' } %></div>
    <p class="text-sm text-mocha">Each clocked-in worker earns an estimated 1% of eligible item sales during their shift. Overlapping workers each receive 1%. This estimate refreshes every 30 seconds from imported data; source delays still apply.</p>
    <%= form_with url: live_commissions_path, method: :get, class: 'flex flex-wrap gap-3 items-end' do %>
      <div><%= label_tag :source, 'Sales source', class: 'block text-sm' %><%= select_tag :source, options_for_select(CommissionPreview::SOURCES.map { |source| [source.capitalize, source] }, @source), class: 'input' %></div>
      <div><%= label_tag :currency, 'Currency', class: 'block text-sm' %><%= text_field_tag :currency, @currency, maxlength: 3, required: true, class: 'input' %></div>
      <%= submit_tag 'View commissions', class: 'btn-ghost' %>
    <% end %>
    <% if @preview_error %><p role="alert"><%= @preview_error %></p><% else %>
      <p class="text-xs text-taupe"><%= Date.current %> · <%= Time.zone.name %> · calculated <%= Time.current.strftime('%H:%M:%S %Z') %> · <%= @preview.gateway_matched_orders %> gateway matches checked (<%= @preview.gateway_excluded_orders %> failed payment checks) · <%= @preview.eligible_orders %> eligible sales · <%= @preview.excluded_orders %> excluded · <%= @preview.currency %></p>
      <% if @shift_count.zero? %><p role="status">No clock shifts are recorded today. Commission coverage is incomplete until workers clock in or approved corrections are recorded.</p><% end %>
      <% if @last_order_at.nil? %><p role="status">No <%= @source.capitalize %> orders are imported in <%= @preview.currency %>. A zero estimate does not establish that no commission was earned.</p><% else %><p class="text-xs text-taupe">Latest stored <%= @source.capitalize %> order update: <%= l(@last_order_at, format: :long) %>. This timestamp does not certify complete source coverage.</p><% end %>
      <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr><% ['Worker', 'Matched sales', 'Eligible item subtotal', '1% estimate'].each do |heading| %><th scope="col" class="th"><%= heading %></th><% end %></tr></thead><tbody><% @preview.rows.each do |row| %><tr><td class="td"><%= row[:employee] %></td><td class="td"><%= row[:order_count] %></td><td class="td"><%= @preview.currency %> <%= number_with_precision(row[:sales_cents] / 100.0, precision: 2) %></td><td class="td font-semibold"><%= @preview.currency %> <%= number_with_precision(row[:commission_cents] / 100.0, precision: 2) %></td></tr><% end %></tbody></table></div>
      <%= fold_explainer('Authorize.net payment observations are reconciliation evidence. They are not added as another sale or commission. Confirmed matches apply gateway capture, refund and void status to the existing sale; unmatched payments remain outside gateway-backed commission verification; C-Trax and native SwipeSimple payment exports alone cannot establish this commission basis.', class: 'text-sm text-mocha') %>
      <p class="text-xs text-taupe">Uses imported sale time and item unit price × quantity before order-level discounts; excludes separately recorded tax, shipping and tips, unpaid orders and any order with a recorded refund. Clock-out is excluded. This remains a reviewable estimate; payroll is not posted.</p>
      <% @sources.each do |source| %><p class="text-xs"><strong><%= source[:label] %>:</strong> <%= source[:badge] %> · <%= source[:schedule] %> · last read <%= source[:last_at] ? l(source[:last_at], format: :long) : 'none' %></p><% end %>
    <% end %>
  </section>
<% end %>
