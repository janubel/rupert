<%= turbo_frame_tag 'live-commissions' do %>
  <section class="section-card">
    <%= section_heading 'Shift commissions · today', hint: 'Each clocked-in worker earns an estimated 1% of eligible item sales during their shift; overlapping workers each receive 1%. The estimate refreshes every 30 seconds from imported data, so source delays still apply.' do %>
      <%= link_to 'Match gateway payments', authorize_net_sale_links_path, class: 'btn-ghost btn-sm', data: { turbo_frame: '_top' } %>
      <%= link_to 'Review a date range', commission_preview_time_clock_path, class: 'btn-ghost btn-sm', data: { turbo_frame: '_top' } %>
    <% end %>
    <%= form_with url: live_commissions_path, method: :get, class: 'toolbar' do %>
      <div class="toolbar-field"><%= label_tag :source, 'Sales source', class: 'field-label' %><%= select_tag :source, options_for_select(CommissionPreview::SOURCES.map { |source| [source.capitalize, source] }, @source), class: 'select w-full' %></div>
      <div class="toolbar-field"><%= label_tag :currency, 'Currency', class: 'field-label' %><%= text_field_tag :currency, @currency, maxlength: 3, required: true, class: 'input' %></div>
      <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary' %></div>
    <% end %>
    <% if @preview_error %><p role="alert" class="flash flash-alert"><%= @preview_error %></p><% else %>
      <p class="text-xs text-taupe"><%= Date.current %> · <%= Time.zone.name %> · calculated <%= Time.current.strftime('%H:%M:%S %Z') %> · <%= @preview.gateway_matched_orders %> gateway matches checked (<%= @preview.gateway_excluded_orders %> failed payment checks) · <%= @preview.eligible_orders %> eligible sales · <%= @preview.excluded_orders %> excluded · <%= @preview.currency %></p>
      <% if @shift_count.zero? %><p role="status" class="text-sm text-mocha">No clock shifts are recorded today. Commission coverage is incomplete until workers clock in or approved corrections are recorded.</p><% end %>
      <% if @last_order_at.nil? %><p role="status" class="text-sm text-mocha">No <%= @source.capitalize %> orders are imported in <%= @preview.currency %>. A zero estimate does not establish that no commission was earned.</p><% else %><p class="text-xs text-taupe">Latest stored <%= @source.capitalize %> order update: <%= l(@last_order_at, format: :long) %>. This timestamp does not certify complete source coverage.</p><% end %>
      <div class="table-region" role="region" tabindex="0" aria-label="Shift commissions">
        <table class="table">
          <thead><tr><th scope="col" class="th">Worker</th><th scope="col" class="th num">Matched sales</th><th scope="col" class="th num">Eligible item subtotal</th><th scope="col" class="th num">1% estimate</th></tr></thead>
          <tbody>
            <% @preview.rows.each do |row| %><tr><td class="td"><%= row[:employee] %></td><td class="td num"><%= row[:order_count] %></td><td class="td num"><%= @preview.currency %> <%= number_with_precision(row[:sales_cents] / 100.0, precision: 2) %></td><td class="td num font-semibold"><%= @preview.currency %> <%= number_with_precision(row[:commission_cents] / 100.0, precision: 2) %></td></tr><% end %>
            <% if @preview.rows.empty? %><tr><td colspan="4" class="empty-row">No shift commissions yet today.</td></tr><% end %>
          </tbody>
        </table>
      </div>
      <%= fold_explainer('Authorize.net payment observations are reconciliation evidence. They are not added as another sale or commission. Confirmed matches apply gateway capture, refund and void status to the existing sale; unmatched payments remain outside gateway-backed commission verification; C-Trax and native SwipeSimple payment exports alone cannot establish this commission basis.', class: 'text-sm text-mocha') %>
      <p class="text-xs text-taupe">Uses imported sale time and item unit price × quantity before order-level discounts; excludes separately recorded tax, shipping and tips, unpaid orders and any order with a recorded refund. Clock-out is excluded. This remains a reviewable estimate; payroll is not posted.</p>
      <% @sources.each do |source| %><p class="text-xs"><strong><%= source[:label] %>:</strong> <%= source[:badge] %> · <%= source[:schedule] %> · last read <%= source[:last_at] ? l(source[:last_at], format: :long) : 'none' %></p><% end %>
    <% end %>
  </section>
<% end %>
