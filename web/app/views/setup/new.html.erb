<%# First-run setup: a Form page (docs/ui-standards.md §4). %>
<% content_for :title, "Set up your workspace" %>
<div class="page-narrow space-y-6 pt-6">
  <%= page_header 'Set up your workspace', subtitle: 'First run: create the admin account and your first tenant.', eyebrow: 'Rupert' %>

  <%= form_with url: setup_path, method: :post, class: "card card-pad space-y-5", data: { controller: "setup-slug" } do |f| %>
    <fieldset class="space-y-3">
      <legend class="card-title">Your account</legend>
      <div>
        <%= f.label :user_name, "Your name", class: "field-label" %>
        <%= f.text_field :user_name, required: true, autofocus: true, class: "input" %>
      </div>
      <div>
        <%= f.label :user_email, "Email", class: "field-label" %>
        <%= f.email_field :user_email, autocomplete: "email", required: true, class: "input" %>
      </div>
      <div>
        <%= f.label :user_password, "Password (min 8 characters)", class: "field-label" %>
        <%= f.password_field :user_password, autocomplete: "new-password", required: true, minlength: 8, class: "input" %>
      </div>
    </fieldset>

    <fieldset class="space-y-3">
      <legend class="card-title">Your first tenant</legend>
      <div>
        <%= f.label :tenant_name, "Business name", class: "field-label" %>
        <%= f.text_field :tenant_name, required: true, autofocus: false, class: "input",
                         data: { setup_slug_target: "name", action: "input->setup-slug#sync" } %>
      </div>
      <div>
        <%= f.label :tenant_subdomain, "Web address", class: "field-label" %>
        <div class="flex items-center gap-2">
          <%= f.text_field :tenant_subdomain, required: true, pattern: '[a-z0-9][a-z0-9\-]*[a-z0-9]', placeholder: "my-business", class: "input", data: { setup_slug_target: "slug", action: "input->setup-slug#onSlugInput" } %>
          <span class="whitespace-nowrap text-sm text-taupe">.<%= request.domain %></span>
        </div>
        <p class="mt-1 text-xs text-taupe">Filled in from your business name; edit it if you like.</p>
      </div>
    </fieldset>

    <div class="form-actions">
      <%= f.submit "Create workspace", class: "btn-primary", data: { turbo_submits_with: "Saving…" } %>
    </div>
  <% end %>
</div>
