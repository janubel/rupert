<% content_for :title, 'General ledger' %>
<% range_text = (@from || @to) ? "#{@from ? @from.to_date.strftime('%b %-d, %Y') : 'Start'} – #{@to ? @to.to_date.strftime('%b %-d, %Y') : 'today'}" : 'All dates' %>
<div class="space-y-6">
  <%= render layout: 'finance/page_header', locals: { title: 'General ledger', range: range_text, print: true,
        menu: [['Financial statements', finance_reports_path], ['Download ledger', finance_ledger_export_path], ['Chart of accounts', finance_chart_of_accounts_path]],
        explain: 'The record of every posted entry. Each entry has equal debits and credits. Entries from expenses and sales are created automatically; you can add manual entries and reverse them.' } do %>
    <% if @can_write %><%= link_to 'Add entry', new_finance_journal_entry_path, class: 'btn-primary' %><% end %>
  <% end %>

  <section class="grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Ledger summary">
    <div class="stat">
      <div class="stat-label">Entries<%= define('void_entry') %></div>
      <p class="stat-value mt-1"><%= number_with_delimiter(@totals[:entries]) %></p>
      <p class="mt-1 text-xs text-taupe"><%= @totals[:void] %> of them void</p>
    </div>
    <div class="stat">
      <div class="stat-label">Total debits<%= define('debit_credit') %></div>
      <p class="stat-value mt-1"><%= finance_money(@totals[:debits]) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Total credits<%= define('debit_credit') %></div>
      <p class="stat-value mt-1"><%= finance_money(@totals[:credits]) %></p>
      <%= explain_calculation(title: 'Do the listed entries balance?', id: 'ledger-balance-check',
            formula: 'Total debits − total credits across the entries matching these filters. Zero means every listed entry is balanced.',
            rows: [['Entries listed', number_with_delimiter(@totals[:entries])], ['Total debits', finance_money(@totals[:debits])], ['Total credits', "− #{finance_money(@totals[:credits])}"],
                   ['Difference', finance_money(@totals[:debits] - @totals[:credits])]],
            note: "These totals include the #{@totals[:void]} void #{'entry'.pluralize(@totals[:void])} shown in the list; reports and exports leave void entries out.",
            term: 'debit_credit', lesson: 'books') %>
    </div>
  </section>
  <div>
    <%= finance_balance_status(@totals[:debits] - @totals[:credits], balanced_text: 'Balanced: debits equal credits') %>
    <p class="mt-2 text-xs text-mocha">Totals include void entries shown in the list. Reports and exports leave void entries out.</p>
  </div>

  <%= form_tag finance_journal_entries_path, method: :get, class: 'toolbar', role: 'search', aria: { label: 'Filter ledger entries' } do %>
    <div class="toolbar-field"><%= label_tag :q, 'Memo contains', class: 'field-label' %><%= search_field_tag :q, @q, class: 'input', autocomplete: 'off' %></div>
    <div class="toolbar-field"><%= label_tag :account_id, 'Account', class: 'field-label' %>
      <%= select_tag :account_id, options_for_select(Finance::Account.ordered.map { |a| [a.label, a.id] }, @account&.id), include_blank: 'All accounts', class: 'select' %></div>
    <div class="toolbar-field"><%= label_tag :kind, 'Kind', class: 'field-label' %>
      <%= select_tag :kind, options_for_select([['All kinds', 'all']] + Finance::JournalEntry::KINDS.map { |k| [k.tr('_', ' ').humanize, k] }, @kind), class: 'select' %></div>
    <div class="toolbar-field"><%= label_tag :from, 'From', class: 'field-label' %><%= date_field_tag :from, @from, class: 'input' %></div>
    <div class="toolbar-field"><%= label_tag :to, 'To', class: 'field-label' %><%= date_field_tag :to, @to, class: 'input' %></div>
    <div class="toolbar-field"><%= label_tag :min, 'Amount from (USD)', class: 'field-label' %><%= text_field_tag :min, params[:min], class: 'input money', inputmode: 'decimal' %></div>
    <div class="toolbar-field"><%= label_tag :max, 'Amount to (USD)', class: 'field-label' %><%= text_field_tag :max, params[:max], class: 'input money', inputmode: 'decimal' %></div>
    <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary', name: nil %><%= link_to 'Clear', finance_journal_entries_path, class: 'btn-ghost' %></div>
  <% end %>
  <% if @filter_problem %><p role="alert" class="flash flash-alert"><%= @filter_problem %></p><% end %>

  <div class="card">
    <div class="table-region" role="region" tabindex="0" aria-label="Journal entries">
      <table class="table finance-table">
        <caption class="sr-only">Journal entries, newest first, amounts in USD</caption>
        <thead>
          <tr>
            <th scope="col" class="th">Entry</th>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Kind</th>
            <th scope="col" class="th">Memo</th>
            <th scope="col" class="th">Source</th>
            <th scope="col" class="th num">Amount</th>
            <th scope="col" class="th">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if @entries.empty? %>
            <tr><td colspan="7" class="empty-row">No entries match. Clear the filters<%= ', or add a manual entry' if @can_write %>.</td></tr>
          <% end %>
          <% @entries.each do |entry| %>
            <tr class="<%= 'row-removed' if entry.void? %>">
              <td class="td whitespace-nowrap"><%= link_to "##{entry.id}", finance_journal_entry_path(entry), class: 'link', aria: { label: "Open journal entry #{entry.id}" } %></td>
              <td class="td whitespace-nowrap"><%= l(entry.posted_on, format: :short) %></td>
              <td class="td"><%= entry.kind.tr('_', ' ').humanize %></td>
              <td class="td"><%= link_to (entry.memo.presence || "Entry ##{entry.id}"), finance_journal_entry_path(entry), class: 'link' %></td>
              <td class="td text-mocha"><%= entry.source_type.present? ? "#{entry.source_type.demodulize.titleize} ##{entry.source_id}" : 'Manual' %></td>
              <td class="td num"><%= finance_money(entry.debit_cents) %></td>
              <td class="td"><%= entry.void? ? tag.span('Void', class: 'pill-rose status-removed') : tag.span('Posted', class: 'pill-fern status-active') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%== @pagy.series_nav if @pagy.pages > 1 %>
</div>
