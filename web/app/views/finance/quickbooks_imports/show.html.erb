<% content_for :title, "QuickBooks batch ##{@batch.id}" %>
<% summary = @summary %>
<% closed = %w[discarded reversed].include?(@batch.status) %>
<% open_batch = !closed %>
<div class="space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :money %>

  <%= page_header @batch.kind_label, eyebrow: "QuickBooks import · batch ##{@batch.id}",
        subtitle: "#{@batch.filename} · uploaded #{l(@batch.created_at.in_time_zone, format: :short)}#{" by #{@batch.created_by_name}" if @batch.created_by_name.present?}" do %>
    <%= link_to 'All uploads', finance_quickbooks_imports_path, class: 'btn-ghost btn-sm' %>
  <% end %>

  <div class="card card-pad text-sm" role="status">
    <p class="font-semibold">
      <% if @batch.staged? %>Staged: read, not posted. Your books are unchanged.
      <% elsif @batch.approved? %>Approved by <%= @batch.approved_by_name %> on <%= @batch.approved_at.to_date %>.<% if @batch.postable? %> <%= pluralize(@posted_entries, 'transaction') %> posted as journal entries.<% end %>
      <% elsif @batch.status == 'reversed' %>Reversed by <%= @batch.closed_by_name %> on <%= @batch.closed_at.to_date %>: <%= @batch.closed_reason %>
      <% else %>Discarded before approval. The original file is still retained.
      <% end %>
    </p>
    <p class="mt-1 text-mocha">The original file is kept unchanged and encrypted (checksum <%= @batch.source_document.sha256.first(12) %>…). Dates are read month first unless written YYYY-MM-DD. This is a copy of what QuickBooks exported, not an audit of your books.</p>
  </div>

  <section aria-labelledby="read-heading" class="space-y-3">
    <h2 id="read-heading" class="font-display text-xl">What Rupert read</h2>
    <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      <% [['Rows', @batch.row_count], ['Transactions', @batch.transaction_count], ['Ready', @batch.accepted_count], ['Already imported', @batch.duplicate_count], ['Rejected', @batch.rejected_count]].each do |label, value| %>
        <div class="stat"><dt class="text-xs text-mocha"><%= label %></dt><dd class="stat-value-sm"><%= value.to_fs(:delimited) %></dd></div>
      <% end %>
      <div class="stat"><dt class="text-xs text-mocha"><%= @batch.kind == 'trial_balance' ? 'As of' : 'Dates' %></dt><dd class="stat-value-sm"><%= @batch.kind == 'trial_balance' ? @batch.as_of : (@batch.date_from ? "#{@batch.date_from} – #{@batch.date_to}" : '—') %></dd></div>
    </dl>
    <% if summary['notes'].present? || summary['skipped'].present? %>
      <ul class="list-disc space-y-1 pl-5 text-sm text-mocha">
        <% summary['notes'].to_a.each do |note| %><li><%= note %></li><% end %>
        <% summary['skipped'].to_h.each do |what, count| %><li><%= what.capitalize %>: <%= number_with_delimiter(count) %> skipped.</li><% end %>
        <% if summary.key?('control_matches') %><li><%= summary['control_matches'] ? 'The file’s own total row matches the lines Rupert read.' : 'The file’s own total row does NOT match the lines Rupert read; check for filtered or truncated data.' %></li><% end %>
      </ul>
    <% end %>
  </section>

  <% if summary['unbalanced_total'].to_i.positive? || @batch.rejected_count.positive? || summary['duplicate_transactions'].to_i.positive? || summary['resembling_transactions'].to_i.positive? %>
    <section aria-labelledby="problems-heading" class="space-y-3">
      <h2 id="problems-heading" class="font-display text-xl">Needs your attention</h2>
      <% if summary['unbalanced_total'].to_i.positive? %>
        <div class="card card-pad text-sm">
          <p class="font-semibold"><%= pluralize(summary['unbalanced_total'], 'transaction') %> will not be imported: <span class="font-normal text-mocha">not balanced, or containing a line Rupert could not read. Rupert never adjusts them.</span></p>
          <ul class="mt-2 space-y-1 text-mocha">
            <% summary['unbalanced'].to_a.first(10).each do |row| %><li><%= row['date'] %> · <%= [row['type'], row['number'].presence&.then { |n| "##{n}" }].compact.join(' ') %> — <%= row['reason'] %></li><% end %>
          </ul>
          <% if summary['unbalanced_total'] > 10 %><p class="mt-1 text-xs text-mocha">Showing 10 of <%= summary['unbalanced_total'] %>. Download the rejected rows for the full list.</p><% end %>
        </div>
      <% end %>
      <% if @batch.rejected_count.positive? && summary['rejected_samples'].present? %>
        <div class="card card-pad text-sm">
          <p class="font-semibold">Rows that could not be read</p>
          <ul class="mt-2 space-y-1 text-mocha"><% summary['rejected_samples'].first(10).each do |row| %><li>File row <%= row['row'] %>: <%= row['reason'] %></li><% end %></ul>
        </div>
      <% end %>
      <% if @batch.rejected_count.positive? %><p><%= link_to 'Download rejected rows (CSV)', rejected_finance_quickbooks_import_path(@batch), class: 'btn-ghost btn-sm' %></p><% end %>
      <% if summary['duplicate_transactions'].to_i.positive? %>
        <p class="card card-pad text-sm"><strong><%= pluralize(summary['duplicate_transactions'], 'transaction') %></strong> were already imported in an earlier batch and are skipped, so overlapping exports do not double count.</p>
      <% end %>
      <% if summary['resembling_transactions'].to_i.positive? %>
        <p class="card card-pad text-sm"><strong><%= pluralize(summary['resembling_transactions'], 'transaction') %></strong> share a date, type, number and total with something already imported but differ in their lines (often an edit made in QuickBooks). They are held until you allow them below.</p>
      <% end %>
    </section>
  <% end %>

  <% if @usage.any? %>
    <section aria-labelledby="mapping" id="mapping" class="space-y-3">
      <h2 class="font-display text-xl">Match to Rupert</h2>
      <p class="text-sm text-mocha">
        <% if @entity_type == 'account' %>Every account must have a decision before a journal can be posted. Rupert never matches by itself: a similar existing account is only suggested. “Create” adds the account when you approve.
        <% elsif @entity_type == 'vendor' %>Map a vendor to an existing one, or create it when you approve this list. A vendor with the same name is never merged for you.
        <% else %>Map a customer to an existing record or skip it. Customers are never created from an import, and matching contact details never implies identity.
        <% end %>
      </p>
      <%= form_with url: mappings_finance_quickbooks_import_path(@batch), method: :patch, class: 'space-y-3' do |f| %>
        <ul class="space-y-3" aria-label="Mapping decisions">
          <% @usage.each do |row| %>
            <% mapping = row[:mapping] %>
            <% next unless mapping %>
            <% locked = !(@can_write && open_batch) %>
            <% suggestion = (@accounts.find { |a| a.name.casecmp?(row[:name].to_s) } if @entity_type == 'account') %>
            <% free_code = (mapping.source_number if mapping.source_number.present? && @accounts.none? { |a| a.code.casecmp?(mapping.source_number) }) %>
            <li class="card card-pad space-y-3">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p><span class="font-medium"><%= row[:name] %></span>
                  <% if mapping.source_type.present? %><span class="text-xs text-mocha"> · <%= mapping.source_type %><%= " · ##{mapping.source_number}" if mapping.source_number.present? %></span><% end %></p>
                <% if @batch.kind == 'journal' || @batch.kind == 'trial_balance' %>
                  <p class="text-xs text-mocha tabular-nums">Debits <%= finance_money_text(row[:debit_cents], zero: :dash) %> · Credits <%= finance_money_text(row[:credit_cents], zero: :dash) %></p>
                <% end %>
              </div>
              <% if suggestion && mapping.decision == 'unmapped' %><p class="text-xs text-mocha">Rupert has an account with the same name: <%= suggestion.label %>. Choose “Map to existing” to confirm it.</p><% end %>
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                <div>
                  <label class="field-label" for="decision-<%= mapping.id %>">Decision</label>
                  <%= select_tag "mappings[#{mapping.id}][decision]", options_for_select([['— choose —', 'unmapped'], ['Map to existing', 'map'], *(@entity_type == 'customer' ? [] : [['Create new', 'create']]), ['Skip', 'skip']], mapping.decision),
                        id: "decision-#{mapping.id}", class: 'select w-full', disabled: locked %>
                </div>
                <div>
                  <label class="field-label" for="target-<%= mapping.id %>">Rupert <%= @entity_type %></label>
                  <% options = case @entity_type
                     when 'account' then @accounts.map { |a| [a.label, a.id] }
                     when 'vendor' then @vendors.map { |v| [v.name, v.id] }
                     else @customers.map { |c| [c.name, c.id] }
                     end %>
                  <%= select_tag "mappings[#{mapping.id}][target_id]", options_for_select([['—', '']] + options, mapping.target_id), id: "target-#{mapping.id}", class: 'select w-full', disabled: locked %>
                </div>
                <% if @entity_type == 'account' %>
                  <div>
                    <label class="field-label" for="code-<%= mapping.id %>">New account code</label>
                    <%= text_field_tag "mappings[#{mapping.id}][proposed_code]", mapping.proposed_code, id: "code-#{mapping.id}", class: 'input w-full', maxlength: 20, placeholder: free_code ? "e.g. #{free_code}" : 'unused code', disabled: locked %>
                  </div>
                  <div>
                    <label class="field-label" for="type-<%= mapping.id %>">New account type</label>
                    <%= select_tag "mappings[#{mapping.id}][proposed_type]", options_for_select([['—', '']] + Finance::Account::TYPES.map { |t| [t.titleize, t] }, mapping.proposed_type), id: "type-#{mapping.id}", class: 'select w-full', disabled: locked %>
                  </div>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
        <% if @can_write && open_batch %><%= f.submit 'Save decisions', class: 'btn-primary' %> <span class="text-xs text-mocha">Saving decisions changes no books.</span><% end %>
      <% end %>
    </section>
  <% end %>

  <% if summary['totals_by_account'].present? && @batch.kind == 'journal' %>
    <section aria-labelledby="totals-heading" class="space-y-3">
      <h2 id="totals-heading" class="font-display text-xl">Totals by account</h2>
      <div class="card overflow-hidden">
        <div class="operations-table-region" role="region" tabindex="0" aria-label="Totals by account">
          <table class="operations-table finance-table w-full">
            <caption class="sr-only">Lines read from the file, by QuickBooks account, in USD</caption>
            <thead><tr><th scope="col" class="th">Account</th><th scope="col" class="th num">Lines</th><th scope="col" class="th num">Debits</th><th scope="col" class="th num">Credits</th></tr></thead>
            <tbody>
              <% summary['totals_by_account'].each do |name, row| %>
                <tr><td class="td"><%= name %></td><td class="td num"><%= row['lines'] %></td><td class="td num"><%= finance_money(row['debit_cents'], zero: :dash) %></td><td class="td num"><%= finance_money(row['credit_cents'], zero: :dash) %></td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <% if summary['accounts_total'].to_i > summary['totals_by_account'].size %><p class="text-xs text-mocha">Showing the first <%= summary['totals_by_account'].size %> of <%= summary['accounts_total'] %> accounts.</p><% end %>
    </section>
  <% end %>

  <% if @held.any? %>
    <section aria-labelledby="held-heading" class="space-y-3">
      <h2 id="held-heading" class="font-display text-xl">Staged, not posted</h2>
      <ul class="card card-pad space-y-1 text-sm">
        <% @held.each do |txn| %><li><%= txn.txn_date %> · <%= [txn.txn_type, txn.doc_number.presence&.then { |n| "##{n}" }].compact.join(' ') %> · <%= finance_money_text(txn.debit_cents) %> — <span class="text-mocha"><%= txn.reason %></span></li><% end %>
      </ul>
    </section>
  <% end %>

  <% if @can_write && open_batch %>
    <section aria-labelledby="approve-heading" class="card card-pad space-y-3" id="approve">
      <h2 id="approve-heading" class="font-display text-xl"><%= @batch.postable? ? 'Approve and post' : 'Approve' %></h2>
      <% if @batch.postable? %>
        <% if @native_overlap.positive? %>
          <p role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm">Rupert already holds <strong><%= pluralize(@native_overlap, 'posted entry') %></strong> inside this file’s dates. Posting QuickBooks history over the same days would count the business twice. The last date below is set to the day before Rupert’s first own entry.</p>
        <% end %>
        <p class="text-sm text-mocha">Posts each staged transaction as a balanced journal entry dated as in QuickBooks. Transactions after the last date, in locked periods, with a skipped account, or held above stay staged. Nothing already posted is edited.</p>
        <%= form_with url: approve_finance_quickbooks_import_path(@batch), class: 'space-y-3', data: { turbo_confirm: 'Post these transactions to your books?' } do |f| %>
          <div><%= f.label :post_through, 'Post transactions dated on or before', class: 'field-label' %><%= f.date_field :post_through, value: params[:post_through] || @suggested_cutover || @batch.date_to, required: true, class: 'input' %></div>
          <% if @staged_transactions.where("reason LIKE 'Resembles%'").exists? %>
            <label class="flex items-start gap-3 text-sm"><%= f.check_box :allow_resembling, { class: 'mt-1' }, '1', '0' %><span>Also post transactions that resemble an earlier import (they may double count an edited transaction).</span></label>
          <% end %>
          <% if @approved_overlap.positive? %>
            <label class="flex items-start gap-3 text-sm"><%= f.check_box :allow_approved, { class: 'mt-1' }, '1', '0' %><span>I understand <%= pluralize(@approved_overlap, 'date') %> fall in days or weeks whose books were approved; those approvals will show as changed.</span></label>
          <% end %>
          <%= f.submit 'Approve and post', class: 'btn-primary' %>
        <% end %>
      <% else %>
        <p class="text-sm text-mocha">This file does not post to the books. Approving records your decisions<%= @entity_type && @batch.kind != 'trial_balance' ? ' and creates only the records you chose “Create new” for' : '' %>.</p>
        <%= button_to 'Approve', approve_finance_quickbooks_import_path(@batch), class: 'btn-primary' %>
      <% end %>
      <% if @batch.staged? %>
        <%= button_to 'Discard this batch', discard_finance_quickbooks_import_path(@batch), class: 'btn-ghost btn-sm', form: { data: { turbo_confirm: 'Discard this batch? The original file stays retained.' } } %>
      <% end %>
    </section>
  <% end %>

  <% if @can_write && @batch.approved? && @batch.postable? %>
    <section aria-labelledby="reverse-heading" class="card card-pad space-y-3" id="reverse">
      <h2 id="reverse-heading" class="font-display text-xl">Reverse this import</h2>
      <p class="text-sm text-mocha">Voids every journal entry this batch posted, so they drop out of every report. It is all or nothing and is refused while any of them is in a locked period. The original file and staged rows are kept.</p>
      <%= form_with url: reverse_finance_quickbooks_import_path(@batch), class: 'space-y-3', data: { turbo_confirm: 'Void every entry from this batch?' } do |f| %>
        <div><%= f.label :reason, 'Why are you reversing it?', class: 'field-label' %><%= f.text_area :reason, required: true, maxlength: 2000, rows: 2, class: 'input w-full' %></div>
        <%= f.submit 'Reverse import', class: 'btn-ghost' %>
      <% end %>
      <% if @posted_entries.positive? %><p class="text-xs text-mocha">Posted entries: <%= link_to 'open the general ledger', finance_journal_entries_path(kind: 'imported'), class: 'link' %>.</p><% end %>
    </section>
  <% end %>
</div>
