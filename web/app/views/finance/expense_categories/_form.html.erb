<%= form_with model: category, scope: :expense_category, url: (category.persisted? ? finance_expense_category_path(category) : finance_expense_categories_path), class: 'card card-pad max-w-2xl space-y-4' do |f| %>
  <%= render 'shared/form_errors', model: category %>
  <div><%= f.label :name, 'Name', class: 'field-label' %><%= f.text_field :name, class: 'input', required: true, maxlength: 60 %></div>
  <div>
    <%= f.label :ledger_account_id, 'Posts to ledger account', class: 'field-label' %>
    <%= f.select :ledger_account_id, @accounts.map { |a| ["#{a.code} · #{a.name}", a.id] }, { include_blank: 'Default account for this category' }, class: 'select', 'aria-describedby': 'ledger-hint' %>
    <p id="ledger-hint" class="mt-1 text-xs text-mocha">Expense accounts from your chart of accounts. Applies to expenses recorded or edited from now on.</p>
  </div>
  <div>
    <%= f.label :keywords, 'Suggest for bank lines containing', class: 'field-label' %>
    <%= f.text_area :keywords, rows: 3, class: 'input', placeholder: 'e.g. usps, ups, fedex', 'aria-describedby': 'keyword-hint' %>
    <p id="keyword-hint" class="mt-1 text-xs text-mocha">Separate words with commas. When a bank line's description contains one, this category is suggested. A suggestion is never saved until someone presses Save.</p>
  </div>
  <div class="flex flex-wrap gap-6">
    <div><%= f.label :position, 'Order in lists', class: 'field-label' %><%= f.number_field :position, class: 'input w-28', min: 0, step: 1 %></div>
    <label class="flex items-center gap-2 pt-6 text-sm"><%= f.check_box :active %> Active (shown when choosing a category)</label>
  </div>
  <div class="flex gap-2"><%= f.submit category.persisted? ? 'Save category' : 'Add category', class: 'btn-primary' %><%= link_to 'Cancel', finance_expense_categories_path, class: 'btn-ghost' %></div>
<% end %>
