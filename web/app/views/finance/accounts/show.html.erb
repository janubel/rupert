<% content_for :title, 'Accounts' %>
<% can_write = retail_business_access?('finance.write') %>
<div class="space-y-6">
  <%= page_header 'Accounts', subtitle: 'What vendors are owed and what customers owe, from recorded purchase orders, orders and payments.',
        menu: [(['Add expense', new_finance_expense_path] if can_write), (['Day close', financial_close_path(day: Date.yesterday)] if retail_business_access?('reports.read'))].compact do %>
    <% if can_write %><%= link_to 'Add payment', new_finance_vendor_payment_path, class: 'btn-primary' %><% end %>
  <% end %>
  <%= fold_explainer('Balances use Rupert’s recorded purchase orders, canonical orders and completed payments; they are not bank balances. Local expenses and vendor payments are separate registers, and this page does not add them together.', class: 'text-sm text-mocha') %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3" aria-label="Vendor balance summary">
    <% [['Vendor balances due', @payables_total, "#{pluralize(@payables_count, 'vendor')} with a balance", 'accounts_payable'],
        ['Vendor credits / prepayments', @credits_total, 'Shown separately from balances due', 'vendor_credit'],
        ['Ordered, not received', @committed_total, 'Purchase commitments, separate from received goods', 'po_pending']].each do |label, value, detail, term| %>
      <div class="stat min-w-0">
        <div class="stat-label"><%= label %> · USD<%= define(term) %></div>
        <p class="stat-value mt-1"><%= finance_money(value) %></p>
        <p class="mt-1 text-xs text-taupe"><%= detail %></p>
      </div>
    <% end %>
  </section>
  <% if (first_payable = @payables.find { |row| row[:balance_cents].positive? } || @payables.first) %>
    <%= explain_calculation(title: "Vendor balance due · #{first_payable[:vendor].name}", id: 'vendor-balance-due', summary: 'How is a vendor balance calculated? (first vendor)',
          formula: 'Received goods − recorded payments for one vendor. When payments exceed received goods, the excess is shown as a credit instead of a negative balance.',
          rows: [['Received goods', finance_money(first_payable[:owed_cents])], ['Recorded payments', "− #{finance_money(first_payable[:paid_cents])}"],
                 ['Balance due', finance_money(first_payable[:balance_cents])], ['Credit / prepayment', finance_money([first_payable[:paid_cents] - first_payable[:owed_cents], 0].max)],
                 ['Ordered, not received (separate)', finance_money(first_payable[:committed_cents])]],
          note: "Vendor balances due above adds the balance of every vendor with a positive balance (#{@payables_count}). These are Rupert’s local records, not vendor invoices or a bank balance.",
          term: 'accounts_payable', lesson: 'books') %>
  <% end %>

  <section id="vendor-balances" class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'Vendor balances', hint: 'Received goods less recorded payments · USD. A credit never reduces another vendor’s balance.' %></div>
    <div class="table-region" role="region" tabindex="0" aria-label="Vendor balances">
      <table class="table finance-table">
        <caption class="sr-only">Vendor balances, credits and purchase commitments in USD</caption>
        <thead>
          <tr>
            <% [['Vendor', nil, false], ['Received goods', 'received_quantity', true], ['Recorded payments', 'vendor_payment', true], ['Balance due', 'accounts_payable', true],
                ['Credit / prepayment', 'vendor_credit', true], ['Not received', 'po_pending', true]].each do |label, term, numeric| %>
              <th scope="col" class="th<%= ' num' if numeric %>"><%= label %><%= define(term) if term %></th>
            <% end %>
            <th scope="col" class="th"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @payables.each do |row| %>
            <tr>
              <th scope="row" class="td text-left font-medium text-ink"><%= retail_business_access?('purchasing.read') ? link_to(row[:vendor].name, row[:vendor], class: 'link') : row[:vendor].name %></th>
              <% [row[:owed_cents], row[:paid_cents], row[:balance_cents], [row[:paid_cents] - row[:owed_cents], 0].max, row[:committed_cents]].each do |value| %>
                <td class="td num"><%= finance_money(value) %></td>
              <% end %>
              <td class="td whitespace-nowrap text-right">
                <% if can_write %>
                  <%= link_to 'Add payment', new_finance_vendor_payment_path(vendor_id: row[:vendor].id), class: 'btn-ghost btn-sm', aria: { label: "Add payment for #{row[:vendor].name}" } %>
                <% else %>
                  <span class="text-xs text-mocha">Read-only</span>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @payables.empty? %><tr><td colspan="7" class="empty-row">No received goods, purchase commitments or vendor payments recorded yet.<%= ' Add the first payment from the header.' if can_write %></td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section id="customer-balances" class="space-y-4">
    <%= section_heading 'Customer receivables', hint: 'Paid or fulfilled order totals less completed payments, by customer and currency. Currencies are never combined; a missing order amount keeps that balance Unknown.' %>
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-3" aria-label="Receivables by currency">
      <% @receivable_groups.each do |currency, rows| %>
        <div class="stat min-w-0">
          <div class="stat-label"><%= currency.presence || 'Unknown currency' %> · balance due<%= define('accounts_receivable') %></div>
          <p class="stat-value mt-1"><%= finance_money(rows.any? { |row| row[:balance_cents].nil? } ? nil : rows.sum { |row| row[:balance_cents] }, currency: currency, missing: 'Unknown') %></p>
          <p class="mt-1 text-xs text-taupe"><%= pluralize(rows.size, 'customer balance') %></p>
        </div>
      <% end %>
    </div>
    <div class="card">
      <div class="table-region" role="region" tabindex="0" aria-label="Customer receivables">
        <table class="table finance-table">
          <caption class="sr-only">Customer receivables by customer and currency</caption>
          <thead>
            <tr>
              <th scope="col" class="th">Customer</th>
              <th scope="col" class="th">Currency</th>
              <th scope="col" class="th num">Recorded orders</th>
              <th scope="col" class="th num">Balance due</th>
            </tr>
          </thead>
          <tbody>
            <% @receivables.each do |row| %>
              <tr>
                <th scope="row" class="td text-left font-medium text-ink"><%= row[:customer].name %></th>
                <td class="td"><%= row[:currency].presence || 'Unknown' %></td>
                <td class="td num"><%= row[:order_count] %></td>
                <td class="td num"><%= finance_money(row[:balance_cents], currency: row[:currency], missing: 'Unknown') %></td>
              </tr>
            <% end %>
            <% if @receivables.empty? %><tr><td colspan="4" class="empty-row">No customer owes a balance on recorded orders. Missing invoices and unimported payments need a source review.</td></tr><% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% if @receivables_count > @receivables.size %><p class="text-xs text-mocha">Showing <%= @pagy.from %>–<%= @pagy.to %> of <%= @receivables_count %> balances. The currency figures above include every recorded balance.</p><% end %>
    <%== @pagy.series_nav if @pagy.pages > 1 %>
  </section>
</div>
