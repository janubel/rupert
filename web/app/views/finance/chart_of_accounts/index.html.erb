<% content_for :title, "Chart of accounts" %>
<div class="space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :money %>
  <%= render 'shared/operations_navigation', workspace: :finance %>
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Chart of accounts</h1>
      <p class="mt-1 text-sm text-mocha">The account codes the ledger posts to, grouped by type. <%= @active_count %> active of <%= @grouped.values.sum(&:length) %> accounts.</p>
    </div>
    <% if Current.user.can?("finance.write") %>
      <%= link_to "Add account", new_finance_chart_of_account_path, class: "btn-primary" %>
    <% end %>
  </section>

  <% Finance::Account::TYPE_LABELS.each do |type, label| %>
    <% accounts = @grouped.fetch(type, []) %>
    <section class="card overflow-hidden">
      <div class="flex items-center justify-between border-b border-fog px-5 py-3">
        <h2 class="font-display text-lg text-ink"><%= label %></h2>
        <span class="pill-taupe"><%= accounts.count(&:active) %> active</span>
      </div>
      <div class="operations-table-region" role="region" tabindex="0" aria-label="Finance record table">
        <table class="operations-table w-full text-sm">
          <thead class="border-b border-fog bg-haze/60">
            <tr>
              <th scope="col" class="th">Code</th>
              <th scope="col" class="th">Name</th>
              <th scope="col" class="th">Normal balance</th>
              <th scope="col" class="th">Description</th>
              <th scope="col" class="th text-right"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-fog">
            <% if accounts.empty? %>
              <tr><td colspan="5" class="empty-row">No <%= label.downcase %> accounts.</td></tr>
            <% end %>
            <% accounts.each do |account| %>
              <tr class="hover:bg-cream <%= account.active ? "" : "opacity-50" %>">
                <td class="td font-mono text-mocha"><%= account.code %></td>
                <td class="td font-medium text-ink">
                  <%= account.name %>
                  <% unless account.active %><span class="ml-2 pill-taupe">archived</span><% end %>
                </td>
                <td class="td text-mocha capitalize"><%= account.normal_balance %></td>
                <td class="td text-taupe"><%= account.description.presence || "—" %></td>
                <td class="td whitespace-nowrap text-right">
                  <% if Current.user.can?("finance.write") %>
                    <%= link_to "Edit", edit_finance_chart_of_account_path(account), class: "text-xs font-semibold text-olive hover:underline" %>
                    <% if account.active %>
                      <%= button_to "Archive", archive_finance_chart_of_account_path(account), method: :post, class: "ml-2 text-xs font-semibold text-taupe hover:text-rose", data: { turbo_confirm: "Archive #{account.name}? It will stay in the chart but be hidden from new entries." } %>
                    <% else %>
                      <%= button_to "Restore", restore_finance_chart_of_account_path(account), method: :post, class: "ml-2 text-xs font-semibold text-fern hover:underline" %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
