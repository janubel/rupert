<% content_for :title, "Account #{@account.code}" %>
<% range_text = @from || @to ? "#{@from ? @from.to_date.strftime('%b %-d, %Y') : 'Start'} – #{@to ? @to.to_date.strftime('%b %-d, %Y') : 'today'}" : 'All dates' %>
<div class="space-y-6">
  <%= page_header finance_account_label(@account), eyebrow: 'Bookkeeping · Account',
        subtitle: "#{@account.type_label.singularize} account · normal balance #{@account.normal_balance} · #{range_text} · USD",
        menu: [['Chart of accounts', finance_chart_of_accounts_path], ['Trial balance', finance_reports_trial_balance_path(from: @from, to: @to)]] do %>
    <% if Current.user.can?('finance.write') %><%= link_to 'Edit', edit_finance_chart_of_account_path(@account), class: 'btn-primary' %><% end %>
  <% end %>
  <% unless @account.active %><p><span class="pill-taupe">Archived</span> <span class="text-sm text-mocha">Kept on record; cannot be used for new entries.</span></p><% end %>

  <%= form_tag finance_chart_of_account_path(@account), method: :get, class: 'toolbar' do %>
    <div class="toolbar-field"><%= label_tag :from, 'From', class: 'field-label' %><%= date_field_tag :from, @from, class: 'input' %></div>
    <div class="toolbar-field"><%= label_tag :to, 'To', class: 'field-label' %><%= date_field_tag :to, @to, class: 'input' %></div>
    <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary', name: nil %><%= link_to 'Clear', finance_chart_of_account_path(@account), class: 'btn-ghost' %></div>
  <% end %>

  <section class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'Ledger lines', hint: 'Every posted ledger line that touched this account. Select an entry to see all of its lines and its source.' %></div>
    <div class="table-region" role="region" tabindex="0" aria-label="Ledger lines for <%= finance_account_label(@account) %>">
      <table class="table finance-table">
        <caption class="sr-only">Posted ledger lines for <%= finance_account_label(@account) %>, in USD</caption>
        <thead>
          <tr>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Entry</th>
            <th scope="col" class="th num">Debit</th>
            <th scope="col" class="th num">Credit</th>
            <th scope="col" class="th num">Running balance</th>
          </tr>
        </thead>
        <tbody>
          <% if @rows.empty? %>
            <tr><td colspan="5" class="empty-row">No posted lines for this account in this range. Widen the dates, or post an entry from the <%= link_to 'General ledger', finance_journal_entries_path, class: 'link' %>.</td></tr>
          <% end %>
          <% @rows.each do |row| %>
            <tr>
              <td class="td whitespace-nowrap"><%= l(row[:entry].posted_on, format: :short) %></td>
              <td class="td"><%= link_to (row[:entry].memo.presence || "Entry ##{row[:entry].id}"), finance_journal_entry_path(row[:entry]), class: 'link' %><% if row[:line].memo.present? %> <span class="text-mocha">· <%= row[:line].memo %></span><% end %></td>
              <td class="td num"><%= finance_money(row[:line].debit_cents, zero: :dash) %></td>
              <td class="td num"><%= finance_money(row[:line].credit_cents, zero: :dash) %></td>
              <td class="td num"><%= finance_money(row[:running_balance]) %></td>
            </tr>
          <% end %>
        </tbody>
        <% if @rows.any? %>
          <tfoot>
            <tr class="font-semibold">
              <th scope="row" class="td" colspan="2">Totals for these lines</th>
              <td class="td num"><%= finance_money(@total_debit) %></td>
              <td class="td num"><%= finance_money(@total_credit) %></td>
              <td class="td num"><%= finance_money(@rows.last[:running_balance]) %></td>
            </tr>
          </tfoot>
        <% end %>
      </table>
    </div>
  </section>
  <p class="text-xs text-mocha">The running balance starts at $0.00 at the first line shown, so it is the account balance only when the range starts at the first posting. Balances are shown on the account's normal side (<%= @account.normal_balance %>); a negative number means the opposite side.</p>
</div>
