<% content_for :title, "Account #{@account.code}" %>
<div class="space-y-6 operations-workspace">

  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title"><%= finance_account_label(@account) %></h1>
      <p class="mt-1 text-base text-mocha">
        <%= @account.type_label.singularize %> account · normal balance <%= @account.normal_balance %> ·
        <%= @from || @to ? "#{@from || 'start'} through #{@to || 'today'}" : 'All dates' %> · USD
        <% unless @account.active %> · <span class="pill-taupe">Archived</span><% end %>
      </p>
      <p class="mt-1 text-sm text-mocha">Every posted ledger line that touched this account. Select an entry to see all of its lines and its source.</p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Chart of accounts", finance_chart_of_accounts_path, class: "btn-ghost btn-sm" %>
      <%= link_to "Trial balance", finance_reports_trial_balance_path(from: @from, to: @to), class: "btn-ghost btn-sm" %>
    </div>
  </section>

  <%= form_tag finance_chart_of_account_path(@account), method: :get, class: "card card-pad operations-filters" do %>
    <label class="flex items-center gap-1.5 text-base text-mocha">From <%= date_field_tag :from, @from, class: "select" %></label>
    <label class="flex items-center gap-1.5 text-base text-mocha">To <%= date_field_tag :to, @to, class: "select" %></label>
    <%= submit_tag "Apply dates", class: "btn-ghost btn-sm" %>
  <% end %>

  <div class="card overflow-hidden">
    <div class="operations-table-region" role="region" tabindex="0" aria-label="Ledger lines for <%= finance_account_label(@account) %>">
      <table class="operations-table finance-table w-full">
        <caption class="sr-only">Posted ledger lines for <%= finance_account_label(@account) %>, in USD</caption>
        <thead>
          <tr>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Entry</th>
            <th scope="col" class="th num">Debit</th>
            <th scope="col" class="th num">Credit</th>
            <th scope="col" class="th num">Running balance</th>
          </tr>
        </thead>
        <tbody>
          <% if @rows.empty? %>
            <tr><td colspan="5" class="empty-row">No posted lines for this account in this range. Widen the dates, or post an entry from the <%= link_to "General ledger", finance_journal_entries_path, class: "link" %>.</td></tr>
          <% end %>
          <% @rows.each do |row| %>
            <tr>
              <td class="td whitespace-nowrap"><%= row[:entry].posted_on %></td>
              <td class="td"><%= link_to (row[:entry].memo.presence || "Entry ##{row[:entry].id}"), finance_journal_entry_path(row[:entry]), class: "link" %><% if row[:line].memo.present? %> <span class="text-mocha">· <%= row[:line].memo %></span><% end %></td>
              <td class="td num"><%= finance_money(row[:line].debit_cents, zero: :dash) %></td>
              <td class="td num"><%= finance_money(row[:line].credit_cents, zero: :dash) %></td>
              <td class="td num"><%= finance_money(row[:running_balance]) %></td>
            </tr>
          <% end %>
        </tbody>
        <% if @rows.any? %>
          <tfoot>
            <tr>
              <th scope="row" class="td" colspan="2">Totals for these lines</th>
              <td class="td num"><%= finance_money(@total_debit) %></td>
              <td class="td num"><%= finance_money(@total_credit) %></td>
              <td class="td num"><%= finance_money(@rows.last[:running_balance]) %></td>
            </tr>
          </tfoot>
        <% end %>
      </table>
    </div>
  </div>
  <p class="text-sm text-mocha">The running balance starts at $0.00 at the first line shown, so it is the account balance only when the range starts at the first posting. Balances are shown on the account's normal side (<%= @account.normal_balance %>); a negative number means the opposite side.</p>
</div>
