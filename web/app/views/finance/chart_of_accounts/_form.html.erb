<%= form_with model: @account, scope: :account, url: (@account.persisted? ? finance_chart_of_account_path(@account) : finance_chart_of_accounts_path), class: 'space-y-4' do |f| %>
  <% if @account.errors.any? %>
    <div role="alert" class="flash flash-alert"><%= @account.errors.full_messages.to_sentence %></div>
  <% end %>
  <fieldset class="space-y-4">
    <legend class="card-title">Account</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :code, 'Code', class: 'field-label' %>
        <%= f.text_field :code, class: 'input', placeholder: 'e.g. 1100', autocomplete: 'off' %>
        <p class="mt-1 text-xs text-mocha">A unique number. Accounts are listed in code order. Posting rules refer to codes, so avoid changing a code that already has entries.</p>
      </div>
      <div>
        <%= f.label :name, 'Name', class: 'field-label' %>
        <%= f.text_field :name, class: 'input', placeholder: 'e.g. Checking account', autocomplete: 'off' %>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :account_type, 'Type', class: 'field-label' %>
        <%= f.select :account_type, Finance::Account::TYPES.map { |t| [Finance::Account::TYPE_LABELS.fetch(t), t] }, {}, class: 'select w-full' %>
      </div>
      <div>
        <%= f.label :normal_balance, 'Increases with (normal balance)', class: 'field-label' %>
        <%= f.select :normal_balance, [['Debit', 'debit'], ['Credit', 'credit']], {}, class: 'select w-full' %>
        <p class="mt-1 text-xs text-mocha">Normally debit for assets and expenses, credit for liabilities, equity and revenue. Choosing the other side makes reports show this account backwards.</p>
      </div>
    </div>
    <div>
      <%= f.label :description, 'Description (optional)', class: 'field-label' %>
      <%= f.text_area :description, rows: 2, class: 'input', placeholder: 'What this account tracks' %>
    </div>
    <label class="flex items-center gap-1.5 text-sm text-mocha">
      <%= f.check_box :active, class: 'checkbox' %> Active
    </label>
  </fieldset>
  <div class="form-actions">
    <%= f.submit 'Save', class: 'btn-primary' %>
    <%= link_to 'Cancel', finance_chart_of_accounts_path, class: 'btn-ghost' %>
  </div>
<% end %>
