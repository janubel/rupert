<% content_for :title, "Edit account" %>
<div class="space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :money %>
  <%= render 'shared/operations_navigation', workspace: :finance %>
  <section>
    <h1 class="page-title">Edit account</h1>
    <p class="mt-1 text-sm text-mocha"><%= @account.code %> · <%= @account.name %></p>
  </section>
  <div class="card card-pad max-w-2xl">
    <%= render "form", account: @account %>
  </div>
</div>
