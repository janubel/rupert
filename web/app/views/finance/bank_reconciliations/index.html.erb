<% content_for :title, "Bank reconciliation" %>
<div class="space-y-6 operations-workspace">

  <%= render layout: 'finance/page_header', locals: { title: 'Bank reconciliation', range: "#{@from} through #{@to}", print: true,
        explain: "Match each line on the #{@account_label} bank statement to a ledger entry. Suggestions are never applied until you confirm them." } do %>
    <%= link_to "General ledger", finance_journal_entries_path, class: "btn-ghost btn-sm" %>
    <%= link_to "Bank statements", bank_statements_path, class: "btn-ghost btn-sm" %>
  <% end %>

  <%= form_tag finance_bank_reconciliation_path, method: :get, class: "card card-pad operations-filters" do %>
    <%= select_tag :account_label, options_for_select(@account_labels, @account_label), class: "select", aria: { label: "Account" } %>
    <%= date_field_tag :from, @from, class: "select" %>
    <%= date_field_tag :to, @to, class: "select" %>
    <%= select_tag :window_days, options_for_select([["±0 days",0],["±3 days",3],["±5 days",5],["±10 days",10]], @reconciliation.window_days), class: "select", aria: { label: "Match window" } %>
    <%= submit_tag "Show lines", class: "btn-ghost btn-sm" %>
  <% end %>

  <section class="card card-pad">
    <h2 class="font-display text-xl">Statement ledger account</h2>
    <p class="text-sm text-mocha">Choose the single asset account represented by this statement label. Existing labels are not mapped automatically. One label represents one ledger account.</p>
    <% unless @reconciliation.mapping %><p role="status">Choose a ledger account before matching. Ledger totals and the difference are unavailable until then.</p><% end %>
    <% if Current.user.can?('finance.write') %>
    <%= form_tag finance_bank_reconciliation_account_path, method: :post, class: "operations-filters" do %>
      <%= hidden_field_tag :account_label, @account_label %>
      <%= hidden_field_tag :from, @from %><%= hidden_field_tag :to, @to %>
      <%= select_tag :ledger_account_id, options_from_collection_for_select(@reconciliation.bank_accounts, :id, :label, @reconciliation.mapping&.ledger_account_id), include_blank: 'Choose a ledger account', required: true, class: 'select', aria: { label: 'Statement ledger account' } %>
      <%= submit_tag 'Save account mapping', class: 'btn-primary btn-sm' %>
    <% end %>
    <% else %><p class="text-sm text-mocha">A finance editor can set the statement ledger account.</p><% end %>
  </section>

  <% s = @reconciliation.summary %>
  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="stat">
      <div class="stat-label">Lines<%= define('matched_line') %></div>
      <p class="stat-value mt-1"><%= s[:lines] %></p>
      <p class="mt-1 text-sm text-mocha"><%= s[:matched] %> with a matching ledger movement · <%= s[:unmatched_lines] %> without one. Review and confirm suggestions below.</p>
    </div>
    <div class="stat">
      <div class="stat-label">Statement net · USD<%= define('statement_net') %></div>
      <p class="stat-value mt-1"><%= finance_money(s[:statement_net_cents]) %></p>
      <p class="mt-1 text-sm text-mocha">in <%= finance_money(s[:statement_in_cents]) %> · out <%= finance_money(s[:statement_out_cents]) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Ledger net · USD<%= define('ledger_net') %></div>
      <p class="stat-value mt-1"><%= s[:gl_net_cents].nil? ? "Unavailable" : finance_money(s[:gl_net_cents]) %></p>
      <p class="mt-1 text-sm text-mocha"><%= @reconciliation.mapping&.ledger_account&.label || "No account mapped" %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Difference · USD<%= define('bank_difference') %></div>
      <p class="stat-value mt-1"><%= s[:difference_cents].nil? ? "Unavailable" : finance_money(s[:difference_cents]) %></p>
      <p class="mt-1 text-sm font-semibold"><%= s[:difference_cents].nil? ? "Choose the statement ledger account." : s[:difference_cents].zero? ? "Selected-period net movements agree; review unmatched lines." : "Selected-period net difference: #{finance_money_text(s[:difference_cents].abs)}." %></p>
      <% money_or_na = ->(cents) { cents.nil? ? 'Unavailable' : finance_money(cents) } %>
      <%= explain_calculation(title: 'Statement minus ledger', id: 'bank-difference',
              formula: 'Statement net (in + out) − ledger net (movements in the selected ledger account) for the selected period.',
              rows: [['Statement in', finance_money(s[:statement_in_cents])], ['Statement out', finance_money(s[:statement_out_cents])], ['Statement net', finance_money(s[:statement_net_cents])],
                     ['Ledger in', money_or_na.(s[:gl_in_cents])], ['Ledger out', money_or_na.(s[:gl_out_cents])], ['Ledger net', money_or_na.(s[:gl_net_cents])],
                     ['Difference', money_or_na.(s[:difference_cents])]],
              note: "#{s[:unmatched_lines]} statement #{'line'.pluralize(s[:unmatched_lines])} and #{s[:unmatched_gl]} ledger #{'movement'.pluralize(s[:unmatched_gl])} are still unmatched. Ignored lines are excluded. Confirming a match records the link only; nothing here changes an amount.",
              term: 'bank_difference', lesson: 'books') %>
    </div>
  </section>

  <% dups = @reconciliation.duplicate_groups %>
  <% if dups.any? %>
    <div class="card card-pad">
      <h2 class="font-display text-xl">Possible duplicates (<%= dups.size %>)</h2>
      <p class="mt-1 text-sm text-mocha">Statement lines with the same amount close together. Review and ignore any that are true duplicates; ignored lines drop out of reconciliation.</p>
      <div class="mt-3 space-y-3">
        <% dups.each do |group| %>
          <div class="rounded border border-fog p-3">
            <% group.each do |line| %>
              <div class="flex items-center justify-between gap-3 py-1">
                <span><%= line.posted_on %> · <%= line.description.to_s.truncate(44) %> · <%= finance_money(line.amount_cents) %></span>
                <% if line.recorded_source? %><span class="text-sm text-mocha">Review recorded source</span><% else %>
                <%= button_to "Ignore this line", finance_bank_reconciliation_ignore_path, method: :post, params: { line_id: line.id, from: @from, to: @to }, class: "btn-ghost btn-sm",
                      form: { data: { turbo_confirm: "Ignore this statement line?\n\n#{line.posted_on}, #{finance_money_text(line.amount_cents)}, #{line.description.to_s.truncate(40)}\n\nIt drops out of reconciliation and duplicate checks. The bank statement itself is not changed." } } %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="card overflow-hidden">
    <h2 class="px-4 pt-4 font-display text-xl">Statement lines</h2>
    <div class="operations-table-region" role="region" tabindex="0" aria-label="Statement lines">
      <table class="operations-table finance-table w-full">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Description</th>
            <th scope="col" class="th num">Amount</th>
            <th scope="col" class="th">Suggested ledger match</th>
            <th scope="col" class="th">Match</th>
          </tr>
        </thead>
        <tbody>
          <% if @reconciliation.lines.empty? %><tr><td colspan="5" class="empty-row">No statement lines for this account and these dates. Upload a statement on <%= link_to "Bank statements", bank_statements_path, class: "link" %>, or widen the dates.</td></tr><% end %>
          <% @reconciliation.lines.each do |line| %>
            <% suggestion = @reconciliation.suggestions[line.id] %>
            <tr>
              <td class="td whitespace-nowrap"><%= line.posted_on %></td>
              <td class="td"><%= line.description.to_s.truncate(48) %></td>
              <td class="td num"><%= finance_money(line.amount_cents) %></td>
              <td class="td">
                <% if suggestion %>
                  <%= link_to (suggestion.entry.memo.presence || "Entry ##{suggestion.entry.id}"), finance_journal_entry_path(suggestion.entry), class: "link" %>
                  <span class="text-sm text-mocha">· <%= suggestion.entry.posted_on %><%= " (±#{suggestion.days_apart}d)" if suggestion.days_apart.to_i.positive? %></span>
                <% else %>
                  <span class="text-mocha">No suggested match</span>
                <% end %>
              </td>
              <td class="td">
                <% if line.recorded_source? %>
                  <span class="text-sm text-mocha">Linked to recorded source</span>
                <% elsif line.journal_entry_id.present? %>
                  <%= button_to "Clear match", finance_bank_reconciliation_unmatch_path, method: :post,
                        params: { line_id: line.id, from: @from, to: @to }, class: "btn-ghost btn-sm",
                        form: { data: { turbo_confirm: "Clear this match?\n\nStatement line: #{line.posted_on}, #{finance_money_text(line.amount_cents)}, #{line.description.to_s.truncate(40)}\n\nThe line goes back to unmatched. The ledger entry is not changed." } } %>
                <% elsif suggestion %>
                  <%= button_to "Confirm match", finance_bank_reconciliation_match_path, method: :post,
                        params: { line_id: line.id, journal_entry_id: suggestion.entry.id, from: @from, to: @to }, class: "btn-primary btn-sm",
                        form: { data: { turbo_confirm: "Match these two records?\n\nStatement line: #{line.posted_on}, #{finance_money_text(line.amount_cents)}, #{line.description.to_s.truncate(40)}\nLedger entry ##{suggestion.entry.id}: #{suggestion.entry.posted_on}, #{finance_money_text(suggestion.entry.debit_cents)}, #{suggestion.entry.memo.to_s.truncate(40)}\n\nThis records that the bank line belongs to that entry. No amounts change. You can clear the match later." } } %>
                <% else %>
                  <span class="text-mocha">Nothing to confirm</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @reconciliation.unmatched_gl.any? %>
    <div class="card overflow-hidden">
      <h2 class="px-4 pt-4 font-display text-xl">Ledger movements with no statement line (<%= @reconciliation.unmatched_gl.size %>)</h2>
      <div class="operations-table-region" role="region" tabindex="0" aria-label="Unmatched ledger movements">
        <table class="operations-table finance-table w-full">
          <thead class="border-b border-fog bg-haze/60">
            <tr><th scope="col" class="th">Date</th><th scope="col" class="th">Entry</th><th scope="col" class="th num">Amount</th></tr>
          </thead>
          <tbody>
            <% @reconciliation.unmatched_gl.each do |m| %>
              <tr>
                <td class="td"><%= m[:date] %></td>
                <td class="td"><%= link_to (m[:entry].memo.presence || "Entry ##{m[:entry].id}"), finance_journal_entry_path(m[:entry]), class: "link" %></td>
                <td class="td num"><%= finance_money(m[:signed_cents]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <p class="text-sm text-mocha">
    Compares non-ignored statement lines with posted movements in the selected ledger account for the same dates. Matching suggestions require the same signed amount and use your date window. A zero net difference does not establish complete records or a reconciled bank balance; review unmatched items and settlement timing.
  </p>
</div>
