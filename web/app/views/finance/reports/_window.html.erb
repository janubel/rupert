<%= form_tag path, method: :get, class: "card card-pad operations-filters no-print" do %>
  <div><%= label_tag :from, "From", class: "field-label" %><%= date_field_tag :from, @from, class: "select w-full" %></div>
  <div><%= label_tag :to, "To", class: "field-label" %><%= date_field_tag :to, @to, class: "select w-full" %></div>
  <%= submit_tag "Apply dates", class: "btn-primary btn-sm" %>
  <%= link_to "Export CSV", csv_path, class: "btn-ghost btn-sm", data: { turbo: false } %>
<% end %>
