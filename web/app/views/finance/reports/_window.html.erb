<%# Period picker shared by the statements: quick ranges as a second row of tabs, then the dates. +as_of+ reports take one date. %>
<% as_of = local_assigns[:as_of] %>
<% presets = report_date_presets %>
<div class="card card-pad space-y-3 no-print">
  <nav class="tabs" aria-label="Quick date ranges">
    <% presets.each do |label, from, to| %>
      <% active = as_of ? @to == to : (@from == from && @to == to) %>
      <%= link_to label, (as_of ? url_for(to: to.iso8601) : url_for(from: from.iso8601, to: to.iso8601)), class: "tab #{'tab-active' if active}".strip, aria: { current: (active ? 'page' : nil) } %>
    <% end %>
  </nav>
  <%= form_tag path, method: :get, class: 'toolbar' do %>
    <% unless as_of %><div class="toolbar-field"><%= label_tag :from, 'From', class: 'field-label' %><%= date_field_tag :from, @from, class: 'input' %></div><% end %>
    <div class="toolbar-field"><%= label_tag :to, as_of ? 'As of' : 'To', class: 'field-label' %><%= date_field_tag :to, @to, class: 'input' %></div>
    <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary', name: nil %><%= link_to 'Clear', path, class: 'btn-ghost' %></div>
  <% end %>
</div>
