<% content_for :title, "Income statement" %>
<%= render 'finance/reports/coverage_notice' %>
<div class="space-y-6 operations-workspace">

  <%= render layout: 'finance/page_header', locals: { title: 'Income statement', range: "#{@from} through #{@to}", print: true,
        explain: 'Revenue earned less expenses incurred in the period. The difference is net income (or a net loss, shown with a minus sign).' } do %>
    <%= link_to "All reports", finance_reports_path, class: "btn-ghost btn-sm" %>
  <% end %>

  <%= render 'window', path: finance_reports_income_statement_path, csv_path: finance_reports_income_statement_path(format: :csv) %>

  <section class="grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Report totals">
    <div class="stat">
      <div class="stat-label">Revenue<%= define('profit_loss') %></div>
      <p class="stat-value mt-1"><%= finance_money(@statement[:total_revenue]) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Expenses<%= define('expense') %></div>
      <p class="stat-value mt-1"><%= finance_money(@statement[:total_expense]) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Net income<%= define('net_income') %></div>
      <p class="stat-value mt-1"><%= finance_money(@statement[:net_income]) %></p>
      <%= explain_calculation(title: 'Net income for the period', id: 'income-statement-net',
            formula: 'Total revenue − total expenses, from entries posted to the ledger between the dates.',
            rows: [["Revenue accounts with activity", @statement[:revenue].size], ['Total revenue', finance_money(@statement[:total_revenue])],
                   ["Expense accounts with activity", @statement[:expense].size], ['Total expenses', "− #{finance_money(@statement[:total_expense])}"],
                   ['Net income', finance_money(@statement[:net_income])]],
            note: 'A negative result is a net loss. Only posted ledger entries count: bank lines still waiting for a decision and unrecorded expenses are not here, so the figure can look better than reality.',
            term: 'net_income', lesson: 'books') %>
    </div>
  </section>

  <div class="card overflow-hidden operations-table-region" role="region" tabindex="0" aria-label="Income statement">
    <table class="operations-table finance-table w-full">
      <caption class="sr-only">Income statement, amounts in USD</caption>
      <thead class="border-b border-fog bg-haze/60">
        <tr><th scope="col" class="th">Account</th><th scope="col" class="th num">Amount</th></tr>
      </thead>
      <tbody>
        <tr class="group-row"><th scope="colgroup" class="td" colspan="2">Revenue</th></tr>
        <% @statement[:revenue].each do |row| %>
          <tr>
            <td class="td"><%= link_to finance_account_label(row.account), finance_chart_of_account_path(row.account, from: @from, to: @to), class: "link" %></td>
            <td class="td num"><%= finance_money(row.balance) %></td>
          </tr>
        <% end %>
        <tr class="subtotal-row"><th scope="row" class="td">Total revenue</th><td class="td num"><%= finance_money(@statement[:total_revenue]) %></td></tr>
        <tr class="group-row"><th scope="colgroup" class="td" colspan="2">Expenses</th></tr>
        <% @statement[:expense].each do |row| %>
          <tr>
            <td class="td"><%= link_to finance_account_label(row.account), finance_chart_of_account_path(row.account, from: @from, to: @to), class: "link" %></td>
            <td class="td num"><%= finance_money(row.balance) %></td>
          </tr>
        <% end %>
        <tr class="subtotal-row"><th scope="row" class="td">Total expenses</th><td class="td num"><%= finance_money(@statement[:total_expense]) %></td></tr>
      </tbody>
      <tfoot>
        <tr><th scope="row" class="td">Net income</th><td class="td num"><%= finance_money(@statement[:net_income]) %></td></tr>
      </tfoot>
    </table>
  </div>

  <p class="entry-state" role="status">Net income = total revenue <%= finance_money(@statement[:total_revenue]) %> less total expenses <%= finance_money(@statement[:total_expense]) %>.</p>
</div>
