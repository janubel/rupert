<%= form_with model: expense, scope: :expense, url: (expense.persisted? ? finance_expense_path(expense) : finance_expenses_path), class: "mt-6 space-y-4" do |f| %>
  <%= render "shared/form_errors", model: expense %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :payee, "Payee", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.text_field :payee, class: "input", placeholder: "Who was paid", autocomplete: "off" %>
    </div>
    <div>
      <%= f.label :vendor_id, "Vendor (optional)", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.collection_select :vendor_id, @vendors, :id, :name, { include_blank: "—" }, class: "select w-full" %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :category, "Category", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.select :category, Finance::Expense::CATEGORIES.map { |c| [c.tr("_", " ").titleize, c] }, {}, class: "select w-full" %>
    </div>
    <div>
      <%= f.label :amount, "Amount (USD)", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <div class="flex items-center gap-1">
        <span class="text-sm text-mocha" aria-hidden="true">$</span>
        <%= f.text_field :amount, required: true, inputmode: "decimal", placeholder: "0.00", class: "input", aria: { describedby: "finance-amount-help" } %>
      </div>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :incurred_on, "Date", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.date_field :incurred_on, class: "select w-full" %>
    </div>
    <div>
      <%= f.label :method, "Method", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.select :method, Finance::Expense::METHODS, {}, class: "select w-full" %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :reference, "Reference", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.text_field :reference, class: "input", autocomplete: "off" %>
    </div>
    <div></div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :account_id, "GL account (optional)", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.collection_select :account_id, (@accounts || Finance::Account.active.ordered), :id, :label, { include_blank: "— auto from category —" }, class: "select w-full" %>
    </div>
    <div></div>
  </div>

  <div>
    <%= f.label :notes, "Notes", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
    <%= f.text_area :notes, rows: 3, class: "input retail-notes" %>
  </div>

  <p id="finance-amount-help" class="text-xs text-mocha">Enter dollars with up to two decimal places. This records an existing payment in Rupert; it does not transfer money.</p>
  <div class="flex flex-wrap items-center gap-3 pt-2">
    <%= f.submit expense.persisted? ? "Save changes" : "Record expense", class: "btn-primary" %>
    <%= link_to "Cancel", finance_expenses_path, class: "btn-ghost" %>
  </div>
<% end %>
