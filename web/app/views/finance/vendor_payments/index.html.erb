<% content_for :title, "Payments to vendors" %>
<div class="space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :money %>
  <%= render 'shared/operations_navigation', workspace: :finance %>
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Payments to vendors</h1>
      <p class="mt-1 text-sm text-mocha">Money out against vendor purchase orders (accounts payable), last <%= @range_days %> days.</p>
    </div>
    <% if Current.user.can?("finance.write") %>
      <%= link_to "Record payment", new_finance_vendor_payment_path, class: "btn-primary" %>
    <% end %>
  </section>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3">
    <div class="stat">
      <p class="stat-label">Recorded payments · USD</p>
      <p class="stat-value mt-1"><%= number_to_currency(@total_cents / 100.0) %></p>
      <p class="mt-1 text-xs text-taupe"><%= @entry_count %> active payments</p>
    </div>
  </section>

  <%= form_tag finance_vendor_payments_path, method: :get, class: "card card-pad operations-filters" do %>
    <%= select_tag :days, options_for_select([["Last 30 days", 30], ["Last 90 days", 90], ["Last year", 365]], @range_days), class: "select", aria: { label: "Date range" } %>
    <label class="flex items-center gap-1.5 text-sm text-mocha">
      <%= check_box_tag :include_deleted, "1", @include_deleted %> include removed history
    </label>
    <%= submit_tag "Filter", class: "btn-ghost btn-sm" %>
  <% end %>

  <p class="text-sm text-mocha"><%= @from %> through <%= @through %> · USD. Summary totals exclude removed records. <%= @removed_count %> removed entries included in this view. This register records existing payments; no money is transferred.</p>
  <div class="card overflow-hidden">
    <div class="operations-table-region" role="region" tabindex="0" aria-label="Finance record table">
      <table class="operations-table w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Vendor</th>
            <th scope="col" class="th">Method</th>
            <th scope="col" class="th text-right">Amount</th>
            <th scope="col" class="th"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @payments.empty? %>
            <tr><td colspan="5" class="empty-row">No payments in this range.</td></tr>
          <% end %>
          <% @payments.each do |payment| %>
            <tr class="hover:bg-cream <%= payment.discarded? ? "opacity-50" : "" %>">
              <td class="td whitespace-nowrap text-mocha"><%= l(payment.paid_on, format: :short) %></td>
              <td class="td font-medium text-ink"><%= retail_business_access?('purchasing.read') ? link_to(payment.vendor.name, payment.vendor, class: 'text-olive underline') : payment.vendor.name %></td>
              <td class="td text-mocha capitalize"><%= payment.method %></td>
              <td class="td text-right font-medium text-ink"><%= number_to_currency(payment.amount_cents / 100.0) %></td>
              <td class="td text-right">
                <% if payment.discarded? %><span class="pill-taupe">Removed</span><% end %>
                <% if Current.user.can?("finance.write") %>
                  <% if payment.discarded? %>
                    <%= button_to "Restore", restore_finance_vendor_payment_path(payment), method: :post, class: "text-xs font-semibold text-fern hover:underline" %>
                  <% else %>
                    <%= button_to "Delete", finance_vendor_payment_path(payment), method: :delete, class: "text-xs font-semibold text-rose hover:underline", data: { turbo_confirm: "Delete this payment?" } %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
