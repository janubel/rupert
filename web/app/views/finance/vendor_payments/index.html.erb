<% content_for :title, 'Vendor payments' %>
<% range_text = @month ? @from.strftime('%B %Y') : report_range_label(@from, @through) %>
<div class="space-y-6">
  <%= render layout: 'finance/page_header', locals: { title: 'Vendor payments', range: range_text, print: true,
        menu: [['Download CSV', finance_vendor_payments_path(request.query_parameters.merge(format: :csv)), { data: { turbo: false } }], ['Accounts', finance_accounts_path], ['By payee', finance_payees_path]],
        explain: 'Payments already made against vendor purchase orders (accounts payable). Adding one lowers what is owed to that vendor.' } do %>
    <% if @can_write %><%= link_to 'Add payment', new_finance_vendor_payment_path, class: 'btn-primary' %><% end %>
  <% end %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3" aria-label="Payment summary">
    <div class="stat">
      <div class="stat-label">Recorded payments<%= define('vendor_payment') %></div>
      <p class="stat-value mt-1"><%= finance_money(@total_cents) %></p>
      <p class="mt-1 text-xs text-taupe"><%= pluralize(@entry_count, 'active payment') %> in range<%= ', filtered' if @q.present? || @min_cents || @max_cents %></p>
    </div>
  </section>

  <section class="toolbar-band" aria-label="Payment filters">
    <%= form_tag finance_vendor_payments_path, method: :get, role: 'search', aria: { label: 'Filter payments' } do %>
      <div class="toolbar">
        <div class="toolbar-field"><%= label_tag :q, 'Vendor or reference', class: 'field-label' %><%= search_field_tag :q, @q, class: 'input', autocomplete: 'off' %></div>
        <div class="toolbar-field"><%= label_tag :month, 'Month (optional)', class: 'field-label' %><%= month_field_tag :month, @month, min: '2000-01', max: '2099-12', class: 'input' %></div>
        <div class="toolbar-field"><%= label_tag :from, 'From', class: 'field-label' %><%= date_field_tag :from, @from, class: 'input' %></div>
        <div class="toolbar-field"><%= label_tag :to, 'To', class: 'field-label' %><%= date_field_tag :to, @through, class: 'input' %></div>
        <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary', name: nil %><%= link_to 'Clear', finance_vendor_payments_path, class: 'btn-ghost' %></div>
      </div>
      <details class="explainer mt-3" <%= 'open' if params[:min].present? || params[:max].present? || @include_deleted %>>
        <summary class="explainer-summary">More filters</summary>
        <div class="toolbar mt-2">
          <div class="toolbar-field"><%= label_tag :min, 'Amount from', class: 'field-label' %><%= text_field_tag :min, params[:min], class: 'input money', inputmode: 'decimal', placeholder: '0.00' %></div>
          <div class="toolbar-field"><%= label_tag :max, 'Amount to', class: 'field-label' %><%= text_field_tag :max, params[:max], class: 'input money', inputmode: 'decimal', placeholder: '0.00' %></div>
          <%= hidden_field_tag :include_deleted, '0', id: nil %>
          <label class="flex items-center gap-1.5 pb-2 text-sm text-mocha"><%= check_box_tag :include_deleted, '1', @include_deleted, class: 'checkbox' %> Show removed payments</label>
        </div>
      </details>
    <% end %>
  </section>
  <% if @filter_problem %><p role="alert" class="flash flash-alert"><%= @filter_problem %></p><% end %>

  <div class="card">
    <div class="table-region" role="region" tabindex="0" aria-label="Vendor payment register">
      <table class="table finance-table">
        <caption class="sr-only">Vendor payments from <%= range_text %>, newest first, amounts in USD</caption>
        <thead>
          <tr>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Vendor</th>
            <th scope="col" class="th">Method</th>
            <th scope="col" class="th">Reference</th>
            <th scope="col" class="th num">Amount</th>
            <th scope="col" class="th">Status and history</th>
            <th scope="col" class="th no-print"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @payments.empty? %>
            <tr><td colspan="7" class="empty-row">No payments match. Widen the dates, clear the filters<%= ', or add a payment' if @can_write %>.</td></tr>
          <% end %>
          <% @payments.each do |payment| %>
            <% lock = finance_lock_in(@locks, payment.paid_on) %>
            <% history = finance_history(payment, @activity[payment.id.to_s]) %>
            <tr class="<%= 'row-removed' if payment.discarded? %>">
              <td class="td whitespace-nowrap"><%= l(payment.paid_on, format: :short) %></td>
              <td class="td font-medium text-ink"><%= retail_business_access?('purchasing.read') ? link_to(payment.vendor.name, payment.vendor, class: 'link') : payment.vendor.name %></td>
              <td class="td capitalize"><%= payment.method.to_s.tr('_', ' ') %></td>
              <td class="td"><%= payment.reference.presence || '—' %></td>
              <td class="td num <%= 'line-through' if payment.discarded? %>"><%= finance_money(payment.amount_cents) %></td>
              <td class="td">
                <% if payment.discarded? %><span class="pill-rose status-removed">Removed</span><% else %><span class="pill-fern status-active">Active</span><% end %>
                <% if lock %><span class="pill-clay status-locked" title="<%= PeriodLock.locked_message(lock) %>">Locked · <%= lock.label %></span><% end %>
                <details class="mt-1"><summary class="cursor-pointer text-xs text-mocha"><%= history.last %></summary>
                  <ul class="mt-1 text-xs text-mocha"><% history.each do |line| %><li><%= line %></li><% end %></ul></details>
              </td>
              <td class="td no-print whitespace-nowrap text-right">
                <% if @can_write %>
                  <% if lock %><span class="text-xs text-mocha">Read-only: period locked</span>
                  <% elsif payment.discarded? %>
                    <%= button_to 'Restore', restore_finance_vendor_payment_path(payment), method: :post, class: 'btn-ghost btn-sm' %>
                  <% else %>
                    <%= button_to 'Remove', finance_vendor_payment_path(payment), method: :delete, class: 'btn-ghost btn-sm text-rose',
                          form: { class: 'inline', data: { turbo_confirm: finance_remove_confirm('payment', payment.amount_cents, payment.vendor.name, payment.paid_on, ledger: false) } },
                          aria: { label: "Remove payment to #{payment.vendor.name} #{finance_money_text(payment.amount_cents)}" } %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="font-semibold">
            <th scope="row" class="td" colspan="4">Total of active payments in range (all pages)</th>
            <td class="td num"><%= finance_money(@total_cents) %></td>
            <td class="td" colspan="2"><%= pluralize(@entry_count, 'payment') %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <p class="text-xs text-mocha">Totals count active payments only. <%= pluralize(@removed_count, 'removed payment') %> in the list. This register records payments that already happened; no money is transferred.</p>
  <%== @pagy.series_nav if @pagy.pages > 1 %>
</div>
