<% content_for :title, "Payments to vendors" %>
<% range_text = "#{@from} through #{@through}" %>
<div class="space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :money %>

  <%= render layout: 'finance/page_header', locals: { title: 'Payments to vendors', range: range_text, print: true,
        explain: 'Payments already made against vendor purchase orders (accounts payable). Recording one lowers what is owed to that vendor.' } do %>
    <%= link_to "Export CSV", finance_vendor_payments_path(request.query_parameters.merge(format: :csv)), class: "btn-ghost btn-sm", data: { turbo: false } %>
    <% if @can_write %><%= link_to "Record payment", new_finance_vendor_payment_path, class: "btn-primary" %><% end %>
  <% end %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3" aria-label="Payment summary">
    <div class="stat">
      <p class="stat-label">Recorded payments · USD</p>
      <p class="stat-value mt-1"><%= finance_money(@total_cents) %></p>
      <p class="mt-1 text-sm text-mocha"><%= pluralize(@entry_count, 'active payment') %> in range<%= ', filtered' if @q.present? || @min_cents || @max_cents %></p>
    </div>
  </section>

  <%= form_tag finance_vendor_payments_path, method: :get, class: "card card-pad operations-filters", role: "search", aria: { label: "Filter payments" } do %>
    <div><%= label_tag :q, "Vendor or reference", class: "field-label" %><%= search_field_tag :q, @q, class: "input", autocomplete: "off" %></div>
    <div><%= label_tag :from, "From", class: "field-label" %><%= date_field_tag :from, @from, class: "select w-full" %></div>
    <div><%= label_tag :to, "To", class: "field-label" %><%= date_field_tag :to, @through, class: "select w-full" %></div>
    <div><%= label_tag :min, "Amount from (USD)", class: "field-label" %><%= text_field_tag :min, params[:min], class: "input money", inputmode: "decimal", placeholder: "0.00" %></div>
    <div><%= label_tag :max, "Amount to (USD)", class: "field-label" %><%= text_field_tag :max, params[:max], class: "input money", inputmode: "decimal", placeholder: "0.00" %></div>
    <%= hidden_field_tag :include_deleted, "0", id: nil %>
    <label class="flex items-center gap-1.5 text-base text-mocha"><%= check_box_tag :include_deleted, "1", @include_deleted %> Show removed payments</label>
    <%= submit_tag "Apply filters", class: "btn-primary btn-sm" %>
    <%= link_to "Clear", finance_vendor_payments_path, class: "btn-ghost btn-sm" %>
  <% end %>
  <% if @filter_problem %><p role="alert" class="flash flash-alert"><%= @filter_problem %></p><% end %>

  <p class="text-base text-mocha">Totals count active payments only. <%= pluralize(@removed_count, 'removed payment') %> in the list. This register records payments that already happened; no money is transferred.</p>
  <div class="card overflow-hidden">
    <div class="operations-table-region" role="region" tabindex="0" aria-label="Vendor payment register">
      <table class="operations-table finance-table w-full">
        <caption class="sr-only">Vendor payments from <%= range_text %>, newest first, amounts in USD</caption>
        <thead>
          <tr>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Vendor</th>
            <th scope="col" class="th">Method</th>
            <th scope="col" class="th">Reference</th>
            <th scope="col" class="th num">Amount</th>
            <th scope="col" class="th">Status and history</th>
            <th scope="col" class="th no-print"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @payments.empty? %>
            <tr><td colspan="7" class="empty-row">No payments match. Widen the dates, clear the filters<%= ', or record a payment' if @can_write %>.</td></tr>
          <% end %>
          <% @payments.each do |payment| %>
            <% lock = finance_lock_in(@locks, payment.paid_on) %>
            <% history = finance_history(payment, @activity[payment.id.to_s]) %>
            <tr class="<%= 'row-removed' if payment.discarded? %>">
              <td class="td whitespace-nowrap"><%= l(payment.paid_on, format: :short) %></td>
              <td class="td font-medium"><%= retail_business_access?('purchasing.read') ? link_to(payment.vendor.name, payment.vendor, class: 'link') : payment.vendor.name %></td>
              <td class="td capitalize"><%= payment.method.to_s.tr('_', ' ') %></td>
              <td class="td"><%= payment.reference.presence || '—' %></td>
              <td class="td num <%= 'line-through' if payment.discarded? %>"><%= finance_money(payment.amount_cents) %></td>
              <td class="td">
                <% if payment.discarded? %><span class="status-tag status-removed">Removed</span><% else %><span class="status-tag status-active">Active</span><% end %>
                <% if lock %><span class="status-tag status-locked" title="<%= PeriodLock.locked_message(lock) %>">Locked · <%= lock.label %></span><% end %>
                <details class="mt-1"><summary class="text-sm text-mocha cursor-pointer"><%= history.last %></summary>
                  <ul class="text-sm text-mocha mt-1"><% history.each do |line| %><li><%= line %></li><% end %></ul></details>
              </td>
              <td class="td no-print whitespace-nowrap">
                <% if @can_write %>
                  <% if lock %><span class="text-sm text-mocha">Read-only: period locked</span>
                  <% elsif payment.discarded? %>
                    <%= button_to "Restore", restore_finance_vendor_payment_path(payment), method: :post, class: "row-action text-fern" %>
                  <% else %>
                    <%= button_to "Remove", finance_vendor_payment_path(payment), method: :delete, class: "row-action text-rose",
                          form: { data: { turbo_confirm: finance_remove_confirm('payment', payment.amount_cents, payment.vendor.name, payment.paid_on, ledger: false) } },
                          aria: { label: "Remove payment to #{payment.vendor.name} #{finance_money_text(payment.amount_cents)}" } %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" class="td" colspan="4">Total of active payments in range (all pages)</th>
            <td class="td num"><%= finance_money(@total_cents) %></td>
            <td class="td" colspan="2"><%= pluralize(@entry_count, 'payment') %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
