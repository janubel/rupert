<section id="cash-flow-events" class="card card-pad">
  <%= section_heading 'Latest money events', hint: 'Sales, bank lines, expenses and vendor payments, newest first.' %>
  <% events = report.recent_events %>
  <% if events.empty? %>
    <%= empty_state 'Nothing recorded yet', hint: 'Sales appear after a sync; bank lines after a statement import.' %>
  <% else %>
    <ol class="divide-y divide-fog">
      <% events.each do |event| %>
        <li class="flex items-center gap-3 py-2 text-sm" data-event-kind="<%= event[:kind] %>">
          <span class="cash-flow-event-icon cash-flow-event-<%= event[:kind] %>" role="img" aria-label="<%= cash_flow_event_kind_label(event[:kind]) %>"><%= cash_flow_event_icon(event[:kind]) %></span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-ink"><% if (path = cash_flow_event_path(event)) %><%= link_to event[:label], path, class: 'hover:underline' %><% else %><%= event[:label] %><% end %></p>
            <p class="truncate text-xs text-taupe"><%= event[:detail] %> · <%= time_ago_in_words(event[:at]) %> ago</p>
          </div>
          <%= finance_money(event[:cents]) %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
