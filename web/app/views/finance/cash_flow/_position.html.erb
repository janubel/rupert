<aside id="cash-flow-position" class="card card-pad cash-flow-position">
  <%= section_heading 'Where cash stands' %>
  <% balance = report.statement_balance %>
  <div>
    <p class="stat-label">Last verified bank balance<%= define('statement_balance') %></p>
    <% if balance %>
      <p class="stat-value mt-1" title="<%= finance_money_text(balance[:cents], currency: balance[:currency]) %>"><%= cash_flow_compact(balance[:cents], currency: balance[:currency]) %></p>
      <p class="mt-1 text-xs text-taupe">As of <%= balance[:date].strftime('%b %-d, %Y') %>, from the retained statement.</p>
    <% else %>
      <p class="stat-value-sm mt-1">Unavailable</p>
      <p class="mt-1 text-xs text-taupe">Upload a bank statement with a closing balance to see it here. Unavailable is not zero.</p>
    <% end %>
  </div>
  <dl class="grid grid-cols-2 gap-3 text-sm">
    <div class="rounded-card bg-haze px-4 py-3">
      <dt class="stat-label">Average per day</dt>
      <dd class="mt-1 font-display text-xl <%= report.average_daily_net_cents.negative? ? 'money-negative' : 'text-ink' %>"><%= finance_money_text(report.average_daily_net_cents) %></dd>
      <dd class="text-xs text-taupe">net, over <%= report.span_days %> days</dd>
    </div>
    <div class="rounded-card bg-haze px-4 py-3">
      <dt class="stat-label">At this pace</dt>
      <dd class="mt-1 font-display text-xl text-ink"><%= cash_flow_runway_text(report) %></dd>
      <dd class="text-xs text-taupe">
        <% if report.runway_days %>until the verified balance reaches zero
        <% elsif report.average_daily_net_cents.negative? %>cash is leaving; no verified balance to count down from
        <% else %>more came in than went out<% end %>
      </dd>
    </div>
  </dl>
  <% forecast = report.latest_forecast %>
  <p class="text-sm text-mocha">
    <% if forecast %>Last cash forecast scenario: <%= link_to "##{forecast.id}, #{forecast.created_at.strftime('%b %-d')}", cash_forecast_path(prefill: forecast.id), class: 'link' %>.<% else %>No cash forecast scenario retained yet.<% end %>
    <%= link_to 'Plan the next 8 weeks', cash_forecast_path, class: 'link' %>.
  </p>
</aside>
