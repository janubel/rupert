<aside id="cash-flow-deposits" class="card card-pad">
  <%= section_heading 'From sale to bank', hint: 'Card sales reach the bank later as processor payouts, net of fees.' %>
  <% d = { sales: report.sales_cents, refunds: report.refunds_cents, deposits: report.processor_deposits_cents } %>
  <% gap = d[:sales] - d[:refunds] - d[:deposits] %>
  <ol class="cash-flow-flow">
    <li><span class="cash-flow-flow-label">Sales taken</span><span class="money"><%= finance_money_text(d[:sales]) %></span></li>
    <li><span class="cash-flow-flow-label">Refunds given</span><span class="money"><%= finance_money_text(-d[:refunds]) %></span></li>
    <li><span class="cash-flow-flow-label">Processor payouts into the bank</span><span class="money"><%= finance_money_text(d[:deposits]) %></span></li>
    <li class="cash-flow-flow-total"><span class="cash-flow-flow-label">Not yet in the bank, or fees, cash and timing</span><span class="money <%= 'money-negative' if gap.negative? %>"><%= finance_money_text(gap) %></span></li>
  </ol>
  <p class="text-xs text-taupe">Payouts count only statement lines reviewed as "Processor payout"<% if report.pending_count.positive? %>; <%= report.pending_count %> lines are still undecided<% end %>. <%= link_to 'Review bank lines', bank_statements_path, class: 'underline' %>.</p>
</aside>
