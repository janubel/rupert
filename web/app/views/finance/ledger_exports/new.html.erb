<% content_for :title, "Export ledger" %>
<div class="space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :money %>

  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Export ledger</h1>
      <p class="mt-1 text-sm text-mocha">Download posted journal entries for your accountant or accounting software.</p>
    </div>
    <%= link_to "All reports", finance_reports_path, class: "btn-ghost btn-sm" %>
  </section>

  <%= form_with url: finance_ledger_export_path, method: :post, class: "card card-pad space-y-4" do |f| %>
    <div class="grid gap-4 sm:grid-cols-3">
      <div>
        <%= label_tag :from, "From", class: "mb-1 block text-sm font-semibold uppercase tracking-wide text-mocha" %>
        <%= date_field_tag :from, @from, class: "select w-full" %>
      </div>
      <div>
        <%= label_tag :to, "To", class: "mb-1 block text-sm font-semibold uppercase tracking-wide text-mocha" %>
        <%= date_field_tag :to, @to, class: "select w-full" %>
      </div>
      <div>
        <%= label_tag :format, "Format", class: "mb-1 block text-sm font-semibold uppercase tracking-wide text-mocha" %>
        <%= select_tag :format, options_from_collection_for_select(Finance::LedgerExport::FORMATS, :key, :label, @format), class: "select w-full" %>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <%= submit_tag "Download", class: "btn-primary" %>
    </div>
  <% end %>

  <div class="text-sm text-mocha">
    Exports only posted entries in the chosen range; voided entries are excluded.<%= define('void_entry') %> QuickBooks IIF imports as a general journal; the CSV lists debits and credits per line for Xero, Wave, Sage and similar.<%= define('debit_credit') %>
  </div>
</div>
