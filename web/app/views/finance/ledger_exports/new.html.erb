<% content_for :title, 'Download ledger' %>
<div class="page-narrow space-y-6">
  <%= page_header 'Download ledger', subtitle: 'Posted journal entries for your accountant or accounting software.', menu: [['Financial statements', finance_reports_path], ['General ledger', finance_journal_entries_path]] %>

  <%= form_with url: finance_ledger_export_path, method: :post, class: 'card card-pad space-y-4' do |f| %>
    <fieldset class="space-y-4">
      <legend class="card-title">Dates and format</legend>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= label_tag :from, 'From', class: 'field-label' %>
          <%= date_field_tag :from, @from, class: 'input' %>
        </div>
        <div>
          <%= label_tag :to, 'To', class: 'field-label' %>
          <%= date_field_tag :to, @to, class: 'input' %>
        </div>
      </div>
      <div>
        <%= label_tag :format, 'Format', class: 'field-label' %>
        <%= select_tag :format, options_from_collection_for_select(Finance::LedgerExport::FORMATS, :key, :label, @format), class: 'select w-full' %>
      </div>
    </fieldset>
    <div class="form-actions">
      <%= submit_tag 'Download', class: 'btn-primary', name: nil %>
      <%= link_to 'Cancel', finance_journal_entries_path, class: 'btn-ghost' %>
    </div>
  <% end %>

  <div class="text-sm text-mocha">
    Only posted entries in the chosen range are included; voided entries are left out.<%= define('void_entry') %> QuickBooks IIF imports as a general journal; the CSV lists debits and credits per line for Xero, Wave, Sage and similar.<%= define('debit_credit') %>
  </div>
</div>
