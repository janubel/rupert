<%# Thin wrapper around page_header for Money pages: the dates line is the subtitle (a currency is named only
    when it is not US dollars), the one-sentence explanation sits under the header (folded past its lead sentence),
    and Print joins the More menu.
    Usage: render layout: 'finance/page_header', locals: { title:, range:, explain:, currency: 'USD', print: false, menu: [...] } do ... actions ... end %>
<% currency = local_assigns.fetch(:currency, 'USD') %>
<% meta = [local_assigns[:range].presence, (currency.presence unless currency == 'USD')].compact.join(' · ') %>
<% menu = Array(local_assigns[:menu]).compact %>
<% menu += [['Print', '#', { data: { controller: 'print', action: 'click->print#print:prevent' } }]] if local_assigns[:print] %>
<%= page_header(title, subtitle: meta.presence, menu: menu.presence) do %>
  <%= yield %>
<% end %>
<% if local_assigns[:explain].present? %><%= fold_explainer(local_assigns[:explain], class: 'text-sm text-mocha') %><% end %>
