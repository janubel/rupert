<div class="page-narrow">
  <%= page_header 'Payer details', subtitle: 'The business filing the 1099s. This prints on every form.' %>
  <div class="card card-pad">
    <%= form_with model: @payer, scope: :tax_payer, url: payer_finance_tax_payees_path, method: :patch, class: 'space-y-4' do |f| %>
      <%= render 'shared/form_errors', model: @payer %>
      <div><%= f.label :name, 'Legal business name', class: 'field-label' %><%= f.text_field :name, class: 'input', autocomplete: 'organization', required: true %></div>
      <div><%= f.label :street, 'Street address', class: 'field-label' %><%= f.text_field :street, class: 'input', autocomplete: 'street-address', required: true %></div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div><%= f.label :city, 'City', class: 'field-label' %><%= f.text_field :city, class: 'input', required: true %></div>
        <div><%= f.label :state, 'State', class: 'field-label' %><%= f.text_field :state, class: 'input', maxlength: 2, placeholder: 'NY', required: true %></div>
        <div><%= f.label :zip, 'ZIP', class: 'field-label' %><%= f.text_field :zip, class: 'input', inputmode: 'numeric', required: true %></div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><%= f.label :phone, 'Phone', class: 'field-label' %><%= f.telephone_field :phone, class: 'input' %></div>
        <div>
          <%= f.label :tin, 'EIN', class: 'field-label' %>
          <%= f.password_field :tin, value: '', class: 'input', autocomplete: 'off', inputmode: 'numeric', placeholder: (@payer.masked_tin ? "On file: #{@payer.masked_tin}. Leave blank to keep it." : '9 digits') %>
        </div>
      </div>
      <div class="form-actions"><%= f.submit 'Save', class: 'btn-primary', data: { turbo_submits_with: 'Saving…' } %><%= link_to 'Cancel', finance_tax_payees_path, class: 'btn-ghost' %></div>
    <% end %>
  </div>
</div>
