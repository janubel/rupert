<%= form_with model: payee, url: (payee.persisted? ? finance_tax_payee_path(payee) : finance_tax_payees_path), scope: :tax_payee, class: 'space-y-4' do |f| %>
  <%= render 'shared/form_errors', model: payee %>
  <fieldset class="space-y-4">
    <legend class="card-title">Payee</legend>
    <% if payee.persisted? %>
      <p class="text-sm text-mocha">Paid as <strong><%= payee.payee_label %></strong></p>
    <% else %>
      <div>
        <%= f.label :payee_key, 'Paid as', class: 'field-label' %>
        <%= f.select :payee_key, grouped_options_for_select(choices, payee.payee_key), { include_blank: 'Choose who you pay' }, class: 'select', required: true %>
      </div>
    <% end %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :legal_name, 'Legal name (W-9 line 1)', class: 'field-label' %><%= f.text_field :legal_name, class: 'input', autocomplete: 'off', required: true %></div>
      <div><%= f.label :business_name, 'Business name (W-9 line 2)', class: 'field-label' %><%= f.text_field :business_name, class: 'input', autocomplete: 'off' %></div>
    </div>
    <div><%= f.label :tax_classification, 'Tax classification', class: 'field-label' %><%= f.select :tax_classification, Finance::TaxPayee::CLASSIFICATIONS.invert, {}, class: 'select' %></div>
  </fieldset>
  <fieldset class="space-y-4">
    <legend class="card-title">1099</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :form_type, 'Form', class: 'field-label' %><%= f.select :form_type, Finance::TaxPayee::FORMS.invert, {}, class: 'select' %></div>
      <div><%= f.label :misc_box, '1099-MISC box', class: 'field-label' %><%= f.select :misc_box, Finance::TaxPayee::MISC_BOXES.invert, { include_blank: 'Only for 1099-MISC' }, class: 'select' %></div>
    </div>
  </fieldset>
  <fieldset class="space-y-4">
    <legend class="card-title">W-9</legend>
    <div class="grid gap-4 sm:grid-cols-3">
      <div><%= f.label :tin_type, 'TIN type', class: 'field-label' %><%= f.select :tin_type, Finance::TaxPayee::TIN_TYPES.invert, { include_blank: '—' }, class: 'select' %></div>
      <div class="sm:col-span-2">
        <%= f.label :tin, 'TIN', class: 'field-label' %>
        <%= f.password_field :tin, value: '', class: 'input', autocomplete: 'off', inputmode: 'numeric', placeholder: (payee.masked_tin ? "On file: #{payee.masked_tin}. Leave blank to keep it." : '9 digits') %>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :address_line1, 'Address', class: 'field-label' %><%= f.text_field :address_line1, class: 'input', autocomplete: 'off' %></div>
      <div><%= f.label :address_line2, 'Address line 2', class: 'field-label' %><%= f.text_field :address_line2, class: 'input', autocomplete: 'off' %></div>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <div><%= f.label :city, 'City', class: 'field-label' %><%= f.text_field :city, class: 'input', autocomplete: 'off' %></div>
      <div><%= f.label :state, 'State', class: 'field-label' %><%= f.text_field :state, class: 'input', autocomplete: 'off', maxlength: 2, placeholder: 'NY' %></div>
      <div><%= f.label :postal_code, 'ZIP', class: 'field-label' %><%= f.text_field :postal_code, class: 'input', autocomplete: 'off', inputmode: 'numeric' %></div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :w9_received_on, 'W-9 received', class: 'field-label' %><%= f.date_field :w9_received_on, class: 'input' %></div>
    </div>
    <div><%= f.label :notes, 'Notes', class: 'field-label' %><%= f.text_area :notes, rows: 2, class: 'input' %></div>
  </fieldset>
  <div class="form-actions"><%= f.submit 'Save', class: 'btn-primary', data: { turbo_submits_with: 'Saving…' } %><%= link_to 'Cancel', finance_tax_payees_path, class: 'btn-ghost' %></div>
<% end %>
