<%# The Next thing to do bar (NextThingsController#show). Its buttons only redraw this frame; Open goes to the page. %>
<turbo-frame id="next_thing">
  <% item = @current %>
  <% if @ops %>
    <section class="next-bar next-bar-ops" aria-label="Ops mode">
      <span class="next-bar-label">⚑ Ops mode<% if item %> · <%= @position %> of <%= @items.size %><% end %></span>
      <% if item %>
        <span class="<%= item[:level] == 'fix' ? 'pill-rose' : 'pill-clay' %>"><%= item[:level] == 'fix' ? 'Fix' : 'Watch' %></span>
        <span class="next-bar-text"><strong><%= item[:title] %></strong><% if item[:detail] %> <span class="next-bar-detail"><%= item[:detail] %></span><% end %></span>
        <span class="next-bar-actions">
          <%= link_to 'Open', item[:path], class: 'btn-primary btn-sm', data: { turbo_frame: '_top' } %>
          <%= button_to 'Done', done_next_thing_path, params: { key: item[:key] }, class: 'btn-ghost btn-sm', form_class: 'contents' %>
          <%= button_to 'Snooze 1 h', snooze_next_thing_path, params: { key: item[:key] }, class: 'btn-ghost btn-sm', form_class: 'contents' %>
          <% if @items.size > 1 %><%= button_to 'Skip', skip_next_thing_path, params: { key: item[:key] }, class: 'btn-ghost btn-sm', form_class: 'contents' %><% end %>
          <%= button_to 'Exit ops mode', mode_next_thing_path, params: { ops: 0 }, class: 'btn-ghost btn-sm', form_class: 'contents' %>
        </span>
      <% else %>
        <span class="next-bar-text">All clear. Nothing needs you right now.</span>
        <span class="next-bar-actions"><%= button_to 'Exit ops mode', mode_next_thing_path, params: { ops: 0 }, class: 'btn-ghost btn-sm', form_class: 'contents' %></span>
      <% end %>
    </section>
  <% elsif item %>
    <section class="next-bar" aria-label="Next thing to do">
      <span class="next-bar-label">Next</span>
      <span class="<%= item[:level] == 'fix' ? 'pill-rose' : 'pill-clay' %>"><%= item[:level] == 'fix' ? 'Fix' : 'Watch' %></span>
      <span class="next-bar-text"><%= link_to item[:title], item[:path], class: 'next-bar-link', data: { turbo_frame: '_top' } %><% if item[:detail] %> <span class="next-bar-detail"><%= item[:detail] %></span><% end %></span>
      <span class="next-bar-actions">
        <%= button_to 'Done', done_next_thing_path, params: { key: item[:key] }, class: 'btn-ghost btn-sm', form_class: 'contents' %>
        <%= button_to 'Snooze 1 h', snooze_next_thing_path, params: { key: item[:key] }, class: 'btn-ghost btn-sm', form_class: 'contents' %>
        <%= button_to(@items.size > 1 ? "Start ops mode · #{@items.size}" : 'Start ops mode', mode_next_thing_path, params: { ops: 1 }, class: 'btn-ghost btn-sm', form_class: 'contents') %>
      </span>
    </section>
  <% end %>
</turbo-frame>
