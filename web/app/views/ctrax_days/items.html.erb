<% scope_label = @days.one? ? @days.first.location.name : 'All stores' %>
<% content_for :title, "C-Trax items sold · #{@date}" %>
<% menu = [['Daily close for this date', ctrax_days_path(date: @date)]] %>
<% menu << ['Open store close', ctrax_day_path(@days.first)] if @days.one? %>
<div class="space-y-6">
  <%= page_header "Items sold · #{scope_label}", subtitle: "Built from stored C-Trax receipts for #{@date.strftime('%b %-d, %Y')}#{" across #{pluralize(@days.size, 'store')}" if @days.many?}; read-only, nothing is sent to C-Trax, Shopify or Square and no catalog item is created.", menu: menu %>
  <% if @days.empty? %>
    <section class="card">
      <%= empty_state 'No stored sales for this date', hint: 'Sync this business date on the daily close page first. Missing imports do not mean zero sales.' do %>
        <%= link_to 'Open daily close', ctrax_days_path(date: @date), class: 'btn-ghost' %>
      <% end %>
    </section>
  <% else %>
    <% if @days.many? || params[:location_id].present? %>
      <%= page_tabs([['All stores', items_ctrax_days_path(date: @date), params[:location_id].blank?]] + CtraxDay.includes(:location).where(business_date: @date).order(:location_id).map { |day| [day.location.name, items_ctrax_days_path(date: @date, location_id: day.location_id), params[:location_id].to_s == day.location_id.to_s] }, label: 'Stores') %>
    <% end %>
    <%= render 'items', items: @items, date: @date, location_id: (@days.first.location_id if @days.one? && params[:location_id].present?) %>
  <% end %>
</div>
