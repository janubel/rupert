<% scope_label = @days.one? ? @days.first.location.name : 'All stores' %>
<% content_for :title, "C-Trax items sold · #{@date}" %>
<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div><p class="eyebrow text-olive-deep">C-Trax daily close · <%= @date.strftime('%b %-d, %Y') %></p><h1 class="page-title mt-2">Items sold · <%= scope_label %></h1><p class="mt-2 max-w-3xl text-sm text-mocha">Built from stored C-Trax receipts for this business date<%= " across #{pluralize(@days.size, 'store')}" if @days.many? %>. Read-only: nothing is sent to C-Trax, Shopify or Square, and no catalog item is created.</p></div>
    <div class="flex flex-wrap gap-2"><%= link_to 'Daily close', ctrax_days_path(date: @date), class: 'btn-ghost' %><% if @days.one? %><%= link_to 'Store close', ctrax_day_path(@days.first), class: 'btn-ghost' %><%= link_to 'All stores', items_ctrax_days_path(date: @date), class: 'btn-ghost' %><% end %></div>
  </header>
  <% if @days.empty? %>
    <section class="card card-pad space-y-3"><h2 class="font-display text-xl">No stored sales for this date</h2><p class="text-sm text-mocha">Pull this business date on the daily close page first. Missing imports do not mean zero sales.</p></section>
  <% else %>
    <% if @days.many? %><nav aria-label="Stores" class="flex flex-wrap gap-2"><% @days.each do |day| %><%= link_to day.location.name, items_ctrax_days_path(date: @date, location_id: day.location_id), class: 'btn-ghost btn-sm' %><% end %></nav><% end %>
    <%= render 'items', items: @items, date: @date, location_id: (@days.first.location_id if @days.one? && params[:location_id].present?) %>
  <% end %>
</div>
