<% content_for :title, "C-Trax · #{@day.business_date}" %>
<div class="space-y-6">
  <header class="flex flex-wrap justify-between gap-4"><div><h1 class="page-title"><%= @day.location.name %> · <%= @day.business_date %></h1><p class="mt-2 text-sm text-mocha"><%= @day.timezone %> · <%= @day.currency %> · source read <%= l @day.captured_at, format: :short %></p></div><div class="flex gap-2"><%= link_to 'Other days', ctrax_days_path(date: @day.business_date), class: 'btn-ghost' %><%= link_to 'Download checks', ctrax_day_path(@day, format: :csv), class: 'btn-ghost' %></div></header>
  <section class="card card-pad space-y-3"><h2 class="font-display text-xl"><%= @reconciliation.matched? ? 'Daily source controls match' : 'Daily source controls need review' %></h2><p class="text-sm text-mocha">Order detail and C-Trax’s independent report are compared below. Processor fees, settlement and bank deposits are separate.</p><% @reconciliation.warnings.each do |warning| %><p class="text-sm text-clay"><%= warning %></p><% end %><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr><th class="p-2 text-left">Check</th><th class="p-2 text-right">Order detail</th><th class="p-2 text-right">Source report</th><th class="p-2 text-right">Difference</th></tr></thead><tbody><% @reconciliation.checks.each do |check| %><tr class="border-t border-fog"><td class="p-2"><%= check[:label] %></td><% %i[actual expected delta].each do |key| %><td class="p-2 text-right"><%= check[:monetary] ? ctrax_money(check[key]) : (check[key].nil? ? 'Unknown' : check[key]) %></td><% end %></tr><% end %></tbody></table></div></section>
  <section class="card card-pad space-y-3"><h2 class="font-display text-xl">Register cash</h2><p class="text-sm text-mocha">Expected closing cash is calculated only for a complete session within this day, known cash movements and no unresolved cash refunds. Cross-day and open sessions remain unverified.</p><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr><% ['Register / session', 'Opened / closed', 'Opening', 'Day cash sales', 'Cash drops', 'Expected close', 'Source counted close', 'Variance'].each do |label| %><th class="p-2 text-left"><%= label %></th><% end %></tr></thead><tbody><% @reconciliation.session_rows.each do |session| %><tr class="border-t border-fog"><td class="p-2"><%= session['register_name'] %> #<%= session['id'] %></td><td class="p-2 text-xs"><%= session['opened_at'] %><br><%= session['closed_at'].presence || 'Still open' %></td><% %w[opening_cash day_cash drop_total expected_cash closing_cash variance].each do |key| %><td class="p-2"><%= ctrax_money(session[key]) %></td><% end %></tr><% end %></tbody></table></div></section>
  <section class="card card-pad space-y-3"><h2 class="font-display text-xl">Sales journal</h2><p class="text-xs text-taupe">Native order/payment/line IDs are retained. Base tender, actual tips and surcharges stay separate. No cardholder or card-account details are imported.</p><% @day.orders.each do |order| %><details class="rounded-xl border border-fog p-3"><summary class="cursor-pointer text-sm font-medium">Receipt <%= order['receipt'] %> · order #<%= order['id'] %> · <%= order['status'] %> · <%= ctrax_money(order['total']) %><span class="ml-3 text-xs text-taupe"><%= order['completed_at'] %> · session #<%= order['register_session_id'] %></span></summary><div class="mt-3 grid gap-4 md:grid-cols-2"><div><h3 class="text-sm font-semibold">Products</h3><% order['lines'].each do |line| %><p class="mt-1 text-sm"><%= line['name'] %> · <%= line['variant_name'] %> · <%= ctrax_money(line['price']) %><span class="ml-1 text-xs text-taupe">line #<%= line['id'] %></span></p><% end %></div><div><h3 class="text-sm font-semibold">Tender records</h3><% order['payments'].each do |payment| %><p class="mt-1 text-sm">#<%= payment['id'] %> <%= payment['type'] %> · <%= payment['status'] %> · base <%= ctrax_money(payment['amount']) %> · tip <%= ctrax_money(payment['tip_amount']) %> · surcharge <%= ctrax_money(payment['surcharge_amount']) %></p><% end %></div></div></details><% end %></section>
  <% if Current.user.can?('sales.write') %><section class="card card-pad space-y-3"><h2 class="font-display text-xl">Record a local review</h2><p class="text-sm"><%= @day.reviewed? ? 'This source version has been reviewed.' : 'This source version has not been reviewed.' %> A changed import requires a new review.</p><%= form_tag review_ctrax_day_path(@day), method: :post, class: 'space-y-3' do %><%= hidden_field_tag :source_digest, @day.source_digest %><%= label_tag :note, 'Review note / unresolved differences', class: 'block text-sm' %><%= text_area_tag :note, @day.review_note, maxlength: 1000, class: 'input w-full' %><%= submit_tag 'Record review', class: 'btn-primary' %><% end %></section><% end %>
</div>
