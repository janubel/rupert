<% content_for :title, "C-Trax daily close · #{@day.business_date}" %>
<% money = ->(value) { ctrax_money(value, currency: @day.currency) } %>
<div class="space-y-6">
  <%= render 'shared/retail_navigation' %>
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div><p class="eyebrow text-olive-deep">C-Trax daily close · <%= @day.business_date.strftime('%b %-d, %Y') %></p><h1 class="page-title mt-2"><%= @day.location.name %></h1><p class="mt-2 text-sm text-mocha"><%= @day.timezone %> · <%= @day.currency %> · Last pulled <time datetime="<%= @day.captured_at.iso8601 %>"><%= retail_source_time(@day.captured_at) %></time></p></div>
    <div class="flex flex-wrap gap-2"><%= link_to 'Other days', ctrax_days_path(date: @day.business_date), class: 'btn-ghost' %><%= link_to 'Download checks', ctrax_day_path(@day, format: :csv), class: 'btn-ghost' %></div>
  </header>
  <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Daily sales summary">
    <% [['Recorded sales', @reconciliation.sum(@reconciliation.orders, 'total')], ['Tax included', @reconciliation.sum(@reconciliation.orders, 'tax')], ['Tips · separate', @reconciliation.sum(@reconciliation.orders, 'tip')]].each do |label, value| %><div class="stat"><p class="stat-label"><%= label %></p><p class="stat-value mt-2"><%= money.call(value) %></p></div><% end %>
    <div class="stat"><p class="stat-label">Completed orders</p><p class="stat-value mt-2"><%= @reconciliation.orders.size %></p><p class="mt-1 text-xs text-mocha">Source detail only</p></div>
  </section>
  <nav aria-label="Daily close sections" class="flex flex-wrap gap-2"><a href="#close-controls" class="btn-ghost btn-sm">1 · Source checks</a><a href="#close-registers" class="btn-ghost btn-sm">2 · Register cash</a><a href="#close-orders" class="btn-ghost btn-sm">Sales journal</a><% if retail_business_access?('sales.write') %><a href="#close-review" class="btn-ghost btn-sm">3 · Local review</a><% end %></nav>
  <section id="close-controls" class="retail-anchor card card-pad space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-2"><h2 class="font-display text-xl">Source checks</h2><span class="<%= @reconciliation.matched? ? 'pill-fern' : 'pill-clay' %>"><%= @reconciliation.matched? ? 'Controls match' : 'Needs review' %></span></div>
    <p class="text-sm text-mocha">Order detail is compared with C-Trax’s independent report. Tender receipts, tips, processor fees, and bank deposits are separate evidence; do not add them to sales again.</p>
    <% if @reconciliation.warnings.any? %><div class="rounded-xl border border-clay/30 bg-clay/10 p-3 text-sm"><p class="font-semibold">Review these differences</p><ul class="mt-2 list-disc space-y-1 pl-5"><% @reconciliation.warnings.each do |warning| %><li><%= warning %></li><% end %></ul></div><% end %>
    <p class="text-xs text-mocha sm:hidden">Scroll across the table to compare all amounts.</p>
    <div class="retail-table-region" role="region" tabindex="0" aria-label="Daily source checks">
      <table class="retail-checks-table w-full text-sm"><caption class="sr-only">Native order and tender checks for <%= @day.business_date %>; amounts in <%= @day.currency %></caption><thead class="border-b border-fog bg-haze"><tr><th scope="col" class="th">Check</th><th scope="col" class="th text-right">Order detail</th><th scope="col" class="th text-right">Source report</th><th scope="col" class="th text-right">Difference</th></tr></thead><tbody class="divide-y divide-fog"><% @reconciliation.checks.each do |check| %><tr><th scope="row" class="td text-left font-medium"><%= retail_check_label(check[:label]) %></th><% %i[actual expected delta].each do |key| %><td class="td retail-money text-right <%= key == :delta && !check[key].nil? && check[key] != 0 ? 'text-clay font-semibold' : 'text-mocha' %>"><%= check[:monetary] ? money.call(check[key]) : (check[key].nil? ? 'Unknown' : check[key]) %></td><% end %></tr><% end %></tbody></table>
    </div>
  </section>
  <section id="close-registers" class="retail-anchor space-y-4">
    <div><h2 class="font-display text-xl">Register cash</h2><p class="mt-2 max-w-3xl text-sm text-mocha">Expected cash is shown only for a complete source session with verified movements. Open, cross-day, and incomplete sessions remain Unknown.</p></div>
    <% if @day.sessions.empty? %><p class="card card-pad text-sm text-mocha">No source register sessions are stored for this day.</p><% end %>
    <div class="grid gap-4 lg:grid-cols-2"><% @reconciliation.session_rows.each do |session| %>
      <article class="card card-pad space-y-4"><div class="flex flex-wrap items-start justify-between gap-2"><div><h3 class="font-display text-lg"><%= session['register_name'] %></h3><p class="mt-1 text-xs text-mocha">Source session #<%= session['id'] %></p></div><span class="<%= session['expected_cash'].nil? ? 'pill-clay' : 'pill-taupe' %>"><%= session['expected_cash'].nil? ? 'Cash not verified' : 'Cash calculation available' %></span></div>
        <p class="text-xs text-mocha">Opened <%= retail_event_time(session['opened_at'], timezone: @day.timezone) %><br>Closed <%= session['closed_at'].present? ? retail_event_time(session['closed_at'], timezone: @day.timezone) : 'Still open' %></p>
        <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3"><% { 'Opening cash' => 'opening_cash', 'Day cash sales' => 'day_cash', 'Cash drops' => 'drop_total', 'Expected close' => 'expected_cash', 'Source count' => 'closing_cash', 'Variance' => 'variance' }.each do |label, key| %><div class="min-w-0 rounded-xl bg-haze p-3"><dt class="text-xs text-mocha"><%= label %></dt><dd class="retail-money mt-1 text-lg font-semibold"><%= money.call(session[key]) %></dd></div><% end %></dl>
      </article>
    <% end %></div>
  </section>
  <section id="close-orders" class="retail-anchor card card-pad space-y-4">
    <h2 class="font-display text-xl">Sales journal</h2><p class="text-sm text-mocha">Each receipt keeps its source products and tender records. Order totals, base tender, tips, and surcharges stay separate.</p>
    <% if @day.orders.empty? %><p class="text-sm text-mocha">No source orders are stored for this business date.</p><% end %>
    <% @day.orders.each do |order| %>
      <details class="rounded-xl border border-fog p-3"><summary class="disclosure-trigger text-sm"><span class="font-semibold">Receipt <%= order['receipt'].presence || order['id'] %></span><span class="retail-money ml-2 font-semibold text-olive-deep"><%= money.call(order['total']) %></span><span class="pill-taupe ml-2"><%= order['deleted'] ? 'Deleted in source' : order['status'].to_s.humanize %></span><span class="mt-1 block text-xs text-mocha"><%= retail_event_time(order['completed_at'], timezone: @day.timezone) %> · Source order #<%= order['id'] %> · session #<%= order['register_session_id'] %></span></summary>
        <div class="mt-3 grid gap-4 md:grid-cols-2"><div><h3 class="font-semibold">Products</h3><% order['lines'].each do |line| %><div class="mt-2 border-t border-fog pt-2"><p class="text-sm"><%= line['name'] %> · <%= line['variant_name'] %></p><p class="text-xs text-mocha"><%= money.call(line['price']) %> · source line #<%= line['id'] %></p></div><% end %></div>
          <div><h3 class="font-semibold">Tender records</h3><% order['payments'].each do |payment| %><div class="mt-2 rounded-xl bg-haze p-3 text-sm"><p class="font-semibold"><%= retail_tender_label(payment['type']) %> · <%= payment['status'] %></p><p class="retail-money mt-1">Base <%= money.call(payment['amount']) %> · Tip <%= money.call(payment['tip_amount']) %> · Surcharge <%= money.call(payment['surcharge_amount']) %></p><p class="mt-1 text-xs text-mocha">Source payment #<%= payment['id'] %></p></div><% end %></div>
        </div>
      </details>
    <% end %>
  </section>
  <% if retail_business_access?('sales.write') %>
    <section id="close-review" class="retail-anchor card card-pad space-y-4"><div class="flex flex-wrap items-center justify-between gap-2"><h2 class="font-display text-xl">Record a local review</h2><span class="<%= @day.reviewed? ? 'pill-fern' : 'pill-clay' %>"><%= @day.reviewed? ? 'Current version reviewed' : 'Review needed' %></span></div><p class="text-sm text-mocha">Review the checks and register cash above. A changed source import requires another review. This records your review in Rupert; it does not close a source register or post a bank deposit.</p>
      <%= form_tag review_ctrax_day_path(@day), method: :post, class: 'space-y-3' do %><%= hidden_field_tag :source_digest, @day.source_digest %><div><%= label_tag :note, 'Review note / unresolved differences', class: 'field-label' %><%= text_area_tag :note, @day.review_note, maxlength: 1000, rows: 4, class: 'input retail-notes', aria: { describedby: 'close-review-help' } %><p id="close-review-help" class="mt-1 text-xs text-mocha">A note is required when source controls do not match. Maximum 1,000 characters.</p></div><%= submit_tag 'Record review', class: 'btn-primary' %><% end %>
    </section>
  <% end %>
</div>
