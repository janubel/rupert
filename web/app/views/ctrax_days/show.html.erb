<% content_for :title, "C-Trax daily close · #{@day.business_date}" %>
<% money = ->(value) { ctrax_money(value, currency: @day.currency) } %>
<% sections = [['1 · Source checks', '#close-controls'], ['2 · Register cash', '#close-registers'], ['Items sold', '#close-items'], ['Not in catalog', '#close-not-in-catalog'], ['Sales journal', '#close-orders']] %>
<% sections << ['3 · Local review', '#close-review'] if retail_business_access?('sales.write') %>
<div class="space-y-6">
  <%= page_header @day.location.name, subtitle: "C-Trax daily close for #{@day.business_date.strftime('%b %-d, %Y')} · #{@day.timezone} · #{@day.currency} · last pulled #{retail_source_time(@day.captured_at)}.",
      menu: [['All stores for this date', ctrax_days_path(date: @day.business_date)],
             ['SwipeSimple daily close', swipesimple_days_path(date: @day.business_date)],
             ['Download checks CSV', ctrax_day_path(@day, format: :csv)],
             ['Download items CSV', items_ctrax_days_path(date: @day.business_date, location_id: @day.location_id, format: :csv)]] do %>
    <span class="<%= @reconciliation.matched? ? 'pill-fern' : 'pill-clay' %>"><%= @reconciliation.matched? ? 'Controls match' : 'Needs review' %></span>
  <% end %>

  <% close = DailyCloseSummary.ctrax_row(@day) %>
  <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Daily sales summary" data-ctrax-close>
    <% [['Gross sales', close.gross, 'After discounts, before tax and tips'], ['Refunds', close.refunds, nil], ['Net sales', close.net, 'Gross sales minus refunds'],
        ['Tax collected', close.tax, nil], ['Tips collected', close.tips, 'Not part of sales'], ['Cash collected', close.cash, 'Cash tenders, tips included'],
        ['Credit collected', close.credit, 'Card tenders, tips included']].each do |label, value, hint| %>
      <div class="stat"><p class="stat-label"><%= label %></p><p class="stat-value mt-2"><%= money.call(value) %></p><% if hint %><p class="mt-1 text-xs text-mocha"><%= hint %></p><% end %></div>
    <% end %>
    <div class="stat"><p class="stat-label">Completed orders</p><p class="stat-value mt-2"><%= @reconciliation.orders.size %></p><p class="mt-1 text-xs text-mocha">Source detail only</p></div>
  </section>

  <%= page_tabs(sections.map { |label, anchor| [label, anchor, false] }, label: 'Daily close sections') %>

  <section id="close-controls" class="retail-anchor section-card">
    <%= section_heading 'Source checks', hint: 'Order detail is compared with C-Trax’s independent report. Tender receipts, tips, processor fees and bank deposits are separate evidence; do not add them to sales again.' do %>
      <span class="<%= @reconciliation.matched? ? 'pill-fern' : 'pill-clay' %>"><%= @reconciliation.matched? ? 'Controls match' : 'Needs review' %></span>
    <% end %>
    <% if @reconciliation.warnings.any? %><div class="flash flash-alert" role="status"><p class="font-semibold">Review these differences</p><ul class="mt-2 list-disc space-y-1 pl-5"><% @reconciliation.warnings.each do |warning| %><li><%= warning %></li><% end %></ul></div><% end %>
    <p class="text-xs text-mocha sm:hidden">Scroll across the table to compare all amounts.</p>
    <div class="table-region" role="region" tabindex="0" aria-label="Daily source checks">
      <table class="table retail-checks-table"><caption class="sr-only">Native order and tender checks for <%= @day.business_date %>; amounts in <%= @day.currency %></caption>
        <thead><tr><th scope="col" class="th">Check</th><th scope="col" class="th num">Order detail</th><th scope="col" class="th num">Source report</th><th scope="col" class="th num">Difference</th></tr></thead>
        <tbody><% @reconciliation.checks.each do |check| %><tr><th scope="row" class="td text-left font-medium"><%= retail_check_label(check[:label]) %></th><% %i[actual expected delta].each do |key| %><td class="td num <%= key == :delta && !check[key].nil? && check[key] != 0 ? 'font-semibold text-clay' : 'text-mocha' %>"><%= check[:monetary] ? money.call(check[key]) : (check[key].nil? ? 'Unknown' : check[key]) %></td><% end %></tr><% end %></tbody>
      </table>
    </div>
  </section>

  <section id="close-registers" class="retail-anchor space-y-4">
    <%= section_heading 'Register cash', hint: 'Expected cash is shown only for a complete source session with verified movements. Open, cross-day and incomplete sessions remain Unknown.' %>
    <% if @day.sessions.empty? %><div class="card"><%= empty_state 'No source register sessions for this day', hint: 'Sync the business date again after the register closes in C-Trax.' %></div><% end %>
    <div class="grid gap-4 lg:grid-cols-2">
      <% @reconciliation.session_rows.each do |session| %>
        <article class="section-card">
          <%= section_heading session['register_name'], hint: "Source session ##{session['id']}", level: :h3 do %>
            <span class="<%= session['expected_cash'].nil? ? 'pill-clay' : 'pill-taupe' %>"><%= session['expected_cash'].nil? ? 'Cash not verified' : 'Cash calculation available' %></span>
          <% end %>
          <p class="text-xs text-mocha">Opened <%= retail_event_time(session['opened_at'], timezone: @day.timezone) %><br>Closed <%= session['closed_at'].present? ? retail_event_time(session['closed_at'], timezone: @day.timezone) : 'Still open' %></p>
          <dl class="facts"><% { 'Opening cash' => 'opening_cash', 'Day cash sales' => 'day_cash', 'Cash drops' => 'drop_total', 'Expected close' => 'expected_cash', 'Source count' => 'closing_cash', 'Variance' => 'variance' }.each do |label, key| %><div><dt><%= label %></dt><dd class="num text-left font-semibold"><%= money.call(session[key]) %></dd></div><% end %></dl>
        </article>
      <% end %>
    </div>
  </section>

  <%= render 'items', items: @items, date: @day.business_date, location_id: @day.location_id %>

  <section id="close-orders" class="retail-anchor section-card">
    <%= section_heading 'Sales journal', hint: 'Each receipt keeps its source products and tender records. Order totals, base tender, tips and surcharges stay separate.' %>
    <% if @day.orders.empty? %><p class="text-sm text-mocha">No source orders are stored for this business date.</p><% end %>
    <% @day.orders.each do |order| %>
      <details class="rounded-card border border-fog p-3"><summary class="disclosure-trigger text-sm"><span class="font-semibold">Receipt <%= order['receipt'].presence || order['id'] %></span><span class="num ml-2 font-semibold text-olive-deep"><%= money.call(order['total']) %></span><span class="pill-taupe ml-2"><%= order['deleted'] ? 'Deleted in source' : order['status'].to_s.humanize %></span><span class="mt-1 block text-xs text-mocha"><%= retail_event_time(order['completed_at'], timezone: @day.timezone) %> · Source order #<%= order['id'] %> · session #<%= order['register_session_id'] %></span></summary>
        <div class="mt-3 grid gap-4 md:grid-cols-2">
          <div><h3 class="card-title">Products</h3><% order['lines'].each do |line| %><div class="mt-2 border-t border-fog pt-2"><p class="text-sm"><%= line['name'] %> · <%= line['variant_name'] %></p><p class="text-xs text-mocha"><%= money.call(line['price']) %> · source line #<%= line['id'] %></p></div><% end %></div>
          <div><h3 class="card-title">Tender records</h3><% order['payments'].each do |payment| %><div class="mt-2 rounded-control bg-haze p-3 text-sm"><p class="font-semibold"><%= retail_tender_label(payment['type']) %> · <%= payment['status'] %></p><p class="retail-money mt-1">Base <%= money.call(payment['amount']) %> · Tip <%= money.call(payment['tip_amount']) %> · Surcharge <%= money.call(payment['surcharge_amount']) %></p><p class="mt-1 text-xs text-mocha">Source payment #<%= payment['id'] %></p></div><% end %></div>
        </div>
      </details>
    <% end %>
  </section>

  <% if retail_business_access?('sales.write') %>
    <section id="close-review" class="retail-anchor section-card">
      <%= section_heading 'Record a local review', hint: 'Review the checks and register cash above. A changed source import requires another review. This records your review in Rupert; it does not close a source register or post a bank deposit.' do %>
        <span class="<%= @day.reviewed? ? 'pill-fern' : 'pill-clay' %>"><%= @day.reviewed? ? 'Current version reviewed' : 'Review needed' %></span>
      <% end %>
      <%= form_tag review_ctrax_day_path(@day), method: :post, class: 'space-y-3' do %>
        <%= hidden_field_tag :source_digest, @day.source_digest %>
        <div><%= label_tag :note, 'Review note / unresolved differences', class: 'field-label' %><%= text_area_tag :note, @day.review_note, maxlength: 1000, rows: 4, class: 'input retail-notes', aria: { describedby: 'close-review-help' } %><p id="close-review-help" class="mt-1 text-xs text-mocha">A note is required when source controls do not match. Maximum 1,000 characters.</p></div>
        <div class="form-actions"><%= submit_tag 'Save review', class: 'btn-primary' %></div>
      <% end %>
    </section>
  <% end %>
</div>
