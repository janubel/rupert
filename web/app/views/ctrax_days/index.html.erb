<% content_for :title, 'C-Trax daily close' %>
<% today = Time.current.in_time_zone('America/New_York').to_date %>
<% can_pull = @connection&.credentials_saved? && retail_business_access?('sales.write') && Current.user.can?('sync.write') %>
<% menu = [['SwipeSimple daily close for this date', swipesimple_days_path(date: @date)]] %>
<% menu << ['Download items CSV', items_ctrax_days_path(date: @date, format: :csv)] if @days.any? %>
<div class="space-y-6">
  <%= page_header 'C-Trax daily close', subtitle: 'Recorded sales, tenders and register cash for one business date.', menu: menu do %>
    <% if can_pull %><%= button_to 'Sync now', ctrax_days_path(date: @date), method: :post, class: 'btn-primary', data: { turbo: false }, title: "Pull #{@date.strftime('%b %-d')} from C-Trax" %><% end %>
  <% end %>

  <section class="toolbar-band" aria-label="Choose business date">
    <%= form_tag ctrax_days_path, method: :get, class: 'toolbar' do %>
      <div class="toolbar-field"><%= label_tag :date, 'Business date', class: 'field-label' %>
        <nav aria-label="Business dates" class="date-stepper">
          <%= link_to '‹', ctrax_days_path(date: @date - 1), class: 'btn-ghost btn-sm', aria: { label: 'Previous day' }, title: 'Previous day' %>
          <%= date_field_tag :date, @date, class: 'input' %>
          <%= link_to '›', ctrax_days_path(date: @date + 1), class: 'btn-ghost btn-sm', aria: { label: 'Next day' }, title: 'Next day' %>
        </nav>
      </div>
      <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary' %><% if @date != today %><%= link_to 'Today', ctrax_days_path(date: today), class: 'btn-ghost' %><% end %></div>
    <% end %>
    <% if @connection&.last_report_message.present? %><p role="status" class="mt-3 text-xs text-mocha">Last pull: <%= @connection.last_report_message %></p><% end %>
  </section>

  <% if @days.empty? %>
    <section class="card">
      <%= empty_state 'No stored sales for this date', hint: 'Sync this date to load orders and register sessions. A missing import is not a zero-sales day.' do %>
        <% if retail_business_access?('settings.read') %><%= link_to 'Open C-Trax connection', pos_connection_path('ctrax'), class: 'btn-ghost' %><% else %><p class="text-sm text-mocha">Ask a manager with sync access to pull this business date.</p><% end %>
      <% end %>
    </section>
  <% else %>
    <section class="card" aria-label="Stores on <%= @date.strftime('%b %-d, %Y') %>">
      <ul class="row-list">
        <% @days.each do |day| %>
          <% reconciliation = Ctrax::Reconciliation.new(day) %>
          <li class="row-item">
            <article class="flex w-full flex-wrap items-center justify-between gap-3" aria-label="<%= day.location.name %> daily close">
              <div class="min-w-0">
                <p class="font-semibold text-ink"><%= day.location.name %> <span class="<%= reconciliation.matched? ? 'pill-fern' : 'pill-clay' %>"><%= reconciliation.matched? ? 'Controls match' : 'Needs review' %></span></p>
                <p class="text-xs text-taupe"><%= pluralize(day.sessions.size, 'register session') %> · <%= day.reviewed? ? 'Reviewed' : 'Not reviewed' %> · last pulled <time datetime="<%= day.captured_at.iso8601 %>"><%= retail_source_time(day.captured_at) %></time></p>
              </div>
              <div class="row-item-end">
                <div class="text-right"><p class="text-xs text-mocha">Recorded sales</p><p class="num font-semibold text-ink"><%= ctrax_money(reconciliation.sum(reconciliation.orders, 'total'), currency: day.currency) %></p><p class="text-xs text-taupe"><%= pluralize(reconciliation.orders.size, 'completed order') %></p></div>
                <div class="text-right"><p class="text-xs text-mocha">Recorded tips</p><p class="num font-semibold text-ink"><%= ctrax_money(reconciliation.sum(reconciliation.orders, 'tip'), currency: day.currency) %></p><p class="text-xs text-taupe">Not in sales</p></div>
                <%= link_to 'Review', ctrax_day_path(day), class: 'btn-ghost btn-sm', aria: { label: "Review #{day.location.name} sales and cash" } %>
              </div>
            </article>
          </li>
        <% end %>
      </ul>
      <div class="row-list-foot flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm text-mocha">Items sold: item totals, a tie-out to orders and items missing from the catalog.</p>
        <%= link_to 'Open items sold', items_ctrax_days_path(date: @date), class: 'btn-ghost btn-sm' %>
      </div>
    </section>
  <% end %>

  <details class="explainer">
    <summary class="explainer-summary">About this close</summary>
    <div class="mt-2 space-y-2 text-sm text-mocha">
      <p>A local review does not close a C-Trax register or confirm a bank settlement.</p>
      <p>Each store uses its own source timezone<% if @days.any? %> (<%= @days.map { |day| "#{day.location.name}: #{day.timezone}, #{day.currency}" }.to_sentence %>)<% end %>. Tips are kept separate from order totals.</p>
    </div>
  </details>
</div>
