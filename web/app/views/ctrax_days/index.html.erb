<% content_for :title, 'C-Trax daily close' %>
<div class="space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4"><div><h1 class="page-title">C-Trax daily close</h1><p class="mt-2 text-sm text-mocha">Retail sales, split tenders and register cash, checked against C-Trax’s daily report.</p></div><%= link_to 'Cashier catalog', ctrax_pos_path, class: 'btn-ghost' %></header>
  <%= form_tag ctrax_days_path, method: :get, class: 'flex flex-wrap items-end gap-3' do %><div><%= label_tag :date, 'Business date', class: 'block text-sm' %><%= date_field_tag :date, @date, class: 'input' %></div><%= submit_tag 'View day', class: 'btn-ghost' %><% end %>
  <% if @connection&.credentials_saved? && Current.user.can?('sales.write') && Current.user.can?('sync.write') %><%= button_to 'Pull this day from C-Trax', ctrax_days_path(date: @date), method: :post, class: 'btn-primary', data: { turbo: false } %><% end %>
  <% if @connection&.last_report_message.present? %><p role="status" class="text-sm text-mocha"><%= @connection.last_report_message %></p><% end %>
  <% if @days.empty? %><section class="card card-pad"><h2 class="font-display text-xl">No daily import yet</h2><p class="mt-2 text-sm">Pull this business date to read orders, register sessions and source controls. Missing data is not zero sales.</p><%= link_to 'C-Trax connection', pos_connection_path('ctrax'), class: 'btn-ghost mt-3' %></section><% end %>
  <div class="grid gap-4 md:grid-cols-2"><% @days.each do |day| %><% reconciliation = Ctrax::Reconciliation.new(day) %><article class="card card-pad space-y-3"><div class="flex justify-between gap-3"><h2 class="font-display text-xl"><%= day.location.name %></h2><span class="pill"><%= reconciliation.matched? ? 'Controls match' : 'Needs review' %></span></div><p class="text-sm"><%= day.orders.size %> source orders · <%= day.sessions.size %> register sessions</p><p class="text-xs text-taupe"><%= day.timezone %> · read <%= l day.captured_at, format: :short %></p><%= link_to 'Review sales and cash', ctrax_day_path(day), class: 'btn-primary' %><p class="text-xs"><%= day.reviewed? ? 'Current source version reviewed' : 'Current source version not reviewed' %></p></article><% end %></div>
</div>
