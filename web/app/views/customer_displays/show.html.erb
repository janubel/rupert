<!DOCTYPE html><html lang="en"><head><title>Rupert · Your cart</title><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="turbo-cache-control" content="no-cache"><%= csrf_meta_tags %><%= stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload' %><%= javascript_importmap_tags %></head><body class="min-h-screen bg-haze text-ink"><main class="mx-auto max-w-xl space-y-6 p-6 sm:p-10" data-controller="customer-tip" data-customer-tip-state-url-value="<%= customer_display_state_path(display_token: @display.display_token) %>" data-customer-tip-tip-url-value="<%= customer_display_tip_path(display_token: @display.display_token) %>"><header><p class="text-sm font-medium text-mocha">Rupert <%= @display.demo? ? '· Demo' : '' %></p><h1 class="mt-2 font-display text-3xl">Your cart, your choice</h1><p class="mt-2 text-sm text-mocha">Review your items and choose a tip privately. Your choice is shared with the cashier only when you confirm.</p></header><section class="card card-pad space-y-3"><div class="space-y-3" data-customer-tip-target="items"></div><p class="flex justify-between font-semibold"><span>Subtotal before tax</span><span data-customer-tip-target="subtotal">—</span></p></section><form class="card card-pad space-y-4" data-busy="false" data-action="submit->customer-tip#confirm"><fieldset data-customer-tip-target="choices"><legend class="font-display text-xl">Would you like to leave a tip?</legend><div class="mt-4 grid grid-cols-3 gap-3"><% %w[10 15 20].each do |percent| %><label class="rounded-xl border border-fog p-4 text-center text-lg"><input type="radio" name="choice" value="<%= percent %>" required data-action="change->customer-tip#choiceChanged"> <%= percent %>%</label><% end %></div><div class="mt-3 grid grid-cols-2 gap-3"><label class="rounded-xl border border-fog p-4"><input type="radio" name="choice" value="none" data-action="change->customer-tip#choiceChanged"> No tip</label><label class="rounded-xl border border-fog p-4"><input type="radio" name="choice" value="custom" data-action="change->customer-tip#choiceChanged"> Custom amount</label></div><div class="mt-3" hidden data-customer-tip-target="custom"><label for="customer_tip_amount" class="block text-sm">Custom tip amount (USD)</label><input id="customer_tip_amount" name="amount" type="number" min="0" max="999999.99" step="0.01" class="input mt-1 w-full" inputmode="decimal"></div></fieldset><button class="btn-primary w-full" type="submit" disabled data-customer-tip-target="confirm">Confirm my choice</button><p class="text-xs text-taupe">This is a cart preview before final tax. No money is collected on this screen.</p></form><p role="status" aria-live="polite" class="text-sm" data-customer-tip-target="status">Waiting for the cashier’s cart…</p></main></body></html>
