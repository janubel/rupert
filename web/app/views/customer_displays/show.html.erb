<!DOCTYPE html>
<html lang="en">
<head>
  <%= render "layouts/favicon" %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@400;500;600;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap">
  <title>Rupert · Your cart</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-cache-control" content="no-cache">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload' %>
  <%= javascript_importmap_tags %>
</head>
<body class="min-h-screen bg-haze text-ink">
  <main class="page-narrow mx-auto space-y-6 p-6 sm:p-10" data-controller="customer-tip" data-customer-tip-state-url-value="<%= customer_display_state_path(display_token: @display.display_token) %>" data-customer-tip-config-url-value="<%= customer_payment_config_path(display_token: @display.display_token) %>" data-customer-tip-pay-url-value="<%= customer_pay_path(display_token: @display.display_token) %>" data-customer-tip-tip-url-value="<%= customer_display_tip_path(display_token: @display.display_token) %>">
    <header class="page-header">
      <div class="page-header-main">
        <div class="flex items-center gap-2"><%= render "shared/rupert_face", size: 40 %><p class="eyebrow text-olive-deep">Rupert<%= ' · Demo' if @display.demo? %></p></div>
        <h1 class="page-title">Your cart, your choice</h1>
        <p class="page-subtitle">Review your items and choose a tip privately. Your choice is shared with the cashier only when you confirm.</p>
      </div>
    </header>
    <section class="card card-pad space-y-3" aria-label="Your items">
      <div class="space-y-3" data-customer-tip-target="items"></div>
      <p class="flex justify-between font-semibold"><span>Subtotal before tax</span><span class="num" data-customer-tip-target="subtotal">—</span></p>
      <p class="flex justify-between"><span>Tax</span><span class="num" data-customer-tip-target="tax">—</span></p>
    </section>
    <form class="card card-pad space-y-4" data-busy="false" data-action="submit->customer-tip#confirm">
      <fieldset data-customer-tip-target="choices">
        <legend class="section-title">Would you like to leave a tip?</legend>
        <div class="mt-4 grid grid-cols-3 gap-3">
          <% %w[10 15 20].each do |percent| %>
            <label class="rounded-control border border-fog p-4 text-center text-lg"><input type="radio" name="choice" value="<%= percent %>" required data-action="change->customer-tip#choiceChanged"> <%= percent %>%</label>
          <% end %>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <label class="rounded-control border border-fog p-4"><input type="radio" name="choice" value="none" data-action="change->customer-tip#choiceChanged"> No tip</label>
          <label class="rounded-control border border-fog p-4"><input type="radio" name="choice" value="custom" data-action="change->customer-tip#choiceChanged"> Custom amount</label>
        </div>
        <div class="mt-3" hidden data-customer-tip-target="custom">
          <label for="customer_tip_amount" class="field-label">Custom tip amount (USD)</label>
          <input id="customer_tip_amount" name="amount" type="number" min="0" max="999999.99" step="0.01" class="input w-full" inputmode="decimal">
        </div>
      </fieldset>
      <button class="btn-primary btn-lg w-full" type="submit" disabled data-customer-tip-target="confirm">Confirm my choice</button>
      <p class="text-xs text-taupe"><%= @display.demo? ? 'Demonstration only. No real payment or inventory movement is made.' : 'Confirming your tip does not charge your card. Review the final payment total before paying.' %></p>
    </form>
    <section hidden class="card card-pad space-y-3" data-customer-tip-target="payment" aria-label="Secure checkout">
      <h2 class="section-title">Secure checkout</h2>
      <p class="text-sm">Your total includes the confirmed tip and source tax.</p>
      <div hidden data-customer-tip-target="nmiFields" class="space-y-3">
        <div><label class="field-label" for="nmi-card-number">Card number</label><div id="nmi-card-number" class="input h-12"></div></div>
        <div><label class="field-label" for="nmi-card-exp">Expiry</label><div id="nmi-card-exp" class="input h-12"></div></div>
        <div><label class="field-label" for="nmi-card-cvv">Security code</label><div id="nmi-card-cvv" class="input h-12"></div></div>
      </div>
      <button type="button" disabled class="btn-primary btn-lg w-full" data-customer-tip-target="pay" data-action="customer-tip#demoPay">Pay securely</button>
    </section>
    <section hidden class="card card-pad text-sm" data-customer-tip-target="receipt" aria-label="Receipt"></section>
    <p role="status" aria-live="polite" class="text-sm" data-customer-tip-target="status">Waiting for the cashier’s cart…</p>
  </main>
</body>
</html>
