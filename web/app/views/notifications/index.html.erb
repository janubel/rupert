<% content_for :title, "Notifications" %>
<div class="page-medium space-y-6">
  <%= page_header "Notifications", subtitle: (@unread.positive? ? "#{pluralize(@unread, "unread message")}." : "You're all caught up.") do %>
    <% if @unread.positive? %><%= button_to "Mark all read", read_all_notifications_path, method: :post, class: "btn-ghost btn-sm" %><% end %>
  <% end %>

  <% if system_alerts.any? %>
    <ul class="space-y-2" aria-label="Alerts">
      <% system_alerts.each do |alert| %>
        <li role="alert" class="flash flash-alert flex flex-wrap items-center justify-between gap-3" data-system-alert>
          <span><strong><%= alert[:title] %>.</strong> <%= alert[:body] %></span>
          <%= link_to alert[:link], alert[:path], class: 'font-semibold underline' %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @notifications.empty? %>
    <%= empty_state 'No notifications yet.', hint: 'Task assignments, comments, blocked work and due dates show up here.' %>
  <% else %>
    <ul class="card divide-y divide-fog">
      <% @notifications.each do |notification| %>
        <li>
          <%= link_to notification_path(notification), class: "flex items-start gap-3 px-4 py-3 hover:bg-haze/60" do %>
            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full <%= notification.read? ? "bg-transparent" : "bg-olive" %>" aria-hidden="true"></span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm <%= notification.read? ? "text-mocha" : "font-semibold text-ink" %>"><%= notification.title %><% unless notification.read? %> <span class="sr-only">(unread)</span><% end %></span>
              <% if notification.body.present? %><span class="mt-0.5 line-clamp-2 block text-xs text-taupe"><%= notification.body %></span><% end %>
            </span>
            <span class="shrink-0 text-xs text-taupe"><%= time_ago_in_words(notification.created_at) %> ago</span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <div class="text-xs text-taupe"><%== @pagy.series_nav if @pagy.pages > 1 %></div>
  <% end %>
</div>
