<% content_for :title, 'Square timecards' %>
<section class="space-y-3"><h1 class="page-title">Square timecards</h1><p class="text-sm text-mocha">Read-only history matched to consolidated employees by Square identity. Paid breaks are included; unpaid breaks are deducted. These hours appear in personal reports and calendars, and cannot create a new payroll payment.</p><p class="text-sm text-mocha">Square’s closed status does not establish overtime, approval or payment. Changed or missing source records retain their original imported hours for review.</p><div class="flex flex-wrap gap-3"><%= link_to 'Rupert timesheets', people_timesheets_path, class: 'btn-ghost btn-sm' %><%= link_to 'Download this history', people_square_timesheets_path(request.query_parameters.merge(format: :csv)), class: 'btn-ghost btn-sm' %></div></section>
<section class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="card card-pad"><p class="text-sm text-mocha">Timecards</p><p class="text-2xl font-semibold"><%= @count %></p></div><div class="card card-pad"><p class="text-sm text-mocha">Imported hours</p><p class="text-2xl font-semibold"><%= number_with_precision(BigDecimal(@seconds.to_s) / 3600, precision: 2) %></p></div><div class="card card-pad"><p class="text-sm text-mocha">Not counted</p><p class="text-2xl font-semibold"><%= @held %></p></div></section>
<%= form_with url: people_square_timesheets_path, method: :get, class: 'card card-pad flex flex-wrap items-end gap-3' do |f| %><div><%= f.label :from, 'From', class: 'block text-sm mb-1' %><%= f.date_field :from, value: params[:from], class: 'input' %></div><div><%= f.label :to, 'To', class: 'block text-sm mb-1' %><%= f.date_field :to, value: params[:to], class: 'input' %></div><div><%= f.label :status, 'Import status', class: 'block text-sm mb-1' %><%= f.select :status, [['All', ''], *%w[imported open unmatched conflict invalid changed missing].map { |value| [value.humanize, value] }], { selected: params[:status] }, class: 'select' %></div><%= f.hidden_field :employee_id, value: params[:employee_id] if Current.user.can_manage_accounts? && params[:employee_id].present? %><%= f.submit 'Filter', class: 'btn-primary' %><% end %>
<section class="space-y-3"><% if @cards.empty? %><p class="card card-pad text-sm text-mocha">No Square timecards in this view.</p><% end %><% @cards.each do |card| %><article class="card card-pad space-y-2"><div class="flex flex-wrap justify-between gap-2"><h2 class="font-semibold"><%= link_to(card.started_at ? l(card.started_at.in_time_zone(card.timezone), format: '%b %-d, %Y · %-I:%M %p') : 'Timecard awaiting review', people_square_timesheet_path(card), class: 'text-olive underline') %></h2><span class="pill-olive"><%= card.import_status.humanize %></span></div><p class="text-sm"><%= card.employee&.name || 'Employee not matched' %> · <%= number_with_precision(card.hours, precision: 2) %>h<%= ' · Not counted in totals' unless card.imported_at %></p><% if card.issue.present? %><p class="text-sm text-mocha"><%= card.issue %></p><% end %></article><% end %></section>
<%== pagy_nav(@pagy) if @pagy.pages > 1 %>
