<% content_for :title, 'Square timecards' %>
<%= render 'shared/time_navigation' %>
<%= render 'shared/square_timecard_sync' %>
<section class="space-y-3"><h1 class="page-title">Square timecards</h1><p class="text-sm text-mocha">Read-only history matched to consolidated staff by Square identity. Paid breaks are included; unpaid breaks are deducted. These hours appear in personal reports and calendars, and cannot create a new payroll payment.</p><p class="text-sm text-mocha">Latest punches and break records remain separate from original counted history. Square’s closed status does not establish overtime, approval or payment. Changed or missing source records retain their original imported hours for review.</p><div class="flex flex-wrap gap-3"><%= link_to 'Run punch report', people_punch_history_path(source: 'square'), class: 'btn-ghost btn-sm' %><%= link_to 'Download this history', people_square_timesheets_path(request.query_parameters.merge(format: :csv)), class: 'btn-ghost btn-sm' %></div></section>
<section class="grid grid-cols-2 gap-3 sm:grid-cols-3"><div class="card card-pad"><p class="text-sm text-mocha">Timecards</p><p class="text-2xl font-semibold"><%= @count %></p></div><div class="card card-pad"><p class="text-sm text-mocha">Original counted hours</p><p class="text-2xl font-semibold"><%= number_with_precision(BigDecimal(@seconds.to_s) / 3600, precision: 2) %></p></div><div class="card card-pad"><p class="text-sm text-mocha">Not counted</p><p class="text-2xl font-semibold"><%= @held %></p></div></section>
<%= form_with url: people_square_timesheets_path, method: :get, class: 'card card-pad flex flex-wrap items-end gap-3' do |f| %><div><%= f.label :from, 'From', class: 'field-label' %><%= f.date_field :from, value: params[:from], class: 'input' %></div><div><%= f.label :to, 'To', class: 'field-label' %><%= f.date_field :to, value: params[:to], class: 'input' %></div><div><%= f.label :status, 'Import status', class: 'field-label' %><%= f.select :status, [['All', ''], *%w[imported open unmatched conflict invalid changed missing].map { |value| [value.humanize, value] }], { selected: params[:status] }, class: 'select' %></div><% if @all_employees %><div><%= f.label :employee_id, 'Staff member', class: 'field-label' %><%= f.select :employee_id, [['All staff, including inactive', ''], ['Staff member not matched', 'unmatched'], *@employees.map { |employee| ["#{employee.name}#{employee.active? ? '' : ' (inactive)'}", employee.id] }], { selected: params[:employee_id] }, class: 'select' %></div><% end %><%= f.submit 'Filter', class: 'btn-primary' %><% end %>
<section class="space-y-3"><% if @cards.empty? %><p class="card card-pad text-sm text-mocha">No Square timecards in this view.</p><% end %><% @cards.each do |card| %><% latest = square_latest_values(card) %><article class="card card-pad space-y-2"><div class="flex flex-wrap justify-between gap-2"><h2 class="font-semibold"><%= link_to(square_punch_label(latest[:started_at] || card.started_at, latest[:timezone] || card.timezone), people_square_timesheet_path(card), class: 'text-olive underline') %></h2><span class="pill-olive"><%= card.import_status.humanize %></span></div><p class="text-sm"><%= card.employee&.name || 'Staff member not matched' %> · <%= number_with_precision(card.hours, precision: 2) %>h originally counted<%= ' · Not counted in totals' unless card.imported_at %></p><p class="text-sm text-mocha">Latest clock-out: <%= square_punch_label(latest[:ended_at], latest[:timezone]) %><%= " · #{latest[:status].downcase}" if latest[:status] %> · <%= latest[:breaks].length %> source breaks</p><% if card.issue.present? %><p class="text-sm text-mocha"><%= card.issue %></p><% end %></article><% end %></section>
<%== pagy_nav(@pagy) if @pagy.pages > 1 %>
