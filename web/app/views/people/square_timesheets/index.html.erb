<% content_for :title, 'Square history' %>
<div class="space-y-6">
  <%= page_header 'Square history', subtitle: 'Read-only Square timecards, matched to staff by Square identity.',
        menu: [['Open punch report', people_punch_history_path(source: 'square')], ['Download CSV', people_square_timesheets_path(time_range_query(@from, @to).merge(format: :csv)), { data: { turbo: false } }]] %>
  <%= render 'shared/square_timecard_sync' %>

  <section class="grid grid-cols-2 gap-3 sm:grid-cols-3" aria-label="Square totals">
    <div class="stat"><p class="stat-label">Timecards</p><p class="stat-value mt-1"><%= @count %></p></div>
    <div class="stat"><p class="stat-label">Original counted hours</p><p class="stat-value mt-1"><%= number_with_precision(BigDecimal(@seconds.to_s) / 3600, precision: 2) %></p></div>
    <div class="stat"><p class="stat-label">Not counted</p><p class="stat-value mt-1"><%= @held %></p></div>
  </section>

  <%= form_with url: people_square_timesheets_path, method: :get, class: 'toolbar' do |f| %>
    <%= render 'shared/time_range_picker', from: @from, to: @to, optional: true %>
    <div class="toolbar-field"><%= f.label :status, 'Import status', class: 'field-label' %><%= f.select :status, [['All', ''], *%w[imported open unmatched conflict invalid changed missing].map { |value| [value.humanize, value] }], { selected: params[:status] }, class: 'select' %></div>
    <% if @all_employees %><div class="toolbar-field"><%= f.label :employee_id, 'Staff member', class: 'field-label' %><%= f.select :employee_id, [['All staff, including inactive', ''], ['Staff member not matched', 'unmatched'], *@employees.map { |employee| ["#{employee.name}#{employee.active? ? '' : ' (inactive)'}", employee.id] }], { selected: params[:employee_id] }, class: 'select' %></div><% end %>
    <div class="toolbar-actions">
      <%= f.submit 'Apply', class: 'btn-primary', name: nil %>
      <%= link_to 'Clear', people_square_timesheets_path, class: 'btn-ghost' %>
    </div>
  <% end %>

  <div class="card">
    <div class="table-region" role="region" tabindex="0" aria-label="Square timecards">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Clock-in</th>
            <th scope="col" class="th">Staff member</th>
            <th scope="col" class="th num">Hours counted</th>
            <th scope="col" class="th">Latest clock-out</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th">Notes</th>
          </tr>
        </thead>
        <tbody>
          <% if @cards.empty? %><tr><td colspan="6" class="empty-row">No Square timecards in this view. Widen the dates or clear the filters.</td></tr><% end %>
          <% @cards.each do |card| %>
            <% latest = square_latest_values(card) %>
            <tr>
              <td class="td whitespace-nowrap"><%= link_to(square_punch_label(latest[:started_at] || card.started_at, latest[:timezone] || card.timezone), people_square_timesheet_path(card), class: 'font-medium text-olive hover:underline') %></td>
              <td class="td"><%= card.employee&.name || 'Staff member not matched' %></td>
              <td class="td num"><%= number_with_precision(card.hours, precision: 2) %><% unless card.imported_at %><p class="text-xs text-taupe">Not counted in totals</p><% end %></td>
              <td class="td whitespace-nowrap text-mocha"><%= square_punch_label(latest[:ended_at], latest[:timezone]) %><% if latest[:status] %><p class="text-xs text-taupe"><%= latest[:status].downcase %></p><% end %></td>
              <td class="td"><span class="<%= time_status_pill(card.import_status) %>"><%= card.import_status.humanize %></span></td>
              <td class="td text-mocha"><%= pluralize(latest[:breaks].length, 'source break') %><% if card.issue.present? %><p class="text-xs"><%= card.issue %></p><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%== @pagy.series_nav if @pagy.pages > 1 %>
  <%= fold_explainer('Paid breaks are included; unpaid breaks are deducted. These hours appear in personal reports and calendars, and cannot create a new payroll payment. Latest punches and break records remain separate from original counted history. Square’s closed status does not establish overtime, approval or payment. Changed or missing source records retain their original imported hours for review.', class: 'text-sm text-mocha') %>
</div>
