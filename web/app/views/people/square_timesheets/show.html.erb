<% content_for :title, 'Square timecard' %>
<section class="space-y-3"><h1 class="page-title">Square timecard</h1><p class="text-sm text-mocha">Read-only imported history · <%= @card.import_status.humanize %></p><%= link_to 'Back to Square history', people_square_timesheets_path, class: 'text-sm text-olive underline' %></section>
<section class="card card-pad space-y-3"><h2 class="text-lg font-semibold"><%= @card.employee&.name || 'Employee not matched' %></h2><dl class="grid gap-3 text-sm sm:grid-cols-2"><div><dt class="text-mocha">Square timecard ID</dt><dd class="break-all"><%= @card.external_id %></dd></div><div><dt class="text-mocha">Timezone</dt><dd><%= @card.timezone || 'Not available' %></dd></div><div><dt class="text-mocha">Clock-in</dt><dd><%= @card.started_at ? l(@card.started_at.in_time_zone(@card.timezone), format: :long) : 'Not available' %></dd></div><div><dt class="text-mocha">Clock-out</dt><dd><%= @card.ended_at ? l(@card.ended_at.in_time_zone(@card.timezone), format: :long) : 'Not available' %></dd></div><div><dt class="text-mocha">Recorded hours</dt><dd><%= number_with_precision(@card.hours, precision: 2) %>h</dd></div><div><dt class="text-mocha">Unpaid break time</dt><dd><%= number_with_precision(BigDecimal(@card.unpaid_break_seconds.to_s) / 60, precision: 2) %> minutes</dd></div></dl><% if @card.issue.present? %><p class="rounded-xl bg-haze p-3 text-sm"><%= @card.issue %></p><% end %><p class="text-sm text-mocha"><%= @card.imported_at ? 'Counted once in personal hours history. Square history is excluded from new Rupert payroll generation.' : 'Not counted in personal hours or payroll.' %></p></section>
<section class="card card-pad space-y-3"><h2 class="text-lg font-semibold">Hours by day</h2><% @card.days.order(:worked_on).each do |day| %><p class="flex flex-wrap justify-between gap-2 text-sm"><span><%= l(day.worked_on, format: :long) %></span><span><%= number_with_precision(day.hours, precision: 2) %>h</span></p><% end %><% if @card.days.empty? %><p class="text-sm text-mocha">No positive imported work time. Zero-duration Square records contribute zero hours.</p><% end %></section>
