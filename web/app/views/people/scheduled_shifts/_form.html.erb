<div class="card card-pad">
  <%= form_with model: shift, scope: :scheduled_shift, url: (shift.persisted? ? people_scheduled_shift_path(shift) : people_scheduled_shifts_path), class: "space-y-6" do |f| %>
    <% if shift.errors.any? %><div role="alert" class="flash flash-alert"><%= shift.errors.full_messages.to_sentence %></div><% end %>
    <fieldset class="space-y-4">
      <legend class="card-title">Shift</legend>
      <div>
        <%= f.label :employee_id, "Staff member", class: "field-label" %>
        <%= f.select :employee_id, @employees.map { |e| [e.full_name, e.id] }, { include_blank: "Choose…" }, class: "select w-full", required: true %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :starts_at, "Starts", class: "field-label" %>
          <%= f.datetime_field :starts_at, class: "input", required: true %>
        </div>
        <div>
          <%= f.label :ends_at, "Ends", class: "field-label" %>
          <%= f.datetime_field :ends_at, class: "input", required: true %>
        </div>
      </div>
      <div>
        <%= f.label :role_label, "Role or station (optional)", class: "field-label" %>
        <%= f.text_field :role_label, class: "input", maxlength: 80, placeholder: "e.g. Front counter" %>
      </div>
      <div>
        <%= f.label :notes, "Note for the staff member (optional)", class: "field-label" %>
        <%= f.text_area :notes, rows: 2, maxlength: 2000, class: "input" %>
      </div>
    </fieldset>
    <div class="form-actions">
      <%= f.submit "Save", class: "btn-primary" %>
      <%= link_to "Cancel", people_scheduled_shifts_path(week: shift.starts_at&.to_date&.iso8601), class: "btn-ghost" %>
    </div>
  <% end %>
  <% if shift.persisted? %><div class="mt-4 flex justify-end"><%= button_to "Delete shift", people_scheduled_shift_path(shift), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "Delete this shift?" } } %></div><% end %>
</div>
