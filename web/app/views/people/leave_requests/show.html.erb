<% content_for :title, "Leave request" %>
<% can_write = Current.user.can?("leave.write") %>
<% menu = [] %>
<% if can_write && @leave_request.requested? %>
  <% menu << ['Deny', deny_people_leave_request_path(@leave_request), { method: :post }] %>
  <% menu << ['Cancel request', cancel_people_leave_request_path(@leave_request), { method: :post, data: { turbo_confirm: "Cancel this request?" } }] %>
<% elsif can_write && @leave_request.approved? %>
  <% menu << ['Cancel approval', cancel_people_leave_request_path(@leave_request), { method: :post, data: { turbo_confirm: "Cancel this approved leave and give the hours back?" } }] %>
<% end %>
<div class="space-y-6">
  <%= page_header "#{@leave_request.leave_type.humanize} leave", subtitle: @leave_request.employee.name, menu: menu do %>
    <% if can_write && @leave_request.requested? %>
      <%= button_to "Approve", approve_people_leave_request_path(@leave_request), method: :post, class: "btn-primary", data: { turbo_confirm: "Approve this leave?" } %>
    <% end %>
  <% end %>

  <dl class="facts">
    <div><dt>Staff member</dt><dd><%= link_to @leave_request.employee.name, people_employee_path(@leave_request.employee), class: "text-olive hover:underline" %></dd></div>
    <div><dt>Status</dt><dd><span class="<%= @leave_request.approved? ? "pill-fern" : @leave_request.denied? ? "pill-rose" : @leave_request.cancelled? ? "pill-taupe" : "pill-olive" %>"><%= @leave_request.status.humanize %></span></dd></div>
    <% if @leave_request.reviewer %><div><dt>Reviewed by</dt><dd><%= @leave_request.reviewer.display_name %></dd></div><% end %>
  </dl>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4" aria-label="Leave details">
    <div class="stat">
      <p class="stat-label">From</p>
      <p class="stat-value-sm mt-1"><%= l(@leave_request.starts_on, format: :long) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">To</p>
      <p class="stat-value-sm mt-1"><%= l(@leave_request.ends_on, format: :long) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Length</p>
      <p class="stat-value mt-1"><%= @leave_request.duration_label %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Balance remaining</p>
      <p class="stat-value-sm mt-1"><%= @balance ? "#{number_with_precision(@balance.remaining_hours, precision: 1)}h" : 'Allowance not set' %></p>
      <p class="mt-1 text-xs text-taupe"><%= @leave_request.leave_type.humanize %> <%= @leave_request.starts_on.year %></p>
    </div>
  </section>

  <% if @leave_request.reason.present? %>
    <section class="section-card">
      <%= section_heading 'Reason' %>
      <p class="whitespace-pre-wrap text-sm text-mocha"><%= @leave_request.reason %></p>
    </section>
  <% end %>
</div>
