<% content_for :title, "Leave & PTO" %>
<div class="space-y-6">
  <%= page_header 'Leave & PTO', subtitle: 'Time-off requests, approvals and annual balances.' do %>
    <% if Current.user.can?("leave.write") %>
      <%= link_to "Add request", new_people_leave_request_path, class: "btn-primary" %>
    <% end %>
  <% end %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4" aria-label="Leave totals">
    <div class="stat">
      <p class="stat-label">Pending requests</p>
      <p class="stat-value mt-1"><%= People::LeaveRequest.pending.count %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Approved</p>
      <p class="stat-value mt-1"><%= People::LeaveRequest.where(status: "approved").count %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Denied</p>
      <p class="stat-value mt-1"><%= People::LeaveRequest.where(status: "denied").count %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Vacation given · <%= Date.current.year %></p>
      <p class="stat-value-sm mt-1"><%= number_with_precision(@balances.sum { |b| b.leave_type == "vacation" ? b.accrued_hours : 0 }, precision: 1) %>h</p>
    </div>
  </section>

  <section class="section-card">
    <%= section_heading 'Requests' %>
    <div class="table-region" role="region" tabindex="0" aria-label="Leave requests">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Staff member</th>
            <th scope="col" class="th">Type</th>
            <th scope="col" class="th">Dates</th>
            <th scope="col" class="th num">Length</th>
            <th scope="col" class="th">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if @requests.empty? %>
            <tr><td colspan="5" class="empty-row">No leave requests yet.<%= ' Add the first request.' if Current.user.can?("leave.write") %></td></tr>
          <% end %>
          <% @requests.each do |request| %>
            <tr>
              <td class="td font-medium text-ink"><%= link_to request.employee&.name, people_employee_path(request.employee), class: "hover:text-olive hover:underline" %></td>
              <td class="td"><%= request.leave_type.humanize %></td>
              <td class="td text-mocha"><%= link_to "#{l(request.starts_on, format: :short)} – #{l(request.ends_on, format: :short)}", people_leave_request_path(request), class: "text-olive hover:underline" %></td>
              <td class="td num"><%= request.duration_label %></td>
              <td class="td">
                <span class="<%= request.approved? ? "pill-fern" : request.denied? ? "pill-rose" : request.cancelled? ? "pill-taupe" : "pill-olive" %>"><%= request.status.humanize %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section-card">
    <%= section_heading "Balances · #{Date.current.year}" %>
    <div class="table-region" role="region" tabindex="0" aria-label="Leave balances">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Staff member</th>
            <th scope="col" class="th">Type</th>
            <th scope="col" class="th num">Accrued</th>
            <th scope="col" class="th num">Used</th>
            <th scope="col" class="th num">Remaining</th>
          </tr>
        </thead>
        <tbody>
          <% if @balances.empty? %>
            <tr><td colspan="5" class="empty-row">No balances on record for this year. Set an allowance on a staff member's page.</td></tr>
          <% end %>
          <% @balances.each do |balance| %>
            <tr>
              <td class="td font-medium text-ink"><%= balance.employee&.name %></td>
              <td class="td"><%= balance.leave_type.humanize %></td>
              <td class="td num"><%= number_with_precision(balance.accrued_hours, precision: 1) %></td>
              <td class="td num"><%= number_with_precision(balance.used_hours, precision: 1) %></td>
              <td class="td num font-medium text-ink"><%= number_with_precision(balance.remaining_hours, precision: 1) %>h</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
