<% content_for :title, 'Punch report' %>
<div class="space-y-6" data-controller="punch-calendar">
  <%= page_header 'Punch report', subtitle: 'Every punch from Rupert, Square and C-Trax for a date range.',
        menu: [['Download CSV', people_punch_history_path(time_range_query(@from, @to).merge(format: :csv)), { data: { turbo: false } }]] %>

  <%= page_tabs([['List', people_punch_history_path(time_range_query(@from, @to).merge(view: 'list')), @view == 'list'], ['Calendar', people_punch_history_path(time_range_query(@from, @to).merge(view: 'calendar')), @view == 'calendar']], label: 'Punch report view') %>

  <section class="toolbar-band">
    <%= form_with url: people_punch_history_path, method: :get, class: 'toolbar', data: { punch_calendar_target: 'form' } do |f| %>
      <%= hidden_field_tag :view, @view %>
      <%= render 'shared/time_range_picker', from: @from, to: @to, from_data: { punch_calendar_target: 'from' }, to_data: { punch_calendar_target: 'to' } %>
      <div class="toolbar-field"><%= label_tag :employee_id, 'Staff member', class: 'field-label' %><%= select_tag :employee_id, options_for_select([['All staff', '']] + @employees.map { |e| [e.name, e.id] }, params[:employee_id]), class: 'select' %></div>
      <div class="toolbar-field"><%= label_tag :source, 'Source', class: 'field-label' %><%= select_tag :source, options_for_select([['All sources', ''], ['Rupert clock', 'rupert'], ['Square', 'square'], ['C-Trax', 'ctrax']], params[:source]), class: 'select' %></div>
      <div class="toolbar-field"><%= label_tag :status, 'Status', class: 'field-label' %><%= select_tag :status, options_for_select([['All statuses', ''], ['Closed / counted', 'closed'], ['Open (still punched in)', 'open'], ['Conflict', 'conflict'], ['Unmatched', 'unmatched'], ['Unassigned', 'unassigned']], params[:status]), class: 'select' %></div>
      <div class="toolbar-actions">
        <%= submit_tag 'Apply', class: 'btn-primary', name: nil %>
        <%= link_to 'Clear', people_punch_history_path, class: 'btn-ghost' %>
      </div>
      <p class="basis-full text-xs text-mocha">Selected range: <strong data-punch-calendar-target="label"><%= @from.strftime('%b %-d, %Y') %> – <%= @to.strftime('%b %-d, %Y') %></strong><% if @view == 'calendar' %> · drag across days to pick a range<% end %></p>
    <% end %>
  </section>

  <section class="grid grid-cols-2 gap-3 sm:grid-cols-5" aria-label="Report totals">
    <div class="stat"><p class="stat-label">Punches</p><p class="stat-value mt-1"><%= @summary.punches %></p><p class="text-xs text-mocha"><%= @summary.by_source.map { |src, n| "#{n} #{time_source_label(src)}" }.join(' · ') %></p></div>
    <div class="stat"><p class="stat-label">Counted hours</p><p class="stat-value mt-1"><%= number_with_precision(@summary.counted_hours, precision: 1) %></p><p class="text-xs text-mocha">Rupert + imported Square</p></div>
    <div class="stat"><p class="stat-label">All recorded hours</p><p class="stat-value mt-1"><%= number_with_precision(@summary.hours, precision: 1) %></p><p class="text-xs text-mocha">includes held and C-Trax</p></div>
    <div class="stat"><p class="stat-label">Still punched in</p><p class="stat-value mt-1 <%= @summary.open_shifts.positive? ? 'text-rose' : '' %>"><%= @summary.open_shifts %></p></div>
    <div class="stat"><p class="stat-label">Needs a look</p><p class="stat-value mt-1 <%= @summary.flagged.positive? ? 'text-rose' : '' %>"><%= @summary.flagged %></p><p class="text-xs text-mocha"><%= @summary.implausible %> over <%= PunchHistory::IMPLAUSIBLE_HOURS %>h</p></div>
  </section>

  <section class="section-card" aria-label="Hours by staff member">
    <%= section_heading 'Hours by staff member', hint: 'Counted = Rupert clock + imported Square. C-Trax is shown for comparison only.' %>
    <% if @summary.by_employee_source.empty? %>
      <%= empty_state 'No punches in this range', hint: 'Pick other dates or clear the filters.' %>
    <% else %>
      <div class="table-region" role="region" tabindex="0" aria-label="Hours by staff member">
        <table class="table table-figures">
          <thead><tr>
            <th scope="col" class="th">Staff member</th>
            <th scope="col" class="th num">Punches</th>
            <th scope="col" class="th num">Rupert</th>
            <th scope="col" class="th num">Square</th>
            <th scope="col" class="th num">C-Trax</th>
            <th scope="col" class="th num">Counted</th>
            <th scope="col" class="th num">Flags</th>
            <th scope="col" class="th"><span class="sr-only">Filter</span></th>
          </tr></thead>
          <tbody>
            <% @summary.by_employee_source.sort_by { |_n, m| -m['counted'] }.each do |name, m| %>
              <% emp = @employees.find { |e| e.name == name } %>
              <tr>
                <td class="td font-medium text-ink"><%= name %></td>
                <td class="td num"><%= m['punches'] %></td>
                <td class="td num"><%= m['rupert'].positive? ? number_with_precision(m['rupert'], precision: 1) : '—' %></td>
                <td class="td num"><%= m['square'].positive? ? number_with_precision(m['square'], precision: 1) : '—' %></td>
                <td class="td num"><%= m['ctrax'].positive? ? number_with_precision(m['ctrax'], precision: 1) : '—' %></td>
                <td class="td num font-semibold text-ink"><%= number_with_precision(m['counted'], precision: 1) %></td>
                <td class="td num"><% if m['flagged'].positive? %><span class="pill-rose"><%= m['flagged'] %></span><% else %><span class="text-taupe">—</span><% end %></td>
                <td class="td text-right"><% if emp %><%= link_to 'Only this person', people_punch_history_path(time_range_query(@from, @to).merge(employee_id: emp.id)), class: 'btn-ghost btn-sm' %><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <% if @view == 'calendar' %>
    <section class="section-card">
      <div class="card-head">
        <div><h2 class="section-title"><%= @from.strftime('%B %Y') %></h2></div>
        <nav class="card-head-actions date-stepper" aria-label="Month">
          <%= link_to '‹', people_punch_history_path(time_range_query(@from, @to).merge(from: (@from - 1.month).beginning_of_month.iso8601, to: (@from - 1.month).end_of_month.iso8601)), class: 'btn-ghost btn-sm', aria: { label: 'Previous month' }, title: 'Previous month' %>
          <%= link_to '›', people_punch_history_path(time_range_query(@from, @to).merge(from: (@from + 1.month).beginning_of_month.iso8601, to: (@from + 1.month).end_of_month.iso8601)), class: 'btn-ghost btn-sm', aria: { label: 'Next month' }, title: 'Next month' %>
        </nav>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-mocha">
        <% Date::DAYNAMES.rotate.each do |day| %><div class="py-1"><%= day %></div><% end %>
      </div>
      <div class="grid grid-cols-7 gap-1" data-punch-calendar-target="grid">
        <% @month.each do |day| %>
          <% bucket = @calendar_days[day.iso8601] %>
          <% in_range = day.between?(@from, @to) %>
          <div class="min-h-24 rounded-card border p-2 text-left <%= in_range ? 'border-olive bg-olive/20' : 'border-fog' %> <%= bucket && !in_range ? 'bg-haze/40' : '' %>"
               data-punch-calendar-target="day" data-date="<%= day.iso8601 %>"
               data-action="mousedown->punch-calendar#start mouseenter->punch-calendar#extend"
               role="button" tabindex="0" aria-label="<%= day.strftime('%B %-d, %Y') %>">
            <p class="text-xs font-semibold <%= day == Date.current ? 'text-olive' : 'text-ink' %>"><%= day.day %></p>
            <% if bucket %>
              <p class="mt-1 text-xs font-semibold text-olive"><%= bucket[:rows].size %> punch<%= bucket[:rows].size == 1 ? '' : 'es' %></p>
              <p class="text-xs text-mocha"><%= number_with_precision(bucket[:hours], precision: 1) %> h</p>
              <% flagged = bucket[:rows].count(&:flagged?) %>
              <% if flagged.positive? %><p class="text-xs text-rose"><%= flagged %> to check</p><% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% else %>
    <div class="card">
      <div class="table-region" role="region" tabindex="0" aria-label="Punches">
        <table class="table">
          <thead>
            <tr>
              <th scope="col" class="th">Staff member</th>
              <th scope="col" class="th">Source</th>
              <th scope="col" class="th">Clock-in</th>
              <th scope="col" class="th">Clock-out</th>
              <th scope="col" class="th num">Hours</th>
              <th scope="col" class="th">Status</th>
              <th scope="col" class="th">Counted</th>
              <th scope="col" class="th">Reference</th>
            </tr>
          </thead>
          <tbody>
            <% if @rows.empty? %>
              <tr><td colspan="8" class="empty-row">No punches in this range. Pick other dates or clear the filters.</td></tr>
            <% end %>
            <% @rows.each do |row| %>
              <tr class="<%= row.implausible? ? 'bg-rose/5' : '' %>">
                <td class="td font-medium text-ink"><%= row.employee_name %></td>
                <td class="td"><span class="<%= time_source_pill(row.source) %>"><%= time_source_label(row.source) %></span></td>
                <td class="td whitespace-nowrap"><%= row.started_at&.strftime('%a %b %-d, %-l:%M %p') || '—' %></td>
                <td class="td whitespace-nowrap"><%= row.ended_at&.strftime('%a %b %-d, %-l:%M %p') || '—' %></td>
                <td class="td num <%= row.implausible? ? 'font-semibold text-rose' : '' %>"><%= row.hours ? number_with_precision(row.hours, precision: 2) : '—' %></td>
                <td class="td"><span class="<%= time_status_pill(row.status) %>"><%= row.status %></span></td>
                <td class="td"><%= row.counted ? 'Yes' : 'No' %></td>
                <td class="td text-mocha"><%= row.reference %><% if row.implausible? %><p class="text-xs text-rose">Over <%= PunchHistory::IMPLAUSIBLE_HOURS %> hours — check for a missed clock-out.</p><% end %><% if row.issue.present? %><p class="text-xs"><%= row.issue %></p><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%= fold_explainer('Read-only: nothing here creates, edits or approves payroll. A shift recorded in two sources is never added together. Counted hours are Rupert clock plus imported Square; C-Trax is shown for comparison only.', class: 'text-sm text-mocha') %>
  <%= render 'shared/time_source_coverage', coverage: @coverage %>
</div>
