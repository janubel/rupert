<% content_for :title, 'Punch report' %>
<div class="space-y-6" data-controller="punch-calendar">
  <section class="space-y-3">
    <%= page_header 'Punch report', subtitle: 'Every punch from Rupert, Square and C-Trax for a date range, with hours per staff member and anything that needs a look. Read-only: nothing here creates, edits or approves payroll, and a shift recorded in two sources is never added together.' do %>
      <%= link_to 'Download CSV', people_punch_history_path(time_range_query(@from, @to).merge(format: :csv)), class: 'btn-primary btn-sm' %>
    <% end %>
  </section>

  <%= form_with url: people_punch_history_path, method: :get, class: 'card card-pad space-y-3', data: { punch_calendar_target: 'form' } do |f| %>
    <%= hidden_field_tag :view, @view %>
    <div class="flex flex-wrap items-end gap-3">
      <%= render 'shared/time_range_picker', from: @from, to: @to, from_data: { punch_calendar_target: 'from' }, to_data: { punch_calendar_target: 'to' } %>
      <div><%= label_tag :employee_id, 'Staff member', class: 'field-label' %><%= select_tag :employee_id, options_for_select([['All staff', '']] + @employees.map { |e| [e.name, e.id] }, params[:employee_id]), class: 'select' %></div>
      <div><%= label_tag :source, 'Source', class: 'field-label' %><%= select_tag :source, options_for_select([['All sources', ''], ['Rupert clock', 'rupert'], ['Square', 'square'], ['C-Trax', 'ctrax']], params[:source]), class: 'select' %></div>
      <div><%= label_tag :status, 'Status', class: 'field-label' %><%= select_tag :status, options_for_select([['All statuses', ''], ['Closed / counted', 'closed'], ['Open (still punched in)', 'open'], ['Conflict', 'conflict'], ['Unmatched', 'unmatched'], ['Unassigned', 'unassigned']], params[:status]), class: 'select' %></div>
      <%= submit_tag 'Run report', class: 'btn-primary' %>
      <%= link_to 'Reset', people_punch_history_path, class: 'btn-ghost btn-sm' %>
    </div>
    <p class="text-sm text-mocha">Selected range: <strong data-punch-calendar-target="label"><%= @from.strftime('%b %-d, %Y') %> – <%= @to.strftime('%b %-d, %Y') %></strong><% if @view == 'calendar' %> · drag across days to pick a range<% end %></p>
  <% end %>

  <section class="grid grid-cols-2 gap-3 sm:grid-cols-5" aria-label="Report totals">
    <div class="stat"><p class="stat-label">Punches</p><p class="stat-value mt-1"><%= @summary.punches %></p><p class="text-xs text-mocha"><%= @summary.by_source.map { |src, n| "#{n} #{time_source_label(src)}" }.join(' · ') %></p></div>
    <div class="stat"><p class="stat-label">Counted hours</p><p class="stat-value mt-1"><%= number_with_precision(@summary.counted_hours, precision: 1) %></p><p class="text-xs text-mocha">Rupert + imported Square</p></div>
    <div class="stat"><p class="stat-label">All recorded hours</p><p class="stat-value mt-1"><%= number_with_precision(@summary.hours, precision: 1) %></p><p class="text-xs text-mocha">includes held and C-Trax</p></div>
    <div class="stat"><p class="stat-label">Still punched in</p><p class="stat-value mt-1 <%= @summary.open_shifts.positive? ? 'text-rose' : '' %>"><%= @summary.open_shifts %></p></div>
    <div class="stat"><p class="stat-label">Needs a look</p><p class="stat-value mt-1 <%= @summary.flagged.positive? ? 'text-rose' : '' %>"><%= @summary.flagged %></p><p class="text-xs text-mocha"><%= @summary.implausible %> over <%= PunchHistory::IMPLAUSIBLE_HOURS %>h</p></div>
  </section>

  <section class="card overflow-hidden" aria-label="Hours by staff member">
    <div class="flex flex-wrap items-baseline justify-between gap-2 px-4 pt-3">
      <h2 class="text-lg font-semibold">Hours by staff member</h2>
      <p class="text-xs text-mocha">Counted = Rupert clock + imported Square. C-Trax is shown for comparison only.</p>
    </div>
    <% if @summary.by_employee_source.empty? %>
      <p class="px-4 pb-4 pt-2 text-sm text-mocha">No punches in this range.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm table-figures">
          <thead class="border-b border-fog bg-haze/60"><tr>
            <th scope="col" class="th">Staff member</th>
            <th scope="col" class="th text-right">Punches</th>
            <th scope="col" class="th text-right">Rupert</th>
            <th scope="col" class="th text-right">Square</th>
            <th scope="col" class="th text-right">C-Trax</th>
            <th scope="col" class="th text-right">Counted</th>
            <th scope="col" class="th text-right">Flags</th>
            <th scope="col" class="th"><span class="sr-only">Filter</span></th>
          </tr></thead>
          <tbody class="divide-y divide-fog">
            <% @summary.by_employee_source.sort_by { |_n, m| -m['counted'] }.each do |name, m| %>
              <% emp = @employees.find { |e| e.name == name } %>
              <tr class="hover:bg-cream">
                <td class="td font-medium text-ink"><%= name %></td>
                <td class="td text-right text-mocha"><%= m['punches'] %></td>
                <td class="td text-right text-mocha"><%= m['rupert'].positive? ? number_with_precision(m['rupert'], precision: 1) : '—' %></td>
                <td class="td text-right text-mocha"><%= m['square'].positive? ? number_with_precision(m['square'], precision: 1) : '—' %></td>
                <td class="td text-right text-mocha"><%= m['ctrax'].positive? ? number_with_precision(m['ctrax'], precision: 1) : '—' %></td>
                <td class="td text-right font-semibold text-ink"><%= number_with_precision(m['counted'], precision: 1) %></td>
                <td class="td text-right"><% if m['flagged'].positive? %><span class="pill-rose"><%= m['flagged'] %></span><% else %><span class="text-taupe">—</span><% end %></td>
                <td class="td"><% if emp %><%= link_to 'Only this person', people_punch_history_path(time_range_query(@from, @to).merge(employee_id: emp.id)), class: 'text-olive underline text-xs' %><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <nav aria-label="Punch report view" class="flex flex-wrap gap-2">
    <%= link_to 'List', people_punch_history_path(time_range_query(@from, @to).merge(view: 'list')), class: "nav-pill #{@view == 'list' ? 'nav-pill-active' : 'nav-pill-idle'}" %>
    <%= link_to 'Calendar', people_punch_history_path(time_range_query(@from, @to).merge(view: 'calendar')), class: "nav-pill #{@view == 'calendar' ? 'nav-pill-active' : 'nav-pill-idle'}" %>
  </nav>

  <% if @view == 'calendar' %>
    <section class="card card-pad space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold"><%= @from.strftime('%B %Y') %></h2>
        <div class="flex gap-2">
          <%= link_to '← Month', people_punch_history_path(time_range_query(@from, @to).merge(from: (@from - 1.month).beginning_of_month.iso8601, to: (@from - 1.month).end_of_month.iso8601)), class: 'btn-ghost btn-sm' %>
          <%= link_to 'Month →', people_punch_history_path(time_range_query(@from, @to).merge(from: (@from + 1.month).beginning_of_month.iso8601, to: (@from + 1.month).end_of_month.iso8601)), class: 'btn-ghost btn-sm' %>
        </div>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold uppercase tracking-wide text-mocha">
        <% Date::DAYNAMES.rotate.each do |day| %><div class="py-1"><%= day %></div><% end %>
      </div>
      <div class="grid grid-cols-7 gap-1" data-punch-calendar-target="grid">
        <% @month.each do |day| %>
          <% bucket = @calendar_days[day.iso8601] %>
          <% in_range = day.between?(@from, @to) %>
          <div class="min-h-24 rounded-xl border p-2 text-left <%= in_range ? 'border-olive bg-olive/20' : 'border-fog' %> <%= bucket && !in_range ? 'bg-haze/40' : '' %>"
               data-punch-calendar-target="day" data-date="<%= day.iso8601 %>"
               data-action="mousedown->punch-calendar#start mouseenter->punch-calendar#extend"
               role="button" tabindex="0" aria-label="<%= day.strftime('%B %-d, %Y') %>">
            <p class="text-xs font-semibold <%= day == Date.current ? 'text-olive' : 'text-ink' %>"><%= day.day %></p>
            <% if bucket %>
              <p class="mt-1 text-xs font-semibold text-olive"><%= bucket[:rows].size %> punch<%= bucket[:rows].size == 1 ? '' : 'es' %></p>
              <p class="text-xs text-mocha"><%= number_with_precision(bucket[:hours], precision: 1) %> h</p>
              <% flagged = bucket[:rows].count(&:flagged?) %>
              <% if flagged.positive? %><p class="text-xs text-rose"><%= flagged %> to check</p><% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% else %>
    <div class="card overflow-hidden">
      <div class="overflow-x-auto operations-table-region">
        <table class="w-full text-sm operations-table">
          <thead class="border-b border-fog bg-haze/60">
            <tr>
              <th scope="col" class="th">Staff member</th>
              <th scope="col" class="th">Source</th>
              <th scope="col" class="th">Clock-in</th>
              <th scope="col" class="th">Clock-out</th>
              <th scope="col" class="th text-right">Hours</th>
              <th scope="col" class="th">Status</th>
              <th scope="col" class="th">Counted</th>
              <th scope="col" class="th">Reference</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-fog">
            <% if @rows.empty? %>
              <tr><td colspan="8" class="empty-row">No punches in this range.</td></tr>
            <% end %>
            <% @rows.each do |row| %>
              <tr class="hover:bg-cream <%= row.implausible? ? 'bg-rose/5' : '' %>">
                <td class="td font-medium text-ink"><%= row.employee_name %></td>
                <td class="td"><span class="<%= time_source_pill(row.source) %>"><%= time_source_label(row.source) %></span></td>
                <td class="td whitespace-nowrap"><%= row.started_at&.strftime('%a %b %-d, %-l:%M %p') || '—' %></td>
                <td class="td whitespace-nowrap"><%= row.ended_at&.strftime('%a %b %-d, %-l:%M %p') || '—' %></td>
                <td class="td text-right <%= row.implausible? ? 'font-semibold text-rose' : 'text-mocha' %>"><%= row.hours ? number_with_precision(row.hours, precision: 2) : '—' %></td>
                <td class="td"><span class="<%= time_status_pill(row.status) %>"><%= row.status %></span></td>
                <td class="td"><%= row.counted ? 'Yes' : 'No' %></td>
                <td class="td text-mocha"><%= row.reference %><% if row.implausible? %><p class="text-xs text-rose">Over <%= PunchHistory::IMPLAUSIBLE_HOURS %> hours — check for a missed clock-out.</p><% end %><% if row.issue.present? %><p class="text-xs"><%= row.issue %></p><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%= render 'shared/time_source_coverage', coverage: @coverage %>
</div>
