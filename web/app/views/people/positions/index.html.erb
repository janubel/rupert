<% content_for :title, "Positions" %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Positions</h1>
      <p class="mt-1 text-sm text-mocha">Job titles and pay grades across the org.</p>
    </div>
    <% if Current.user.can?("hr.write") %>
      <%= link_to "New position", new_people_position_path, class: "btn-primary" %>
    <% end %>
  </section>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Position</th>
            <th scope="col" class="th">Department</th>
            <th scope="col" class="th">Pay grade</th>
            <th scope="col" class="th text-right">Filled</th>
            <% if Current.user.can?("hr.write") %><th scope="col" class="th"></th><% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @positions.empty? %>
            <tr><td colspan="<%= Current.user.can?("hr.write") ? 5 : 4 %>" class="empty-row">No positions yet — add the first one.</td></tr>
          <% end %>
          <% @positions.each do |position| %>
            <tr class="hover:bg-cream">
              <td class="td font-medium text-ink"><%= position.name %></td>
              <td class="td text-mocha"><%= position.department&.name || "—" %></td>
              <td class="td text-mocha"><%= position.pay_grade.presence || "—" %></td>
              <td class="td text-right text-mocha"><%= @filled.fetch(position.id, 0) %></td>
              <% if Current.user.can?("hr.write") %>
                <td class="td text-right"><%= link_to "Edit", edit_people_position_path(position), class: "text-xs font-semibold text-olive hover:underline" %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
