<div class="card card-pad">
  <% if employee.errors.any? %>
    <div role="alert" class="flash flash-alert">
      <p class="font-semibold">Check the staff details:</p>
      <ul class="mt-2 list-disc pl-5">
        <% employee.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form_with model: employee, scope: :employee, url: (employee.persisted? ? people_employee_path(employee) : people_employees_path), class: "space-y-6" do |f| %>
    <fieldset class="space-y-4">
      <legend class="card-title">Name and record</legend>
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <%= f.label :first_name, "First name", class: "field-label" %>
          <%= f.text_field :first_name, class: "input", autocomplete: "off", required: true %>
        </div>
        <div>
          <%= f.label :last_name, "Last name", class: "field-label" %>
          <%= f.text_field :last_name, class: "input", autocomplete: "off", required: true %>
        </div>
        <div>
          <%= f.label :employee_number, "Staff member #", class: "field-label" %>
          <%= f.text_field :employee_number, class: "input", autocomplete: "off", placeholder: "E2026-001" %>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :legal_name, "Legal name", class: "field-label" %>
          <%= f.text_field :legal_name, class: "input", autocomplete: "off" %>
        </div>
        <div>
          <%= f.label :user_id, "Login account", class: "field-label" %>
          <%= f.select :user_id, @users.map { |u| [u.display_name, u.id] }, { include_blank: "No login account" }, class: "select w-full" %>
        </div>
      </div>
    </fieldset>

    <fieldset class="space-y-4">
      <legend class="card-title">Role</legend>
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <%= f.label :department_id, "Department", class: "field-label" %>
          <%= f.select :department_id, @departments.map { |d| [d.name, d.id] }, { include_blank: "—" }, class: "select w-full" %>
        </div>
        <div>
          <%= f.label :position_id, "Position", class: "field-label" %>
          <%= f.select :position_id, @positions.map { |p| [p.name, p.id] }, { include_blank: "—" }, class: "select w-full" %>
        </div>
        <div>
          <%= f.label :employment_type, "Employment type", class: "field-label" %>
          <%= f.select :employment_type, People::Employee::EMPLOYMENT_TYPES.map { |t| [t.tr("_", " ").capitalize, t] }, {}, class: "select w-full" %>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :hire_date, "Hire date", class: "field-label" %>
          <%= f.date_field :hire_date, class: "input" %>
        </div>
        <div>
          <%= f.label :termination_date, "Termination date", class: "field-label" %>
          <%= f.date_field :termination_date, class: "input" %>
        </div>
      </div>
    </fieldset>

    <fieldset class="space-y-4">
      <legend class="card-title">Contact</legend>
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <%= f.label :email, "Email", class: "field-label" %>
          <%= f.email_field :email, class: "input", autocomplete: "off" %>
        </div>
        <div>
          <%= f.label :phone, "Phone", class: "field-label" %>
          <%= f.telephone_field :phone, class: "input", autocomplete: "off" %>
        </div>
        <div>
          <%= f.label :date_of_birth, "Date of birth", class: "field-label" %>
          <%= f.date_field :date_of_birth, class: "input" %>
        </div>
      </div>
      <div>
        <%= f.label :address, "Address", class: "field-label" %>
        <%= f.text_area :address, rows: 2, class: "input" %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :emergency_contact_name, "Emergency contact", class: "field-label" %>
          <%= f.text_field :emergency_contact_name, class: "input", autocomplete: "off" %>
        </div>
        <div>
          <%= f.label :emergency_contact_phone, "Emergency contact phone", class: "field-label" %>
          <%= f.telephone_field :emergency_contact_phone, class: "input", autocomplete: "off" %>
        </div>
      </div>
      <div>
        <%= f.label :notes, "Notes", class: "field-label" %>
        <%= f.text_area :notes, rows: 2, class: "input" %>
      </div>
    </fieldset>

    <div class="form-actions">
      <%= f.submit "Save", class: "btn-primary" %>
      <%= link_to "Cancel", employee.persisted? ? people_employee_path(employee) : people_employees_path, class: "btn-ghost" %>
    </div>
  <% end %>
</div>
