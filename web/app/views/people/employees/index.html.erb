<% content_for :title, "Staff" %>
<% menu = [] %>
<% menu << ['Sync staff now', sync_directory_people_employees_path, { method: :post }] if Current.user.can?("hr.write") && Current.user.can?("sync.write") %>
<% menu << ['Consolidate profiles', consolidation_people_employees_path] if Current.user.can?("hr.write") && Current.user.can_manage_accounts? %>
<div class="space-y-6">
  <div <%= tour_anchor('actions') %>>
    <%= page_header 'Staff', subtitle: 'The team directory with department, position and employment status.', menu: menu do %>
      <% if Current.user.can?("hr.write") %>
        <%= link_to "Add staff member", new_people_employee_path, class: "btn-primary" %>
      <% end %>
    <% end %>
  </div>

  <%= render "shared/directory_sync_status", kind: "employees", tour: "sync" %>
  <%= fold_explainer('Each staff member can have accounts in several apps. Consolidated profiles retain every source identity. Confirm employment type and payroll details before payroll.', class: 'text-sm text-mocha') %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4" <%= tour_anchor('stats') %>>
    <div class="stat">
      <p class="stat-label">Active</p>
      <p class="stat-value mt-1"><%= People::Employee.active.count %></p>
    </div>
    <% if Current.user.can?("timesheets.read") %>
    <div class="stat">
      <p class="stat-label">Awaiting timesheets</p>
      <p class="stat-value mt-1"><%= @awaiting_timesheets %></p>
    </div>
    <% end %>
    <% if Current.user.can?("leave.read") %>
    <div class="stat">
      <p class="stat-label">Leave pending</p>
      <p class="stat-value mt-1"><%= @pending_leave %></p>
    </div>
    <% end %>
    <div class="stat">
      <p class="stat-label">Departments</p>
      <p class="stat-value mt-1"><%= People::Department.count %></p>
    </div>
  </section>

  <p class="text-sm text-mocha"><%= @missing_logins %> active staff records need a login. <%= link_to 'Review staff without logins', people_employees_path(login: 'missing'), class: 'font-semibold text-olive-deep hover:underline' %></p>

  <%= form_tag people_employees_path, method: :get, class: "toolbar", data: { tour: 'filters' } do %>
    <div class="toolbar-field">
      <label class="field-label" for="staff-q">Search</label>
      <input id="staff-q" type="search" name="q" value="<%= params[:q] %>" placeholder="Name, staff member # or email" class="input" autocomplete="off">
    </div>
    <div class="toolbar-field">
      <label class="field-label" for="staff-status">Status</label>
      <select id="staff-status" name="status" data-controller="auto-submit" data-action="change->auto-submit#submit" class="select">
        <option value="all" <%= @status == "all" ? "selected" : "" %>>All statuses</option>
        <% People::Employee.aasm.states.map(&:name).each do |status| %>
          <option value="<%= status %>" <%= @status == status.to_s ? "selected" : "" %>><%= status.to_s.humanize %></option>
        <% end %>
      </select>
    </div>
    <div class="toolbar-field">
      <%= label_tag :source, 'Source', class: 'field-label' %>
      <%= select_tag :source, options_for_select([['All sources', '']] + Directories::Sync::PAIRS.keys.map { |v| [directory_label(v), v] }, params[:source]), class: 'select' %>
    </div>
    <div class="toolbar-field">
      <%= label_tag :login, 'Login', class: 'field-label' %>
      <%= select_tag :login, options_for_select([['All logins', ''], ['Needs login', 'missing'], ['Linked login', 'linked']], params[:login]), class: 'select' %>
    </div>
    <div class="toolbar-actions">
      <%= submit_tag 'Apply', class: 'btn-primary', name: nil %>
      <%= link_to 'Clear', people_employees_path, class: 'btn-ghost' %>
    </div>
  <% end %>

  <div class="card" <%= tour_anchor('table') %>>
    <div class="table-region" role="region" tabindex="0" aria-label="Staff">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Staff member</th>
            <th scope="col" class="th">Department</th>
            <th scope="col" class="th">Position</th>
            <th scope="col" class="th">Web login</th>
            <th scope="col" class="th">Access &amp; tabs</th>
            <th scope="col" class="th">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if @employees.empty? %>
            <tr><td colspan="6" class="empty-row"><%= @q.present? ? "No staff match that search. Clear the filters to see everyone." : "No staff yet. Add your first staff member." %></td></tr>
          <% end %>
          <% @employees.each do |employee| %>
            <tr>
              <td class="td">
                <p class="font-medium text-ink"><%= link_to employee.name, people_employee_path(employee), class: "hover:text-olive hover:underline" %></p>
                <% employee.source_identities.each do |identity| %><p class="text-xs text-taupe"><%= directory_label(identity.source) %> · <%= identity.source_active.nil? ? 'status not supplied' : identity.source_active ? 'active' : 'inactive' %></p><% end %>
                <p class="text-xs text-taupe"><%= employee.employee_number.presence || employee.email %></p>
              </td>
              <td class="td text-mocha"><%= employee.department&.name || "—" %></td>
              <td class="td text-mocha"><%= employee.position&.name || "—" %></td>
              <td class="td text-mocha"><%= employee.user ? (employee.user.active? ? "Login linked" : "Login disabled") : "Needs login" %></td>
              <td class="td"><%= render 'access_badges', employee: employee, compact: true %><%= link_to 'Review access', people_employee_path(employee, anchor: 'access'), class: 'mt-2 inline-block text-xs text-olive underline' %></td>
              <td class="td">
                <span class="<%= employee.active? ? "pill-fern" : employee.on_leave? ? "pill-olive" : "pill-rose" %>"><%= employee.status.tr("_", " ").capitalize %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy.pages > 1 %><div class="p-4"><%== @pagy.series_nav %></div><% end %>
  </div>
</div>
