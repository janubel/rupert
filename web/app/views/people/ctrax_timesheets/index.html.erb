<% content_for :title, 'C-Trax history' %>
<div class="space-y-6">
  <%= page_header 'C-Trax history', subtitle: 'Read-only C-Trax register shifts, including open and unmatched ones.',
        menu: [['Open punch report', people_punch_history_path(source: 'ctrax')], ['Download CSV', people_ctrax_timesheets_path(time_range_query(@from, @to).merge(format: :csv)), { data: { turbo: false } }]] %>
  <%= render 'automatic_refresh' %>

  <section class="grid grid-cols-3 gap-3" aria-label="C-Trax totals">
    <div class="stat"><p class="stat-label">Source records</p><p class="stat-value mt-1"><%= @count %></p></div>
    <div class="stat"><p class="stat-label">In progress</p><p class="stat-value mt-1"><%= @open %></p></div>
    <div class="stat"><p class="stat-label">Awaiting review or match</p><p class="stat-value mt-1"><%= @held %></p></div>
  </section>

  <%= form_with url: people_ctrax_timesheets_path, method: :get, class: 'toolbar' do |f| %>
    <%= render 'shared/time_range_picker', from: @from, to: @to, optional: true, hint: 'Start and end dates match each shift’s original clock-in date.' %>
    <div class="toolbar-field"><%= f.label :status, 'Source status', class: 'field-label' %><%= f.select :status, [['All', ''], *CtraxLaborShift::STATUSES.map { |value| [value.humanize, value] }], { selected: params[:status] }, class: 'select' %></div>
    <% if @all_employees %>
      <div class="toolbar-field"><%= f.label :employee_id, 'Staff member', class: 'field-label' %><%= f.select :employee_id, [['All staff, including inactive', ''], ['Staff member not matched', 'unmatched'], *@employees.map { |employee| ["#{employee.name}#{employee.active? ? '' : ' (inactive)'}", employee.id] }], { selected: params[:employee_id] }, class: 'select' %></div>
    <% end %>
    <div class="toolbar-actions">
      <%= f.submit 'Apply', class: 'btn-primary', name: nil %>
      <%= link_to 'Clear', people_ctrax_timesheets_path, class: 'btn-ghost' %>
    </div>
  <% end %>

  <div class="card">
    <div class="table-region" role="region" tabindex="0" aria-label="C-Trax shifts">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Clock-in</th>
            <th scope="col" class="th">Staff member</th>
            <th scope="col" class="th">Latest clock-out</th>
            <th scope="col" class="th">Hours</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th">Notes</th>
          </tr>
        </thead>
        <tbody>
          <% if @shifts.empty? %><tr><td colspan="6" class="empty-row">No C-Trax shifts in this view. Widen the dates or clear the filters.</td></tr><% end %>
          <% @shifts.each do |shift| %>
            <% latest = ctrax_source_values(shift.latest_record) %>
            <tr>
              <td class="td whitespace-nowrap"><%= link_to(latest[:started_at] ? l(latest[:started_at].in_time_zone, format: '%b %-d, %Y · %-I:%M %p %Z') : 'Shift awaiting review', people_ctrax_timesheet_path(shift), class: 'font-medium text-olive hover:underline') %></td>
              <td class="td"><%= shift.employee&.name || 'Staff member not matched' %><p class="text-xs text-taupe">Store <%= shift.store_id || 'not available' %></p></td>
              <td class="td whitespace-nowrap text-mocha"><%= latest[:ended_at] ? l(latest[:ended_at].in_time_zone, format: '%b %-d, %Y · %-I:%M %p %Z') : 'Not available' %></td>
              <td class="td text-mocha">Latest source-reported: <%= latest[:reported_hours].nil? ? 'Not available' : "#{number_with_precision(latest[:reported_hours], precision: 2)}h" %><br>Latest elapsed: <%= latest[:elapsed_hours].nil? ? 'Not available' : "#{number_with_precision(latest[:elapsed_hours], precision: 2)}h" %><%= ' · In progress' if latest[:in_progress] %></td>
              <td class="td"><span class="<%= time_status_pill(shift.status) %>"><%= shift.status.humanize %></span></td>
              <td class="td text-mocha"><% if latest[:reported_hours] && latest[:elapsed_hours] && (latest[:reported_hours] - latest[:elapsed_hours]).abs > 0.01 %><p class="text-xs">Reported and elapsed hours differ; inspect the source record before relying on these hours.</p><% end %><% if shift.issue.present? %><p class="text-xs"><%= shift.issue %></p><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%== @pagy.series_nav if @pagy.pages > 1 %>
  <%= fold_explainer('C-Trax reported hours and elapsed clock time can differ; neither establishes overtime, Rupert approval or payment. Each shift retains its original observation and a dated change history. These records stay separate from Square history and Rupert timesheets; overlapping source hours are never added together, and C-Trax shifts do not enter Rupert payroll or personal hour totals.', class: 'text-sm text-mocha') %>
</div>
