<% content_for :title, 'C-Trax shift' %>
<div class="space-y-6">
  <%= page_header 'C-Trax shift', subtitle: "Read-only source history · #{@shift.employee&.name || 'Staff member not matched'}",
        menu: [['Download CSV', people_ctrax_timesheet_path(@shift, format: :csv), { data: { turbo: false } }]] %>
  <dl class="facts">
    <div><dt>Source status</dt><dd><span class="<%= time_status_pill(@shift.status) %>"><%= @shift.status.humanize %></span></dd></div>
    <div><dt>C-Trax shift ID</dt><dd><%= @shift.external_id %></dd></div>
    <div><dt>Store ID</dt><dd><%= @shift.latest_record['store_id'] || @shift.store_id || 'Not available' %></dd></div>
    <div><dt>Last read</dt><dd><%= @shift.last_seen_at ? l(@shift.last_seen_at.in_time_zone, format: :long) : 'Not available' %></dd></div>
  </dl>

  <section class="section-card" aria-label="Latest source observation">
    <%= section_heading 'Latest source observation' %>
    <dl class="facts">
      <div><dt>Clock-in</dt><dd><%= @latest[:started_at] ? l(@latest[:started_at].in_time_zone, format: :long) : 'Not available' %></dd></div>
      <div><dt>Clock-out</dt><dd><%= @latest[:ended_at] ? l(@latest[:ended_at].in_time_zone, format: :long) : 'Not available' %></dd></div>
      <div><dt>Source-reported hours</dt><dd><%= @latest[:reported_hours].nil? ? 'Not available' : number_with_precision(@latest[:reported_hours], precision: 2) %></dd></div>
      <div><dt>Elapsed hours</dt><dd><%= @latest[:elapsed_hours].nil? ? 'Not available' : number_with_precision(@latest[:elapsed_hours], precision: 2) %></dd></div>
      <div><dt>In progress</dt><dd><%= @latest[:in_progress].nil? ? 'Not reported' : @latest[:in_progress] ? 'Yes' : 'No' %></dd></div>
      <div><dt>Verified by source</dt><dd><%= @latest[:verified].nil? ? 'Not reported' : @latest[:verified] ? 'Yes' : 'No' %></dd></div>
    </dl>
    <% if @latest[:reported_hours] && @latest[:elapsed_hours] && (@latest[:reported_hours] - @latest[:elapsed_hours]).abs > 0.01 %><p class="flash flash-alert" role="status">Reported and elapsed hours differ. This may reflect source adjustments; review the source rather than assuming either value is payable.</p><% end %>
    <% if @shift.issue.present? %><p class="flash flash-alert" role="status"><%= @shift.issue %></p><% end %>
    <p class="text-sm text-mocha">Source verification is not Rupert approval or proof of payment. These hours remain excluded from Rupert payroll and personal hour totals. Do not add them to overlapping Square or Rupert entries.</p>
  </section>

  <section class="section-card" aria-label="Original source observation">
    <%= section_heading 'Original source observation', hint: 'The first observed punches and reported hours are retained here even when C-Trax later closes or changes the shift.' %>
    <dl class="facts">
      <div><dt>Original clock-in</dt><dd><%= @shift.started_at ? l(@shift.started_at.in_time_zone, format: :long) : 'Not available' %></dd></div>
      <div><dt>Original clock-out</dt><dd><%= @shift.ended_at ? l(@shift.ended_at.in_time_zone, format: :long) : 'Not available' %></dd></div>
      <div><dt>Original source-reported hours</dt><dd><%= @shift.reported_hours.nil? ? 'Not available' : number_with_precision(@shift.reported_hours, precision: 2) %></dd></div>
      <div><dt>Original elapsed hours</dt><dd><%= @shift.elapsed_hours.nil? ? 'Not available' : number_with_precision(@shift.elapsed_hours, precision: 2) %></dd></div>
    </dl>
  </section>

  <section class="section-card" aria-label="Source observation history">
    <%= section_heading 'Source observation history', hint: "#{@observation_count} recorded observations. Showing the latest 50; identical refreshes do not add duplicates. Missing or changed records stay in history." %>
    <% @observations.each do |observation| %>
      <% values = ctrax_source_values(observation.record_data) %>
      <article class="space-y-1 border-t border-fog pt-3" data-observation="<%= observation.sequence %>">
        <h3 class="card-title">Observation <%= observation.sequence %> · <%= l(observation.observed_at.in_time_zone, format: :long) %> · <%= observation.status.humanize %></h3>
        <p class="text-sm">Clock-in: <%= values[:started_at] ? l(values[:started_at].in_time_zone, format: :long) : 'Not available' %> · Clock-out: <%= values[:ended_at] ? l(values[:ended_at].in_time_zone, format: :long) : 'Not available' %></p>
        <p class="text-sm">Source-reported: <%= values[:reported_hours].nil? ? 'Not available' : "#{number_with_precision(values[:reported_hours], precision: 2)}h" %> · Elapsed: <%= values[:elapsed_hours].nil? ? 'Not available' : "#{number_with_precision(values[:elapsed_hours], precision: 2)}h" %><%= ' · In progress' if values[:in_progress] %></p>
        <% if observation.issue.present? %><p class="text-sm text-mocha"><%= observation.issue %></p><% end %>
      </article>
    <% end %>
  </section>
</div>
