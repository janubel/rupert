<% content_for :title, "Departments" %>
<div class="space-y-6">
  <%= page_header 'Departments', subtitle: 'The org chart: who runs each team and how big it is.' do %>
    <% if Current.user.can?("hr.write") %>
      <%= link_to "New department", new_people_department_path, class: "btn-primary" %>
    <% end %>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% if @departments.empty? %>
      <div class="card card-pad col-span-full text-sm text-taupe">No departments yet — add the first one.</div>
    <% end %>
    <% @departments.each do |department| %>
      <div class="card card-pad">
        <div class="flex items-center justify-between gap-2">
          <h3 class="font-display text-lg text-ink"><%= department.name %></h3>
          <% if department.code %><span class="pill-taupe font-mono"><%= department.code %></span><% end %>
        </div>
        <p class="mt-1 text-sm text-mocha"><%= department.description.presence || "—" %></p>
        <dl class="mt-3 space-y-1 text-xs text-taupe">
          <div class="flex justify-between"><dt>Manager</dt><dd class="font-medium text-mocha"><%= department.manager&.name || "—" %></dd></div>
          <div class="flex justify-between"><dt>Headcount</dt><dd class="font-medium text-mocha"><%= @headcount.fetch(department.id, 0) %> active</dd></div>
          <div class="flex justify-between"><dt>Positions</dt><dd class="font-medium text-mocha"><%= department.positions.count %></dd></div>
        </dl>
        <% if Current.user.can?("hr.write") %>
          <%= link_to "Edit", edit_people_department_path(department), class: "mt-3 inline-block text-xs font-semibold text-olive hover:underline" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
