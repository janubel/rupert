<% content_for :title, "Departments" %>
<% can_write = Current.user.can?("hr.write") %>
<div class="space-y-6">
  <%= page_header 'Departments', subtitle: 'Who runs each team and how big it is.' do %>
    <% if can_write %>
      <%= link_to "Add department", new_people_department_path, class: "btn-primary" %>
    <% end %>
  <% end %>

  <div class="card">
    <div class="table-region" role="region" tabindex="0" aria-label="Departments">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Department</th>
            <th scope="col" class="th">Code</th>
            <th scope="col" class="th">Manager</th>
            <th scope="col" class="th num">Headcount</th>
            <th scope="col" class="th num">Positions</th>
            <% if can_write %><th scope="col" class="th"><span class="sr-only">Actions</span></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% if @departments.empty? %>
            <tr><td colspan="<%= can_write ? 6 : 5 %>" class="empty-row">No departments yet. Add your first department.</td></tr>
          <% end %>
          <% @departments.each do |department| %>
            <tr>
              <td class="td">
                <p class="font-medium text-ink"><%= department.name %></p>
                <% if department.description.present? %><p class="text-xs text-taupe"><%= department.description %></p><% end %>
              </td>
              <td class="td text-mocha"><%= department.code.presence || "—" %></td>
              <td class="td text-mocha"><%= department.manager&.name || "—" %></td>
              <td class="td num"><%= @headcount.fetch(department.id, 0) %></td>
              <td class="td num"><%= department.positions.count %></td>
              <% if can_write %>
                <td class="td text-right"><%= link_to "Edit", edit_people_department_path(department), class: "btn-ghost btn-sm" %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
