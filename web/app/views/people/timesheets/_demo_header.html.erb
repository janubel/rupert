<section role="status" aria-label="Demo timesheet notice" class="flash flash-alert">
  <p class="font-semibold">DEMO · Fictional timesheet</p>
  <p class="mt-1">Sample hours for review practice. Excluded from payroll and actual-hours reports.</p>
  <% if local_assigns[:timesheet]&.assigned_reviewer %>
    <p class="mt-1 font-semibold">Assigned to <%= timesheet.assigned_reviewer.display_name %> for approval or return.</p>
  <% end %>
</section>
