<% content_for :title, "Timesheet" %>
<div class="space-y-6">
  <%= render 'people/timesheets/demo_header', timesheet: @timesheet if @timesheet.demo? %>
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title"><%= @timesheet.period_label %></h1>
      <p class="mt-1 text-sm text-mocha">
        <%= @timesheet.employee.name %>
        <span class="text-taupe">·</span>
        <span class="<%= @timesheet.approved? ? "pill-fern" : @timesheet.submitted? ? "pill-olive" : @timesheet.rejected? ? "pill-rose" : "pill-taupe" %>"><%= @timesheet.status %></span>
        <% if @timesheet.submitted_at %><span class="text-taupe">· submitted <%= l(@timesheet.submitted_at, format: :short) %></span><% end %>
        <% if @timesheet.reviewer %><span class="text-taupe">· reviewed by <%= @timesheet.reviewer.display_name %></span><% end %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to 'Back to timesheets', people_timesheets_path, class: 'btn-ghost btn-sm' %>
      <%= link_to '← Earlier', people_timesheet_path(@previous_sheet), class: 'btn-ghost btn-sm', title: @previous_sheet.period_label if @previous_sheet %>
      <%= link_to 'Later →', people_timesheet_path(@next_sheet), class: 'btn-ghost btn-sm', title: @next_sheet.period_label if @next_sheet %>
      <%= link_to 'Download CSV', people_timesheet_path(@timesheet, format: :csv), class: 'btn-ghost btn-sm' %>
      <% if policy(@timesheet).update? && @timesheet.draft? %>
        <%= button_to 'Submit for review', submit_people_timesheet_path(@timesheet), class: 'btn-primary btn-sm' %>
        <%= button_to 'Import clock shifts', import_shifts_people_timesheet_path(@timesheet), class: 'btn-ghost btn-sm' %>
        <%= link_to 'Edit period / notes', edit_people_timesheet_path(@timesheet), class: 'btn-ghost btn-sm' %>
        <%= button_to 'Delete draft', people_timesheet_path(@timesheet), method: :delete, class: 'btn-ghost btn-sm', data: { turbo_confirm: 'Delete this draft and its entries?' } %>
      <% end %>
      <% if policy(@timesheet).approve? && @timesheet.submitted? %>
        <%= form_with url: approve_people_timesheet_path(@timesheet), class: 'flex flex-wrap gap-2' do |f| %>
          <%= f.label :review_note, 'Review comment', class: 'sr-only' %>
          <%= f.text_field :review_note, maxlength: 4000, placeholder: 'Review comment', class: 'input' %>
          <%= f.submit 'Approve', class: 'btn-primary btn-sm' %>
          <% if @next_awaiting %><%= f.submit 'Approve & next', name: 'continue', class: 'btn-primary btn-sm' %><% end %>
          <%= f.submit 'Return for correction', formaction: reject_people_timesheet_path(@timesheet), class: 'btn-ghost btn-sm' %>
        <% end %>
      <% end %>
      <% if policy(@timesheet).reopen? && (@timesheet.approved? || @timesheet.rejected?) %>
        <%= button_to 'Reopen for editing', reopen_people_timesheet_path(@timesheet), class: 'btn-ghost btn-sm' unless @timesheet.payroll_locked? %>
      <% end %>
    </div>
  </section>

  <% if @timesheet.submitted? && policy(@timesheet).approve? %>
    <section class="card card-pad space-y-2" aria-label="Review checklist">
      <h2 class="font-display text-lg">Before approving</h2>
      <p class="text-sm text-mocha">Check the dates, daily hours, overtime and notes below against the employee's shifts. Approval rechecks entries, imported clock hours and pending corrections. Return the timesheet for correction if anything needs changing.</p>
      <% if @summary.flags.any? %><p class="flex flex-wrap gap-2"><% @summary.flags.each do |flag| %><span class="pill-clay"><%= flag %></span><% end %></p><% end %>
      <% if @next_awaiting %><p class="text-sm"><%= link_to "Skip to next awaiting review: #{@next_awaiting.employee.name}", people_timesheet_path(@next_awaiting), class: 'text-olive underline' %></p><% end %>
    </section>
  <% end %>

  <section class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="stat">
      <p class="stat-label">Total hours</p>
      <p class="stat-value mt-1"><%= number_with_precision(@timesheet.total_hours, precision: 1) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Regular</p>
      <p class="stat-value mt-1"><%= number_with_precision(@timesheet.regular_hours, precision: 1) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Overtime</p>
      <p class="stat-value mt-1"><%= number_with_precision(@timesheet.overtime_hours, precision: 1) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Days worked</p>
      <p class="stat-value mt-1"><%= @summary.days_worked %></p>
    </div>
  </section>

  <% days = (@timesheet.period_start..@timesheet.period_end).to_a %>
  <% by_day = @timesheet.entries.group_by(&:worked_on) %>
  <section class="card overflow-hidden" aria-label="Daily hours">
    <div class="border-b border-fog px-5 py-3"><h2 class="font-display text-lg text-ink">Day by day</h2></div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60"><tr>
          <% days.each do |day| %><th scope="col" class="th text-center"><%= day.strftime('%a') %><br><span class="font-normal"><%= day.strftime('%b %-d') %></span></th><% end %>
        </tr></thead>
        <tbody><tr>
          <% days.each do |day| %>
            <% hours = (by_day[day] || []).sum(&:hours) %>
            <td class="td text-center <%= hours > TimesheetInsights::LONG_DAY_HOURS ? 'font-semibold text-rose' : hours.zero? ? 'text-taupe' : 'text-ink' %>"><%= hours.zero? ? '–' : number_with_precision(hours, precision: 2, strip_insignificant_zeros: true) %></td>
          <% end %>
        </tr></tbody>
      </table>
    </div>
  </section>

  <div class="card overflow-hidden">
    <div class="border-b border-fog px-5 py-3">
      <h2 class="font-display text-lg text-ink">Entries</h2>
    </div>

    <% if @timesheet.draft? && policy(@timesheet).update? %>
      <div class="border-b border-fog bg-haze/40 px-5 py-3">
        <p class="text-xs text-taupe">Add a day's hours to this draft.</p>
        <%= form_with model: [@timesheet, @entry], scope: :timesheet_entry, url: add_entry_people_timesheet_path(@timesheet), method: :post, class: "mt-2 flex flex-wrap items-end gap-2" do |f| %>
          <div>
            <%= f.label :worked_on, "Date", class: "mb-1 block text-[10px] font-semibold uppercase tracking-wide text-mocha" %>
            <%= f.date_field :worked_on, class: "input" %>
          </div>
          <div>
            <%= f.label :hours, "Hours", class: "mb-1 block text-[10px] font-semibold uppercase tracking-wide text-mocha" %>
            <%= f.number_field :hours, step: 0.25, min: 0.25, max: 24, value: @entry.hours.positive? ? @entry.hours : 8, class: "input w-24" %>
          </div>
          <div>
            <%= f.label :work_type, "Type", class: "mb-1 block text-[10px] font-semibold uppercase tracking-wide text-mocha" %>
            <%= f.select :work_type, People::TimesheetEntry::WORK_TYPES.map { |t| [t.titleize, t] }, {}, class: "select w-auto" %>
          </div>
          <div><%= f.label :notes, "Entry notes", class: "block text-xs" %><%= f.text_field :notes, maxlength: 1000, class: "input" %></div>
          <%= f.submit "Add entry", class: "btn-primary btn-sm" %>
        <% end %>
        <% if @entry.errors.any? %>
          <p class="mt-2 text-xs text-rose"><%= @entry.errors.full_messages.to_sentence %></p>
        <% end %>
      </div>
    <% end %>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Type</th>
            <th scope="col" class="th text-right">Hours</th>
            <% if @timesheet.draft? && policy(@timesheet).update? %><th scope="col" class="th"></th><% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @timesheet.entries.empty? %>
            <tr><td colspan="<%= @timesheet.draft? ? 4 : 3 %>" class="empty-row">No entries yet.</td></tr>
          <% end %>
          <% @timesheet.entries.ordered.each do |entry| %>
            <tr class="hover:bg-cream">
              <td class="td text-mocha"><%= l(entry.worked_on, format: :long) %></td>
              <td class="td"><span class="pill-taupe capitalize"><%= entry.work_type %></span><% if entry.clock_shift_id %> <span class="pill-olive">Time clock</span><% end %><p class="text-xs"><%= entry.notes %></p></td>
              <td class="td text-right font-medium text-ink"><%= number_with_precision(entry.hours, precision: 2) %></td>
              <% if @timesheet.draft? && policy(@timesheet).update? %>
                <td class="td text-right">
                  <details><summary class="text-xs text-olive">Edit entry</summary>
                    <%= form_with url: update_entry_people_timesheet_path(@timesheet, entry_id: entry.id), method: :patch, scope: :timesheet_entry, class: 'space-y-2' do |f| %>
                      <%= f.label :worked_on, 'Date', for: "date-#{entry.id}" %><%= f.date_field :worked_on, id: "date-#{entry.id}", value: entry.worked_on, required: true, class: 'input' %>
                      <%= f.label :hours, 'Hours', for: "hours-#{entry.id}" %><%= f.number_field :hours, id: "hours-#{entry.id}", value: entry.hours, min: 0.01, max: 24, step: 0.01, required: true, class: 'input' %>
                      <%= f.label :work_type, 'Type', for: "type-#{entry.id}" %><%= f.select :work_type, People::TimesheetEntry::WORK_TYPES, { selected: entry.work_type }, id: "type-#{entry.id}", class: 'select' %>
                      <%= f.label :notes, 'Notes', for: "notes-#{entry.id}" %><%= f.text_field :notes, id: "notes-#{entry.id}", value: entry.notes, maxlength: 1000, class: 'input' %>
                      <%= f.submit 'Save entry', class: 'btn-primary btn-sm' %>
                    <% end %>
                  </details>
                  <%= button_to "Remove", remove_entry_people_timesheet_path(@timesheet, entry_id: entry.id), method: :post, class: "text-xs font-semibold text-rose hover:underline" %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @timesheet.notes.present? %>
    <section class="card card-pad">
      <h2 class="font-display text-lg text-ink">Notes</h2>
      <p class="mt-1 whitespace-pre-wrap text-sm text-mocha"><%= @timesheet.notes %></p>
    </section>
  <% end %>
  <% if @timesheet.review_note.present? %>
    <section class="card card-pad"><h2 class="font-display text-lg">Review comment</h2><p class="whitespace-pre-wrap"><%= @timesheet.review_note %></p></section>
  <% end %>
  <section class="card card-pad space-y-2">
    <h2 class="font-display text-lg">History</h2>
    <% @timesheet.events.includes(:user).order(:id).each do |event| %>
      <p class="text-sm"><%= l(event.created_at, format: :short) %> · <%= event.action.humanize %> · <%= event.user&.display_name || 'Former account' %></p>
    <% end %>
  </section>
</div>
