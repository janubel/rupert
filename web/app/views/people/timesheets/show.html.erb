<% content_for :title, "Timesheet" %>
<% editable = policy(@timesheet).update? && @timesheet.draft? %>
<% reviewing = policy(@timesheet).approve? && @timesheet.submitted? %>
<% menu = [] %>
<% menu << ['Download CSV', people_timesheet_path(@timesheet, format: :csv), { data: { turbo: false } }] %>
<% menu << ["Earlier: #{@previous_sheet.period_label}", people_timesheet_path(@previous_sheet)] if @previous_sheet %>
<% menu << ["Later: #{@next_sheet.period_label}", people_timesheet_path(@next_sheet)] if @next_sheet %>
<% if editable %>
  <% menu << ['Import clock shifts', import_shifts_people_timesheet_path(@timesheet), { method: :post }] %>
  <% menu << ['Edit', edit_people_timesheet_path(@timesheet)] %>
  <% menu << ['Delete draft', people_timesheet_path(@timesheet), { method: :delete, data: { turbo_confirm: 'Delete this draft and its entries?' } }] %>
<% end %>
<% if policy(@timesheet).reopen? && (@timesheet.approved? || @timesheet.rejected?) && !@timesheet.payroll_locked? %>
  <% menu << ['Reopen for editing', reopen_people_timesheet_path(@timesheet), { method: :post }] %>
<% end %>
<% status_pill = @timesheet.approved? ? "pill-fern" : @timesheet.submitted? ? "pill-olive" : @timesheet.rejected? ? "pill-rose" : "pill-taupe" %>
<div class="space-y-6">
  <%= render 'people/timesheets/demo_header', timesheet: @timesheet if @timesheet.demo? %>
  <%= page_header @timesheet.period_label, subtitle: @timesheet.employee.name, menu: menu do %>
    <% if editable %><%= button_to 'Submit for review', submit_people_timesheet_path(@timesheet), class: 'btn-primary' %><% end %>
  <% end %>

  <dl class="facts">
    <div><dt>Status</dt><dd><span class="<%= status_pill %>"><%= @timesheet.status.humanize %></span></dd></div>
    <% if @timesheet.submitted_at %><div><dt>Submitted</dt><dd><%= l(@timesheet.submitted_at, format: :short) %></dd></div><% end %>
    <% if @timesheet.reviewer %><div><dt>Reviewed by</dt><dd><%= @timesheet.reviewer.display_name %></dd></div><% end %>
    <% if @timesheet.assigned_reviewer %><div><dt>Assigned to</dt><dd><%= @timesheet.assigned_reviewer.display_name %></dd></div><% end %>
  </dl>

  <% if reviewing %>
    <section class="section-card" aria-label="Review checklist">
      <%= section_heading 'Before approving', hint: "Check the dates, daily hours, overtime and notes below against the staff member's shifts." %>
      <%= fold_explainer('Approval rechecks entries, imported clock hours and pending corrections. Return the timesheet for correction if anything needs changing.', class: 'text-sm text-mocha') %>
      <% if @summary.flags.any? %><p class="flex flex-wrap gap-2"><% @summary.flags.each do |flag| %><span class="pill-clay"><%= flag %></span><% end %></p><% end %>
      <%= form_with url: approve_people_timesheet_path(@timesheet), class: 'flex flex-wrap items-end gap-2' do |f| %>
        <div class="toolbar-field">
          <%= f.label :review_note, 'Review comment', class: 'field-label' %>
          <%= f.text_field :review_note, maxlength: 4000, placeholder: 'Optional', class: 'input' %>
        </div>
        <div class="toolbar-actions">
          <%= f.submit 'Approve', class: 'btn-primary' %>
          <% if @next_awaiting %><%= f.submit 'Approve & next', name: 'continue', class: 'btn-ghost' %><% end %>
          <%= f.submit 'Return for correction', formaction: reject_people_timesheet_path(@timesheet), class: 'btn-ghost' %>
        </div>
      <% end %>
      <% if @next_awaiting %><p class="text-sm"><%= link_to "Skip to next awaiting review: #{@next_awaiting.employee.name}", people_timesheet_path(@next_awaiting), class: 'text-olive underline' %></p><% end %>
    </section>
  <% end %>

  <section class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6" aria-label="Hours and compensation">
    <div class="stat">
      <p class="stat-label">Total hours</p>
      <p class="stat-value mt-1"><%= number_with_precision(@timesheet.total_hours, precision: 1) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Regular</p>
      <p class="stat-value mt-1"><%= number_with_precision(@timesheet.regular_hours, precision: 1) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Overtime</p>
      <p class="stat-value mt-1"><%= number_with_precision(@timesheet.overtime_hours, precision: 1) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Commission (1%)</p>
      <p class="stat-value mt-1"><%= number_to_currency(@timesheet.commission_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Card bonus (<%= @timesheet.card_redemptions %> &times; $10)</p>
      <p class="stat-value mt-1"><%= number_to_currency(@timesheet.card_bonus_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Compensation total</p>
      <p class="stat-value mt-1"><%= number_to_currency(@timesheet.compensation_total_cents / 100.0) %></p>
    </div>
  </section>

  <% days = (@timesheet.period_start..@timesheet.period_end).to_a %>
  <% by_day = @timesheet.entries.group_by(&:worked_on) %>
  <section class="section-card" aria-label="Daily hours">
    <%= section_heading 'Day by day' %>
    <div class="table-region" role="region" tabindex="0" aria-label="Hours by day">
      <table class="table">
        <thead><tr>
          <% days.each do |day| %><th scope="col" class="th text-center"><%= day.strftime('%a') %><br><span class="font-normal"><%= day.strftime('%b %-d') %></span></th><% end %>
        </tr></thead>
        <tbody><tr>
          <% days.each do |day| %>
            <% hours = (by_day[day] || []).sum(&:hours) %>
            <td class="td text-center <%= hours > TimesheetInsights::LONG_DAY_HOURS ? 'font-semibold text-rose' : hours.zero? ? 'text-taupe' : 'text-ink' %>"><%= hours.zero? ? '–' : number_with_precision(hours, precision: 2, strip_insignificant_zeros: true) %></td>
          <% end %>
        </tr></tbody>
      </table>
    </div>
  </section>

  <section class="section-card">
    <%= section_heading 'Entries' %>

    <% if editable %>
      <div class="rounded-card bg-haze/40 p-4">
        <p class="text-xs text-taupe">Add a day's hours to this draft.</p>
        <%= form_with model: [@timesheet, @entry], scope: :timesheet_entry, url: add_entry_people_timesheet_path(@timesheet), method: :post, class: "mt-2 flex flex-wrap items-end gap-2" do |f| %>
          <div>
            <%= f.label :worked_on, "Date", class: "field-label" %>
            <%= f.date_field :worked_on, class: "input" %>
          </div>
          <div>
            <%= f.label :hours, "Hours", class: "field-label" %>
            <%= f.number_field :hours, step: 0.25, min: 0.25, max: 24, value: @entry.hours.positive? ? @entry.hours : 8, class: "input w-24" %>
          </div>
          <div>
            <%= f.label :work_type, "Type", class: "field-label" %>
            <%= f.select :work_type, People::TimesheetEntry::WORK_TYPES.map { |t| [t.humanize, t] }, {}, class: "select w-auto" %>
          </div>
          <div><%= f.label :notes, "Entry notes", class: "field-label" %><%= f.text_field :notes, maxlength: 1000, class: "input" %></div>
          <%= f.submit "Add entry", class: "btn-primary btn-sm" %>
        <% end %>
        <% if @entry.errors.any? %>
          <p class="mt-2 text-xs text-rose"><%= @entry.errors.full_messages.to_sentence %></p>
        <% end %>
      </div>
    <% end %>

    <div class="table-region" role="region" tabindex="0" aria-label="Timesheet entries">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Type</th>
            <th scope="col" class="th num">Hours</th>
            <% if editable %><th scope="col" class="th"><span class="sr-only">Actions</span></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% if @timesheet.entries.empty? %>
            <tr><td colspan="<%= @timesheet.draft? ? 4 : 3 %>" class="empty-row">No entries yet.</td></tr>
          <% end %>
          <% @timesheet.entries.ordered.each do |entry| %>
            <tr>
              <td class="td text-mocha"><%= l(entry.worked_on, format: :long) %></td>
              <td class="td"><span class="pill-taupe"><%= entry.work_type.humanize %></span><% if entry.clock_shift_id %> <span class="pill-olive">Time clock</span><% end %><p class="text-xs"><%= entry.notes %></p></td>
              <td class="td num font-medium text-ink"><%= number_with_precision(entry.hours, precision: 2) %></td>
              <% if editable %>
                <td class="td text-right">
                  <details class="explainer"><summary class="explainer-summary">Edit entry</summary>
                    <%= form_with url: update_entry_people_timesheet_path(@timesheet, entry_id: entry.id), method: :patch, scope: :timesheet_entry, class: 'mt-2 space-y-2 text-left' do |f| %>
                      <div><%= f.label :worked_on, 'Date', for: "date-#{entry.id}", class: 'field-label' %><%= f.date_field :worked_on, id: "date-#{entry.id}", value: entry.worked_on, required: true, class: 'input' %></div>
                      <div><%= f.label :hours, 'Hours', for: "hours-#{entry.id}", class: 'field-label' %><%= f.number_field :hours, id: "hours-#{entry.id}", value: entry.hours, min: 0.01, max: 24, step: 0.01, required: true, class: 'input' %></div>
                      <div><%= f.label :work_type, 'Type', for: "type-#{entry.id}", class: 'field-label' %><%= f.select :work_type, People::TimesheetEntry::WORK_TYPES, { selected: entry.work_type }, id: "type-#{entry.id}", class: 'select' %></div>
                      <div><%= f.label :notes, 'Notes', for: "notes-#{entry.id}", class: 'field-label' %><%= f.text_field :notes, id: "notes-#{entry.id}", value: entry.notes, maxlength: 1000, class: 'input' %></div>
                      <%= f.submit 'Save entry', class: 'btn-primary btn-sm' %>
                    <% end %>
                  </details>
                  <%= button_to "Remove", remove_entry_people_timesheet_path(@timesheet, entry_id: entry.id), method: :post, class: "btn-ghost btn-sm text-rose" %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section-card">
    <%= section_heading 'Compensation breakdown', hint: 'Commission is 1% of credited period sales; the staff 50%-off card adds a $10 bonus per redemption. Display figures only, not posted to payroll.' %>
    <dl class="facts">
      <div><dt>Credited sales</dt><dd><%= number_to_currency(@timesheet.sales_cents / 100.0) %></dd></div>
      <div><dt>Commission (1%)</dt><dd><%= number_to_currency(@timesheet.commission_cents / 100.0) %></dd></div>
      <div><dt>Card redemptions</dt><dd><%= @timesheet.card_redemptions %></dd></div>
      <div><dt>Card bonus</dt><dd><%= number_to_currency(@timesheet.card_bonus_cents / 100.0) %></dd></div>
    </dl>
  </section>

  <% if @timesheet.notes.present? %>
    <section class="section-card">
      <%= section_heading 'Notes' %>
      <p class="whitespace-pre-wrap text-sm text-mocha"><%= @timesheet.notes %></p>
    </section>
  <% end %>
  <% if @timesheet.review_note.present? %>
    <section class="section-card"><%= section_heading 'Review comment' %><p class="whitespace-pre-wrap text-sm"><%= @timesheet.review_note %></p></section>
  <% end %>
  <section class="section-card">
    <%= section_heading 'History' %>
    <ul class="space-y-1 text-sm">
      <% @timesheet.events.includes(:user).order(:id).each do |event| %>
        <li><%= l(event.created_at, format: :short) %> · <%= event.action.humanize %> · <%= event.user&.display_name || 'Former account' %></li>
      <% end %>
    </ul>
  </section>
</div>
