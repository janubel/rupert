<% content_for :title, "Timesheets" %>
<div class="space-y-6">
  <%= render 'people/timesheets/demo_header' if @has_demo_timesheets %>
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Timesheets</h1>
      <p class="mt-1 text-sm text-mocha"><%= Current.user.employee? ? (@reviewer ? 'Your timesheets and assigned demo reviews.' : 'Your hours by week, submitted for review.') : 'Hours by week per employee, submitted for review.' %></p>
    </div>
    <% if policy(People::Timesheet).create? %>
      <%= link_to "New timesheet", new_people_timesheet_path, class: "btn-primary" %>
    <% end %>
    <%= link_to "My time home", employee_app_path, class: "btn-ghost btn-sm" %>
  </section>

  <% if @reviewer %>
    <nav aria-label="Timesheet review" class="flex flex-wrap gap-2">
      <% [['Needs review', 'submitted'], ['All timesheets', 'all'], ['Approved', 'approved'], ['Returned for correction', 'rejected']].each do |label, status| %>
        <%= link_to (status == 'submitted' ? "#{label} (#{@awaiting})" : label), people_timesheets_path(status: status), class: "nav-pill #{@status == status ? 'nav-pill-active' : 'nav-pill-idle'}", aria: { current: (@status == status ? 'page' : nil) } %>
      <% end %>
    </nav>
    <p class="text-sm text-mocha">Review each day's hours and notes, then approve or return for correction. Your own timesheets need another reviewer. Demo hours are always excluded from payroll.</p>

    <section class="space-y-3" aria-label="Timesheet navigation">
      <h2 class="text-lg font-semibold">Where to go next</h2>
      <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-6">
        <%= link_to people_employees_path, class: 'card card-pad space-y-1 hover:bg-cream' do %>
          <h3 class="font-semibold">Employees</h3>
          <p class="text-sm text-mocha">Profiles, pay rates and leave balances.</p>
        <% end %>
        <%= link_to people_leave_requests_path, class: 'card card-pad space-y-1 hover:bg-cream' do %>
          <h3 class="font-semibold">Vacation &amp; time off<%= " (#{@pending_leave_count})" if @pending_leave_count&.positive? %></h3>
          <p class="text-sm text-mocha">Requests, approvals and denials.</p>
        <% end %>
        <%= link_to people_punch_history_path, class: 'card card-pad space-y-1 hover:bg-cream' do %>
          <h3 class="font-semibold">Punch calendar</h3>
          <p class="text-sm text-mocha">Every clock punch, drag to pick dates.</p>
        <% end %>
        <%= link_to people_pay_runs_path, class: 'card card-pad space-y-1 hover:bg-cream' do %>
          <h3 class="font-semibold">Payroll</h3>
          <p class="text-sm text-mocha">Pay runs and finalized payslips.</p>
        <% end %>
        <%= link_to people_square_timesheets_path, class: 'card card-pad space-y-1 hover:bg-cream' do %>
          <h3 class="font-semibold">Square history</h3>
          <p class="text-sm text-mocha">Imported timecards and breaks.</p>
        <% end %>
        <%= link_to people_ctrax_timesheets_path, class: 'card card-pad space-y-1 hover:bg-cream' do %>
          <h3 class="font-semibold">C-Trax shifts</h3>
          <p class="text-sm text-mocha">Register shifts, unapproved history.</p>
        <% end %>
      </div>
    </section>

    <section class="space-y-3" aria-label="Upcoming weeks">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-lg font-semibold">Upcoming weeks</h2>
        <p class="text-sm text-mocha">Timesheets on file per week. Open a week to review what is in it.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <% @upcoming_weeks.each do |week| %>
          <%= link_to people_timesheets_path(period: week[:monday].iso8601, status: 'all'), class: 'card card-pad space-y-2 hover:bg-cream' do %>
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="font-semibold"><%= week[:label] %></h3>
              <span class="text-sm text-mocha"><%= week[:monday].strftime('%b %-d') %> – <%= (week[:monday] + 6).strftime('%b %-d') %></span>
            </div>
            <p class="text-2xl font-semibold"><%= week[:total] %></p>
            <p class="text-sm text-mocha">
              <%= week[:submitted] %> awaiting review · <%= week[:approved] %> approved<% if week[:draft].positive? %> · <%= week[:draft] %> draft<% end %><% if week[:rejected].positive? %> · <%= week[:rejected] %> returned<% end %>
            </p>
          <% end %>
        <% end %>
      </div>
    </section>

    <section class="space-y-3" aria-label="Upcoming time off">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-lg font-semibold">Upcoming time off</h2>
        <%= link_to 'All requests', people_leave_requests_path, class: 'text-sm text-olive underline' %>
      </div>
      <% if @upcoming_leave.empty? %>
        <p class="card card-pad text-sm text-mocha">No upcoming vacation or time off on file.</p>
      <% else %>
        <div class="card overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="border-b border-fog bg-haze/60">
                <tr>
                  <th scope="col" class="th">Employee</th>
                  <th scope="col" class="th">Type</th>
                  <th scope="col" class="th">Dates</th>
                  <th scope="col" class="th">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-fog">
                <% @upcoming_leave.each do |leave| %>
                  <tr class="hover:bg-cream">
                    <td class="td font-medium text-ink"><%= leave.employee&.name %></td>
                    <td class="td"><%= leave.leave_type.titleize %></td>
                    <td class="td"><%= leave.starts_on.strftime('%b %-d') %> – <%= leave.ends_on.strftime('%b %-d') %></td>
                    <td class="td"><span class="<%= leave.approved? ? 'pill-fern' : leave.requested? ? 'pill-olive' : 'pill-taupe' %>"><%= leave.status %></span></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="space-y-3" aria-label="Employee time sources">
    <h2 class="text-lg font-semibold"><%= Current.user.employee? ? 'Your time sources' : 'All employee time sources' %></h2>
    <p class="text-sm text-mocha">Rupert submissions, Square timecards and C-Trax shifts are separate records. Review each source; overlapping hours must not be added together. Source records do not approve hours or create a payroll payment.</p>
    <div class="grid gap-3 sm:grid-cols-3">
      <article class="card card-pad space-y-2"><h3 class="font-semibold">Rupert timesheets</h3><p class="text-sm text-mocha">Weekly entries and approval history.</p><%= link_to 'View all Rupert timesheets', people_timesheets_path(status: 'all'), class: 'text-sm text-olive underline' %></article>
      <article class="card card-pad space-y-2"><h3 class="font-semibold">Square timecards</h3><p class="text-sm text-mocha"><%= @square_history.count %> retained records, including open and held history. Counted Square history also appears in personal reports and calendars.</p><%= link_to 'View Square history', people_square_timesheets_path, class: 'text-sm text-olive underline' %></article>
      <article class="card card-pad space-y-2"><h3 class="font-semibold">C-Trax shifts</h3><p class="text-sm text-mocha"><%= @ctrax_history.count %> retained records. Source-reported hours and elapsed time remain unapproved history.</p><%= link_to 'View C-Trax history', people_ctrax_timesheets_path, class: 'text-sm text-olive underline' %></article>
      <article class="card card-pad space-y-2"><h3 class="font-semibold">Punch history</h3><p class="text-sm text-mocha">Every Rupert clock punch and imported Square timecard in one calendar or list, with a CSV report.</p><%= link_to 'View punch history', people_punch_history_path, class: 'text-sm text-olive underline' %></article>
      <article class="card card-pad space-y-2"><h3 class="font-semibold">Team schedule</h3><p class="text-sm text-mocha">Employee × day grid of hours worked from all sources.</p><%= link_to 'View team schedule', people_team_schedule_path, class: 'text-sm text-olive underline' %></article>
    </div>
  </section>
  <% if @awaiting.positive? %>
    <div class="rounded-xl border border-olive/30 bg-olive/10 px-4 py-2.5 text-sm text-olive"><%= @awaiting %> timesheet<%= @awaiting == 1 ? "" : "s" %> awaiting review.</div>
  <% end %>

  <nav aria-label="Timesheet view" class="flex flex-wrap gap-2">
    <%= link_to 'Rupert timesheets', people_timesheets_path(request.query_parameters.merge(view: 'list')), class: "nav-pill #{@view == 'list' ? 'nav-pill-active' : 'nav-pill-idle'}" %>
    <%= link_to 'All sources (unified)', people_timesheets_path(request.query_parameters.merge(view: 'unified')), class: "nav-pill #{@view == 'unified' ? 'nav-pill-active' : 'nav-pill-idle'}" %>
    <%= link_to 'Calendar', people_timesheets_path(request.query_parameters.merge(view: 'calendar', month: (@month || Date.current).strftime('%Y-%m'))), class: "nav-pill #{@view == 'calendar' ? 'nav-pill-active' : 'nav-pill-idle'}" %>
  </nav>

  <% if @view == 'calendar' %>
  <section class="card card-pad space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-lg font-semibold"><%= @month.strftime('%B %Y') %></h2>
      <div class="flex gap-2">
        <%= link_to 'Previous', people_timesheets_path(request.query_parameters.merge(view: 'calendar', month: @prev_month.strftime('%Y-%m'))), class: 'btn-ghost btn-sm' %>
        <%= link_to 'Next', people_timesheets_path(request.query_parameters.merge(view: 'calendar', month: @next_month.strftime('%Y-%m'))), class: 'btn-ghost btn-sm' %>
        <%= link_to 'Today', people_timesheets_path(request.query_parameters.merge(view: 'calendar', month: Date.current.strftime('%Y-%m'))), class: 'btn-ghost btn-sm' %>
      </div>
    </div>
    <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold uppercase tracking-wide text-mocha">
      <% Date::DAYNAMES.rotate.each do |day| %><div class="py-1"><%= day %></div><% end %>
    </div>
    <div class="grid grid-cols-7 gap-1">
      <% @month_days.each do |day| %>
        <% bucket = @calendar_days[day.iso8601] %>
        <div class="min-h-20 rounded-xl border border-fog p-2 text-left <%= bucket && (bucket[:timesheets].any? || bucket[:punches].positive?) ? 'bg-haze/40' : 'bg-cream' %>" role="button" tabindex="0" aria-label="<%= day.strftime('%B %-d, %Y') %>">
          <p class="text-xs font-semibold <%= day == Date.current ? 'text-olive' : 'text-ink' %>"><%= day.day %></p>
          <% if bucket && bucket[:timesheets].any? %>
            <% bucket[:timesheets].each do |ts| %>
              <p class="mt-1 text-xs font-semibold <%= ts.approved? ? 'text-fern' : ts.submitted? ? 'text-olive-deep' : ts.rejected? ? 'text-rose' : 'text-taupe' %>" title="<%= ts.employee&.name %>"><%= ts.employee&.name&.split&.first %> · <%= ts.status %></p>
            <% end %>
          <% end %>
          <% if bucket && bucket[:punches].positive? %>
            <p class="mt-1 text-xs text-mocha"><%= bucket[:punches] %> punch<%= bucket[:punches] == 1 ? '' : 'es' %> · <%= number_with_precision(bucket[:hours], precision: 1) %>h</p>
          <% end %>
        </div>
      <% end %>
    </div>
    <p class="text-xs text-taupe">Timesheets (weekly periods) and punches (daily) from Rupert, Square and C-Trax. Overlapping hours are never added together.</p>
  </section>
  <% elsif @view == 'unified' %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Source</th>
            <th scope="col" class="th">Employee</th>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th text-right">Hours</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th">Detail</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @unified_records.blank? %>
            <tr><td colspan="6" class="empty-row">No time records in this view.</td></tr>
          <% end %>
          <% @unified_records.each do |record| %>
            <tr class="hover:bg-cream">
              <td class="td"><span class="<%= record[:source_class] %>"><%= record[:source] %></span></td>
              <td class="td font-medium text-ink"><%= record[:employee] %></td>
              <td class="td text-mocha"><%= record[:date]&.strftime('%b %-d, %Y') || '—' %><% if record[:end_date] && record[:end_date] != record[:date] %> – <%= record[:end_date].strftime('%b %-d') %><% end %></td>
              <td class="td text-right text-mocha"><%= record[:hours].nil? ? '—' : number_with_precision(record[:hours], precision: 2) %></td>
              <td class="td"><span class="pill-taupe"><%= record[:status] %></span></td>
              <td class="td"><%= link_to (record[:detail].presence || 'View'), record[:path], class: 'text-olive hover:underline' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%== pagy_nav(@pagy) if @pagy && @pagy.pages > 1 %>
  <% else %>
  <%= form_tag people_timesheets_path, method: :get, class: "flex flex-wrap gap-2" do %>
    <select name="status" data-controller="auto-submit" data-action="change->auto-submit#submit" class="select w-auto">
      <option value="all" <%= @status == "all" ? "selected" : "" %>>All statuses</option>
      <% People::Timesheet.aasm.states.map(&:name).each do |status| %>
        <option value="<%= status %>" <%= @status == status.to_s ? "selected" : "" %>><%= status.to_s.titleize %></option>
      <% end %>
    </select>
    <input type="date" name="period" value="<%= params[:period] %>" class="input w-auto" title="Week of" aria-label="Week of">
    <%= link_to 'Export Rupert CSV', people_timesheets_path(format: :csv, status: @status, period: @period), class: 'btn-ghost btn-sm' %>
    <%= submit_tag "Filter", class: "btn-ghost btn-sm" %>
  <% end %>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Employee</th>
            <th scope="col" class="th">Period</th>
            <th scope="col" class="th text-right">Hours</th>
            <th scope="col" class="th text-right">Comp.</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th">Review</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @timesheets.empty? %>
            <tr><td colspan="6" class="empty-row"><%= @status == 'submitted' ? 'No timesheets awaiting review.' : 'No timesheets found.' %></td></tr>
          <% end %>
          <% @timesheets.each do |timesheet| %>
            <tr class="hover:bg-cream">
              <td class="td font-medium text-ink"><%= timesheet.employee&.name %><% if timesheet.demo? %><span class="ml-2 pill-taupe">DEMO</span><% end %></td>
              <td class="td"><%= link_to timesheet.period_label, people_timesheet_path(timesheet), class: "text-olive hover:underline" %></td>
              <td class="td text-right text-mocha"><%= number_with_precision(timesheet.total_hours, precision: 1) %></td>
              <td class="td text-right text-mocha" title="1% commission + $10/card bonus"><%= number_to_currency(timesheet.compensation_total_cents / 100.0) %></td>
              <td class="td">
                <span class="<%= timesheet.approved? ? "pill-fern" : timesheet.submitted? ? "pill-olive" : timesheet.rejected? ? "pill-rose" : "pill-taupe" %>"><%= timesheet.status %></span>
              </td>
              <td class="td">
                <%= link_to (timesheet.submitted? && policy(timesheet).approve? ? 'Review timesheet' : 'View timesheet'), people_timesheet_path(timesheet), class: 'text-olive underline' %>
                <% if timesheet.assigned_reviewer %><p class="text-xs text-mocha">Assigned to <%= timesheet.assigned_reviewer.display_name %></p><% end %>
                <% if @reviewer && timesheet.submitted? && !policy(timesheet).approve? %><p class="text-xs text-mocha">Another reviewer required</p><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  <% end %>

  <% if @view == 'unified' %>
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-fog bg-haze/60">
            <tr>
              <th scope="col" class="th">Source</th>
              <th scope="col" class="th">Employee</th>
              <th scope="col" class="th">Date</th>
              <th scope="col" class="th text-right">Hours</th>
              <th scope="col" class="th">Status</th>
              <th scope="col" class="th">Detail</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-fog">
            <% if @unified_records.blank? %>
              <tr><td colspan="6" class="empty-row">No time records in this view.</td></tr>
            <% end %>
            <% @unified_records.each do |record| %>
              <tr class="hover:bg-cream">
                <td class="td"><span class="<%= record[:source_class] %>"><%= record[:source] %></span></td>
                <td class="td font-medium text-ink"><%= record[:employee] %></td>
                <td class="td text-mocha"><%= record[:date]&.strftime('%b %-d, %Y') || '—' %><% if record[:end_date] && record[:end_date] != record[:date] %> – <%= record[:end_date].strftime('%b %-d') %><% end %></td>
                <td class="td text-right text-mocha"><%= record[:hours].nil? ? '—' : number_with_precision(record[:hours], precision: 2) %></td>
                <td class="td"><span class="pill-taupe"><%= record[:status] %></span></td>
                <td class="td"><%= link_to (record[:detail].presence || 'View'), record[:path], class: 'text-olive hover:underline' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  <% end %>
</div>
