<div class="card card-pad">
  <%= form_with model: timesheet, scope: :timesheet, url: (timesheet.persisted? ? people_timesheet_path(timesheet) : people_timesheets_path), class: "space-y-6" do |f| %>
    <% if timesheet.errors.any? %><div role="alert" class="flash flash-alert"><%= timesheet.errors.full_messages.to_sentence %></div><% end %>
    <fieldset class="space-y-4">
      <legend class="card-title">Week</legend>
      <% if Current.user.employee? %>
        <%= f.hidden_field :employee_id, value: @employees.first&.id %>
      <% else %>
      <div>
        <%= f.label :employee_id, "Staff member", class: "field-label" %>
        <%= f.select :employee_id, @employees.map { |e| [e.name, e.id] }, { include_blank: "Select staff member…" }, class: "select w-full", required: true, disabled: timesheet.persisted? %>
      </div>
      <% end %>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :period_start, "Week starts", class: "field-label" %>
          <%= f.date_field :period_start, class: "input" %>
        </div>
        <div>
          <%= f.label :period_end, "Week ends", class: "field-label" %>
          <%= f.date_field :period_end, class: "input" %>
        </div>
      </div>
      <div>
        <%= f.label :notes, "Notes", class: "field-label" %>
        <%= f.text_area :notes, rows: 2, class: "input" %>
      </div>
    </fieldset>
    <div class="form-actions">
      <%= f.submit "Save", class: "btn-primary" %>
      <%= link_to "Cancel", timesheet.persisted? ? people_timesheet_path(timesheet) : people_timesheets_path, class: "btn-ghost" %>
    </div>
  <% end %>
</div>
