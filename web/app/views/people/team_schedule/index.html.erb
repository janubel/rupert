<% content_for :title, "Team schedule" %>
<div class="space-y-6">
  <%= page_header 'Team schedule', subtitle: 'Hours worked per staff member per day.' %>

  <section class="toolbar-band">
    <nav class="toolbar" aria-label="Week">
      <div class="date-stepper">
        <%= link_to '‹', people_team_schedule_path(week: @prev_week.iso8601), class: 'btn-ghost btn-sm', aria: { label: 'Previous week' }, title: 'Previous week' %>
        <h2 class="section-title"><%= @week.strftime('%b %-d') %> – <%= (@week + 6).strftime('%b %-d, %Y') %></h2>
        <%= link_to '›', people_team_schedule_path(week: @next_week.iso8601), class: 'btn-ghost btn-sm', aria: { label: 'Next week' }, title: 'Next week' %>
      </div>
      <% unless Date.current.between?(@week, @week + 6) %><%= link_to 'This week', people_team_schedule_path, class: 'btn-ghost btn-sm' %><% end %>
    </nav>
  </section>

  <div class="card">
    <div class="table-region" role="region" tabindex="0" aria-label="Hours worked by day">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Staff member</th>
            <% @week_days.each do |day| %>
              <th scope="col" class="th num <%= day == Date.current ? 'text-olive' : '' %>"><%= day.strftime('%a') %><br><span class="text-xs font-normal text-taupe"><%= day.strftime('%-d') %></span></th>
            <% end %>
            <th scope="col" class="th num">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @employees.each do |employee| %>
            <% row_hours = @hours[employee.id] || {} %>
            <% total = row_hours.values.sum %>
            <tr>
              <td class="td whitespace-nowrap font-medium text-ink"><%= employee.name %></td>
              <% @week_days.each do |day| %>
                <% h = row_hours[day.iso8601].to_f %>
                <td class="td num <%= h.positive? ? 'font-semibold text-olive-deep' : 'text-taupe' %>"><%= h.positive? ? number_with_precision(h, precision: 1) : '—' %></td>
              <% end %>
              <td class="td num font-semibold text-ink"><%= number_with_precision(total, precision: 1) %>h</td>
            </tr>
          <% end %>
          <% if @employees.empty? %>
            <tr><td colspan="9" class="empty-row">No active staff. Add a staff member to see their hours here.</td></tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="border-t border-fog bg-haze/40">
            <td class="td font-semibold text-ink">Team total</td>
            <% @week_days.each do |day| %>
              <% col_total = @employees.sum { |e| (@hours[e.id] || {})[day.iso8601].to_f } %>
              <td class="td num font-semibold text-ink"><%= col_total.positive? ? number_with_precision(col_total, precision: 1) : '—' %></td>
            <% end %>
            <td class="td num font-bold text-ink"><%= number_with_precision(@employees.sum { |e| (@hours[e.id] || {}).values.sum }, precision: 1) %>h</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <p class="text-xs text-taupe">Read-only. Hours combine Rupert punches, Square timecards and C-Trax shifts per day; overlapping hours from several sources are summed, so review before relying on totals.</p>
</div>
