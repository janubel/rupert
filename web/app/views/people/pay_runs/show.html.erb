<% content_for :title, @pay_run.name %>
<% can_write = Current.user.can?("payroll.write") %>
<% menu = [] %>
<% menu << ['Regenerate from timesheets', generate_payslips_people_pay_run_path(@pay_run), { method: :post, data: { turbo_confirm: "Rebuild all payslips from approved timesheets? Manual payslips will be replaced." } }] if can_write && @pay_run.draft? %>
<div class="space-y-6">
  <%= page_header @pay_run.name, subtitle: @pay_run.period_label, menu: menu do %>
    <% if can_write && @pay_run.draft? %>
      <%= button_to "Finalize", finalize_people_pay_run_path(@pay_run), method: :post, class: "btn-primary", data: { turbo_confirm: "Lock in these payslips and totals?" } %>
    <% elsif can_write && @pay_run.finalized? %>
      <%= button_to "Mark paid", pay_people_pay_run_path(@pay_run), method: :post, class: "btn-primary", data: { turbo_confirm: "Mark this pay run as paid?" } %>
    <% end %>
  <% end %>

  <dl class="facts">
    <div><dt>Status</dt><dd><span class="<%= @pay_run.paid? ? "pill-fern" : @pay_run.finalized? ? "pill-olive" : "pill-taupe" %>"><%= @pay_run.status.humanize %></span></dd></div>
    <% if @pay_run.paid_on %><div><dt>Paid</dt><dd><%= l(@pay_run.paid_on, format: :long) %></dd></div><% end %>
    <div><dt>Staff</dt><dd><%= @pay_run.payslips.count %></dd></div>
  </dl>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3" aria-label="Pay run totals">
    <div class="stat">
      <div class="stat-label">Gross<%= define('gross_pay') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@pay_run.total_gross_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Deductions<%= define('deductions') %></div>
      <p class="stat-value mt-1"><%= number_to_currency((@pay_run.total_gross_cents - @pay_run.total_net_cents) / 100.0) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Net to pay<%= define('net_pay') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@pay_run.total_net_cents / 100.0) %></p>
      <%= explain_calculation(title: 'Net to pay for this run', id: 'pay-run-net',
            formula: 'Gross − deductions, payslip by payslip, then added across the run. Each payslip’s gross is hours × rate, or the salary share for the period, or a manual amount.',
            rows: [['Gross (all payslips)', number_to_currency(@pay_run.total_gross_cents / 100.0)], ['Deductions', "− #{number_to_currency((@pay_run.total_gross_cents - @pay_run.total_net_cents) / 100.0)}"],
                   ['Net to pay', number_to_currency(@pay_run.total_net_cents / 100.0)]],
            note: 'Deductions not entered by hand are filled with a flat 15% estimate when the run is finalized. That is a placeholder, not a tax calculation, and marking the run paid moves no money.',
            term: 'net_pay') %>
    </div>
  </section>

  <section class="section-card">
    <%= section_heading 'Payslips' %>

    <% if @pay_run.draft? && can_write %>
      <div class="rounded-card bg-haze/40 p-4">
        <p class="text-xs text-taupe">Add a manual payslip (bonus, commission, off-cycle). Deductions default to a 15% tax estimate on finalize.</p>
        <%= form_with model: [@pay_run, @slip], url: add_payslip_people_pay_run_path(@pay_run), method: :post, class: "mt-2 flex flex-wrap items-end gap-2" do |f| %>
          <div>
            <%= f.label :employee_id, "Staff member", class: "field-label" %>
            <%= f.select :employee_id, @employees.map { |e| [e.name, e.id] }, { include_blank: "…" }, class: "select w-auto", required: true %>
          </div>
          <div>
            <%= f.label :gross_cents, "Gross $", class: "field-label" %>
            <%= f.number_field :gross_cents, step: 100, min: 0, class: "input w-32" %>
          </div>
          <div>
            <%= f.label :deductions_cents, "Deductions $", class: "field-label" %>
            <%= f.number_field :deductions_cents, step: 100, min: 0, value: 0, class: "input w-32" %>
          </div>
          <div>
            <%= f.label :hours, "Hours", class: "field-label" %>
            <%= f.number_field :hours, step: 0.25, min: 0, value: 0, class: "input w-24" %>
          </div>
          <%= f.submit "Add payslip", class: "btn-primary btn-sm" %>
        <% end %>
        <% if @slip&.errors&.any? %>
          <p class="mt-2 text-xs text-rose"><%= @slip.errors.full_messages.to_sentence %></p>
        <% end %>
      </div>
    <% end %>

    <div class="table-region" role="region" tabindex="0" aria-label="Payslips">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Staff member</th>
            <th scope="col" class="th">Rate</th>
            <th scope="col" class="th num">Hours<%= define('timesheet') %></th>
            <th scope="col" class="th num">Gross<%= define('gross_pay') %></th>
            <th scope="col" class="th num">Deductions<%= define('deductions') %></th>
            <th scope="col" class="th num">Net<%= define('net_pay') %></th>
            <% if @pay_run.draft? && can_write %><th scope="col" class="th"><span class="sr-only">Actions</span></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% if @pay_run.payslips.empty? %>
            <tr><td colspan="<%= @pay_run.draft? ? 7 : 6 %>" class="empty-row">No payslips yet. Regenerate from timesheets or add one by hand.</td></tr>
          <% end %>
          <% @pay_run.payslips.includes(:employee, :pay_rate).order(id: :asc).each do |slip| %>
            <tr>
              <td class="td font-medium text-ink"><%= link_to slip.employee&.name, people_employee_path(slip.employee), class: "hover:text-olive hover:underline" %></td>
              <td class="td text-mocha"><%= slip.pay_rate&.label || "—" %></td>
              <td class="td num"><%= number_with_precision(slip.hours, precision: 1) %></td>
              <td class="td num"><%= number_to_currency(slip.gross_cents / 100.0) %></td>
              <td class="td num"><%= number_to_currency(slip.deductions_cents / 100.0) %></td>
              <td class="td num font-medium text-ink"><%= number_to_currency(slip.net_cents / 100.0) %></td>
              <% if @pay_run.draft? && can_write %>
                <td class="td text-right"><%= button_to "Remove", remove_payslip_people_pay_run_path(@pay_run, payslip_id: slip.id), method: :post, class: "btn-ghost btn-sm text-rose" %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <% if @pay_run.notes.present? %>
    <section class="section-card">
      <%= section_heading 'Notes' %>
      <p class="whitespace-pre-wrap text-sm text-mocha"><%= @pay_run.notes %></p>
    </section>
  <% end %>
</div>
