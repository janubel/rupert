<% content_for :title, "Payroll" %>
<div class="space-y-6">
  <%= page_header 'Payroll', subtitle: 'Pay runs built from approved timesheets, finalized and paid.' do %>
    <% if Current.user.can?("payroll.write") %>
      <%= link_to "Add pay run", new_people_pay_run_path, class: "btn-primary" %>
    <% end %>
  <% end %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4" aria-label="Payroll totals">
    <div class="stat">
      <p class="stat-label">Gross · <%= @year %></p>
      <p class="stat-value mt-1"><%= number_to_currency(@annual_gross / 100.0) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Draft runs</p>
      <p class="stat-value mt-1"><%= People::PayRun.where(status: "draft").count %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Finalized</p>
      <p class="stat-value mt-1"><%= People::PayRun.where(status: "finalized").count %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Paid</p>
      <p class="stat-value mt-1"><%= People::PayRun.where(status: "paid").count %></p>
    </div>
  </section>

  <%= form_tag people_pay_runs_path, method: :get, class: "toolbar" do %>
    <div class="toolbar-field">
      <label class="field-label" for="pay-run-status">Status</label>
      <select id="pay-run-status" name="status" data-controller="auto-submit" data-action="change->auto-submit#submit" class="select">
        <option value="all" <%= @status == "all" ? "selected" : "" %>>All statuses</option>
        <% People::PayRun.aasm.states.map(&:name).each do |status| %>
          <option value="<%= status %>" <%= @status == status.to_s ? "selected" : "" %>><%= status.to_s.humanize %></option>
        <% end %>
      </select>
    </div>
    <div class="toolbar-actions">
      <%= submit_tag 'Apply', class: 'btn-primary', name: nil %>
      <%= link_to 'Clear', people_pay_runs_path, class: 'btn-ghost' %>
    </div>
  <% end %>

  <div class="card">
    <div class="table-region" role="region" tabindex="0" aria-label="Pay runs">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Pay run</th>
            <th scope="col" class="th">Period</th>
            <th scope="col" class="th num">Payslips</th>
            <th scope="col" class="th num">Gross</th>
            <th scope="col" class="th num">Net</th>
            <th scope="col" class="th">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if @pay_runs.empty? %>
            <tr><td colspan="6" class="empty-row">No pay runs yet.<%= ' Add the first pay run.' if Current.user.can?("payroll.write") %></td></tr>
          <% end %>
          <% @pay_runs.each do |pay_run| %>
            <tr>
              <td class="td font-medium text-ink"><%= link_to pay_run.name, people_pay_run_path(pay_run), class: "hover:text-olive hover:underline" %></td>
              <td class="td text-mocha"><%= pay_run.period_label %></td>
              <td class="td num"><%= pay_run.payslips.count %></td>
              <td class="td num"><%= number_to_currency(pay_run.total_gross_cents / 100.0) %></td>
              <td class="td num font-medium text-ink"><%= number_to_currency(pay_run.total_net_cents / 100.0) %></td>
              <td class="td">
                <span class="<%= pay_run.paid? ? "pill-fern" : pay_run.finalized? ? "pill-olive" : "pill-taupe" %>"><%= pay_run.status.humanize %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
