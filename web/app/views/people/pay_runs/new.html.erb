<% content_for :title, "Add pay run" %>
<div class="page-narrow space-y-6">
  <%= page_header 'Add pay run', subtitle: 'Payslips are generated from approved timesheets in the period.' %>
  <div class="card card-pad">
    <%= form_with model: @pay_run, url: people_pay_runs_path, class: "space-y-6" do |f| %>
      <% if @pay_run.errors.any? %><div role="alert" class="flash flash-alert"><%= @pay_run.errors.full_messages.to_sentence %></div><% end %>
      <fieldset class="space-y-4">
        <legend class="card-title">Pay run</legend>
        <div>
          <%= f.label :name, "Pay run name", class: "field-label" %>
          <%= f.text_field :name, class: "input", autocomplete: "off", placeholder: "e.g. Pay #{Date.current.strftime("%B")} #{Date.current.day.ordinalize}" %>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= f.label :period_start, "Period starts", class: "field-label" %>
            <%= f.date_field :period_start, class: "input" %>
          </div>
          <div>
            <%= f.label :period_end, "Period ends", class: "field-label" %>
            <%= f.date_field :period_end, class: "input" %>
          </div>
        </div>
        <div>
          <%= f.label :notes, "Notes", class: "field-label" %>
          <%= f.text_area :notes, rows: 2, class: "input" %>
        </div>
      </fieldset>
      <div class="form-actions">
        <%= f.submit "Save", class: "btn-primary" %>
        <%= link_to "Cancel", people_pay_runs_path, class: "btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
