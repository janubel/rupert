<% content_for :title, @vendor.name %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title"><%= @vendor.name %></h1>
      <p class="mt-1 text-sm text-mocha">
        <% if @vendor.email.present? %><span><%= @vendor.email %></span><% end %>
        <% if @vendor.phone.present? %><span class="ml-2"><%= @vendor.phone %></span><% end %>
        <span class="ml-2 pill-taupe"><%= @vendor.payment_terms %></span>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Back to vendors", purchasing_vendors_path, class: "btn-ghost btn-sm" %>
      <%= link_to "New purchase order", new_purchasing_purchase_order_path(vendor_id: @vendor), class: "btn-primary btn-sm" %>
      <%= link_to "Edit", edit_purchasing_vendor_path(@vendor), class: "btn-ghost btn-sm" %>
      <%= button_to "Remove", @vendor, method: :delete, class: "btn-ghost btn-sm", data: { confirm: "Remove #{@vendor.name}?" } %>
    </div>
  </section>

  <% if @vendor.address.present? %>
    <section class="card card-pad max-w-xl">
      <h2 class="font-display text-lg text-ink">Address</h2>
      <p class="mt-1 whitespace-pre-wrap text-sm text-mocha"><%= @vendor.address %></p>
    </section>
  <% end %>

  <section class="card overflow-hidden">
    <div class="border-b border-fog px-5 py-3">
      <h2 class="font-display text-lg text-ink">Purchase orders</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Order</th>
            <th scope="col" class="th">Created</th>
            <th scope="col" class="th">Expected</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th text-right">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @purchase_orders.empty? %>
            <tr><td colspan="5" class="empty-row">No purchase orders yet.</td></tr>
          <% end %>
          <% @purchase_orders.each do |po| %>
            <tr class="hover:bg-cream">
              <td class="td font-medium text-ink"><%= link_to po.order_number, po, class: "hover:text-olive hover:underline" %></td>
              <td class="td text-mocha"><%= l(po.created_at.to_date, format: :short) %></td>
              <td class="td text-mocha"><%= po.expected_date ? l(po.expected_date, format: :short) : "—" %></td>
              <td class="td"><span class="<%= po.status == "received" ? "pill-fern" : po.status == "ordered" ? "pill-olive" : po.status == "cancelled" ? "pill-rose" : "pill-taupe" %>"><%= po.status %></span></td>
              <td class="td text-right font-medium text-ink"><%= number_to_currency(po.total_cents / 100.0) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
