<%= form_with model: vendor, url: (vendor.persisted? ? vendor : purchasing_vendors_path), class: 'space-y-4' do |f| %>
  <%= render 'shared/form_errors', model: vendor %>
  <fieldset class="space-y-4">
    <legend class="card-title">Contact</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :name, 'Vendor name', class: 'field-label' %>
        <%= f.text_field :name, class: 'input', placeholder: 'e.g. GreenLeaf Distributors', autocomplete: 'off' %>
      </div>
      <div>
        <%= f.label :contact_name, 'Contact person', class: 'field-label' %>
        <%= f.text_field :contact_name, class: 'input', autocomplete: 'off' %>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :email, 'Email', class: 'field-label' %>
        <%= f.email_field :email, class: 'input', autocomplete: 'off' %>
      </div>
      <div>
        <%= f.label :phone, 'Phone', class: 'field-label' %>
        <%= f.telephone_field :phone, class: 'input', autocomplete: 'off' %>
      </div>
    </div>
    <div>
      <%= f.label :address, 'Address', class: 'field-label' %>
      <%= f.text_area :address, rows: 2, class: 'input' %>
    </div>
  </fieldset>
  <fieldset class="space-y-4">
    <legend class="card-title">Terms</legend>
    <div>
      <%= f.label :payment_terms, 'Payment terms', class: 'field-label' %>
      <%= f.select :payment_terms, Purchasing::Vendor::PAYMENT_TERMS, {}, class: 'input' %>
    </div>
    <div>
      <%= f.label :notes, 'Notes', class: 'field-label' %>
      <%= f.text_area :notes, rows: 2, class: 'input' %>
    </div>
  </fieldset>
  <div class="form-actions">
    <%= f.submit 'Save', class: 'btn-primary', name: nil %>
    <%= link_to 'Cancel', (vendor.persisted? ? vendor : purchasing_vendors_path), class: 'btn-ghost' %>
  </div>
<% end %>
