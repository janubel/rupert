<%= form_with model: purchase_order, url: (purchase_order.persisted? ? purchase_order : purchasing_purchase_orders_path), class: 'space-y-4' do |f| %>
  <%= render 'shared/form_errors', model: purchase_order %>
  <fieldset class="space-y-4">
    <legend class="card-title">Order</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :vendor_id, 'Vendor', class: 'field-label' %>
        <%= f.collection_select :vendor_id, @vendors, :id, :name, { prompt: 'Choose a vendor' }, class: 'input' %>
      </div>
      <div>
        <%= f.label :order_number, 'Order number', class: 'field-label' %>
        <%= f.text_field :order_number, class: 'input', autocomplete: 'off' %>
      </div>
    </div>
    <div>
      <%= f.label :expected_date, 'Expected date', class: 'field-label' %>
      <%= f.date_field :expected_date, class: 'input' %>
    </div>
    <div>
      <%= f.label :notes, 'Notes', class: 'field-label' %>
      <%= f.text_area :notes, rows: 2, class: 'input' %>
    </div>
  </fieldset>
  <div class="form-actions">
    <%= f.submit 'Save', class: 'btn-primary', name: nil %>
    <%= link_to 'Cancel', (purchase_order.persisted? ? purchase_order : purchasing_purchase_orders_path), class: 'btn-ghost' %>
  </div>
<% end %>
