<% d = @data
   money = ->(cents) { cents.nil? ? 'Unknown' : finance_money_text(cents) }
   when_ = ->(iso) { iso.present? ? I18n.l(Time.iso8601(iso).in_time_zone, format: :short) : 'Never seen' }
   age = ->(iso) { iso.present? ? "#{time_ago_in_words(Time.iso8601(iso))} ago" : 'no record' } %>
<div class="space-y-6">
  <%= page_header 'Business snapshot', subtitle: "#{d['business'] || 'Business'} · prepared #{when_.call(d['generated_at'])} (#{d['timezone']}) from live records." do %>
    <button type="button" class="btn-ghost" data-controller="print" data-action="click->print#print">Print</button>
    <% if Current.user.can?('reports.write') %>
      <%= button_to 'Save a dated copy', business_snapshot_path, method: :post, class: 'btn-primary', form: { class: 'inline' }, data: { turbo_confirm: 'Keep an unchangeable copy of this snapshot as evidence?' } %>
    <% end %>
  <% end %>
  <%= fold_explainer('Each section says where its numbers come from and how old they are. Unknown means unknown, not zero. A saved copy is a JSON file kept unchanged with a checksum; this is an operational picture, not audited financial statements.', class: 'text-sm text-mocha') %>

  <% h = d['health']; verdict = { 'ok' => ['All clear', 'pill-fern'], 'watch' => ['Worth a look', 'pill-clay'], 'fix' => ['Needs fixing', 'pill-rose'] }.fetch(h['books_check']) %>
  <section class="section-card break-inside-avoid" aria-label="Data health">
    <%= section_heading 'Can I trust this today?' do %><span class="<%= verdict.last %>"><%= verdict.first %></span><% end %>
    <p class="text-sm"><%= h['fix'] %> to fix, <%= h['watch'] %> to watch, <%= h['ok'] %> passing in Books health. Approval ledger: <%= h['approval_ledger_intact'] ? "intact (#{h['approvals']} entries)" : 'PROBLEM, treat approvals as unverified' %>.</p>
  </section>

  <section class="space-y-3 break-inside-avoid" aria-label="Sales">
    <%= section_heading '1. Sales and where they come from', hint: d['sales']['note'] %>
    <div class="table-region" role="region" tabindex="0" aria-label="Sales by source"><table class="table">
      <thead><tr><th scope="col" class="th">Source</th><% BusinessSnapshot::WINDOWS.each do |days| %><th scope="col" class="th num">Last <%= days %> days</th><% end %><th scope="col" class="th">Last sale</th><th scope="col" class="th">Last import</th></tr></thead>
      <tbody>
        <% d['sales']['sources'].each do |src| %>
          <tr>
            <td class="td"><span class="font-medium"><%= src['label'] %></span><span class="block text-xs text-taupe"><%= src['note'] %></span></td>
            <% BusinessSnapshot::WINDOWS.each do |days| %>
              <% row = d['sales']['windows'][days.to_s].find { |r| r['source'] == src['key'] } %>
              <td class="td num"><%= row ? "#{money.call(row['cents'])} (#{row['orders']})" : '$0.00 (0)' %></td>
            <% end %>
            <td class="td text-xs"><%= age.call(src['last_sale_at']) %></td>
            <td class="td text-xs"><%= age.call(src['last_import_at']) %></td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
    <p class="text-xs text-mocha">Figures are sales totals with order counts in brackets. Windows end today.</p>
  </section>

  <section class="space-y-3 break-inside-avoid" aria-label="Products">
    <%= section_heading '2. Products and stock', hint: d['products']['note'] %>
    <% p = d['products'] %>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
      <% [['Active products', p['active_products'], nil], ['Variants', p['variants'], 'sku'], ['Linked Shopify↔Square SKUs', p['linked_skus'], 'shared_stock'], ['Stock value at price', money.call(p['stock_value_cents']), 'stock_value'], ['Low stock (≤ ' + p['low_stock_threshold'].to_s + ')', p['low_stock'], 'threshold'], ['Out of stock', p['out_of_stock'], 'mirror']].each do |label, value, term| %>
        <div class="stat"><div class="stat-label"><%= label %><%= define(term) if term %></div><p class="stat-value-sm mt-1"><%= value %></p></div>
      <% end %>
    </div>
    <% if p['top_sellers_90d'].any? %>
      <div class="table-region" role="region" tabindex="0" aria-label="Top sellers"><table class="table">
        <caption class="th text-left">Top sellers, last 90 days (canonical orders)</caption>
        <tbody><% p['top_sellers_90d'].each do |row| %><tr><td class="td"><%= row['name'] %> <span class="text-xs text-taupe"><%= row['sku'] %></span></td><td class="td num"><%= money.call(row['cents']) %></td></tr><% end %></tbody>
      </table></div>
    <% end %>
  </section>

  <section class="space-y-3 break-inside-avoid" aria-label="Cash">
    <%= section_heading '3. Cash and money coming in', hint: d['cash']['note'] %>
    <% c = d['cash'] %>
    <div class="table-region" role="region" tabindex="0" aria-label="Recorded sales receipts"><table class="table">
      <caption class="th text-left">Recorded sales receipts, last 30 days</caption>
      <tbody>
        <% c['tenders_30d'].each do |method, cents| %><tr><td class="td"><%= method.to_s.humanize %></td><td class="td num"><%= money.call(cents) %></td></tr><% end %>
        <% if c['tenders_30d'].empty? %><tr><td class="empty-row" colspan="2">No tender records in this window.</td></tr><% end %>
        <tr><td class="td">Refunds recorded</td><td class="td num"><%= money.call(c['refunds_30d_cents']) %></td></tr>
      </tbody>
    </table></div>
    <dl class="facts">
      <div><dt>Card processor deposits</dt><dd><%= c['processor_deposits'] ? "latest report read #{age.call(c['processor_deposits']['observed_at'])}, covering #{c['processor_deposits']['window_from']} to #{c['processor_deposits']['window_to']}" : 'no deposit reports on file' %>.</dd></div>
      <div><dt>Bank</dt><dd>no live connection. <%= c['bank']['statements'].zero? ? 'No bank statements uploaded.' : "#{pluralize(c['bank']['statements'], 'statement')} uploaded, latest line #{c['bank']['latest_line_on']}, #{c['bank']['lines_waiting']} line(s) waiting for a decision." %></dd></div>
      <div><dt>Cash forecast</dt><dd><%= c['cash_forecast'] ? "scenario retained #{age.call(c['cash_forecast']['retained_at'])} (baseline #{c['cash_forecast']['baseline']})" : 'none retained' %>.</dd></div>
      <div><dt>Last human approval of the books</dt><dd><%= c['latest_approval'] ? "#{c['latest_approval']['period']} · #{c['latest_approval']['status'].humanize} by #{c['latest_approval']['by']} #{age.call(c['latest_approval']['at'])}" : 'none yet' %>.</dd></div>
    </dl>
  </section>

  <section class="space-y-3 break-inside-avoid" aria-label="Money out and vendors">
    <% m = d['money_out']; v = d['vendors'] %>
    <%= section_heading '4. Money out and vendors', hint: "#{m['note']} #{v['note']}" %>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
      <% [["Expenses, 90 days (#{m['expenses_90d_count']})", money.call(m['expenses_90d_cents']), 'expense'], ["Vendor payments, 90 days (#{m['vendor_payments_90d_count']})", money.call(m['vendor_payments_90d_cents']), 'vendor_payment'], ['Owed to vendors', money.call(v['owed_cents']), 'accounts_payable'], ['Ordered, not received', money.call(v['committed_cents']), 'po_pending']].each do |label, value, term| %>
        <div class="stat"><div class="stat-label"><%= label %><%= define(term) %></div><p class="stat-value-sm mt-1"><%= value %></p></div>
      <% end %>
    </div>
    <% if m['by_category'].any? %><p class="text-sm">Expenses by category: <%= m['by_category'].map { |k, cents| "#{k.humanize} #{money.call(cents)}" }.join(' · ') %>.</p><% end %>
    <% if v['vendors'].any? %>
      <div class="table-region" role="region" tabindex="0" aria-label="Vendors"><table class="table">
        <thead><tr><th scope="col" class="th">Vendor</th><% %w[Owed Paid Balance Ordered].each do |hd| %><th scope="col" class="th num"><%= hd %></th><% end %></tr></thead>
        <tbody><% v['vendors'].each do |row| %><tr><td class="td"><%= row['name'] %></td><td class="td num"><%= money.call(row['owed_cents']) %></td><td class="td num"><%= money.call(row['paid_cents']) %></td><td class="td num font-semibold"><%= money.call(row['balance_cents']) %></td><td class="td num"><%= money.call(row['committed_cents']) %></td></tr><% end %></tbody>
      </table></div>
    <% else %>
      <%= empty_state "#{pluralize(v['vendor_count'], 'vendor')} on file", hint: 'None with orders or payments yet.' %>
    <% end %>
  </section>

  <footer class="border-t border-fog pt-3 text-xs text-mocha">Rupert <%= d['version'] %> · generated <%= d['generated_at'] %> for <%= Current.user.display_name || Current.user.email %>.</footer>
</div>
