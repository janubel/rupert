<% content_for :title, 'Checkout setup' %>
<% nmi = @setting.gateway_provider == 'nmi' %>
<% menu = [] %>
<% menu << ['Check gateway', verify_pos_setting_path(@location.id), { method: :post, data: { turbo: false } }] if @setting.persisted? %>
<div class="page-medium space-y-6">
  <%= page_header 'Checkout setup', subtitle: "Real cash checkout, C-Trax stock deductions and a card gateway for #{@location.name}.", menu: menu %>
  <% if @setting.errors.any? %><div role="alert" class="flash flash-alert"><%= @setting.errors.full_messages.to_sentence %></div><% end %>
  <% if @setting.persisted? %><p class="text-sm text-mocha"><%= @setting.verified_at ? "Gateway profile checked #{l(@setting.verified_at, format: :short)}." : 'Card gateway has not been verified. Choose Check gateway from the More menu after saving credentials.' %></p><% end %>
  <%= form_with model: @setting, url: pos_setting_path(@location.id), method: :patch, class: 'card card-pad space-y-6', data: { turbo: false } do |form| %>
    <%= form.hidden_field :lock_version %>
    <fieldset class="space-y-3">
      <legend class="card-title">Cash and stock</legend>
      <label class="flex gap-2 text-sm"><%= form.check_box :cash_enabled %><span>Enable real cash sales and receipts</span></label>
      <label class="flex gap-2 text-sm"><%= form.check_box :stock_writes_enabled %><span>Deduct C-Trax stock for paid Rupert sales using the saved C-Trax account</span></label>
      <p class="text-xs text-taupe">Only verified paid sales can deduct their exact native variants. Uncertain write outcomes remain pending for review and are never blindly repeated. Sales are recorded in Rupert, separately from C-Trax’s own order journal.</p>
    </fieldset>
    <fieldset class="space-y-3">
      <legend class="card-title">Card checkout</legend>
      <div><%= form.label :gateway_provider, 'Payment gateway', class: 'field-label' %><%= form.select :gateway_provider, [['Authorize.net', 'authorize_net'], ['NMI · sandbox only', 'nmi']], {}, class: 'select w-full' %></div>
      <%= fold_explainer('Save the gateway choice first to display its credential fields. NMI live payments are disabled pending Next Stage confirmation. Use the merchant account approved for this store. Card details are collected inside the selected gateway’s hosted fields; Rupert receives a one-use token. This is a browser card checkout. Terminal support requires a separate integration.', class: 'text-sm text-mocha') %>
      <% environments = nmi ? [['Sandbox · test payments', 'sandbox']] : [['Sandbox · test payments', 'sandbox'], ['Production · real charges', 'production']] %>
      <div><%= form.label :environment, 'Gateway environment', class: 'field-label' %><%= form.select :environment, environments, {}, class: 'select w-full' %></div>
      <div><%= form.label :gateway_id, 'Existing Gateway ID', class: 'field-label' %><%= form.text_field :gateway_id, class: 'input', autocomplete: 'off' %></div>
      <% if nmi %>
        <p class="text-sm text-mocha">Use a dedicated NMI sandbox merchant. Sandbox receipts never create live sales, register revenue or stock deductions. The company check compares the profile name, not the operator-entered Gateway ID. Card payment permissions and the public key are tested by sandbox checkout.</p>
        <div><label for="nmi_company" class="field-label">Expected sandbox merchant company</label><%= password_field_tag 'credentials[merchant_company]', nil, id: 'nmi_company', autocomplete: 'new-password', class: 'input', placeholder: 'Exact company shown in the sandbox profile' %></div>
        <div><label for="nmi_private" class="field-label">Sandbox private API security key</label><%= password_field_tag 'credentials[security_key]', nil, id: 'nmi_private', autocomplete: 'new-password', class: 'input' %></div>
        <div><label for="nmi_public" class="field-label">Sandbox public tokenization key</label><%= password_field_tag 'credentials[tokenization_key]', nil, id: 'nmi_public', autocomplete: 'new-password', class: 'input' %></div>
      <% else %>
        <div><label for="pos_gateway_login" class="field-label">API Login ID</label><%= password_field_tag 'credentials[api_login_id]', nil, id: 'pos_gateway_login', autocomplete: 'new-password', class: 'input', placeholder: 'Leave blank to keep saved value' %></div>
        <div><label for="pos_gateway_key" class="field-label">Transaction Key</label><%= password_field_tag 'credentials[transaction_key]', nil, id: 'pos_gateway_key', autocomplete: 'new-password', class: 'input', placeholder: 'Leave blank to keep saved value' %></div>
      <% end %>
      <label class="flex gap-2 text-sm"><%= form.check_box :card_enabled %><span><%= nmi ? 'Enable sandbox card tests only' : 'Enable card charges for this verified gateway and store' %></span></label>
      <p class="text-xs text-taupe">Credentials are encrypted and never redisplayed. Changing the account, environment or credentials disables card charges until checked again. Reporting-only OAuth credentials cannot charge payments.</p>
    </fieldset>
    <div class="form-actions">
      <%= form.submit 'Save', class: 'btn-primary' %>
      <%= link_to 'Cancel', ctrax_pos_path(location_id: @location.id), class: 'btn-ghost' %>
    </div>
  <% end %>
</div>
