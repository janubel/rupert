<% content_for :title, "Connections" %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Connections</h1>
      <p class="mt-1 text-sm text-mocha">Every service Rupert talks to, whether it's set up, and where to find or renew the keys when you need them.</p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Settings", settings_path, class: "btn-ghost btn-sm" %>
      <%= link_to "Import .env", settings_path(anchor: "env"), class: "btn-ghost btn-sm" %>
    </div>
  </section>

  <section class="rounded-xl border border-fog bg-cream px-4 py-3 text-sm text-mocha">
    <span class="font-semibold text-ink"><%= @configured %> of <%= @services.length %> services configured.</span>
    Keys are stored encrypted and shown masked — raw values never leave the server.
  </section>

  <div class="grid gap-6 lg:grid-cols-2">
    <% @services.each do |service| %>
      <section class="card card-pad flex flex-col">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="font-display text-xl text-ink"><%= service[:name] %></h2>
            <p class="mt-0.5 text-sm text-mocha"><%= service[:description] %></p>
          </div>
          <span class="<%= service[:status] == :configured ? "pill-fern" : service[:status] == :partial ? "pill-olive" : "pill-taupe" %> shrink-0">
            <span class="dot <%= service[:status] == :configured ? "bg-fern" : service[:status] == :partial ? "bg-olive" : "bg-taupe" %>"></span>
            <%= service[:status_label] %>
          </span>
        </div>

        <div class="mt-4 space-y-2">
          <% service[:keys].each do |key| %>
            <div class="flex items-center justify-between gap-3 rounded-xl bg-haze px-3 py-2 text-sm">
              <div class="min-w-0">
                <p class="truncate font-mono text-xs text-ink"><%= key[:key] %></p>
                <p class="text-[11px] text-taupe"><%= key[:set] ? "#{key[:masked]} · #{key[:source]}" : "not set" %></p>
              </div>
              <span class="<%= key[:set] ? "dot bg-fern" : "dot bg-taupe" %> shrink-0" title="<%= key[:set] ? "Set" : "Missing" %>"></span>
            </div>
          <% end %>
        </div>

        <div class="mt-4 flex-1 space-y-3 text-xs text-mocha">
          <div class="flex gap-2">
            <span class="mt-0.5 font-semibold text-olive">Where to find it</span>
            <span>
              <% if service[:find_url] %>
                <%= link_to service[:find_hint], service[:find_url], target: "_blank", rel: "noopener", class: "font-semibold text-olive hover:underline" %>
              <% else %>
                <%= service[:find_hint] %>
              <% end %>
            </span>
          </div>
          <% if service[:renewal_note] %>
            <div class="flex gap-2">
              <span class="mt-0.5 font-semibold text-olive">Renewing</span>
              <span><%= service[:renewal_note] %></span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <section class="card card-pad">
    <h2 class="font-display text-xl text-ink">Not managed here</h2>
    <p class="mt-2 text-xs text-taupe">Boot-time keys (<code class="rounded bg-haze px-1 py-0.5 font-mono">SHOPIFY_API_KEY</code>, <code class="rounded bg-haze px-1 py-0.5 font-mono">SHOPIFY_API_SECRET</code>, database credentials, <code class="rounded bg-haze px-1 py-0.5 font-mono">SECRET_KEY_BASE</code>) are set by the hosting environment and can't be changed from the app. To rotate those, edit <code class="rounded bg-haze px-1 py-0.5 font-mono">/opt/rupert/.env</code> on the droplet and redeploy.</p>
  </section>
</div>
