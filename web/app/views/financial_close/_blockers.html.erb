<% day = workflow.day; blockers = workflow.blockers %>
<section id="close-blockers" class="space-y-4" aria-label="Close blockers">
  <div class="rounded-card border p-5 <%= blockers.empty? ? 'border-success-edge bg-success-bg' : 'border-warn-edge bg-warn-bg' %> space-y-3">
    <h2 class="section-title"><%= blockers.empty? ? 'Recorded checks clear · finish the reviewer checklist' : "#{pluralize(blockers.size, 'check')} before a complete close" %></h2>
    <p class="text-sm"><% if !workflow.review_current? %>A current review is required before retaining any close package. Resolve the evidence below, then record your review.<% elsif blockers.any? %>You can retain a package with documented exceptions after completing the checklist. These items stay open until resolved.<% else %>Confirm originals, bank checks and retention requirements, then retain the close package.<% end %></p>
    <% if blockers.any? %><%= link_to "Start: #{blockers.first[:title]}", financial_close_blocker_path(blockers.first[:key], day), class: 'btn-primary' %><% else %><%= link_to(can_write ? 'Complete close checklist' : 'Inspect retained close versions', can_write ? '#retain-close' : '#close-history', class: 'btn-primary') %><% end %>
    <p class="text-xs text-mocha">Counts describe checks and may overlap. Verify retention requirements separately; local originals stay available.</p>
  </div>
  <div class="grid gap-3 md:grid-cols-2" aria-label="Checks needing action">
    <% blockers.each do |blocker| %><article class="section-card min-w-0"><div class="card-head"><h3 class="card-title"><%= blocker[:title] %><%= blocker[:count] ? " · #{blocker[:count]}" : '' %></h3><span class="<%= blocker[:required] ? 'pill-rose' : 'pill-clay' %>"><%= blocker[:required] ? 'Required for any package' : 'Blocks complete close' %></span></div><p class="text-sm text-mocha"><%= blocker[:detail] %></p><%= link_to financial_close_action_label(blocker[:key]), financial_close_blocker_path(blocker[:key], day), class: 'btn-ghost btn-sm', aria: { label: "Open #{blocker[:title]}" } %></article><% end %>
  </div>
  <% if workflow.attention.missing_controls.any? %><section id="close-missing-reports" class="space-y-3" aria-label="Missing reports blocking close"><%= section_heading 'Which register reports are missing?', level: :h3 %>
    <% workflow.attention.missing_controls.first(4).each do |row| %>
      <div class="section-card"><%= render 'financial_close/missing_report', row: row, request: workflow.missing_control_request(row), control_key: workflow.attention.control_key(row), day: day, can_write: can_write %></div>
    <% end %><% if workflow.attention.missing_controls.size > 4 %><%= link_to 'Open every missing register scope', daily_reconciliations_path(day: day.iso8601, anchor: 'missing-controls'), class: 'text-sm font-semibold text-olive-deep hover:underline' %><% end %>
  </section><% end %>
  <% if workflow.open_follow_ups.any? %><section id="close-follow-ups" class="space-y-3" aria-label="Priority follow-ups blocking close"><%= section_heading 'Next follow-ups for this date', level: :h3 do %><%= link_to "All #{workflow.open_follow_ups.size} open follow-ups", reconciliation_follow_ups_path(day: day.iso8601), class: 'btn-ghost btn-sm' %><% end %><div class="grid gap-3 md:grid-cols-2"><% workflow.open_follow_ups.first(3).each do |item| %><%= render 'reconciliation_follow_ups/card', item: item, heading_tag: :h4, close_day: day %><% end %></div></section><% end %>
</section>
