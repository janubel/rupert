<% workflow = @workflow; day = workflow.day; issues = workflow.issues; can_write = Current.user.can?('reports.write')
   menu = [['Open days across this date', overview_reconciliation_follow_ups_path(ending_on: day.iso8601)], ['Plan cash from this date', cash_forecast_path(day: day.iso8601)],
           ['Download reconciliation CSV', daily_reconciliations_path(day: day.iso8601, format: :csv)]]
   menu << ['Missing reports', '#close-missing-reports'] if workflow.attention.missing_controls.any?
   menu << ['Priority follow-ups', '#close-follow-ups'] if workflow.open_follow_ups.any?
   menu << ['Close checklist', '#retain-close'] if can_write
   menu << ['Retained close versions', '#close-history'] %>
<div class="space-y-6">
  <%= page_header 'Day close', subtitle: "#{day.strftime('%A, %B %-d, %Y')} · from source originals to a saved close package.", menu: menu do %>
    <%= link_to 'Review the day', daily_reconciliations_path(day: day.iso8601), class: 'btn-primary' %>
  <% end %>

  <section aria-label="Close date" class="toolbar-band">
    <%= form_with url: financial_close_path, method: :get, class: 'toolbar' do |f| %>
      <div class="toolbar-field"><%= f.label :day, 'Business date', class: 'field-label' %>
        <nav class="date-stepper" aria-label="Close business dates">
          <%= link_to '‹', financial_close_path(day: (day - 1).iso8601), class: 'btn-ghost btn-sm', rel: 'prev', aria: { label: 'Previous day' }, title: 'Previous day' %>
          <%= f.date_field :day, value: day, required: true, class: 'input' %>
          <%= link_to '›', financial_close_path(day: (day + 1).iso8601), class: 'btn-ghost btn-sm', rel: 'next', aria: { label: 'Next day' }, title: 'Next day' %>
        </nav>
      </div>
      <div class="toolbar-actions"><%= f.submit 'Apply', class: 'btn-primary' %><% if day != Date.yesterday %><%= link_to 'Yesterday', financial_close_path(day: Date.yesterday.iso8601), class: 'btn-ghost' %><% end %></div>
    <% end %>
    <% if (next_check = workflow.blockers.first) %><p class="mt-2 text-sm text-mocha">Next check: <%= link_to next_check[:title], '#close-blockers', class: 'font-semibold text-olive-deep hover:underline' %></p><% end %>
  </section>
  <% if @error %><p role="alert" class="flash flash-alert"><%= @error %> Your closing note and selections are preserved below.</p><% end %>

  <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Close status overview">
    <% [['Checks needing action', workflow.blockers.size, 'close_check'], ['Current review', !workflow.review ? 'Not recorded' : !workflow.review_current? ? 'Evidence changed' : workflow.review.status.humanize, 'fingerprint'], ['Originals retained', workflow.report.documents.size, 'original_document'], ['Open follow-ups', workflow.open_follow_ups.size, 'follow_up']].each do |label, value, term| %><div class="stat min-w-0"><div class="stat-label"><%= label %><%= define(term) %></div><p class="stat-value-sm mt-1 break-words"><%= value %></p></div><% end %>
  </section>

  <nav class="card" aria-label="Reconciliation workflow">
    <ol class="row-list">
      <% [['1', 'Gather', 'Find source originals', 'Reports, invoices and statements covering this date.', reconciliation_documents_path(from: day.iso8601, to: day.iso8601, close_day: day.iso8601)],
          ['2', 'Compare', 'Investigate and review', 'Source, currency and location stay separate.', daily_reconciliations_path(day: day.iso8601, anchor: 'control-comparisons')],
          ['3', 'Retain', (can_write ? 'Finish the close checklist' : 'Inspect saved close versions'), 'A current review is required before saving a package.', (can_write ? '#retain-close' : '#close-history')]].each do |number, step, title, caption, path| %>
        <li class="row-item">
          <div class="min-w-0"><p class="font-semibold text-ink"><span class="text-taupe"><%= number %> · <%= step %>:</span> <%= link_to title, path, class: 'hover:underline' %></p><p class="text-xs text-taupe"><%= caption %></p></div>
        </li>
      <% end %>
    </ol>
  </nav>

  <%= render 'shared/daily_close_summary', day: day %>

  <div class="operations-close-grid">
    <div class="min-w-0"><%= render 'blockers', workflow: workflow, can_write: can_write %></div>
    <div class="min-w-0">
      <% if can_write %>
        <section id="retain-close" class="section-card" aria-labelledby="retain-close-title">
          <div class="card-head"><div><h2 id="retain-close-title" class="section-title">Retain the close package<%= define('close_package') %></h2><p class="card-hint">Keeps a version of the evidence, review, outstanding work and your checklist.</p></div></div>
          <%= form_with url: financial_close_path, scope: :close, class: 'space-y-4' do |f| %>
            <%= f.hidden_field :day, value: day.iso8601 %><%= f.hidden_field :workflow_digest, value: workflow.digest %>
            <div><%= f.label :disposition, 'Close disposition', class: 'field-label' %><%= f.select :disposition, [['Complete recorded checks', 'complete', { disabled: !workflow.clear_for_close? }], ['Close with documented exceptions', 'with_exceptions']], { selected: @values&.dig('disposition') || (workflow.clear_for_close? ? 'complete' : 'with_exceptions') }, class: 'select' %></div>
            <fieldset class="space-y-3"><legend class="card-title">Reviewer checklist</legend><% FinancialCloseWorkflow::CHECKS.each do |key, label| %><label class="flex items-start gap-3 text-sm"><%= f.check_box key, { checked: @values&.dig(key) == '1', required: true, class: 'mt-1' }, '1', '0' %><span><%= label %></span></label><% end %></fieldset>
            <div><%= f.label :notes, 'Closing explanation / documented exceptions', class: 'field-label' %><%= f.text_area :notes, value: @values&.dig('notes'), required: true, maxlength: 4000, rows: 4, class: 'input', placeholder: 'Evidence checked, unresolved items, who owns them, and any retention or bank-verification exceptions.' %></div>
            <p class="text-xs text-mocha">Use documented exceptions for any missing bank, source or policy evidence, including a required Drive copy. Supporting originals are checksum-verified and the reconciliation CSV is archived with the package. Saving does not close follow-ups, post a ledger transaction or send a message.</p>
            <% unless workflow.review_current? %><p class="rounded-card border border-warn-edge bg-warn-bg p-3 text-sm">A current review is required before retaining either type of package. <%= link_to 'Record current review', daily_reconciliations_path(day: day.iso8601, anchor: 'review-history'), class: 'font-semibold text-olive-deep hover:underline' %></p><% end %>
            <div class="form-actions"><%= f.submit 'Verify originals & retain close package', disabled: !workflow.review_current?, class: 'btn-primary' %></div>
          <% end %>
        </section>
      <% else %>
        <section class="section-card"><%= section_heading 'Review access', hint: 'You can inspect checks, originals and retained versions. A reviewer with report-write access records the review and retains the close package.' %></section>
      <% end %>
    </div>
  </div>

  <details class="explainer card card-pad">
    <summary class="explainer-summary font-semibold">Full workflow and reference links</summary>
    <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3" aria-label="Day close lifecycle">
      <section class="section-card"><p class="eyebrow text-taupe">1 · Completeness</p><h3 class="card-title">Check source reports</h3><p class="text-sm"><%= workflow.report.register.rows.size %> recorded source / currency / location pools. Missing activity is not proof of zero sales.</p><%= link_to 'Check coverage and source freshness', daily_reconciliations_path(day: day.iso8601, anchor: 'source-evidence'), class: 'btn-ghost btn-sm' %><% if can_write %><%= link_to 'Track another expected report', new_reconciliation_follow_up_path(period_from: day.iso8601, period_to: day.iso8601), class: 'block text-sm font-semibold text-olive-deep hover:underline' %><% end %><p class="text-xs text-mocha">Only tracked expectations are known; add required invoices, bank and processor reports.</p></section>
      <section class="section-card"><p class="eyebrow text-taupe">2 · Retention</p><h3 class="card-title">Keep the originals</h3><p class="text-sm"><%= workflow.report.documents.size %> supporting files / versions cover this date. Originals and corrections remain encrypted in Rupert without automatic deletion.</p><%= link_to 'Find originals for this date', reconciliation_documents_path(from: day.iso8601, to: day.iso8601), class: 'btn-ghost btn-sm' %><% if can_write %><%= link_to 'Retain an original', daily_reconciliations_path(day: day.iso8601, anchor: 'upload-document'), class: 'btn-ghost btn-sm' %><% end %><%= link_to 'Drive copies', retention_drive_path, class: 'block text-sm text-olive-deep hover:underline' %></section>
      <section class="section-card"><p class="eyebrow text-taupe">3 · Reconciliation</p><h3 class="card-title">Resolve or explain differences</h3><p class="text-sm">Compare Rupert minus source, keeping currencies, locations, gateway observations and deposits separate.</p><%= link_to 'Review source controls', daily_reconciliations_path(day: day.iso8601, anchor: 'attention-items'), class: 'btn-ghost btn-sm' %><p class="text-xs text-mocha">Bank funding, fees and timing require source evidence and human review.</p></section>
      <section class="section-card"><p class="eyebrow text-taupe">4 · Follow-up</p><h3 class="card-title">Keep exceptions owned</h3><p class="text-sm"><%= workflow.open_follow_ups.size %> open or waiting · <%= workflow.open_follow_ups.count(&:overdue?) %> overdue for this date.</p><%= link_to 'Open follow-ups for this date', reconciliation_follow_ups_path(day: day.iso8601), class: 'btn-ghost btn-sm' %><%= link_to 'All overdue follow-ups', reconciliation_follow_ups_path(status: 'overdue'), class: 'block text-sm font-semibold text-olive-deep hover:underline' %><p class="text-xs text-mocha">Assignments, due dates, evidence links and earlier notes stay in Rupert. No messages are sent.</p></section>
      <section class="section-card"><p class="eyebrow text-taupe">5 · Review and control</p><h3 class="card-title"><%= !workflow.review ? 'Review not recorded' : !workflow.review_current? ? 'Changed since review' : workflow.review.status.humanize %></h3><p class="text-sm">Reviews bind to the current evidence fingerprint. Record your conclusion before retaining a close package.</p><%= link_to 'Record or inspect review', daily_reconciliations_path(day: day.iso8601, anchor: 'review-history'), class: 'btn-ghost btn-sm' %><p class="text-xs text-mocha">Operational audit evidence; organization-specific compliance requirements still need reviewer confirmation.</p></section>
      <section class="section-card"><p class="eyebrow text-taupe">6 · Reporting and forecast</p><h3 class="card-title">Report the close, plan cash</h3><div class="flex flex-wrap gap-2"><%= link_to 'Download CSV', daily_reconciliations_path(day: day.iso8601, format: :csv), class: 'btn-ghost btn-sm' %><%= link_to 'Source reports', money_reconciliations_path(date: day.iso8601), class: 'btn-ghost btn-sm' %><%= link_to 'Build cash forecast', cash_forecast_path(day: day.iso8601), class: 'btn-ghost btn-sm' %></div><p class="text-xs text-mocha">Forecasts use entered bank-cash assumptions, one currency per scenario. Sales receipts are not assumed bank funding.</p></section>
    </div>
  </details>

  <section id="close-history" class="space-y-3">
    <%= section_heading 'Retained close versions' do %><%= link_to 'Find every retained version', reconciliation_documents_path(source: 'rupert', category: 'archives', from: day.iso8601, to: day.iso8601), class: 'btn-ghost btn-sm' %><% end %>
    <% packages = workflow.packages.to_a %>
    <% if packages.empty? %><%= empty_state 'No close package retained for this date yet', hint: 'Earlier reviews and originals remain available.' %><% end %>
    <% packages.each do |doc| %>
      <article class="section-card">
        <div class="card-head"><div><h3 class="card-title">Package #<%= doc.id %> · <%= doc.metadata['disposition'].to_s.humanize %></h3><p class="card-hint"><%= doc.metadata['workflow_digest'] == workflow.digest ? 'Matches current evidence and follow-up progress' : 'Evidence or follow-up progress changed since this version' %> · retained <%= doc.created_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %></p></div><div class="card-head-actions"><%= link_to 'Download close package JSON', document_daily_reconciliation_path(doc), class: 'btn-ghost btn-sm' %></div></div>
      </article>
    <% end %>
  </section>
</div>
