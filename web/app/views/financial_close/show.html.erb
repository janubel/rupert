<% content_for :title, 'Financial close' %>
<% workflow = @workflow; day = workflow.day; issues = workflow.issues; can_write = Current.user.can?('reports.write') %>
<div class="mx-auto max-w-7xl space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-mocha">Money · Full close workflow</p><h1 class="page-title mt-2">Financial close</h1><p class="mt-2 text-sm text-mocha">Check completeness, keep originals, reconcile, review and retain a close package. Carry the day into a cash scenario.</p></div><div class="flex flex-wrap gap-2"><%= link_to 'Across days', overview_reconciliation_follow_ups_path(ending_on: day.iso8601), class: 'btn-ghost' %><%= link_to 'Cash forecast', cash_forecast_path(day: day.iso8601), class: 'btn-ghost' %></div></header>
  <%= form_with url: financial_close_path, method: :get, class: 'card card-pad flex flex-wrap items-end gap-3' do |f| %><div><%= f.label :day, 'Business date', class: 'block text-sm font-semibold' %><%= f.date_field :day, value: day, required: true, class: 'input' %></div><%= f.submit 'Open close workspace', class: 'btn-primary' %><%= link_to 'Previous day', financial_close_path(day: (day - 1).iso8601), class: 'btn-ghost' %><%= link_to 'Next day', financial_close_path(day: (day + 1).iso8601), class: 'btn-ghost' %><%= link_to 'Yesterday', financial_close_path(day: Date.yesterday.iso8601), class: 'btn-ghost' %><%= link_to 'Today', financial_close_path(day: Date.current.iso8601), class: 'btn-ghost' %><% end %>
  <% if @error %><p role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm"><%= @error %> Your closing note and selections are preserved below.</p><% end %>
  <nav class="flex flex-wrap gap-2" aria-label="Close workspace sections"><% if workflow.attention.missing_controls.any? %><%= link_to 'Missing reports', '#close-missing-reports', class: 'btn-ghost btn-sm' %><% end %><% if workflow.open_follow_ups.any? %><%= link_to 'Priority follow-ups', '#close-follow-ups', class: 'btn-ghost btn-sm' %><% end %><% if can_write %><%= link_to 'Close checklist', '#retain-close', class: 'btn-ghost btn-sm' %><% end %><%= link_to 'Retained close versions', '#close-history', class: 'btn-ghost btn-sm' %></nav>
  <%= render 'blockers', workflow: workflow, can_write: can_write %>
  <details class="space-y-4"><summary class="cursor-pointer font-semibold">Full workflow &amp; reference links</summary>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" aria-label="Financial close lifecycle">
    <section class="card card-pad space-y-3"><p class="text-xs font-semibold text-mocha">1 · COMPLETENESS</p><h2 class="font-display text-xl">Check source reports</h2><p class="text-sm"><%= workflow.report.register.rows.size %> recorded source / currency / location pools. Missing activity is not proof of zero sales.</p><%= link_to 'Check coverage & source freshness', daily_reconciliations_path(day: day.iso8601, anchor: 'source-evidence'), class: 'btn-ghost btn-sm' %><% if can_write %><%= link_to 'Track another expected report', new_reconciliation_follow_up_path(period_from: day.iso8601, period_to: day.iso8601), class: 'block text-sm font-semibold text-olive underline' %><% end %><p class="text-xs text-mocha">Only tracked expectations are known; add required invoices, bank and processor reports.</p></section>
    <section class="card card-pad space-y-3"><p class="text-xs font-semibold text-mocha">2 · RETENTION</p><h2 class="font-display text-xl">Keep the originals</h2><p class="text-sm"><%= workflow.report.documents.size %> supporting files / versions cover this date. Originals and corrections remain encrypted in Rupert without automatic deletion.</p><%= link_to 'Find originals for this date', reconciliation_documents_path(from: day.iso8601, to: day.iso8601), class: 'btn-ghost btn-sm' %><% if can_write %><%= link_to 'Retain an original', daily_reconciliations_path(day: day.iso8601, anchor: 'upload-document'), class: 'btn-ghost btn-sm' %><% end %><%= link_to 'Google Drive · pending', retention_drive_path, class: 'block text-sm text-olive underline' %></section>
    <section class="card card-pad space-y-3"><p class="text-xs font-semibold text-mocha">3 · RECONCILIATION</p><h2 class="font-display text-xl">Resolve or explain differences</h2><p class="text-sm">Compare Rupert minus source, keeping currencies, locations, gateway observations and deposits separate.</p><%= link_to 'Review source controls', daily_reconciliations_path(day: day.iso8601, anchor: 'attention-items'), class: 'btn-ghost btn-sm' %><p class="text-xs text-mocha">Bank funding, fees and timing require source evidence and human review.</p></section>
    <section class="card card-pad space-y-3"><p class="text-xs font-semibold text-mocha">4 · FOLLOW-UP</p><h2 class="font-display text-xl">Keep exceptions owned</h2><p class="text-sm"><%= workflow.open_follow_ups.size %> open or waiting · <%= workflow.open_follow_ups.count(&:overdue?) %> overdue for this date.</p><%= link_to 'Open date-specific follow-ups', reconciliation_follow_ups_path(day: day.iso8601), class: 'btn-ghost btn-sm' %><%= link_to 'All overdue follow-ups', reconciliation_follow_ups_path(status: 'overdue'), class: 'block text-sm font-semibold text-olive underline' %><p class="text-xs text-mocha">Assignments, due dates, evidence links and earlier notes stay in Rupert. No messages are sent.</p></section>
    <section class="card card-pad space-y-3"><p class="text-xs font-semibold text-mocha">5 · REVIEW & CONTROL</p><h2 class="font-display text-xl"><%= !workflow.review ? 'Review not recorded' : !workflow.review_current? ? 'Changed since review' : workflow.review.status.humanize %></h2><p class="text-sm">Reviews bind to the current evidence fingerprint. Record your conclusion before retaining a close package.</p><%= link_to 'Record or inspect review', daily_reconciliations_path(day: day.iso8601, anchor: 'review-history'), class: 'btn-ghost btn-sm' %><p class="text-xs text-mocha">Operational audit evidence; organization-specific compliance requirements still need reviewer confirmation.</p></section>
    <section class="card card-pad space-y-3"><p class="text-xs font-semibold text-mocha">6 · REPORTING & FORECAST</p><h2 class="font-display text-xl">Report the close, plan cash</h2><div class="flex flex-wrap gap-2"><%= link_to 'Reconciliation CSV', daily_reconciliations_path(day: day.iso8601, format: :csv), class: 'btn-ghost btn-sm' %><%= link_to 'Daily / weekly / monthly reports', money_reconciliations_path(date: day.iso8601), class: 'btn-ghost btn-sm' %><%= link_to 'Build cash forecast', cash_forecast_path(day: day.iso8601), class: 'btn-primary btn-sm' %></div><p class="text-xs text-mocha">Forecasts use entered bank-cash assumptions, one currency per scenario. Sales receipts are not assumed bank funding.</p></section>
  </div>
  </details>
  <% if can_write %><section id="retain-close" class="card card-pad scroll-mt-48 space-y-4"><h2 class="font-display text-xl">Retain the close package</h2><p class="text-sm text-mocha">Keeps a version of the evidence, review, outstanding work and your checklist. Supporting originals are checksum-verified and the reconciliation CSV is archived together with the package.</p><%= form_with url: financial_close_path, scope: :close, class: 'space-y-4' do |f| %><%= f.hidden_field :day, value: day.iso8601 %><%= f.hidden_field :workflow_digest, value: workflow.digest %><div><%= f.label :disposition, 'Close disposition', class: 'block text-sm font-semibold' %><%= f.select :disposition, [['Complete recorded checks', 'complete', { disabled: !workflow.clear_for_close? }], ['Close with documented exceptions', 'with_exceptions']], { selected: @values&.dig('disposition') || (workflow.clear_for_close? ? 'complete' : 'with_exceptions') }, class: 'input' %></div><div class="space-y-3"><% FinancialCloseWorkflow::CHECKS.each do |key, label| %><label class="flex items-start gap-3 text-sm"><%= f.check_box key, { checked: @values&.dig(key) == '1', required: true, class: 'mt-1' }, '1', '0' %><span><%= label %></span></label><% end %></div><div><%= f.label :notes, 'Closing explanation / documented exceptions', class: 'block text-sm font-semibold' %><%= f.text_area :notes, value: @values&.dig('notes'), required: true, maxlength: 4000, rows: 4, class: 'input', placeholder: 'Evidence checked, unresolved items, who owns them, and any retention or bank-verification exceptions.' %></div><p class="text-xs text-mocha">Use documented exceptions for any missing bank, source or policy evidence, including a required Drive copy. Saving does not close follow-ups, post a ledger transaction or send a message.</p><% unless workflow.review_current? %><p class="rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm">A current review is required before retaining either type of package. <%= link_to 'Record current review', daily_reconciliations_path(day: day.iso8601, anchor: 'review-history'), class: 'font-semibold text-olive underline' %></p><% end %><%= f.submit 'Verify originals & retain close package', disabled: !workflow.review_current?, class: 'btn-primary' %><% end %></section><% end %>
  <section id="close-history" class="space-y-3 scroll-mt-48"><h2 class="font-display text-xl">Retained close versions</h2><% packages = workflow.packages.to_a %><% if packages.empty? %><p class="card card-pad text-sm text-mocha">No close package retained for this date yet. Earlier reviews and originals remain available.</p><% end %><% packages.each do |doc| %><article class="card card-pad space-y-2"><p class="font-semibold">Package #<%= doc.id %> · <%= doc.metadata['disposition'].to_s.humanize %></p><p class="text-sm"><%= doc.metadata['workflow_digest'] == workflow.digest ? 'Matches current evidence and follow-up progress' : 'Evidence or follow-up progress changed since this version' %> · retained <%= doc.created_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %></p><%= link_to 'Download close package JSON', document_daily_reconciliation_path(doc), class: 'btn-ghost btn-sm' %></article><% end %><%= link_to 'Find every retained version', reconciliation_documents_path(source: 'rupert', category: 'archives', from: day.iso8601, to: day.iso8601), class: 'text-sm text-olive underline' %></section>
</div>
