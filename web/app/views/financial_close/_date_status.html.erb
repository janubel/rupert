<% status = entry[:close]; day = entry[:day] %>
<section class="space-y-3 rounded-card border border-fog bg-haze p-4" aria-label="Close status for <%= day.iso8601 %>">
  <div class="flex flex-wrap justify-between gap-2"><p class="font-semibold"><%= status[:checks].positive? ? pluralize(status[:checks], 'close check') + ' needing action' : 'Recorded checks clear · reviewer checklist remains' %></p><p class="text-sm"><%= status[:review] %></p></div>
  <p class="text-sm text-mocha"><% if status[:package_id] %>Package #<%= status[:package_id] %> · <%= status[:disposition].to_s.humanize %> · <%= status[:package_current] ? 'Matches current evidence and follow-up progress' : 'Changed since package · inspect before relying on this version' %><% else %>No close package retained for this date.<% end %></p>
  <%= render 'financial_close/next_action', status: status, day: day %>
  <div class="flex flex-wrap gap-2"><%= link_to 'Open day close', financial_close_path(day: day.iso8601), class: 'btn-ghost btn-sm' %><%= link_to 'Plan cash from this date', cash_forecast_path(day: day.iso8601), class: 'btn-ghost btn-sm' %><% if entry[:overdue].positive? %><%= link_to "Overdue follow-ups · #{entry[:overdue]}", reconciliation_follow_ups_path(day: day.iso8601, status: 'overdue'), class: 'btn-ghost btn-sm' %><% end %></div>
</section>
