<% if @baseline %><% status = @baseline.status_summary; day = @baseline.day; overdue = @baseline.open_follow_ups.count(&:overdue?) %>
<section class="section-card" aria-label="Forecast baseline close status">
  <div data-cash-forecast-form-target="baselineStatus" class="space-y-3">
    <%= section_heading "Close baseline · #{day.strftime('%b %-d, %Y')}", hint: 'You can plan cash while close checks remain open. Resolve or document those exceptions in the day close. Opening cash remains the amount you enter.' do %><span class="<%= status[:checks].positive? ? 'pill-clay' : 'pill-taupe' %>"><%= pluralize(status[:checks], 'close check') %> needing action</span><% end %>
    <p class="text-sm font-semibold"><%= status[:review] %> · <%= pluralize(@baseline.open_follow_ups.size, 'open follow-up') %> · <%= overdue %> overdue</p>
    <%= render 'financial_close/next_action', status: status, day: day %>
    <div class="flex flex-wrap gap-2"><%= link_to 'Inspect baseline evidence', financial_close_path(day: day.iso8601, anchor: 'close-blockers'), class: 'btn-ghost btn-sm' %><%= link_to 'Compare close dates', overview_reconciliation_follow_ups_path(ending_on: day.iso8601, anchor: 'business-days'), class: 'btn-ghost btn-sm' %><% if overdue.positive? %><%= link_to "Work #{pluralize(overdue, 'overdue follow-up')}", reconciliation_follow_ups_path(day: day.iso8601, status: 'overdue'), class: 'btn-ghost btn-sm' %><% end %></div>
  </div>
  <p hidden role="status" data-cash-forecast-form-target="baselineChanged" class="rounded-card border border-warn-edge bg-warn-bg p-3 text-sm">Close date changed. Calculate the scenario to refresh its baseline review and follow-up status. Your entered cash plan stays below.</p>
</section><% end %>
