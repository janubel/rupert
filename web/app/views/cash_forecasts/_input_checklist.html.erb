<section id="cash-plan-checklist" class="rounded-xl border border-fog bg-paper p-4 space-y-3 scroll-mt-48" aria-label="Cash plan input checklist">
  <h2 class="font-display text-xl">What is missing from this cash plan?</h2><p class="text-sm text-mocha">Enter opening cash, assumptions and both amounts for every active week. Use an explicit 0 when no receipts or payments are planned. This checklist tracks filled entries; calculation validates their amounts.</p>
  <div hidden data-cash-forecast-form-target="checklist" class="space-y-3"><p role="status" class="text-sm font-semibold" data-cash-forecast-form-target="checklistSummary"></p><p class="text-sm text-mocha" data-cash-forecast-form-target="nextLabel"></p><button type="button" class="btn-ghost btn-sm" data-cash-forecast-form-target="nextMissing" data-action="cash-forecast-form#jumpMissing">Review next missing entry</button><details data-cash-forecast-form-target="missingDetails"><summary class="cursor-pointer text-sm font-semibold" data-cash-forecast-form-target="missingSummary">Show missing entries</summary><div class="mt-3 flex flex-wrap gap-2" data-cash-forecast-form-target="missingList"></div></details></div>
</section>
