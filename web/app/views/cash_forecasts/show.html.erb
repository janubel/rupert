<% content_for :title, 'Cash forecast' %>
<% values = @values || {}; horizon = %w[4 8 13].include?(values['horizon']) ? values['horizon'].to_i : 8 %>
<div class="mx-auto max-w-6xl space-y-6 operations-workspace" data-controller="cash-forecast-form" data-cash-forecast-form-calculated-value="<%= @forecast.present? %>" data-cash-forecast-form-baseline-date-value="<%= @baseline&.day&.iso8601 %>">
  <%= render 'shared/operations_navigation', workspace: :money, day: @baseline&.day %>
  <header class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-mocha">Money · Planning scenario</p><h1 class="page-title mt-2">Cash forecast</h1><p class="mt-2 text-sm text-mocha">Plan weekly bank receipts and payments. Keep the assumptions and each retained version.</p></div><%= link_to 'Back to financial close', financial_close_path(day: @baseline&.day&.iso8601), class: 'btn-ghost' %></header>
  <section class="card card-pad space-y-2"><h2 class="font-semibold">One currency. Explicit cash assumptions.</h2><p class="text-sm text-mocha">Enter bank cash as of the selected close date and the expected receipts/payments for each following week. Include payroll, tax, fees and other outflows once. Sales totals, gateway settlements and processor deposits are not automatically treated as bank cash.</p></section>
  <%= render 'baseline' %>
  <%= render 'prefill' %>
  <% if @error || @confirmation_error %><p id="cash-forecast-error" role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm"><%= @error || @confirmation_error %> Entered assumptions remain below. <% if @error_field || @confirmation_error %><%= link_to 'Go to this entry', "##{@error_field || 'cash-zero-confirmation'}", class: 'font-semibold text-olive underline', data: { turbo: false } %><% end %></p><% end %>
  <%= render 'results' if @forecast %>
  <%# Normal submission and the busy opt-out preserve the preview/CSV/retain submitter value. %>
  <%= form_with url: cash_forecast_path, scope: :forecast, class: 'card card-pad space-y-5', data: { turbo: false, busy: false, action: 'input->cash-forecast-form#markChanged change->cash-forecast-form#markChanged' } do |f| %>
    <%= render 'input_checklist' %>
    <p hidden role="status" class="rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm" data-cash-forecast-form-target="changed">Inputs changed. Results above are from the last calculation. Recalculate before downloading or retaining a version.</p>
    <%= f.hidden_field :baseline_digest, value: @baseline&.report&.digest %>
    <%= f.hidden_field :prefilled_from, value: values['prefilled_from'] if values['prefilled_from'].present? %>
    <div id="cash-opening-fields" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 scroll-mt-48">
      <div><%= f.label :as_of, 'Cash as of close date', class: 'block text-sm font-semibold' %><%= f.date_field :as_of, value: values['as_of'], required: true, class: 'input', **cash_forecast_field_error('forecast_as_of'), data: { cash_forecast_form_target: 'asOf entry', entry_label: 'Close date', action: 'change->cash-forecast-form#update' } %></div>
      <div><%= f.label :currency, 'Currency', class: 'block text-sm font-semibold' %><%= f.text_field :currency, value: values['currency'], required: true, maxlength: 3, pattern: '[A-Za-z]{3}', class: 'input', **cash_forecast_field_error('forecast_currency'), data: { cash_forecast_form_target: 'entry', entry_label: 'Currency' } %></div>
      <div><%= f.label :horizon, 'Forecast weeks', class: 'block text-sm font-semibold' %><%= f.select :horizon, [4, 8, 13], { selected: horizon }, class: 'input', **cash_forecast_field_error('forecast_horizon'), data: { cash_forecast_form_target: 'horizon', action: 'change->cash-forecast-form#update' } %></div>
      <div><%= f.label :opening, 'Opening cash (currency units)', class: 'block text-sm font-semibold' %><%= f.text_field :opening, value: values['opening'], inputmode: 'decimal', autocomplete: 'off', required: true, class: 'input text-right tabular-nums', placeholder: 'e.g. 12,500.00', **cash_forecast_field_error('forecast_opening'), data: { cash_forecast_form_target: 'entry opening', entry_label: 'Opening cash', action: 'change->cash-forecast-form#normalize' } %></div>
      <div><%= f.label :basis, 'Opening cash basis', class: 'block text-sm font-semibold' %><%= f.select :basis, [['Planning assumption', 'assumption'], ['Bank balance entered by reviewer', 'entered_balance']], { selected: values['basis'] }, class: 'input', **cash_forecast_field_error('forecast_basis') %></div>
      <div><%= f.label :reserve, 'Minimum reserve (optional)', class: 'block text-sm font-semibold' %><%= f.text_field :reserve, value: values['reserve'], inputmode: 'decimal', autocomplete: 'off', class: 'input text-right tabular-nums', placeholder: 'Blank checks for negative cash only', **cash_forecast_field_error('forecast_reserve'), data: { cash_forecast_form_target: 'reserve', action: 'change->cash-forecast-form#normalize' } %></div>
    </div>
    <p class="text-xs text-mocha">Amounts may use thousands commas, a leading $ and leading-dot cents, for example $12,500.00 or .50.</p>
    <div><%= f.label :notes, 'Assumptions & source of opening balance', class: 'block text-sm font-semibold' %><%= f.text_area :notes, value: values['notes'], required: true, maxlength: 4000, rows: 3, class: 'input', placeholder: 'Bank/account scope, expected deposit timing, payroll/tax dates, one-off payments and what remains uncertain.', **cash_forecast_field_error('forecast_notes'), data: { cash_forecast_form_target: 'entry', entry_label: 'Scenario assumptions' } %></div>
    <%= render 'weeks', values: values, horizon: horizon %>
    <%= render 'zero_confirmation' if @forecast&.blank_entries&.any? %>
    <p class="text-xs text-mocha">Calculate previews the scenario. Retain saves an encrypted version with its assumptions. Neither action moves money or sends email/messages.</p><div class="flex flex-wrap gap-2"><p hidden role="status" class="text-sm font-semibold text-amber-950" data-cash-forecast-form-target="changed">Recalculate to refresh results and enable download / retention.</p><%= f.button(@forecast ? 'Recalculate cash scenario' : 'Calculate cash scenario', name: 'intent', value: 'preview', class: 'btn-primary') %><% if @forecast %><%= f.button 'Download scenario CSV', name: 'intent', value: 'csv', class: 'btn-ghost', data: { cash_forecast_form_target: 'output' } %><% if Current.user.can?('reports.write') %><%= f.button 'Retain scenario version', name: 'intent', value: 'retain', class: 'btn-ghost', data: { cash_forecast_form_target: 'output' } %><% end %><% end %></div>
  <% end %>
  <%= link_to 'Find retained close packages & forecast versions', reconciliation_documents_path(source: 'rupert', category: 'archives'), class: 'text-sm text-olive underline' %>
</div>
