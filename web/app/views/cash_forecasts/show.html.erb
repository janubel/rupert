<% content_for :title, 'Cash forecast' %>
<% values = @values || {}; horizon = %w[4 8 13].include?(values['horizon']) ? values['horizon'].to_i : 8 %>
<div class="mx-auto max-w-6xl space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-mocha">Money · Planning scenario</p><h1 class="page-title mt-2">Cash forecast</h1><p class="mt-2 text-sm text-mocha">Plan weekly bank receipts and payments. Keep the assumptions and each retained version.</p></div><%= link_to 'Back to financial close', financial_close_path(day: @baseline&.day&.iso8601), class: 'btn-ghost' %></header>
  <section class="card card-pad space-y-2"><h2 class="font-semibold">One currency. Explicit cash assumptions.</h2><p class="text-sm text-mocha">Enter bank cash as of the selected close date and the expected receipts/payments for each following week. Include payroll, tax, fees and other outflows once. Sales totals, gateway settlements and processor deposits are not automatically treated as bank cash.</p><% if @baseline %><p class="text-sm">Baseline <%= @baseline.day.strftime('%b %-d, %Y') %> · <%= @baseline.review_current? ? "Current review: #{@baseline.review.status.humanize}" : 'Current review still needed' %> · <%= @baseline.open_follow_ups.size %> open follow-ups. <%= link_to 'Inspect baseline evidence', financial_close_path(day: @baseline.day.iso8601), class: 'text-olive underline' %></p><% end %></section>
  <% if @error %><p role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm"><%= @error %> Entered assumptions remain below.</p><% end %>
  <% if @forecast %><section id="forecast-results" class="space-y-4 scroll-mt-48" aria-label="Forecast results"><div class="grid gap-3 sm:grid-cols-3"><div class="card card-pad"><p class="text-xs text-mocha">Final weekly closing cash · <%= @forecast.currency %></p><p class="mt-2 font-display text-2xl"><%= reconciliation_money(@forecast.rows.last[:closing_cents]) %></p></div><div class="card card-pad"><p class="text-xs text-mocha">Lowest weekly closing cash · <%= @forecast.currency %></p><p class="mt-2 font-display text-2xl"><%= reconciliation_money(@forecast.rows.map { |row| row[:closing_cents] }.min) %></p></div><div class="card card-pad <%= @forecast.first_shortfall ? 'border-amber-300 bg-amber-50' : '' %>"><p class="text-xs text-mocha"><%= @forecast.reserve_cents ? 'First closing balance below your reserve' : 'First negative closing balance' %></p><p class="mt-2 font-semibold"><%= @forecast.first_shortfall ? "#{@forecast.first_shortfall[:week].zero? ? 'At opening' : "Week #{@forecast.first_shortfall[:week]}"} · #{@forecast.first_shortfall[:to].strftime('%b %-d')}" : 'None in this scenario' %></p></div></div><% if (shortfall = @forecast.first_shortfall) %><div class="rounded-xl border border-amber-300 bg-amber-50 p-4 space-y-3" aria-label="Cash shortfall action"><p class="font-semibold"><%= @forecast.currency %> <%= reconciliation_money(@forecast.shortfall_cents) %> below <%= @forecast.reserve_cents ? 'your reserve' : 'zero cash' %> <%= shortfall[:week].zero? ? 'at opening' : "in week #{shortfall[:week]}" %></p><p class="text-sm">Check the timing and amounts in your plan, then recalculate. This is an entered scenario, not a confirmed bank shortfall.</p><%= link_to(shortfall[:week].zero? ? 'Review opening cash' : "Review week #{shortfall[:week]} cash plan", shortfall[:week].zero? ? '#cash-opening-fields' : "#cash-week-#{shortfall[:week]}", class: 'btn-primary btn-sm', data: { turbo: false }) %></div><% end %><p class="text-xs text-mocha md:hidden">Swipe the table sideways to see every weekly balance.</p><div class="card overflow-x-auto"><table class="w-full text-sm"><caption class="p-4 text-left font-semibold">Weekly scenario · <%= @forecast.currency %> · amounts in currency units</caption><thead><tr><th scope="col" class="th">Week ending</th><th scope="col" class="th text-right">Opening</th><th scope="col" class="th text-right">Bank receipts</th><th scope="col" class="th text-right">Payments</th><th scope="col" class="th text-right">Closing</th></tr></thead><tbody><% @forecast.rows.each do |row| %><tr class="<%= row[:closing_cents] < (@forecast.reserve_cents || 0) ? 'bg-amber-50' : '' %>"><th scope="row" class="td whitespace-nowrap"><%= row[:to].strftime('%b %-d, %Y') %></th><% %i[opening_cents receipts_cents payments_cents closing_cents].each do |key| %><td class="td text-right whitespace-nowrap"><%= reconciliation_money(row[key]) %></td><% end %></tr><% end %></tbody></table></div><p class="text-xs text-mocha">A manual scenario, not a prediction or verified bank balance. Weekly closing balances do not model intraday shortfalls or funding delays.</p><% if @retained_document %><p class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm">Scenario version #<%= @retained_document.id %> retained. <%= link_to 'Download retained assumptions & forecast JSON', document_daily_reconciliation_path(@retained_document), class: 'font-semibold text-olive underline' %></p><% end %></section><% end %>
  <%# Normal submission and the busy opt-out preserve the preview/CSV/retain submitter value. %>
  <%= form_with url: cash_forecast_path, scope: :forecast, class: 'card card-pad space-y-5', data: { turbo: false, busy: false, controller: 'cash-forecast-form', action: 'input->cash-forecast-form#markChanged change->cash-forecast-form#markChanged', cash_forecast_form_calculated_value: @forecast.present? } do |f| %>
    <p hidden role="status" class="rounded-xl border border-amber-300 bg-amber-50 p-3 text-sm" data-cash-forecast-form-target="changed">Inputs changed. Results above are from the last calculation. Recalculate before downloading or retaining a version.</p>
    <%= f.hidden_field :baseline_digest, value: @baseline&.report&.digest %>
    <div id="cash-opening-fields" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 scroll-mt-48"><div><%= f.label :as_of, 'Cash as of close date', class: 'block text-sm font-semibold' %><%= f.date_field :as_of, value: values['as_of'], required: true, class: 'input', data: { cash_forecast_form_target: 'asOf', action: 'change->cash-forecast-form#update' } %></div><div><%= f.label :currency, 'Currency', class: 'block text-sm font-semibold' %><%= f.text_field :currency, value: values['currency'], required: true, maxlength: 3, pattern: '[A-Za-z]{3}', class: 'input' %></div><div><%= f.label :horizon, 'Forecast weeks', class: 'block text-sm font-semibold' %><%= f.select :horizon, [4, 8, 13], { selected: horizon }, class: 'input', data: { cash_forecast_form_target: 'horizon', action: 'change->cash-forecast-form#update' } %></div><div><%= f.label :opening, 'Opening cash (currency units)', class: 'block text-sm font-semibold' %><%= f.text_field :opening, value: values['opening'], inputmode: 'decimal', required: true, class: 'input', placeholder: 'Explicit amount, e.g. 12500.00' %></div><div><%= f.label :basis, 'Opening cash basis', class: 'block text-sm font-semibold' %><%= f.select :basis, [['Planning assumption', 'assumption'], ['Bank balance entered by reviewer', 'entered_balance']], { selected: values['basis'] }, class: 'input' %></div><div><%= f.label :reserve, 'Minimum reserve (optional)', class: 'block text-sm font-semibold' %><%= f.text_field :reserve, value: values['reserve'], inputmode: 'decimal', class: 'input', placeholder: 'Blank checks for negative cash only' %></div></div>
    <div><%= f.label :notes, 'Assumptions & source of opening balance', class: 'block text-sm font-semibold' %><%= f.text_area :notes, value: values['notes'], required: true, maxlength: 4000, rows: 3, class: 'input', placeholder: 'Bank/account scope, expected deposit timing, payroll/tax dates, one-off payments and what remains uncertain.' %></div>
    <section class="space-y-3"><h2 class="font-display text-xl">Weekly cash plan</h2><p class="text-sm text-mocha">Enter an explicit 0 for no planned cash movement. Do not count a vendor payment again in another expense amount.</p><div class="grid gap-3 md:grid-cols-2"><% 13.times do |index| %><% week = values.fetch('weeks', {})[index.to_s] || {} %><fieldset id="cash-week-<%= index + 1 %>" class="rounded-xl border border-fog p-4 min-w-0 scroll-mt-48" data-cash-forecast-form-target="week" data-week="<%= index + 1 %>" <%= 'hidden' if index >= horizon %>><legend class="px-1 text-sm font-semibold">Week <%= index + 1 %><span data-week-dates><%= @baseline ? " · #{@baseline.day.next_day(index * 7 + 1).strftime('%b %-d')} – #{@baseline.day.next_day((index + 1) * 7).strftime('%b %-d')}" : '' %></span></legend><div class="grid gap-3 sm:grid-cols-2"><div><%= label_tag "forecast_weeks_#{index}_receipts", 'Expected bank receipts', class: 'block text-sm' %><%= text_field_tag "forecast[weeks][#{index}][receipts]", week['receipts'], id: "forecast_weeks_#{index}_receipts", inputmode: 'decimal', required: index < horizon, disabled: index >= horizon, class: 'input' %></div><div><%= label_tag "forecast_weeks_#{index}_payments", 'Expected cash payments', class: 'block text-sm' %><%= text_field_tag "forecast[weeks][#{index}][payments]", week['payments'], id: "forecast_weeks_#{index}_payments", inputmode: 'decimal', required: index < horizon, disabled: index >= horizon, class: 'input' %></div></div></fieldset><% end %></div></section>
    <p class="text-xs text-mocha">Calculate previews the scenario. Retain saves an encrypted version with its assumptions. Neither action moves money or sends email/messages.</p><div class="flex flex-wrap gap-2"><p hidden role="status" class="text-sm font-semibold text-amber-950" data-cash-forecast-form-target="changed">Recalculate to refresh results and enable download / retention.</p><%= f.button(@forecast ? 'Recalculate cash scenario' : 'Calculate cash scenario', name: 'intent', value: 'preview', class: 'btn-primary') %><% if @forecast %><%= f.button 'Download scenario CSV', name: 'intent', value: 'csv', class: 'btn-ghost', data: { cash_forecast_form_target: 'output' } %><% if Current.user.can?('reports.write') %><%= f.button 'Retain scenario version', name: 'intent', value: 'retain', class: 'btn-ghost', data: { cash_forecast_form_target: 'output' } %><% end %><% end %></div>
  <% end %>
  <%= link_to 'Find retained close packages & forecast versions', reconciliation_documents_path(source: 'rupert', category: 'archives'), class: 'text-sm text-olive underline' %>
</div>
