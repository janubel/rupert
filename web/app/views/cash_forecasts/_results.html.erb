<% blanks = @forecast.blank_entries %>
<section id="forecast-results" class="space-y-4 scroll-mt-48" aria-label="Forecast results">
  <p hidden role="status" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm" data-cash-forecast-form-target="changed">These results use the previous inputs. Recalculate before using them. <%= link_to 'Review cash plan entries', '#cash-plan-checklist', class: 'font-semibold text-olive underline', data: { turbo: false } %></p>
  <div class="grid gap-3 sm:grid-cols-3"><div class="card card-pad"><p class="text-xs text-mocha">Final weekly closing cash · <%= @forecast.currency %></p><p class="mt-2 font-display text-2xl tabular-nums"><%= reconciliation_money(@forecast.rows.last[:closing_cents]) %></p></div><div class="card card-pad"><p class="text-xs text-mocha">Lowest weekly closing cash · <%= @forecast.currency %></p><p class="mt-2 font-display text-2xl tabular-nums"><%= reconciliation_money(@forecast.rows.map { |row| row[:closing_cents] }.min) %></p></div><div class="card card-pad <%= @forecast.first_shortfall ? 'border-amber-300 bg-amber-50' : '' %>"><p class="text-xs text-mocha"><%= @forecast.reserve_cents ? 'First closing balance below your reserve' : 'First negative closing balance' %></p><p class="mt-2 font-semibold"><%= @forecast.first_shortfall ? "#{@forecast.first_shortfall[:week].zero? ? 'At opening' : "Week #{@forecast.first_shortfall[:week]}"} · #{@forecast.first_shortfall[:to].strftime('%b %-d')}" : 'None in this scenario' %></p></div></div>
  <% if blanks.any? %><p class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm" aria-label="Blank entries counted as zero"><span class="font-semibold"><%= pluralize(blanks.size, 'blank weekly entry') %> counted as 0 in these results.</span> Confirm them before downloading or retaining. <%= link_to 'Review blank entries', '#cash-zero-confirmation', class: 'font-semibold text-olive underline', data: { turbo: false } %></p><% end %>
  <% if (shortfall = @forecast.first_shortfall) %><div class="rounded-xl border border-amber-300 bg-amber-50 p-4 space-y-3" aria-label="Cash shortfall action"><p class="font-semibold"><%= @forecast.currency %> <%= reconciliation_money(@forecast.shortfall_cents) %> below <%= @forecast.reserve_cents ? 'your reserve' : 'zero cash' %> <%= shortfall[:week].zero? ? 'at opening' : "in week #{shortfall[:week]}" %></p><p class="text-sm">Check the timing and amounts in your plan, then recalculate. This is an entered scenario, not a confirmed bank shortfall.</p><%= link_to(shortfall[:week].zero? ? 'Review opening cash' : "Review week #{shortfall[:week]} cash plan", shortfall[:week].zero? ? '#cash-opening-fields' : "#cash-week-#{shortfall[:week]}", class: 'btn-primary btn-sm', data: { turbo: false }) %></div><% end %>
  <p class="text-xs text-mocha md:hidden">Swipe the table sideways to see every weekly balance.</p>
  <div class="card overflow-x-auto"><table class="w-full text-sm tabular-nums"><caption class="p-4 text-left font-semibold">Weekly scenario · <%= @forecast.currency %> · amounts in currency units</caption>
    <thead><tr><th scope="col" class="th">Week ending</th><th scope="col" class="th text-right">Opening</th><th scope="col" class="th text-right">Bank receipts</th><th scope="col" class="th text-right">Payments</th><th scope="col" class="th text-right">Net change</th><th scope="col" class="th text-right">Closing</th></tr></thead>
    <tbody><% @forecast.rows.each do |row| %><% blank = blanks.select { |entry| entry[:week] == row[:week] }.map { |entry| entry[:field] } %><tr class="<%= row[:closing_cents] < (@forecast.reserve_cents || 0) ? 'bg-amber-50' : '' %>"><th scope="row" class="td whitespace-nowrap"><%= row[:to].strftime('%b %-d, %Y') %></th><td class="td text-right whitespace-nowrap"><%= reconciliation_money(row[:opening_cents]) %></td><% %w[receipts payments].each do |key| %><td class="td text-right whitespace-nowrap"><%= reconciliation_money(row[:"#{key}_cents"]) %><% if blank.include?(key) %> <span class="text-xs text-amber-950">(blank)</span><% end %></td><% end %><td class="td text-right whitespace-nowrap"><%= reconciliation_difference(row[:receipts_cents] - row[:payments_cents]) %></td><td class="td text-right whitespace-nowrap"><%= reconciliation_money(row[:closing_cents]) %></td></tr><% end %></tbody>
    <tfoot class="font-semibold"><tr><th scope="row" class="td">Total · <%= pluralize(@forecast.horizon, 'week') %></th><td class="td text-right whitespace-nowrap"><%= reconciliation_money(@forecast.opening_cents) %></td><td class="td text-right whitespace-nowrap"><%= reconciliation_money(@forecast.receipts_cents) %></td><td class="td text-right whitespace-nowrap"><%= reconciliation_money(@forecast.payments_cents) %></td><td class="td text-right whitespace-nowrap"><%= reconciliation_difference(@forecast.receipts_cents - @forecast.payments_cents) %></td><td class="td text-right whitespace-nowrap"><%= reconciliation_money(@forecast.rows.last[:closing_cents]) %></td></tr></tfoot>
  </table></div>
  <p class="text-xs text-mocha">A manual scenario, not a prediction or verified bank balance. Weekly closing balances do not model intraday shortfalls or funding delays.</p>
  <% if @retained_document %><p class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm">Scenario version #<%= @retained_document.id %> retained. <%= link_to 'Download retained assumptions & forecast JSON', document_daily_reconciliation_path(@retained_document), class: 'font-semibold text-olive underline' %></p><% end %>
</section>
