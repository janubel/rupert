<% blanks = @forecast.blank_entries %>
<section id="forecast-results" class="space-y-4 scroll-mt-48" aria-label="Forecast results">
  <p hidden role="status" class="rounded-card border border-warn-edge bg-warn-bg p-4 text-sm" data-cash-forecast-form-target="changed">These results use the previous inputs. Recalculate before using them. <%= link_to 'Review cash plan entries', '#cash-plan-checklist', class: 'font-semibold text-olive-deep underline', data: { turbo: false } %></p>
  <div class="grid gap-3 sm:grid-cols-3">
    <div class="stat"><div class="stat-label">Final weekly closing cash · <%= @forecast.currency %><%= define('closing_cash') %></div><p class="stat-value mt-1"><%= reconciliation_money(@forecast.rows.last[:closing_cents]) %></p></div>
    <div class="stat"><p class="stat-label">Lowest weekly closing cash · <%= @forecast.currency %></p><p class="stat-value mt-1"><%= reconciliation_money(@forecast.rows.map { |row| row[:closing_cents] }.min) %></p></div>
    <div class="stat <%= 'border-warn-edge' if @forecast.first_shortfall %>"><p class="stat-label"><%= @forecast.reserve_cents ? 'First closing balance below your reserve' : 'First negative closing balance' %></p><p class="stat-value-sm mt-1"><%= @forecast.first_shortfall ? "#{@forecast.first_shortfall[:week].zero? ? 'At opening' : "Week #{@forecast.first_shortfall[:week]}"} · #{@forecast.first_shortfall[:to].strftime('%b %-d')}" : 'None in this scenario' %></p></div>
  </div>
  <%= explain_calculation(title: "Final closing cash · #{pluralize(@forecast.horizon, 'week')} · #{@forecast.currency}", id: 'forecast-closing-cash',
        formula: 'Opening cash + expected bank receipts − expected payments, week by week. Each week opens with the previous week’s closing balance.',
        rows: [['Opening cash', reconciliation_money(@forecast.opening_cents)], ['Expected bank receipts (all weeks)', reconciliation_money(@forecast.receipts_cents)],
               ['Expected payments (all weeks)', "− #{reconciliation_money(@forecast.payments_cents)}"], ['Final weekly closing cash', reconciliation_money(@forecast.rows.last[:closing_cents])]],
        note: "#{blanks.any? ? "#{pluralize(blanks.size, 'blank weekly entry')} counted as 0. " : ''}Every figure is an assumption you entered; sales totals and processor deposits are not treated as bank cash, and Rupert reads no bank balance.",
        term: 'closing_cash', lesson: 'books') %>
  <% if blanks.any? %><p class="rounded-card border border-warn-edge bg-warn-bg p-4 text-sm" aria-label="Blank entries counted as zero"><span class="font-semibold"><%= pluralize(blanks.size, 'blank weekly entry') %> counted as 0 in these results.</span> Confirm them before downloading or retaining. <%= link_to 'Review blank entries', '#cash-zero-confirmation', class: 'font-semibold text-olive-deep underline', data: { turbo: false } %></p><% end %>
  <% if (shortfall = @forecast.first_shortfall) %><div class="space-y-3 rounded-card border border-warn-edge bg-warn-bg p-4" aria-label="Cash shortfall action"><p class="font-semibold"><%= @forecast.currency %> <%= reconciliation_money(@forecast.shortfall_cents) %> below <%= @forecast.reserve_cents ? 'your reserve' : 'zero cash' %> <%= shortfall[:week].zero? ? 'at opening' : "in week #{shortfall[:week]}" %></p><p class="text-sm">Check the timing and amounts in your plan, then recalculate. This is an entered scenario, not a confirmed bank shortfall.</p><%= link_to(shortfall[:week].zero? ? 'Review opening cash' : "Review week #{shortfall[:week]} cash plan", shortfall[:week].zero? ? '#cash-opening-fields' : "#cash-week-#{shortfall[:week]}", class: 'btn-ghost btn-sm', data: { turbo: false }) %></div><% end %>
  <div class="table-region" role="region" tabindex="0" aria-label="Weekly scenario"><table class="table tabular-nums">
    <caption class="p-4 text-left font-semibold">Weekly scenario · <%= @forecast.currency %> · amounts in currency units</caption>
    <thead><tr><th scope="col" class="th">Week ending</th><th scope="col" class="th num">Opening</th><th scope="col" class="th num">Bank receipts</th><th scope="col" class="th num">Payments</th><th scope="col" class="th num">Net change</th><th scope="col" class="th num">Closing</th></tr></thead>
    <tbody><% @forecast.rows.each do |row| %><% blank = blanks.select { |entry| entry[:week] == row[:week] }.map { |entry| entry[:field] } %><tr class="<%= row[:closing_cents] < (@forecast.reserve_cents || 0) ? 'bg-warn-bg' : '' %>"><th scope="row" class="td whitespace-nowrap text-left font-medium"><%= row[:to].strftime('%b %-d, %Y') %></th><td class="td num whitespace-nowrap"><%= reconciliation_money(row[:opening_cents]) %></td><% %w[receipts payments].each do |key| %><td class="td num whitespace-nowrap"><%= reconciliation_money(row[:"#{key}_cents"]) %><% if blank.include?(key) %> <span class="text-xs text-mocha">(blank)</span><% end %></td><% end %><td class="td num whitespace-nowrap"><%= reconciliation_difference(row[:receipts_cents] - row[:payments_cents]) %></td><td class="td num whitespace-nowrap"><%= reconciliation_money(row[:closing_cents]) %></td></tr><% end %></tbody>
    <tfoot class="font-semibold"><tr><th scope="row" class="td text-left">Total · <%= pluralize(@forecast.horizon, 'week') %></th><td class="td num whitespace-nowrap"><%= reconciliation_money(@forecast.opening_cents) %></td><td class="td num whitespace-nowrap"><%= reconciliation_money(@forecast.receipts_cents) %></td><td class="td num whitespace-nowrap"><%= reconciliation_money(@forecast.payments_cents) %></td><td class="td num whitespace-nowrap"><%= reconciliation_difference(@forecast.receipts_cents - @forecast.payments_cents) %></td><td class="td num whitespace-nowrap"><%= reconciliation_money(@forecast.rows.last[:closing_cents]) %></td></tr></tfoot>
  </table></div>
  <p class="text-xs text-mocha">A manual scenario, not a prediction or verified bank balance. Weekly closing balances do not model intraday shortfalls or funding delays.</p>
  <% if @retained_document %><p class="rounded-card border border-success-edge bg-success-bg p-4 text-sm">Scenario version #<%= @retained_document.id %> retained. <%= link_to 'Download retained assumptions and forecast JSON', document_daily_reconciliation_path(@retained_document), class: 'font-semibold text-olive-deep underline' %></p><% end %>
</section>
