<% content_for :title, "Order #{@order.order_number}" %>
<div class="space-y-8">
  <%= page_header 'Order confirmed', subtitle: "Order #{@order.order_number} was placed and paid. A record of this sale now appears in the store dashboard.", eyebrow: 'Warehouse sale' do %>
    <%= link_to 'Open the catalog', warehouse_sale_path(@share.token), class: 'btn-primary' %>
  <% end %>

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="section-card" aria-label="Items">
      <%= section_heading 'Items' %>
      <ul class="divide-y divide-fog text-sm">
        <% @order_lines.each do |line| %>
          <li class="flex items-center justify-between gap-3 py-2">
            <span class="min-w-0 truncate text-mocha"><%= line.quantity %> × <%= line.name %></span>
            <span class="num shrink-0 font-medium text-ink"><%= number_to_currency(line.line_cents / 100.0) %></span>
          </li>
        <% end %>
      </ul>
      <div class="flex items-center justify-between border-t border-fog pt-3">
        <span class="text-sm text-mocha">Total paid</span>
        <span class="num text-lg font-semibold text-ink"><%= number_to_currency(@order.gross_cents / 100.0) %></span>
      </div>
      <% if @payment&.reference.present? %>
        <p class="text-xs text-taupe">Payment reference: <%= @payment.reference %></p>
      <% end %>
    </section>

    <% if @order.shipping_address1.present? %>
      <section class="section-card" aria-label="Shipping address">
        <%= section_heading 'Shipping to' %>
        <address class="not-italic text-sm text-mocha">
          <%= @order.shipping_name %><br>
          <%= @order.shipping_address1 %><% if @order.shipping_address2.present? %><br><%= @order.shipping_address2 %><% end %><br>
          <%= [@order.shipping_city, @order.shipping_province].compact.join(', ') %> <%= @order.shipping_zip %><br>
          <%= @order.shipping_country %>
          <% if @order.shipping_phone.present? %><br><%= @order.shipping_phone %><% end %>
        </address>
      </section>
    <% end %>
  </div>
</div>
