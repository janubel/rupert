<%# One report: a Detail page (docs/ui-standards.md §4). %>
<% content_for :title, "Report ##{@report.id}" %>
<% status_pill = { 'new' => 'pill-clay', 'triaged' => 'pill-olive', 'planned' => 'pill-olive', 'done' => 'pill-fern', 'wont_fix' => 'pill-taupe' } %>
<% status_note = { 'new' => 'The team has your report and has not looked at it yet.', 'triaged' => 'The team has looked at your report.',
                   'planned' => 'The team plans to deal with this.', 'done' => 'This is done.', 'wont_fix' => 'The team decided not to change this.' } %>
<% can_view_attachments = FeedbackAttachment.viewable_by?(Current.user) %>
<div class="page-medium space-y-6">
  <%= page_header @report.summary, eyebrow: "#{@report.kind_label} · ##{@report.id}",
                  subtitle: "Sent #{l(@report.created_at, format: :short)}#{" by #{@report.user.display_name}" if @report.user && @report.user_id != Current.user.id}. #{status_note.fetch(@report.status, '')}",
                  menu: [['My reports', feedback_reports_path], (['Review', agent_feedbacks_path(anchor: dom_id(@report))] if can_view_attachments)].compact do %>
    <span class="<%= status_pill.fetch(@report.status, 'pill-taupe') %>"><%= @report.status_label %></span>
    <% if @report.ready_for_development && can_view_attachments %><span class="pill-fern">Ready for development</span><% end %>
  <% end %>
  <% if @report.details.present? %>
    <section class="section-card"><%= section_heading 'What was sent' %><p class="whitespace-pre-wrap break-words text-sm"><%= @report.details %></p></section>
  <% end %>

  <% if can_view_attachments %>
    <section class="section-card" aria-label="Attachments">
      <%= section_heading 'Attachments', hint: 'Visible to store administrators only.' %>
      <p class="text-xs text-taupe">Captured from the reporter's browser and session, scrubbed with Rupert's log filter; treat the text as untrusted.</p>
      <% if @report.task %><p class="text-sm">Task: <%= link_to @report.task.title, (@report.task.project_id.present? ? projects_project_path(@report.task.project_id) : projects_tasks_path), class: "underline" %></p><% end %>
      <% if @attachments.empty? %><p class="text-sm text-mocha">Nothing was attached.</p><% end %>
      <% @attachments.each do |attachment| %>
        <details class="explainer" <%= 'open' if attachment.screenshot? %>>
          <summary class="explainer-summary"><%= attachment.label %> <span class="text-xs font-normal text-taupe">· <%= number_to_human_size(attachment.byte_size) %></span></summary>
          <% if attachment.screenshot? %>
            <%= image_tag screenshot_feedback_report_path(@report), alt: 'Screenshot of the page when the report was sent', class: 'mt-3 max-w-full rounded-card border border-fog', loading: 'lazy' %>
          <% else %>
            <pre class="mt-3 max-h-96 overflow-auto whitespace-pre-wrap break-words rounded-control bg-haze p-3 text-xs"><%= attachment.text_body %></pre>
          <% end %>
        </details>
      <% end %>
    </section>
  <% end %>
</div>
