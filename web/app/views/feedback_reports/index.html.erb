<%# My reports: a List page (docs/ui-standards.md §4) of the reports this person sent. %>
<% status_pill = { 'new' => 'pill-clay', 'triaged' => 'pill-olive', 'planned' => 'pill-olive', 'done' => 'pill-fern', 'wont_fix' => 'pill-taupe' } %>
<div class="page-medium space-y-6">
  <%= page_header 'My reports', subtitle: 'Bugs, requests and questions you sent with the ladybug in the header, with their status.' %>
  <p class="text-xs text-taupe">Screenshots and logs are visible to store administrators only.</p>
  <% if @reports.empty? %>
    <%= empty_state 'No reports yet', hint: 'Use the ladybug in the header from any page to send one.' %>
  <% else %>
    <div class="card">
      <ul class="divide-y divide-fog">
        <% @reports.each do |report| %>
          <li class="flex flex-wrap items-start justify-between gap-3 p-4">
            <div class="min-w-0">
              <p class="font-medium text-ink"><%= link_to report.summary, feedback_report_path(report), class: 'underline' %></p>
              <p class="text-xs text-taupe"><%= report.kind_label %> · #<%= report.id %> · <%= l(report.created_at, format: :short) %></p>
            </div>
            <span class="<%= status_pill.fetch(report.status, 'pill-taupe') %>"><%= report.status_label %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
