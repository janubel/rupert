<% content_for :title, 'Drive copies' %>
<% connected = @connection&.connected? && @connection.enabled
   can_manage = Current.user.can?('reports.write') && Current.user.can?('settings.write')
   menu = []
   menu << ['Sync now', sync_retention_drive_path, { method: :post }] if connected && Current.user.can?('reports.write')
   menu << ['Reconnect Google Drive', connect_retention_drive_path, { data: { turbo: false } }] if connected && can_manage && RetentionDrive.configured?
   menu << ['Open days', overview_reconciliation_follow_ups_path]
   menu << ['Source documents', reconciliation_documents_path]
   menu << ['Daily reconciliation', daily_reconciliations_path]
   copied = @counts.fetch('verified', 0); failed = @counts.fetch('failed', 0); waiting = [@total - copied - failed, 0].max %>
<div class="page-medium space-y-6">
  <%= page_header 'Drive copies', subtitle: 'An automatic second copy of reports, invoices and every archived reconciliation in Google Drive.', menu: menu do %>
    <% if connected && @root&.drive_url %><%= link_to 'Open retention folder', @root.drive_url, target: '_blank', rel: 'noopener noreferrer', class: 'btn-primary' %>
    <% elsif !connected && can_manage && RetentionDrive.configured? %><%= link_to 'Connect Google Drive', connect_retention_drive_path, class: 'btn-primary', data: { turbo: false } %><% end %>
  <% end %>
  <%= fold_explainer('Rupert copies original file bytes without converting them. Each copy is downloaded and checked before it is marked Copied. Corrections and earlier report versions keep their own files. Only this workspace’s retained files are copied; whole-instance database backups have their own connection and schedule. Rupert does not share or delete retention files.', class: 'text-sm text-mocha') %>

  <% unless connected %>
    <div class="rounded-card border border-warn-edge bg-warn-bg p-4 text-sm" role="status">
      <p class="font-semibold">Google Drive setup is pending</p>
      <p class="mt-1">Originals already retained in Rupert remain available. Review missing reports and follow-ups while Drive setup waits.</p>
      <% if can_manage && !RetentionDrive.configured? %><p class="mt-1">The platform administrator needs to configure the Google Drive app in Settings.</p>
      <% elsif !can_manage %><p class="mt-1">Ask a workspace administrator to connect the destination account.</p><% end %>
    </div>
  <% end %>

  <section class="section-card" aria-labelledby="drive-connection-title">
    <div class="card-head">
      <div><h2 id="drive-connection-title" class="section-title"><%= connected ? 'Automatic retention is connected' : 'Connect your retention folder' %></h2><p class="card-hint"><%= connected ? @connection.account_email : 'Choose the Google account that should own this workspace’s documents.' %></p></div>
      <span class="<%= connected ? 'pill-fern' : 'pill-clay' %>"><%= connected ? 'Every 15 minutes' : 'Connection needed' %></span>
    </div>
    <% if @connection&.last_error.present? %><div role="status" class="rounded-card border border-warn-edge bg-warn-bg p-4 text-sm"><strong>Needs attention</strong><p class="mt-1"><%= @connection.last_error %></p></div><% end %>
    <div class="grid gap-3 sm:grid-cols-3" aria-label="Copy progress">
      <% [['Copied and verified', copied], ['Awaiting copy', waiting], ['Needs retry', failed]].each do |label, count| %>
        <div class="stat"><p class="stat-label"><%= label %></p><p class="stat-value-sm mt-1"><%= count %></p></div>
      <% end %>
    </div>
    <% if @connection&.last_synced_at %><p class="text-xs text-mocha">Last sync pass: <%= @connection.last_synced_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %>. Reload this page to see current progress.</p><% end %>
  </section>

  <section class="section-card" aria-labelledby="drive-folders-title">
    <div class="card-head"><div><h2 id="drive-folders-title" class="section-title">A folder structure you can browse</h2><p class="card-hint">Documents use the start of their covered period. All earlier versions stay available.</p></div></div>
    <div class="break-words rounded-card bg-cream p-4 font-mono text-sm leading-7">Rupert Document Retention — <%= Current.tenant.name %><br><span class="pl-4">Year / Month / Source / Originals</span><br><span class="pl-4">Year / Month / Source / Native Exports</span><br><span class="pl-4">Year / Month / Rupert / Report Archives</span><br><span class="pl-4">Year / Month / Ctrax / Source Snapshots</span></div>
    <%= fold_explainer('Existing files backfill automatically in batches of 25; new retained invoices, reports, native exports and archives enter the same queue. Native SwipeSimple and Authorize.net exports use their received export date, which does not establish their transaction coverage. C-Trax JSON files are normalized source snapshots. Upload any invoice that Rupert has not received from a source on the daily reconciliation page.', class: 'text-sm text-mocha') %>
  </section>

  <section class="space-y-3" aria-labelledby="drive-recent-title">
    <div class="card-head"><div><h2 id="drive-recent-title" class="section-title">Recent copies and retries</h2></div></div>
    <div class="table-region" role="region" tabindex="0" aria-label="Recent copies and retries"><table class="table">
      <thead><tr><th scope="col" class="th">Document</th><th scope="col" class="th">Folder</th><th scope="col" class="th">Status</th><th scope="col" class="th">Drive copy</th></tr></thead>
      <tbody>
        <% @recent.each do |item| %>
          <tr>
            <td class="td break-words"><%= item.title %></td>
            <td class="td"><%= item.folder_path.presence || 'Waiting for sync' %></td>
            <td class="td"><span class="<%= { 'verified' => 'pill-fern', 'failed' => 'pill-rose' }.fetch(item.status, 'pill-taupe') %>"><%= item.status == 'verified' ? 'Copied · checksum verified' : (item.status == 'failed' ? 'Needs retry' : item.status.humanize) %></span><% if item.last_error.present? %><p class="mt-1 text-xs text-mocha"><%= item.last_error %></p><% end %></td>
            <td class="td"><% if item.drive_url %><%= link_to 'Open original', item.drive_url, target: '_blank', rel: 'noopener noreferrer', class: 'font-semibold text-olive-deep hover:underline' %><% else %>Pending verification<% end %></td>
          </tr>
        <% end %>
        <% if @recent.empty? %><tr><td class="empty-row" colspan="4"><%= connected ? 'No copies yet. The first copy pass is queued; your originals are already safe in Rupert.' : 'No copies yet. Connect Google Drive to copy existing and future retained files automatically.' %></td></tr><% end %>
      </tbody>
    </table></div>
  </section>

  <details class="explainer card card-pad">
    <summary class="explainer-summary font-semibold">Connection and recovery options</summary>
    <div class="mt-4 space-y-3 text-sm">
      <p>Disconnecting stops future uploads and removes Rupert’s saved retention token. Existing files remain in both places. Reconnecting the same Google account resumes its copy history.</p>
      <p>If Google blocks access while the OAuth app is in Testing, its developer must approve your account as a test user or finish production setup. Testing refresh tokens for Drive expire after seven days. Existing originals remain safe in Rupert while consent is repaired.</p>
      <% if connected && can_manage %><%= button_to 'Disconnect automatic retention', disconnect_retention_drive_path, class: 'btn-ghost' %><% end %>
    </div>
  </details>
</div>
