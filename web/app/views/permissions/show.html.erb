<% can_manage_accounts = Current.user.can_manage_accounts? %>
<% content_for :title, "Permissions" %>
<div class="space-y-6">
  <%= page_header 'Permissions', subtitle: 'What each role can do.',
        menu: (can_manage_accounts ? [['Reset to defaults', reset_permissions_path, { method: :post, data: { turbo_confirm: "Clear all role overrides and use the built-in defaults?" } }]] : nil) %>

  <%= form_tag save_permissions_path, method: :post, class: "space-y-4" do %>
    <div class="card">
      <div class="table-region" role="region" tabindex="0" aria-label="Permissions by role">
        <table class="table">
          <thead>
            <tr>
              <th scope="col" class="th min-w-44">Area / permission</th>
              <% @roles.each do |role| %>
                <th scope="col" class="th text-center"><%= role.to_s.humanize %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @catalog.each do |group| %>
              <tr class="bg-haze/40">
                <th scope="rowgroup" colspan="<%= @roles.length + 1 %>" class="px-4 py-2 text-left text-xs font-semibold text-mocha"><%= group[:area] %></th>
              </tr>
              <% group[:permissions].each do |permission| %>
                <tr>
                  <td class="td">
                    <p class="font-medium text-ink"><%= permission.split(".").last.humanize %></p>
                    <p class="font-mono text-xs text-taupe"><%= permission %></p>
                  </td>
                  <% @roles.each do |role| %>
                    <% checked = if @overrides[[role, permission]]
                        @overrides[[role, permission]].enabled?
                      else
                        @builtin.fetch(role, []).include?(permission) || @builtin.fetch(role, []).include?("*")
                      end %>
                    <td class="td text-center">
                      <% if role == 'employee' %>
                        <span class="text-taupe" title="Staff member — POS, own time records and assigned tasks"><%= @builtin.fetch('employee').include?(permission) ? '✓' : '—' %></span>
                      <% elsif @builtin.fetch(role, []).include?("*") %>
                        <span class="text-taupe" title="Super admin — always allowed">—</span>
                      <% else %>
                        <input type="checkbox" name="roles[<%= role %>][<%= permission %>]" value="1" <%= checked ? "checked" : "" %> class="checkbox" aria-label="<%= role.to_s.humanize %> · <%= permission %>" <%= "disabled" unless can_manage_accounts %>>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if can_manage_accounts %>
    <div class="form-actions">
      <%= submit_tag "Save permissions", class: "btn-primary" %>
      <%= link_to "Cancel", permissions_path, class: "btn-ghost" %>
    </div>
    <% end %>
  <% end %>
  <%= fold_explainer('Super admin always has full access; overrides in this table replace a role\'s built-in defaults. Staff access is fixed to POS, their own time records and assigned tasks and cannot be expanded by overrides. Empty cells mean a role uses its built-in default for that permission.', class: 'text-sm text-mocha') %>
</div>
