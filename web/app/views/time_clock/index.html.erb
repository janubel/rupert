<% content_for :title, 'Time clock' %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="space-y-6">
  <%= page_header 'Time clock', subtitle: "Clock your own work from this device, including remote work (#{Time.zone.name} time).",
        menu: (Current.user.can?('payroll.read') ? [['Commission preview', commission_preview_time_clock_path]] : nil) %>
  <section class="section-card">
    <% if @worker %>
      <%= section_heading "#{@worker.name} · #{@worker.employment_type.humanize}", hint: 'Corrections require review; these records do not automatically change payroll.' do %>
        <% if @open_shift %><span class="pill-fern">Clocked in</span><% else %><span class="pill-taupe">Clocked out</span><% end %>
      <% end %>
      <% if @open_shift %>
        <p class="text-sm">Since <%= l(@open_shift.started_at, format: '%b %-d, %Y %-I:%M:%S %p %Z') %> · <%= number_with_precision(@open_shift.hours, precision: 2) %> hours so far</p>
        <%= button_to 'Clock out', clock_out_time_clock_path, params: { shift_id: @open_shift.id }, method: :post, class: 'btn-primary btn-lg', data: { turbo: false } %>
      <% else %>
        <%= button_to 'Clock in', clock_in_time_clock_path, params: { request_token: SecureRandom.uuid }, method: :post, class: 'btn-primary btn-lg', data: { turbo: false } %>
      <% end %>
    <% else %>
      <%= section_heading 'Link your worker record', hint: 'Ask an administrator to connect exactly one active Staff record to your sign-in account. Contractors can use the same time clock. Your existing shift history stays below.' %>
      <% if @open_shift %>
        <p class="text-sm"><span class="pill-fern">Clocked in</span> <%= l(@open_shift.started_at, format: '%b %-d, %Y %-I:%M:%S %p %Z') %> · <%= number_with_precision(@open_shift.hours, precision: 2) %> hours so far</p>
        <%= button_to 'Clock out', clock_out_time_clock_path, params: { shift_id: @open_shift.id }, method: :post, class: 'btn-primary btn-lg', data: { turbo: false } %>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-3">
    <%= section_heading 'Your latest shifts' %>
    <% @shifts.each do |shift| %>
      <article class="card card-pad space-y-3">
        <p class="font-medium"><%= l(shift.started_at, format: '%b %-d, %Y %-I:%M:%S %p %Z') %> → <%= shift.ended_at ? l(shift.ended_at, format: '%b %-d, %Y %-I:%M:%S %p %Z') : 'Open shift' %></p>
        <p class="text-sm text-mocha"><%= number_with_precision(shift.hours, precision: 2) %> hours</p>
        <details class="explainer"><summary class="explainer-summary">Request a time correction</summary>
          <%= form_with url: request_correction_time_clock_path(shift), scope: :clock_correction, data: { turbo: false }, class: 'mt-3 space-y-3' do |form| %>
            <div class="grid gap-3 sm:grid-cols-2"><div><%= form.label :proposed_started_at, 'Correct clock-in', class: 'field-label' %><%= form.datetime_local_field :proposed_started_at, value: shift.started_at.in_time_zone.strftime('%Y-%m-%dT%H:%M:%S'), step: 1, required: true, class: 'input' %></div><div><%= form.label :proposed_ended_at, 'Correct clock-out', class: 'field-label' %><%= form.datetime_local_field :proposed_ended_at, value: shift.ended_at&.in_time_zone&.strftime('%Y-%m-%dT%H:%M:%S'), step: 1, required: true, class: 'input' %></div></div>
            <div><%= form.label :reason, 'Reason for correction', class: 'field-label' %><%= form.text_area :reason, required: true, maxlength: 1000, class: 'input', rows: 2 %></div>
            <%= form.submit 'Request review', class: 'btn-ghost' %>
          <% end %>
        </details>
        <% shift.corrections.sort_by(&:created_at).reverse.each do |correction| %><p class="text-xs text-taupe"><%= correction.status.capitalize %> correction: <%= l(correction.proposed_started_at, format: :short) %> → <%= l(correction.proposed_ended_at, format: :short) %> · <%= correction.reason %><% if correction.reviewed_at %> · reviewed <%= l(correction.reviewed_at, format: :short) %><% end %></p><% end %>
      </article>
    <% end %>
    <% if @shifts.empty? %><%= empty_state 'No shifts yet', hint: 'Your shifts appear here after you clock in.' %><% end %>
    <% if @pagy.pages > 1 %><%== @pagy.series_nav %><% end %>
  </section>

  <% if @pending_corrections %><section class="space-y-3">
    <%= section_heading 'Pending correction review', hint: 'Up to 100 pending requests shown. Approval records the reviewer and original values. A request becomes stale if the shift changes before approval.' %>
    <% @pending_corrections.each do |correction| %><article class="card card-pad space-y-3"><p class="font-medium"><%= correction.clock_shift.employee_name %></p><p class="text-sm">Original: <%= l(correction.original_started_at, format: '%b %-d, %Y %-I:%M:%S %p %Z') %> → <%= correction.original_ended_at ? l(correction.original_ended_at, format: '%b %-d, %Y %-I:%M:%S %p %Z') : 'Open' %><br>Requested: <%= l(correction.proposed_started_at, format: '%b %-d, %Y %-I:%M:%S %p %Z') %> → <%= l(correction.proposed_ended_at, format: '%b %-d, %Y %-I:%M:%S %p %Z') %></p><p class="text-sm text-mocha"><%= correction.reason %></p><div class="flex gap-2"><%= button_to 'Approve', approve_correction_time_clock_path(correction), method: :post, class: 'btn-primary btn-sm', data: { turbo_confirm: 'Apply these corrected shift times? This does not pay payroll.' } %><%= button_to 'Reject', reject_correction_time_clock_path(correction), method: :post, class: 'btn-ghost btn-sm' %></div></article><% end %>
    <% if @pending_corrections.empty? %><%= empty_state 'No corrections awaiting review' %><% end %>
  </section><% end %>
</div>
