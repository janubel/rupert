<section class="section-card border-warn-edge" aria-label="Missing register report search">
  <% if @missing_control %><% row = @missing_control; location = row[:location_id].present? ? Location.find_by(id: row[:location_id]) : nil %>
    <div class="card-head"><div><p class="eyebrow text-taupe">Missing register report · exact scope</p><h2 class="section-title"><%= reconciliation_source(row[:source]) %> · <%= row[:currency] %> · <%= @close_day.strftime('%b %-d, %Y') %></h2><p class="card-hint"><%= location&.name || row[:location_id].presence || 'Unassigned records only' %></p></div></div>
    <p class="text-sm text-mocha">Search results may include other kinds or covered periods. Keep this source, currency, location and business date when adding its control or tracking the missing original.</p>
    <div class="flex flex-wrap gap-2"><% if Current.user.can?('reports.write') %><%= link_to 'Add this control', daily_reconciliations_path(day: @close_day.iso8601, control_for: ReconciliationAttention.control_key(row), anchor: 'upload-document'), class: 'btn-primary btn-sm' %><%= link_to 'Track this missing report', new_reconciliation_follow_up_path(@request_context), class: 'btn-ghost btn-sm' %><% end %><%= link_to 'Reset to this report scope', reconciliation_documents_path(reconciliation_missing_control_search(row, @close_day)), class: 'btn-ghost btn-sm' %><%= link_to 'Back to day close', financial_close_path(day: @close_day.iso8601, anchor: 'close-missing-reports'), class: 'btn-ghost btn-sm' %></div>
  <% else %>
    <div class="card-head"><div><h2 class="section-title">Review the latest close checks</h2><p class="card-hint">This missing-report scope is no longer available for these dates, or the link is invalid. Check the current day before adding another request.</p></div></div>
    <%= link_to 'Review current close checks', financial_close_path(day: @close_day&.iso8601, anchor: 'close-missing-reports'), class: 'btn-primary btn-sm' %>
  <% end %>
</section>
