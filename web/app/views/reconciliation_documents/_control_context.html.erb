<section class="card card-pad space-y-3 border-amber-300 bg-amber-50" aria-label="Missing register report search">
  <% if @missing_control %><% row = @missing_control; location = row[:location_id].present? ? Location.find_by(id: row[:location_id]) : nil %>
    <p class="text-xs font-semibold uppercase tracking-wide text-mocha">Missing register report · exact scope</p><h2 class="font-display text-xl"><%= reconciliation_source(row[:source]) %> · <%= row[:currency] %> · <%= @close_day.strftime('%b %-d, %Y') %></h2><p class="text-sm"><%= location&.name || row[:location_id].presence || 'Unassigned records only' %></p><p class="text-sm text-mocha">Search results may include other kinds or covered periods. Keep this source, currency, location and business date when adding its control or tracking the missing original.</p>
    <div class="flex flex-wrap gap-2"><% if Current.user.can?('reports.write') %><%= link_to 'Add this control', daily_reconciliations_path(day: @close_day.iso8601, control_for: ReconciliationAttention.control_key(row), anchor: 'upload-document'), class: 'btn-primary btn-sm' %><%= link_to 'Track this missing report', new_reconciliation_follow_up_path(@request_context), class: 'btn-ghost btn-sm' %><% end %><%= link_to 'Reset to this report scope', reconciliation_documents_path(reconciliation_missing_control_search(row, @close_day)), class: 'btn-ghost btn-sm' %><%= link_to 'Back to financial close', financial_close_path(day: @close_day.iso8601, anchor: 'close-missing-reports'), class: 'btn-ghost btn-sm' %></div>
  <% else %><h2 class="font-display text-xl">Review the latest close checks</h2><p class="text-sm text-mocha">This missing-report scope is no longer available for these dates, or the link is invalid. Check the current day before adding another request.</p><%= link_to 'Review current close checks', financial_close_path(day: @close_day&.iso8601, anchor: 'close-missing-reports'), class: 'btn-primary btn-sm' %><% end %>
</section>
