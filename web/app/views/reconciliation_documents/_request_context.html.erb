<section class="card card-pad space-y-3 <%= item.overdue? ? 'border-amber-300 bg-amber-50' : '' %>" aria-label="Report request being resolved">
  <div class="flex flex-wrap items-start justify-between gap-2"><div><p class="text-xs font-semibold uppercase tracking-wide text-mocha">Finding an original for follow-up #<%= item.id %></p><h2 class="mt-1 font-display text-xl break-words"><%= item.title %></h2></div><p class="text-sm font-semibold"><%= reconciliation_due_label(item) %> · <%= item.due_on.strftime('%b %-d, %Y') %></p></div>
  <p class="text-sm"><%= reconciliation_source(item.source) %> · <%= item.document_kind.humanize %> · <%= item.period_from.strftime('%b %-d, %Y') %> – <%= item.period_to.strftime('%b %-d, %Y') %><%= item.currency.present? ? " · #{item.currency}" : '' %><% if item.document_kind == 'register_control' %> · <%= (item.location_id.present? && Location.find_by(id: item.location_id)&.name) || item.location_id.presence || 'Unassigned records only' %><% end %> · <%= item.owner&.display_name || 'Needs an owner' %></p>
  <p class="text-sm text-mocha"><%= @request_match_count %> matching <%= @request_match_count == 1 ? 'original' : 'originals' %> on this page. <%= item.status == 'closed' ? 'This request is closed; its originals and history remain available.' : item.document_id ? 'An original is already linked; review it before replacing or resolving.' : 'Choose a matching original below, or add the missing report.' %> Review and save a progress note to confirm a link; searching does not change the request.</p>
  <div class="flex flex-wrap gap-2"><%= link_to 'Back to this follow-up', reconciliation_follow_up_path(item, close_day: close_day&.iso8601, anchor: Current.user.can?('reports.write') ? 'record-progress' : nil), class: 'btn-primary btn-sm' %><% if item.document_id %><%= link_to 'Review linked original', document_daily_reconciliation_path(item.document_id), class: 'btn-ghost btn-sm' %><% end %><%= link_to 'Reset to requested scope', reconciliation_documents_path(reconciliation_library_request_context(item, close_day)), class: 'btn-ghost btn-sm' %><% if Current.user.can?('reports.write') && item.status != 'closed' %><%= link_to(item.document_id ? 'Add another original' : 'Add missing original', daily_reconciliations_path(request: item.id, close_day: close_day&.iso8601, anchor: 'upload-document'), class: 'btn-ghost btn-sm') %><% end %><% if close_day %><%= link_to "Back to close · #{close_day.strftime('%b %-d')}", financial_close_path(day: close_day.iso8601, anchor: 'close-follow-ups'), class: 'btn-ghost btn-sm' %><% end %></div>
</section>
