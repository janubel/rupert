<% content_for :title, 'Source documents' %>
<% library_context = @library_context || {}; reset_context = library_context.merge(@close_day && !@report_request ? { from: @close_day.iso8601, to: @close_day.iso8601 } : {}) %>
<div class="mx-auto max-w-7xl space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :money, day: @close_day %>
  <%= render layout: 'finance/page_header', locals: { title: 'Source documents', currency: nil,
        explain: 'Find the original reports, invoices and statements behind the books, including every saved version, across dates.' } do %>
    <%= link_to 'Across days', overview_reconciliation_follow_ups_path, class: 'btn-ghost' %>
    <%= link_to 'Report requests & follow-ups', reconciliation_follow_ups_path, class: 'btn-ghost' %>
    <%= link_to 'Daily reconciliation', daily_reconciliations_path, class: 'btn-ghost' %>
    <% if Current.user.can?('reports.write') %><%= link_to 'Add a document', daily_reconciliations_path(anchor: 'upload-document'), class: 'btn-primary' %><% end %>
  <% end %>
  <% if @report_request %><%= render 'request_context', item: @report_request, close_day: @close_day %><% elsif @missing_control || @control_scope_changed %><%= render 'control_context' %><% elsif @close_day %><div class="rounded-xl border border-fog bg-paper p-4 flex flex-wrap items-center justify-between gap-3"><p class="text-sm">Finding originals for close on <strong><%= @close_day.strftime('%b %-d, %Y') %></strong></p><%= link_to 'Back to day close', financial_close_path(day: @close_day.iso8601, anchor: 'close-missing-reports'), class: 'btn-ghost btn-sm' %></div><% end %>
  <details class="card card-pad"><summary class="cursor-pointer text-sm font-semibold text-olive">Other follow-ups across dates</summary>
  <section class="card card-pad space-y-3" aria-label="Report follow-up actions"><div class="flex flex-wrap justify-between gap-3"><div><h2 class="font-display text-xl">Missing a report or waiting on a reply?</h2><p class="mt-1 text-sm text-mocha"><%= @follow_up_count || ReconciliationFollowUp.active.count %> open or waiting follow-ups across all dates. A retained file can still need linking to its request.</p></div><%= link_to 'See reports to request', overview_reconciliation_follow_ups_path(anchor: 'report-gaps'), class: 'btn-ghost' %></div><div class="flex flex-wrap gap-2"><%= link_to "Overdue follow-ups · #{@overdue_count || 0}", reconciliation_follow_ups_path(status: 'overdue'), class: 'btn-ghost' %><%= link_to "Due today · #{@today_count || 0}", reconciliation_follow_ups_path(status: 'today'), class: 'btn-ghost' %><%= link_to 'Reports without linked originals', reconciliation_follow_ups_path(category: 'missing_report', evidence: 'missing'), class: 'btn-ghost' %><%= link_to 'All follow-ups', reconciliation_follow_ups_path, class: 'btn-ghost' %></div></section>
  </details>
  <% if @library_error %><div role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm"><%= @library_error %></div><% end %>
  <%= form_with url: reconciliation_documents_path, method: :get, class: 'card card-pad space-y-4', html: { role: 'search' } do |f| %>
    <% library_context.each do |key, value| %><%= hidden_field_tag key, value %><% end %>
    <div class="grid gap-4 md:grid-cols-3"><div><%= f.label :q, 'Search documents', class: 'block text-sm font-semibold' %><%= f.search_field :q, value: @library.filters['q'], placeholder: 'Filename, source or #reference', maxlength: 100, class: 'input' %></div><div><%= f.label :source, 'Source', class: 'block text-sm font-semibold' %><%= f.select :source, ReconciliationLibrary::SOURCE_NAMES.map { |key, name| [name, key] }, { include_blank: 'All sources', selected: @library.filters['source'] }, class: 'input' %></div><div><%= f.label :category, 'Document category', class: 'block text-sm font-semibold' %><%= f.select :category, ReconciliationLibrary::CATEGORIES.map { |key, name| [name, key] }, { selected: @library.filters['category'] }, class: 'input' %></div></div>
    <div class="flex flex-wrap items-end gap-3"><div><%= f.label :from, 'From date', class: 'field-label' %><%= f.date_field :from, value: @library.filters['from'], class: 'input' %></div><div><%= f.label :to, 'Through date', class: 'field-label' %><%= f.date_field :to, value: @library.filters['to'], class: 'input' %></div><%= f.submit 'Find documents', class: 'btn-primary' %><%= link_to(@close_day && !@report_request ? 'Reset to close date' : 'Clear filters', reconciliation_documents_path(reset_context), class: 'btn-ghost') %></div>
    <p class="text-xs text-mocha">Dates match covered periods for vault documents and received export dates for native CSVs. An export date does not establish its transaction coverage.</p>
  <% end %>
  <div class="flex flex-wrap items-center justify-between gap-3" role="status"><p class="text-sm"><strong><%= @library.total %></strong> matching <%= @library.total == 1 ? 'file' : 'files' %> · newest retained first<% if params[:cursor].present? %> · older results<% end %></p><%= link_to 'Drive retention status', retention_drive_path, class: 'text-sm text-olive underline' %></div>
  <div class="grid gap-4 md:grid-cols-2">
    <% @entries.each do |entry| %>
      <% if entry.rank.zero? %><%= render 'document', doc: entry.record, successors: @successors, copies: @drive_copies, follow_ups: @document_follow_ups[entry.record.id], report_request: @report_request, close_day: @close_day %>
      <% else %><% receipt = entry.record %><article class="card card-pad min-w-0 space-y-3"><div class="flex flex-wrap justify-between gap-2"><p class="text-xs font-semibold uppercase tracking-wide text-mocha"><%= reconciliation_source(entry.key.split(':').first) %></p><span class="inline-flex rounded-full border border-fog bg-haze px-2.5 py-1 text-xs font-semibold">Native CSV original</span></div><h2 class="font-display text-xl"><%= receipt.kind.humanize %> export #<%= receipt.id %></h2><p class="text-sm">Export received <%= entry.retained_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %></p><p class="text-xs text-mocha">Download the original to confirm covered transaction dates.</p><%= link_to 'Download original CSV', native_document_daily_reconciliations_path(source: entry.key.split(':').first, id: receipt.id), class: 'btn-ghost btn-sm' %><% copy = @drive_copies[entry.key] %><% if copy&.drive_url %><%= link_to 'Verified Drive copy ↗', copy.drive_url, target: '_blank', rel: 'noopener noreferrer', class: 'block text-xs text-olive underline' %><% end %><details class="border-t border-haze pt-3 text-xs"><summary class="cursor-pointer font-semibold">Original checksum</summary><p class="mt-3 break-all font-mono">SHA-256: <%= receipt.sha256 %></p></details></article><% end %>
    <% end %>
  </div>
  <% if @entries.empty? %><section class="card card-pad space-y-3"><h2 class="font-display text-xl">No documents match these filters</h2><p class="text-sm text-mocha">Try a wider date range, another source or fewer search words. Earlier correction versions and report archives are retained.</p><div class="flex flex-wrap gap-2"><%= link_to(@close_day && !@report_request ? 'Show files for close date' : 'Show all retained files', reconciliation_documents_path(reset_context), class: 'btn-ghost') %><% if @report_request %><%= link_to 'Return to this request', reconciliation_follow_up_path(@report_request, close_day: @close_day&.iso8601, anchor: Current.user.can?('reports.write') ? 'record-progress' : nil), class: 'btn-primary' %><% elsif Current.user.can?('reports.write') && !@control_scope_changed %><%= link_to(@missing_control ? 'Track this missing report' : 'Track missing report', new_reconciliation_follow_up_path(@request_context), class: 'btn-primary') %><% end %></div><p class="text-xs text-mocha">If a report is still outstanding, track its owner and next check in Rupert. No email or message is sent.</p></section><% end %>
  <nav class="flex flex-wrap justify-between gap-3" aria-label="Document library pages"><% if params[:cursor].present? %><%= link_to 'Back to newest matches', reconciliation_documents_path(@library.filters.merge(library_context)), class: 'btn-ghost' %><% end %><% if @library.next_cursor %><%= link_to 'Older documents →', reconciliation_documents_path(@library.filters.merge(library_context).merge(cursor: @library.next_cursor)), class: 'btn-primary' %><% end %></nav>
  <p class="text-xs text-mocha">Originals, corrections and review history are retained without automatic deletion. Downloads verify stored checksums. Local originals stay available independently of Drive.</p>
</div>
