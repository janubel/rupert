<% content_for :title, 'Source documents' %>
<% library_context = @library_context || {}; reset_context = library_context.merge(@close_day && !@report_request ? { from: @close_day.iso8601, to: @close_day.iso8601 } : {})
   can_write = Current.user.can?('reports.write')
   menu = [['Open days', overview_reconciliation_follow_ups_path], ['Follow-ups', reconciliation_follow_ups_path], ['Daily reconciliation', daily_reconciliations_path], ['Drive copies', retention_drive_path]] %>
<div class="space-y-6">
  <%= render layout: 'finance/page_header', locals: { title: 'Source documents', currency: nil, menu: menu,
        explain: 'Find the original reports, invoices and statements behind the books, including every saved version, across dates. Originals, corrections and review history are retained without automatic deletion. Downloads verify stored checksums, and local originals stay available independently of Drive.' } do %>
    <% if can_write %><%= link_to 'Add document', daily_reconciliations_path(anchor: 'upload-document'), class: 'btn-primary' %><% end %>
  <% end %>

  <% if @report_request %><%= render 'request_context', item: @report_request, close_day: @close_day %>
  <% elsif @missing_control || @control_scope_changed %><%= render 'control_context' %>
  <% elsif @close_day %><div class="flex flex-wrap items-center justify-between gap-3 rounded-card border border-fog bg-paper p-4"><p class="text-sm">Finding originals for the close on <strong><%= @close_day.strftime('%b %-d, %Y') %></strong></p><%= link_to 'Back to day close', financial_close_path(day: @close_day.iso8601, anchor: 'close-missing-reports'), class: 'btn-ghost btn-sm' %></div><% end %>

  <details class="explainer card card-pad">
    <summary class="explainer-summary font-semibold">Missing a report or waiting on a reply? · <%= @follow_up_count || ReconciliationFollowUp.active.count %> open or waiting follow-ups</summary>
    <section class="mt-3 space-y-3" aria-label="Report follow-up actions">
      <p class="text-sm text-mocha">Counts cover all dates. A retained file can still need linking to its request.</p>
      <div class="flex flex-wrap gap-2"><%= link_to 'Reports to request', overview_reconciliation_follow_ups_path(anchor: 'report-gaps'), class: 'btn-ghost btn-sm' %><%= link_to "Overdue follow-ups · #{@overdue_count || 0}", reconciliation_follow_ups_path(status: 'overdue'), class: 'btn-ghost btn-sm' %><%= link_to "Due today · #{@today_count || 0}", reconciliation_follow_ups_path(status: 'today'), class: 'btn-ghost btn-sm' %><%= link_to 'Reports without linked originals', reconciliation_follow_ups_path(category: 'missing_report', evidence: 'missing'), class: 'btn-ghost btn-sm' %><%= link_to 'All follow-ups', reconciliation_follow_ups_path, class: 'btn-ghost btn-sm' %></div>
    </section>
  </details>

  <% if @library_error %><p role="alert" class="flash flash-alert"><%= @library_error %></p><% end %>

  <%= form_with url: reconciliation_documents_path, method: :get, class: 'toolbar', html: { role: 'search' } do |f| %>
    <% library_context.each do |key, value| %><%= hidden_field_tag key, value %><% end %>
    <div class="toolbar-field"><%= f.label :q, 'Search', class: 'field-label' %><%= f.search_field :q, value: @library.filters['q'], placeholder: 'Filename, source or #reference', maxlength: 100, class: 'input' %></div>
    <div class="toolbar-field"><%= f.label :source, 'Source', class: 'field-label' %><%= f.select :source, ReconciliationLibrary::SOURCE_NAMES.map { |key, name| [name, key] }, { include_blank: 'All sources', selected: @library.filters['source'] }, class: 'select' %></div>
    <div class="toolbar-field"><%= f.label :category, 'Category', class: 'field-label' %><%= f.select :category, ReconciliationLibrary::CATEGORIES.map { |key, name| [name, key] }, { selected: @library.filters['category'] }, class: 'select' %></div>
    <div class="toolbar-field"><%= f.label :from, 'From date', class: 'field-label' %><%= f.date_field :from, value: @library.filters['from'], class: 'input' %></div>
    <div class="toolbar-field"><%= f.label :to, 'Through date', class: 'field-label' %><%= f.date_field :to, value: @library.filters['to'], class: 'input' %></div>
    <div class="toolbar-actions"><%= f.submit 'Apply', class: 'btn-primary' %><%= link_to 'Clear', reconciliation_documents_path(reset_context), class: 'btn-ghost' %></div>
  <% end %>
  <p class="text-xs text-mocha">Dates match covered periods for vault documents and received export dates for native CSVs. An export date does not establish its transaction coverage.</p>
  <p class="text-sm" role="status"><strong><%= @library.total %></strong> matching <%= @library.total == 1 ? 'file' : 'files' %> · newest retained first<% if params[:cursor].present? %> · older results<% end %></p>

  <% if @entries.empty? %>
    <%= empty_state 'No documents match these filters', hint: 'Try a wider date range, another source or fewer search words. Earlier correction versions and report archives are retained. If a report is still outstanding, track its owner and next check in Rupert. No email or message is sent.' do %>
      <%= link_to(@close_day && !@report_request ? 'Show files for close date' : 'Show all retained files', reconciliation_documents_path(reset_context), class: 'btn-ghost') %>
      <% if @report_request %><%= link_to 'Return to this request', reconciliation_follow_up_path(@report_request, close_day: @close_day&.iso8601, anchor: can_write ? 'record-progress' : nil), class: 'btn-primary' %>
      <% elsif can_write && !@control_scope_changed %><%= link_to(@missing_control ? 'Track this missing report' : 'Track missing report', new_reconciliation_follow_up_path(@request_context), class: 'btn-primary') %><% end %>
    <% end %>
  <% else %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @entries.each do |entry| %>
        <% if entry.rank.zero? %><%= render 'document', doc: entry.record, successors: @successors, copies: @drive_copies, follow_ups: @document_follow_ups[entry.record.id], report_request: @report_request, close_day: @close_day %>
        <% else %><% receipt = entry.record %><article class="section-card min-w-0"><div class="card-head"><div><p class="eyebrow text-taupe"><%= reconciliation_source(entry.key.split(':').first) %></p><h3 class="card-title"><%= receipt.kind.humanize %> export #<%= receipt.id %></h3></div><span class="pill-taupe">Native CSV original</span></div><p class="text-sm">Export received <%= entry.retained_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %></p><p class="text-xs text-mocha">Download the original to confirm covered transaction dates.</p><div class="flex flex-wrap gap-2"><%= link_to 'Download original CSV', native_document_daily_reconciliations_path(source: entry.key.split(':').first, id: receipt.id), class: 'btn-ghost btn-sm' %><% copy = @drive_copies[entry.key] %><% if copy&.drive_url %><%= link_to 'Open verified Drive copy', copy.drive_url, target: '_blank', rel: 'noopener noreferrer', class: 'btn-ghost btn-sm' %><% end %></div><details class="explainer border-t border-fog pt-3 text-xs"><summary class="explainer-summary font-semibold">Original checksum</summary><p class="mt-3 break-all font-mono">SHA-256: <%= receipt.sha256 %></p></details></article><% end %>
      <% end %>
    </div>
  <% end %>
  <nav class="flex flex-wrap justify-between gap-3" aria-label="Document library pages"><% if params[:cursor].present? %><%= link_to 'Back to newest matches', reconciliation_documents_path(@library.filters.merge(library_context)), class: 'btn-ghost' %><% end %><% if @library.next_cursor %><%= link_to 'Older documents', reconciliation_documents_path(@library.filters.merge(library_context).merge(cursor: @library.next_cursor)), class: 'btn-ghost' %><% end %></nav>
</div>
