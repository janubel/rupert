<% content_for :title, 'Document retention library' %>
<div class="mx-auto max-w-7xl space-y-6">
  <header class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-widest text-mocha">Money · Retained evidence</p><h1 class="page-title mt-2">Document retention library</h1><p class="mt-2 text-sm text-mocha">Find original reports, invoices and every saved version across dates.</p></div><div class="flex flex-wrap gap-2"><%= link_to 'Daily reconciliation', daily_reconciliations_path, class: 'btn-ghost' %><% if Current.user.can?('reports.write') %><%= link_to 'Add a document', daily_reconciliations_path(anchor: 'upload-document'), class: 'btn-primary' %><% end %></div></header>
  <% if @library_error %><div role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm"><%= @library_error %></div><% end %>
  <%= form_with url: reconciliation_documents_path, method: :get, class: 'card card-pad space-y-4', role: 'search' do |f| %>
    <div class="grid gap-4 md:grid-cols-3"><div><%= f.label :q, 'Search documents', class: 'block text-sm font-semibold' %><%= f.search_field :q, value: @library.filters['q'], placeholder: 'Filename, source or #reference', maxlength: 100, class: 'input' %></div><div><%= f.label :source, 'Source', class: 'block text-sm font-semibold' %><%= f.select :source, ReconciliationLibrary::SOURCE_NAMES.map { |key, name| [name, key] }, { include_blank: 'All sources', selected: @library.filters['source'] }, class: 'input' %></div><div><%= f.label :category, 'Document category', class: 'block text-sm font-semibold' %><%= f.select :category, ReconciliationLibrary::CATEGORIES.map { |key, name| [name, key] }, { selected: @library.filters['category'] }, class: 'input' %></div></div>
    <div class="flex flex-wrap items-end gap-3"><div><%= f.label :from, 'From date', class: 'block text-sm' %><%= f.date_field :from, value: @library.filters['from'], class: 'input' %></div><div><%= f.label :to, 'Through date', class: 'block text-sm' %><%= f.date_field :to, value: @library.filters['to'], class: 'input' %></div><%= f.submit 'Find documents', class: 'btn-primary' %><%= link_to 'Clear filters', reconciliation_documents_path, class: 'btn-ghost' %></div>
    <p class="text-xs text-mocha">Dates match covered periods for vault documents and received export dates for native CSVs. An export date does not establish its transaction coverage.</p>
  <% end %>
  <div class="flex flex-wrap items-center justify-between gap-3" role="status"><p class="text-sm"><strong><%= @library.total %></strong> matching <%= @library.total == 1 ? 'file' : 'files' %> · newest retained first<% if params[:cursor].present? %> · older results<% end %></p><%= link_to 'Drive retention status', retention_drive_path, class: 'text-sm text-olive underline' %></div>
  <div class="grid gap-4 md:grid-cols-2">
    <% @entries.each do |entry| %>
      <% if entry.rank.zero? %><%= render 'document', doc: entry.record, successors: @successors, copies: @drive_copies %>
      <% else %><% receipt = entry.record %><article class="card card-pad min-w-0 space-y-3"><div class="flex flex-wrap justify-between gap-2"><p class="text-xs font-semibold uppercase tracking-wide text-mocha"><%= reconciliation_source(entry.key.split(':').first) %></p><span class="badge">Native CSV original</span></div><h2 class="font-display text-xl"><%= receipt.kind.humanize %> export #<%= receipt.id %></h2><p class="text-sm">Export received <%= entry.retained_at.in_time_zone.strftime('%b %-d, %Y at %-I:%M %p %Z') %></p><p class="text-xs text-mocha">Download the original to confirm covered transaction dates.</p><%= link_to 'Download original CSV', native_document_daily_reconciliations_path(source: entry.key.split(':').first, id: receipt.id), class: 'btn-ghost btn-sm' %><% copy = @drive_copies[entry.key] %><% if copy&.drive_url %><%= link_to 'Verified Drive copy ↗', copy.drive_url, target: '_blank', rel: 'noopener noreferrer', class: 'block text-xs text-olive underline' %><% end %><details class="border-t border-haze pt-3 text-xs"><summary class="cursor-pointer font-semibold">Original checksum</summary><p class="mt-3 break-all font-mono">SHA-256: <%= receipt.sha256 %></p></details></article><% end %>
    <% end %>
  </div>
  <% if @entries.empty? %><section class="card card-pad space-y-3"><h2 class="font-display text-xl">No documents match these filters</h2><p class="text-sm text-mocha">Try a wider date range, another source or fewer search words. Earlier correction versions and report archives are retained.</p><%= link_to 'Show all retained files', reconciliation_documents_path, class: 'btn-ghost' %></section><% end %>
  <nav class="flex flex-wrap justify-between gap-3" aria-label="Document library pages"><% if params[:cursor].present? %><%= link_to 'Back to newest matches', reconciliation_documents_path(@library.filters), class: 'btn-ghost' %><% end %><% if @library.next_cursor %><%= link_to 'Older documents →', reconciliation_documents_path(@library.filters.merge(cursor: @library.next_cursor)), class: 'btn-primary' %><% end %></nav>
  <p class="text-xs text-mocha">Originals, corrections and review history are retained without automatic deletion. Downloads verify stored checksums. Local originals stay available independently of Drive.</p>
</div>
