<% content_for :title, "Receipt ##{@receipt.id}" %>
<div class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-3"><div><%= link_to 'All receipts', receipts_path, class: 'text-sm text-olive underline' %><h1 class="page-title mt-2"><%= @receipt.payee %></h1></div><span class="pill-olive"><%= @receipt.status == 'rejected' ? 'Returned for correction' : @receipt.status.humanize %></span></div>
  <section class="card card-pad space-y-3"><h2 class="font-display text-xl">Purchase details</h2><dl class="grid gap-3 sm:grid-cols-2"><div><dt class="text-sm text-mocha">Amount · USD</dt><dd class="text-xl font-semibold"><%= finance_money(@receipt.amount_cents) %></dd></div><div><dt class="text-sm text-mocha">Purchase date</dt><dd><%= @receipt.incurred_on %></dd></div><div><dt class="text-sm text-mocha">Category</dt><dd><%= @receipt.category.humanize %></dd></div><div><dt class="text-sm text-mocha">Submitted by</dt><dd><%= @receipt.submitted_by.display_name %></dd></div></dl><p class="whitespace-pre-wrap text-sm"><%= @receipt.notes %></p><%= link_to 'Download original receipt', download_receipt_path(@receipt), class: 'btn-ghost', data: { turbo: false } %><p class="text-sm text-mocha">Private <%= @receipt.content_type %> · <%= number_to_human_size(@receipt.byte_size) %>. Check the original before approving.</p></section>
  <% owner = @receipt.submitted_by_id == Current.user.id %>
  <% if owner && @receipt.status == 'draft' %>
    <section class="card card-pad space-y-3"><h2 class="font-display text-xl">Ready for review?</h2><p class="text-sm text-mocha">Check the original, amount and business purpose before submitting. Submitted receipts cannot be edited.</p><div class="flex flex-wrap gap-3"><%= link_to 'Edit details', edit_receipt_path(@receipt), class: 'btn-ghost' %><%= button_to 'Submit for approval', submit_receipt_path(@receipt), params: { lock_version: @receipt.lock_version }, class: 'btn-primary' %></div></section>
  <% elsif owner && @receipt.status == 'rejected' %>
    <section class="card card-pad space-y-3"><h2 class="font-display text-xl">Make the requested corrections</h2><%= button_to 'Reopen draft', reopen_receipt_path(@receipt), params: { lock_version: @receipt.lock_version }, class: 'btn-primary' %><p class="text-sm text-mocha">Your original file and previous review remain in the history.</p></section>
  <% elsif @receipt.status == 'submitted' && Current.user.can_review_receipts? && !owner %>
    <section class="card card-pad space-y-4"><h2 class="font-display text-xl">Review receipt</h2>
      <%= form_tag approve_receipt_path(@receipt), method: :post, class: 'space-y-3' do %><%= hidden_field_tag :lock_version, @receipt.lock_version %><div><%= label_tag :review_note, 'Review note / correction needed', class: 'label' %><%= text_area_tag :review_note, nil, maxlength: 4000, rows: 3, class: 'input' %></div><label class="flex gap-2 text-sm"><%= check_box_tag :confirmed, '1', false, required: true %> I reviewed the original receipt and the purchase details.</label><div class="flex flex-wrap gap-3"><%= submit_tag 'Approve receipt', class: 'btn-primary' %><button type="submit" formaction="<%= reject_receipt_path(@receipt) %>" class="btn-ghost">Return for correction</button></div><% end %>
    </section>
  <% elsif owner && @receipt.status == 'submitted' %><p class="card card-pad text-sm">Awaiting another reviewer. You cannot approve your own receipt.</p><% end %>
  <p class="text-sm text-mocha">Receipt approval does not transfer money or create an expense entry. <%= link_to 'Open expense register', finance_expenses_path, class: 'text-olive underline' if Current.user.can?('finance.read') %></p>
  <section class="card card-pad space-y-4"><h2 class="font-display text-xl">History</h2><ol class="space-y-3"><% @events.each do |event| %><li class="border-b border-fog pb-3 text-sm"><p><strong><%= event.action == 'reject' ? 'Returned for correction' : event.action.humanize %></strong> · <%= event.actor.display_name %> · <%= l(event.created_at, format: :long) %></p><% if event.note.present? %><p class="mt-1 whitespace-pre-wrap"><%= event.note %></p><% end %></li><% end %></ol></section>
</div>
