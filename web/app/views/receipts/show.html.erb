<% content_for :title, "Receipt ##{@receipt.id}" %>
<% owner = @receipt.submitted_by_id == Current.user.id %>
<% menu = [['Download original', download_receipt_path(@receipt), { data: { turbo: false } }]] %>
<% menu.unshift(['Edit', edit_receipt_path(@receipt)]) if owner && @receipt.status == 'draft' %>
<% menu << ['Open expense register', finance_expenses_path] if Current.user.can?('finance.read') %>
<div class="page-medium space-y-6">
  <%= page_header @receipt.payee, subtitle: "Receipt ##{@receipt.id} · #{l(@receipt.incurred_on, format: :long)}", menu: menu do %>
    <% if owner && @receipt.status == 'draft' %>
      <%= button_to 'Submit for approval', submit_receipt_path(@receipt), params: { lock_version: @receipt.lock_version }, class: 'btn-primary' %>
    <% elsif owner && @receipt.status == 'rejected' %>
      <%= button_to 'Reopen draft', reopen_receipt_path(@receipt), params: { lock_version: @receipt.lock_version }, class: 'btn-primary' %>
    <% end %>
  <% end %>
  <dl class="facts">
    <div><dt>Status</dt><dd><span class="<%= receipt_status_pill_class(@receipt.status) %>"><%= receipt_status_label(@receipt.status) %></span></dd></div>
    <div><dt>Amount · USD</dt><dd class="num text-left"><%= finance_money(@receipt.amount_cents) %></dd></div>
    <div><dt>Purchase date</dt><dd><%= l(@receipt.incurred_on, format: :long) %></dd></div>
    <div><dt>Category</dt><dd><%= @receipt.category.humanize %></dd></div>
    <div><dt>Submitted by</dt><dd><%= @receipt.submitted_by.display_name %></dd></div>
    <div><dt>Original file</dt><dd>Private <%= @receipt.content_type %> · <%= number_to_human_size(@receipt.byte_size) %></dd></div>
  </dl>
  <% if @receipt.notes.present? %>
    <section class="section-card">
      <%= section_heading 'Business purpose' %>
      <p class="whitespace-pre-wrap text-sm"><%= @receipt.notes %></p>
    </section>
  <% end %>
  <% if owner && @receipt.status == 'draft' %>
    <p class="text-sm text-mocha">Check the original, amount and business purpose before submitting. Submitted receipts cannot be edited.</p>
  <% elsif owner && @receipt.status == 'rejected' %>
    <p class="text-sm text-mocha">Reopen the draft to make the requested corrections. Your original file and previous review remain in the history.</p>
  <% elsif @receipt.status == 'submitted' && Current.user.can_review_receipts? && !owner %>
    <section class="section-card">
      <%= section_heading 'Review receipt', hint: 'Check the original before approving. Approval records a review; it does not transfer money or create an expense entry.' %>
      <%= form_tag approve_receipt_path(@receipt), method: :post, class: 'space-y-4' do %><%= hidden_field_tag :lock_version, @receipt.lock_version %><div><%= label_tag :review_note, 'Review note / correction needed', class: 'field-label' %><%= text_area_tag :review_note, nil, maxlength: 4000, rows: 3, class: 'input' %></div><label class="flex gap-2 text-sm"><%= check_box_tag :confirmed, '1', false, required: true, class: 'checkbox mt-0.5' %> I reviewed the original receipt and the purchase details.</label><div class="form-actions"><%= submit_tag 'Approve receipt', class: 'btn-primary' %><button type="submit" formaction="<%= reject_receipt_path(@receipt) %>" class="btn-ghost">Return for correction</button></div><% end %>
    </section>
  <% elsif owner && @receipt.status == 'submitted' %><p class="text-sm text-mocha">Awaiting another reviewer. You cannot approve your own receipt.</p><% end %>
  <section class="section-card">
    <%= section_heading 'History' %>
    <ol class="divide-y divide-fog"><% @events.each do |event| %><li class="py-3 text-sm"><p><strong><%= event.action == 'reject' ? 'Returned for correction' : event.action.humanize %></strong> · <%= event.actor.display_name %> · <%= l(event.created_at, format: :long) %></p><% if event.note.present? %><p class="mt-1 whitespace-pre-wrap"><%= event.note %></p><% end %></li><% end %></ol>
  </section>
</div>
