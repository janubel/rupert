<% content_for :title, 'Private instance overview' %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><meta name="referrer" content="no-referrer"><meta name="robots" content="noindex,nofollow,noarchive"><% end %>
<% totals = @overview.fetch(:totals); instance = @overview.fetch(:instance); jobs = @overview.fetch(:jobs) %>
<div class="space-y-6">
  <%= render "commerce" %>
  <section><p class="text-xs font-semibold uppercase tracking-wide text-taupe">Private platform administration</p><h1 class="page-title mt-2">Instance overview</h1><p class="mt-2 max-w-3xl text-sm text-mocha">See new workspace requests, account totals and recorded service activity across this Rupert installation. Only active platform administrators can open this dashboard.</p><p class="mt-2 text-xs text-taupe">Snapshot at <%= @overview.fetch(:generated_at).utc.iso8601 %>. Counts can change while this page is open.</p></section>
  <section class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4" aria-label="Account and setup totals">
    <% [['Workspaces', :workspaces, "#{totals[:active_workspaces]} active · #{totals[:inactive_workspaces]} inactive"], ['Accounts', :accounts, "#{totals[:active_accounts]} active"], ['New accounts · 7 days', :new_accounts, 'Created during the last seven days'], ['New workspaces · 30 days', :new_workspaces, 'Created during the last thirty days'], ['Signup requests awaiting review', :pending_signups, "#{totals[:approved_signups]} approved · #{totals[:rejected_signups]} rejected"], ['Allowed sign-in domains', :allowed_domains, 'Domain entries across all workspaces'], ['Saved provider setups', :provider_setups, 'Setup records; does not establish payment readiness'], ['Active API tokens', :active_api_tokens, "#{totals[:issued_api_tokens]} total issued, including expired or revoked"]].each do |label, key, detail| %>
      <article class="card card-pad" data-metric="<%= key %>"><h2 class="text-sm font-semibold text-mocha"><%= label %></h2><p class="mt-2 font-display text-3xl"><%= number_with_delimiter(totals.fetch(key)) %></p><p class="mt-2 text-xs text-taupe"><%= detail %></p></article>
    <% end %>
  </section>
  <section class="card card-pad space-y-3"><h2 class="font-display text-xl">Account referral attribution</h2><p class="text-sm text-mocha">Up to ten attribution labels by account count. Attribution grants no access to customer records or payments.</p><ul class="space-y-2 text-sm"><% @overview.fetch(:account_referrals).each do |domain, count| %><li><strong><%= domain.presence || 'Not recorded (legacy)' %></strong>: <%= number_with_delimiter(count) %> accounts</li><% end %></ul></section>
  <section class="card card-pad space-y-4" aria-labelledby="signup-requests-heading"><div><h2 id="signup-requests-heading" class="font-display text-xl">Workspace requests awaiting review</h2><p class="mt-2 text-sm text-mocha">Up to 20 pending requests per page, newest submissions first. Review the applicant and domain before approval. Approval creates a separate workspace and its owner account; it does not verify domain ownership or configure payment providers.</p><p class="mt-2 text-sm text-mocha">New requests receive referral attribution <strong><%= @overview.fetch(:referral_domain) %></strong>. This is the owner-requested attribution label, not a verified website or an access grant.</p></div>
    <div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr class="border-b border-sand text-xs text-taupe"><th class="p-3">Applicant</th><th class="p-3">Requested workspace</th><th class="p-3">Referral</th><th class="p-3">Status and review</th></tr></thead><tbody>
      <% @overview.fetch(:signups).each do |signup| %><tr class="border-b border-sand align-top" data-signup-id="<%= signup.id %>"><td class="p-3"><p class="font-semibold"><%= signup.applicant_name %></p><p class="break-all"><%= signup.email %></p><p class="mt-1 text-xs text-taupe"><%= signup.created_at.utc.iso8601 %></p></td><td class="p-3"><p class="font-semibold"><%= signup.workspace_name %></p><p class="break-all"><%= signup.domain %></p><p class="mt-1 text-xs text-taupe">Workspace address: <%= signup.requested_subdomain %></p></td><td class="break-all p-3"><%= signup.referral_domain.presence || 'Not recorded (legacy)' %></td><td class="p-3"><p class="font-semibold"><%= signup.status.humanize %></p><% if signup.reviewed_at %><p class="mt-1 text-xs text-taupe">Reviewed <%= signup.reviewed_at.utc.iso8601 %></p><% end %><% if signup.status == 'pending' %><div class="mt-3 flex flex-wrap gap-2"><%= button_to 'Approve workspace', "/platform/signups/#{signup.id}/approve", method: :post, params: { lock_version: signup.lock_version }, class: 'btn-primary btn-sm', form: { data: { turbo: false } } %><%= button_to 'Reject request', "/platform/signups/#{signup.id}/reject", method: :post, params: { lock_version: signup.lock_version }, class: 'btn-ghost btn-sm', form: { data: { turbo: false } } %></div><% end %></td></tr><% end %>
      <% if @overview.fetch(:signups).empty? %><tr><td colspan="4" class="p-3 text-mocha">No pending requests on this page.</td></tr><% end %>
    </tbody></table></div>
    <div class="flex flex-wrap gap-2"><% if params[:before_signup_id].present? %><%= link_to 'Newest pending requests', platform_path, class: 'btn-ghost btn-sm', data: { turbo: false } %><% end %><% if @overview[:next_signup_cursor] %><%= link_to 'Older pending requests', platform_path(before_signup_id: @overview[:next_signup_cursor]), class: 'btn-ghost btn-sm', data: { turbo: false } %><% end %></div>
  </section>
  <section class="card card-pad space-y-4" aria-labelledby="reviewed-requests-heading"><h2 id="reviewed-requests-heading" class="font-display text-xl">Latest reviewed requests</h2><p class="text-sm text-mocha">Up to 20 completed reviews, most recently reviewed first. Earlier requests remain retained in the database.</p><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr class="border-b border-sand text-xs text-taupe"><th class="p-3">Applicant and domain</th><th class="p-3">Workspace</th><th class="p-3">Status</th><th class="p-3">Reviewed</th></tr></thead><tbody><% @overview.fetch(:reviewed_signups).each do |signup| %><tr class="border-b border-sand" data-signup-id="<%= signup.id %>"><td class="break-all p-3"><%= signup.email %><br><%= signup.domain %></td><td class="p-3"><%= signup.workspace_name %></td><td class="p-3"><%= signup.status.humanize %></td><td class="p-3"><%= signup.reviewed_at&.utc&.iso8601 || 'Not recorded' %></td></tr><% end %><% if @overview.fetch(:reviewed_signups).empty? %><tr><td colspan="4" class="p-3">No reviewed requests yet.</td></tr><% end %></tbody></table></div></section>
  <section class="card card-pad space-y-4" aria-labelledby="workspaces-heading"><div><h2 id="workspaces-heading" class="font-display text-xl">Workspaces</h2><p class="mt-2 text-sm text-mocha">Latest 20 setups. Counts belong to each workspace; existing setups are not assigned a referral retroactively.</p></div><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr class="border-b border-sand text-xs text-taupe"><th class="p-3">Workspace</th><th class="p-3">Status</th><th class="p-3">Accounts</th><th class="p-3">Allowed domains</th><th class="p-3">Provider setups</th><th class="p-3">Referral</th></tr></thead><tbody>
    <% @overview.fetch(:workspaces).each do |row| %><% workspace = row.fetch(:workspace) %><tr class="border-b border-sand align-top" data-workspace-id="<%= workspace.id %>"><td class="p-3"><p class="font-semibold"><%= workspace.name %></p><p class="break-all text-xs text-taupe"><%= workspace.subdomain %> · Created <%= workspace.created_at.utc.iso8601 %></p></td><td class="p-3"><%= workspace.status.humanize %></td><td class="p-3"><%= row.fetch(:accounts) %></td><td class="p-3"><%= row.fetch(:allowed_domains) %></td><td class="p-3"><%= row.fetch(:provider_setups) %></td><td class="break-all p-3"><%= workspace.referral_domain.presence || 'Not recorded (legacy)' %></td></tr><% end %>
  </tbody></table></div><%= link_to 'Manage workspaces', tenants_path, class: 'btn-ghost btn-sm', data: { turbo: false } %></section>
  <section class="grid grid-cols-1 gap-4 lg:grid-cols-2"><article class="card card-pad space-y-3"><h2 class="font-display text-xl">Installation</h2><dl class="space-y-2 text-sm"><div><dt class="font-semibold">Deployment label</dt><dd><%= instance.fetch(:label) %> <span class="text-xs text-taupe">(configured label; host health is not checked)</span></dd></div><div><dt class="font-semibold">Database</dt><dd><%= instance.fetch(:adapter) %><% if instance[:sqlite_version] %> <%= instance[:sqlite_version] %> · Journal mode <%= instance[:journal_mode] %><% end %></dd></div><div><dt class="font-semibold">Schema version</dt><dd><%= instance[:schema_version].presence || 'Not recorded' %></dd></div><% if instance[:main_database_bytes] %><div><dt class="font-semibold">Main database file</dt><dd><%= number_to_human_size(instance[:main_database_bytes]) %> <span class="text-xs text-taupe">(excludes journal and temporary files)</span></dd></div><% end %></dl><p class="text-xs text-taupe">This dashboard does not expose database credentials, host paths or Incus controls.</p></article>
    <article class="card card-pad space-y-3"><h2 class="font-display text-xl">Recorded activity and backups</h2><dl class="space-y-2 text-sm"><div><dt class="font-semibold">Jobs waiting / failed</dt><dd><%= jobs.fetch(:ready) %> waiting · <%= jobs.fetch(:failed) %> failed</dd></div><div><dt class="font-semibold">Recent process heartbeats</dt><dd><%= jobs.fetch(:recent_heartbeats) %> records in the last two minutes <span class="text-xs text-taupe">(not a count of verified live operating-system processes)</span></dd></div><div><dt class="font-semibold">Last recorded successful sync</dt><dd><%= @overview[:last_sync]&.utc&.iso8601 || 'Not recorded' %></dd></div><div><dt class="font-semibold">Last recorded completed backup upload</dt><dd><% if (backup = @overview[:last_backup]) %><%= backup.fetch(:finished_at).utc.iso8601 %><% if backup[:bytes] %> · <%= number_to_human_size(backup[:bytes]) %><% end %><% else %>Not recorded in this dashboard<% end %></dd></div></dl><p class="text-xs text-taupe">A successful backup record is not proof that a restore has been tested. Incus snapshots and separate operator backups are not discovered here. No sync, backup or provider check runs when this page opens.</p><%= link_to 'Backup and restore settings', settings_path, class: 'btn-ghost btn-sm', data: { turbo: false } %></article></section>
</div>
