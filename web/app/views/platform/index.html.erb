<%# Instance overview: an Overview page (docs/ui-standards.md §4) for platform administrators. %>
<% content_for :title, 'Instance overview' %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><meta name="referrer" content="no-referrer"><meta name="robots" content="noindex,nofollow,noarchive"><% end %>
<% totals = @overview.fetch(:totals); instance = @overview.fetch(:instance); jobs = @overview.fetch(:jobs) %>
<div class="space-y-6">
  <div>
    <%= page_header 'Instance overview', subtitle: 'Workspace requests, account totals and recorded service activity across this Rupert installation.',
                    menu: [['Manage workspaces', tenants_path, { data: { turbo: false } }], ['Backup and restore settings', settings_path, { data: { turbo: false } }]] %>
    <p class="mt-2 text-xs text-taupe">Snapshot at <%= @overview.fetch(:generated_at).utc.iso8601 %>. Counts can change while this page is open. Only active platform administrators can open this page.</p>
  </div>

  <section class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4" aria-label="Account and setup totals">
    <% [['Workspaces', :workspaces, "#{totals[:active_workspaces]} active · #{totals[:inactive_workspaces]} inactive"], ['Accounts', :accounts, "#{totals[:active_accounts]} active"], ['New accounts · 7 days', :new_accounts, 'Created during the last seven days'], ['New workspaces · 30 days', :new_workspaces, 'Created during the last thirty days'], ['Signup requests awaiting review', :pending_signups, "#{totals[:approved_signups]} approved · #{totals[:rejected_signups]} rejected"], ['Allowed sign-in domains', :allowed_domains, 'Domain entries across all workspaces'], ['Saved provider setups', :provider_setups, 'Setup records; does not establish payment readiness'], ['Active API tokens', :active_api_tokens, "#{totals[:issued_api_tokens]} total issued, including expired or revoked"]].each do |label, key, detail| %>
      <div class="stat" data-metric="<%= key %>"><p class="stat-label"><%= label %></p><p class="stat-value mt-1"><%= number_with_delimiter(totals.fetch(key)) %></p><p class="mt-1 text-xs text-taupe"><%= detail %></p></div>
    <% end %>
  </section>

  <%= render "commerce" %>

  <section class="section-card">
    <%= section_heading 'Account referral attribution', hint: 'Up to ten attribution labels by account count. Attribution grants no access to customer records or payments.' %>
    <ul class="space-y-2 text-sm"><% @overview.fetch(:account_referrals).each do |domain, count| %><li><strong><%= domain.presence || 'Not recorded (legacy)' %></strong>: <%= number_with_delimiter(count) %> accounts</li><% end %></ul>
    <% if @overview.fetch(:account_referrals).empty? %><p class="text-sm text-taupe">No referral attribution recorded yet.</p><% end %>
  </section>

  <section class="section-card" aria-labelledby="signup-requests-heading">
    <div class="card-head"><div><h2 id="signup-requests-heading" class="section-title">Workspace requests awaiting review</h2><p class="card-hint">Up to 20 pending requests per page, newest first. New requests receive referral attribution <strong><%= @overview.fetch(:referral_domain) %></strong>.</p></div></div>
    <%= fold_explainer('Review the applicant and domain before approval. Approval creates a separate workspace and its owner account; it does not verify domain ownership or configure payment providers. The referral attribution is the owner-requested label, not a verified website or an access grant.', class: 'text-sm text-mocha') %>
    <div class="table-region" role="region" tabindex="0" aria-label="Workspace requests awaiting review">
      <table class="table">
        <thead><tr><th scope="col" class="th">Applicant</th><th scope="col" class="th">Requested workspace</th><th scope="col" class="th">Referral</th><th scope="col" class="th">Status and review</th></tr></thead>
        <tbody>
          <% @overview.fetch(:signups).each do |signup| %>
            <tr class="align-top" data-signup-id="<%= signup.id %>">
              <td class="td"><p class="font-semibold"><%= signup.applicant_name %></p><p class="break-all"><%= signup.email %></p><p class="mt-1 text-xs text-taupe"><%= signup.created_at.utc.iso8601 %></p></td>
              <td class="td"><p class="font-semibold"><%= signup.workspace_name %></p><p class="break-all"><%= signup.domain %></p><p class="mt-1 text-xs text-taupe">Workspace address: <%= signup.requested_subdomain %></p></td>
              <td class="td break-all"><%= signup.referral_domain.presence || 'Not recorded (legacy)' %></td>
              <td class="td">
                <span class="<%= signup.status == 'pending' ? 'pill-clay' : signup.status == 'approved' ? 'pill-fern' : 'pill-taupe' %>"><%= signup.status.humanize %></span>
                <% if signup.reviewed_at %><p class="mt-1 text-xs text-taupe">Reviewed <%= signup.reviewed_at.utc.iso8601 %></p><% end %>
                <% if signup.status == 'pending' %><div class="mt-3 flex flex-wrap gap-2"><%= button_to 'Approve', "/platform/signups/#{signup.id}/approve", method: :post, params: { lock_version: signup.lock_version }, class: 'btn-primary btn-sm', form: { data: { turbo: false } } %><%= button_to 'Reject', "/platform/signups/#{signup.id}/reject", method: :post, params: { lock_version: signup.lock_version }, class: 'btn-ghost btn-sm', form: { data: { turbo: false } } %></div><% end %>
              </td>
            </tr>
          <% end %>
          <% if @overview.fetch(:signups).empty? %><tr><td colspan="4" class="empty-row">No pending requests on this page. New requests appear here as soon as an applicant verifies their email.</td></tr><% end %>
        </tbody>
      </table>
    </div>
    <% if params[:before_signup_id].present? || @overview[:next_signup_cursor] %>
      <div class="flex flex-wrap gap-2"><% if params[:before_signup_id].present? %><%= link_to 'Newest pending requests', platform_path, class: 'btn-ghost btn-sm', data: { turbo: false } %><% end %><% if @overview[:next_signup_cursor] %><%= link_to 'Older pending requests', platform_path(before_signup_id: @overview[:next_signup_cursor]), class: 'btn-ghost btn-sm', data: { turbo: false } %><% end %></div>
    <% end %>
  </section>

  <section class="section-card" aria-labelledby="reviewed-requests-heading">
    <div class="card-head"><div><h2 id="reviewed-requests-heading" class="section-title">Latest reviewed requests</h2><p class="card-hint">Up to 20 completed reviews, most recently reviewed first. Earlier requests stay in the database.</p></div></div>
    <div class="table-region" role="region" tabindex="0" aria-label="Latest reviewed requests">
      <table class="table">
        <thead><tr><th scope="col" class="th">Applicant and domain</th><th scope="col" class="th">Workspace</th><th scope="col" class="th">Status</th><th scope="col" class="th">Reviewed</th></tr></thead>
        <tbody>
          <% @overview.fetch(:reviewed_signups).each do |signup| %><tr data-signup-id="<%= signup.id %>"><td class="td break-all"><%= signup.email %><br><%= signup.domain %></td><td class="td"><%= signup.workspace_name %></td><td class="td"><span class="<%= signup.status == 'approved' ? 'pill-fern' : 'pill-taupe' %>"><%= signup.status.humanize %></span></td><td class="td"><%= signup.reviewed_at&.utc&.iso8601 || 'Not recorded' %></td></tr><% end %>
          <% if @overview.fetch(:reviewed_signups).empty? %><tr><td colspan="4" class="empty-row">No reviewed requests yet. Approve or reject a pending request above.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section-card" aria-labelledby="workspaces-heading">
    <div class="card-head"><div><h2 id="workspaces-heading" class="section-title">Workspaces</h2><p class="card-hint">Latest 20 setups. Counts belong to each workspace; existing setups are not assigned a referral retroactively.</p></div><div class="card-head-actions"><%= link_to 'Manage workspaces', tenants_path, class: 'btn-ghost btn-sm', data: { turbo: false } %></div></div>
    <div class="table-region" role="region" tabindex="0" aria-label="Workspaces">
      <table class="table">
        <thead><tr><th scope="col" class="th">Workspace</th><th scope="col" class="th">Status</th><th scope="col" class="th num">Accounts</th><th scope="col" class="th num">Allowed domains</th><th scope="col" class="th num">Provider setups</th><th scope="col" class="th">Referral</th></tr></thead>
        <tbody>
          <% @overview.fetch(:workspaces).each do |row| %><% workspace = row.fetch(:workspace) %>
            <tr class="align-top" data-workspace-id="<%= workspace.id %>"><td class="td"><p class="font-semibold"><%= workspace.name %></p><p class="break-all text-xs text-taupe"><%= workspace.subdomain %> · Created <%= workspace.created_at.utc.iso8601 %></p></td><td class="td"><span class="<%= workspace.status == 'active' ? 'pill-fern' : 'pill-taupe' %>"><%= workspace.status.humanize %></span></td><td class="td num"><%= row.fetch(:accounts) %></td><td class="td num"><%= row.fetch(:allowed_domains) %></td><td class="td num"><%= row.fetch(:provider_setups) %></td><td class="td break-all"><%= workspace.referral_domain.presence || 'Not recorded (legacy)' %></td></tr>
          <% end %>
          <% if @overview.fetch(:workspaces).empty? %><tr><td colspan="6" class="empty-row">No workspaces yet. Add the first one under Manage workspaces.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <article class="section-card">
      <%= section_heading 'Installation', level: :h3 %>
      <dl class="facts">
        <div><dt>Deployment label</dt><dd><%= instance.fetch(:label) %> <span class="text-xs text-taupe">(configured label; host health is not checked)</span></dd></div>
        <div><dt>Database</dt><dd><%= instance.fetch(:adapter) %><% if instance[:sqlite_version] %> <%= instance[:sqlite_version] %> · Journal mode <%= instance[:journal_mode] %><% end %></dd></div>
        <div><dt>Schema version</dt><dd><%= instance[:schema_version].presence || 'Not recorded' %></dd></div>
        <% if instance[:main_database_bytes] %><div><dt>Main database file</dt><dd><%= number_to_human_size(instance[:main_database_bytes]) %> <span class="text-xs text-taupe">(excludes journal and temporary files)</span></dd></div><% end %>
      </dl>
      <p class="text-xs text-taupe">This page does not expose database credentials, host paths or Incus controls.</p>
    </article>
    <article class="section-card">
      <%= section_heading 'Recorded activity and backups', level: :h3 do %><%= link_to 'Backup and restore settings', settings_path, class: 'btn-ghost btn-sm', data: { turbo: false } %><% end %>
      <dl class="facts">
        <div><dt>Jobs waiting / failed</dt><dd><%= jobs.fetch(:ready) %> waiting · <%= jobs.fetch(:failed) %> failed</dd></div>
        <div><dt>Recent process heartbeats</dt><dd><%= jobs.fetch(:recent_heartbeats) %> records in the last two minutes <span class="text-xs text-taupe">(not a count of verified live operating-system processes)</span></dd></div>
        <div><dt>Last recorded successful sync</dt><dd><%= @overview[:last_sync]&.utc&.iso8601 || 'Not recorded' %></dd></div>
        <div><dt>Last recorded completed backup upload</dt><dd><% if (backup = @overview[:last_backup]) %><%= backup.fetch(:finished_at).utc.iso8601 %><% if backup[:bytes] %> · <%= number_to_human_size(backup[:bytes]) %><% end %><% else %>Not recorded in this dashboard<% end %></dd></div>
      </dl>
      <p class="text-xs text-taupe">A successful backup record is not proof that a restore has been tested. Incus snapshots and separate operator backups are not discovered here. No sync, backup or provider check runs when this page opens.</p>
    </article>
  </section>
</div>
