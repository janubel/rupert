<section class="section-card">
  <%= section_heading 'Subscriptions and customer trust', hint: RupertBilling.configured? ? 'Billing configured · account verification occurs at checkout.' : 'Checkout disabled · CSP configuration needed.' %>
  <div class="grid gap-3 md:grid-cols-3">
    <div class="stat"><p class="stat-label">Standard</p><p class="stat-value-sm mt-1">$499 / month</p></div>
    <div class="stat"><p class="stat-label">Customer referral · 12-month commitment</p><p class="stat-value-sm mt-1">$249.50 / month</p><p class="mt-1 text-xs text-taupe">12 months, then $499/month</p></div>
    <div class="stat"><p class="stat-label">Account access</p><p class="stat-value-sm mt-1">Free</p><p class="mt-1 text-xs text-taupe">Google verification before provisioning</p></div>
  </div>
  <p class="text-sm"><% @billing_totals.each do |status, count| %><span class="mr-4"><%= status.humanize %>: <strong><%= count %></strong></span><% end %></p>
  <%= form_with url: platform_path, method: :get, class: 'toolbar', aria: { label: 'Filter subscriptions' } do |f| %>
    <div class="toolbar-field"><%= f.label :customer, 'Workspace', class: 'field-label' %><%= f.search_field :customer, value: params[:customer], maxlength: 100, class: 'input' %></div>
    <div class="toolbar-field"><%= f.label :billing_status, 'Subscription status', class: 'field-label' %><%= f.select :billing_status, %w[free active past_due unpaid incomplete canceled trialing paused incomplete_expired], { include_blank: 'All statuses', selected: params[:billing_status] }, class: 'input' %></div>
    <div class="toolbar-actions"><%= f.submit 'Apply', class: 'btn-primary', name: nil %><%= link_to 'Clear', platform_path, class: 'btn-ghost', data: { turbo: false } %></div>
  <% end %>
  <div class="table-region" role="region" tabindex="0" aria-label="Customer subscriptions">
    <table class="table">
      <thead><tr><th scope="col" class="th">Workspace</th><th scope="col" class="th">Plan / status</th><th scope="col" class="th">Referral</th><th scope="col" class="th">Commitment / confirmation</th></tr></thead>
      <tbody>
        <% @subscriptions.each do |row| %><tr><td class="td"><%= row.tenant.name %></td><td class="td"><%= row.plan.humanize %> · <%= row.status %></td><td class="td"><%= row.referral_code || '—' %></td><td class="td"><%= row.commitment_ends_at&.to_date || 'No annual term recorded' %><br><span class="text-xs text-taupe"><%= row.last_synced_at&.utc&.iso8601 || 'No Stripe confirmation' %></span></td></tr><% end %>
        <% if @subscriptions.empty? %><tr><td colspan="4" class="empty-row">No matching subscription records. Clear the filter to see every workspace.</td></tr><% end %>
      </tbody>
    </table>
  </div>
  <%= fold_explainer('Latest 50 matching customer subscription records. These are provider-confirmed subscription states, not collected-revenue totals. Customer records require a current customer-issued support grant. Server-held encryption does not prevent infrastructure-operator access.', class: 'text-xs text-taupe') %>
</section>

<section class="section-card">
  <%= section_heading 'Operator sign-in readiness', hint: 'Privileges come from an existing active platform account and verified Google identity links. An email address alone never grants administrator access.' %>
  <% if PlatformOwnerIdentities.emails.empty? %><p class="text-sm text-taupe">Owner sign-in identities are not configured in this deployment.</p><% end %>
  <ul class="space-y-1 text-sm">
    <% PlatformOwnerIdentities.emails.each do |email| %><% identity = @operator_identities.find { |item| item.email == email } %><% ready = identity&.user&.super_admin? && identity.user.active? %>
      <li><%= email %> · <span class="<%= ready ? 'pill-fern' : 'pill-clay' %>"><%= ready ? (identity.google_subject.present? ? 'Linked and identity pinned' : 'Linked; first verified sign-in pending') : 'Operator setup required' %></span></li>
    <% end %>
  </ul>
</section>

<section class="section-card">
  <%= section_heading 'Support access audit' %>
  <% if @support_events.empty? %><p class="text-sm text-taupe">No support access events recorded.</p><% else %>
    <ul class="space-y-1 text-sm"><% @support_events.each do |event| %><li><%= event.created_at.utc.iso8601 %> · <%= event.actor.email %> · <%= event.action %> · <%= event.resource %></li><% end %></ul>
  <% end %>
</section>

<section class="section-card">
  <%= section_heading 'Customer-authorized support sessions', hint: 'These customers have granted you temporary read access. Enter on this origin without sharing customer passwords.' %>
  <% @support_grants.each do |grant| %>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-fog py-3"><p class="text-sm"><strong><%= grant.tenant.name %></strong> · Expires <%= grant.expires_at.utc.iso8601 %></p><%= button_to 'Open read-only support', enter_platform_support_path(grant.tenant_id), class: 'btn-primary btn-sm' %></div>
  <% end %>
  <% if @support_grants.empty? %><p class="text-sm text-taupe">No active grants assigned to your account.</p><% end %>
</section>

<section class="section-card">
  <%= section_heading 'Isolated customer instances · SER8', hint: "#{WorkspaceNode.provisioning? ? 'Isolated provisioning enabled' : 'Isolated provisioning disabled pending host setup'}. A workspace opens only after the host worker confirms its database, application health and HTTPS route." %>
  <div class="table-region" role="region" tabindex="0" aria-label="Isolated customer instances">
    <table class="table">
      <thead><tr><th scope="col" class="th">Workspace</th><th scope="col" class="th">State</th><th scope="col" class="th">Host</th><th scope="col" class="th">Setup result</th></tr></thead>
      <tbody>
        <% @deployments.each do |deployment| %>
          <tr><td class="td"><%= deployment.tenant.name %></td><td class="td"><%= deployment.status %> · <%= deployment.phase %></td><td class="td"><%= deployment.hostname %></td><td class="td"><%= deployment.failure_code || deployment.ready_at&.utc&.iso8601 || 'Awaiting host readiness checks' %><% if deployment.status == 'failed' || (deployment.status == 'provisioning' && deployment.lease_expires_at && deployment.lease_expires_at < Time.current) %><div class="mt-2"><%= button_to 'Retry isolated setup', retry_platform_deployment_path(deployment), class: 'btn-ghost btn-sm' %></div><% end %></td></tr>
        <% end %>
        <% if @deployments.empty? %><tr><td colspan="4" class="empty-row">No isolated instances yet. One appears here when a workspace is provisioned on SER8.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</section>
