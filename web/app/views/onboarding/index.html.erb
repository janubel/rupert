<%# First run: a Form page (docs/ui-standards.md §4). Learning first, then the connection details for administrators. %>
<% content_for :title, @can_connect ? 'Get your workspace ready' : 'Welcome to Rupert' %>
<div class="page-narrow space-y-6">
  <%= page_header @can_connect ? 'Get your workspace ready' : 'Start with your everyday work', eyebrow: 'Welcome to Rupert',
                  subtitle: @can_connect ? 'Save connection details, verify a source read and check a familiar day.' : 'An administrator is finishing source connections; you can learn your daily tasks now.' do %>
    <%= link_to 'Choose my getting-started path', learning_index_path, class: 'btn-primary' %>
  <% end %>
  <% if @can_connect %>
    <p class="text-sm text-mocha">Values are stored encrypted. Saving does not start a sync, test credentials or charge a payment. Your team can start learning while you finish setup.</p>
  <% else %>
    <p class="text-sm text-mocha">You can use the tools your account can access now.</p>
  <% end %>

  <aside class="section-card" aria-label="Getting started">
    <%= section_heading 'Make Rupert feel familiar', hint: 'Choose the work you do and follow a short path with examples.' do %>
      <%= link_to 'My time & receipts', employee_app_path, class: 'btn-ghost btn-sm' %>
    <% end %>
  </aside>

  <% if @can_connect %>
    <section class="section-card" aria-label="Workspace setup steps">
      <%= section_heading 'Your setup checklist' do %>
        <%= link_to 'Walk through setup · 3 min', learning_path('setup'), class: 'btn-ghost btn-sm' if Current.user.can?('settings.read') %>
      <% end %>
      <ol class="list-decimal space-y-2 pl-5 text-sm text-mocha"><li><strong>Save details.</strong> Add Shopify below; Square is optional.</li><li><strong>Verify a source read.</strong> Open Credentials & sync and run the relevant read when ready.</li><li><strong>Check your first day.</strong> Find a familiar sale or stock observation and compare it with the source.</li></ol>
    </section>

    <%= form_with url: onboarding_connect_path, method: :post, class: "card card-pad space-y-5" do %>
      <% shopify_saved = @required["SHOPIFY_CLIENT_ID"] && @required["SHOPIFY_CLIENT_SECRET"] %>
      <fieldset class="space-y-3">
        <legend class="card-title">Shopify</legend>
        <div class="flex flex-wrap items-center gap-2">
          <span class="<%= shopify_saved ? "pill-fern" : "pill-clay" %>"><%= shopify_saved ? "Details saved" : "Needed" %></span>
          <p class="text-xs text-taupe">Store admin → Settings → Apps and sales channels → your app. Required to run syncs.</p>
        </div>
        <% shop_domain = EnvStore.fetch("SHOPIFY_SHOP_DOMAIN", "") %>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label class="field-label" for="shopify_client_id">Client ID</label>
            <input type="text" id="shopify_client_id" name="shopify_client_id" autocomplete="off" class="input font-mono text-sm"
                   placeholder="<%= @required["SHOPIFY_CLIENT_ID"] ? "Saved — enter a new value to replace" : "e.g. 4a2b9c…" %>">
          </div>
          <div>
            <label class="field-label" for="shopify_client_secret">Client secret</label>
            <input type="password" id="shopify_client_secret" name="shopify_client_secret" autocomplete="new-password" class="input font-mono text-sm"
                   placeholder="<%= @required["SHOPIFY_CLIENT_SECRET"] ? "Saved — enter a new value to replace" : "" %>">
          </div>
        </div>
        <div>
          <label class="field-label" for="shopify_shop_domain">Shop domain <span class="font-normal text-taupe">(optional)</span></label>
          <input type="text" id="shopify_shop_domain" name="shopify_shop_domain" autocomplete="off" class="input font-mono text-sm"
                 placeholder="your-store.myshopify.com" value="<%= shop_domain %>">
        </div>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="card-title">Square</legend>
        <div class="flex flex-wrap items-center gap-2">
          <span class="<%= @optional["SQUARE_ACCESS_TOKEN"] ? "pill-fern" : "pill-taupe" %>"><%= @optional["SQUARE_ACCESS_TOKEN"] ? "Details saved" : "Optional" %></span>
          <p class="text-xs text-taupe">Optional: enables Square POS catalog and order sync. Developer Dashboard → your app → Authorization.</p>
        </div>
        <div>
          <label class="field-label" for="square_access_token">Access token</label>
          <input type="password" id="square_access_token" name="square_access_token" autocomplete="new-password" class="input font-mono text-sm"
                 placeholder="<%= @optional["SQUARE_ACCESS_TOKEN"] ? "Saved — enter a new value to replace" : "e.g. EAAA…" %>">
        </div>
      </fieldset>

      <div class="form-actions">
        <button type="submit" class="btn-primary" data-turbo-submits-with="Saving…">Save connection details</button>
        <%= link_to "Paste a full .env file instead", settings_path, class: "btn-ghost" %>
      </div>
    <% end %>
  <% end %>
</div>
