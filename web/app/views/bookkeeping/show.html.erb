<% overview = @overview; currency = overview.currency; balance = overview.statement_balance
   bank_money = ->(cents) { currency ? operations_money(cents, currency: currency) : 'Currency unverified' }
   expense_categories = overview.expense_categories
   month_label = overview.month.strftime('%B %Y'); month_param = overview.month.strftime('%Y-%m')
   menu = []
   menu << ['Add expense', new_finance_expense_path] if Current.user.can?('finance.write')
   menu << ['General ledger', finance_journal_entries_path(from: overview.from, to: overview.to)]
   menu << ['Chart of accounts', finance_chart_of_accounts_path]
   menu << ['Open follow-ups', reconciliation_follow_ups_path] if Current.user.can?('reports.read') %>
<div class="space-y-6">
  <%= page_header 'Bookkeeping', subtitle: 'Know what moved, what is recorded, and what still needs a decision.', menu: menu do %>
    <% if Current.user.can?('finance.write') %><%= link_to 'Import bank statement', bank_statements_path, class: 'btn-primary' %><% end %>
  <% end %>

  <%= form_with url: bookkeeping_path, method: :get, class: 'toolbar', data: { turbo: false } do |f| %>
    <div class="toolbar-field"><%= f.label :month, 'Month', class: 'field-label' %><%= f.month_field :month, value: month_param, min: '2000-01', max: '2099-12', class: 'input', required: true %></div>
    <% if overview.accounts.any? %><div class="toolbar-field"><%= f.label :account, 'Bank account', class: 'field-label' %><%= f.select :account, overview.accounts, { selected: overview.account }, class: 'select' %></div><% end %>
    <div class="toolbar-actions"><%= f.submit 'Apply', class: 'btn-primary' %><%= link_to 'Clear', bookkeeping_path, class: 'btn-ghost' %></div>
  <% end %>
  <p class="text-xs text-mocha"><%= month_label %> · bank figures cover the selected account; expenses cover this workspace.</p>

  <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Financial summary for selected month">
    <div class="stat">
      <div class="stat-label">Statement balance<%= define('statement_balance') %></div>
      <p class="stat-value mt-1"><%= balance ? operations_money(balance[:cents], currency: balance[:currency]) : 'Unavailable' %></p>
      <p class="mt-1 text-xs text-taupe"><%= balance ? "As of #{balance[:date].strftime('%b %-d, %Y')} · retained statement" : 'Upload a statement with a verified closing balance.' %></p>
    </div>
    <div class="stat"><div class="stat-label">Money in<%= define('deposit') %></div><p class="stat-value mt-1"><%= overview.line_count.positive? ? bank_money.call(overview.credits_cents) : 'No activity' %></p><p class="mt-1 text-xs text-taupe">All statement credits, including transfers.</p></div>
    <div class="stat"><div class="stat-label">Money out<%= define('expense') %></div><p class="stat-value mt-1"><%= overview.line_count.positive? ? bank_money.call(overview.debits_cents) : 'No activity' %></p><p class="mt-1 text-xs text-taupe">All statement debits, including transfers.</p></div>
    <div class="stat"><div class="stat-label">Net cash movement<%= define('net_cash_movement') %></div><p class="stat-value mt-1"><%= overview.line_count.positive? ? bank_money.call(overview.net_cents) : 'No activity' %></p><p class="mt-1 text-xs text-taupe">Money in less money out for this month.</p>
      <% if overview.line_count.positive? %>
        <% money_in = overview.credits_cents; money_out = overview.debits_cents %>
        <%= explain_calculation(title: "Net cash movement · #{month_label}", id: 'bookkeeping-net-cash',
              formula: 'Statement credits (money in) − statement debits (money out) for the selected account and month, including transfers.',
              rows: [["Statement lines · #{overview.account.presence || 'selected account'}", overview.line_count], ['Money in', bank_money.call(money_in)], ['Money out', "− #{bank_money.call(money_out)}"],
                     ['Net cash movement', bank_money.call(money_in - money_out)]],
              note: 'Bank movement is not profit: transfers between your own accounts count on both sides, and lines still waiting for a decision are included. Rupert has no live bank connection.',
              term: 'net_cash_movement', lesson: 'books') %>
      <% end %>
    </div>
  </section>

  <section class="section-card" aria-labelledby="bookkeeping-review-heading">
    <div class="card-head">
      <div>
        <p class="eyebrow text-olive">Do this next</p>
        <h2 id="bookkeeping-review-heading" class="section-title mt-1"><%= overview.line_count.zero? ? 'Import a statement to start reviewing' : (overview.pending_count.positive? ? "Review #{pluralize(overview.pending_count, 'bank transaction')}" : 'Transaction review is up to date') %></h2>
        <p class="card-hint"><%= overview.decided_count %> of <%= overview.line_count %> decided · <%= overview.flagged_count %> flagged for clarification</p>
      </div>
      <div class="card-head-actions"><%= link_to 'Review transactions', bank_statements_path, class: 'btn-primary' %></div>
    </div>
    <%# The bar width is data, so it stays an inline width until the meter gets its own component. %>
    <div class="desk-meter max-w-md" role="progressbar" aria-label="Bank transactions decided" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= overview.progress %>"><span style="width:<%= overview.progress %>%"></span></div>
  </section>

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="section-card" aria-labelledby="bookkeeping-expenses">
      <div class="card-head">
        <div><h2 id="bookkeeping-expenses" class="section-title">Recorded expenses<%= define('expense') %></h2><p class="card-hint">Only confirmed expenses entered in Rupert. Pending lines and excluded transfers are separate.</p></div>
        <div class="card-head-actions"><%= link_to 'Open expenses', finance_expenses_path(month: month_param), class: 'btn-ghost btn-sm' %></div>
      </div>
      <p class="stat-value-sm num text-left"><%= operations_money(overview.expense_cents) %></p>
      <% if expense_categories.any? %>
        <ul class="space-y-3">
          <% expense_categories.each do |category, amount| %>
            <li>
              <div class="flex justify-between gap-4 text-sm num"><span class="text-left"><%= category.humanize %></span><strong><%= operations_money(amount) %></strong></div>
              <div class="desk-meter mt-1" aria-hidden="true"><span style="width:<%= amount * 100 / [overview.expense_cents, 1].max %>%"></span></div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= empty_state 'No expenses recorded for this month', hint: 'Start with the bank transactions or add an expense.' do %>
          <% if Current.user.can?('finance.write') %><%= link_to 'Add expense', new_finance_expense_path, class: 'btn-ghost' %><% end %>
        <% end %>
      <% end %>
      <div class="flex flex-wrap justify-between gap-2 border-t border-fog pt-3 text-sm num"><span class="text-left">Vendor payments, tracked separately<%= define('vendor_payment') %></span><strong><%= operations_money(overview.vendor_payment_cents) %></strong></div>
    </section>

    <section class="section-card" aria-labelledby="bookkeeping-questions">
      <div class="card-head">
        <div><h2 id="bookkeeping-questions" class="section-title">Needs your attention</h2><p class="card-hint">Bank lines flagged for clarification or still waiting for a category.</p></div>
        <div class="card-head-actions"><span class="<%= overview.pending_count.positive? ? 'pill-clay' : 'pill-fern' %>"><%= overview.pending_count %> waiting</span></div>
      </div>
      <% if overview.questions.any? %>
        <ul class="divide-y divide-fog">
          <% overview.questions.each do |line| %>
            <li>
              <%= link_to bank_statement_path(line.document_id, anchor: "bank-line-#{line.id}"), class: 'block space-y-1 py-3 hover:bg-haze' do %>
                <span class="flex flex-wrap justify-between gap-2 text-sm"><strong><%= line.review_category_label %></strong><strong class="num"><%= line.money_out? ? '−' : '+' %><%= currency ? operations_money(line.amount_cents.abs, currency: currency) : number_with_precision(line.amount_cents.abs / 100.0, precision: 2, delimiter: ',') %></strong></span>
                <span class="block text-sm text-ink"><%= line.description.truncate(85) %></span>
                <span class="block text-xs text-mocha"><%= line.review_note.presence || 'Choose a category or confirm why this line is excluded.' %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= empty_state 'No bank transactions waiting', hint: 'Daily reconciliation and period close have their own checks.' %>
      <% end %>
      <% if Current.user.can?('reports.read') %><p class="text-sm"><%= link_to "#{pluralize(overview.open_follow_ups.count, 'open follow-up')} for this month", reconciliation_follow_ups_path, class: 'font-semibold text-olive-deep hover:underline' %></p><% end %>
    </section>
  </div>

  <section class="section-card" aria-labelledby="bookkeeping-activity">
    <div class="card-head">
      <div><h2 id="bookkeeping-activity" class="section-title">Recent bank transactions</h2><p class="card-hint"><%= overview.account.presence || 'No bank account imported' %> · category, review status and the original line together.</p></div>
      <div class="card-head-actions"><%= link_to 'Open bank transactions', bank_statements_path, class: 'btn-ghost btn-sm' %></div>
    </div>
    <div class="table-region" role="region" tabindex="0" aria-label="Recent bank transactions">
      <table class="table">
        <thead><tr><th scope="col" class="th">Date</th><th scope="col" class="th">Transaction</th><th scope="col" class="th">Category</th><th scope="col" class="th">Status</th><th scope="col" class="th num">Amount<%= " (#{currency})" if currency %></th></tr></thead>
        <tbody>
          <% overview.recent_lines.each do |line| %>
            <tr>
              <td class="td whitespace-nowrap"><%= line.posted_on.strftime('%b %-d') %></td>
              <td class="td"><%= link_to line.description.truncate(100), bank_statement_path(line.document_id, show: 'all', anchor: "bank-line-#{line.id}"), class: 'font-semibold text-olive-deep hover:underline' %></td>
              <td class="td"><%= line.review_category_label %></td>
              <td class="td"><span class="<%= line.pending? ? (line.review_flag? ? 'pill-clay' : 'pill-taupe') : (line.status == 'ignored' ? 'pill-taupe' : 'pill-fern') %>"><%= line.pending? ? (line.review_flag? ? 'Flagged' : 'To review') : (line.status == 'ignored' ? 'Excluded' : line.status.humanize) %></span></td>
              <td class="td num whitespace-nowrap <%= 'text-rose' if line.money_out? %>"><%= line.money_out? ? '−' : '+' %><%= number_with_precision(line.amount_cents.abs / 100.0, precision: 2, delimiter: ',') %></td>
            </tr>
          <% end %>
          <% if overview.line_count.zero? %><tr><td colspan="5" class="empty-row">No bank transactions for this account and month. Import a statement or choose another month.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="space-y-3" aria-labelledby="bookkeeping-statements">
    <%= section_heading 'Financial statements', hint: 'Posted entries for this period. Pending bank lines and other unposted records are not included.' %>
    <div class="grid gap-3 md:grid-cols-3">
      <%= link_to finance_reports_income_statement_path(from: overview.from, to: overview.to), class: 'section-card operations-task' do %><p class="eyebrow text-taupe">Performance</p><h3 class="card-title mt-1">Income statement</h3><p class="text-sm text-mocha">Revenue and expenses from the posted ledger.</p><% end %>
      <%= link_to finance_reports_balance_sheet_path(from: overview.from, to: overview.to), class: 'section-card operations-task' do %><p class="eyebrow text-taupe">Position</p><h3 class="card-title mt-1">Balance sheet</h3><p class="text-sm text-mocha">Posted assets, liabilities and equity through month end.</p><% end %>
      <%= link_to finance_reports_trial_balance_path(from: overview.from, to: overview.to), class: 'section-card operations-task' do %><p class="eyebrow text-taupe">Control</p><h3 class="card-title mt-1">Trial balance</h3><p class="text-sm text-mocha">Account debits and credits for the selected period.</p><% end %>
    </div>
  </section>

  <%= fold_explainer('Bank movement, recorded expenses and vendor payments answer different questions. This overview does not certify reconciliation or calculate profit. The default month is the latest imported activity for the selected bank account.', class: 'text-xs text-mocha') %>
</div>
