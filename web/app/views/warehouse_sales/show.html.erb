<% content_for :title, @share.name %>
<div class="space-y-8">
  <%= page_header @share.name, subtitle: "Vendor pricing applies: list price × #{number_with_precision(@share.priceMultiplier, precision: 2)}, with extra discounts on bulk quantities.", eyebrow: 'Warehouse sale' do %>
    <%= link_to "Open cart (#{@cart.item_count})", warehouse_cart_path(@share.token), class: 'btn-primary btn-lg' %>
  <% end %>

  <section class="section-card" aria-label="Bulk discounts">
    <%= section_heading 'Bulk discounts' %>
    <div class="flex flex-wrap gap-2">
      <% @share.effective_tiers.each do |tier| %>
        <span class="pill-olive"><%= tier.label %></span>
      <% end %>
      <% if @share.effective_tiers.empty? %>
        <span class="text-sm text-taupe">No bulk tiers set; flat vendor pricing applies.</span>
      <% end %>
    </div>
  </section>

  <% if @variants.empty? %>
    <div class="card"><%= empty_state 'No products listed in this warehouse sale yet', hint: 'Check back later or contact the store.' %></div>
  <% end %>

  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Products">
    <% @variants.each do |variant| %>
      <% product = variant.product %>
      <% qty = @stock_by_variant.fetch(variant.id, 0) %>
      <% list = variant.price %>
      <article class="card card-pad flex flex-col" aria-label="<%= variant.title %>">
        <div class="flex items-start gap-3">
          <% if (thumb = product.thumbnail_url(width: 160, height: 160)) %>
            <%= image_tag thumb, alt: product.title, loading: 'lazy', class: 'h-16 w-16 shrink-0 rounded-control border border-fog bg-haze object-cover' %>
          <% else %>
            <span class="grid h-16 w-16 shrink-0 place-items-center rounded-control border border-fog bg-haze font-display text-lg text-taupe"><%= product.title.first.upcase %></span>
          <% end %>
          <div class="min-w-0">
            <h3 class="card-title truncate"><%= variant.title %></h3>
            <p class="truncate text-xs text-taupe"><%= product.title %></p>
          </div>
        </div>

        <div class="mt-4 flex-1 border-t border-fog pt-3">
          <div class="flex items-end justify-between">
            <div>
              <p class="text-xs text-taupe">List price</p>
              <p class="num text-sm text-taupe"><%= list.present? ? number_to_currency(list) : '—' %></p>
            </div>
            <div class="text-right">
              <p class="text-xs text-taupe">Your price · each</p>
              <p class="num text-lg font-semibold text-olive"><%= list.present? ? number_to_currency(@share.sale_price(list, 1)) : '—' %></p>
              <% if list.present? && @share.priceMultiplier.to_f < 1 %>
                <p class="text-xs text-fern"><%= number_to_percentage((1 - @share.unit_price(list) / list.to_f) * 100, precision: 1) %> off list</p>
              <% end %>
            </div>
          </div>

          <% tiers = @share.effective_tiers.to_a %>
          <% if tiers.any? %>
            <div class="mt-3 space-y-1">
              <p class="eyebrow text-taupe">Bulk pricing</p>
              <% tiers.each do |tier| %>
                <div class="flex items-center justify-between text-xs">
                  <span class="text-mocha"><%= tier.minQty %>+ units</span>
                  <span class="num font-medium text-ink"><%= list.present? ? number_to_currency(@share.sale_price(list, tier.minQty)) : '—' %> each <span class="text-taupe">· <%= tier.discountPercent.to_i %>% off</span></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="mt-4 flex items-center justify-between border-t border-fog pt-3">
          <p class="text-xs text-taupe">available</p>
          <p class="num text-sm font-medium <%= qty.positive? ? 'text-ink' : 'text-rose' %>"><%= qty %></p>
        </div>

        <% if list.present? && qty.positive? %>
          <%= form_tag warehouse_cart_add_item_path(@share.token), method: :post, class: 'mt-3 flex items-center gap-2 border-t border-fog pt-3' do %>
            <%= hidden_field_tag 'variant_id', variant.id, id: "variant_id_#{variant.id}" %>
            <%= number_field_tag 'quantity', 1, id: "quantity_#{variant.id}", min: 1, max: [qty, WarehouseCartItem::MAX_QUANTITY].min, class: 'input w-20', aria: { label: "Quantity of #{variant.title}" } %>
            <%= submit_tag 'Add to cart', class: 'btn-primary btn-sm flex-1' %>
          <% end %>
        <% end %>
      </article>
    <% end %>
  </section>
</div>
