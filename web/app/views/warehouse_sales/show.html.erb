<% content_for :title, @share.name %>
<section class="space-y-8">
  <header class="border-b border-fog pb-6">
    <p class="eyebrow text-olive">Warehouse sale</p>
    <h1 class="mt-2 font-display text-4xl text-ink md:text-5xl"><%= @share.name %></h1>
    <p class="mt-3 max-w-xl text-mocha">
      Vendor pricing applies — list price × <%= number_with_precision(@share.priceMultiplier, precision: 2) %>,
      with extra discounts on bulk quantities.
    </p>
    <div class="mt-4">
      <%= link_to warehouse_cart_path(@share.token), class: "btn-primary" do %>
        View cart (<%= @cart.item_count %>)
      <% end %>
    </div>
  </header>

  <section class="card card-pad">
    <h2 class="font-display text-xl text-ink">Bulk discounts</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      <% @share.effective_tiers.each do |tier| %>
        <span class="pill-olive"><%= tier.label %></span>
      <% end %>
      <% if @share.effective_tiers.empty? %>
        <span class="text-sm text-taupe">No bulk tiers set — flat vendor pricing applies.</span>
      <% end %>
    </div>
  </section>

  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @variants.each do |variant| %>
        <% product = variant.product %>
        <% qty = @stock_by_variant.fetch(variant.id, 0) %>
        <% list = variant.price %>
        <article class="card card-pad flex flex-col">
          <div class="flex items-start gap-3">
            <% if (thumb = product.thumbnail_url(width: 160, height: 160)) %>
              <%= image_tag thumb, alt: product.title, loading: "lazy", class: "h-16 w-16 shrink-0 rounded-xl border border-fog bg-haze object-cover" %>
            <% else %>
              <span class="grid h-16 w-16 shrink-0 place-items-center rounded-xl border border-fog bg-haze font-display text-lg text-taupe"><%= product.title.first.upcase %></span>
            <% end %>
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold text-ink"><%= variant.title %></p>
              <p class="truncate text-xs text-taupe"><%= product.title %></p>
            </div>
          </div>

          <div class="mt-4 flex-1 border-t border-fog pt-3">
            <div class="flex items-end justify-between">
              <div>
                <p class="text-xs text-taupe">list price</p>
                <p class="text-sm text-taupe"><%= list.present? ? number_to_currency(list) : "—" %></p>
              </div>
              <div class="text-right">
                <p class="text-xs text-taupe">your price · each</p>
                <p class="text-lg font-semibold text-olive">
                  <%= list.present? ? number_to_currency(@share.sale_price(list, 1)) : "—" %>
                </p>
                <% if list.present? && @share.priceMultiplier.to_f < 1 %>
                  <p class="text-xs text-fern"><%= number_to_percentage((1 - @share.unit_price(list) / list.to_f) * 100, precision: 1) %> off list</p>
                <% end %>
              </div>
            </div>

            <% tiers = @share.effective_tiers.to_a %>
            <% if tiers.any? %>
              <div class="mt-3 space-y-1">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-taupe">Bulk pricing</p>
                <% tiers.each do |tier| %>
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-mocha"><%= tier.minQty %>+ units</span>
                    <span class="font-medium text-ink">
                      <%= list.present? ? number_to_currency(@share.sale_price(list, tier.minQty)) : "—" %> each
                      <span class="text-taupe">· <%= tier.discountPercent.to_i %>% off</span>
                    </span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="mt-4 flex items-center justify-between border-t border-fog pt-3">
            <p class="text-xs text-taupe">available</p>
            <p class="text-sm font-medium <%= qty.positive? ? "text-ink" : "text-rose" %>"><%= qty %></p>
          </div>

          <% if list.present? && qty.positive? %>
            <%= form_tag warehouse_cart_add_item_path(@share.token), method: :post, class: "mt-3 flex items-center gap-2 border-t border-fog pt-3" do %>
              <%= hidden_field_tag "variant_id", variant.id %>
              <%= number_field_tag "quantity", 1, min: 1, max: [qty, WarehouseCartItem::MAX_QUANTITY].min, class: "input w-20" %>
              <%= submit_tag "Add to cart", class: "btn-primary btn-sm flex-1" %>
            <% end %>
          <% end %>
        </article>
      <% end %>
  </section>

  <% if @variants.empty? %>
    <div class="card card-pad">
      <p class="py-4 text-center text-taupe">No products listed in this warehouse sale yet.</p>
    </div>
  <% end %>
</section>
