<%# Upload insights: a Report page (docs/ui-standards.md §4). Counts and times only; no file contents or names. %>
<% buckets = upload_chart_buckets(@insights.daily, @insights.days) %>
<% kept = @insights.funnel.first[:count] %>
<div class="space-y-6 operations-workspace">
  <%= page_header 'Upload insights', subtitle: 'How the inbox is doing: which files wait and why, which importers read cleanly, how long a file takes to reach an import.' %>
  <%= page_tabs(Uploads::Insights::RANGES.map { |days| ["Last #{days} days", insights_uploads_path(days: days), @insights.days == days] }, label: 'Time range') %>
  <p class="text-xs text-taupe">Counts and times only; no file contents, values or names appear here.</p>

  <% if @insights.total.zero? %>
    <div role="status"><%= empty_state "Nothing uploaded in the last #{@insights.days} days", hint: 'There is nothing to chart yet. Send a file from Uploads and this page fills in.' do %><%= link_to 'Open Uploads', uploads_path, class: 'btn-primary' %><% end %></div>
  <% else %>
    <section aria-label="Headline numbers" class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      <div class="stat"><p class="stat-label">Files received</p><p class="stat-value mt-1"><%= number_with_delimiter(@insights.total) %></p><p class="mt-1 text-xs text-taupe"><%= number_with_delimiter(kept) %> kept, the rest refused or repeats</p></div>
      <div class="stat"><p class="stat-label">Waiting for a person</p><p class="stat-value mt-1"><%= @insights.waiting_count %></p><p class="mt-1 text-xs text-taupe"><%= @insights.oldest_waiting_days ? "oldest #{pluralize(@insights.oldest_waiting_days, 'day')} old" : 'nothing waiting' %></p></div>
      <div class="stat"><p class="stat-label">Held for review</p><p class="stat-value mt-1"><%= upload_percent(@insights.status_totals['needs_review'], kept) %></p><p class="mt-1 text-xs text-taupe">of kept files needed a decision</p></div>
      <div class="stat"><p class="stat-label">Median time to import</p><p class="stat-value mt-1"><%= @insights.time_to_import_hours ? (@insights.time_to_import_hours < 48 ? "#{@insights.time_to_import_hours} h" : "#{(@insights.time_to_import_hours / 24).round(1)} d") : '–' %></p><p class="mt-1 text-xs text-taupe">from received to imported</p></div>
    </section>

    <section class="section-card" aria-label="Uploads by outcome">
      <%= section_heading 'Uploads by outcome', hint: "Each column is a #{@insights.days > 90 ? 'week' : 'day'}; imported sits on the baseline." %>
      <p class="text-sm text-mocha">A growing amber (needs review) share means files arrive that Rupert cannot place yet.</p>
      <ul class="upload-legend" aria-label="Legend">
        <% Uploads::Insights::SERIES.each do |status| %>
          <li><span class="upload-swatch upload-seg-<%= status %>" aria-hidden="true"></span><%= UploadsHelper::CHART_LABELS[status] %> <strong><%= @insights.status_totals[status] %></strong></li>
        <% end %>
      </ul>
      <%= upload_volume_chart(buckets) %>
      <details class="explainer">
        <summary class="explainer-summary">View as a table</summary>
        <div class="table-region mt-2" role="region" tabindex="0" aria-label="Uploads by outcome per period"><table class="table">
          <caption class="sr-only">Uploads by outcome per <%= @insights.days > 90 ? 'week' : 'day' %></caption>
          <thead><tr><th scope="col" class="th"><%= @insights.days > 90 ? 'Week' : 'Day' %></th><% Uploads::Insights::SERIES.each do |status| %><th scope="col" class="th num"><%= UploadsHelper::CHART_LABELS[status] %></th><% end %><th scope="col" class="th num">Total</th></tr></thead>
          <tbody>
            <% buckets.reverse.each do |bucket| %>
              <tr><th scope="row" class="td font-normal"><%= bucket[:label] %></th><% Uploads::Insights::SERIES.each do |status| %><td class="td num"><%= bucket[:counts][status] %></td><% end %><td class="td num"><%= bucket[:total] %></td></tr>
            <% end %>
          </tbody>
        </table></div>
      </details>
    </section>

    <section class="section-card" id="funnel-title" aria-label="How far files get">
      <%= section_heading 'How far files get', hint: 'Share of kept files at each step.' %>
      <p class="text-sm text-mocha">A big drop between steps shows where people have to step in: a sniffer that is not sure, or an importer that cannot read the file.</p>
      <ol class="upload-bars">
        <% @insights.funnel.each do |step| %>
          <li>
            <div class="upload-bar-head"><span><%= step[:label] %></span><span><strong><%= step[:count] %></strong> <span class="text-taupe">(<%= upload_percent(step[:count], kept) %>)</span></span></div>
            <div class="upload-bar" role="img" aria-label="<%= step[:label] %>: <%= step[:count] %> of <%= kept %>"><span style="width: <%= kept.zero? ? 0 : [(step[:count] * 100.0 / kept), 100].min.round(1) %>%"></span></div>
            <p class="upload-bar-note"><%= step[:note] %></p>
          </li>
        <% end %>
      </ol>
    </section>

    <section class="section-card" id="reasons-title" aria-label="Why files wait or are refused">
      <%= section_heading 'Why files wait or are refused' %>
      <% if @insights.reasons.empty? %>
        <p class="text-sm text-mocha">No file was held, refused or repeated in this period.</p>
      <% else %>
        <p class="text-sm text-mocha">The most common cause is the next thing to fix. “Recognized, no importer” is the list of importers to build.</p>
        <% top = @insights.reasons.first[:count] %>
        <ol class="upload-bars">
          <% @insights.reasons.each do |reason| %>
            <li>
              <div class="upload-bar-head"><span><%= reason[:label] %></span><strong><%= reason[:count] %></strong></div>
              <div class="upload-bar" role="img" aria-label="<%= reason[:label] %>: <%= reason[:count] %>"><span style="width: <%= (reason[:count] * 100.0 / top).round(1) %>%"></span></div>
              <% if reason[:hint] %><p class="upload-bar-note"><%= reason[:hint] %></p><% end %>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>

    <section class="section-card" aria-label="What Rupert thinks files are">
      <%= section_heading 'What Rupert thinks files are' %>
      <div class="table-region" role="region" tabindex="0" aria-label="Detected file types"><table class="table">
        <caption class="sr-only">Detected file types with how often each needed a person</caption>
        <thead><tr><th scope="col" class="th">Looks like</th><th scope="col" class="th num">Files</th><th scope="col" class="th num">Avg. sure</th><th scope="col" class="th num">Held</th><th scope="col" class="th num">Type chosen by hand</th><th scope="col" class="th num">Imported</th></tr></thead>
        <tbody>
          <% @insights.types.each do |type| %>
            <tr><th scope="row" class="td font-normal"><%= type[:label] %></th><td class="td num"><%= type[:count] %></td><td class="td num"><%= type[:average_confidence] ? "#{type[:average_confidence]}%" : '–' %></td><td class="td num"><%= upload_percent(type[:held], type[:count]) %></td><td class="td num"><%= upload_percent(type[:helped], type[:count]) %></td><td class="td num"><%= type[:imported] %></td></tr>
          <% end %>
        </tbody>
      </table></div>
      <p class="text-xs text-taupe">“Type chosen by hand” is how often someone had to override or confirm Rupert’s guess: a high share means the sniffer for that type is too loose or too shy.</p>
    </section>

    <section class="section-card" aria-label="Importer health">
      <%= section_heading 'Importer health' %>
      <% if @insights.importers.empty? %>
        <p class="text-sm text-mocha">No dry runs or imports in this period yet.</p>
      <% else %>
        <div class="table-region" role="region" tabindex="0" aria-label="Dry runs and imports per importer"><table class="table">
          <caption class="sr-only">Dry runs and imports per importer</caption>
          <thead><tr><th scope="col" class="th">Importer</th><th scope="col" class="th num">Dry runs passed</th><th scope="col" class="th num">Dry runs failed</th><th scope="col" class="th num">Pass rate</th><th scope="col" class="th num">Imported</th><th scope="col" class="th num">Import failures</th></tr></thead>
          <tbody>
            <% @insights.importers.each do |importer| %>
              <tr><th scope="row" class="td font-normal"><%= importer[:label] %></th><td class="td num"><%= importer[:passed] %></td><td class="td num"><%= importer[:failed] %></td><td class="td num"><%= upload_percent(importer[:passed], importer[:passed] + importer[:failed]) %></td><td class="td num"><%= importer[:imported] %></td><td class="td num"><%= importer[:import_failed] %></td></tr>
            <% end %>
          </tbody>
        </table></div>
        <p class="text-xs text-taupe">A low pass rate means people send files in a layout the importer does not accept: read its error messages on the failed uploads and widen the parser or sharpen the message. Counted from the activity trail, so dry runs before this page existed have no importer and are not listed.</p>
      <% end %>
    </section>

    <section class="section-card" aria-label="Where files come from">
      <%= section_heading 'Where files come from' %>
      <ul class="text-sm space-y-1">
        <% { 'web' => 'Browser', 'api' => 'API', 'drop' => 'Drop folder' }.each do |key, label| %>
          <li><%= label %>: <strong><%= @insights.origins.fetch(key, 0) %></strong></li>
        <% end %>
      </ul>
      <p class="text-xs text-taupe">If the API or drop folder stay at zero, the “send without opening Rupert” path is not being used.</p>
    </section>
  <% end %>
</div>
