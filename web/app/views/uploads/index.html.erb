<%# Uploads: a List page (docs/ui-standards.md §4). The dropzone sits above the list; status is a toolbar filter. %>
<div class="space-y-6 operations-workspace">
  <%= page_header 'Uploads', subtitle: 'Send any file here; Rupert keeps the original, works out what it is and changes nothing until a person approves a dry run.',
                  menu: [['Insights', insights_uploads_path], (['Copy from Google Drive', uploads_drive_path] if @can_write)].compact %>
  <%= fold_explainer('Bank statements, QuickBooks exports, SwipeSimple, NAB / IRIS, Authorize.net and timesheets all belong here. Rupert keeps the original untouched, works out what it is, and shows what it would do. Nothing changes in your records until a person runs a dry run and approves it.', class: 'text-sm text-mocha') %>

  <% if @can_write %>
    <%= form_with url: uploads_path, multipart: true, data: { controller: 'dropzone', turbo: false, dropzone_max_files_value: Uploads::Limits::MAX_FILES_PER_REQUEST, dropzone_max_bytes_value: Uploads::Limits::MAX_FILE_BYTES, dropzone_max_total_value: Uploads::Limits::MAX_REQUEST_BYTES }, class: 'card card-pad space-y-3', id: 'upload-form' do |f| %>
      <div class="upload-dropzone" data-dropzone-target="zone" data-action="dragover->dropzone#over dragenter->dropzone#over dragleave->dropzone#leave drop->dropzone#drop">
        <%= f.label :files, for: 'upload-files', class: 'upload-dropzone-label' do %>
          <span class="font-display text-lg">Drop files here</span>
          <span class="text-sm text-mocha">or <span class="underline">choose files</span> from this device</span>
        <% end %>
        <%= file_field_tag 'files[]', id: 'upload-files', multiple: true, accept: Uploads::Limits.accept_attribute, class: 'upload-input', data: { dropzone_target: 'input', action: 'change->dropzone#changed' }, aria: { describedby: 'upload-help upload-status' } %>
      </div>
      <p id="upload-help" class="text-xs text-mocha">CSV, Excel (.xlsx), JSON, PDF or text. Up to <%= Uploads::Limits::MAX_FILES_PER_REQUEST %> files at a time, <%= Uploads::Limits.human_max %> each. Files are stored encrypted. Nothing inside a file is ever run or opened as a link.</p>
      <ul class="text-sm space-y-1" data-dropzone-target="list"></ul>
      <p id="upload-status" class="text-sm" role="status" aria-live="polite" data-dropzone-target="message"></p>
      <div class="form-actions">
        <%= f.button 'Upload', type: 'submit', class: 'btn-primary', disabled: true, data: { dropzone_target: 'submit' } %>
        <%= link_to 'Copy from Google Drive', uploads_drive_path, class: 'btn-ghost' %>
        <span class="text-xs text-mocha">Sending from another computer or a script? See <code>docs/ops/uploads-inbox.md</code> for the API and the drop folder.</span>
      </div>
    <% end %>
  <% end %>

  <% waiting = @counts.fetch('needs_review', 0) %>
  <% if waiting.positive? %>
    <p class="flash flash-notice text-sm" role="status"><strong><%= pluralize(waiting, 'file') %></strong> need<%= 's' if waiting == 1 %> a decision. <%= link_to 'Review', uploads_path(status: 'needs_review'), class: 'underline font-semibold' %></p>
  <% end %>
  <% if @can_write && @stale.positive? %>
    <div class="flash flash-notice flex flex-wrap items-center gap-3 text-sm" role="status">
      <span><%= pluralize(@stale, 'file') %> waiting for review w<%= @stale == 1 ? 'as' : 'ere' %> looked at before the current set of importers was installed.</span>
      <%= button_to 'Re-run recognition', recognize_all_uploads_path, method: :post, class: 'btn-ghost btn-sm', form: { data: { turbo: false } } %>
    </div>
  <% end %>

  <section class="space-y-4" aria-label="Every upload">
    <%= section_heading 'Every upload' %>
    <% statuses = [['all', 'All', @counts.values.sum], ['open', 'Open', Upload::OPEN_STATUSES.sum { |s| @counts.fetch(s, 0) }], ['needs_review', 'Needs review', @counts.fetch('needs_review', 0)], ['recognized', 'Recognized', @counts.fetch('recognized', 0)], ['imported', 'Imported', @counts.fetch('imported', 0)], ['rejected', 'Rejected', @counts.fetch('rejected', 0)], ['duplicate', 'Duplicate', @counts.fetch('duplicate', 0)]] %>
    <%= form_with url: uploads_path, method: :get, class: 'toolbar', aria: { label: 'Filter uploads' } do |f| %>
      <div class="toolbar-field">
        <%= f.label :status, 'Status', class: 'field-label' %>
        <%= f.select :status, options_for_select(statuses.map { |key, label, count| ["#{label} (#{count})", key == 'all' ? '' : key] }, @filter == 'all' ? '' : @filter), {}, class: 'input' %>
      </div>
      <div class="toolbar-field">
        <%= f.label :q, 'Search file names', class: 'field-label' %>
        <%= f.search_field :q, value: params[:q], placeholder: 'File name', class: 'input', maxlength: 80 %>
      </div>
      <div class="toolbar-actions">
        <%= f.submit 'Apply', class: 'btn-primary', name: nil %>
        <%= link_to 'Clear', uploads_path, class: 'btn-ghost' %>
      </div>
    <% end %>

    <div class="table-region" role="region" tabindex="0" aria-label="Uploaded files">
      <table class="table">
        <caption class="sr-only">Uploaded files, newest first</caption>
        <thead><tr>
          <th scope="col" class="th">File</th><th scope="col" class="th">Status</th><th scope="col" class="th hidden md:table-cell">Looks like</th><th scope="col" class="th num hidden sm:table-cell">Lines</th>
        </tr></thead>
        <tbody>
          <% if @uploads.empty? %>
            <tr><td class="td empty-row" colspan="4"><%= @counts.values.sum.zero? ? 'No uploads yet. Drop a file above to start.' : 'No uploads match. Clear the filter to see every upload.' %></td></tr>
          <% end %>
          <% @uploads.each do |upload| %>
            <tr>
              <td class="td">
                <%= link_to upload.filename, upload_path(upload), class: 'font-semibold text-olive-deep hover:underline break-words' %>
                <div class="text-xs text-taupe"><%= [upload.file_format && upload_format_label(upload), upload_size(upload), upload_who(upload), upload_origin_label(upload)].compact.join(' · ') %> · <time datetime="<%= upload.created_at.iso8601 %>"><%= l(upload.created_at, format: :short) %></time></div>
              </td>
              <td class="td"><%= upload_status_pill(upload) %><% if upload.reason.present? %><div class="mt-1 max-w-xs text-xs text-mocha"><%= truncate(upload.reason, length: 140) %></div><% end %></td>
              <td class="td hidden md:table-cell"><% if upload.detected_label.present? %><%= upload.detected_label %> <span class="text-xs text-taupe"><%= upload_confidence(upload) %></span><% elsif upload.source_guess.present? %><span class="text-xs text-taupe">Maybe <%= upload.source_guess %></span><% else %><span class="text-xs text-taupe">—</span><% end %></td>
              <td class="td num hidden sm:table-cell"><%= upload.row_count || '—' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%== pagy_nav(@pagy) if @uploads.any? && @pagy.pages > 1 %>
  </section>
</div>
