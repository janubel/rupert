<%# Header bell: opens the person's notifications, with an unread count. A system problem (card processing down)
    turns the badge red with "!" and is listed at the top of Notifications. %>
<% unread = Notification.unread_count_for(Current.user) %>
<% alerts = system_alerts %>
<% label = [(pluralize(alerts.size, 'alert') if alerts.any?), ("#{unread} unread" if unread.positive?)].compact.join(', ') %>
<%= link_to notifications_path, class: "nav-utility#{' nav-pill-active' if controller_name == 'notifications'}", aria: { label: (label.present? ? "Notifications, #{label}" : 'Notifications'), current: (controller_name == 'notifications' ? 'page' : nil) }, title: (alerts.any? ? alerts.map { |alert| alert[:title] }.join(' · ') : 'Notifications'), data: { system_alerts: alerts.size } do %><%= navigation_icon('bell') %><% if alerts.any? %><span class="absolute right-1 top-1 grid h-4 min-w-[1rem] place-items-center rounded-full bg-rose px-1 text-[10px] font-bold leading-none text-cream" aria-hidden="true">!</span><% elsif unread.positive? %><span class="absolute right-1 top-1 grid h-4 min-w-[1rem] place-items-center rounded-full bg-clay px-1 text-[10px] font-bold leading-none text-cream" aria-hidden="true"><%= unread > 9 ? "9+" : unread %></span><% end %><span class="nav-hint">Notifications</span><% end %>
