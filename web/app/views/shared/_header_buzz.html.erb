<%# Header entry for the team chat: opens the Buzz card (agent profile, open chat, connect, get the app). %>
<%= link_to buzz_path, class: "nav-utility#{' nav-pill-active' if controller_name == 'buzz'}", aria: { label: 'Buzz team chat', current: (controller_name == 'buzz' ? 'page' : nil) }, title: 'Buzz team chat', data: ({ action: 'buzz-badge#open' } if buzz_badge_available?) do %><%= navigation_icon('chat') %><% if buzz_badge_available? %><span class="badge nav-badge" data-buzz-badge-target="count" hidden>0</span><% end %><span class="nav-hint">Buzz</span><% end %>
