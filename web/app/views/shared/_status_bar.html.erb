<%# The status bar (docs/ui-standards.md §2): one thin strip under every page with the sync
    state, the Team chat unread badge and latest message, server health for platform
    administrators, help, bug reports and the build.
    Badges, not popups. %>
<footer class="app-statusbar" aria-label="Status">
  <%= render 'shared/statusbar_sync', sync: local_assigns[:sync] %>
  <% if team_chat_badge_available? %>
    <%= link_to team_chat_path, class: 'statusbar-item statusbar-chat', data: { action: 'team-chat-badge#open' } do %>
      <%= navigation_icon('chat', css_class: 'nav-symbol statusbar-icon') %>
      <span>Team chat</span>
      <span class="badge" data-team-chat-badge-target="count" hidden>0</span>
      <span class="statusbar-latest"><strong data-team-chat-badge-target="author" hidden></strong> <span data-team-chat-badge-target="latest" hidden></span></span>
    <% end %>
  <% end %>
  <span class="statusbar-spacer"></span>
  <%= render 'shared/statusbar_vitals' if Current.user.super_admin? %>
  <%= link_to feedback_reports_path, class: 'statusbar-item', aria: { label: 'Report a bug or send a request', expanded: 'false', haspopup: 'dialog', controls: 'feedback-panel' }, title: 'Report a bug or request', data: { action: 'click->feedback#toggle', feedback_target: 'trigger', feedback_ignore: '' } do %><%= navigation_icon('bug', css_class: 'nav-symbol statusbar-icon') %><span class="statusbar-label">Report a problem</span><% end %>
  <%= link_to learning_index_path, class: 'statusbar-item', aria: { label: 'Help', expanded: 'false', haspopup: 'dialog' }, title: 'Help — press ?', data: { action: 'click->help-panel#toggle', help_panel_target: 'trigger', tour: 'help' } do %><span>Help</span> <kbd>?</kbd><% end %>
  <span class="statusbar-item statusbar-build" title="<%= BuildInfo.current.revision %>"><%= BuildInfo.current.label %></span>
</footer>
