<div class="report-table" data-controller="report-table" data-report-table-key-value="<%= key %>" data-report-table-filename-value="<%= filename %>" data-report-table-sortable-value="<%= sortable %>">
  <div class="report-table-toolbar no-print" <%= tour_anchor('columns') %>>
    <input type="search" class="input report-table-filter" placeholder="Narrow rows…" aria-label="Narrow rows in <%= label %>" data-report-table-target="filter" data-action="input->report-table#filter keydown.esc->report-table#clearFilter">
    <details class="report-table-menu">
      <summary class="btn-ghost btn-sm">Columns</summary>
      <fieldset class="report-table-columns">
        <legend class="sr-only">Columns shown in <%= label %></legend>
        <div data-report-table-target="columns"></div>
      </fieldset>
    </details>
    <button type="button" class="btn-ghost btn-sm" data-action="report-table#download" title="Download the rows and columns shown, in this order">Download view</button>
    <button type="button" class="btn-ghost btn-sm" data-action="report-table#reset" title="Show the default columns and order">Reset</button>
    <span class="report-table-count" data-report-table-target="count" aria-live="polite"></span>
  </div>
  <div class="report-table-scroll" role="region" tabindex="0" aria-label="<%= label %>"><%= table %></div>
  <p class="report-table-empty" data-report-table-target="empty" hidden>No rows match. <button type="button" class="font-semibold underline" data-action="report-table#clearFilter">Clear filter</button></p>
</div>
