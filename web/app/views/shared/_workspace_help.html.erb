<%# The help bar at the top of every work page: a closed "How this page works" disclosure, an optional
    guided tour of the page's real elements, and a link to the matching lesson. Nothing opens by itself. %>
<% guide = PageGuides.for_path(request.path); lesson = LearningCatalog.for_path(request.path, Current.user); tour = learning_tour %>
<% guide = nil if Current.user.employee? && request.path.start_with?('/projects/') %>
<% if guide || lesson || tour %>
  <% tour_steps = tour ? tour.steps.map { |step| { anchor: step[:anchor], title: step[:title], body: step[:body] } } : [] %>
  <div class="help-bar mb-4" <% if tour %>data-controller="tour" data-action="rupert:start-tour@window->tour#start" data-tour-key-value="<%= tour.key %>" data-tour-title-value="<%= tour.title %>" data-tour-steps-value="<%= tour_steps.to_json %>" data-tour-save-url-value="<%= learning_preferences_path %>" data-tour-done-value="<%= learning_journey.tour_done?(tour.key) %>" data-tour-autostart-value="<%= (params[:tour] == '1' || tour.key == 'team_chat') && !learning_journey.tour_done?(tour.key) %>"<% end %>>
    <details class="workspace-help">
      <summary class="cursor-pointer font-medium text-mocha hover:text-ink">How this page works</summary>
      <div id="page-guide-panel" class="card card-pad mt-3 space-y-4">
        <div><h2 class="font-display text-lg"><%= guide ? guide.title : (lesson ? lesson[:title] : tour.title) %></h2><p class="mt-2 text-sm text-mocha"><%= guide ? guide.summary : (lesson ? lesson[:summary] : tour.intro) %></p></div>
        <% if guide %>
          <% guide.sections.each do |section| %><section><h3 class="font-semibold"><%= section[:heading] %></h3><p class="mt-1 text-sm text-mocha"><%= section[:body] %></p></section><% end %>
          <% if guide.tips.any? %><ul class="list-disc space-y-2 pl-5 text-sm text-mocha"><% guide.tips.each do |tip| %><li><%= tip %></li><% end %></ul><% end %>
        <% elsif lesson %>
          <ol class="list-decimal space-y-2 pl-5 text-sm text-mocha"><% lesson[:steps].each do |step| %><li><%= step %></li><% end %></ol>
        <% end %>
        <% if tour %>
          <section class="border-t border-fog pt-4"><h3 class="font-semibold">Take a look around</h3><p class="mt-1 text-sm text-mocha"><%= tour.intro %></p>
            <ol class="mt-2 list-decimal space-y-2 pl-5 text-sm text-mocha"><% tour.steps.each do |step| %><li><strong class="text-ink"><%= step[:title] %>.</strong> <%= step[:body] %></li><% end %></ol>
            <button type="button" class="btn-ghost btn-sm mt-3" hidden data-tour-target="trigger" data-action="tour#start">Start the guided tour · <%= tour.minutes %> min</button>
          </section>
        <% end %>
        <% if lesson %>
          <div class="border-t border-fog pt-4"><h3 class="font-semibold">Words you’ll see here</h3><dl class="mt-3 space-y-3"><% lesson[:terms].first(4).each do |term| %><% label, definition = LearningCatalog::TERMS.fetch(term) %><div><dt class="text-sm font-semibold"><%= label %></dt><dd class="mt-1 text-sm text-mocha"><%= definition %></dd></div><% end %></dl></div>
          <%= link_to "Practice this task · #{lesson[:minutes]} min", learning_path(lesson[:key]), class: 'btn-ghost btn-sm' %>
        <% end %>
      </div>
    </details>
    <% if tour %>
      <button type="button" class="help-bar-link" hidden data-tour-target="trigger" data-action="tour#start" aria-label="<%= tour.title %>, guided tour, about <%= tour.minutes %> minute<%= 's' unless tour.minutes == 1 %>">Show me around<% unless learning_journey.tour_done?(tour.key) %><span class="help-new" data-tour-target="badge">New</span><% end %></button>
    <% end %>
    <%= link_to lesson ? "Learn this task · #{lesson[:minutes]} min" : 'Learn Rupert & definitions', lesson ? learning_path(lesson[:key]) : learning_index_path, class: 'help-bar-link' %>
  </div>
<% end %>
