<%# Ask Rupert drawer: the in-app help chat. Behind the chat-bubble button in the header; talks to AskRupertController as JSON. %>
<div class="help-panel-backdrop hidden" data-ask-rupert-target="backdrop" data-action="click->ask-rupert#close"></div>
<aside class="help-panel ask-panel hidden" role="dialog" aria-modal="true" aria-labelledby="ask-rupert-title" data-ask-rupert-target="panel" data-action="keydown->ask-rupert#trapFocus"
       data-ask-rupert-state-url-value="<%= ask_rupert_path(format: :json) %>" data-ask-rupert-conversations-url-value="<%= ask_rupert_conversations_path %>" data-ask-rupert-page-value="<%= request.path %>">
  <div class="help-panel-head">
    <h2 id="ask-rupert-title" class="font-display text-xl">Ask Rupert</h2>
    <div class="ask-head-actions">
      <button type="button" class="btn-ghost btn-sm" data-action="ask-rupert#newChat" data-ask-rupert-target="newButton">New chat</button>
      <button type="button" class="btn-ghost btn-sm" data-action="ask-rupert#clear" data-ask-rupert-target="clearButton">Clear</button>
      <button type="button" class="nav-utility" data-action="ask-rupert#close" aria-label="Close Ask Rupert"><span aria-hidden="true">×</span></button>
    </div>
  </div>
  <p class="ask-disclosure" data-ask-rupert-target="disclosure">Checking how answers are written…</p>
  <div class="ask-log" role="log" tabindex="0" aria-label="Conversation with Ask Rupert" aria-live="polite" data-ask-rupert-target="log"></div>
  <div class="ask-starters hidden" data-ask-rupert-target="starters" role="group" aria-label="Suggested questions"></div>
  <p class="ask-notice hidden" role="status" data-ask-rupert-target="notice"></p>
  <form class="ask-form" data-action="submit->ask-rupert#send" data-ask-rupert-target="form">
    <label for="ask-rupert-input" class="sr-only">Your question</label>
    <textarea id="ask-rupert-input" class="ask-input" rows="2" maxlength="1000" placeholder="Ask how to do something…" autocomplete="off"
              data-ask-rupert-target="input" data-action="keydown->ask-rupert#keydown input->ask-rupert#grow"></textarea>
    <button type="submit" class="btn-primary" data-ask-rupert-target="submit">Send</button>
  </form>
  <p class="ask-footnote">
    <button type="button" class="ask-link" data-action="ask-rupert#reportChat">Not helpful? Report it to the Rupert team</button>
    <span aria-hidden="true">·</span> <%= link_to 'Learn Rupert', learning_index_path, class: 'ask-link' %>
  </p>
</aside>
