<%# Collapsible in-app help: the icon was static, so the rich PageGuides
    content was never visible. Now a labeled button toggles the panel. %>
<div data-controller="page-guide" data-page-guide-auto-key-value="<%= request.path %>" data-page-guide-auto-open-value="false" class="mb-6">
  <div class="flex justify-end">
    <button type="button" data-action="click->page-guide#toggle" data-page-guide-target="trigger"
      aria-expanded="false" aria-controls="page-guide-panel"
      class="inline-flex items-center gap-2 rounded-full border border-olive/20 bg-paper px-3 py-1.5 text-xs font-semibold text-olive-deep shadow-[0_1px_2px_rgba(26,57,61,0.06)] hover:border-olive/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-olive">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      How this page works
    </button>
  </div>

  <div id="page-guide-panel" data-page-guide-target="panel" class="card card-pad mt-3 hidden">
    <h2 class="font-display text-lg text-ink"><%= guide.title %></h2>
    <p class="mt-1 text-sm text-mocha"><%= guide.summary %></p>
    <% guide.sections.each do |section| %>
      <h3 class="mt-4 text-sm font-semibold text-ink"><%= section[:heading] %></h3>
      <p class="mt-1 text-sm text-mocha"><%= section[:body] %></p>
    <% end %>
    <% if guide.tips.any? %>
      <h3 class="mt-4 text-sm font-semibold text-ink">Tips</h3>
      <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-mocha">
        <% guide.tips.each do |tip| %>
          <li><%= tip %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
