<%# Time workspace header: the everyday pages up front, the rest under "More".
    A page in "More" is shown up front while you are on it. %>
<% links = time_workspace_links %>
<% if links.length > 1 %>
  <% primary_labels = ['Time keeping', 'Timesheets', 'Punch report', 'Team schedule'] %>
  <% primary, more = links.partition { |label, _path, active| primary_labels.include?(label) || active } %>
  <nav aria-label="Time workspace" class="retail-navigation">
    <% primary.each do |label, path, active| %>
      <%= link_to label, path, class: "nav-pill workspace-nav-link #{active ? 'nav-pill-active' : 'nav-pill-idle'}", aria: { current: active ? 'page' : nil } %>
    <% end %>
    <% if more.any? %>
      <details class="relative" data-controller="navigation-menu">
        <summary class="nav-pill nav-pill-idle workspace-nav-link cursor-pointer list-none">More ▾</summary>
        <div class="absolute left-0 z-20 mt-1 flex min-w-48 flex-col gap-1 rounded-xl border border-fog bg-paper p-2 shadow-lg">
          <% more.each do |label, path, _active| %>
            <%= link_to label, path, class: 'nav-menu-item rounded-lg px-3 py-2 text-sm hover:bg-haze' %>
          <% end %>
        </div>
      </details>
    <% end %>
  </nav>
<% end %>
