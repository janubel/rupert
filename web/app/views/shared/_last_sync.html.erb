<%# "Last synced" indicator, shared by the dashboard and live updates.
    Accepts a local `sync:` or falls back to @last_sync. %>
<div id="last-sync">
  <% sync = local_assigns[:sync] || @last_sync %>
  <% if sync %>
    <p class="text-xs text-taupe">
      <%= sync.source.presence || 'Unknown source' %> · <%= sync.mode %> ·
      <%= sync.success? ? 'Finished' : 'Started' %> <%= time_ago_in_words(sync.success? && sync.finishedAt ? sync.finishedAt : sync.startedAt) %> ago
      <span class="<%= sync.success? ? "pill-fern" : "pill-rose" %>"><%= sync.status %></span>
    </p>
  <% else %>
    <p class="text-xs text-taupe">No syncs yet — hit Sync now.</p>
  <% end %>
</div>
