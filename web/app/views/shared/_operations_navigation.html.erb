<% groups = operations_link_groups(workspace, day: local_assigns[:day]); finance = %i[money finance].include?(workspace.to_sym) %>
<% if groups.any? %>
  <nav class="operations-navigation <%= 'finance-navigation' if finance %>" aria-label="<%= finance ? 'Finance' : workspace.to_s.humanize %> workspace">
    <% if finance %>
      <% groups.each do |group, links| %>
        <div class="finance-navigation-group" role="group" aria-label="<%= group %>">
          <span class="workspace-nav-group"><%= group %></span>
          <% links.each do |label, path, active| %><%= link_to label, path, class: "nav-pill workspace-nav-link #{active ? 'nav-pill-active' : 'nav-pill-idle'}", aria: { current: active ? 'page' : nil } %><% end %>
        </div>
      <% end %>
    <% else %>
      <% groups.each do |group, links| %>
        <% if group %><span class="workspace-nav-group"><%= group %></span><% end %>
        <% links.each do |label, path, active| %><%= link_to label, path, class: "nav-pill workspace-nav-link #{active ? 'nav-pill-active' : 'nav-pill-idle'}", aria: { current: active ? 'page' : nil } %><% end %>
      <% end %>
    <% end %>
  </nav>
<% end %>
