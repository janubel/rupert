<% groups = operations_link_groups(workspace, day: local_assigns[:day]); finance = %i[money finance].include?(workspace.to_sym) %>
<% if groups.any? %>
  <nav class="operations-navigation <%= 'finance-navigation' if finance %>" aria-label="<%= finance ? 'Bookkeeping' : workspace.to_s.humanize %> workspace">
    <% if finance %>
      <% current_label = groups.flat_map { |_g, links| links }.find { |link| link[2] }&.first %>
      <details class="finance-menu" open data-controller="menu-collapse">
        <summary class="finance-menu-summary">Bookkeeping menu<% if current_label %> · You are on: <%= current_label %><% end %></summary>
      <div class="finance-navigation-title"><span>Bookkeeping</span><span class="finance-navigation-hint">Transactions · Reconciliation · Reports</span></div>
      <% primary = groups.find { |group, _| group == 'Bookkeeping' } %>
      <% if primary %><div class="finance-primary-links"><% primary.last.each do |label, path, active| %><%= link_to label, path, class: "nav-pill workspace-nav-link #{active ? 'nav-pill-active' : 'nav-pill-idle'}", aria: { current: active ? 'page' : nil } %><% end %></div><% end %>
      <div class="finance-navigation-groups">
        <% groups.each do |group, links| %>
          <% next if group == 'Bookkeeping' %>
          <details class="finance-navigation-group" <%= 'open' if links.any? { |link| link[2] } %>>
            <summary class="workspace-nav-group"><%= group %></summary>
            <div class="finance-navigation-links">
              <% links.each do |label, path, active| %><%= link_to label, path, class: "nav-pill workspace-nav-link #{active ? 'nav-pill-active' : 'nav-pill-idle'}", aria: { current: active ? 'page' : nil } %><% end %>
            </div>
          </details>
        <% end %>
      </div>
      </details>
    <% else %>
      <% groups.each do |group, links| %>
        <% if group %><span class="workspace-nav-group"><%= group %></span><% end %>
        <% links.each do |label, path, active| %><%= link_to label, path, class: "nav-pill workspace-nav-link #{active ? 'nav-pill-active' : 'nav-pill-idle'}", aria: { current: active ? 'page' : nil } %><% end %>
      <% end %>
    <% end %>
  </nav>
<% end %>
