<%# Header sync-status pill, shared by the shell layout and live updates.
    Falls back to @last_sync when no local is given. %>
<span id="header-sync-pill">
  <% sync = local_assigns[:sync] || @last_sync %>
  <% if sync %>
    <% synced = sync.success? %>
    <% event_at = synced && sync.finishedAt ? sync.finishedAt : sync.startedAt %>
    <span class="<%= synced ? "pill-fern" : "pill-clay" %>" title="Latest recorded run: <%= sync.source.presence || 'Unknown source' %> · <%= sync.mode %> · <%= l(event_at, format: :short) %>">
      <span class="dot <%= synced ? "bg-fern" : "bg-clay" %>"></span>
      <%= sync.source.presence || 'Unknown source' %> · <%= sync.mode %> · <%= sync.status %>
      <time datetime="<%= event_at.iso8601 %>"><%= time_ago_in_words(event_at) %> ago</time>
    </span>
  <% else %>
    <span class="pill-taupe">
      <span class="dot bg-taupe"></span>
      Never synced
    </span>
  <% end %>
</span>
