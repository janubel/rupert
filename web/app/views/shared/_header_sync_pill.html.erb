<%# Compact read-only status; no sync information is rendered without read access. %>
<span id="header-sync-pill">
  <% if Current.user&.can?('sync.read') %>
    <% sync = local_assigns[:sync] || @last_sync %>
    <% event_at = sync && (sync.success? && sync.finishedAt ? sync.finishedAt : sync.startedAt) %>
    <% description = sync ? "#{sync.source.presence || 'Unknown source'} · #{sync.mode} · #{sync.status}" : 'Never synced' %>
    <%= link_to syncs_path, class: 'nav-utility', aria: { label: "Sync status: #{description}" }, title: "Sync status: #{description}" do %>
      <%= navigation_icon('sync') %><span aria-hidden="true" class="sync-status-dot <%= sync ? (sync.success? ? 'bg-fern' : 'bg-clay') : 'bg-taupe' %>"></span>
      <span class="nav-hint"><%= description %><% if event_at %><br><time datetime="<%= event_at.iso8601 %>"><%= time_ago_in_words(event_at) %> ago</time><% end %></span>
    <% end %>
  <% end %>
</span>
