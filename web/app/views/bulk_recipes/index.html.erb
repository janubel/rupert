<% content_for :title, 'Bulk recipes' %>
<div class="space-y-6">
  <%= page_header 'Bulk recipes', subtitle: 'Exact Shopify variants mapped to grams of one raw material per sold unit.' do %>
    <% if Current.user.can?('inventory.write') %><%= link_to 'Add recipe version', new_bulk_recipe_path, class: 'btn-primary' %><% end %>
  <% end %>
  <div class="card overflow-hidden">
    <div class="table-region" role="region" tabindex="0" aria-label="Bulk recipes">
      <table class="table">
        <thead><tr><% [['Exact variant', 'native_id', false], ['Material', nil, false], ['Grams per unit', 'recipe', true], ['Version / effective time', nil, false], ['Recorded by', nil, false]].each do |label, term, numeric| %><th class="th<%= ' num' if numeric %>" scope="col"><%= label %><%= define(term) if term %></th><% end %></tr></thead>
        <tbody>
          <% @recipes.each do |recipe| %><tr><td class="td"><span class="font-medium text-ink"><%= recipe.catalog_title %></span><p class="font-mono text-xs text-taupe"><%= recipe.source_variant_id %></p><p class="text-xs text-taupe"><%= recipe.catalog_sku.presence || 'No SKU' %></p></td><td class="td"><%= link_to recipe.bulk_material.name, bulk_material_path(recipe.bulk_material), class: 'hover:underline' %></td><td class="td num"><%= number_with_precision(recipe.grams, precision: 3, strip_insignificant_zeros: true) %></td><td class="td">v<%= recipe.version %><p class="text-xs text-taupe"><%= recipe.effective_from.iso8601 %></p></td><td class="td"><%= recipe.created_by %></td></tr><% end %>
          <% if @recipes.empty? %><tr><td colspan="5" class="empty-row">No recipes yet. Add a material and its lot receipts, then map an exact variant.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% if @pagy.pages > 1 %><div class="text-xs text-taupe"><%== @pagy.series_nav %></div><% end %>
  <%= fold_explainer('Every definition is a new immutable version with an effective time. Applied material-use receipts retain their original version, and reused SKUs never choose the recipe. Record receipts and lot balances under Bulk materials, then review imported sale lines under Material use. Automatic source stock changes, refund restocking and Google Sheets synchronization remain separate work.', class: 'text-sm text-mocha') %>
</div>
