<% content_for :title, 'Record bulk recipe' %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="space-y-6">
  <section><h1 class="page-title">Record bulk recipe version</h1><p class="mt-2 text-sm text-mocha">Choose the exact product variant and verified grams used for one sold unit. New versions must take effect after the previous version.</p></section>
  <% if @recipe.errors.any? %><div class="card card-pad text-rose" role="alert"><% @recipe.errors.full_messages.each do |error| %><p><%= error %></p><% end %></div><% end %>
  <%= form_with url: new_bulk_recipe_path, method: :get, class: 'card card-pad flex flex-wrap items-end gap-3' do |f| %><div><%= f.label :q, 'Find variant by product, title or SKU' %><%= f.text_field :q, value: @query, class: 'input' %></div><%= f.submit 'Find variants', class: 'btn-ghost' %><% end %>
  <%= form_with url: bulk_recipes_path, scope: :bulk_recipe, class: 'card card-pad space-y-4' do |f| %>
    <div><%= f.label :source_variant_id, 'Exact Shopify variant', class: 'block text-sm' %><%= f.select :source_variant_id, @variants.map { |variant| ["#{variant.product&.title} — #{variant.title} | #{variant.sku.presence || 'No SKU'} | #{variant.id}", variant.id] }, { selected: @recipe.source_variant_id, include_blank: 'Choose an exact variant' }, required: true, class: 'input' %><% if @variants_limited %><p class="text-xs text-taupe mt-2">First 50 matching variants shown. Narrow the search to find another exact item.</p><% end %></div>
    <div><%= f.label :material_id, 'Raw material', class: 'block text-sm' %><%= f.select :material_id, @materials.map { |material| [material.name, material.id] }, { selected: @recipe.bulk_material_id, include_blank: 'Choose material' }, required: true, class: 'input' %><% if @materials_limited %><p class="text-xs text-taupe">First 200 materials shown; review the material catalog before configuring another.</p><% end %></div>
    <div><%= f.label :grams_per_unit, 'Grams per sold unit (up to 3 decimal places)', class: 'block text-sm' %><%= f.text_field :grams_per_unit, value: @recipe.grams_per_unit, inputmode: 'decimal', required: true, class: 'input', placeholder: '3.5' %></div>
    <div><%= f.label :effective_from, 'Effective time with UTC offset', class: 'block text-sm' %><%= f.text_field :effective_from, value: @submitted_effective_from || @recipe.effective_from&.iso8601 || Time.current.iso8601, required: true, class: 'input', placeholder: '2026-10-15T10:00:00-04:00' %><p class="text-xs text-taupe mt-2">Earlier sales are eligible only if a recipe version was explicitly effective at their imported sale time. Recording a recipe does not deduct stock.</p></div>
    <%= f.submit 'Record immutable recipe version', class: 'btn-primary' %><%= link_to 'Cancel', bulk_recipes_path, class: 'btn-ghost' %>
  <% end %>
</div>
