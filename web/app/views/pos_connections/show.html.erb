<% content_for :title, "#{@provider[:name]} setup" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="space-y-6">
  <section><%= link_to 'POS & payment connections', pos_connections_path, class: 'text-sm text-olive' %><h1 class="page-title mt-3"><%= @provider[:name] %> setup</h1><p class="mt-2 text-sm text-mocha"><%= @provider[:description] %></p><p class="pill-taupe mt-3"><%= @connection.status_label %></p></section>
  <section class="card card-pad space-y-3"><p class="text-sm"><%= @provider[:instructions] %></p><div class="flex flex-wrap gap-3"><%= link_to 'Open vendor site', @provider[:website], target: '_blank', rel: 'noopener noreferrer', class: 'btn-ghost' %><%= link_to 'Connection documentation', @provider[:docs], target: '_blank', rel: 'noopener noreferrer', class: 'btn-ghost' %>
    <% if @provider[:mode] == 'existing' %><%= link_to 'Existing connection settings', settings_path(anchor: 'env'), class: 'btn-ghost' %><% end %>
    <% if @provider[:mode] == 'csv' && Current.user.can?('sync.read') %><%= link_to 'SwipeSimple CSV import', syncs_path(anchor: 'swipesimple'), class: 'btn-ghost' %><% end %></div>
  </section>
  <% if @connection.last_checked_at %><section class="card card-pad"><p class="text-sm"><%= @connection.last_check_message %></p><p class="text-xs text-taupe mt-2">Checked <%= l(@connection.last_checked_at, format: '%b %d, %Y %H:%M:%S %Z') %>. Read access does not establish payment or terminal readiness.</p></section><% end %>
  <% if Current.user.can?('settings.write') %>
    <%= form_with model: @connection, url: pos_connection_path(@provider[:key]), method: :patch, data: { turbo: false }, class: 'card card-pad space-y-4' do |form| %>
      <% if @connection.errors.any? %><div role="alert" class="text-sm text-rose"><%= @connection.errors.full_messages.to_sentence %></div><% end %>
      <%= form.hidden_field :lock_version if @connection.persisted? %>
      <div><%= form.label :environment, 'Account environment', class: 'block text-sm mb-1' %><%= form.select :environment, [['Trial / test account', 'sandbox'], ['Production account', 'production']], {}, class: 'input' %><p class="mt-1 text-xs text-taupe">Use credentials for the selected account. This label does not create a vendor sandbox. Changing it clears saved API credentials.</p></div>
      <div><%= form.label :account_reference, @provider[:key] == 'pax' ? 'Terminal model / device reference' : 'Merchant / store reference', class: 'block text-sm mb-1' %><%= form.text_field :account_reference, maxlength: 200, class: 'input' %><p class="mt-1 text-xs text-taupe">An operational reference only. Do not enter card numbers or passwords here.</p></div>
      <% if @provider[:key] == 'valmar' %><div><%= form.label :gateway, 'Gateway confirmed with Valmar', class: 'block text-sm mb-1' %><%= form.select :gateway, [['Not confirmed', 'unconfirmed'], ['Authorize.net', 'authorize_net'], ['NMI', 'nmi'], ['SwipeSimple', 'swipesimple'], ['Other — confirm API documentation', 'other']], {}, class: 'input' %><p class="mt-1 text-xs text-taupe">Recording this choice does not configure a gateway or enable charges.</p></div><% end %>
      <label class="flex gap-2 text-sm"><%= form.check_box :access_requested %><span>Vendor API / integration access has been requested</span></label>
      <label class="flex gap-2 text-sm"><%= form.check_box :vendor_approved %><span><%= @provider[:key] == 'cova' ? 'Cova approved this integration and supplied its Onboarding Package' : 'The vendor approved the required access for this account' %></span></label>
      <% if @provider[:credentials].any? %>
        <fieldset class="space-y-3"><legend class="font-medium">Dedicated integration credentials</legend><p class="text-xs text-taupe">Stored encrypted. Saved values are never filled back into this form. Leave fields blank to keep existing values; use Remove saved credentials to clear them. Saving does not contact the vendor.</p>
          <% @provider[:credentials].each do |key| %>
            <% label = { 'api_url' => 'API endpoint URL', 'account_id' => 'Account UUID', 'company_id' => 'Company ID', 'client_id' => 'Client ID', 'client_secret' => 'Client secret', 'api_username' => 'API username', 'api_password' => 'API password' }.fetch(key) %>
            <div><%= label_tag "pos_credential_#{key}", label, class: 'block text-sm mb-1' %><%= password_field_tag "pos_connection[credential_secret][#{key}]", nil, id: "pos_credential_#{key}", autocomplete: 'new-password', maxlength: 4096, class: 'input', placeholder: @connection.credential_values[key].present? ? 'Saved · leave blank to keep' : 'Not saved' %></div>
          <% end %>
        </fieldset>
      <% end %>
      <%= form.submit 'Save setup', class: 'btn-primary' %>
    <% end %>
    <% if @connection.credentials_saved? %><section class="card card-pad space-y-3"><h2 class="font-display text-xl">Check saved API access</h2><p class="text-sm text-mocha">The check contacts this provider using the saved credentials and reads its store/location list. It does not import business records or initiate a payment.</p><div class="flex flex-wrap gap-3"><%= button_to 'Check read access', check_access_pos_connection_path(@provider[:key]), method: :post, class: 'btn-primary', data: { turbo: false } %><%= button_to 'Remove saved credentials', disconnect_pos_connection_path(@provider[:key]), method: :post, class: 'btn-ghost', data: { turbo: false } %></div></section><% end %>
  <% else %><section class="card card-pad"><p class="text-sm text-mocha">An administrator with settings write access can save connection details and check API access.</p></section><% end %>
</div>
