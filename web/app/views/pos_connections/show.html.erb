<%# One provider's setup: a Form page with related cards (docs/ui-standards.md §4). %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<% can_write = Current.user.can?('settings.write') %>
<div class="page-medium space-y-6">
  <%= page_header "#{@provider[:name]} setup", subtitle: @provider[:description],
                  menu: [['Open vendor site', @provider[:website], { target: '_blank', rel: 'noopener noreferrer' }],
                         ['Connection documentation', @provider[:docs], { target: '_blank', rel: 'noopener noreferrer' }],
                         (['Existing connection settings', settings_path(anchor: 'env')] if @provider[:mode] == 'existing'),
                         (['SwipeSimple CSV import', swipesimple_reports_path(anchor: 'import')] if @provider[:key] == 'swipesimple' && Current.user.can?('sync.read'))].compact do %>
    <span class="pill-taupe"><%= @connection.status_label %></span>
  <% end %>
  <p class="text-sm text-mocha"><%= link_to 'Credentials & sync', connections_path, class: 'underline' %> · <%= link_to 'POS & payments', pos_connections_path, class: 'underline' %></p>
  <%= fold_explainer(@provider[:instructions], class: 'text-sm text-mocha') %>
  <% if @provider[:key] == 'ctrax' %>
    <section class="section-card">
      <%= section_heading 'Retail stock and daily sales', hint: 'C-Trax is the retail count reference.' %>
      <%= fold_explainer('Missing SKUs use native variant IDs. Reads every 30 minutes require the production job worker and scheduler to be running; this browser session is not used by the worker.', class: 'text-sm text-mocha') %>
      <div class="flex flex-wrap gap-2">
        <% if @connection.credentials_saved? && can_write && Current.user.can?('inventory.write') %><%= button_to 'Sync stock', sync_stock_pos_connection_path('ctrax'), method: :post, class: 'btn-primary', data: { turbo: false } %><% end %>
        <%= link_to 'Open C-Trax stock', ctrax_stock_index_path, class: 'btn-ghost' %>
        <%= link_to 'Open POS', ctrax_pos_path, class: 'btn-ghost' %>
        <%= link_to 'Daily sales and register close', ctrax_days_path, class: 'btn-ghost' %>
      </div>
    </section>
  <% end %>
  <% if @connection.gateway_details %>
    <section class="section-card">
      <%= section_heading "#{@connection.gateway_details[:name]} API setup" %>
      <p class="text-sm text-mocha"><%= @connection.gateway_details[:instructions] %></p>
      <div><%= link_to 'Gateway API documentation', @connection.gateway_details[:docs], target: '_blank', rel: 'noopener noreferrer', class: 'btn-ghost btn-sm' %></div>
    </section>
  <% end %>
  <% if @connection.errors.empty? && @connection.last_checked_at %>
    <section class="section-card">
      <p class="text-sm"><%= @connection.last_check_message %></p>
      <p class="text-xs text-taupe">Checked <%= l(@connection.last_checked_at, format: '%b %d, %Y %H:%M:%S %Z') %>. API checks do not establish payment or terminal readiness.</p>
    </section>
  <% end %>
  <% if can_write %>
    <%= form_with model: @connection, url: pos_connection_path(@provider[:key]), method: :patch, data: { turbo: false }, class: 'card card-pad space-y-4' do |form| %>
      <% if @connection.errors.any? %><div role="alert" class="flash flash-alert"><p><%= @connection.errors.full_messages.to_sentence %></p><p>Setup changes were not saved. <%= link_to 'Reload the saved connection', pos_connection_path(@provider[:key]), class: 'underline' %> to review its current details.</p></div><% end %>
      <%= form.hidden_field :lock_version if @connection.persisted? %>
      <fieldset class="space-y-4">
        <legend class="card-title">Account</legend>
        <div><%= form.label :environment, 'Account environment', class: 'field-label' %><%= form.select :environment, [['Trial / test account', 'sandbox'], ['Production account', 'production']], {}, class: 'input' %><p class="mt-1 text-xs text-taupe">Use credentials for the selected account. This label does not create a vendor sandbox. Changing the environment or gateway clears all saved API credentials and prior checks.</p></div>
        <div><%= form.label :account_reference, { 'pax' => 'Terminal model / device reference', 'authorize_net_reporting' => 'Authorize.net Gateway ID', 'iris_reporting' => 'Merchant IDs (comma-separated)', 'swipesimple' => 'SwipeSimple company ID (from dashboard URL)' }.fetch(@provider[:key], 'Merchant / store reference'), class: 'field-label' %><%= form.text_field :account_reference, maxlength: 200, class: 'input' %><p class="mt-1 text-xs text-taupe">An operational reference only. Do not enter card numbers or passwords here.</p></div>
        <% if @provider[:key] == 'valmar' %><div><%= form.label :gateway, 'Gateway confirmed with Valmar', class: 'field-label' %><%= form.select :gateway, [['Not confirmed', 'unconfirmed'], ['Authorize.net', 'authorize_net'], ['NMI', 'nmi'], ['SwipeSimple', 'swipesimple'], ['Other: confirm API documentation', 'other']], {}, class: 'input' %><p class="mt-1 text-xs text-taupe">Save the confirmed gateway selection to show its dedicated API fields. Changing the gateway removes all earlier API credentials and checks. This setup does not enable charges.</p></div><% end %>
        <% if @provider[:key] == 'authorize_net_reporting' %>
          <div><%= form.label :reporting_auth_mode, 'Reporting authentication', class: 'field-label' %><%= form.select :reporting_auth_mode, [['API Login ID + Transaction Key (can also process payments)', 'api_key'], ['OAuth application with read scope', 'oauth']], {}, class: 'input' %><p class="text-xs text-taupe mt-1">Save a changed method to display its fields. OAuth needs an existing approved application and refresh token; this page does not register an application or start merchant consent. Changing methods clears earlier credentials.</p></div>
          <label class="flex gap-2 text-sm"><%= form.check_box :reporting_enabled, class: 'checkbox' %><span>Enable reconciliation every 5 minutes and receive signed payment events</span></label>
          <div><%= label_tag :authorize_signature_key, 'Existing Signature Key (optional, for real-time events)', class: 'field-label' %><%= password_field_tag 'pos_connection[credential_secret][signature_key]', nil, id: 'authorize_signature_key', autocomplete: 'new-password', maxlength: 128, class: 'input', placeholder: @connection.credential_values['signature_key'].present? ? 'Saved · leave blank to keep' : 'Not saved' %><p class="mt-1 text-xs text-taupe">Use the existing key; replacing it can affect other integrations. Register payment events in the merchant portal using this callback after saving: <% if @connection.persisted? %><%= authorize_net_webhook_url(connection_id: @connection.id) %><% else %>Save this connection to obtain its callback URL.<% end %> The callback reads current transaction details and never awards a second commission for the gateway payment.</p></div>
        <% end %>
        <% if @provider[:key] == 'swipesimple' %><label class="flex gap-2 text-sm"><%= form.check_box :reporting_enabled, class: 'checkbox' %><span>Pull fresh website exports every 30 minutes</span></label><p class="text-xs text-taupe">Uses its own server login. USD · America/New_York · full transaction and invoice snapshots. A failed pull keeps the previous data; additional verification pauses the schedule.</p><% end %>
        <% if @provider[:key] == 'iris_reporting' %><div><%= form.label :reporting_auth_mode, 'NAB reporting access', class: 'field-label' %><%= form.select :reporting_auth_mode, [['NAB website login · native Daily Deposits CSV', 'web'], ['Approved IRIS REST API token', 'api_key']], {}, class: 'input' %><p class="text-xs text-taupe mt-1">Save a changed method to show its fields. Changing methods clears prior credentials. Website pulls use a new server session and pause when sign-in verification is required.</p></div><label class="flex gap-2 text-sm"><%= form.check_box :reporting_enabled, class: 'checkbox' %><span>Import NAB reports daily at 06:45 America/New_York (website: current and previous month; API: previous 31 dates)</span></label><% end %>
        <label class="flex gap-2 text-sm"><%= form.check_box :access_requested, class: 'checkbox' %><span>Vendor API / integration access has been requested</span></label>
        <label class="flex gap-2 text-sm"><%= form.check_box :vendor_approved, class: 'checkbox' %><span><%= { 'cova' => 'Cova approved this integration and supplied its Onboarding Package', 'ctrax' => 'I authorize Rupert to use this C-Trax account for read-only store data access', 'swipesimple' => 'I authorize Rupert to use this SwipeSimple login for read-only website exports', 'iris_reporting' => (@connection.reporting_auth_mode == 'web' ? 'I authorize Rupert to use this NAB login for read-only Daily Deposits exports' : 'NAB approved API read access for these merchants') }.fetch(@provider[:key], 'The vendor approved the required access for this account') %></span></label>
        <% if @provider[:key] == 'ctrax' %><label class="flex gap-2 text-sm"><%= form.check_box :hourly_sync_enabled, class: 'checkbox' %><span>Sync C-Trax stock every 30 minutes using the saved account</span></label><% if Current.user.can?('sales.write') %><label class="flex gap-2 text-sm"><%= form.check_box :reporting_enabled, class: 'checkbox' %><span>Read C-Trax sales and register sessions every 30 minutes (today and yesterday)</span></label><% end %><p class="text-xs text-taupe">Use a dedicated user with the narrowest available read permissions. The connector issues stock, sales and register reads only; a broader C-Trax login may still permit other actions outside Rupert.</p><% end %>
      </fieldset>
      <% if @connection.credential_keys.any? %>
        <fieldset class="space-y-3"><legend class="card-title"><%= @provider[:key] == 'ctrax' ? 'C-Trax read account' : 'Dedicated integration credentials' %></legend><p class="text-xs text-taupe">Stored encrypted. Saved values are never filled back into this form. Leave fields blank to keep existing values; use Remove saved credentials to clear them. Saving does not contact the vendor.</p>
          <% @connection.credential_keys.each do |key| %>
            <% label = { 'api_url' => 'API endpoint URL', 'api_token' => 'IRIS API token', 'account_id' => 'Account UUID', 'company_id' => 'Company ID', 'client_id' => 'Client ID', 'client_secret' => 'Client secret', 'api_username' => 'API username', 'api_password' => 'API password', 'api_login_id' => 'API Login ID', 'transaction_key' => 'Transaction key', 'client_key' => 'Public client key', 'security_key' => 'Private API security key', 'refresh_token' => 'OAuth refresh token', 'web_email' => 'SwipeSimple login email', 'web_password' => 'Website login password', 'web_username' => 'NAB website username' }.fetch(key) %>
            <div><%= label_tag "pos_credential_#{key}", label, class: 'field-label' %><%= password_field_tag "pos_connection[credential_secret][#{key}]", nil, id: "pos_credential_#{key}", autocomplete: 'new-password', maxlength: { 'api_login_id' => (@provider[:key] == 'authorize_net_reporting' ? 25 : 20), 'transaction_key' => 16 }.fetch(key, 4096), class: 'input', placeholder: @connection.errors.empty? && @connection.credential_values[key].present? ? 'Saved · leave blank to keep' : 'Not saved' %></div>
          <% end %>
        </fieldset>
      <% end %>
      <div class="form-actions">
        <%= form.submit 'Save', class: 'btn-primary' %>
        <%= link_to 'Cancel', pos_connections_path, class: 'btn-ghost' %>
      </div>
    <% end %>
    <% if @connection.credentials_saved? %>
      <section class="section-card">
        <%= section_heading 'Check saved read access' %>
        <% if @provider[:key] == 'swipesimple' %><p class="text-sm text-mocha">Sign in to SwipeSimple and validate fresh transaction and invoice exports without importing them.</p><% elsif @provider[:key] == 'iris_reporting' && @connection.reporting_auth_mode == 'web' %><p class="text-sm text-mocha">Sign in to NAB and verify the current month’s native deposit CSV, merchant identity, rows and totals without importing.</p><% elsif @provider[:key] == 'iris_reporting' %><p class="text-sm text-mocha">Read today’s deposit and batch/transaction reports for every configured merchant. No reports are imported by this check.</p><% elsif @provider[:key] == 'authorize_net_reporting' %><p class="text-sm text-mocha">Check merchant identity, settlement batches, unsettled transactions and an available transaction detail. No payment or merchant setting is changed.</p><% elsif @connection.check_kind == 'authorize_net' %><p class="text-sm text-mocha">The check sends an API authentication test to the selected Authorize.net environment. It does not retrieve transactions, initiate a payment or establish terminal readiness.</p><% elsif @connection.check_kind == 'nmi' %><p class="text-sm text-mocha">The check reads the merchant profile from the selected NMI environment. It does not retrieve transactions, import business records, initiate a payment or operate a terminal.</p><% else %><p class="text-sm text-mocha">The check contacts this provider using the saved credentials and reads its store/location list. It does not import business records or initiate a payment.</p><% end %>
        <div class="flex flex-wrap gap-3"><%= button_to({ 'authorize_net' => 'Check API credentials', 'nmi' => 'Check merchant profile' }.fetch(@connection.check_kind, 'Check read access'), check_access_pos_connection_path(@provider[:key]), method: :post, class: 'btn-primary', data: { turbo: false }) %><%= button_to 'Remove saved credentials', disconnect_pos_connection_path(@provider[:key]), method: :post, class: 'btn-danger', data: { turbo: false } %></div>
      </section>
    <% end %>
  <% else %>
    <section class="section-card"><p class="text-sm text-mocha">An administrator with settings write access can save connection details and check API access.</p></section>
  <% end %>
  <% if @provider[:key] == 'authorize_net_reporting' %><%= render 'reporting' %><% end %>
  <% if @provider[:key] == 'iris_reporting' %><%= render 'iris_reporting' %><% end %>
</div>
