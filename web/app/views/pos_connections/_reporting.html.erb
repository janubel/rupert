<div data-controller="live-report" data-live-report-interval-value="30000">
<%= turbo_frame_tag 'authorize-payment-report', src: (pos_connection_path(@provider[:key], report_date: @report_date) unless turbo_frame_request?) do %>
<section class="section-card">
  <%= section_heading 'Payment reconciliation', hint: 'Payment observations do not create retail sales or change inventory.' do %>
    <%= link_to 'Match payments to sales', authorize_net_sale_links_path, class: 'btn-ghost btn-sm', data: { turbo_frame: '_top' } if Current.user.can?('payroll.read') %>
  <% end %>
  <%= fold_explainer('C-Trax remains the retail inventory reference. Refunds retain their original transaction link; voids retain their source status. Tips and customer surcharges are shown only when returned. Processing fees are unavailable. Currency stays unknown when the gateway enables multiple currencies.', class: 'text-sm text-mocha') %>
  <% if @connection.last_report_status %><p role="status" class="text-sm"><%= @connection.last_report_status %>: <%= @connection.last_report_message %><% if @connection.last_reported_at %> Last completed <%= @connection.last_reported_at.utc.iso8601 %>.<% end %></p><% end %>
  <% if Current.user.can?('settings.write') && @connection.credentials_saved? %>
    <%= form_with url: import_reporting_pos_connection_path(@provider[:key]), method: :post, data: { turbo: false }, class: 'toolbar' do %>
      <div class="toolbar-field"><%= label_tag :from, 'First UTC date (optional)', class: 'field-label' %><%= date_field_tag :from, nil, class: 'input' %></div>
      <div class="toolbar-field"><%= label_tag :to, 'Last UTC date (optional)', class: 'field-label' %><%= date_field_tag :to, nil, class: 'input' %></div>
      <div class="toolbar-actions"><%= submit_tag 'Import reporting data', class: 'btn-primary' %></div>
    <% end %>
    <%= fold_explainer('Defaults to the previous 7 days. Each window must be at most 31 days. Imports run in the job queue; this report refreshes every 30 seconds. Source availability and queue delays still apply. Replays update existing source transactions. An unobserved void or decline that has left the unsettled list may be missing; compare portal exports for a complete historical audit.', class: 'text-xs text-taupe') %>
  <% end %>
  <%= form_with url: pos_connection_path(@provider[:key]), method: :get, data: { turbo: false }, class: 'toolbar' do %>
    <div class="toolbar-field"><%= label_tag :report_date, 'Reporting day (UTC)', class: 'field-label' %><%= date_field_tag :report_date, @report_date, class: 'input' %></div>
    <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-ghost' %></div>
  <% end %>
  <p class="text-sm">Settled amounts for this UTC day, grouped by currency and latest status: <% (@report_totals || {}).each do |(currency, status), total| %><span><%= currency || 'Currency unknown' %> · <%= status %>: <%= total.to_s('F') %>; </span><% end %></p>
  <p class="text-sm">Current statuses of payments submitted this UTC day: <%= (@report_status_counts || {}).to_json %></p>
  <%= fold_explainer("Showing up to 100 of #{@report_transaction_count || 0} transactions submitted or settled this UTC day, and up to 30 batches settled this day. Totals include all imported rows with a known currency for the settlement day; unknown currency amounts are excluded. Void execution timestamps are not provided; status counts use submission day. Amounts are source amounts, not net bank deposits. Refund amounts remain positive and are identified by type/status.", class: 'text-xs text-taupe') %>
  <div class="table-region" role="region" tabindex="0" aria-label="Payments this day"><table class="table"><thead><tr><th scope="col" class="th">Source transaction / original</th><th scope="col" class="th">Submitted UTC</th><th scope="col" class="th">Type / status</th><th scope="col" class="th num">Authorized / settled</th><th scope="col" class="th num">Tip / customer surcharge</th><th scope="col" class="th">Batch / settlement</th></tr></thead><tbody>
    <% if (@report_transactions || []).empty? %><tr><td class="td empty-row" colspan="6">No payments for this day yet. Import reporting data or pick another day.</td></tr><% end %>
    <% (@report_transactions || []).each do |row| %><tr>
      <td class="td"><%= row.source_transaction_id %><br><%= row.reference_transaction_id %></td>
      <td class="td"><%= row.submitted_at.utc.iso8601 %></td><td class="td"><%= row.transaction_type %><br><%= row.payment_status %></td>
      <td class="td num"><%= row.currency || 'Currency unknown' %><br><%= row.authorized_amount.to_s('F') %> / <%= row.settled_amount.to_s('F') %></td>
      <td class="td num"><%= row.tip_amount&.to_s('F') || 'Unknown' %> / <%= row.surcharge_amount&.to_s('F') || 'Unknown' %></td>
      <td class="td"><%= row.source_batch_id %><br><%= row.settlement_state %><br><%= row.settled_at&.utc&.iso8601 %></td>
    </tr><% end %>
  </tbody></table></div>
  <div class="table-region" role="region" tabindex="0" aria-label="Batches settled this day"><table class="table"><thead><tr><th scope="col" class="th">Source batch</th><th scope="col" class="th">Settlement UTC / status</th><th scope="col" class="th">Payment method</th><th scope="col" class="th">Source statistics</th></tr></thead><tbody>
    <% if (@report_batches || []).empty? %><tr><td class="td empty-row" colspan="4">No batches settled this day.</td></tr><% end %>
    <% (@report_batches || []).each do |row| %><tr><td class="td"><%= row.source_batch_id %></td><td class="td"><%= row.settled_at&.utc&.iso8601 %><br><%= row.settlement_state %></td><td class="td"><%= row.payment_method %></td><td class="td"><%= row.statistics.to_json %></td></tr><% end %>
  </tbody></table></div>
</section>
<% end %>
</div>
