<% content_for :title, "Edit #{@family.name}" %>
<div class="page-narrow space-y-6">
  <%= page_header "Edit #{@family.name}", subtitle: 'Sizes are the SKUs you sell (e.g. 3.5g, 7g, 14g, 28g); each is derived as floor(root grams ÷ its grams).' %>

  <div class="card card-pad">
    <%= form_with(model: @family, url: size_family_path(@family), method: :patch, class: 'space-y-4') do |form| %>
      <fieldset class="space-y-4">
        <legend class="card-title">Family</legend>
        <div>
          <%= form.label :name, class: 'field-label' %>
          <%= form.text_field :name, class: 'input', required: true %>
        </div>
        <div>
          <%= form.label :root_sku, 'Root SKU (optional)', class: 'field-label' %>
          <%= form.text_field :root_sku, class: 'input' %>
        </div>
        <div>
          <%= form.label :mode, class: 'field-label' %>
          <%= form.select :mode, options_for_select([['Approval-only', 'approval'], ['Auto-apply', 'auto']], @family.mode), class: 'input' %>
        </div>
      </fieldset>
      <div class="form-actions">
        <%= form.submit 'Save', class: 'btn-primary', name: nil %>
        <%= link_to 'Cancel', size_families_path, class: 'btn-ghost' %>
      </div>
    <% end %>
  </div>

  <section class="section-card">
    <%= section_heading 'Sizes', hint: 'The SKU should match a Square variation SKU so it can be linked and written back.', level: :h3 %>

    <div class="space-y-2">
      <% @family.members.order(:grams).each do |member| %>
        <div class="flex items-center justify-between gap-3 rounded-control bg-haze px-4 py-2.5">
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-mono text-sm text-ink"><%= member.sku %></span>
            <span class="text-xs text-taupe"><%= member.grams %>g</span>
            <% if member.square_variation_id.present? %>
              <span class="pill-fern">Linked</span>
            <% else %>
              <span class="pill-taupe">Unlinked</span>
            <% end %>
          </div>
          <%= button_to 'Remove', remove_member_size_family_path(@family, member_id: member.id), method: :post, class: 'btn-ghost btn-sm', form_class: 'contents' %>
        </div>
      <% end %>
      <% if @family.members.empty? %>
        <p class="text-sm text-taupe">No sizes yet. Add the first size below.</p>
      <% end %>
    </div>

    <%= form_tag add_member_size_family_path(@family), method: :post, class: 'toolbar' do %>
      <div class="toolbar-field">
        <label class="field-label" for="new_sku">SKU</label>
        <input type="text" id="new_sku" name="sku" placeholder="e.g. afghan7" class="input">
      </div>
      <div class="toolbar-field">
        <label class="field-label" for="new_grams">Grams</label>
        <input type="number" step="0.1" min="0.1" id="new_grams" name="grams" placeholder="e.g. 7" class="input">
      </div>
      <div class="toolbar-actions"><%= submit_tag 'Add size', class: 'btn-ghost', name: nil %></div>
    <% end %>
  </section>
</div>
