<% content_for :title, "Edit #{@family.name}" %>
<div class="mx-auto max-w-xl space-y-6">
  <section>
    <h1 class="page-title">Edit <%= @family.name %></h1>
    <p class="mt-1 text-sm text-mocha">Sizes are the SKUs you sell (e.g. 3.5g, 7g, 14g, 28g). Each is derived as floor(root grams ÷ its grams).</p>
  </section>

  <div class="card card-pad">
    <%= form_with(model: @family, url: size_family_path(@family), method: :patch) do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :name, class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
          <%= form.text_field :name, class: "input", required: true %>
        </div>
        <div>
          <%= form.label :root_sku, "Root SKU (optional)", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
          <%= form.text_field :root_sku, class: "input" %>
        </div>
        <div>
          <%= form.label :mode, class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
          <%= form.select :mode, options_for_select([["Approval-only", "approval"], ["Auto-apply", "auto"]], @family.mode), class: "select" %>
        </div>
        <div>
          <%= form.submit "Save family", class: "btn-primary" %>
          <%= link_to "Cancel", size_families_path, class: "btn-ghost" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="card card-pad">
    <h2 class="font-display text-lg text-ink">Sizes</h2>
    <p class="mt-1 text-xs text-taupe">The SKU should match a Square variation SKU so it can be linked and written back.</p>

    <div class="mt-3 space-y-2">
      <% @family.members.order(:grams).each do |member| %>
        <div class="flex items-center justify-between rounded-xl bg-haze px-4 py-2.5">
          <div class="flex items-center gap-3">
            <span class="font-mono text-sm text-ink"><%= member.sku %></span>
            <span class="text-xs text-taupe"><%= member.grams %>g</span>
            <% if member.square_variation_id.present? %>
              <span class="pill-fern">linked</span>
            <% else %>
              <span class="pill-taupe">unlinked</span>
            <% end %>
          </div>
          <%= button_to "Remove", remove_member_size_family_path(@family, member_id: member.id), method: :post, class: "text-xs font-semibold text-rose hover:underline" %>
        </div>
      <% end %>
      <% if @family.members.empty? %>
        <p class="rounded-xl bg-haze px-4 py-2.5 text-sm text-taupe">No sizes yet.</p>
      <% end %>
    </div>

    <%= form_tag add_member_size_family_path(@family), method: :post, class: "mt-3 flex items-end gap-2" do %>
      <div class="flex-1">
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="new_sku">SKU</label>
        <input type="text" id="new_sku" name="sku" placeholder="e.g. afghan7" class="input">
      </div>
      <div class="w-32">
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="new_grams">Grams</label>
        <input type="number" step="0.1" min="0.1" id="new_grams" name="grams" placeholder="e.g. 7" class="input">
      </div>
      <%= submit_tag "Add size", class: "btn-primary btn-sm" %>
    <% end %>
  </div>
</div>
