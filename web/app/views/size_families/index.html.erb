<% content_for :title, 'Sizes' %>
<% can_manage = Current.user.can?('settings.write') %>
<% can_apply = Current.user.can?('reconcile.write') %>
<% total_pending = @pending_changes.length %>
<% total_root = @families.sum { |f| f[:root] || 0 } %>
<% auto_count = @families.count { |f| f[:family].auto? } %>
<% menu = [] %>
<% menu << ['Derive all now', derive_all_size_families_path, { method: :post, data: { turbo_submits_with: 'Deriving…' } }] if can_apply %>
<% menu << ['Approve all pending', approve_all_size_families_path, { method: :post, data: { turbo_confirm: 'Write every pending size to Square?' } }] if can_apply && total_pending.positive? %>

<div class="space-y-6">
  <%= page_header 'Sizes', subtitle: 'Multi-size gram products derived from a root gram bank.', menu: menu do %>
    <% if can_manage %>
      <%= link_to 'Add family', new_size_family_path, class: 'btn-primary' %>
    <% end %>
  <% end %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="stat">
      <p class="stat-label">Families</p>
      <p class="stat-value mt-1"><%= @families.length %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Pending approvals</p>
      <p class="stat-value mt-1 <%= total_pending.positive? ? 'text-clay' : '' %>"><%= total_pending %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Root grams tracked</p>
      <p class="stat-value-sm mt-1"><%= number_with_precision(total_root, precision: 0) %>g</p>
    </div>
    <div class="stat">
      <p class="stat-label">Auto-apply</p>
      <p class="stat-value mt-1"><%= auto_count %></p>
    </div>
  </section>

  <% if @families.empty? %>
    <%= empty_state 'No size families yet', hint: (can_manage ? 'Add one to start deriving your multi-size products.' : 'A settings editor can add the first family.') do %>
      <% if can_manage %><%= link_to 'Add family', new_size_family_path, class: 'btn-primary' %><% end %>
    <% end %>
  <% end %>

  <% @families.each do |row| %>
    <% family = row[:family] %>
    <section class="section-card">
      <%= section_heading family.name, hint: "Root SKU #{family.root_sku.presence || 'manual'} · #{family.auto? ? 'auto-apply' : 'approval-only'}#{row[:last_derived] ? " · derived #{time_ago_in_words(row[:last_derived])} ago" : ''}" do %>
        <span class="<%= family.auto? ? 'pill-fern' : 'pill-taupe' %>"><%= family.auto? ? 'Auto' : 'Approval' %></span>
        <% if can_apply %>
          <%= button_to 'Derive now', derive_size_family_path(family), method: :post, class: 'btn-ghost btn-sm', form_class: 'contents', data: { turbo_submits_with: 'Deriving…' } %>
          <% if row[:pending_count].positive? %>
            <%= button_to "Approve all (#{row[:pending_count]})", approve_all_size_family_path(family), method: :post, class: 'btn-ghost btn-sm', form_class: 'contents', data: { turbo_confirm: "Write all pending sizes for #{family.name} to Square?" } %>
          <% end %>
        <% end %>
        <% if can_manage %>
          <%= link_to 'Edit', edit_size_family_path(family), class: 'btn-ghost btn-sm' %>
        <% end %>
      <% end %>

      <div class="grid gap-4 lg:grid-cols-3">
        <div class="stat">
          <p class="stat-label">Root gram bank</p>
          <p class="stat-value mt-1"><%= row[:root] ? number_with_precision(row[:root], precision: 1) : '—' %><span class="text-base text-taupe"> g</span></p>
          <p class="mt-1 text-xs text-taupe">
            <% if family.sales_watermark %>
              Sales fold in from <%= l(family.sales_watermark, format: :short) %>.
            <% else %>
              Set root grams to start tracking.
            <% end %>
          </p>
          <% if can_manage %>
            <%= form_tag set_root_size_family_path(family), method: :post, class: 'mt-3 flex items-end gap-2' do %>
              <div class="min-w-0 flex-1">
                <label class="field-label" for="base_grams_<%= family.id %>">Override root grams</label>
                <input type="number" step="0.1" min="0" id="base_grams_<%= family.id %>" name="base_grams" placeholder="e.g. 420" class="input">
              </div>
              <%= submit_tag 'Save', class: 'btn-ghost btn-sm', name: nil %>
            <% end %>
          <% end %>
        </div>

        <div class="lg:col-span-2">
          <h3 class="card-title">Derived sizes</h3>
          <% if row[:members].empty? %>
            <p class="mt-1 text-sm text-taupe">No sizes yet. Add them on the Edit screen.</p>
          <% else %>
            <div class="table-region mt-2" role="region" tabindex="0" aria-label="Derived sizes for <%= family.name %>">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col" class="th">Size</th>
                    <th scope="col" class="th">SKU</th>
                    <th scope="col" class="th num">Current</th>
                    <th scope="col" class="th num">Target</th>
                    <th scope="col" class="th"><span class="sr-only">Status</span></th>
                  </tr>
                </thead>
                <tbody>
                  <% row[:members].each do |m| %>
                    <tr>
                      <td class="td font-medium text-ink"><%= m[:member].grams %>g</td>
                      <td class="td font-mono text-xs text-mocha"><%= m[:member].sku %></td>
                      <td class="td num text-mocha"><%= m[:current].nil? ? '—' : m[:current] %></td>
                      <td class="td num font-semibold text-olive"><%= m[:target].nil? ? '—' : m[:target] %></td>
                      <td class="td text-right">
                        <% if m[:pending] %>
                          <% if can_apply %>
                            <%= button_to 'Approve', approve_size_family_path(family, change_id: m[:pending].id), method: :post, class: 'btn-ghost btn-sm', form_class: 'contents', data: { turbo_confirm: "Write #{m[:member].sku} to #{m[:pending].target_quantity} on Square?" } %>
                          <% else %>
                            <span class="pill-rose">Pending</span>
                          <% end %>
                        <% elsif m[:in_sync] %>
                          <span class="pill-fern">In sync</span>
                        <% else %>
                          <span class="pill-taupe">Derives on sync</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section class="card overflow-hidden">
    <div class="card-pad pb-3">
      <%= section_heading 'Pending approvals', hint: 'Derived quantities awaiting sign-off before they are written to Square.' %>
    </div>
    <div class="table-region" role="region" tabindex="0" aria-label="Pending size approvals">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Family</th>
            <th scope="col" class="th">Size</th>
            <th scope="col" class="th">SKU</th>
            <th scope="col" class="th num">Root grams</th>
            <th scope="col" class="th num">Current</th>
            <th scope="col" class="th num">Target</th>
            <th scope="col" class="th num">Change</th>
            <th scope="col" class="th"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @pending_changes.empty? %>
            <tr>
              <td class="empty-row" colspan="8">Nothing pending. Sizes are in sync with their root gram banks.</td>
            </tr>
          <% end %>
          <% @pending_changes.each do |change| %>
            <% current = change.square_variation_id ? InventoryLevel.total_for_variation(change.square_variation_id) : nil %>
            <% delta = current && change.target_quantity ? change.target_quantity - current : nil %>
            <tr>
              <td class="td text-mocha"><%= change.family.name %></td>
              <td class="td text-ink"><%= change.grams %>g</td>
              <td class="td font-mono text-xs text-mocha"><%= change.sku %></td>
              <td class="td num text-mocha"><%= number_with_precision(change.root_grams, precision: 1) %></td>
              <td class="td num text-mocha"><%= current.nil? ? '—' : current %></td>
              <td class="td num font-semibold text-olive"><%= change.target_quantity %></td>
              <td class="td num">
                <% if delta.nil? %>
                  <span class="text-taupe">—</span>
                <% elsif delta.positive? %>
                  <span class="pill-fern">+<%= delta %></span>
                <% elsif delta.negative? %>
                  <span class="pill-clay"><%= delta %></span>
                <% else %>
                  <span class="text-taupe">—</span>
                <% end %>
              </td>
              <td class="td text-right">
                <% if can_apply %>
                  <%= button_to 'Approve', approve_size_family_path(change.family, change_id: change.id), method: :post, class: 'btn-ghost btn-sm', form_class: 'contents', data: { turbo_confirm: "Write #{change.sku} to #{change.target_quantity} on Square?" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <%= fold_explainer('Every 15-minute sync folds in new sales and recomputes each size as floor(root grams ÷ size grams), then writes to Square instead of trusting realtime counts. Approval-only families record derived sizes as pending and write them to Square on approval; auto-apply families write them every sync.', class: 'text-sm text-mocha') %>
</div>
