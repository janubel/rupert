<% content_for :title, 'Ask Rupert usage' %>
<% can_edit = Current.user.can?('settings.write') %>
<div class="space-y-6">
  <section>
    <h1 class="page-title">Ask Rupert usage</h1>
    <p class="mt-1 max-w-3xl text-sm text-mocha">Ask Rupert is the help chat behind the chat-bubble button in the header. Who can use it is the <strong>Rupert Chat</strong> permission on the <%= link_to 'Permissions', permissions_path, class: 'underline' %> screen: administrators by default, and you can give it to other roles or people. These are counts only: who asked how often and how many tokens it used, never what anyone asked. Limits are light on purpose. Nobody is locked out; a person who goes over is asked to wait a little.</p>
  </section>

  <section class="grid grid-cols-2 gap-3 sm:grid-cols-5" aria-label="Last seven days">
    <div class="stat"><p class="stat-label">Questions, 7 days</p><p class="stat-value mt-1"><%= @totals[:questions] %></p></div>
    <div class="stat"><p class="stat-label">Asked to wait</p><p class="stat-value mt-1"><%= @totals[:limited] %></p></div>
    <div class="stat"><p class="stat-label">Failed replies</p><p class="stat-value mt-1 <%= 'text-rose' if @totals[:failed].positive? %>"><%= @totals[:failed] %></p></div>
    <div class="stat"><p class="stat-label">Tokens used</p><p class="stat-value mt-1"><%= number_with_delimiter(@totals[:tokens]) %></p></div>
    <div class="stat"><p class="stat-label">Lookups run</p><p class="stat-value mt-1"><%= @totals[:tool_calls] %></p></div>
  </section>

  <section class="card p-5">
    <h2 class="font-display text-lg">Limits and settings</h2>
    <%= form_with url: ask_rupert_usage_path, method: :patch, scope: :ask_rupert, class: 'mt-3 grid gap-4 sm:grid-cols-2' do |form| %>
      <fieldset <%= 'disabled' unless can_edit %> class="contents">
        <div class="sm:col-span-2 flex items-center gap-3">
          <%= hidden_field_tag 'ask_rupert[enabled]', '0', id: nil %>
          <%= check_box_tag 'ask_rupert[enabled]', '1', @config.enabled?, id: 'ask_rupert_enabled', class: 'h-5 w-5' %>
          <%= label_tag 'ask_rupert_enabled', 'Ask Rupert is on for this workspace', class: 'text-sm font-semibold text-ink' %>
        </div>
        <div class="sm:col-span-2">
          <%= label_tag 'ask_rupert_provider_mode', 'Which model answers', class: 'field-label' %>
          <%= select_tag 'ask_rupert[provider_mode]', options_for_select(AskRupert::Config::MODES.map { |key, label| [label, key] }, @config.mode), id: 'ask_rupert_provider_mode', class: 'select' %>
          <p class="mt-1 text-xs text-taupe">
            Cloud: <%= AskRupert::Providers::Opencode.new.model %> through OpenCode. Local: <%= @config.local_configured? ? "#{@config.local_model} (Ollama on this network)" : 'not set up on this server (set OLLAMA_URL and ASK_RUPERT_LOCAL_MODEL)' %>.
            The panel tells everyone which one is in use.
          </p>
        </div>
        <% [['rate_limit_count', 'Questions allowed per window', 'default 20'], ['rate_limit_window_minutes', 'Window (minutes)', 'default 10'], ['daily_cap', 'Daily cap per person', 'default 200'],
            ['max_message_chars', 'Longest question (characters)', ''], ['context_messages', 'Earlier turns the assistant sees', ''], ['context_chars', 'Most earlier text the assistant sees (characters)', ''],
            ['retention_days', 'Delete chats after (days)', '0 keeps chats until their owner clears them (default)']].each do |key, label, hint| %>
          <div>
            <%= label_tag "ask_rupert_#{key}", label, class: 'field-label' %>
            <%= number_field_tag "ask_rupert[#{key}]", @config[key], id: "ask_rupert_#{key}", class: 'input', min: AskRupert::Config::BOUNDS[key].begin, max: AskRupert::Config::BOUNDS[key].end %>
            <% if hint.present? %><p class="mt-1 text-xs text-taupe"><%= hint %></p><% end %>
          </div>
        <% end %>
        <div class="sm:col-span-2 flex items-center gap-3">
          <% if can_edit %><%= submit_tag 'Save settings', class: 'btn-primary' %><% else %><p class="text-sm text-taupe">You can view these settings. Changing them needs settings-write access.</p><% end %>
        </div>
      </fieldset>
    <% end %>
  </section>

  <section class="card overflow-hidden">
    <h2 class="px-5 pt-5 font-display text-lg">By person, last 7 days</h2>
    <% if @people.empty? %>
      <p class="px-5 pb-5 pt-2 text-sm text-mocha">Nobody has asked yet.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="operations-table w-full text-sm">
          <thead class="border-b border-fog bg-haze/60"><tr>
            <th scope="col" class="th">Person</th><th scope="col" class="th">Last 24 hours</th><th scope="col" class="th">7 days</th><th scope="col" class="th">Tokens</th><th scope="col" class="th">Asked to wait</th><th scope="col" class="th">Last asked</th>
          </tr></thead>
          <tbody class="divide-y divide-fog">
            <% @people.each do |row| %>
              <tr><th scope="row" class="td text-left font-medium"><%= row[:name] %></th><td class="td"><%= row[:day] %></td><td class="td"><%= row[:week] %></td><td class="td"><%= number_with_delimiter(row[:tokens]) %></td><td class="td"><%= row[:limited] %></td><td class="td"><%= row[:last] ? l(row[:last], format: :short) : '—' %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <% if @by_provider.any? %>
      <p class="px-5 py-3 text-xs text-taupe">By model: <%= @by_provider.map { |provider, model, count, tokens| "#{provider || 'none'}#{" / #{model}" if model} — #{count} questions, #{number_with_delimiter(tokens.to_i)} tokens" }.join(' · ') %></p>
    <% end %>
    <p class="px-5 pb-4 text-xs text-taupe"><%= pluralize(@conversations, 'chat') %> stored right now. People can delete their own with Clear. <%= @config['retention_days'].zero? ? 'Chats are otherwise saved.' : "The rest are removed after #{@config['retention_days']} days." %> Every lookup the assistant runs is recorded in <%= link_to 'Activity', activity_path, class: 'underline' %> by tool name and time only.</p>
  </section>
</div>
