<% code = flash[:buzz_link_code] %>
<section id="buzz-link" class="section-card scroll-mt-24" aria-label="Link your Buzz account">
  <%= section_heading 'Link your Buzz account', hint: "Link your Buzz account to your Rupert account and #{BuzzAgentPrompt::HANDLE} can answer you in Buzz as you." %>
  <%= fold_explainer('It answers in a direct message or when you mention it in another channel. In Buzz it only says where things are and how to do them; it never shows records or figures. Anything you write to it stays in Buzz, which Rupert cannot clear.', class: 'text-sm text-mocha') %>

  <% @links.each do |link| %>
    <div class="rounded-card border border-fog bg-paper p-4">
      <% if link.pending? %>
        <p class="font-semibold text-ink">Confirm this is your Buzz account</p>
        <p class="mt-1 text-sm text-mocha">A Buzz account sent your code. Check that this matches the public key in your own Buzz app (Profile). If you don't recognise it, decline.</p>
        <code class="mt-2 block break-all rounded-control border border-fog bg-haze px-3 py-2 font-mono text-xs text-ink" aria-label="Public key waiting to be linked"><%= link.npub || link.pubkey %></code>
        <div class="mt-3 flex flex-wrap gap-3">
          <%= button_to 'Yes, link it', confirm_buzz_link_path(link), method: :post, class: 'btn-primary btn-sm' %>
          <%= button_to 'Decline', remove_buzz_link_path(link), method: :delete, class: 'btn-ghost btn-sm' %>
        </div>
      <% else %>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="font-semibold text-ink"><span class="pill-olive">Linked</span> <span class="ml-1 font-mono text-xs"><%= link.fingerprint %>…</span></p>
            <p class="mt-1 text-xs text-taupe">Since <%= l(link.linked_at.to_date, format: :long) if link.linked_at %><%= ", last used #{time_ago_in_words(link.last_used_at)} ago" if link.last_used_at %>.</p>
          </div>
          <%= button_to 'Remove link', remove_buzz_link_path(link), method: :delete, class: 'btn-ghost btn-sm', form: { data: { turbo_confirm: 'Remove this link? The agent will stop answering you as yourself.' } } %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if code %>
    <div class="rounded-card border border-fog bg-paper p-4" role="status">
      <p class="font-semibold text-ink">Your code (valid for <%= BuzzIdentity::CODE_TTL.in_minutes.to_i %> minutes)</p>
      <div class="mt-2 flex items-center gap-2" data-controller="copy">
        <code data-copy-target="source" class="min-w-0 flex-1 rounded-control border border-fog bg-haze px-3 py-2 font-mono text-lg tracking-widest text-ink"><%= code %></code>
        <button type="button" class="btn-ghost btn-sm shrink-0" data-action="copy#copy" aria-label="Copy the code">Copy</button>
        <span hidden data-copy-target="status" role="status" class="text-xs text-olive-deep">Copied</span>
      </div>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-mocha">
        <li>In Buzz, open a <strong>direct message</strong> with <%= BuzzAgentPrompt::HANDLE %>.</li>
        <li>Send: <code class="font-mono">link <%= code %></code></li>
        <li>Come back here and confirm. Never post the code in a channel; anyone reading it could try to use it.</li>
      </ol>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <%= button_to (code || @open_code ? 'Make a new code' : 'Link my Buzz account'), buzz_link_path, method: :post, class: 'btn-primary btn-sm' %>
    <% if @open_code && !code %><p class="text-xs text-taupe">You have a code that has not been used yet. A new one replaces it.</p><% end %>
  </div>
</section>
