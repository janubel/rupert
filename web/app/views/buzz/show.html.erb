<%# The Buzz card: a Detail-style page for the agent and how to connect (docs/ui-standards.md §4). %>
<% content_for :title, 'Buzz' %>
<% relay = BuzzConnect.relay_url %>
<% channel = BuzzConnect.channel_id %>
<% npub = BuzzConnect.agent_npub %>
<% chat_url = BuzzConnect.chat_url %>
<% connect_url = BuzzConnect.connect_url %>
<div class="page-medium space-y-6">
  <%= page_header "#{BuzzAgentPrompt::NAME} #{BuzzAgentPrompt::HANDLE}", eyebrow: 'Team chat · Buzz', subtitle: BuzzAgentPrompt.about do %>
    <%= link_to '#get-buzz', class: 'btn-ghost inline-flex items-center gap-2', aria: { label: 'Get the Buzz app' } do %><%= navigation_icon('download') %><span>Get Buzz</span><% end %>
    <% if chat_url %>
      <%= link_to chat_url, class: 'btn-primary inline-flex items-center gap-2', aria: { label: (@state == :ready ? 'Open the team chat in Buzz' : 'Add the workspace in Buzz') } do %><%= navigation_icon('chat') %><span><%= @state == :ready ? 'Open chat' : 'Add workspace' %></span><% end %>
    <% else %>
      <span class="btn-primary inline-flex items-center gap-2" role="link" aria-disabled="true" aria-describedby="buzz-state-note"><%= navigation_icon('chat') %><span>Open chat</span></span>
    <% end %>
  <% end %>
  <%= render 'buzz/tabs', current: :card %>

  <section class="section-card" aria-label="Agent profile">
    <div class="flex flex-wrap items-start gap-4">
      <span class="grid h-16 w-16 shrink-0 place-items-center overflow-hidden rounded-pill bg-haze"><%= render 'shared/rupert_face', size: 56 %></span>
      <div class="min-w-0 flex-1 space-y-3">
        <p class="text-sm text-mocha"><span class="pill-olive">AI agent</span></p>
        <% if npub %>
          <div class="flex items-center gap-2" data-controller="copy">
            <code data-copy-target="source" class="min-w-0 flex-1 break-all rounded-control border border-fog bg-haze px-3 py-2 font-mono text-xs text-ink" aria-label="Agent public key"><%= npub %></code>
            <button type="button" class="btn-ghost btn-sm shrink-0" data-action="copy#copy" aria-label="Copy the agent's public key">Copy</button>
            <span hidden data-copy-target="status" role="status" class="text-xs text-olive-deep">Copied</span>
          </div>
        <% else %>
          <p class="text-sm text-mocha">The agent has no identity yet<%= ". An administrator can create one in Settings." if @can_configure %></p>
        <% end %>
        <% if chat_url %>
          <p class="text-xs text-taupe">Open chat opens the Buzz app on this device. If nothing happens, install it first (Get Buzz), then try again.</p>
        <% end %>
      </div>
    </div>
  </section>

  <% unless @state == :ready %>
    <section class="section-card" id="buzz-state-note" role="status">
      <%= section_heading(@state == :unconfigured ? 'Buzz is not set up yet' : 'No channel chosen yet') %>
      <p class="text-sm text-mocha">
        <% if @state == :unconfigured %>
          Rupert has no Buzz relay address, so there is nothing to connect to. You can still install the app below.
        <% else %>
          The relay is set but no channel is. You can add the workspace in Buzz; the Open chat button appears once a channel is chosen.
        <% end %>
        <% if @can_configure %>
          Set it in <%= link_to 'Settings → Buzz agent', settings_path(anchor: 'buzz'), class: 'underline' %>.
        <% else %>
          Ask an administrator to set it up in Settings.
        <% end %>
      </p>
    </section>
  <% end %>

  <% if relay %>
    <section class="section-card" aria-label="Connect your own device">
      <%= section_heading 'Connect your own device', hint: 'Everyone uses their own Buzz identity in their own app. Rupert shows only the public details below and never your key.' %>
      <div class="grid gap-5 sm:grid-cols-[1fr_auto]">
        <div class="space-y-4">
          <div data-controller="copy">
            <p class="field-label" id="buzz-relay-label">Relay address</p>
            <div class="flex items-center gap-2">
              <code data-copy-target="source" aria-labelledby="buzz-relay-label" class="min-w-0 flex-1 break-all rounded-control border border-fog bg-haze px-3 py-2 font-mono text-xs text-ink"><%= relay %></code>
              <button type="button" class="btn-ghost btn-sm shrink-0" data-action="copy#copy" aria-label="Copy the relay address">Copy</button>
              <span hidden data-copy-target="status" role="status" class="text-xs text-olive-deep">Copied</span>
            </div>
          </div>
          <% if channel %>
            <div data-controller="copy">
              <p class="field-label" id="buzz-channel-label">Channel</p>
              <div class="flex items-center gap-2">
                <code data-copy-target="source" aria-labelledby="buzz-channel-label" class="min-w-0 flex-1 break-all rounded-control border border-fog bg-haze px-3 py-2 font-mono text-xs text-ink"><%= channel %></code>
                <button type="button" class="btn-ghost btn-sm shrink-0" data-action="copy#copy" aria-label="Copy the channel id">Copy</button>
                <span hidden data-copy-target="status" role="status" class="text-xs text-olive-deep">Copied</span>
              </div>
              <% unless BuzzConnect.channel_looks_valid? %>
                <p class="mt-1 text-xs text-clay">This does not look like a Buzz channel id (they are UUIDs). Check it in Settings.</p>
              <% end %>
            </div>
          <% end %>
          <ol class="list-decimal space-y-1 pl-5 text-sm text-mocha">
            <li>Install Buzz (see <a class="underline" href="#get-buzz">Get Buzz</a>).</li>
            <li>Add the workspace: press Open chat, scan the code, or paste the relay address into Buzz when it asks for a community.</li>
            <li>Sign in with your own Buzz identity. Never paste a private key (a code starting nsec1) into Rupert or into the chat.</li>
            <li>If the channel is private, ask an administrator to add you.</li>
          </ol>
        </div>
        <% if connect_url %>
          <div class="mx-auto w-44 sm:mx-0" data-controller="qr" data-qr-text-value="<%= connect_url %>" data-qr-label-value="QR code that adds the <%= BuzzConnect.workspace_name %> Buzz workspace">
            <div data-qr-target="canvas" class="aspect-square w-full overflow-hidden rounded-card border border-fog bg-white [&_svg]:h-full [&_svg]:w-full"></div>
            <p class="mt-2 text-center text-xs text-taupe">Scan with your phone to add the workspace in Buzz.</p>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render 'buzz/link' if @can_link %>

  <section id="get-buzz" class="section-card scroll-mt-24" aria-label="Get Buzz">
    <%= section_heading 'Get Buzz', hint: 'Buzz is the open-source team chat Rupert’s agent lives in. Install it on each device you want to use.' %>
    <ul class="grid gap-3 sm:grid-cols-2">
      <% @platforms.each do |platform| %>
        <li class="flex flex-col justify-between gap-3 rounded-card border border-fog bg-paper p-4">
          <div>
            <p class="font-semibold text-ink"><%= platform.label %></p>
            <p class="mt-1 text-xs text-mocha"><%= platform.note %></p>
          </div>
          <% if platform.available? %>
            <%= link_to platform.url, class: 'btn-ghost btn-sm inline-flex items-center gap-2 self-start', target: '_blank', rel: 'noopener noreferrer', aria: { label: "Download Buzz for #{platform.label} (opens in a new tab)" } do %><%= navigation_icon('download') %><span>Download</span><% end %>
          <% else %>
            <p class="text-xs font-medium text-taupe">Not available yet</p>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="text-xs text-taupe">Download links come from the Buzz project and can be changed in Settings<%= " (Environment card)" if @can_configure %>.</p>
  </section>
</div>
