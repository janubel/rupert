<% content_for :title, 'POS' %>
<% if turbo_frame_request? %>
  <%= render 'catalog' if @snapshot %>
<% else %>
<% image_links = retail_business_access?('inventory.write') %>
<% image_options = image_links ? @images.products.sort_by(&:title).map { |p| [p.title, p.id] } : [] %>
<% stock_fresh = @snapshot.present? && @snapshot.captured_at >= 60.minutes.ago %>
<% if @snapshot %>
<div class="pos-app" data-controller="pos-cart pos-screen<%= ' pos-display' if @display %>" data-action="<%= 'pos-cart:changing->pos-display#pending pos-cart:checked->pos-display#checked' if @display %>" data-pos-cart-cart-key-value="<%= @cart_key %>" data-pos-cart-initial-quote-value="<%= (@quote || {}).to_json %>" data-pos-screen-stock-fresh-value="<%= stock_fresh %>" <% if @display %>data-pos-cart-clear-url-value="<%= clear_pos_display_path(@display) %>" data-pos-display-status-url-value="<%= pos_display_path(@display) %>"<% end %>>
<% else %>
<div class="pos-app">
<% end %>
  <%= render 'topbar', stock_fresh: stock_fresh, image_links: image_links %>
  <% if notice || alert || (@snapshot && !stock_fresh) %>
    <div class="pos-flashes">
      <% if notice %><p role="status" class="flash flash-notice"><%= notice %></p><% end %>
      <% if alert %><p role="alert" class="flash flash-alert"><%= alert %></p><% end %>
      <% if @snapshot && !stock_fresh %><p role="alert" class="flash flash-alert">A new stock read is required before items can be added. <%= retail_business_access?('settings.read') ? 'Refresh the C-Trax connection before continuing.' : 'Ask a manager to refresh the C-Trax stock read.' %></p><% end %>
    </div>
  <% end %>
  <% if @snapshot %>
    <main id="main" class="pos-main" tabindex="-1">
      <section id="retail-catalog" class="pos-catalog-pane" aria-label="Products">
        <%= form_tag ctrax_pos_path, method: :get, class: 'pos-search', role: 'search', data: { turbo_frame: 'pos_catalog', busy: false, pos_screen_target: 'searchForm', tour: 'search' } do %>
          <%= hidden_field_tag :location_id, @snapshot.location_id, id: 'pos_search_location' %>
          <%= hidden_field_tag :display_id, @display.id, id: 'pos_search_display' if @display %>
          <%= hidden_field_tag :category, @category, id: 'pos_search_category', data: { pos_screen_target: 'category' } %>
          <%= label_tag :pos_q, 'Search products', class: 'sr-only' %>
          <span class="pos-search-icon" aria-hidden="true"><%= navigation_icon('search') %></span>
          <%= search_field_tag :q, @query, id: 'pos_q', class: 'pos-search-input', placeholder: 'Search or scan: name, SKU or barcode', autocomplete: 'off', autocorrect: 'off', autocapitalize: 'off', spellcheck: false, autofocus: true, enterkeyhint: 'search', data: { pos_screen_target: 'search', action: 'input->pos-screen#typed keydown->pos-screen#searchKeydown' } %>
          <kbd class="pos-search-key" title="Press / to search">/</kbd>
          <noscript><%= submit_tag 'Apply', class: 'btn-ghost' %></noscript>
        <% end %>
        <p class="pos-announce" role="status" aria-live="polite" data-pos-screen-target="announce"></p>
        <%= render 'catalog' %>
      </section>
      <%= render 'cart' %>
    </main>
    <a href="#retail-cart" class="btn-primary pos-cart-jump">Cart · <span data-pos-cart-target="count" aria-live="polite">0</span> items</a>

    <dialog id="pos-item-dialog" class="pos-sheet" aria-labelledby="pos-item-title" data-pos-screen-target="itemDialog" data-action="close->pos-screen#itemClosed click->pos-screen#backdropClose">
      <div class="pos-sheet-body">
        <div class="pos-sheet-media"><img alt="" referrerpolicy="no-referrer" data-pos-screen-target="itemImage"></div>
        <div class="pos-sheet-info">
          <p class="pos-sheet-category" data-pos-screen-target="itemCategory"></p>
          <h2 id="pos-item-title" class="pos-sheet-title" data-pos-screen-target="itemTitle">Product</h2>
          <p class="pos-sheet-variant" data-pos-screen-target="itemVariant"></p>
          <p class="pos-sheet-price retail-money" data-pos-screen-target="itemPrice"></p>
          <p class="pos-sheet-stock"><span data-pos-screen-target="itemStock"></span> <span data-pos-screen-target="itemStockDetail"></span></p>
          <p class="pos-sheet-codes" data-pos-screen-target="itemCodes"></p>
          <div class="pos-variants" role="group" aria-label="Sizes" data-pos-screen-target="itemVariants" hidden></div>
          <p class="pos-sheet-note" data-pos-screen-target="itemNote" hidden></p>
          <%= form_tag quote_ctrax_pos_path(@snapshot.location_id, display_id: @display&.id), method: :post, class: 'pos-sheet-form', data: { action: 'submit->pos-cart#add submit->pos-screen#added', turbo: false, busy: false } do %>
            <%= hidden_field_tag 'items[0][variant_id]', '', id: 'pos_item_variant', data: { pos_screen_target: 'itemId' } %>
            <div class="pos-stepper" role="group" aria-label="Quantity">
              <button type="button" class="pos-step" data-action="pos-screen#stepQuantity" data-delta="-1" aria-label="One fewer">−</button>
              <%= number_field_tag 'items[0][quantity]', 1, id: 'pos_item_quantity', min: 1, max: 999, step: 1, required: true, inputmode: 'numeric', class: 'pos-step-input', aria: { label: 'Quantity' }, data: { pos_screen_target: 'itemQuantity' } %>
              <button type="button" class="pos-step" data-action="pos-screen#stepQuantity" data-delta="1" aria-label="One more">+</button>
            </div>
            <div class="pos-sheet-actions">
              <button type="button" class="btn-ghost btn-lg" data-action="pos-screen#closeItem" data-pos-screen-target="itemCancel">Cancel</button>
              <%= button_tag 'Add to cart', type: 'submit', class: 'btn-primary btn-lg pos-add', disabled: !stock_fresh, data: { pos_screen_target: 'itemAdd' } %>
            </div>
          <% end %>
          <% if image_links %>
            <details class="explainer pos-sheet-imagelink">
              <summary class="explainer-summary">Website image link</summary>
              <%= form_tag ctrax_pos_images_path(@snapshot.location_id), method: :post, class: 'mt-2 space-y-2', data: { pos_screen_target: 'imageForm', turbo: false } do %>
                <%= select_tag :product_id, options_for_select(image_options), id: 'pos_image_product', include_blank: 'Select website product', required: true, class: 'select w-full', aria: { label: 'Website product image' }, data: { pos_screen_target: 'imageProduct' } %>
                <%= submit_tag 'Link image', class: 'btn-ghost btn-sm' %>
              <% end %>
            </details>
          <% end %>
        </div>
      </div>
    </dialog>

    <% if image_links && @missing_image_records.any? %>
      <dialog id="pos-images-dialog" class="pos-sheet pos-sheet-narrow" aria-labelledby="pos-images-title" data-pos-screen-target="imagesDialog" data-action="close->pos-screen#itemClosed click->pos-screen#backdropClose">
        <div class="pos-sheet-pad">
          <h2 id="pos-images-title" class="pos-sheet-title">Link website images</h2>
          <p class="text-sm text-mocha"><%= pluralize(@missing_image_records.size, 'product') %> hidden without a website image. Choose the matching website product; its image makes the variant visible here. Source stock and SKU do not change.</p>
          <%= form_tag ctrax_pos_images_path(@snapshot.location_id), method: :post, class: 'space-y-3', data: { turbo: false } do %>
            <div><%= label_tag :missing_image_variant, 'C-Trax variant', class: 'field-label' %><%= select_tag :variant_id, options_for_select(@missing_image_records.sort_by { |r| r['name'].to_s }.map { |r| [r['name'], r['id']] }), id: 'missing_image_variant', include_blank: 'Choose hidden product', required: true, class: 'select w-full' %></div>
            <div><%= label_tag :missing_image_product, 'Website product image', class: 'field-label' %><%= select_tag :product_id, options_for_select(image_options), id: 'missing_image_product', include_blank: 'Choose website product', required: true, class: 'select w-full' %></div>
            <div class="pos-sheet-actions"><button type="button" class="btn-ghost" data-action="pos-screen#closeImages">Cancel</button><%= submit_tag 'Link image', class: 'btn-primary' %></div>
          <% end %>
        </div>
      </dialog>
    <% end %>
  <% else %>
    <main id="main" class="pos-main pos-main-empty" tabindex="-1">
      <section class="card pos-empty">
        <%= empty_state 'Connect the retail catalog', hint: 'A successful C-Trax stock read supplies this cashier view.' do %>
          <% if retail_business_access?('settings.read') %><%= link_to 'Open C-Trax connection', pos_connection_path('ctrax'), class: 'btn-primary' %><% else %><p class="text-sm text-mocha">Ask an administrator to connect the retail catalog.</p><% end %>
        <% end %>
      </section>
    </main>
  <% end %>
</div>
<% end %>
