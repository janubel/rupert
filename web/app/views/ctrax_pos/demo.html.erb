<div class="space-y-4" data-action="pos-cart:changing->pos-display#pending pos-cart:checked->pos-display#checked" data-controller="pos-cart pos-display" data-pos-cart-cart-key-value="<%= @cart_key %>" data-pos-cart-initial-quote-value="<%= (@quote || {}).to_json %>" data-pos-cart-clear-url-value="<%= clear_pos_display_path(@display) %>" data-pos-display-status-url-value="<%= pos_display_path(@display) %>">
  <header><h1 class="font-display text-2xl">Cashier cart</h1><p class="mt-2 text-sm text-mocha">Demonstration · full checkout flow · simulated payment</p></header>
  <%= render 'cart' %>
  <section class="card card-pad space-y-3">
    <h2 class="font-semibold">Add a product</h2>
    <p class="text-xs text-taupe">Adding or removing an item clears the customer's confirmation.</p>
    <% @records.select { |record| record['price_cents'].is_a?(Integer) && !record['variable_price'] }.first(6).each do |record| %>
      <div class="flex items-center gap-3 border-t border-fog pt-3">
        <% if (image = @images.url(record)) %><%= image_tag image, alt: record['product_name'] || record['name'], referrerpolicy: 'no-referrer', class: 'h-12 w-12 rounded-lg object-contain' %><% end %>
        <div class="min-w-0 flex-1"><p class="text-sm"><%= record['name'] %></p><p class="text-xs text-mocha"><%= ctrax_money(record['price_cents']) %></p></div>
        <%= form_tag quote_ctrax_pos_path(@snapshot.location_id, display_id: @display.id), method: :post, data: { action: 'submit->pos-cart#add', turbo: false, busy: false } do %>
          <%= hidden_field_tag 'items[0][variant_id]', record['id'], id: "demo_variant_#{record['id']}" %>
          <%= hidden_field_tag 'items[0][quantity]', 1, id: "demo_quantity_#{record['id']}" %>
          <%= submit_tag 'Add', class: 'btn-primary' %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
