<% content_for :title, "Sales" %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Sales</h1>
      <p class="mt-1 text-sm text-mocha">Order journal — imported and Rupert orders, including their current status.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <div class="flex items-center gap-1 rounded-full border border-fog bg-paper p-1">
        <% (["all"] + @sources).each do |s| %>
          <%= link_to s == "all" ? "All" : s.capitalize,
                sales_path(source: s == "all" ? nil : s, date: @date, window: @window_days),
                class: "nav-pill #{@source == s ? "nav-pill-active-sm" : "nav-pill-idle-sm"}" %>
        <% end %>
      </div>
      <%= form_tag sales_path, method: :get, class: "flex flex-wrap items-center gap-2" do %>
        <%= hidden_field_tag :source, (@source == "all" ? nil : @source) %>
        <%= label_tag :date, "Business date", class: "text-sm text-mocha" %>
        <%= text_field_tag :date, @date.iso8601, type: "date", class: "select" %>
        <%= submit_tag "Jump to day", class: "btn-ghost btn-sm" %>
      <% end %>
      <div class="flex items-center gap-1">
        <%= link_to "← Prev", sales_path(date: (@date - 1.day).iso8601, source: (@source == "all" ? nil : @source), window: @window_days),
              class: "nav-pill nav-pill-idle-sm", title: "Previous day (#{(@date - 1.day).strftime('%b %-e')})" %>
        <%= link_to "Next →", sales_path(date: (@date + 1.day).iso8601, source: (@source == "all" ? nil : @source), window: @window_days),
              class: "nav-pill nav-pill-idle-sm", title: "Next day (#{(@date + 1.day).strftime('%b %-e')})" %>
      </div>
      <div class="flex items-center gap-1 rounded-full border border-fog bg-paper p-1">
        <%= link_to "Print", sales_print_path(date: @date), class: "nav-pill nav-pill-idle-sm", title: "Batch print this day's packing slips" %>
        <%= link_to "Invoices", sales_print_path(date: @date, doc: "invoice"), class: "nav-pill nav-pill-idle-sm", title: "Batch print this day's invoices" %>
      </div>
    </div>
  </section>

  <section class="card card-pad flex flex-wrap items-center justify-between gap-3" aria-label="Sales coverage">
    <p class="max-w-2xl text-sm text-mocha">Native C-Trax orders are included in dashboard sales and reviewed in daily close. This journal contains canonical orders; its charts show paid, fulfilled and refunded order history. Payment and deposit reports are separate.</p>
    <div class="flex flex-wrap gap-2"><%= link_to 'Dashboard sales', dashboard_path, class: 'btn-ghost btn-sm' if Current.user.can?('dashboard.read') %><%= link_to 'C-Trax daily close', ctrax_days_path(date: @date), class: 'btn-ghost btn-sm' %></div>
  </section>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="stat">
      <p class="stat-label"><%= l(@date, format: :long) %> total</p>
      <p class="stat-value mt-1"><%= number_to_currency(@day_total_cents / 100.0) %></p>
      <p class="mt-1 text-xs text-taupe"><%= @day_sales.length %> sales</p>
    </div>
    <div class="stat">
      <p class="stat-label">Avg sale</p>
      <p class="stat-value mt-1"><%= number_to_currency((@day_sales.empty? ? 0 : @day_total_cents / @day_sales.length) / 100.0) %></p>
      <p class="mt-1 text-xs text-taupe">for the day</p>
    </div>
    <div class="stat">
      <p class="stat-label">Busiest hour</p>
      <p class="stat-value-sm mt-1"><%= @hourly.max_by { |r| r[:cells].values.sum { |c| c[:count] } }&.dig(:label) || "—" %></p>
      <p class="mt-1 text-xs text-taupe">9 AM – 9 PM</p>
    </div>
    <div class="stat">
      <p class="stat-label">Total · <%= @window_days %> days</p>
      <p class="stat-value mt-1"><%= number_to_currency(@total_cents / 100.0) %></p>
      <p class="mt-1 text-xs text-taupe"><%= @sales_count %> recent sales</p>
    </div>
  </section>

  <% cached_fragment("sales/charts", date: @date, window: @window_days, source: @source) do %>
  <section class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-xl text-ink">Revenue · last <%= @window_days %> days</h2>
        <span class="text-xs text-taupe">daily gross</span>
      </div>
      <div class="mt-4">
        <%= area_chart @revenue_series, height: "200px", legend: false, colors: chart_color(:olive_deep), library: { scales: { x: { ticks: { maxTicksLimit: 8 } } } } %>
      </div>
    </div>

    <div class="card card-pad">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-xl text-ink">Sales by hour of day</h2>
        <span class="text-xs text-taupe">gross · <%= @window_days %> days</span>
      </div>
      <div class="mt-4">
        <%= column_chart @hourly_series, height: "200px", legend: false, colors: chart_color(:olive_deep), library: { scales: { x: { ticks: { maxTicksLimit: 12 } } } } %>
      </div>
    </div>
  </section>
  <% end %>

  <% cached_fragment("sales/hourly", date: @date, source: @source) do %>
  <div class="card overflow-hidden">
    <div class="border-b border-fog px-5 py-3">
      <h2 class="font-display text-lg text-ink">Hourly × location</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Hour</th>
            <% @hourly.first[:cells].keys.each do |name| %>
              <th scope="col" class="th text-right"><%= name %></th>
            <% end %>
            <th scope="col" class="th text-right">Day total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% @hourly.each do |row| %>
            <tr class="hover:bg-cream">
              <td class="td whitespace-nowrap font-medium text-mocha"><%= row[:label] %></td>
              <% row[:cells].each do |name, cell| %>
                <td class="td text-right">
                  <% if cell[:count].positive? %>
                    <p class="font-semibold text-ink"><%= number_to_currency(cell[:cents] / 100.0) %></p>
                    <p class="text-xs text-taupe"><%= cell[:count] %> sales</p>
                  <% else %>
                    <span class="text-taupe">·</span>
                  <% end %>
                </td>
              <% end %>
              <td class="td text-right font-semibold text-olive"><%= number_to_currency(row[:cells].values.sum { |c| c[:cents] } / 100.0) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% end %>

  <div class="card overflow-hidden">
    <div class="flex items-center justify-between border-b border-fog px-5 py-3">
      <h2 class="font-display text-lg text-ink">The day, sale by sale</h2>
      <span class="text-xs text-taupe"><%= @day_sales.length %> in arrival order</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Time</th>
            <th scope="col" class="th">Order</th>
            <th scope="col" class="th">Where</th>
            <th scope="col" class="th">Channel</th>
            <th scope="col" class="th text-right">Items</th>
            <th scope="col" class="th text-right">Gross</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th">Tracking</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @day_sales.empty? %>
            <tr>
              <td class="empty-row">No sales recorded on <%= l(@date, format: :long) %>.</td>
            </tr>
          <% end %>
          <% @day_sales.each do |sale| %>
            <tr class="hover:bg-cream">
              <td class="td whitespace-nowrap text-mocha"><%= l(sale.occurred_at, format: :time) %></td>
              <td class="td font-medium text-ink"><%= link_to sale.display_number, order_path(sale), class: "hover:text-olive hover:underline" %></td>
              <td class="td"><span class="pill-taupe"><%= sale.location&.name || "Unknown" %></span></td>
              <td class="td"><span class="pill-taupe capitalize"><%= sale.channel %></span></td>
              <td class="td text-right text-mocha"><%= sale.line_items %></td>
              <td class="td text-right font-medium text-ink"><%= number_to_currency(sale.gross_cents / 100.0) %></td>
              <td class="td"><span class="<%= %w[paid fulfilled].include?(sale.status) ? "pill-fern" : "pill-clay" %>"><%= sale.status %></span></td>
              <td class="td">
                <% if sale.fulfillments.any? { |f| f.tracking_number.present? } %>
                  <span class="pill-olive"><span class="dot bg-olive-deep"></span> tracked</span>
                <% elsif sale.status == "fulfilled" %>
                  <span class="pill-taupe">no #</span>
                <% else %>
                  <span class="text-taupe">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
