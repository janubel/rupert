<% content_for :title, 'Sales' %>
<div class="operations-workspace space-y-6">
  <header class="operations-header"><div><p class="eyebrow text-olive-deep">Sell · one sales view</p><h1 class="page-title mt-2">Sales</h1><p class="mt-2 text-sm text-mocha">Recorded sales across channels, with a separate order journal for status and fulfillment.</p></div><div class="flex flex-wrap gap-2"><%= link_to 'View order journal', '#sales-journal', class: 'btn-ghost' %><% if Current.user.can_use_pos? %><%= link_to 'Open retail POS', ctrax_pos_path, class: 'btn-primary' %><% end %></div></header>
  <section class="card card-pad space-y-4" aria-label="Sales filters" <%= tour_anchor('filters') %>>
    <nav class="operations-navigation" aria-label="Sales sources"><% (['all'] + @sources).each do |source| %><%= link_to(source == 'all' ? 'All' : operations_source_name(source), sales_path(source: source, date: @date, window: @window_days, status: @status), class: "nav-pill workspace-nav-link #{@source == source ? 'nav-pill-active' : 'nav-pill-idle'}", aria: { current: @source == source ? 'page' : nil }) %><% end %></nav>
    <%= form_tag sales_path, method: :get, class: 'operations-filters' do %>
      <%= hidden_field_tag :source, @source %><div><%= label_tag :date, 'Business date', class: 'field-label' %><%= date_field_tag :date, @date, required: true, class: 'input' %></div><div><%= label_tag :window, 'Chart period ending on this date', class: 'field-label' %><%= select_tag :window, options_for_select([7, 30, 90, 365].map { |days| ["#{days} days", days] } | [["#{@window_days} days", @window_days]], @window_days), class: 'input' %></div><div><%= label_tag :status, 'Order journal status', class: 'field-label' %><%= select_tag :status, options_for_select(%w[all paid fulfilled placed cancelled refunded].map { |status| [status == 'all' ? 'All statuses' : status.humanize, status] }, @status), class: 'input' %></div><%= submit_tag 'Update view', class: 'btn-primary' %>
    <% end %>
    <div class="flex flex-wrap gap-2"><%= link_to 'Previous day', sales_path(date: @date - 1, source: @source, window: @window_days, status: @status), class: 'btn-ghost btn-sm' %><%= link_to 'Today', sales_path(source: @source, window: @window_days, status: @status), class: 'btn-ghost btn-sm' %><%= link_to 'Next day', sales_path(date: @date + 1, source: @source, window: @window_days, status: @status), class: 'btn-ghost btn-sm' %></div>
  </section>
  <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Recorded sales summary" <%= tour_anchor('summary') %>>
    <% [['Recorded sales · USD', operations_money(@day_total_cents), @date.strftime('%b %-d, %Y'), 'sales_total'], ['Sales recorded', @day_count, 'Paid / fulfilled and native completed orders', 'journal'], ['Average sale · USD', @day_count.zero? ? '—' : operations_money(BigDecimal(@day_total_cents.to_s) / @day_count), 'Recorded sales only', 'average_sale'], ["#{@window_days}-day sales · USD", operations_money(@total_cents), "#{@sales.from.to_date} through #{@date}", 'date_window']].each do |label, value, detail, term| %><div class="stat min-w-0"><div class="stat-label"><%= label %><%= define(term) %></div><p class="stat-value retail-money mt-2"><%= value %></p><p class="mt-2 text-xs text-mocha"><%= detail %></p></div><% end %>
  </section>
  <details class="card card-pad space-y-3" data-sales-total-explanation <%= tour_anchor('explanation') %>>
    <summary class="cursor-pointer text-sm font-semibold text-olive-deep">What makes up these totals?</summary>
    <p class="mt-3 text-sm text-mocha">For <%= @date.strftime('%B %-d, %Y') %>, the recorded-sales total adds these included USD sales before refunds. Paid / fulfilled canonical orders and native completed C-Trax orders are counted once. Tips, payment reports and bank deposits stay separate.</p>
    <dl class="divide-y divide-fog text-sm"><% @source_groups.each do |source, cents, count| %><div class="flex flex-wrap justify-between gap-2 py-2"><dt><%= operations_source_name(source) %> · <%= pluralize(count, 'sale') %></dt><dd class="font-semibold tabular-nums"><%= operations_money(cents) %></dd></div><% end %><div class="flex justify-between gap-3 py-3 font-semibold"><dt>Recorded sales</dt><dd class="tabular-nums"><%= operations_money(@day_total_cents) %></dd></div></dl>
    <p class="text-sm text-mocha"><% if @day_count.positive? %>Average sale = <%= operations_money(@day_total_cents) %> ÷ <%= pluralize(@day_count, 'included sale') %> = <%= operations_money(BigDecimal(@day_total_cents.to_s) / @day_count) %>.<% else %>No included sales are stored for this day. The average is shown as a dash; check source coverage before treating zero as no activity.<% end %></p>
    <p class="text-sm text-mocha">The <%= @window_days %>-day figure covers <%= @sales.from.to_date %> through <%= @date %>. The order journal’s status filter only changes the journal.</p>
    <%= link_to 'Try a sales-total example', learning_path('sales', anchor: 'lesson-example'), class: 'inline-block text-sm font-semibold text-olive-deep underline' %>
  </details>
  <p class="text-sm text-mocha">Summary and charts include USD paid/fulfilled canonical orders and native completed C-Trax sales once, before refunds. Tips, payments and deposits are separate. The journal status filter affects the journal only.</p>
  <% if @sales.warnings.any? %><div class="flash flash-alert" role="status"><ul class="list-disc pl-5"><% @sales.warnings.each do |warning| %><li><%= warning %></li><% end %></ul></div><% end %>
  <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Sales sources and freshness" <%= tour_anchor('sources') %>>
    <% (@source == 'all' ? (%w[shopify ctrax square] | @source_groups.map(&:first)) : [@source]).each do |source| %><% group = @source_groups.find { |row| row.first == source }; freshness = @freshness[source] || {} %><article class="card card-pad space-y-2"><h2 class="font-semibold"><%= operations_source_name(source) %></h2><p class="retail-money text-lg font-semibold"><%= operations_money(group&.second || 0) %> <span class="text-xs font-normal text-mocha">· <%= group&.third || 0 %> sales</span></p><p class="text-xs text-mocha">Last source pull: <%= retail_source_time(freshness[:pulled_at]) %></p><% if source == 'ctrax' %><p class="text-xs text-mocha">Latest stored business date: <%= freshness[:business_date] || 'Not imported' %></p><%= link_to 'Review native receipts', ctrax_days_path(date: @date), class: 'text-sm font-semibold text-olive-deep underline' %><% end %></article><% end %>
  </section>
  <section class="grid gap-4 lg:grid-cols-2" aria-label="Sales trends"><div class="card card-pad"><h2 class="font-display text-xl">Recorded sales · <%= @window_days %> days</h2><p class="mt-1 text-xs text-mocha">USD · ending <%= @date %></p><%= area_chart @revenue_series, height: '200px', legend: false, colors: chart_color(:olive_deep) %></div><div class="card card-pad"><h2 class="font-display text-xl">Sales by hour</h2><p class="mt-1 text-xs text-mocha">USD · all 24 hours · <%= Time.zone.name %></p><%= column_chart @hourly_series, height: '200px', legend: false, colors: chart_color(:olive_deep) %></div></section>
  <section id="sales-journal" tabindex="-1" class="card overflow-hidden" <%= tour_anchor('journal') %>>
    <div class="card-pad space-y-3"><div class="operations-header"><h2 class="font-display text-xl">Canonical order journal</h2><div class="flex flex-wrap gap-2"><%= link_to 'Print packing slips', sales_print_path(date: @date, source: @source, status: @status), class: 'btn-ghost btn-sm' %><%= link_to 'Print invoices', sales_print_path(date: @date, source: @source, status: @status, doc: 'invoice'), class: 'btn-ghost btn-sm' %></div></div><p class="text-sm text-mocha"><%= @pagy.count %> orders in this journal view · amounts retain each order’s currency. Native C-Trax receipts stay in daily close.</p></div>
    <div class="operations-table-region" role="region" tabindex="0" aria-label="Order journal"><table class="operations-table w-full text-sm"><caption class="sr-only">Canonical orders for <%= @date %>, <%= @source %> source, <%= @status %> statuses</caption><thead><tr><% ['Time', 'Order', 'Location', 'Source / channel', 'Items', 'Order gross', 'Status', 'Tracking'].each do |heading| %><th scope="col" class="th"><%= heading %></th><% end %></tr></thead><tbody class="divide-y divide-fog">
      <% @day_sales.each do |sale| %><tr><td class="td whitespace-nowrap"><%= sale.occurred_at.in_time_zone.strftime('%-I:%M %p') %></td><td class="td"><%= link_to sale.display_number, order_path(sale), class: 'font-semibold text-olive-deep underline' %></td><td class="td"><%= sale.location&.name || 'Unknown' %></td><td class="td"><%= operations_source_name(sale.source) %><br><span class="text-xs text-mocha"><%= sale.channel %></span></td><td class="td"><%= sale.line_items %></td><td class="td retail-money whitespace-nowrap"><%= operations_money(sale.gross_cents, currency: sale.currency) %></td><td class="td"><span class="<%= %w[paid fulfilled].include?(sale.status) ? 'pill-fern' : 'pill-taupe' %>"><%= sale.status.humanize %></span></td><td class="td"><%= sale.fulfillments.any? { |fulfillment| fulfillment.tracking_number.present? } ? 'Tracked' : 'Not recorded' %></td></tr><% end %>
      <% if @day_sales.empty? %><tr><td colspan="8" class="empty-row"><%= @source == 'ctrax' ? 'Review native C-Trax receipts in daily close above.' : 'No canonical orders match this date, source and status.' %></td></tr><% end %>
    </tbody></table></div><% if @pagy.pages > 1 %><div class="card-pad"><%== pagy_nav(@pagy) %></div><% end %>
  </section>
  <details class="card card-pad"><summary class="disclosure-trigger font-semibold">Hourly × location · canonical USD sales</summary><p class="mb-3 text-xs text-mocha">Paid and fulfilled canonical orders only. All 24 hours; native C-Trax receipts remain in daily close.</p><div class="operations-table-region" role="region" tabindex="0" aria-label="Hourly sales by location"><table class="w-full text-sm"><thead><tr><th scope="col" class="th">Hour</th><% @hourly.first[:cells].each_key do |name| %><th scope="col" class="th"><%= name %></th><% end %><th scope="col" class="th">Day total</th></tr></thead><tbody><% @hourly.each do |row| %><tr><th scope="row" class="td"><%= row[:label] %></th><% row[:cells].each_value do |cell| %><td class="td retail-money"><%= operations_money(cell[:cents]) %></td><% end %><td class="td retail-money"><%= operations_money(row[:cells].values.sum { |cell| cell[:cents] }) %></td></tr><% end %></tbody></table></div></details>
</div>
