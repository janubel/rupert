<% content_for :title, "Print #{l(@date, format: :long)}" %>
<div class="card card-pad print:hidden">
  <%= page_header "Print #{@doc == 'invoice' ? 'invoices' : 'packing slips'} · #{l(@date, format: :long)}", subtitle: pluralize(@orders.length, 'order'), eyebrow: 'Sell · Sales' do %>
    <%= link_to @doc == 'invoice' ? 'Packing slips' : 'Invoices', sales_print_path(date: @date, doc: @doc == 'invoice' ? 'packing_slip' : 'invoice'), class: 'btn-ghost' %>
    <%= link_to 'Sales', sales_path, class: 'btn-ghost' %>
    <button type="button" data-controller="print" data-action="click->print#print" class="btn-primary">Print</button>
  <% end %>
</div>

<% @orders.each do |order| %>
  <section class="slip card card-pad">
    <div class="flex flex-wrap items-start justify-between gap-4 border-b border-fog pb-4">
      <div>
        <p class="eyebrow text-olive"><%= @doc == 'invoice' ? 'Invoice' : 'Packing slip' %></p>
        <h2 class="font-display text-2xl text-ink"><%= @doc == 'invoice' ? "#{TenantSettings.invoice_prefix}-#{order.display_number}" : "Order #{order.display_number}" %></h2>
        <p class="text-sm text-mocha"><%= l(order.occurred_at, format: :long) %></p>
      </div>
      <div class="text-right">
        <p class="font-display text-lg text-ink"><%= TenantSettings.business_name %></p>
        <p class="text-xs text-taupe"><%= order.channel %> · <span class="capitalize"><%= order.source %></span></p>
        <% if @doc == 'packing_slip' && order.fulfillments.with_tracking.any? %>
          <p class="mt-1 text-xs text-mocha">Tracking: <%= order.fulfillments.with_tracking.map(&:tracking_number).join(', ') %></p>
        <% end %>
      </div>
    </div>

    <dl class="facts mt-4">
      <div>
        <dt>Ship to</dt>
        <% if (addr = order.shipping_address) %>
          <dd><%= addr[:name] %><br><%= addr[:line1] %><% if addr[:line2].present? %>, <%= addr[:line2] %><% end %><br><%= [addr[:city], addr[:province], addr[:zip]].select(&:present?).join(', ') %></dd>
        <% else %>
          <dd class="text-taupe">No shipping address.</dd>
        <% end %>
      </div>
      <div>
        <dt>Customer</dt>
        <% if order.customer %>
          <dd><%= order.customer.name %><% if order.customer.email.present? %><br><%= order.customer.email %><% end %></dd>
        <% else %>
          <dd class="text-taupe">Walk-in</dd>
        <% end %>
      </div>
    </dl>

    <table class="table mt-4">
      <thead class="border-b border-fog">
        <tr>
          <th scope="col" class="th">Item</th>
          <th scope="col" class="th">SKU</th>
          <th scope="col" class="th num">Qty</th>
          <% if @doc == 'invoice' %><th scope="col" class="th num">Amount</th><% end %>
        </tr>
      </thead>
      <tbody>
        <% order.order_lines.each do |line| %>
          <tr>
            <td class="td font-medium text-ink"><%= line.name %></td>
            <td class="td font-mono text-xs text-mocha"><%= line.sku.presence || '—' %></td>
            <td class="td num text-mocha"><%= line.quantity %></td>
            <% if @doc == 'invoice' %><td class="td num font-medium text-ink"><%= number_to_currency(line.line_cents / 100.0) %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @doc == 'invoice' %>
      <div class="mt-3 flex justify-end">
        <dl class="space-y-1 text-sm">
          <div class="flex justify-between gap-8">
            <dt class="text-mocha">Total</dt>
            <dd class="num font-semibold text-ink"><%= number_to_currency(order.gross_cents / 100.0) %></dd>
          </div>
        </dl>
      </div>
    <% end %>
  </section>
<% end %>

<% if @orders.empty? %>
  <div class="card print:hidden"><%= empty_state 'No orders on this day', hint: 'Pick another business date from the Sales page.' %></div>
<% end %>
