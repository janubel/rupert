<% content_for :title, @session.name %>
<div class="space-y-6">
  <%= page_header @session.name, subtitle: "Opened #{l(@session.opened_at, format: :long)}#{@session.closed_at ? " · closed #{l(@session.closed_at, format: :long)}" : ''}.",
      menu: (retail_business_access?('sales.write') ? [['Sync now', refresh_sales_pos_session_path(@session), { method: :post }]] : nil) do %>
    <% if @session.location %><span class="pill-taupe"><%= @session.location.name %></span><% end %>
    <span class="<%= @session.open? ? 'pill-fern' : 'pill-taupe' %>"><%= @session.status.to_s.humanize %></span>
  <% end %>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4" aria-label="Tender summary">
    <% [['Cash tenders', @session.cash_sales_cents], ['Card tenders', @session.card_sales_cents], ['Gift-card tenders', @session.gift_sales_cents], ['Recorded tenders', @session.total_sales_cents]].each do |label, cents| %>
      <div class="stat"><p class="stat-label"><%= label %></p><p class="stat-value mt-1"><%= number_to_currency(cents / 100.0) %></p></div>
    <% end %>
  </section>

  <section class="section-card">
    <%= section_heading 'Cash drawer', hint: "Opening float #{number_to_currency(@session.opening_cash_cents / 100.0)}" %>
    <dl class="facts">
      <div><dt>Expected cash</dt><dd class="num text-left text-lg"><%= number_to_currency(@session.expected_cash_cents / 100.0) %></dd></div>
      <div><dt>Counted cash</dt><dd class="num text-left text-lg"><%= @session.counted_cash_cents ? number_to_currency(@session.counted_cash_cents / 100.0) : '—' %></dd></div>
      <div><dt>Variance</dt><dd class="num text-left text-lg <%= 'text-clay' if @session.variance_cents && !@session.variance_cents.zero? %>"><%= @session.variance_cents ? number_to_currency(@session.variance_cents / 100.0) : '—' %></dd></div>
    </dl>

    <% if @session.open? && Current.user.can?('sales.write') %>
      <%= form_tag close_sales_pos_session_path(@session), method: :post, class: 'space-y-3 border-t border-fog pt-4' do %>
        <%= section_heading 'Close this register', level: :h3 %>
        <p id="physical-count-help" class="text-sm text-mocha">Count the physical drawer and enter dollars, for example 50.00. The expected amount is a comparison, not a cash count.</p>
        <div class="toolbar">
          <div class="toolbar-field">
            <%= label_tag :counted_cash, 'Counted cash (USD)', class: 'field-label' %>
            <%= number_field_tag :counted_cash, nil, required: true, min: 0, max: 999999.99, step: '0.01', inputmode: 'decimal', placeholder: '0.00', class: 'input', aria: { describedby: 'physical-count-help' } %>
          </div>
          <div class="toolbar-field">
            <%= label_tag :notes, 'Notes', class: 'field-label' %>
            <%= text_field_tag :notes, nil, placeholder: 'Optional', class: 'input' %>
          </div>
          <div class="toolbar-actions">
            <%= submit_tag 'Close register', class: 'btn-primary', data: { turbo_confirm: 'Close this register with the physical cash count entered?' } %>
          </div>
        </div>
      <% end %>
    <% elsif !@session.open? %>
      <p class="text-xs text-taupe"><%= @session.notes.presence || 'Closed without notes.' %></p>
    <% end %>
  </section>

  <section class="section-card">
    <%= section_heading 'Orders in this session' %>
    <div class="table-region" role="region" tabindex="0" aria-label="Orders in this register">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Time</th>
            <th scope="col" class="th">Order</th>
            <th scope="col" class="th num">Gross</th>
            <th scope="col" class="th">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if @orders.empty? %>
            <tr><td class="empty-row" colspan="4">No orders in this session yet. Sales recorded at this register appear here.</td></tr>
          <% end %>
          <% @orders.each do |order| %>
            <tr>
              <td class="td whitespace-nowrap text-mocha"><%= l(order.occurred_at, format: :time) %></td>
              <td class="td font-medium text-ink"><%= order.order_number.presence || order.source_order_id.first(12) %></td>
              <td class="td num font-medium text-ink"><%= number_to_currency(order.gross_cents / 100.0) %></td>
              <td class="td"><span class="<%= %w[paid fulfilled].include?(order.status) ? 'pill-fern' : 'pill-clay' %>"><%= order.status.to_s.humanize %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
