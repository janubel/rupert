<% content_for :title, 'Open register' %>
<div class="page-narrow space-y-6">
  <%= page_header 'Open register', subtitle: 'Start a checkout shift and enter the cash physically in its drawer.' %>
  <div class="card card-pad">
    <%= render 'shared/form_errors', model: @session %>
    <%= form_with model: @session, scope: :pos_session, url: sales_pos_sessions_path, class: 'space-y-4' do |f| %>
      <fieldset class="space-y-3">
        <legend class="card-title">Register</legend>
        <div>
          <%= f.label :name, 'Register name', class: 'field-label' %>
          <%= f.text_field :name, placeholder: 'Front counter', class: 'input' %>
        </div>
        <div>
          <%= f.label :location_id, 'Location', class: 'field-label' %>
          <%= f.collection_select :location_id, Location.order(:name), :id, :name, { include_blank: 'No location' }, class: 'select w-full' %>
        </div>
        <div>
          <%= f.label :opening_cash, 'Opening cash (USD)', class: 'field-label' %>
          <%= f.number_field :opening_cash, value: 0, min: 0, max: 999999.99, step: '0.01', inputmode: 'decimal', class: 'input' %>
        </div>
      </fieldset>
      <div class="form-actions">
        <%= f.submit 'Open register', class: 'btn-primary' %>
        <%= link_to 'Cancel', sales_pos_sessions_path, class: 'btn-ghost' %>
      </div>
    <% end %>
  </div>
</div>
