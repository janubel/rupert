<!DOCTYPE html>
<html lang="en">
<head>
  <%= render "layouts/favicon" %>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= [content_for(:title), 'Rupert'].compact.join(' · ') %></title>
  <meta name="turbo-cache-control" content="no-cache">
  <meta name="theme-color" content="#108184">
  <link rel="manifest" href="/employee/manifest.webmanifest">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload' %>
  <%= javascript_importmap_tags %>
  <%= yield :head %>
</head>
<body data-controller="employee-offline" class="min-h-screen bg-cream text-ink">
  <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
  <header class="border-b border-fog bg-paper">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-4 sm:px-6">
      <%= link_to employee_app_path(preview: @preview ? 1 : nil), class: 'app-brand text-lg font-semibold text-olive', aria: { label: 'My time home' } do %>
        <img src="/icon.png?v=rupert-dog-1" width="40" height="40" alt="" style="width:40px;height:40px;object-fit:contain;flex-shrink:0">
        <span>Rupert</span>
      <% end %>
      <% if Current.user %>
        <div class="flex items-center gap-3 text-sm"><span><%= Current.user.display_name %></span><% unless @preview %><%= button_to 'Sign out', logout_path, method: :delete, class: 'text-mocha underline' %><% end %></div>
      <% end %>
    </div>
    <% if Current.user %>
      <nav aria-label="My workspace" class="mx-auto flex max-w-3xl flex-wrap gap-1 px-4 pb-3 sm:flex sm:px-6">
        <% links = @preview ? [['Today', employee_app_path(preview: 1)], ['Timesheets', employee_preview_timesheets_path], ['Pay', employee_preview_pay_path], ['Time off', employee_preview_time_off_path], ['Reports', employee_preview_reports_path]] : [['Today', employee_app_path], ['Timesheets', people_timesheets_path], ['Time off', employee_time_off_path], ['Reports', employee_reports_path]] %>
        <% links.unshift(['POS', ctrax_pos_path]) if !@preview && Current.user.can_use_pos? %>
        <% links.each do |label, path| %>
          <%= link_to label, path, class: "rounded-full px-1 py-2 text-center text-xs whitespace-nowrap sm:px-3 sm:text-sm #{request.path == path.split('?').first ? 'bg-olive text-white' : 'text-mocha hover:bg-haze'}", aria: { current: request.path == path.split('?').first ? 'page' : nil } %>
        <% end %>
      </nav>
    <% end %>
  </header>
  <main id="main" class="mx-auto <%= %w[ctrax_pos point_of_sale].include?(controller_path) ? 'max-w-7xl' : 'max-w-3xl' %> space-y-6 px-4 py-6 sm:px-6 sm:py-8" tabindex="-1">
    <% if notice %><p role="status" class="flash flash-notice"><%= notice %></p><% end %>
    <% if alert %><p role="alert" class="flash flash-alert"><%= alert %></p><% end %>
    <% if @preview %><p role="status" class="rounded-xl border border-olive/30 bg-olive/10 p-3 text-sm"><strong>Employee preview</strong> · Example data only. Browse freely; saving, clocking and sending are disabled. <%= link_to 'Close preview', employee_app_path, class: 'underline' %></p><% end %>
    <%= yield %>
  </main>
  <footer class="mx-auto flex max-w-3xl flex-wrap gap-4 px-4 pb-8 text-xs text-mocha sm:px-6">
    <%= link_to 'Privacy & support', employee_privacy_path(preview: @preview ? 1 : nil), class: 'underline' %>
    <%= link_to 'Signed-in devices', employee_devices_path, class: 'underline' if Current.user && !@preview %>
    <% if Current.user&.can_manage_accounts? %><%= link_to 'Back to management', root_path, class: 'underline' %><% end %>
  </footer>
</body>
</html>
