<!DOCTYPE html>
<html lang="en">
<head>
  <%= render "layouts/favicon" %>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= safe_join([content_for(:title), 'Rupert'].compact, " · ") %></title>
  <meta name="turbo-cache-control" content="no-cache">
  <meta name="theme-color" content="#e6efea">
  <%= render 'layouts/theme' %>
  <link rel="manifest" href="/employee/manifest.webmanifest">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&display=swap">
  <%= stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload' %>
  <%= javascript_importmap_tags %>
  <%= yield :head %>
</head>
<body data-controller="employee-offline<%= ' help-panel' if Current.user && !@preview %>" class="min-h-screen bg-cream text-ink">
  <a href="#main" class="sr-only z-50 rounded-full bg-olive px-4 py-2 text-sm font-semibold text-cream focus:not-sr-only focus:fixed focus:left-4 focus:top-3">Skip to content</a>
  <header class="workspace-header">
    <%= render "layouts/build_version" %>
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-4 sm:px-6">
      <%= link_to employee_app_path(preview: @preview ? 1 : nil), class: 'app-brand text-lg font-semibold text-olive-deep', aria: { label: 'My time home' } do %>
        <%= render "shared/rupert_face", size: 40 %>
        <span>Rupert</span>
      <% end %>
      <% if Current.user %>
        <div class="flex items-center gap-3 text-sm"><% unless @preview %><%= link_to learning_index_path, class: 'nav-utility', aria: { label: 'Help', expanded: 'false', haspopup: 'dialog' }, title: 'Help — press ?', data: { action: 'click->help-panel#toggle', help_panel_target: 'trigger', tour: 'help' } do %><%= navigation_icon('help') %><span class="nav-hint">Help · <kbd>?</kbd></span><% end %><% end %><span><%= Current.user.display_name %></span><% unless @preview %><%= button_to 'Sign out', logout_path, method: :delete, class: 'text-mocha underline' %><% end %></div>
      <% end %>
    </div>
    <% if Current.user %>
      <nav aria-label="My workspace" class="workspace-navigation mx-auto max-w-3xl px-4 pb-3 sm:px-6" <%= tour_anchor('nav') %>>
        <% links = @preview ? [['Today', employee_app_path(preview: 1)], ['Timesheets', employee_preview_timesheets_path], ['Schedule', employee_preview_schedule_path], ['Pay', employee_preview_pay_path], ['Time off', employee_preview_time_off_path], ['Reports', employee_preview_reports_path]] : [['Today', employee_app_path], ['Receipts', receipts_path], ['Timesheets', people_timesheets_path], ['Schedule', employee_schedule_path], ['Time off', employee_time_off_path], ['Reports', employee_reports_path]] %>
        <% links << ['My tasks', projects_tasks_path] if !@preview && Current.user.employee? && Current.user.can?('tasks.self') %>
        <% links.unshift(['POS', ctrax_pos_path]) if !@preview && Current.user.can_use_pos? %>
        <% links.each do |label, path| %>
          <%= link_to label, path, class: "nav-pill workspace-nav-link #{module_match_strength(path.split('?').first).positive? ? 'nav-pill-active' : 'nav-pill-idle'}", aria: { current: module_match_strength(path.split('?').first).positive? ? 'page' : nil } %>
        <% end %>
      </nav>
    <% end %>
  </header>
  <main id="main" class="mx-auto <%= %w[ctrax_pos point_of_sale projects/tasks].include?(controller_path) ? 'max-w-7xl' : 'max-w-3xl' %> space-y-6 px-4 py-6 sm:px-6 sm:py-8" tabindex="-1">
    <%= render 'shared/workspace_help' if Current.user && !@preview %>
    <% if notice %><p role="status" class="flash flash-notice"><%= notice %></p><% end %>
    <% if alert %><p role="alert" class="flash flash-alert"><%= alert %></p><% end %>
    <% if @preview %><p role="status" class="rounded-xl border border-olive/30 bg-olive/10 p-3 text-sm"><strong>Staff preview</strong> · Example data only. Browse freely; saving, clocking and sending are disabled. <%= link_to 'Close preview', employee_app_path, class: 'underline' %></p><% end %>
    <%= yield %>
  </main>
  <%= render 'shared/help_panel' if Current.user && !@preview %>
  <footer class="mx-auto flex max-w-3xl flex-wrap gap-4 px-4 pb-8 text-xs text-mocha sm:px-6">
    <%= link_to 'Learn Rupert & definitions', learning_index_path, class: 'underline' if Current.user && !@preview %>
    <%= link_to 'Privacy & support', employee_privacy_path(preview: @preview ? 1 : nil), class: 'underline' %>
    <%= link_to 'Signed-in devices', employee_devices_path, class: 'underline' if Current.user && !@preview %>
    <% if Current.user&.can_manage_accounts? %><%= link_to 'Back to management', root_path, class: 'underline' %><% end %>
  </footer>
</body>
</html>
