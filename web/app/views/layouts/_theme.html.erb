<%# Dark by default. Applies the saved appearance before first paint so there is no flash. %>
<script>
  (function () {
    try {
      var theme = localStorage.getItem("rupert-theme");
      var colors = { light: "#f5f7fa", mist: "#e6ebf2", sepia: "#efe6d4", herbal: "#f3f4f1" };
      if (theme && colors[theme]) {
        document.documentElement.setAttribute("data-theme", theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", colors[theme]);
      }
    } catch (e) {}
  })();
</script>
