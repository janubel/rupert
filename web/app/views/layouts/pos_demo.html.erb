<!DOCTYPE html>
<html lang="en">
<head>
  <%= render "layouts/favicon" %>
  <title>Rupert · Cashier demo</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-cache-control" content="no-cache">
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&display=swap">
  <%= stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload' %>
  <%= javascript_importmap_tags %>
</head>
<body class="min-h-screen bg-haze p-5 text-ink">
  <%= render "layouts/build_version" %>
<main><%= yield %></main></body>
</html>
