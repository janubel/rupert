<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/favicon" %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Rupert</title>
    <meta name="color-scheme" content="light">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&display=swap">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <% if ShopifyApp.configuration.api_key.present? %>
      <%= javascript_include_tag "https://cdn.shopify.com/shopifycloud/app-bridge.js", data: { "api-key": ShopifyApp.configuration.api_key } %>
    <% end %>
  </head>
  <body class="min-h-full">
    <%= render "layouts/shell" %>
  </body>
</html>
