<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/favicon" %>
    <%= yield :head %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= [content_for(:title), "Rupert"].compact.join(" · ") %></title>
    <link rel="manifest" href="/employee/manifest.webmanifest">
    <meta name="theme-color" content="#526145">
    <meta name="color-scheme" content="light">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@400;500;600;700&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style type="text/turbo-progress-bar">
      turbo-progress-bar { background: #108184; height: 3px; }
    </style>
  </head>
  <body class="min-h-full">
    <%= render "layouts/shell" %>
  </body>
</html>
