<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/favicon" %>
    <%= yield :head %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= safe_join([content_for(:title), "Rupert"].compact, " · ") %></title>
    <link rel="manifest" href="/employee/manifest.webmanifest">
    <meta name="theme-color" content="#e6efea">
    <meta name="color-scheme" content="dark light">
    <%= render "layouts/theme" %>
    <% if panel_view? %><base target="_top"><% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%# The display font loads without blocking the first paint (system serif until it arrives). %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&display=swap"></noscript>
    <%# A form that returns to the same page updates it in place and keeps the scroll position. %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style type="text/turbo-progress-bar">
      turbo-progress-bar { background: var(--color-olive); height: 3px; }
    </style>
  </head>
  <% if panel_view? %>
    <%# A page opened in the team chat side panel: just the page, no top bar, rail or status bar; links and forms
        open in the full window. %>
    <body class="min-h-full panel-view" data-turbo="false">
      <main id="main" class="app-main app-main-panel"><%= yield %></main>
    </body>
  <% else %>
    <body class="min-h-full">
      <%= render "layouts/shell" %>
    </body>
  <% end %>
</html>
