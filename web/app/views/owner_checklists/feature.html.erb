<%= render 'privacy' %><% content_for :title, "Review #{@feature['id']}" %>
<div class="space-y-6"><section><%= link_to 'Private checklist', owner_checklist_path(@checklist, anchor: "feature-#{@feature['id']}"), class: 'text-sm text-olive', data: { turbo: false } %><p class="mt-3 font-mono text-xs text-taupe"><%= @feature['id'] %> · <%= @feature['area'] %></p><h1 class="page-title mt-1"><%= @feature['name'] %></h1><p class="mt-2 text-sm text-mocha">Current code status: <strong><%= @feature['status'] %></strong>. Owner acceptance records your test of the stated scope; it does not change the product catalog or enable planned functionality.</p></section>
  <section class="card card-pad space-y-3"><h2 class="font-display text-xl">Current scope to review</h2><p class="whitespace-pre-wrap text-sm"><%= @feature['scope'] %></p><% if @review_values['status'] == 'stale' %><p role="status" class="text-sm font-semibold text-clay">The catalog changed after the previous review. Review and test the current scope again.</p><% end %><% if @feature['status'] == 'Planned' %><p class="text-sm font-semibold text-mocha">This feature is planned and cannot be marked passed.</p><% end %></section>
  <%= form_with scope: :owner_feature, url: review_feature_owner_checklist_path(@checklist), method: :patch, data: { turbo: false }, autocomplete: 'off', class: 'card card-pad space-y-5' do |form| %>
    <%= render 'errors' %><%= hidden_field_tag :lock_version, @checklist.lock_version %><%= hidden_field_tag :feature_id, @feature['id'] %><%= hidden_field_tag :catalog_fingerprint, OwnerChecklist.catalog_fingerprint(@feature) %>
    <div><%= form.label :status, 'Owner review status', class: 'field-label' %><%= form.select :status, options_for_select(OwnerChecklist::FEATURE_STATUSES.map { |value| [owner_review_label(value), value] }, selected: OwnerChecklist::FEATURE_STATUSES.include?(@review_values['status']) ? @review_values['status'] : 'not_reviewed', disabled: @feature['status'] == 'Planned' ? ['passed'] : []), {}, class: 'input mt-1 w-full' %></div>
    <div><%= form.label :tested_on, 'Date tested', class: 'field-label' %><%= form.date_field :tested_on, value: @review_values['tested_on'], max: Date.current.iso8601, class: 'input mt-1 w-full' %></div>
    <div><%= form.label :evidence, 'Test evidence / blocked reason / not-required reason', class: 'field-label' %><%= form.text_area :evidence, value: @review_values['evidence'], rows: 6, maxlength: 2000, class: 'input mt-1 w-full', placeholder: 'Describe the workflow, result and limits you verified. Keep credentials and customer data out.' %><p class="mt-1 text-xs text-taupe">A pass needs actual evidence and a test date. Not required needs a reason. Text is a private owner record, not an automatic test result.</p></div>
    <label class="flex items-start gap-3 text-sm"><%= form.check_box :attest_scope, checked: false %><span>I tested only the current published scope above and accept that scope. A partial implementation can pass only its stated bounds. This does not certify payments, remote inventory writes or other work outside the scope.</span></label>
    <div class="flex flex-wrap gap-3"><%= form.submit 'Save owner review', class: 'btn-primary' %><%= link_to 'Cancel', owner_checklist_path(@checklist), class: 'btn-ghost', data: { turbo: false } %></div>
  <% end %>
</div>
