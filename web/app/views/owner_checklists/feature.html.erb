<%= render 'privacy' %><% content_for :title, "Review #{@feature['id']}" %>
<div class="page-medium space-y-6">
  <%= page_header @feature['name'], subtitle: 'Record your own test of the stated scope. Acceptance does not change the product catalog or enable planned functionality.' %>
  <dl class="facts">
    <div><dt>Feature</dt><dd class="font-mono"><%= @feature['id'] %> · <%= @feature['area'] %></dd></div>
    <div><dt>Code status</dt><dd><%= @feature['status'] %></dd></div>
    <div><dt>Checklist</dt><dd><%= link_to @checklist.data['name'], owner_checklist_path(@checklist, anchor: "feature-#{@feature['id']}"), class: 'text-olive-deep hover:underline', data: { turbo: false } %></dd></div>
  </dl>
  <section class="section-card">
    <%= section_heading 'Current scope to review' %>
    <p class="whitespace-pre-wrap text-sm"><%= @feature['scope'] %></p>
    <% if @review_values['status'] == 'stale' %><p role="status" class="text-sm font-semibold text-clay">The catalog changed after the previous review. Review and test the current scope again.</p><% end %>
    <% if @feature['status'] == 'Planned' %><p class="text-sm font-semibold text-mocha">This feature is planned and cannot be marked passed.</p><% end %>
  </section>
  <div class="card card-pad">
  <%= form_with scope: :owner_feature, url: review_feature_owner_checklist_path(@checklist), method: :patch, data: { turbo: false }, autocomplete: 'off', class: 'space-y-6' do |form| %>
    <%= render 'errors' %><%= hidden_field_tag :lock_version, @checklist.lock_version %><%= hidden_field_tag :feature_id, @feature['id'] %><%= hidden_field_tag :catalog_fingerprint, OwnerChecklist.catalog_fingerprint(@feature) %>
    <fieldset class="space-y-4">
      <legend class="card-title">Owner review</legend>
      <div><%= form.label :status, 'Owner review status', class: 'field-label' %><%= form.select :status, options_for_select(OwnerChecklist::FEATURE_STATUSES.map { |value| [owner_review_label(value), value] }, selected: OwnerChecklist::FEATURE_STATUSES.include?(@review_values['status']) ? @review_values['status'] : 'not_reviewed', disabled: @feature['status'] == 'Planned' ? ['passed'] : []), {}, class: 'select w-full' %></div>
      <div><%= form.label :tested_on, 'Date tested', class: 'field-label' %><%= form.date_field :tested_on, value: @review_values['tested_on'], max: Date.current.iso8601, class: 'input w-full' %></div>
      <div><%= form.label :evidence, 'Test evidence / blocked reason / not-required reason', class: 'field-label' %><%= form.text_area :evidence, value: @review_values['evidence'], rows: 6, maxlength: 2000, class: 'input w-full', placeholder: 'Describe the workflow, result and limits you verified. Keep credentials and customer data out.' %><p class="mt-1 text-xs text-taupe">A pass needs actual evidence and a test date. Not required needs a reason. Text is a private owner record, not an automatic test result.</p></div>
      <label class="flex items-start gap-3 text-sm"><%= form.check_box :attest_scope, checked: false, class: 'checkbox mt-0.5' %><span>I tested only the current published scope above and accept that scope. A partial implementation can pass only its stated bounds. This does not certify payments, remote inventory writes or other work outside the scope.</span></label>
    </fieldset>
    <div class="form-actions"><%= form.submit 'Save', class: 'btn-primary' %><%= link_to 'Cancel', owner_checklist_path(@checklist, anchor: "feature-#{@feature['id']}"), class: 'btn-ghost', data: { turbo: false } %></div>
  <% end %>
  </div>
</div>
