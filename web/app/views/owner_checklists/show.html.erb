<%= render 'privacy' %><% data = @checklist.data %><% content_for :title, data['name'] %>
<div class="space-y-6">
  <%= page_header data['name'], subtitle: data['purpose'].to_s.split(/(?<=[.!?])\s+/).first,
        menu: [['Edit owner details', edit_owner_checklist_path(@checklist), { data: { turbo: false } }], ['Print private copy', print_owner_checklist_path(@checklist), { data: { turbo: false } }]] do %>
    <%= link_to 'Add service reference', service_owner_checklist_path(@checklist), class: 'btn-primary', data: { turbo: false } %>
  <% end %>

  <dl class="facts">
    <div><dt>Domain</dt><dd class="font-mono"><%= data['domain'] %></dd></div>
    <div><dt>Owner</dt><dd><%= data['owner_name'].presence || 'Not recorded' %></dd></div>
    <div><dt>Contact</dt><dd><%= data['owner_email'].presence || 'Email not recorded' %><% if data['owner_phone'].present? %> · <%= data['owner_phone'] %><% end %></dd></div>
    <div><dt>Service references</dt><dd><%= @checklist.services.length %></dd></div>
  </dl>

  <section class="section-card">
    <%= section_heading 'Domain purpose and notes' %>
    <p class="whitespace-pre-wrap text-sm"><%= data['purpose'] %></p>
    <% if data['notes'].present? %><p class="whitespace-pre-wrap text-sm text-mocha"><%= data['notes'] %></p><% end %>
  </section>

  <section class="space-y-4">
    <%= section_heading 'Service references', hint: 'Owner-reported login locations, renewal dates and support contacts. Dates do not send reminders; MFA labels are not provider verification.' %>
    <% if @checklist.services.empty? %>
      <%= empty_state 'No service references yet', hint: 'Add the services this domain depends on, with actual dates and a vault label where helpful.' do %>
        <%= link_to 'Add service reference', service_owner_checklist_path(@checklist), class: 'btn-primary', data: { turbo: false } %>
      <% end %>
    <% else %>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2"><% @checklist.services.each do |service_id, service| %>
        <article id="service-<%= service_id %>" class="section-card <%= 'opacity-70' if owner_service_archived?(service) %>">
          <%= section_heading service['name'], level: :h3 do %>
            <% if owner_service_archived?(service) %><span class="pill-taupe">Archived</span><% end %>
            <%= link_to 'Edit', service_owner_checklist_path(@checklist, service_id: service_id), class: 'btn-ghost btn-sm', data: { turbo: false } %>
          <% end %>
          <p class="whitespace-pre-wrap text-sm"><%= service['purpose'] %></p>
          <div class="flex flex-wrap gap-2"><% service_schedules(service).each do |schedule| %><span class="<%= schedule[:state] == :overdue ? 'pill-rose' : schedule[:state] == :today ? 'pill-clay' : 'pill-taupe' %>"><%= schedule[:label] %><%= schedule[:state] == :overdue ? ' overdue' : schedule[:state] == :today ? ' today' : '' %> · <%= schedule[:date].iso8601 %></span><% end %></div>
          <dl class="facts">
            <div><dt>Login page</dt><dd><% if (login = safe_login_url(service['login_url'])) %><%= link_to 'Open saved login', login, target: '_blank', rel: 'nofollow noopener noreferrer', referrerpolicy: 'no-referrer', class: 'btn-ghost btn-sm' %><span class="mt-1 block break-all font-mono text-xs text-taupe"><%= login %></span><% else %>Not recorded<% end %></dd></div>
            <div><dt>Renewal</dt><dd><%= service['renewal_cadence'].to_s.humanize %> · <%= service['renewal_on'].presence || 'Date not set' %><% if service['renewal_notes'].present? %><span class="mt-1 block whitespace-pre-wrap text-mocha"><%= service['renewal_notes'] %></span><% end %></dd></div>
            <div><dt>Owner review</dt><dd><%= service['review_cadence'].to_s.humanize %> · <%= service['next_review_on'].presence || 'Next date not set' %></dd></div>
            <div><dt>MFA / vault label</dt><dd>MFA: <%= service['mfa_status'].to_s.humanize %> · Vault label: <%= service['vault_reference'].presence || 'Not recorded' %></dd></div>
            <div><dt>Support contact</dt><dd><%= [service['support_name'], service['support_email'], service['support_phone']].compact_blank.join(' · ').presence || 'Not recorded' %></dd></div>
          </dl>
          <% if service['notes'].present? %><p class="whitespace-pre-wrap text-sm text-mocha"><%= service['notes'] %></p><% end %>
        </article>
      <% end %></div>
    <% end %>
  </section>

  <section class="section-card">
    <%= section_heading 'Owner feature reviews', hint: 'Every current catalog feature, with the owner’s own test record beside its code status.' %>
    <p id="owner-review-coverage" class="text-sm"><strong><%= @reviewed_count %> of <%= @features.length %></strong> reviewed with a current scope pass or a not-required reason.</p>
    <p class="text-xs text-mocha">Not reviewed: <%= @review_counts.fetch('not_reviewed', 0) %> · Pending: <%= @review_counts.fetch('pending', 0) %> · Blocked: <%= @review_counts.fetch('blocked', 0) %> · Scope changed: <%= @review_counts.fetch('stale', 0) %></p>
    <%= fold_explainer('Code status and owner acceptance are separate. A scope-specific pass does not enable planned functionality or establish production readiness. New features start unreviewed; changed scope requires a fresh final review.', class: 'text-sm text-mocha') %>
    <div class="table-region" role="region" tabindex="0" aria-label="Owner feature reviews">
      <table class="table">
        <thead><tr><% ['Feature / current code status', 'Current published scope', 'Owner review'].each do |label| %><th class="th" scope="col"><%= label %></th><% end %><th class="th" scope="col"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody><% @features.each do |feature| %><% review = @feature_reviews.fetch(feature['id']) %><tr id="feature-<%= feature['id'] %>"><th scope="row" class="td align-top font-medium"><span class="font-mono text-xs text-taupe"><%= feature['id'] %> · <%= feature['area'] %></span><p class="mt-1"><%= feature['name'] %></p><p class="mt-2 text-xs text-mocha">Code: <%= feature['status'] %></p></th><td class="td align-top"><p class="max-w-xl"><%= feature['scope'] %></p></td><td class="td align-top"><span class="<%= owner_review_class(review['status']) %>"><%= owner_review_label(review['status']) %></span><% if review['tested_on'].present? %><p class="mt-2 text-xs text-mocha">Tested <%= review['tested_on'] %></p><% end %><% if review['evidence'].present? %><p class="mt-2 max-w-sm whitespace-pre-wrap text-xs text-mocha"><%= review['evidence'] %></p><% end %></td><td class="td align-top text-right"><%= link_to 'Review', feature_owner_checklist_path(@checklist, feature_id: feature['id']), class: 'btn-ghost btn-sm', data: { turbo: false } %></td></tr><% end %></tbody>
      </table>
    </div>
  </section>
  <%= render 'history' %>
</div>
