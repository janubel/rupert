<%= render 'privacy' %><% data = @checklist.data %><% content_for :title, data['name'] %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4"><div><%= link_to 'Owner checklists', owner_checklists_path, class: 'text-sm text-olive', data: { turbo: false } %><h1 class="page-title mt-3"><%= data['name'] %></h1><p class="mt-2 break-all font-mono text-sm text-mocha"><%= data['domain'] %></p></div><div class="flex flex-wrap gap-2"><%= link_to 'Edit owner details', edit_owner_checklist_path(@checklist), class: 'btn-ghost', data: { turbo: false } %><%= link_to 'Print private copy', print_owner_checklist_path(@checklist), class: 'btn-ghost', data: { turbo: false } %></div></section>
  <section class="card card-pad space-y-3"><h2 class="font-display text-xl">Domain purpose & contact</h2><p class="whitespace-pre-wrap text-sm"><%= data['purpose'] %></p><p class="text-sm text-mocha"><%= data['owner_name'].presence || 'Owner name not recorded' %> · <%= data['owner_email'].presence || 'Contact email not recorded' %><% if data['owner_phone'].present? %> · <%= data['owner_phone'] %><% end %></p><% if data['notes'].present? %><p class="whitespace-pre-wrap text-sm text-mocha"><%= data['notes'] %></p><% end %></section>
  <section class="space-y-4"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="font-display text-2xl">Service references</h2><p class="mt-1 text-sm text-mocha">Owner-reported login locations, renewal dates and support contacts. Dates do not send reminders; MFA labels are not provider verification.</p></div><%= link_to 'Add service reference', service_owner_checklist_path(@checklist), class: 'btn-primary', data: { turbo: false } %></div>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2"><% @checklist.services.each do |service_id, service| %><article id="service-<%= service_id %>" class="card card-pad space-y-3 <%= 'opacity-70' if owner_service_archived?(service) %>">
      <div class="flex flex-wrap items-start justify-between gap-3"><h3 class="font-display text-xl"><%= service['name'] %></h3><% if owner_service_archived?(service) %><span class="pill-taupe">Archived reference</span><% end %></div><p class="whitespace-pre-wrap text-sm"><%= service['purpose'] %></p>
      <% if (login = safe_login_url(service['login_url'])) %><%= link_to 'Open saved login', login, target: '_blank', rel: 'nofollow noopener noreferrer', referrerpolicy: 'no-referrer', class: 'btn-ghost btn-sm' %><p class="break-all font-mono text-xs text-taupe"><%= login %></p><% else %><p class="text-xs text-taupe">Login URL not recorded.</p><% end %>
      <div class="flex flex-wrap gap-2"><% service_schedules(service).each do |schedule| %><span class="<%= schedule[:state] == :overdue ? 'pill-rose' : schedule[:state] == :today ? 'pill-clay' : 'pill-taupe' %>"><%= schedule[:label] %><%= schedule[:state] == :overdue ? ' overdue' : schedule[:state] == :today ? ' today' : '' %> · <%= schedule[:date].iso8601 %></span><% end %></div>
      <dl class="grid grid-cols-1 gap-2 text-sm"><div><dt class="font-medium">Renewal</dt><dd class="text-mocha"><%= service['renewal_cadence'].to_s.humanize %> · <%= service['renewal_on'].presence || 'Date not set' %></dd><% if service['renewal_notes'].present? %><dd class="whitespace-pre-wrap text-mocha"><%= service['renewal_notes'] %></dd><% end %></div><div><dt class="font-medium">Periodic owner review</dt><dd class="text-mocha"><%= service['review_cadence'].to_s.humanize %> · <%= service['next_review_on'].presence || 'Next date not set' %></dd></div><div><dt class="font-medium">MFA / password-manager reference</dt><dd class="text-mocha">MFA: <%= service['mfa_status'].to_s.humanize %> · Vault label: <%= service['vault_reference'].presence || 'Not recorded' %></dd></div><div><dt class="font-medium">Support contact</dt><dd class="text-mocha"><%= [service['support_name'], service['support_email'], service['support_phone']].compact_blank.join(' · ').presence || 'Not recorded' %></dd></div></dl>
      <% if service['notes'].present? %><p class="whitespace-pre-wrap text-sm text-mocha"><%= service['notes'] %></p><% end %><%= link_to 'Edit service reference', service_owner_checklist_path(@checklist, service_id: service_id), class: 'btn-ghost btn-sm', data: { turbo: false } %>
    </article><% end %><% if @checklist.services.empty? %><div class="card card-pad text-sm text-mocha">No service references yet. Add the services this domain depends on, with actual dates and a vault label where helpful.</div><% end %></div>
  </section>
  <section class="card overflow-x-auto"><div class="card-pad space-y-2"><h2 class="font-display text-2xl">Owner feature reviews</h2><p id="owner-review-coverage" class="text-sm"><strong><%= @reviewed_count %> of <%= @features.length %></strong> reviewed with a current scope pass or a not-required reason.</p><p class="text-xs text-mocha">Not reviewed: <%= @review_counts.fetch('not_reviewed', 0) %> · Pending: <%= @review_counts.fetch('pending', 0) %> · Blocked: <%= @review_counts.fetch('blocked', 0) %> · Scope changed: <%= @review_counts.fetch('stale', 0) %></p><p class="text-sm text-mocha">Every current catalog feature appears below. Code status and owner acceptance are separate. A scope-specific pass does not enable planned functionality or establish production readiness. New features start unreviewed; changed scope requires a fresh final review.</p></div><table class="w-full text-left text-sm"><thead><tr><% ['Feature / current code status', 'Current published scope', 'Owner review', ''].each do |label| %><th class="th" scope="col"><%= label %></th><% end %></tr></thead><tbody class="divide-y divide-fog"><% @features.each do |feature| %><% review = @feature_reviews.fetch(feature['id']) %><tr id="feature-<%= feature['id'] %>"><th scope="row" class="td align-top font-medium"><span class="font-mono text-xs text-taupe"><%= feature['id'] %> · <%= feature['area'] %></span><p class="mt-1"><%= feature['name'] %></p><p class="mt-2 text-xs text-mocha">Code: <%= feature['status'] %></p></th><td class="td align-top"><p class="max-w-xl"><%= feature['scope'] %></p></td><td class="td align-top"><span class="<%= owner_review_class(review['status']) %>"><%= owner_review_label(review['status']) %></span><% if review['tested_on'].present? %><p class="mt-2 text-xs text-mocha">Tested <%= review['tested_on'] %></p><% end %><% if review['evidence'].present? %><p class="mt-2 max-w-sm whitespace-pre-wrap text-xs text-mocha"><%= review['evidence'] %></p><% end %></td><td class="td align-top"><%= link_to 'Review feature', feature_owner_checklist_path(@checklist, feature_id: feature['id']), class: 'btn-ghost btn-sm', data: { turbo: false } %></td></tr><% end %></tbody></table></section>
  <%= render 'history' %>
</div>
