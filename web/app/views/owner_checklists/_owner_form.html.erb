<div class="card card-pad">
<%= form_with scope: :owner_checklist, url: @checklist.persisted? ? owner_checklist_path(@checklist) : owner_checklists_path, method: @checklist.persisted? ? :patch : :post, data: { turbo: false }, autocomplete: 'off', class: 'space-y-6' do |form| %>
  <%= render 'errors' %><%= hidden_field_tag :lock_version, @checklist.lock_version if @checklist.persisted? %>
  <fieldset class="space-y-4">
    <legend class="card-title">Domain</legend>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :name, 'Checklist name', class: 'field-label' %><%= form.text_field :name, value: @owner_values['name'], required: true, maxlength: 160, class: 'input w-full', placeholder: 'Store operations' %></div><div><%= form.label :domain, 'Domain', class: 'field-label' %><%= form.text_field :domain, value: @owner_values['domain'], required: true, maxlength: 253, class: 'input w-full', placeholder: 'example.org' %></div></div>
    <div><%= form.label :purpose, 'What this domain is for', class: 'field-label' %><%= form.text_field :purpose, value: @owner_values['purpose'], required: true, maxlength: 1000, class: 'input w-full' %></div>
  </fieldset>
  <fieldset class="space-y-4">
    <legend class="card-title">Owner contact</legend>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :owner_name, 'Owner contact name', class: 'field-label' %><%= form.text_field :owner_name, value: @owner_values['owner_name'], required: true, maxlength: 160, class: 'input w-full' %></div><div><%= form.label :owner_email, 'Owner contact email', class: 'field-label' %><%= form.email_field :owner_email, value: @owner_values['owner_email'], maxlength: 254, class: 'input w-full' %></div></div>
    <div><%= form.label :owner_phone, 'Owner contact phone (optional)', class: 'field-label' %><%= form.telephone_field :owner_phone, value: @owner_values['owner_phone'], maxlength: 80, class: 'input w-full' %></div>
  </fieldset>
  <fieldset class="space-y-4">
    <legend class="card-title">Private notes</legend>
    <div><%= form.label :notes, 'Private operating notes', class: 'field-label' %><%= form.text_area :notes, value: @owner_values['notes'], rows: 5, maxlength: 2000, class: 'input w-full' %><p class="mt-1 text-xs text-taupe">Use references, not credentials. Keep passwords, tokens and recovery codes in a password manager.</p></div>
  </fieldset>
  <div class="form-actions"><%= form.submit 'Save', class: 'btn-primary' %><%= link_to 'Cancel', @checklist.persisted? ? owner_checklist_path(@checklist) : owner_checklists_path, class: 'btn-ghost', data: { turbo: false } %></div>
<% end %>
</div>
