<%= render 'privacy' %><% content_for :title, 'Owner checklists' %>
<div class="space-y-6">
  <%= page_header 'Owner checklists', subtitle: 'A private place for each domain’s purpose, service renewals and owner feature reviews.' do %>
    <%= link_to 'Add domain checklist', new_owner_checklist_path, class: 'btn-primary', data: { turbo: false } %>
  <% end %>
  <% if @checklists.empty? %>
    <%= empty_state 'No owner checklists yet', hint: 'Add a domain checklist to collect service references and review the current feature catalog.' do %>
      <%= link_to 'Add domain checklist', new_owner_checklist_path, class: 'btn-primary', data: { turbo: false } %>
    <% end %>
  <% else %>
    <section class="grid grid-cols-1 gap-4 lg:grid-cols-2" aria-label="Owner checklists">
      <% @checklists.each do |checklist| %><% data = checklist.data; active_services = checklist.services.values.reject { |service| owner_service_archived?(service) }; schedules = active_services.flat_map { |service| service_schedules(service) }; overdue = schedules.count { |entry| entry[:state] == :overdue }; today = schedules.count { |entry| entry[:state] == :today } %>
        <article class="section-card">
          <%= section_heading data['name'], hint: data['domain'], level: :h3 do %>
            <% if overdue.positive? %><span class="pill-rose"><%= overdue %> overdue dates</span><% end %>
            <% if today.positive? %><span class="pill-clay"><%= today %> due today</span><% end %>
          <% end %>
          <p class="text-sm text-mocha"><%= truncate(data['purpose'].to_s, length: 220) %></p>
          <p class="text-xs text-taupe"><%= active_services.length %> active service references · Updated <%= l(checklist.updated_at, format: :short) %></p>
          <%= link_to 'Open', owner_checklist_path(checklist), class: 'btn-ghost btn-sm', data: { turbo: false } %>
        </article>
      <% end %>
    </section>
  <% end %>
  <% if @pagy.pages > 1 %><%== @pagy.series_nav %><% end %>
  <%= fold_explainer('Only active owners in this workspace can open these records. Record account references and password-manager labels here; passwords, API keys, recovery codes and login tokens stay in your vault. Dates are manual planning references: this page does not send reminders or renew services.', class: 'text-sm text-mocha') %>
</div>
