<section class="card card-pad space-y-3"><h2 class="font-display text-xl">Private change history</h2><p class="text-sm text-mocha">Showing the latest <%= @events.length %> of <%= @event_count %> retained private events. Earlier history remains stored; this view and print copy show at most 20 events. Saved values are preserved in encrypted audit records.</p><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th class="th" scope="col">When</th><th class="th" scope="col">Owner</th><th class="th" scope="col">Action</th></tr></thead><tbody class="divide-y divide-fog"><% @events.each do |event| %><tr><td class="td"><%= event.created_at.iso8601 %></td><td class="td break-all"><%= owner_event_actor(event) %></td><td class="td"><%= event.action.to_s.humanize %></td></tr><% end %><% if @events.empty? %><tr><td class="td text-mocha" colspan="3">No recorded private changes.</td></tr><% end %></tbody></table></div></section>
