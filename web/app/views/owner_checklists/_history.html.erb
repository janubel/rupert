<section class="section-card">
  <%= section_heading 'Private change history', hint: "Showing the latest #{@events.length} of #{@event_count} retained private events. Earlier history remains stored; this view and the print copy show at most 20 events." %>
  <div class="table-region" role="region" tabindex="0" aria-label="Private change history">
    <table class="table">
      <thead><tr><th class="th" scope="col">When</th><th class="th" scope="col">Owner</th><th class="th" scope="col">Action</th></tr></thead>
      <tbody>
        <% @events.each do |event| %><tr><td class="td whitespace-nowrap"><%= l(event.created_at, format: :short) %></td><td class="td break-all"><%= owner_event_actor(event) %></td><td class="td"><%= event.action.to_s.humanize %></td></tr><% end %>
        <% if @events.empty? %><tr><td class="empty-row" colspan="3">No private changes recorded yet.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</section>
