<%= render 'privacy' %><% content_for :title, @service_id ? 'Edit service reference' : 'Add service reference' %>
<div class="page-narrow space-y-6">
  <%= page_header @service_id ? 'Edit service reference' : 'Add service reference', subtitle: 'What this service does, its real renewal dates and where the owner signs in. No vendor is contacted; keep credentials and recovery codes in your password manager.' %>
  <div class="card card-pad">
  <%= form_with scope: :owner_service, url: save_service_owner_checklist_path(@checklist), method: :patch, data: { turbo: false }, autocomplete: 'off', class: 'space-y-6' do |form| %>
    <%= render 'errors' %><%= hidden_field_tag :lock_version, @checklist.lock_version %><%= hidden_field_tag :service_id, @service_id if @service_id %>
    <fieldset class="space-y-4">
      <legend class="card-title">Service</legend>
      <div><%= form.label :name, 'Service name', class: 'field-label' %><%= form.text_field :name, value: @service_values['name'], required: true, maxlength: 160, class: 'input w-full' %></div>
      <div><%= form.label :purpose, 'What this service is for', class: 'field-label' %><%= form.text_field :purpose, value: @service_values['purpose'], required: true, maxlength: 1000, class: 'input w-full' %></div>
      <div><%= form.label :login_url, 'HTTPS login page', class: 'field-label' %><%= form.url_field :login_url, value: @service_values['login_url'], maxlength: 2048, class: 'input w-full', placeholder: 'https://accounts.example.org/login' %><p class="mt-1 text-xs text-taupe">Use a normal HTTPS login page with no username, password, query string, fragment or one-time sign-in token.</p></div>
    </fieldset>
    <fieldset class="space-y-4">
      <legend class="card-title">Renewal and periodic review</legend>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :renewal_cadence, 'Actual renewal cadence', class: 'field-label' %><%= form.select :renewal_cadence, OwnerChecklist::RENEWAL_CADENCES.map { |value| [value.humanize, value] }, { selected: @service_values['renewal_cadence'] || 'unspecified' }, class: 'select w-full' %></div><div><%= form.label :renewal_on, 'Next renewal date', class: 'field-label' %><%= form.date_field :renewal_on, value: @service_values['renewal_on'], class: 'input w-full' %></div></div>
      <div><%= form.label :renewal_notes, 'Renewal reference / instructions', class: 'field-label' %><%= form.text_area :renewal_notes, value: @service_values['renewal_notes'], rows: 3, maxlength: 2000, class: 'input w-full' %></div>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :review_cadence, 'Owner review cadence', class: 'field-label' %><%= form.select :review_cadence, OwnerChecklist::REVIEW_CADENCES.map { |value| [value.humanize, value] }, { selected: @service_values['review_cadence'] || 'unspecified' }, class: 'select w-full' %></div><div><%= form.label :next_review_on, 'Next owner review date', class: 'field-label' %><%= form.date_field :next_review_on, value: @service_values['next_review_on'], class: 'input w-full' %></div></div>
      <p class="text-xs text-taupe">Cadence labels do not calculate dates. Due badges use the dates you record; no reminders or automatic renewals are enabled.</p>
    </fieldset>
    <fieldset class="space-y-4">
      <legend class="card-title">Support and access references</legend>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :support_name, 'Support contact / team', class: 'field-label' %><%= form.text_field :support_name, value: @service_values['support_name'], maxlength: 160, class: 'input w-full' %></div><div><%= form.label :support_email, 'Support email', class: 'field-label' %><%= form.email_field :support_email, value: @service_values['support_email'], maxlength: 254, class: 'input w-full' %></div></div>
      <div><%= form.label :support_phone, 'Support phone', class: 'field-label' %><%= form.telephone_field :support_phone, value: @service_values['support_phone'], maxlength: 80, class: 'input w-full' %></div>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :mfa_status, 'Owner-reported MFA status', class: 'field-label' %><%= form.select :mfa_status, OwnerChecklist::MFA_STATUSES.map { |value| [value.humanize, value] }, { selected: @service_values['mfa_status'] || 'unknown' }, class: 'select w-full' %></div><div><%= form.label :vault_reference, 'Password-manager item label', class: 'field-label' %><%= form.text_field :vault_reference, value: @service_values['vault_reference'], maxlength: 200, class: 'input w-full', placeholder: 'Business vault / domain account' %><p class="mt-1 text-xs text-taupe">A label only. Never enter the password, secret URL or recovery code.</p></div></div>
    </fieldset>
    <fieldset class="space-y-4">
      <legend class="card-title">Notes</legend>
      <div><%= form.label :notes, 'Private service notes', class: 'field-label' %><%= form.text_area :notes, value: @service_values['notes'], rows: 4, maxlength: 2000, class: 'input w-full' %></div>
      <label class="flex items-start gap-2 text-sm"><%= form.check_box :archived, checked: owner_service_archived?(@service_values), class: 'checkbox mt-0.5' %><span>Archive this reference. Preserve its history and exclude its dates from active due badges.</span></label>
    </fieldset>
    <div class="form-actions"><%= form.submit 'Save', class: 'btn-primary' %><%= link_to 'Cancel', owner_checklist_path(@checklist), class: 'btn-ghost', data: { turbo: false } %></div>
  <% end %>
  </div>
</div>
