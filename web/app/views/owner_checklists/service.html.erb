<%= render 'privacy' %><% content_for :title, 'Service reference' %>
<div class="space-y-6"><section><%= link_to 'Private checklist', owner_checklist_path(@checklist), class: 'text-sm text-olive', data: { turbo: false } %><h1 class="page-title mt-3"><%= @service_id ? 'Edit service reference' : 'Add service reference' %></h1><p class="mt-2 max-w-3xl text-sm text-mocha">Record what this service does, its real renewal dates and where the owner signs in. No vendor is contacted. Keep credentials and recovery codes in your password manager.</p></section>
  <%= form_with scope: :owner_service, url: save_service_owner_checklist_path(@checklist), method: :patch, data: { turbo: false }, autocomplete: 'off', class: 'card card-pad space-y-5' do |form| %>
    <%= render 'errors' %><%= hidden_field_tag :lock_version, @checklist.lock_version %><%= hidden_field_tag :service_id, @service_id if @service_id %>
    <div><%= form.label :name, 'Service name', class: 'block text-sm font-medium' %><%= form.text_field :name, value: @service_values['name'], required: true, maxlength: 160, class: 'input mt-1 w-full' %></div>
    <div><%= form.label :purpose, 'What this service is for', class: 'block text-sm font-medium' %><%= form.text_field :purpose, value: @service_values['purpose'], required: true, maxlength: 1000, class: 'input mt-1 w-full' %></div>
    <div><%= form.label :login_url, 'HTTPS login page', class: 'block text-sm font-medium' %><%= form.url_field :login_url, value: @service_values['login_url'], maxlength: 2048, class: 'input mt-1 w-full', placeholder: 'https://accounts.example.org/login' %><p class="mt-1 text-xs text-taupe">Use a normal HTTPS login page with no username, password, query string, fragment or one-time sign-in token.</p></div>
    <fieldset class="space-y-4"><legend class="font-display text-xl">Renewal & periodic review</legend><div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :renewal_cadence, 'Actual renewal cadence', class: 'block text-sm font-medium' %><%= form.select :renewal_cadence, OwnerChecklist::RENEWAL_CADENCES.map { |value| [value.humanize, value] }, { selected: @service_values['renewal_cadence'] || 'unspecified' }, class: 'input mt-1 w-full' %></div><div><%= form.label :renewal_on, 'Next renewal date', class: 'block text-sm font-medium' %><%= form.date_field :renewal_on, value: @service_values['renewal_on'], class: 'input mt-1 w-full' %></div></div><div><%= form.label :renewal_notes, 'Renewal reference / instructions', class: 'block text-sm font-medium' %><%= form.text_area :renewal_notes, value: @service_values['renewal_notes'], rows: 3, maxlength: 2000, class: 'input mt-1 w-full' %></div><div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :review_cadence, 'Owner review cadence', class: 'block text-sm font-medium' %><%= form.select :review_cadence, OwnerChecklist::REVIEW_CADENCES.map { |value| [value.humanize, value] }, { selected: @service_values['review_cadence'] || 'unspecified' }, class: 'input mt-1 w-full' %></div><div><%= form.label :next_review_on, 'Next owner review date', class: 'block text-sm font-medium' %><%= form.date_field :next_review_on, value: @service_values['next_review_on'], class: 'input mt-1 w-full' %></div></div><p class="text-xs text-taupe">Cadence labels do not calculate dates. Due badges use the dates you record; no reminders or automatic renewals are enabled.</p></fieldset>
    <fieldset class="space-y-4"><legend class="font-display text-xl">Support & access references</legend><div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :support_name, 'Support contact / team', class: 'block text-sm font-medium' %><%= form.text_field :support_name, value: @service_values['support_name'], maxlength: 160, class: 'input mt-1 w-full' %></div><div><%= form.label :support_email, 'Support email', class: 'block text-sm font-medium' %><%= form.email_field :support_email, value: @service_values['support_email'], maxlength: 254, class: 'input mt-1 w-full' %></div></div><div><%= form.label :support_phone, 'Support phone', class: 'block text-sm font-medium' %><%= form.telephone_field :support_phone, value: @service_values['support_phone'], maxlength: 80, class: 'input mt-1 w-full' %></div><div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><%= form.label :mfa_status, 'Owner-reported MFA status', class: 'block text-sm font-medium' %><%= form.select :mfa_status, OwnerChecklist::MFA_STATUSES.map { |value| [value.humanize, value] }, { selected: @service_values['mfa_status'] || 'unknown' }, class: 'input mt-1 w-full' %></div><div><%= form.label :vault_reference, 'Password-manager item label', class: 'block text-sm font-medium' %><%= form.text_field :vault_reference, value: @service_values['vault_reference'], maxlength: 200, class: 'input mt-1 w-full', placeholder: 'Business vault / domain account' %><p class="mt-1 text-xs text-taupe">A label only. Never enter the password, secret URL or recovery code.</p></div></div></fieldset>
    <div><%= form.label :notes, 'Private service notes', class: 'block text-sm font-medium' %><%= form.text_area :notes, value: @service_values['notes'], rows: 4, maxlength: 2000, class: 'input mt-1 w-full' %></div><label class="flex items-start gap-2 text-sm"><%= form.check_box :archived, checked: owner_service_archived?(@service_values) %><span>Archive this reference. Preserve its history and exclude its dates from active due badges.</span></label><div class="flex flex-wrap gap-3"><%= form.submit 'Save service reference', class: 'btn-primary' %><%= link_to 'Cancel', owner_checklist_path(@checklist), class: 'btn-ghost', data: { turbo: false } %></div>
  <% end %>
</div>
