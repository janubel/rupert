<% profile = @profile %>
<% money = ->(cents) { cents.nil? ? nil : number_to_currency(cents / 100.0) } %>
<% content_for :title, profile.name %>
<div class="space-y-6">
  <%= page_header profile.name, subtitle: [profile.vendor && "From #{profile.vendor}", profile.product_type, @product&.status&.capitalize].compact.join(' · ').presence, eyebrow: 'Item' do %>
    <% if @variant.tracked %><span class="pill-fern">Tracked</span><% end %>
    <span class="<%= @link ? 'pill-fern' : 'pill-taupe' %>"><%= @link ? 'Linked to Square' : 'Not linked to Square' %></span>
    <span class="<%= profile.ctrax ? 'pill-fern' : 'pill-taupe' %>"><%= profile.ctrax ? 'Paired with C-Trax' : 'Not paired with C-Trax' %></span>
  <% end %>

  <section class="item-hero card card-pad" aria-label="Item">
    <div class="item-hero-image">
      <% if profile.image_url %>
        <%= image_tag profile.image_url, alt: profile.name, loading: 'lazy' %>
      <% else %>
        <span class="item-hero-placeholder" aria-hidden="true">No photo</span>
      <% end %>
    </div>
    <h2 class="item-hero-name"><%= @product&.title.presence || profile.name %></h2>
    <% if profile.option %><p class="item-hero-option"><%= profile.option %></p><% end %>
    <p class="item-hero-ids"><%= @variant.sku.presence ? "SKU #{@variant.sku}" : 'No SKU' %><%= " · Barcode #{@variant.barcode}" if @variant.barcode.present? %></p>
    <dl class="item-hero-facts">
      <div><dt>Price</dt><dd><%= money.call(profile.price_cents) || 'Unknown' %></dd></div>
      <div><dt>Cost of goods</dt><dd><%= money.call(profile.cost_cents) || 'Unknown' %></dd><p><%= profile.cost_note %></p></div>
      <div><dt>Margin per unit</dt><dd><%= profile.margin_cents ? "#{money.call(profile.margin_cents)} (#{profile.margin_percent}%)" : 'Unknown' %></dd><p>Price minus cost, before tax. An estimate, not profit.</p></div>
    </dl>
  </section>

  <section class="section-card" aria-labelledby="item-source-title">
    <h2 id="item-source-title" class="section-title">Source</h2>
    <dl class="facts">
      <div><dt>Vendor</dt><dd><%= profile.vendor || 'Not set in Shopify' %></dd></div>
      <div><dt>Product type</dt><dd><%= profile.product_type || 'Not set in Shopify' %></dd></div>
      <div><dt>C-Trax item</dt><dd><%= profile.ctrax ? "#{profile.ctrax[:record]['name']} (#{profile.ctrax[:how].downcase})" : 'Not paired' %></dd></div>
      <div><dt>Tags</dt><dd><%= profile.tags.any? ? profile.tags.join(', ') : 'None' %></dd></div>
    </dl>
    <% unless profile.ctrax %><p class="text-xs text-mocha">Pair it on <%= link_to 'Stock comparison', stock_comparison_path(filter: 'to_pair', q: @variant.sku.presence || @product&.title), class: 'underline' %> to see its C-Trax stock and cost here.</p><% end %>
  </section>

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="section-card" aria-labelledby="item-stock-title">
      <h2 id="item-stock-title" class="section-title">Stock everywhere</h2>
      <table class="table">
        <thead><tr><th scope="col" class="th">Platform</th><th scope="col" class="th">Where</th><th scope="col" class="th num">On hand</th></tr></thead>
        <tbody>
          <% profile.stock.each do |row| %>
            <tr><td class="td"><%= row.platform %></td><td class="td"><%= row.place %><% if row.note %><span class="block text-xs text-taupe"><%= row.note %></span><% end %></td>
              <td class="td num<%= ' text-rose font-semibold' if row.quantity.respond_to?(:negative?) && row.quantity.negative? %>"><%= row.quantity.nil? ? 'Unknown' : row.quantity %></td></tr>
          <% end %>
        </tbody>
      </table>
      <p class="mt-2 text-xs text-mocha">Each platform counts its own stock; they are shown side by side, never added together.</p>
    </section>

    <section class="section-card" aria-labelledby="item-sales-title">
      <h2 id="item-sales-title" class="section-title">Sold in the last <%= ItemProfile::SALES_DAYS %> days</h2>
      <% sales = profile.sales %>
      <% if sales.empty? %>
        <p class="text-sm text-taupe">No paid or fulfilled orders with this item in the last <%= ItemProfile::SALES_DAYS %> days. SwipeSimple and C-Trax register sales are not broken down by item here.</p>
      <% else %>
        <table class="table">
          <thead><tr><th scope="col" class="th">Source</th><th scope="col" class="th num">Units</th><th scope="col" class="th num">Gross</th></tr></thead>
          <tbody>
            <% sales.each do |sale| %>
              <tr><td class="td"><%= sale.source.to_s.titleize %> <span class="text-xs text-taupe"><%= sale.channel == 'pos' ? 'in store' : sale.channel %></span></td><td class="td num"><%= sale.units %></td><td class="td num"><%= money.call(sale.gross_cents) %></td></tr>
            <% end %>
          </tbody>
        </table>
        <p class="mt-2 text-xs text-mocha">Order lines matched by this item or its SKU. SwipeSimple and C-Trax register sales are not broken down by item here.</p>
      <% end %>
    </section>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="section-card">
      <%= section_heading 'Square link' %>
      <% if @link&.square_variation %>
        <div class="flex items-center justify-between gap-3 rounded-control bg-haze px-4 py-3">
          <div>
            <p class="text-sm font-medium text-ink"><%= @link.square_variation.name %></p>
            <p class="text-xs text-taupe"><%= @link.square_variation.sku.presence || 'no SKU' %> · linked <%= @link.matchSource %></p>
          </div>
          <% if Current.user.can?('inventory.write') %>
            <%= button_to 'Remove link', unlink_shopify_variant_path(@variant), method: :post, class: 'btn-ghost btn-sm', data: { turbo_confirm: 'Break this link? The next sync may re-link it by SKU.' } %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-taupe">No Square variation linked to this variant yet.</p>
      <% end %>

      <% if Current.user.can?('inventory.write') && @square_variations.any? %>
        <%= form_tag link_shopify_variant_path(@variant), method: :post, class: 'toolbar' do %>
          <div class="toolbar-field"><%= label_tag :square_variation_id, 'Link to a Square variation', class: 'field-label' %><%= select_tag :square_variation_id, options_from_collection_for_select(@square_variations, :id, :name_with_sku), class: 'select w-full' %></div>
          <div class="toolbar-actions"><%= submit_tag 'Link', class: 'btn-primary' %></div>
        <% end %>
      <% end %>
    </section>

  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="section-card">
      <%= section_heading 'Movements' %>
      <% if @movements.empty? %>
        <p class="text-sm text-taupe">No quantity movements recorded.</p>
      <% else %>
        <ul class="divide-y divide-fog">
          <% @movements.each do |m| %>
            <li class="flex items-center justify-between py-2 text-sm">
              <div class="min-w-0">
                <p class="truncate text-ink"><%= m.reason.presence || m.reference %></p>
                <p class="text-xs text-taupe"><%= l(m.createdAt, format: :short) %></p>
              </div>
              <span class="num font-mono text-xs <%= m.delta.negative? ? 'text-clay' : 'text-fern' %>"><%= m.delta >= 0 ? "+#{m.delta}" : m.delta %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="section-card">
      <%= section_heading 'Alerts' %>
      <% if @alerts.empty? %>
        <p class="text-sm text-taupe">No stock alerts for this variant.</p>
      <% else %>
        <ul class="divide-y divide-fog">
          <% @alerts.each do |a| %>
            <li class="flex items-center justify-between py-2 text-sm">
              <span class="text-ink"><%= a.quantity %> on hand</span>
              <span class="text-xs text-taupe"><%= a.createdAt.strftime('%b %e') %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
</div>
