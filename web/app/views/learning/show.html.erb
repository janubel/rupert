<% content_for :title, @lesson[:title] %>
<article class="mx-auto max-w-2xl space-y-6">
  <%= link_to '← All lessons and definitions', learning_index_path, class: 'text-sm font-semibold text-olive-deep underline' %>
  <header><p class="eyebrow text-olive-deep"><%= @lesson[:minutes] %> minute lesson</p><h1 class="page-title mt-2"><%= @lesson[:title] %></h1><p class="mt-3 text-mocha"><%= @lesson[:summary] %></p></header>
  <ol class="space-y-4">
    <% @lesson[:steps].each_with_index do |step, index| %>
      <li class="card card-pad flex gap-4"><span class="font-display text-2xl text-olive-deep" aria-hidden="true"><%= index + 1 %></span><p><%= step %></p></li>
    <% end %>
  </ol>
  <details class="card card-pad"><summary class="cursor-pointer font-semibold">Useful definitions</summary><dl class="mt-3 space-y-3"><% @lesson[:terms].each do |key| %><% label, definition = LearningCatalog::TERMS.fetch(key) %><div><dt class="font-semibold"><%= label %></dt><dd class="mt-1 text-sm text-mocha"><%= definition %></dd></div><% end %></dl></details>
  <%= form_with url: complete_learning_path(@lesson[:key]), method: :post, class: 'card card-pad space-y-4' do %>
    <fieldset><legend class="font-semibold"><%= @lesson[:question] %></legend><div class="mt-3 space-y-2"><% @lesson[:choices].each_with_index do |choice, index| %><label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-xl border border-fog p-3"><%= radio_button_tag :answer, index, params[:answer].to_s == index.to_s, required: true %><span class="text-sm"><%= choice %></span></label><% end %></div></fieldset>
    <%= submit_tag 'Check understanding', class: 'btn-primary' %>
    <p class="text-xs text-mocha">This saves your learning progress. It does not perform the task described in this lesson.</p>
  <% end %>
  <%= link_to @lesson[:action], @lesson[:destination], class: 'btn-ghost' %>
</article>
