<% content_for :title, @lesson[:title] %>
<% questions = @questions || LearningCatalog.questions(@lesson); wrong = @wrong || [] %>
<article class="mx-auto max-w-2xl space-y-6">
  <%= link_to '← All lessons and definitions', learning_index_path, class: 'text-sm font-semibold text-olive-deep underline' %>
  <header><p class="eyebrow text-olive-deep"><%= @lesson[:minutes] %> minute lesson<%= ' · Completed' if @journey.completed.include?(@lesson[:key]) %></p><h1 class="page-title mt-2"><%= @lesson[:title] %></h1><p class="mt-3 text-mocha"><%= @lesson[:summary] %></p></header>
  <nav class="flex flex-wrap gap-4 text-sm text-olive-deep" aria-label="Lesson sections"><a href="#lesson-steps" class="underline">1. Learn the task</a><a href="#lesson-example" class="underline">2. See an example</a><% if @lesson[:practice] %><a href="#lesson-try" class="underline">3. Try it</a><% end %><a href="#lesson-practice" class="underline"><%= @lesson[:practice] ? '4' : '3' %>. Check understanding</a></nav>
  <h2 id="lesson-steps" class="scroll-mt-6 font-display text-xl">Learn the task</h2>
  <ol class="space-y-4">
    <% @lesson[:steps].each_with_index do |step, index| %>
      <li class="card card-pad flex gap-4"><span class="font-display text-2xl text-olive-deep" aria-hidden="true"><%= index + 1 %></span><p><%= step %></p></li>
    <% end %>
  </ol>
  <% if Array(@lesson[:mistakes]).any? %>
    <section class="rounded-2xl border border-butter/60 bg-butter/10 p-5" aria-labelledby="mistakes-title">
      <h2 id="mistakes-title" class="font-display text-lg">Common mistakes</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-mocha"><% @lesson[:mistakes].each do |mistake| %><li><%= mistake %></li><% end %></ul>
    </section>
  <% end %>
  <% example = LearningExamples.for(@lesson[:key]) %>
  <section id="lesson-example" class="card card-pad space-y-4 scroll-mt-6" aria-labelledby="example-title">
    <div><p class="eyebrow text-olive-deep">Fictional worked example</p><h2 id="example-title" class="mt-2 font-display text-xl"><%= example[:title] %></h2></div>
    <p class="text-sm text-mocha"><%= example[:context] %></p>
    <dl class="divide-y divide-fog"><% example[:rows].each do |label, value| %><div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-3"><dt class="text-sm text-mocha"><%= label %></dt><dd class="text-sm font-semibold tabular-nums"><%= value %></dd></div><% end %></dl>
    <p class="rounded-xl bg-haze p-4 text-sm"><strong>What to take away:</strong> <%= example[:takeaway] %></p>
  </section>
  <% if @lesson[:practice] %>
    <% fields = { 'variance' => ['Counted quantity', 'Captured comparison quantity', '8', '10'], 'change' => ['Total due ($)', 'Cash received ($)', '43.16', '50'], 'average' => ['Recorded sales ($)', 'Included sales (count)', '50', '2'], 'cover' => ['Units on hand', 'Units sold in the last 30 days', '6', '30'] }.fetch(@lesson[:practice]) %>
    <section id="lesson-try" class="card card-pad space-y-4 scroll-mt-6" aria-labelledby="try-title" data-controller="practice" data-practice-kind-value="<%= @lesson[:practice] %>">
      <div><p class="eyebrow text-olive-deep">Try it with your own numbers</p><h2 id="try-title" class="mt-2 font-display text-xl">See the formula work</h2><p class="mt-1 text-sm text-mocha">Change either number. Nothing here is saved or sent anywhere.</p></div>
      <div class="practice-grid">
        <div><label for="practice-a" class="field-label"><%= fields[0] %></label><input id="practice-a" type="text" inputmode="decimal" class="input" value="<%= fields[2] %>" data-practice-target="a" data-action="input->practice#compute"></div>
        <div><label for="practice-b" class="field-label"><%= fields[1] %></label><input id="practice-b" type="text" inputmode="decimal" class="input" value="<%= fields[3] %>" data-practice-target="b" data-action="input->practice#compute"></div>
      </div>
      <p class="practice-result" data-practice-target="result" aria-live="polite">—</p>
      <p class="text-sm text-mocha" data-practice-target="explanation">Enter two numbers to see the calculation.</p>
    </section>
  <% end %>
  <details class="card card-pad"><summary class="cursor-pointer font-semibold">Useful definitions</summary><dl class="mt-3 space-y-3"><% @lesson[:terms].each do |key| %><% label, definition = LearningCatalog::TERMS.fetch(key) %><div id="lesson-term-<%= key %>"><dt class="font-semibold"><%= label %></dt><dd class="mt-1 text-sm text-mocha"><%= definition %></dd></div><% end %></dl></details>
  <%= form_with url: complete_learning_path(@lesson[:key]), method: :post, class: 'card card-pad space-y-4 scroll-mt-6', id: 'lesson-practice', data: { busy: false } do %>
    <h2 class="font-display text-xl">Check your understanding</h2>
    <% if @answer_error %><div id="answer-feedback" class="flash flash-alert" role="alert"><p><strong><%= wrong.size == 1 ? 'One answer' : "#{wrong.size} answers" %> to revisit.</strong></p><ul class="mt-1 list-disc pl-5"><% wrong.each do |index| %><li><%= questions[index][:explanation] %></li><% end %></ul><p class="mt-1">Try again below.</p></div><% end %>
    <% questions.each_with_index do |question, q_index| %>
      <% submitted = params.dig(:answers, q_index.to_s).presence || (q_index.zero? ? params[:answer].to_s.presence : nil) %>
      <fieldset class="quiz-question" aria-describedby="<%= 'answer-feedback' if @answer_error && wrong.include?(q_index) %>">
        <legend class="font-semibold"><% if questions.size > 1 %><span class="text-olive-deep"><%= q_index + 1 %>.</span> <% end %><%= question[:prompt] %><% if @answer_error && wrong.include?(q_index) %> <span class="pill-rose">Try again</span><% end %></legend>
        <div class="mt-3 space-y-2">
          <% question[:choices].each_with_index do |choice, index| %>
            <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-xl border border-fog p-3 <%= 'quiz-wrong' if @answer_error && wrong.include?(q_index) && submitted == index.to_s %>"><%= radio_button_tag "answers[#{q_index}]", index, submitted == index.to_s, required: true, id: "answers_#{q_index}_#{index}" %><span class="text-sm"><%= choice %></span></label>
          <% end %>
        </div>
      </fieldset>
    <% end %>
    <%= submit_tag 'Check understanding', class: 'btn-primary', data: { turbo_submits_with: 'Checking…' } %>
    <p class="text-xs text-mocha">Practice here only saves your learning progress. You can retry as often as you like.</p>
  <% end %>
  <section class="space-y-3 border-t border-fog pt-5"><h2 class="font-display text-xl">Ready to use it?</h2><p class="text-sm text-mocha">This opens your real workspace. Use the steps above as a checklist<% if (tour = PageTours.available(Current.user).find { |candidate| candidate.paths.any? { |prefix| @lesson[:destination] == prefix || @lesson[:destination].start_with?("#{prefix}/") } }) %>, and take the <%= tour.minutes %>-minute tour when you get there<% end %>.</p><div class="flex flex-wrap gap-3"><%= link_to @lesson[:action], @lesson[:destination], class: 'btn-ghost' %><% if tour && !@journey.tour_done?(tour.key) %><%= link_to "Open with the tour", "#{tour.path}?tour=1", class: 'btn-ghost' %><% end %><% if %w[tasks work].include?(@lesson[:key]) %><%= link_to 'Step-by-step project & task guide', projects_getting_started_path, class: 'btn-ghost' %><% end %></div></section>
</article>
