<% content_for :title, @lesson[:title] %>
<% questions = @questions || LearningCatalog.questions(@lesson); wrong = @wrong || [] %>
<article class="page-medium space-y-6">
  <%= page_header @lesson[:title], subtitle: @lesson[:summary] %>
  <p class="text-sm text-mocha"><span class="pill-taupe"><%= @lesson[:minutes] %> minute lesson</span><% if @journey.completed.include?(@lesson[:key]) %> <span class="pill-fern">Completed</span><% end %></p>
  <nav class="flex flex-wrap gap-4 text-sm text-olive-deep" aria-label="Lesson sections"><a href="#lesson-steps" class="underline">1. Learn the task</a><a href="#lesson-example" class="underline">2. See an example</a><% if @lesson[:practice] %><a href="#lesson-try" class="underline">3. Try it</a><% end %><a href="#lesson-practice" class="underline"><%= @lesson[:practice] ? '4' : '3' %>. Check understanding</a></nav>
  <% if @lesson[:video].present? %>
    <section class="section-card space-y-3" aria-labelledby="lesson-video-title">
      <h2 id="lesson-video-title" class="section-title">Watch it first</h2>
      <video class="lesson-video" controls preload="metadata" playsinline src="<%= @lesson[:video] %>">Your browser cannot play this video.</video>
      <% replay = PageTours.for_path(@lesson[:destination].to_s, Current.user) %>
      <% if replay %><p class="text-sm text-mocha">Then try it for real: <%= link_to "#{@lesson[:action]} with the guided tour", "#{replay.path}?tour=1", class: 'underline font-semibold text-olive-deep' %>.</p><% end %>
    </section>
  <% end %>
  <section id="lesson-steps" class="space-y-4 scroll-mt-6">
    <%= section_heading 'Learn the task' %>
    <ol class="space-y-4">
      <% @lesson[:steps].each_with_index do |step, index| %>
        <li class="card card-pad flex gap-4"><span class="font-display text-2xl text-olive-deep" aria-hidden="true"><%= index + 1 %></span><p><%= step %></p></li>
      <% end %>
    </ol>
  </section>
  <% if Array(@lesson[:mistakes]).any? %>
    <section class="section-card" aria-labelledby="mistakes-title">
      <h2 id="mistakes-title" class="section-title">Common mistakes</h2>
      <ul class="list-disc space-y-1 pl-5 text-sm text-mocha"><% @lesson[:mistakes].each do |mistake| %><li><%= mistake %></li><% end %></ul>
    </section>
  <% end %>
  <% example = LearningExamples.for(@lesson[:key]) %>
  <section id="lesson-example" class="section-card scroll-mt-6" aria-labelledby="example-title">
    <div><p class="eyebrow text-olive">Fictional worked example</p><h2 id="example-title" class="section-title mt-1"><%= example[:title] %></h2></div>
    <p class="text-sm text-mocha"><%= example[:context] %></p>
    <dl class="divide-y divide-fog"><% example[:rows].each do |label, value| %><div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-3"><dt class="text-sm text-mocha"><%= label %></dt><dd class="text-sm font-semibold tabular-nums"><%= value %></dd></div><% end %></dl>
    <p class="rounded-card bg-haze p-4 text-sm"><strong>What to take away:</strong> <%= example[:takeaway] %></p>
  </section>
  <% if @lesson[:practice] %>
    <% fields = { 'variance' => ['Counted quantity', 'Captured comparison quantity', '8', '10'], 'change' => ['Total due ($)', 'Cash received ($)', '43.16', '50'], 'average' => ['Recorded sales ($)', 'Included sales (count)', '50', '2'], 'cover' => ['Units on hand', 'Units sold in the last 30 days', '6', '30'] }.fetch(@lesson[:practice]) %>
    <section id="lesson-try" class="section-card scroll-mt-6" aria-labelledby="try-title" data-controller="practice" data-practice-kind-value="<%= @lesson[:practice] %>">
      <div><p class="eyebrow text-olive">Try it with your own numbers</p><h2 id="try-title" class="section-title mt-1">See the formula work</h2><p class="card-hint">Change either number. Nothing here is saved or sent anywhere.</p></div>
      <div class="practice-grid">
        <div><label for="practice-a" class="field-label"><%= fields[0] %></label><input id="practice-a" type="text" inputmode="decimal" class="input" value="<%= fields[2] %>" data-practice-target="a" data-action="input->practice#compute"></div>
        <div><label for="practice-b" class="field-label"><%= fields[1] %></label><input id="practice-b" type="text" inputmode="decimal" class="input" value="<%= fields[3] %>" data-practice-target="b" data-action="input->practice#compute"></div>
      </div>
      <p class="practice-result" data-practice-target="result" aria-live="polite">—</p>
      <p class="text-sm text-mocha" data-practice-target="explanation">Enter two numbers to see the calculation.</p>
    </section>
  <% end %>
  <details class="explainer card card-pad"><summary class="explainer-summary font-semibold">Useful definitions</summary><dl class="mt-3 space-y-3"><% @lesson[:terms].each do |key| %><% label, definition = LearningCatalog::TERMS.fetch(key) %><div id="lesson-term-<%= key %>"><dt class="font-semibold"><%= label %></dt><dd class="mt-1 text-sm text-mocha"><%= definition %></dd></div><% end %></dl></details>
  <%= form_with url: complete_learning_path(@lesson[:key]), method: :post, class: 'section-card scroll-mt-6', id: 'lesson-practice', data: { busy: false } do %>
    <h2 class="section-title">Check your understanding</h2>
    <% if @answer_error %><div id="answer-feedback" class="flash flash-alert" role="alert"><p><strong><%= wrong.size == 1 ? 'One answer' : "#{wrong.size} answers" %> to revisit.</strong></p><ul class="mt-1 list-disc pl-5"><% wrong.each do |index| %><li><%= questions[index][:explanation] %></li><% end %></ul><p class="mt-1">Try again below.</p></div><% end %>
    <% questions.each_with_index do |question, q_index| %>
      <% submitted = params.dig(:answers, q_index.to_s).presence || (q_index.zero? ? params[:answer].to_s.presence : nil) %>
      <fieldset class="quiz-question" aria-describedby="<%= 'answer-feedback' if @answer_error && wrong.include?(q_index) %>">
        <legend class="font-semibold"><% if questions.size > 1 %><span class="text-olive-deep"><%= q_index + 1 %>.</span> <% end %><%= question[:prompt] %><% if @answer_error && wrong.include?(q_index) %> <span class="pill-rose">Try again</span><% end %></legend>
        <div class="mt-3 space-y-2">
          <% question[:choices].each_with_index do |choice, index| %>
            <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-control border border-fog p-3 <%= 'quiz-wrong' if @answer_error && wrong.include?(q_index) && submitted == index.to_s %>"><%= radio_button_tag "answers[#{q_index}]", index, submitted == index.to_s, required: true, id: "answers_#{q_index}_#{index}" %><span class="text-sm"><%= choice %></span></label>
          <% end %>
        </div>
      </fieldset>
    <% end %>
    <div class="form-actions"><%= submit_tag 'Check understanding', class: 'btn-primary', data: { turbo_submits_with: 'Checking…' } %><p class="text-xs text-mocha">Practice here only saves your learning progress. You can retry as often as you like.</p></div>
  <% end %>
  <section class="section-card">
    <%= section_heading 'Ready to use it?', hint: "This opens your real workspace. Use the steps above as a checklist#{(tour = PageTours.available(Current.user).find { |candidate| candidate.paths.any? { |prefix| @lesson[:destination] == prefix || @lesson[:destination].start_with?("#{prefix}/") } }) ? ", and take the #{tour.minutes}-minute tour when you get there" : ''}." %>
    <div class="flex flex-wrap gap-3"><%= link_to @lesson[:action], @lesson[:destination], class: 'btn-primary' %><% if tour && !@journey.tour_done?(tour.key) %><%= link_to 'Open with the tour', "#{tour.path}?tour=1", class: 'btn-ghost' %><% end %><% if %w[tasks work].include?(@lesson[:key]) %><%= link_to 'Project and task guide', projects_getting_started_path, class: 'btn-ghost' %><% end %></div>
  </section>
</article>
