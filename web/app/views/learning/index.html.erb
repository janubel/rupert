<% content_for :title, 'Learn Rupert' %>
<div class="mx-auto max-w-4xl space-y-8">
  <header>
    <p class="eyebrow text-olive-deep">Your Rupert guide</p>
    <h1 class="page-title mt-2">Get comfortable. Get things done.</h1>
    <p class="mt-3 text-mocha">Short lessons for your everyday work. Start anywhere, check your understanding, and come back when you need a refresher.</p>
    <p class="mt-3 text-sm font-semibold"><%= (@lessons.map { |lesson| lesson[:key] } & @completed).size %> of <%= @lessons.size %> lessons complete</p>
  </header>
  <section class="grid gap-4 sm:grid-cols-2" aria-label="Training modules">
    <% @lessons.each do |lesson| %>
      <article class="card card-pad flex flex-col items-start gap-3">
        <p class="text-xs text-olive-deep"><%= @completed.include?(lesson[:key]) ? 'Completed · Review anytime' : "#{lesson[:minutes]} minute lesson" %></p>
        <h2 class="font-display text-xl"><%= lesson[:title] %></h2>
        <p class="text-sm text-mocha"><%= lesson[:summary] %></p>
        <%= link_to @completed.include?(lesson[:key]) ? 'Review lesson' : 'Start lesson', learning_path(lesson[:key]), class: 'btn-ghost mt-auto' %>
      </article>
    <% end %>
  </section>
  <section class="space-y-4" aria-labelledby="definitions-title">
    <h2 id="definitions-title" class="font-display text-2xl">Words and numbers, explained</h2>
    <%= form_with url: learning_index_path, method: :get do |form| %>
      <%= form.label :q, 'Find a definition', class: 'field-label' %>
      <div class="flex gap-2"><%= form.search_field :q, value: @query, class: 'input', placeholder: 'Try total, SKU or reconciliation' %><%= form.submit 'Find', class: 'btn-ghost' %></div>
    <% end %>
    <% if @terms.empty? %><p class="text-mocha">No matching definition. Try a shorter word or clear your search.</p><% end %>
    <dl class="card card-pad divide-y divide-fog">
      <% @terms.each do |key, (label, definition)| %>
        <div id="term-<%= key %>" class="py-3 scroll-mt-6"><dt class="font-semibold"><%= label %></dt><dd class="mt-1 text-sm text-mocha"><%= definition %></dd></div>
      <% end %>
    </dl>
  </section>
</div>
