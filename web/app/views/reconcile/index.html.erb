<% content_for :title, "Catalog Links" %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Catalog Links</h1>
      <p class="mt-1 max-w-2xl text-sm text-mocha">Which sellable items are the same across Shopify and Square. This is an identity audit only — Shopify and Square are separate locations with independent inventories, so different quantities are normal and never auto-corrected.</p>
    </div>
    <%= link_to "Download PDF snapshot", pdf_inventory_index_path, class: "btn-ghost", data: { turbo: false } %>
  </section>

  <section class="grid grid-cols-2 gap-4 md:grid-cols-4">
    <div class="stat">
      <p class="stat-label">Linked items</p>
      <p class="stat-value mt-1"><%= @summary[:linked] %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Matched SKUs</p>
      <p class="stat-value mt-1"><%= @summary[:matched] %></p>
    </div>
    <div class="stat">
      <p class="stat-label">SKU mismatches</p>
      <p class="stat-value mt-1 <%= @summary[:mismatched].positive? ? "text-clay" : "" %>"><%= @summary[:mismatched] %></p>
    </div>
    <div class="stat">
      <p class="stat-label">One-sided</p>
      <p class="stat-value mt-1"><%= @summary[:shopify_only] + @summary[:square_only] %></p>
      <p class="mt-1 text-xs text-taupe"><%= @summary[:shopify_only] %> Shopify-only · <%= @summary[:square_only] %> Square-only</p>
    </div>
  </section>

  <% if @size_groups.any? %>
    <section>
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <h2 class="font-display text-2xl text-ink">Size families</h2>
          <p class="mt-1 text-sm text-mocha">Each root product with the sizes derived from its gram bank. Sizes are managed on the <a href="<%= size_families_path %>" class="font-semibold text-olive hover:underline">Sizes</a> page, not here.</p>
        </div>
        <a href="<%= size_families_path %>" class="btn-ghost btn-sm">Manage on Sizes</a>
      </div>

      <% @size_groups.each do |group| %>
        <div class="card mt-4">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-fog bg-haze/40 px-5 py-3">
            <div class="flex items-center gap-3">
              <div>
                <h3 class="font-display text-lg text-ink"><%= group[:family].name %></h3>
                <p class="text-xs text-taupe"><%= group[:family].auto? ? "auto-apply" : "approval-only" %> · root grams <span class="font-semibold text-ink"><%= group[:root] ? number_with_precision(group[:root], precision: 1) : "—" %></span></p>
              </div>
              <span class="<%= group[:family].auto? ? "pill-fern" : "pill-taupe" %>"><%= group[:family].auto? ? "AUTO" : "APPROVAL" %></span>
            </div>
            <% if group[:pending_count].positive? %>
              <span class="pill-rose"><%= group[:pending_count] %> pending</span>
            <% end %>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="border-b border-fog bg-haze/60">
                <tr>
                  <th scope="col" class="th">Derives from</th>
                  <th scope="col" class="th">SKU</th>
                  <th scope="col" class="th text-right">Size</th>
                  <th scope="col" class="th text-right">Current</th>
                  <th scope="col" class="th text-right">Target</th>
                  <th scope="col" class="th text-right">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-fog">
                <% if group[:root_item] %>
                  <tr class="bg-haze/40">
                    <td class="td font-semibold text-ink">Root</td>
                    <td class="td font-mono text-xs text-ink"><%= group[:root_item][:sku] %></td>
                    <td class="td text-right text-mocha">1g</td>
                    <td class="td text-right font-semibold text-ink"><%= group[:root_item][:current] || "—" %></td>
                    <td class="td text-right text-taupe">—</td>
                    <td class="td text-right"><span class="pill-olive">root</span></td>
                  </tr>
                <% end %>
                <% group[:members].each do |m| %>
                  <tr>
                    <td class="td text-taupe"><%= group[:family].name %></td>
                    <td class="td font-mono text-xs text-ink"><%= m[:member].sku %></td>
                    <td class="td text-right font-medium text-ink"><%= m[:member].grams %>g</td>
                    <td class="td text-right text-mocha"><%= m[:current].nil? ? "—" : m[:current] %></td>
                    <td class="td text-right font-semibold text-olive"><%= m[:target].nil? ? "—" : m[:target] %></td>
                    <td class="td text-right">
                      <% if m[:pending] %>
                        <span class="pill-rose">pending → <%= m[:pending].target_quantity %></span>
                      <% elsif m[:target] && m[:target] == m[:current] %>
                        <span class="pill-fern">in sync</span>
                      <% elsif m[:target].nil? %>
                        <span class="pill-taupe">no root</span>
                      <% else %>
                        <span class="pill-taupe">derives on sync</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>

  <% pending_sizes = SizeChange.pending %>
  <% if pending_sizes.any? %>
    <div class="card overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-fog bg-haze/60 px-4 py-3">
        <div>
          <h2 class="font-display text-lg text-ink">Pending size changes (<%= pending_sizes.count %>)</h2>
          <p class="text-xs text-taupe">Derived sizes from your size families awaiting approval before writing to Square.</p>
        </div>
        <%= link_to "Review all", size_families_path, class: "btn-ghost btn-sm" %>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-fog bg-haze/60">
            <tr>
              <th scope="col" class="th">Family</th>
              <th scope="col" class="th">SKU</th>
              <th scope="col" class="th text-right">Grams</th>
              <th scope="col" class="th text-right">Root</th>
              <th scope="col" class="th text-right">Target</th>
              <th scope="col" class="th text-right"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-fog">
            <% pending_sizes.order(:sku).each do |change| %>
              <tr class="hover:bg-cream">
                <td class="td text-mocha"><%= change.family.name %></td>
                <td class="td font-mono text-xs text-ink"><%= change.sku %></td>
                <td class="td text-right text-mocha"><%= change.grams %></td>
                <td class="td text-right text-mocha"><%= number_with_precision(change.root_grams, precision: 1) %></td>
                <td class="td text-right font-semibold text-olive"><%= change.target_quantity %></td>
                <td class="td text-right">
                  <%= button_to "Approve", approve_size_family_path(change.family, change_id: change.id), method: :post, class: "btn-primary btn-sm", data: { confirm: "Write #{change.sku} to #{change.target_quantity} on Square?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <section>
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 class="font-display text-2xl text-ink">Linked items</h2>
      <p class="text-xs text-taupe">Mismatches first. Quantities shown per platform are independent on purpose.</p>
    </div>
    <div class="card mt-3 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-fog bg-haze/60">
            <tr>
              <th scope="col" class="th">SKU</th>
              <th scope="col" class="th">Shopify</th>
              <th scope="col" class="th">Square</th>
              <th scope="col" class="th text-right">Shopify qty</th>
              <th scope="col" class="th text-right">Square qty</th>
              <th scope="col" class="th text-right">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-fog">
            <% if @rows.empty? %>
              <tr>
                <td colspan="6" class="empty-row">No SKU links yet — run a sync first.</td>
              </tr>
            <% end %>
            <% @rows.each do |row| %>
              <tr class="hover:bg-cream">
                <td class="td font-mono text-xs text-mocha">
                  <%= row.sku %>
                  <% if row.status == "mismatched" %>
                    <span class="ml-1 text-[10px] text-clay">↔ <%= row.square_sku.presence || "no Square SKU" %></span>
                  <% end %>
                </td>
                <td class="td">
                  <p class="font-medium text-ink"><%= row.shopify_title %></p>
                  <p class="text-xs text-taupe"><%= row.product_title %></p>
                </td>
                <td class="td text-mocha"><%= row.square_name %></td>
                <td class="td text-right text-mocha"><%= row.shopify_qty %></td>
                <td class="td text-right text-mocha"><%= row.square_qty %></td>
                <td class="td text-right">
                  <% if row.status == "matched" %>
                    <span class="pill-fern">matched</span>
                  <% else %>
                    <span class="pill-clay">mismatched</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% if @pagy.pages > 1 %>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-xs text-taupe">
        <span>Showing <%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %> linked items.</span>
        <%== pagy_nav(@pagy) %>
      </div>
    <% end %>
  </section>
</div>
