<%= form_with model: location, class: 'space-y-4' do |f| %>
  <%= render 'shared/form_errors', model: location %>
  <fieldset class="space-y-4">
    <legend class="card-title">Location</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :name, 'Name', class: 'field-label' %>
        <%= f.text_field :name, class: 'input', placeholder: 'e.g. Downtown Store', autocomplete: 'off' %>
      </div>
      <div>
        <%= f.label :kind, 'Kind', class: 'field-label' %>
        <%= f.select :kind, %w[RETAIL VIRTUAL WAREHOUSE POPUP], { include_blank: '—' }, class: 'input' %>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :timezone, 'Timezone', class: 'field-label' %>
        <%= f.text_field :timezone, class: 'input', placeholder: 'e.g. America/New_York', autocomplete: 'off' %>
      </div>
      <div class="flex items-end pb-2">
        <label class="flex items-center gap-2 text-sm text-ink">
          <%= f.check_box :active, class: 'accent-olive' %>
          Active
        </label>
      </div>
    </div>
  </fieldset>
  <div class="form-actions">
    <%= f.submit 'Save', class: 'btn-primary', name: nil %>
    <%= link_to 'Cancel', (location.persisted? ? location : locations_path), class: 'btn-ghost' %>
  </div>
<% end %>
