<% content_for :title, @location.name %>
<% can_write = Current.user.can?('inventory.write') %>
<% menu = can_write ? [['Remove', location_path(@location), { method: :delete, data: { turbo_confirm: 'Remove this location?' } }]] : nil %>
<div class="space-y-6">
  <%= page_header @location.name, subtitle: 'Stock mirrored at this location.', menu: menu do %>
    <% if can_write %><%= link_to 'Edit', edit_location_path(@location), class: 'btn-primary' %><% end %>
  <% end %>

  <dl class="facts">
    <div><dt>Source</dt><dd><span class="pill-taupe capitalize"><%= @location.source %></span></dd></div>
    <div><dt>Kind</dt><dd class="capitalize"><%= @location.kind.present? ? @location.kind.downcase : '—' %></dd></div>
    <div><dt>Status</dt><dd><% if @location.active %><span class="pill-fern">Active</span><% else %><span class="pill-taupe">Inactive</span><% end %></dd></div>
    <% if @location.timezone.present? %><div><dt>Timezone</dt><dd><%= @location.timezone %></dd></div><% end %>
  </dl>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3">
    <div class="stat">
      <p class="stat-label">Mirrored units</p>
      <p class="stat-value mt-1"><%= @total_units %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Tracked SKUs</p>
      <p class="stat-value mt-1"><%= @levels.count %></p>
    </div>
  </section>

  <div class="card overflow-hidden">
    <div class="card-pad pb-3"><%= section_heading 'Stock at this location' %></div>
    <div class="table-region" role="region" tabindex="0" aria-label="Stock at <%= @location.name %>">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">SKU</th>
            <th scope="col" class="th">Item</th>
            <th scope="col" class="th num">Quantity</th>
            <th scope="col" class="th num">Available</th>
          </tr>
        </thead>
        <tbody>
          <% if @levels.empty? %>
            <tr><td colspan="4" class="empty-row">No stock recorded at this location. Run a sync to read its stock.</td></tr>
          <% end %>
          <% @levels.each do |level| %>
            <tr>
              <td class="td font-mono text-xs text-mocha"><%= level.shopify_variant&.sku.presence || '—' %></td>
              <td class="td font-medium text-ink"><%= level.shopify_variant&.title.presence || '—' %></td>
              <td class="td num text-mocha"><%= level.quantity %></td>
              <td class="td num text-mocha"><%= level.available %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
