<% content_for :title, @location.name %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title"><%= @location.name %></h1>
      <p class="mt-1 text-sm text-mocha">
        <span class="pill-taupe capitalize"><%= @location.source %></span>
        <% if @location.kind %><span class="ml-2 text-taupe capitalize"><%= @location.kind.downcase %></span><% end %>
        <% if @location.active %><span class="ml-2 pill-fern">active</span><% else %><span class="ml-2 pill-taupe">inactive</span><% end %>
      </p>
    </div>
    <% if Current.user.can?("inventory.write") %>
      <div class="flex gap-2">
        <%= link_to "Back to locations", locations_path, class: "btn-ghost btn-sm" %>
        <%= link_to "Edit", edit_location_path(@location), class: "btn-ghost btn-sm" %>
        <%= button_to "Remove", @location, method: :delete, class: "btn-ghost btn-sm", data: { confirm: "Remove this location?" } %>
      </div>
    <% end %>
  </section>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3">
    <div class="stat">
      <p class="stat-label">Mirrored units</p>
      <p class="stat-value mt-1"><%= @total_units %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Tracked SKUs</p>
      <p class="stat-value mt-1"><%= @levels.count %></p>
    </div>
  </section>

  <div class="card overflow-hidden">
    <div class="border-b border-fog px-5 py-3">
      <h2 class="font-display text-lg text-ink">Stock at this location</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">SKU</th>
            <th scope="col" class="th">Item</th>
            <th scope="col" class="th text-right">Quantity</th>
            <th scope="col" class="th text-right">Available</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @levels.empty? %>
            <tr><td colspan="4" class="empty-row">No stock recorded at this location.</td></tr>
          <% end %>
          <% @levels.each do |level| %>
            <tr class="hover:bg-cream">
              <td class="td font-mono text-xs text-mocha"><%= level.shopify_variant&.sku.presence || "—" %></td>
              <td class="td font-medium text-ink"><%= level.shopify_variant&.title.presence || "—" %></td>
              <td class="td text-right text-mocha"><%= level.quantity %></td>
              <td class="td text-right text-mocha"><%= level.available %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
