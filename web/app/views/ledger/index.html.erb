<% content_for :title, "Ledger" %>
<div class="space-y-6">
  <section>
    <h1 class="page-title">Ledger</h1>
    <p class="mt-1 text-sm text-mocha">Central transaction ledger across Shopify and Square.</p>
  </section>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3">
    <div class="stat">
      <p class="stat-label">Total · <%= @window_days %> days</p>
      <p class="stat-value mt-1"><%= number_to_currency(@total_cents / 100.0) %></p>
      <p class="mt-1 text-xs text-taupe"><%= @entries.length %> shown</p>
    </div>
    <% @groups.each do |source, gross, count| %>
      <div class="stat">
        <p class="stat-label capitalize"><%= source %></p>
        <p class="stat-value mt-1"><%= number_to_currency(gross.to_i / 100.0) %></p>
        <p class="mt-1 text-xs text-taupe"><%= count %> orders</p>
      </div>
    <% end %>
  </section>

  <%= form_tag ledger_index_path, method: :get, class: "flex flex-wrap items-center gap-3" do %>
    <%= select_tag :window, options_for_select([["Last 7 days", 7], ["Last 30 days", 30], ["Last 90 days", 90], ["Last year", 365]], @window_days), class: "select" %>
    <%= select_tag :source, options_for_select([["All sources", "all"], ["Shopify", "shopify"], ["Square", "square"]], @source), class: "select" %>
    <%= submit_tag "Filter", class: "btn-ghost btn-sm" %>
  <% end %>

  <% cached_fragment("ledger/table", source: @source, window: @window_days) do %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th">Source</th>
            <th scope="col" class="th">Order</th>
            <th scope="col" class="th text-right">Gross</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th text-right">Lines</th>
            <th scope="col" class="th">Summary</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @entries.empty? %>
            <tr>
              <td class="empty-row">No ledger entries in this range.</td>
            </tr>
          <% end %>
          <% @entries.each do |entry| %>
            <tr class="hover:bg-cream">
              <td class="td whitespace-nowrap text-mocha"><%= l(entry.occurredAt, format: :short) %></td>
              <td class="td"><span class="pill-taupe capitalize"><%= entry.source %></span></td>
              <td class="td font-medium text-ink"><%= entry.orderName.presence || entry.sourceOrderId.first(12) %></td>
              <td class="td text-right font-medium text-ink"><%= number_to_currency(entry.grossCents / 100.0) %></td>
              <td class="td">
                <span class="<%= %w[PAID COMPLETED CLOSED].include?(entry.status) ? "pill-fern" : "pill-taupe" %>"><%= entry.status %></span>
              </td>
              <td class="td text-right text-mocha"><%= entry.lineItems %></td>
              <td class="td max-w-[220px] truncate text-xs text-taupe"><%= entry.summary.presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% end %>
</div>
