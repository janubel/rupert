<%# Workspace request: a Form page (docs/ui-standards.md §4). %>
<% content_for :title, 'Request a workspace' %>
<div class="page-narrow space-y-6 pt-6">
  <%= page_header 'Request a workspace', subtitle: 'Use a Google account with your company email domain; the platform owner reviews your request before creating a separate workspace.', eyebrow: 'Rupert' %>
  <%= fold_explainer('We verify that you can receive email at this domain, not legal ownership of the domain. No payment account, provider connection or DNS configuration is created. Referral attribution: ' + WorkspaceSignup::REFERRAL_DOMAIN + '. This label grants the referrer no access to your workspace.', class: 'text-sm text-mocha') %>

  <%= form_with scope: :workspace_signup, url: signup_path, method: :post, data: { turbo: false }, class: 'card card-pad space-y-4' do |f| %>
    <% if @signup.errors.any? %>
      <div role="alert" class="flash flash-alert"><%= @signup.errors.full_messages.to_sentence %></div>
    <% end %>
    <fieldset class="space-y-3">
      <legend class="card-title">Your company</legend>
      <div>
        <%= f.label :workspace_name, 'Company / workspace name', class: 'field-label' %>
        <%= f.text_field :workspace_name, value: @signup.workspace_name, required: true, maxlength: 160, class: 'input' %>
      </div>
      <div>
        <%= f.label :domain, 'Company email domain', class: 'field-label' %>
        <%= f.text_field :domain, value: @signup.domain, placeholder: 'company.com', required: true, maxlength: 253, class: 'input', autocapitalize: 'none', spellcheck: false %>
        <p class="mt-1 text-xs text-mocha">Your Google email must end with this exact domain. Personal email services are not eligible.</p>
      </div>
      <div>
        <%= f.label :requested_subdomain, 'Workspace name in Rupert', class: 'field-label' %>
        <%= f.text_field :requested_subdomain, value: @signup.requested_subdomain, placeholder: 'your-company', required: true, minlength: 2, maxlength: 63, pattern: '[a-z0-9][a-z0-9\-]*[a-z0-9]', class: 'input', autocapitalize: 'none', spellcheck: false %>
        <p class="mt-1 text-xs text-mocha">Choose 2–63 lowercase letters, numbers or hyphens. A requested name does not create a working hostname.</p>
      </div>
    </fieldset>
    <div class="form-actions">
      <%= f.submit 'Verify company email with Google', class: 'btn-primary' %>
      <%= link_to 'Sign in instead', login_path, class: 'btn-ghost' %>
    </div>
  <% end %>
</div>
