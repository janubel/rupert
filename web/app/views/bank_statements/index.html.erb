<% waiting_total = @statements.sum { |row| row[3].to_i } %>
<div class="space-y-6">
  <%= page_header 'Bank transactions', subtitle: 'Upload a statement CSV from your bank, then say what each withdrawal was.' do %>
    <% if @can_write %><%= link_to 'Import bank statement', '#upload-statement', class: 'btn-primary' %><% end %>
  <% end %>
  <% if waiting_total.positive? %>
    <p class="rounded-card border border-warn-edge bg-warn-bg p-4 text-sm" role="status"><strong><%= pluralize(waiting_total, 'line') %></strong> across your statements still need a decision. Undecided withdrawals are missing from money out.</p>
  <% end %>

  <% if @form_error %><p role="alert" class="flash flash-alert"><%= @form_error %></p><% end %>

  <section class="space-y-3" aria-labelledby="statements-title">
    <%= section_heading 'Uploaded statements', id: 'statements-title' %>
    <div class="table-region" role="region" tabindex="0" aria-label="Uploaded statements"><table class="table">
      <thead><tr><% %w[Account File Dates].each do |h| %><th scope="col" class="th"><%= h %></th><% end %><th scope="col" class="th num">Lines</th><th scope="col" class="th">Waiting<%= define('decision') %></th></tr></thead>
      <tbody>
        <% @statements.each do |doc_id, label, total, waiting, from, to| %>
          <tr>
            <td class="td"><%= link_to label, bank_statement_path(doc_id), class: 'font-semibold text-olive-deep hover:underline' %></td>
            <td class="td text-xs text-taupe"><%= @documents[doc_id]&.filename %></td>
            <td class="td"><%= from %> – <%= to %></td>
            <td class="td num"><%= total %></td>
            <td class="td"><% if waiting.to_i.zero? %><span class="pill-fern">All decided</span><% else %><%= link_to "#{waiting} to review", bank_statement_path(doc_id), class: 'pill-clay' %><% end %></td>
          </tr>
        <% end %>
        <% if @statements.empty? %><tr><td colspan="5" class="empty-row">No statements yet. Import your first statement below.</td></tr><% end %>
      </tbody>
    </table></div>
  </section>

  <% if @can_write %>
    <section class="section-card page-narrow" id="upload-statement" aria-labelledby="upload-statement-title">
      <%= section_heading 'Import a statement', id: 'upload-statement-title', hint: 'Up to 5,000 rows and 8 MiB. The original file and descriptions are kept encrypted.' %>
      <%= form_with url: bank_statements_path, multipart: true, class: 'space-y-4' do |f| %>
        <fieldset class="space-y-3">
          <legend class="sr-only">Statement</legend>
          <div><%= f.label :account_label, 'Account name (a name, never the account number)', class: 'field-label' %><%= f.text_field :account_label, value: params[:account_label], required: true, maxlength: 60, placeholder: 'Operating checking', class: 'input' %></div>
          <div><%= f.label :file, 'Statement CSV', class: 'field-label' %><%= f.file_field :file, accept: '.csv,text/csv', required: true, class: 'input' %></div>
          <label class="flex items-start gap-3 text-sm"><%= f.check_box :withdrawals_positive, { class: 'mt-1', checked: params[:withdrawals_positive] == '1' }, '1', '0' %><span>My bank lists withdrawals as positive numbers in one Amount column (leave unticked if withdrawals are negative or there are separate Debit and Credit columns).</span></label>
        </fieldset>
        <div class="form-actions"><%= f.submit 'Import statement', class: 'btn-primary', data: { turbo_submits_with: 'Importing…' } %></div>
      <% end %>
    </section>
  <% end %>

  <div class="flex flex-wrap items-start gap-1 text-xs text-mocha">
    <%= fold_explainer('Rupert has no connection to your bank. Nothing is recorded until you choose it, and a line is never imported twice.') %>
    <span class="inline-flex gap-1"><%= define('decision') %><%= define('statement_balance') %></span>
  </div>
</div>
