<% content_for :title, 'Review bank statement' %>
<% money = ->(cents) { number_to_currency(cents.abs / 100.0) } %>
<div class="mx-auto max-w-6xl space-y-6 operations-workspace">
  <%= render 'shared/operations_navigation', workspace: :finance %>
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-mocha">Bank statement</p>
      <h1 class="page-title mt-2"><%= @document.filename %></h1>
      <p class="mt-2 text-sm text-mocha"><%= @document.period_from %> to <%= @document.period_to %> · <%= @counts.fetch('pending', 0) %> to review · <%= @counts.fetch('recorded', 0) %> recorded · <%= @counts.fetch('ignored', 0) %> ignored.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to 'Back to statements', bank_statements_path, class: 'btn-ghost btn-sm' %>
      <%= link_to(@filter == 'all' ? 'Only waiting' : 'Show everything', bank_statement_path(@document.id, show: (@filter == 'all' ? 'pending' : 'all')), class: 'btn-ghost btn-sm') %>
      <%= link_to 'Original file', document_daily_reconciliation_path(@document), class: 'btn-ghost btn-sm', data: { turbo: false } %>
    </div>
  </header>

  <% if @lines.empty? %>
    <p class="card card-pad text-sm text-mocha">Nothing waiting. Every line has a decision.</p>
  <% else %>
    <%= form_with url: decide_bank_statement_path(@document.id), class: 'space-y-4' do |f| %>
      <%= hidden_field_tag :show, @filter %>
      <div class="card overflow-x-auto"><table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60"><tr>
          <th scope="col" class="th">Date</th><th scope="col" class="th">Description</th><th scope="col" class="th text-right">Out</th><th scope="col" class="th text-right">In</th><th scope="col" class="th">What was it?</th>
        </tr></thead>
        <tbody class="divide-y divide-fog">
          <% @lines.each do |line| %>
            <tr>
              <td class="td whitespace-nowrap"><%= line.posted_on.strftime('%b %-d, %Y') %></td>
              <td class="td max-w-md break-words"><%= line.description %></td>
              <td class="td text-right"><%= line.money_out? ? money.call(line.amount_cents) : '' %></td>
              <td class="td text-right"><%= line.money_out? ? '' : money.call(line.amount_cents) %></td>
              <td class="td">
                <% if !line.pending? %>
                  <%= line.status.humanize %><%= " by #{line.decided_by_name}" if line.decided_by_name %>
                <% elsif @can_write %>
                  <% groups = [['', [['Decide later', 'leave']]]] %>
                  <% if line.money_out? %>
                    <% groups << ['Expense', Finance::Expense::CATEGORIES.map { |c| [c.humanize, "expense:#{c}"] }] %>
                    <% groups << ['Vendor payment', @vendors.map { |v| [v.name, "payment:#{v.id}"] }] if @vendors.any? %>
                  <% end %>
                  <% groups << ['Not a business expense', [['Ignore this line (transfer, deposit, personal)', 'ignore']]] %>
                  <%= select_tag "decisions[#{line.id}]", grouped_options_for_select(groups, nil), class: 'select', 'aria-label': "Decision for #{line.description.first(40)}" %>
                  <% if line.money_out? %><span class="block text-xs text-taupe">Suggestion: <%= line.suggested_category.humanize %></span><% end %>
                <% else %>
                  Waiting
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
      <% if @can_write %>
        <%= f.submit 'Save my decisions', class: 'btn-primary' %>
        <p class="text-xs text-mocha">Only lines where you picked something are changed. Each one records your name and the time, appears in the Activity log, and is never deleted. If a line falls in a day you already approved, that approval will show as changed.</p>
      <% end %>
    <% end %>
  <% end %>
</div>
