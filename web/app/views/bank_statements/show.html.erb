<% content_for :title, "#{@document.filename} · Bank transactions" %>
<% money = ->(cents) { finance_money_text(cents.abs) }
   total_lines = @counts.values.sum; decided = total_lines - @counts.fetch('pending', 0)
   menu = [['Download original file', document_daily_reconciliation_path(@document), { data: { turbo: false } }],
           ["Open bookkeeping for #{@document.period_from.strftime('%B %Y')}", bookkeeping_path(month: @document.period_from.strftime('%Y-%m'))]]
   menu << ['Edit expense categories', finance_expense_categories_path] if Current.user.can?('finance.read')
   tabs = [['Waiting', bank_statement_path(@document.id, show: 'pending'), @filter == 'pending'], ['Everything', bank_statement_path(@document.id, show: 'all'), @filter == 'all']]
   tabs << ["Flagged · #{@flagged_count}", bank_statement_path(@document.id, show: 'flagged'), @filter == 'flagged'] if @flagged_count.positive? || @filter == 'flagged' %>
<div class="space-y-6">
  <%= page_header @document.filename, eyebrow: 'Bank statement', subtitle: "#{@document.period_from.strftime('%b %-d')} – #{@document.period_to.strftime('%b %-d, %Y')} · #{@counts.fetch('pending', 0)} to review.", menu: menu %>

  <section class="section-card" aria-label="Review progress">
    <dl class="facts">
      <div><dt>Lines decided</dt><dd><%= decided %> of <%= pluralize(total_lines, 'line') %></dd></div>
      <div><dt>Decided as</dt><dd><%= @counts.fetch('recorded', 0) %> recorded · <%= @counts.fetch('ignored', 0) %> ignored · <%= @counts.fetch('matched', 0) %> matched</dd></div>
      <div><dt>Flagged</dt><dd><%= @flagged_count.positive? ? "#{@flagged_count} for your clarification" : 'None' %></dd></div>
      <div><dt>Statement</dt><dd><%= @document.metadata['note'].presence || @document.filename %></dd></div>
    </dl>
    <div class="desk-meter max-w-md" role="progressbar" aria-valuemin="0" aria-valuemax="<%= total_lines %>" aria-valuenow="<%= decided %>" aria-label="Lines decided"><span style="width: <%= total_lines.zero? ? 0 : decided * 100 / total_lines %>%"></span></div>
    <% if @flagged_count.positive? %><p class="text-sm">Open questions stay pending until you decide.</p><% end %>
  </section>

  <%= page_tabs(tabs, label: 'Statement lines') %>

  <% if @lines.empty? %>
    <%= empty_state(@filter == 'flagged' ? 'No flagged questions waiting' : 'Nothing waiting', hint: @filter == 'flagged' ? 'Every flagged line has a decision.' : 'Every line has a decision.') do %>
      <% if Current.user.can?('reports.read') %><%= link_to 'Open Close & review', books_desk_path, class: 'btn-ghost' %><% end %>
    <% end %>
  <% else %>
    <%= form_with url: decide_bank_statement_path(@document.id), class: 'space-y-4', data: { controller: 'bank-decisions', action: 'submit->bank-decisions#submit' } do |f| %>
      <% suggest = @can_write && @lines.any? { |l| l.pending? && l.money_out? && @suggestions[l.id] != 'other' }
         deposits = @can_write && @lines.any? { |l| l.pending? && l.money_in? } %>
      <% if suggest || deposits %>
        <div class="card">
          <ul class="row-list text-sm">
            <% if suggest %>
              <li class="row-item">
                <p class="min-w-0 text-mocha">Rupert recognised some payees (rent, utilities, shipping, software…). Fill those in and check each one.</p>
                <div class="row-item-end">
                  <button type="button" class="btn-ghost btn-sm" data-action="bank-decisions#fillSuggestions" data-bank-decisions-target="fill">Use suggestions</button>
                  <button type="button" class="btn-ghost btn-sm" data-action="bank-decisions#clear">Clear choices</button>
                </div>
              </li>
            <% end %>
            <% if deposits %>
              <li class="row-item">
                <p class="min-w-0 text-mocha">Deposits are money received, never expenses. Accept them in one go and add who each came from if you like.</p>
                <div class="row-item-end"><button type="button" class="btn-ghost btn-sm" data-action="bank-decisions#acceptDeposits" data-bank-decisions-target="deposits">Accept all deposits</button></div>
              </li>
            <% end %>
          </ul>
          <p class="row-list-foot text-xs text-mocha">Nothing is recorded until you press Save.</p>
        </div>
      <% end %>
      <%= hidden_field_tag :show, @filter %>
      <%= hidden_field_tag :page, @pagy.page if @pagy.pages > 1 %>
      <% if @pagy.pages > 1 %>
        <nav class="flex flex-wrap items-center justify-between gap-3 text-sm" aria-label="Statement pages">
          <p class="text-mocha">Lines <%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %>. Save this page before moving to the next; choices on other pages are not kept.</p>
          <div class="flex gap-2">
            <% if @pagy.previous %><%= link_to 'Previous lines', bank_statement_path(@document.id, show: @filter, page: @pagy.previous), class: 'btn-ghost btn-sm', rel: 'prev' %><% end %>
            <% if @pagy.next %><%= link_to 'Next lines', bank_statement_path(@document.id, show: @filter, page: @pagy.next), class: 'btn-ghost btn-sm', rel: 'next' %><% end %>
          </div>
        </nav>
      <% end %>
      <div class="table-region" role="region" tabindex="0" aria-label="Statement lines"><table class="table">
        <thead><tr>
          <th scope="col" class="th">Date</th><th scope="col" class="th">Description</th><th scope="col" class="th num">Out<%= define('expense') %></th><th scope="col" class="th num">In<%= define('deposit') %></th><th scope="col" class="th">What was it?<%= define('decision') %></th>
        </tr></thead>
        <tbody>
          <% @lines.each do |line| %>
            <tr id="bank-line-<%= line.id %>" class="<%= 'bank-flagged' if line.review_flag? %>">
              <td class="td whitespace-nowrap"><%= line.posted_on.strftime('%b %-d, %Y') %></td>
              <td class="td max-w-md break-words"><%= line.description %>
                <% if line.review_category.present? %><span class="mt-1 block text-xs font-semibold"><%= '⚑ ' if line.review_flag? %><%= line.review_category_label %></span><% end %>
                <% if line.review_note.present? %><span class="bank-review-note"><%= line.review_note %></span><% end %>
                <% if line.money_in? %>
                  <% if @can_write %>
                    <label class="mt-2 block text-xs text-mocha" for="payer-<%= line.id %>">Received from</label>
                    <%= text_field_tag "payers[#{line.id}]", line.counterparty, id: "payer-#{line.id}", class: 'input mt-1 max-w-xs py-1 text-sm', maxlength: 120, placeholder: 'e.g. Shopify payout, customer name',
                          data: { bank_decisions_target: 'payer', original: line.counterparty.to_s, action: 'input->bank-decisions#sync' } %>
                  <% elsif line.counterparty.present? %>
                    <span class="mt-1 block text-xs">Received from <strong><%= line.counterparty %></strong></span>
                  <% end %>
                <% end %>
              </td>
              <td class="td num"><%= line.money_out? ? "−#{money.call(line.amount_cents)}" : '' %></td>
              <td class="td num"><%= line.money_out? ? '' : money.call(line.amount_cents) %></td>
              <td class="td">
                <% if !line.pending? %>
                  <span class="<%= line.status == 'ignored' ? 'pill-taupe' : 'pill-fern' %>"><%= line.status.humanize %></span><%= " by #{line.decided_by_name}" if line.decided_by_name %>
                  <% if line.expense_id && (expense = @expenses_by_id[line.expense_id]) %>
                    <span class="mt-1 block text-xs">Category: <strong><%= expense.category_label %></strong>
                      <% if @can_write %> · <%= link_to 'Edit', edit_finance_expense_path(expense, return_to: bank_statement_path(@document.id, anchor: "bank-line-#{line.id}")), class: 'font-semibold text-olive-deep hover:underline', 'aria-label': "Edit category for #{line.description.first(40)}" %><% end %>
                    </span>
                  <% end %>
                <% elsif @can_write %>
                  <% groups = [['', [['Decide later', 'leave']]]] %>
                  <% if line.money_out? %>
                    <% groups << ['Expense', @expense_options] %>
                    <% groups << ['Vendor payment', @vendors.map { |v| [v.name, "payment:#{v.id}"] }] if @vendors.any? %>
                  <% end %>
                  <% groups << ['Deposit', [['Accept deposit (money received)', 'deposit']]] if line.money_in? %>
                  <% groups << ['Not a business expense', [['Ignore this line (transfer, deposit, personal)', 'ignore']]] %>
                  <% suggestion = line.money_out? && @suggestions[line.id] != 'other' ? "expense:#{@suggestions[line.id]}" : nil %>
                  <%= select_tag "decisions[#{line.id}]", grouped_options_for_select(groups, nil), class: 'select', 'aria-label': "Decision for #{line.description.first(40)}",
                        data: { bank_decisions_target: 'choice', action: 'change->bank-decisions#change', suggestion: suggestion } %>
                  <% if suggestion %><span class="block text-xs text-taupe">Suggestion: <%= @category_labels.fetch(@suggestions[line.id], @suggestions[line.id].to_s.humanize) %></span><% end %>
                <% else %>
                  <span class="pill-taupe">Waiting</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table></div>
      <% if @can_write %>
        <div class="bank-save-bar">
          <p class="text-sm font-semibold" data-bank-decisions-target="count" aria-live="polite"><%= pluralize(@lines.count(&:pending?), 'line') %> waiting</p>
          <%= f.submit 'Save decisions', class: 'btn-primary', data: { bank_decisions_target: 'save', turbo_submits_with: 'Saving…' } %>
        </div>
        <% if @pagy.pages > 1 %><p class="text-xs text-mocha">Page <%= @pagy.page %> of <%= @pagy.pages %>. Only the lines on this page are saved.</p><% end %>
        <%= fold_explainer('Only lines where you picked something are changed. Each one records your name and the time, appears in the Activity log, and is never deleted. If a line falls in a day you already approved, that approval will show as changed.', class: 'text-xs text-mocha') %>
      <% end %>
    <% end %>
  <% end %>
</div>
