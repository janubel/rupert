<% content_for :title, @goal.name %>
<% can_write = Current.user.can?("projects.write") %>
<% menu = [] %>
<% menu << ['Mark achieved', transition_goals_goal_path(@goal, event: "achieve"), { method: :post }] if @goal.may_achieve? %>
<% menu << ['Abandon', transition_goals_goal_path(@goal, event: "abandon"), { method: :post, form: { data: { turbo_confirm: "Abandon this goal? Its progress is kept but it will no longer be tracked." } } }] if @goal.may_abandon? %>
<div class="space-y-6">
  <%= page_header @goal.name, subtitle: @goal.description.presence || "No description.", menu: menu do %>
    <% if can_write %><%= link_to "Edit", edit_goals_goal_path(@goal), class: "btn-ghost" %><% end %>
    <% if @goal.may_activate? %><%= button_to "Activate", transition_goals_goal_path(@goal, event: "activate"), method: :post, class: "btn-primary" %><% end %>
  <% end %>

  <dl class="facts">
    <div><dt>Status</dt><dd><span class="<%= @goal.achieved? ? "pill-fern" : @goal.active? ? "pill-olive" : @goal.abandoned? ? "pill-taupe" : "pill-clay" %>"><%= @goal.status.to_s.humanize %></span></dd></div>
    <% if @goal.unit %><div><dt>Unit</dt><dd><%= @goal.unit %></dd></div><% end %>
    <% if @goal.due_on %><div><dt>Due</dt><dd><%= l(@goal.due_on, format: :long) %></dd></div><% end %>
  </dl>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3" aria-label="Goal progress">
    <div class="stat">
      <p class="stat-label">Current</p>
      <p class="stat-value mt-1"><%= number_with_precision(@goal.current_value, precision: 2, delimiter: ',') %></p>
      <% if @goal.unit %><p class="mt-1 text-xs text-taupe"><%= @goal.unit %></p><% end %>
    </div>
    <div class="stat">
      <p class="stat-label">Target</p>
      <p class="stat-value mt-1"><%= number_with_precision(@goal.target_value, precision: 2, delimiter: ',') %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Progress</p>
      <p class="stat-value mt-1"><%= @goal.progress_pct ? "#{@goal.progress_pct}%" : "—" %></p>
      <progress class="learning-progress mt-2 w-full" value="<%= [@goal.progress_pct || 0, 100].min %>" max="100" aria-label="Progress toward target"><%= @goal.progress_pct || 0 %>%</progress>
    </div>
  </section>

  <% if can_write %>
    <section class="section-card">
      <%= section_heading 'Update progress', hint: 'Enter the latest value; the target can be adjusted here too.' %>
      <%= form_with model: @goal, url: goals_goal_path(@goal), method: :patch, class: "toolbar" do |f| %>
        <div class="toolbar-field">
          <%= f.label :current_value, "Current value", class: "field-label" %>
          <%= f.number_field :current_value, step: "0.01", class: "input" %>
        </div>
        <div class="toolbar-field">
          <%= f.label :target_value, "Target", class: "field-label" %>
          <%= f.number_field :target_value, step: "0.01", class: "input" %>
        </div>
        <div class="toolbar-actions"><%= f.submit "Save", class: "btn-primary" %></div>
      <% end %>
    </section>
  <% end %>
</div>
