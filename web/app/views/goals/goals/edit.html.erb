<% content_for :title, "Edit goal" %>
<div class="page-narrow space-y-6">
  <%= page_header 'Edit goal', subtitle: @goal.name %>
  <div class="card card-pad">
    <%= form_with model: @goal, url: goals_goal_path(@goal), method: :patch, class: "space-y-6" do |f| %>
      <% if @goal.errors.any? %><div class="flash flash-alert" role="alert"><%= @goal.errors.full_messages.to_sentence %></div><% end %>
      <fieldset class="space-y-4">
        <legend class="card-title">Goal</legend>
        <div>
          <%= f.label :name, "Name", class: "field-label" %>
          <%= f.text_field :name, class: "input" %>
        </div>
        <div>
          <%= f.label :description, "Description", class: "field-label" %>
          <%= f.text_area :description, rows: 3, class: "input" %>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <%= f.label :unit, "Unit", class: "field-label" %>
            <%= f.text_field :unit, class: "input" %>
          </div>
          <div>
            <%= f.label :target_value, "Target", class: "field-label" %>
            <%= f.number_field :target_value, step: "0.01", class: "input" %>
          </div>
          <div>
            <%= f.label :due_on, "Due date", class: "field-label" %>
            <%= f.date_field :due_on, class: "input" %>
          </div>
        </div>
      </fieldset>
      <div class="form-actions">
        <%= f.submit "Save", class: "btn-primary" %>
        <%= link_to "Cancel", @goal, class: "btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
