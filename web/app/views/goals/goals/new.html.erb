<div class="space-y-6">
  <%= page_header 'New goal' %>
  <div class="card card-pad page-narrow">
    <%= form_with model: @goal, url: goals_goals_path, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, "Name", class: "mb-1 block text-xs font-semibold uppercase tracking-wider text-mocha" %>
        <%= f.text_field :name, placeholder: "e.g. $25k in monthly sales", class: "input" %>
      </div>
      <div>
        <%= f.label :description, "Description", class: "mb-1 block text-xs font-semibold uppercase tracking-wider text-mocha" %>
        <%= f.text_area :description, rows: 3, class: "input" %>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <%= f.label :unit, "Unit", class: "mb-1 block text-xs font-semibold uppercase tracking-wider text-mocha" %>
          <%= f.text_field :unit, placeholder: "USD", class: "input" %>
        </div>
        <div>
          <%= f.label :target_value, "Target", class: "mb-1 block text-xs font-semibold uppercase tracking-wider text-mocha" %>
          <%= f.number_field :target_value, step: "0.01", class: "input" %>
        </div>
        <div>
          <%= f.label :due_on, "Due date", class: "mb-1 block text-xs font-semibold uppercase tracking-wider text-mocha" %>
          <%= f.date_field :due_on, class: "input" %>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <%= f.submit "Create goal", class: "btn-primary" %>
        <%= link_to "Cancel", goals_goals_path, class: "btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
