<% content_for :title, "Goals" %>
<div class="space-y-6">
  <%= page_header 'Goals', subtitle: 'Targets with measurable progress.' do %>
    <% if Current.user.can?("projects.write") %>
      <%= link_to "Add goal", new_goals_goal_path, class: "btn-primary" %>
    <% end %>
  <% end %>

  <% if @goals.empty? %>
    <%= empty_state 'No goals yet', hint: 'Set a target and start tracking progress toward it.' do %>
      <% if Current.user.can?("projects.write") %><%= link_to "Add goal", new_goals_goal_path, class: "btn-primary" %><% end %>
    <% end %>
  <% else %>
  <section class="card" aria-label="Goals">
    <ul class="row-list">
      <% @goals.each do |goal| %>
        <li class="row-item">
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ink"><%= link_to goal.name, goal, class: 'text-olive-deep hover:underline' %> <span class="<%= goal.achieved? ? "pill-fern" : goal.active? ? "pill-olive" : goal.abandoned? ? "pill-taupe" : "pill-clay" %>"><%= goal.status.to_s.humanize %></span></p>
            <p class="text-xs text-taupe"><%= goal.description.presence || "No description." %><% if goal.due_on %> · Due <%= l(goal.due_on, format: :long) %><% end %></p>
            <% if goal.progress_pct %>
              <progress class="learning-progress mt-2 w-full max-w-xs" value="<%= [goal.progress_pct, 100].min %>" max="100" aria-label="<%= goal.name %> progress"><%= goal.progress_pct %>%</progress>
            <% end %>
          </div>
          <div class="row-item-end">
            <div class="text-right">
              <p class="num font-semibold text-ink"><%= number_with_precision(goal.current_value, precision: 2, delimiter: ',') %></p>
              <p class="text-xs text-taupe">of <%= number_with_precision(goal.target_value, precision: 2, delimiter: ',') %><% if goal.progress_pct %> · <%= goal.progress_pct %>%<% end %></p>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
  <% end %>

  <%== @pagy.series_nav if @pagy.pages > 1 %>
</div>
