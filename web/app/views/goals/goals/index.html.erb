<% content_for :title, "Goals" %>
<div class="space-y-6">
  <%= page_header 'Goals', subtitle: 'Targets with measurable progress.' do %>
    <% if Current.user.can?("projects.write") %>
      <%= link_to "Add goal", new_goals_goal_path, class: "btn-primary" %>
    <% end %>
  <% end %>

  <% if @goals.empty? %>
    <%= empty_state 'No goals yet', hint: 'Set a target and start tracking progress toward it.' do %>
      <% if Current.user.can?("projects.write") %><%= link_to "Add goal", new_goals_goal_path, class: "btn-primary" %><% end %>
    <% end %>
  <% else %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @goals.each do |goal| %>
      <%= link_to goal, class: "card card-pad block hover:border-taupe" do %>
        <div class="flex items-center justify-between gap-2">
          <h3 class="card-title truncate"><%= goal.name %></h3>
          <span class="<%= goal.achieved? ? "pill-fern" : goal.active? ? "pill-olive" : goal.abandoned? ? "pill-taupe" : "pill-clay" %>"><%= goal.status.to_s.humanize %></span>
        </div>
        <p class="mt-1 text-sm text-mocha"><%= goal.description.presence || "No description." %></p>
        <div class="mt-3 flex items-baseline justify-between">
          <p class="font-display text-2xl text-ink"><%= number_with_precision(goal.current_value, precision: 2, delimiter: ',') %></p>
          <p class="text-xs text-taupe">target <%= number_with_precision(goal.target_value, precision: 2, delimiter: ',') %></p>
        </div>
        <% if goal.progress_pct %>
          <progress class="learning-progress mt-2 w-full" value="<%= [goal.progress_pct, 100].min %>" max="100" aria-label="<%= goal.name %> progress"><%= goal.progress_pct %>%</progress>
          <p class="mt-1 text-xs text-taupe"><%= goal.progress_pct %>% complete</p>
        <% end %>
        <% if goal.due_on %><p class="mt-2 text-xs text-taupe">Due <%= l(goal.due_on, format: :long) %></p><% end %>
      <% end %>
    <% end %>
  </div>
  <% end %>

  <%== @pagy.series_nav if @pagy.pages > 1 %>
</div>
