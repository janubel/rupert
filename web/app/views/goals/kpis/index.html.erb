<% content_for :title, "KPIs" %>
<div class="space-y-6">
  <%= page_header 'KPIs', subtitle: 'Key figures and their readings over time.' do %>
    <% if Current.user.can?("projects.write") %>
      <%= link_to "Add KPI", new_goals_kpi_path, class: "btn-primary" %>
    <% end %>
  <% end %>

  <% if @kpis.empty? %>
    <%= empty_state 'No KPIs yet', hint: 'Define one and start recording readings.' do %>
      <% if Current.user.can?("projects.write") %><%= link_to "Add KPI", new_goals_kpi_path, class: "btn-primary" %><% end %>
    <% end %>
  <% else %>
  <section class="card" aria-label="KPIs">
    <ul class="row-list">
      <% @kpis.each do |kpi| %>
        <li class="row-item">
          <div class="min-w-0">
            <p class="font-semibold text-ink"><%= link_to kpi.name, kpi, class: 'text-olive-deep hover:underline' %></p>
            <p class="text-xs text-taupe">Target <%= number_with_precision(kpi.target_value, precision: 2, delimiter: ',') %><% if kpi.unit %> <%= kpi.unit %><% end %> · <%= pluralize(kpi.readings.count, 'reading') %></p>
          </div>
          <div class="row-item-end">
            <span class="num font-semibold text-ink"><%= number_with_precision(kpi.latest_value, precision: 2, delimiter: ',') %></span>
            <span class="<%= kpi.on_track? ? "pill-fern" : "pill-clay" %>"><%= kpi.on_track? ? "On track" : "Off track" %></span>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
  <% end %>

  <%== @pagy.series_nav if @pagy.pages > 1 %>
</div>
