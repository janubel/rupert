<% content_for :title, "Edit KPI" %>
<div class="page-narrow space-y-6">
  <%= page_header 'Edit KPI', subtitle: @kpi.name %>
  <div class="card card-pad">
    <%= form_with model: @kpi, url: goals_kpi_path(@kpi), method: :patch, class: "space-y-6" do |f| %>
      <% if @kpi.errors.any? %><div class="flash flash-alert" role="alert"><%= @kpi.errors.full_messages.to_sentence %></div><% end %>
      <fieldset class="space-y-4">
        <legend class="card-title">KPI</legend>
        <div>
          <%= f.label :name, "Name", class: "field-label" %>
          <%= f.text_field :name, class: "input" %>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <%= f.label :unit, "Unit", class: "field-label" %>
            <%= f.text_field :unit, class: "input" %>
          </div>
          <div>
            <%= f.label :target_value, "Target", class: "field-label" %>
            <%= f.number_field :target_value, step: "0.01", class: "input" %>
          </div>
          <div>
            <%= f.label :direction, "Direction", class: "field-label" %>
            <%= f.select :direction, [["Up (higher is better)", "up"], ["Down (lower is better)", "down"]], {}, class: "select w-full" %>
          </div>
        </div>
      </fieldset>
      <div class="form-actions">
        <%= f.submit "Save", class: "btn-primary" %>
        <%= link_to "Cancel", @kpi, class: "btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
