<div class="space-y-6">
  <%= page_header 'Edit KPI' %>
  <div class="card card-pad page-narrow">
    <%= form_with model: @kpi, url: goals_kpi_path(@kpi), method: :patch, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, "Name", class: "mb-1 block text-xs font-semibold uppercase tracking-wider text-mocha" %>
        <%= f.text_field :name, class: "input" %>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <%= f.label :unit, "Unit", class: "mb-1 block text-xs font-semibold uppercase tracking-wider text-mocha" %>
          <%= f.text_field :unit, class: "input" %>
        </div>
        <div>
          <%= f.label :target_value, "Target", class: "mb-1 block text-xs font-semibold uppercase tracking-wider text-mocha" %>
          <%= f.number_field :target_value, step: "0.01", class: "input" %>
        </div>
        <div>
          <%= f.label :direction, "Direction", class: "mb-1 block text-xs font-semibold uppercase tracking-wider text-mocha" %>
          <%= f.select :direction, [["Up (higher is better)", "up"], ["Down (lower is better)", "down"]], {}, class: "select w-full" %>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <%= f.submit "Save KPI", class: "btn-primary" %>
        <%= link_to "Cancel", @kpi, class: "btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
