<div class="page-narrow space-y-6">
  <%= page_header 'Download .env', subtitle: 'The raw .env reveals every managed secret, so confirm your password first.' %>
  <div class="card card-pad">
    <%= form_with(url: env_export_settings_path, method: :post, local: true, data: { turbo: false }, class: 'space-y-4') do %>
      <fieldset class="space-y-3">
        <div>
          <%= label_tag :password, 'Password', class: 'field-label' %>
          <%= password_field_tag :password, nil, autofocus: true, required: true, autocomplete: 'current-password', class: 'input' %>
        </div>
      </fieldset>
      <div class="form-actions">
        <%= submit_tag 'Download .env', class: 'btn-primary' %>
        <%= link_to 'Cancel', settings_path, class: 'btn-ghost' %>
      </div>
    <% end %>
  </div>
</div>
