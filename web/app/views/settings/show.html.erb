<% content_for :title, "Settings" %>
<div class="space-y-8">
  <section>
    <h1 class="page-title">Settings</h1>
    <p class="mt-2"><%= link_to 'Master credentials & sync', connections_path, class: 'btn-primary btn-sm' %></p>
    <p class="mt-1 text-sm text-mocha">Environment variables and database backup/restore. Environment keys apply to the sync engine immediately; boot-time keys (Shopify API key/secret, database) come from the droplet env.</p>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div id="env" class="card card-pad" data-controller="settings">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-xl text-ink">Environment (.env)</h2>
        <% if Current.user.super_admin? %>
          <%= link_to "Export .env", env_export_confirm_settings_path, class: "btn-ghost btn-sm", data: { turbo: false } %>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-taupe">Import a .env file (or paste its contents) to update managed keys. Values are stored encrypted in the database and override the droplet env.</p>

      <div data-settings-target="envList" class="mt-4 space-y-2"></div>

      <% if Current.user.can?("settings.write") %>
      <form data-settings-target="envForm" data-action="submit->settings#submitEnv" class="mt-5 space-y-3">
        <textarea name="text" rows="8" placeholder="KEY=VALUE&#10;# comments are ignored&#10;SQUARE_ACCESS_TOKEN=..." class="input !rounded-2xl font-mono text-xs"></textarea>
        <label class="flex items-center gap-2 text-xs text-mocha">
          or upload a file
          <input type="file" name="file" accept=".env,text/plain" class="text-xs">
        </label>
        <button type="submit" class="btn-primary">Import into settings</button>
        <span data-settings-target="envResult" class="text-xs"></span>
      </form>
      <% end %>
    </div>

    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Database backup</h2>
      <p class="mt-2 text-xs text-taupe">Download a consistent database snapshot.</p>

      <% if Current.user.super_admin? %>
      <div class="mt-5 flex flex-wrap gap-2">
        <%= link_to "Download backup", backup_settings_path, class: "btn-primary", data: { turbo: false } %>
        <p class="text-xs text-taupe">Database restores require offline maintenance with web and jobs stopped and a verified recovery backup. Contact the instance operator.</p>
      </div>
      <p data-settings-target="restoreResult" class="mt-3 text-xs"></p>
      <% else %>
        <p class="mt-5 text-sm text-taupe">Instance backups and restoration are managed by the platform administrator.</p>
      <% end %>
    </div>
  </section>

  <section class="card card-pad">
    <h2 class="font-display text-xl text-ink">Business settings</h2>
    <p class="mt-2 text-xs text-taupe">Shown on printed invoices and used by stock alerts.</p>
    <% if Current.user.can?("settings.write") %>
    <%= form_tag tenant_settings_path, method: :post, class: "mt-4 grid gap-4 sm:grid-cols-3" do %>
      <div>
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="business_name">Business name</label>
        <input type="text" id="business_name" name="business_name" value="<%= TenantSettings.business_name %>" class="input">
      </div>
      <div>
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="invoice_prefix">Invoice prefix</label>
        <input type="text" id="invoice_prefix" name="invoice_prefix" value="<%= TenantSettings.invoice_prefix %>" class="input">
      </div>
      <div>
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="low_stock_threshold">Low-stock threshold</label>
        <input type="number" id="low_stock_threshold" name="low_stock_threshold" value="<%= TenantSettings.low_stock_threshold %>" min="0" class="input">
      </div>
      <div>
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="sales_tax_rate">Sales tax rate % (for estimates)</label>
        <input type="text" inputmode="decimal" id="sales_tax_rate" name="sales_tax_rate" value="<%= TenantSettings.sales_tax_rate %>" placeholder="e.g. 6.35" class="input" aria-describedby="sales_tax_rate_hint">
        <p id="sales_tax_rate_hint" class="mt-1 text-xs text-mocha">Only used to estimate tax for sources that do not report it, such as SwipeSimple. Leave blank for no estimate.</p>
      </div>
      <div class="sm:col-span-3">
        <%= submit_tag "Save business settings", class: "btn-primary" %>
      </div>
    <% end %>
    <% end %>
  </section>

  <section class="card card-pad">
    <h2 class="font-display text-xl text-ink">Office features</h2>
    <p class="mt-2 text-xs text-taupe">Optional workflows for the shipping desk. Off by default.</p>

    <div class="mt-4 flex items-center justify-between rounded-xl bg-haze px-4 py-3">
      <div>
        <p class="text-sm font-medium text-ink">Order fulfillment status</p>
        <p class="text-xs text-taupe">Mark orders in transition, shipped, arrived, or completed from the order page.</p>
      </div>
    <% if Current.user.can?("settings.write") %>
      <%= form_tag fulfillment_workflow_settings_path, method: :post do %>
        <%= hidden_field_tag :enabled, FeatureFlag.enabled?(:fulfillment_workflow) ? "0" : "1" %>
        <%= submit_tag FeatureFlag.enabled?(:fulfillment_workflow) ? "Enabled" : "Disabled", class: FeatureFlag.enabled?(:fulfillment_workflow) ? "btn-primary btn-sm" : "btn-ghost btn-sm" %>
      <% end %>
    <% end %>
    </div>
  </section>

  <% if Current.user.super_admin? %>
  <section id="drive" class="card card-pad">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-xl text-ink">Google Drive backup</h2>
      <span id="drive-conn" class="badge"></span>
    </div>
    <p class="mt-2 text-xs text-taupe">Platform operators can snapshot the entire instance database to their approved Google Drive every 6 hours and keep the last <span id="drive-retention">7</span> backups. Each attempt is logged below.</p>

    <div id="drive-setup" class="mt-5 hidden">
      <p class="text-xs font-medium text-ink">Easy setup — about 5 minutes, one time:</p>
      <ol class="mt-3 space-y-3 text-xs text-mocha">
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">1.</span>
          <span>
            Open Google Cloud in a new tab:
            <a href="https://console.cloud.google.com/" target="_blank" rel="noopener" class="font-semibold text-olive hover:underline">console.cloud.google.com ↗</a>
            <br>Sign in, then create a project (or pick an existing one) using the project dropdown at the top.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">2.</span>
          <span>
            Enable the Google Drive API:
            <a href="https://console.cloud.google.com/apis/library/drive.googleapis.com" target="_blank" rel="noopener" class="font-semibold text-olive hover:underline">Enable Drive API ↗</a>
            <br>Click the blue <b>Enable</b> button.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">3.</span>
          <span>
            Set up the OAuth consent screen:
            <a href="https://console.cloud.google.com/apis/credentials/consent" target="_blank" rel="noopener" class="font-semibold text-olive hover:underline">Consent screen ↗</a>
            <br>Choose <b>External</b> → Create. Add your business name + email, save. (You can skip the scopes and test users steps.)
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">4.</span>
          <span>
            Create the OAuth client:
            <a href="https://console.cloud.google.com/apis/credentials" target="_blank" rel="noopener" class="font-semibold text-olive hover:underline">Credentials ↗</a>
            <br>Click <b>Create Credentials</b> → <b>OAuth client ID</b> → application type <b>Web application</b>.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">5.</span>
          <span>
            Add this exact <b>Authorized redirect URI</b> (click to copy):
            <br>
            <code data-controller="copy" data-copy-text="<%= google_callback_url %>" data-action="click->copy#copy" class="mt-1 block w-full cursor-pointer select-all break-all rounded-lg bg-haze px-3 py-1.5 font-mono text-xs text-ink"><%= google_callback_url %></code>
            <br>Click <b>Create</b>. Google shows you a <b>Client ID</b> and <b>Client Secret</b> — copy both.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">6.</span>
          <span>
            Paste them into the <b>Environment (.env)</b> card above and hit <b>Import</b>:
            <br>
            <code class="mt-1 inline-block rounded-lg bg-haze px-3 py-1.5 font-mono text-xs">GOOGLE_DRIVE_CLIENT_ID=your-client-id</code>
            <br>
            <code class="mt-1 inline-block rounded-lg bg-haze px-3 py-1.5 font-mono text-xs">GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret</code>
            <br>Optional: <code class="rounded bg-haze px-1.5 py-0.5 font-mono">GOOGLE_DRIVE_RETENTION=7</code> to change how many backups to keep.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">7.</span>
          <span>Come back here and click <b>Connect Google Drive</b> below. Done!</span>
        </li>
      </ol>
    </div>

    <div id="drive-connected" class="mt-5 hidden">
      <div class="flex flex-wrap items-center gap-3">
        <% if Current.user.super_admin? && Current.user.can?("settings.write") %>
        <%= button_to "Back up now", drive_backup_settings_path, method: :post, class: "btn-primary", data: { turbo: false }, id: "drive-backup-btn" %>
        <% end %>
        <a id="drive-latest-link" href="#" target="_blank" rel="noopener" class="btn-ghost hidden">Open latest backup ↗</a>
      <% if Current.user.can?("settings.write") %>
        <%= button_to "Disconnect", drive_disconnect_settings_path, method: :post, class: "btn-ghost btn-sm", data: { turbo: false } %>
      <% end %>
      </div>
      <p id="drive-backup-result" class="mt-3 text-xs"></p>
    </div>

    <div id="drive-connect-btn" class="mt-5 hidden">
      <% if Current.user.can?("settings.write") %>
      <%= link_to "Connect Google Drive", drive_auth_settings_path, class: "btn-primary", data: { turbo: false } %>
      <% end %>
    </div>

    <div class="mt-6">
      <h3 class="text-sm font-display text-ink">Recent backups</h3>
      <div id="drive-logs" class="mt-2 space-y-1.5"></div>
    </div>
  </section>

  <% end %>
  <section class="card card-pad">
    <div class="flex items-baseline justify-between">
    <h2 id="google-sign-in" class="font-display text-xl text-ink">Google sign-in</h2>
      <span class="<%= GoogleOauthService.configured? ? "pill-fern" : "pill-taupe" %>"><%= GoogleOauthService.configured? ? "Configured" : "Not configured" %></span>
    </div>
    <p class="mt-2 text-xs text-taupe">Let your team sign in with their Google account. Only email domains you allow below can get in — everyone else is rejected at the door. New people on an allowed domain get a staff account automatically.</p>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl bg-haze px-4 py-3">
        <p class="text-xs font-medium text-mocha">OAuth redirect URI (register this in Google Cloud)</p>
        <code data-controller="copy" data-copy-text="<%= google_callback_url %>" data-action="click->copy#copy" class="mt-1 block w-full cursor-pointer select-all break-all rounded-lg bg-cream px-3 py-1.5 font-mono text-xs text-ink"><%= google_callback_url %></code>
      </div>
      <div class="rounded-xl bg-haze px-4 py-3">
        <p class="text-xs font-medium text-mocha">Allowlist</p>
        <p class="mt-1 text-sm text-ink"><%= OauthAllowedDomain.count.zero? ? "No domains allowed yet" : pluralize(OauthAllowedDomain.count, "allowed domain") %> · <%= OauthAllowedDomain.allowed?(Current.user.email) ? "you're on it" : "you're not on it" %></p>
      </div>
    </div>

    <% if Current.user.can?("settings.write") %>
    <%= form_tag oauth_credentials_settings_path, method: :post, class: "mt-4 grid gap-4 sm:grid-cols-2" do %>
      <div>
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="client_id">Client ID</label>
        <input type="text" id="client_id" name="client_id" value="<%= EnvStore.fetch("GOOGLE_OAUTH_CLIENT_ID", "") %>" class="input">
      </div>
      <div>
        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="client_secret">Client secret</label>
        <input type="password" id="client_secret" name="client_secret" value="" autocomplete="new-password" placeholder="Leave blank to keep the saved secret" class="input">
      </div>
      <label class="sm:col-span-2 text-xs text-mocha"><%= check_box_tag :clear_client_secret, "1" %> Remove the saved client secret</label>
      <div class="sm:col-span-2">
        <%= submit_tag "Save Google credentials", class: "btn-primary" %>
      </div>
    <% end %>
    <% end %>

    <div class="mt-6">
      <h3 class="text-sm font-display text-ink">Allowed email domains</h3>
      <p class="mt-1 text-xs text-taupe">Add a domain like <code class="font-mono">herbalhealers.com</code>. Anyone with a Google account at that domain can sign in.</p>

      <div class="mt-3 flex flex-wrap gap-2">
        <% OauthAllowedDomain.order(:domain).each do |allowed| %>
          <span class="inline-flex items-center gap-2 rounded-full bg-haze px-3 py-1.5 text-xs text-ink">
            <span class="font-mono">@<%= allowed.domain %></span>
      <% if Current.user.can?("settings.write") %>
            <%= button_to "×", oauth_domains_settings_path, method: :delete, params: { domain: allowed.domain }, class: "text-taupe hover:text-rose", title: "Remove #{allowed.domain}", aria: { label: "Remove #{allowed.domain}" } %>
      <% end %>
          </span>
        <% end %>
        <% if OauthAllowedDomain.none? %>
          <span class="rounded-full bg-haze px-3 py-1.5 text-xs text-taupe">No domains allowed yet.</span>
        <% end %>
      </div>

    <% if Current.user.can?("settings.write") %>
      <%= form_tag oauth_domains_settings_path, method: :post, class: "mt-3 flex items-end gap-2" do %>
        <div class="flex-1">
          <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="new_domain">New domain</label>
          <input type="text" id="new_domain" name="domain" placeholder="example.com" class="input">
        </div>
        <%= submit_tag "Allow domain", class: "btn-primary btn-sm" %>
      <% end %>
    <% end %>
    </div>
  </section>

  <section class="card card-pad">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-xl text-ink">Size families</h2>
      <span class="<%= SizeFamily.any? ? "pill-fern" : "pill-taupe" %>"><%= pluralize(SizeFamily.count, "family") %></span>
    </div>
    <p class="mt-2 text-xs text-taupe">Group a base-gram product's sizes (e.g. 3.5g, 7g, 14g, 28g) under a root gram bank. Every 15-minute sync derives each size's quantity from the root and (with your approval) writes it to Square instead of trusting realtime counts.</p>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <%= link_to "Manage size families", size_families_path, class: "btn-primary" %>
      <%= link_to "Pending changes", size_families_path, class: "btn-ghost" %>
    </div>
  </section>

  <section class="card card-pad scroll-mt-24" id="buzz">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-xl text-ink">Buzz agent</h2>
      <span class="<%= BuzzAgent.configured? ? "pill-fern" : "pill-taupe" %>"><%= BuzzAgent.configured? ? "Configured" : "Not configured" %></span>
    </div>
    <p class="mt-2 text-xs text-taupe">Rupert joins your Buzz workspace as an agent: it holds its own Nostr keypair and posts signed events to a channel. Events fire on sync results and count submissions.</p>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl bg-haze px-4 py-3">
        <p class="text-xs font-medium text-mocha">Agent identity (npub)</p>
        <p class="mt-1 break-all font-mono text-xs text-ink"><%= BuzzAgent.agent_npub || "No keypair yet." %></p>
      </div>
      <div class="rounded-xl bg-haze px-4 py-3">
        <p class="text-xs font-medium text-mocha">Relay / channel</p>
        <p class="mt-1 break-all font-mono text-xs text-ink"><%= EnvStore.fetch("BUZZ_RELAY_URL", "—").presence || "No relay set" %><% if BuzzAgent.channel_id.present? %> · channel <%= BuzzAgent.channel_id[0, 12] %>…<% end %></p>
      </div>
    </div>

    <% last_check = BuzzAgent.last_status %>
    <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-3" aria-label="Buzz status">
      <div class="rounded-xl bg-haze px-4 py-3"><dt class="text-xs font-medium text-mocha">Configured</dt><dd class="mt-1"><%= buzz_status_pill(BuzzAgent.configured?, "Yes", "No") %></dd></div>
      <div class="rounded-xl bg-haze px-4 py-3"><dt class="text-xs font-medium text-mocha">Relay reachable</dt><dd class="mt-1"><%= buzz_status_pill(last_check&.dig(:relay_reachable), "Yes", "No") %></dd></div>
      <div class="rounded-xl bg-haze px-4 py-3"><dt class="text-xs font-medium text-mocha">Agent registered</dt><dd class="mt-1"><%= buzz_status_pill(last_check&.dig(:registered), "Yes", "Not yet") %></dd></div>
    </dl>
    <p class="mt-2 text-xs text-taupe"><%= last_check ? "Last checked #{time_ago_in_words(last_check[:checked_at])} ago." : "Relay and registration are checked on demand with Check status." %> <%= link_to "Open the Buzz card", buzz_path, class: "underline" %> to see what your team sees.</p>

    <% if Current.user.can?("settings.write") %>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <%= button_to "Check status", buzz_status_settings_path, method: :post, class: "btn-ghost", disabled: !BuzzAgent.configured?, data: { turbo: false } %>
      <%= button_to "Generate agent keypair", buzz_generate_settings_path, method: :post, class: "btn-ghost", data: { turbo: false } %>
      <%= button_to "Publish agent profile", buzz_register_settings_path, method: :post, class: "btn-ghost", disabled: !BuzzAgent.configured?, data: { turbo: false } %>
      <%= button_to "Send test message", buzz_test_settings_path, method: :post, class: "btn-primary", disabled: !BuzzAgent.configured?, data: { turbo: false } %>
    </div>

    <% end %>
    <p class="mt-4 text-xs text-taupe">Configure on the Environment (.env) card:</p>
    <ul class="mt-2 space-y-1 font-mono text-xs text-mocha">
      <li>BUZZ_RELAY_URL · your relay, e.g. <code>wss://buzz.example.com</code></li>
      <li>BUZZ_CHANNEL · the channel's id (a UUID in Buzz) to post into</li>
      <li>Optional, for the Buzz card: BUZZ_CHAT_LINK_TEMPLATE (default <code>buzz://channel/{channel}</code>), BUZZ_CONNECT_LINK_TEMPLATE (default <code>buzz://add-community?relay={relay}&amp;name={name}</code>), BUZZ_DOWNLOAD_MACOS / _WINDOWS / _LINUX / _IOS / _ANDROID and BUZZ_WEB_URL (https links)</li>    </ul>
    <p class="mt-3 text-xs text-taupe">To let Rupert into a channel: publish its profile, then add the npub as a member — Buzz only knows identities that have a profile on the relay.</p>
  </section>
</div>

<% if Current.user.super_admin? %>
<script>
  (function () {
    var csrf = document.querySelector('meta[name="csrf-token"]');
    var csrfHeader = csrf ? { "X-CSRF-Token": csrf.content } : {};

    var connEl = document.getElementById("drive-conn");
    var setupEl = document.getElementById("drive-setup");
    var connectedEl = document.getElementById("drive-connected");
    var connectBtnEl = document.getElementById("drive-connect-btn");
    var logsEl = document.getElementById("drive-logs");
    var resultEl = document.getElementById("drive-backup-result");

    function driveBadge(status) {
      connEl.textContent = status.connected ? "Connected" : (status.configured ? "Not connected" : "Not configured");
      connEl.className = "badge " + (status.connected ? "bg-fern" : "bg-taupe");
    }

    function driveRender(s) {
      driveBadge(s);
      document.getElementById("drive-retention").textContent = s.retention;
      setupEl.classList.toggle("hidden", s.configured);
      connectedEl.classList.toggle("hidden", !s.connected);
      connectBtnEl.classList.toggle("hidden", !s.configured || s.connected);

      var link = document.getElementById("drive-latest-link");
      if (s.latest_drive_url) { link.href = s.latest_drive_url; link.classList.remove("hidden"); }
      else { link.classList.add("hidden"); }

      var latest = s.last;
      if (latest && latest.status === "success" && latest.driveUrl) {
        resultEl.textContent = "Last successful backup: " + (latest.fileName || "") + " — " + latest.driveUrl;
      } else if (latest && latest.status === "failed") {
        resultEl.textContent = "Last backup failed: " + (latest.error || "unknown error");
      } else {
        resultEl.textContent = "";
      }

      fetch("/settings/drive_logs.json", { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(function (r) { return r.json(); })
        .then(function (rows) {
          logsEl.innerHTML = "";
          if (!rows.length) {
            logsEl.innerHTML = '<p class="text-xs text-taupe">No backups yet.</p>';
            return;
          }
          rows.forEach(function (row) {
            var el = document.createElement("div");
            el.className = "flex items-center justify-between gap-3 rounded-xl bg-haze px-4 py-2 text-xs";
            var label = row.status === "success" ? "bg-fern" : (row.status === "failed" ? "bg-rose" : "bg-butter");
            el.innerHTML = '<div class="flex items-center gap-2"><span class="dot ' + label + '"></span>' +
              '<span class="font-mono text-ink">' + (row.fileName || "—") + '</span>' +
              (row.driveUrl ? '<a href="' + row.driveUrl + '" target="_blank" rel="noopener" class="text-olive hover:underline">open ↗</a>' : "") + '</div>' +
              '<div class="text-right text-taupe"><span>' + row.finishedLabel + '</span>' +
              (row.error ? '<p class="text-rose">' + row.error + '</p>' : "") + '</div>';
            logsEl.appendChild(el);
          });
        });
    }

    function driveRefresh() {
      fetch("/settings/drive_status.json", { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(function (r) { return r.json(); })
        .then(driveRender)
        .catch(function () { connEl.textContent = "Status unavailable"; });
    }

    var backupBtn = document.getElementById("drive-backup-btn");
    if (backupBtn) {
      backupBtn.addEventListener("click", function (e) {
        e.preventDefault();
        resultEl.textContent = "Backing up…";
        fetch("/settings/drive_backup.json", { method: "POST", headers: Object.assign({ "X-Requested-With": "XMLHttpRequest" }, csrfHeader) })
          .then(function (res) { return res.json().then(function (b) { return { ok: res.ok, body: b }; }); })
          .then(function (res) {
            if (res.ok) {
              resultEl.textContent = res.body.status === "success"
                ? "Backup uploaded. Open it on Google Drive: " + res.body.driveUrl
                : "Backup failed: " + (res.body.error || "unknown error");
              driveRefresh();
            } else {
              resultEl.textContent = "Error: " + res.body.error;
            }
          });
      });
    }

    driveRefresh();
  })();
</script>

<% end %>
