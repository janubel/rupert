<%= render "reports/layout", title: "Sales report", subtitle: "Revenue trends, channels, locations, and top products over the last #{@days} days." do %>
  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="stat">
      <div class="stat-label">Total revenue<%= define('sales_total') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@total_revenue) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Orders<%= define('date_window') %></div>
      <p class="stat-value mt-1"><%= @total_orders %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Avg order value<%= define('average_sale') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@aov) %></p>
      <%= explain_calculation(title: 'Average order value', id: 'sales-aov',
            formula: 'Total revenue ÷ paid or fulfilled orders in the window.',
            rows: [['Total revenue', number_to_currency(@total_revenue)], ['Orders', @total_orders],
                   ['Average order value', @total_orders.to_i.zero? ? '—' : number_to_currency(@aov)]],
            note: 'Both figures use the same paid and fulfilled orders, so the average matches the two numbers above. No orders means no average.',
            term: 'average_sale', lesson: 'sales') %>
    </div>
    <div class="stat">
      <div class="stat-label">Revenue / day<%= define('revenue_per_day') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@revenue_daily.values.sum / @revenue_daily.size) rescue number_to_currency(0) %></p>
      <% daily_days = @revenue_daily.size; daily_total = @revenue_daily.values.sum %>
      <%= explain_calculation(title: 'Revenue per day', id: 'sales-revenue-per-day',
            formula: 'Daily revenue totals added together ÷ number of days shown.',
            rows: [['Sum of daily revenue', number_to_currency(daily_total)], ['Days in the window', daily_days],
                   ['Revenue per day', daily_days.zero? ? '—' : number_to_currency(daily_total / daily_days)]],
            note: 'Daily totals include every order with a gross amount in the window, so this can differ slightly from Total revenue, which counts paid and fulfilled orders only. Days without sales count as zero.',
            term: 'revenue_per_day', lesson: 'reports') %>
    </div>
  </section>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <h2 class="font-display text-lg text-ink">Revenue · daily</h2>
      <div class="mt-3"><%= area_chart @revenue_daily, height: "220px", colors: chart_color(:olive_deep), legend: false %></div>
    </div>
    <div class="card card-pad">
      <h2 class="font-display text-lg text-ink">Revenue · weekly</h2>
      <div class="mt-3"><%= column_chart @revenue_weekly, height: "220px", colors: chart_color(:olive_deep), legend: false %></div>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="card card-pad">
      <h2 class="font-display text-lg text-ink">By source</h2>
      <div class="mt-3"><%= pie_chart @by_source, height: "220px", colors: chart_color(:fern, :clay) %></div>
    </div>
    <div class="card card-pad">
      <h2 class="font-display text-lg text-ink">By channel</h2>
      <div class="mt-3"><%= pie_chart @by_channel, height: "220px", colors: chart_color(:olive_deep, :butter) %></div>
    </div>
    <div class="card card-pad">
      <h2 class="font-display text-lg text-ink">By location</h2>
      <div class="mt-3">
        <% if @by_location.empty? %>
          <p class="rounded-xl bg-haze px-4 py-3 text-sm text-taupe">No location data — synced orders don't carry a location yet.</p>
        <% else %>
          <%= bar_chart @by_location, height: "220px", colors: chart_color(:clay), legend: false %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="border-b border-fog px-5 py-3">
      <h2 class="font-display text-lg text-ink">Top products</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">#</th>
            <th scope="col" class="th">Product</th>
            <th scope="col" class="th">SKU</th>
            <th scope="col" class="th text-right">Revenue</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% @top_products.each_with_index do |row, i| %>
            <tr class="hover:bg-cream">
              <td class="td text-taupe"><%= i + 1 %></td>
              <td class="td font-medium text-ink"><%= row[:name] %></td>
              <td class="td font-mono text-xs text-mocha"><%= row[:sku].presence || "—" %></td>
              <td class="td text-right font-medium text-ink"><%= number_to_currency(row[:revenue]) %></td>
            </tr>
          <% end %>
          <% if @top_products.empty? %>
            <tr><td class="empty-row">No line-item data in this window.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
