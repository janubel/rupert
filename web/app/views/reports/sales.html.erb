<%= render "reports/layout", title: "Sales report", subtitle: "Revenue trends, channels, locations and top products for the period." do %>
  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="stat">
      <div class="stat-label">Total revenue<%= define('sales_total') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@total_revenue) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Orders<%= define('date_window') %></div>
      <p class="stat-value mt-1"><%= @total_orders %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Avg order value<%= define('average_sale') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@aov) %></p>
      <%= explain_calculation(title: 'Average order value', id: 'sales-aov',
            formula: 'Total revenue ÷ paid or fulfilled orders in the window.',
            rows: [['Total revenue', number_to_currency(@total_revenue)], ['Orders', @total_orders],
                   ['Average order value', @total_orders.to_i.zero? ? '—' : number_to_currency(@aov)]],
            note: 'Both figures use the same paid and fulfilled orders, so the average matches the two numbers above. No orders means no average.',
            term: 'average_sale', lesson: 'sales') %>
    </div>
    <div class="stat">
      <div class="stat-label">Revenue / day<%= define('revenue_per_day') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@revenue_daily.values.sum / @revenue_daily.size) rescue number_to_currency(0) %></p>
      <% daily_days = @revenue_daily.size; daily_total = @revenue_daily.values.sum %>
      <%= explain_calculation(title: 'Revenue per day', id: 'sales-revenue-per-day',
            formula: 'Daily revenue totals added together ÷ number of days shown.',
            rows: [['Sum of daily revenue', number_to_currency(daily_total)], ['Days in the window', daily_days],
                   ['Revenue per day', daily_days.zero? ? '—' : number_to_currency(daily_total / daily_days)]],
            note: 'Daily totals include every order with a gross amount in the window, so this can differ slightly from Total revenue, which counts paid and fulfilled orders only. Days without sales count as zero.',
            term: 'revenue_per_day', lesson: 'reports') %>
    </div>
  </section>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <%= section_heading 'Revenue · daily' %>
      <div class="mt-3"><%= area_chart @revenue_daily, height: "220px", legend: false %></div>
    </div>
    <div class="card card-pad">
      <%= section_heading 'Revenue · weekly' %>
      <div class="mt-3"><%= column_chart @revenue_weekly, height: "220px", legend: false %></div>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="card card-pad">
      <%= section_heading 'By source' %>
      <div class="mt-3"><%= bar_chart @by_source, height: "220px", legend: false %></div>
    </div>
    <div class="card card-pad">
      <%= section_heading 'By channel' %>
      <div class="mt-3"><%= bar_chart @by_channel, height: "220px", legend: false %></div>
    </div>
    <div class="card card-pad">
      <%= section_heading 'By location' %>
      <div class="mt-3">
        <% if @by_location.empty? %>
          <p class="empty-state-hint">No location data — synced orders don't carry a location yet.</p>
        <% else %>
          <%= bar_chart @by_location, height: "220px", legend: false %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'Top products', hint: 'The 50 best sellers by line revenue in this window.' %></div>
    <%= report_table 'sales-top-products', label: 'Top products' do %>
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th" data-col="rank">#</th>
            <th scope="col" class="th" data-col="product">Product</th>
            <th scope="col" class="th" data-col="sku">SKU</th>
            <th scope="col" class="th num" data-col="units">Units</th>
            <th scope="col" class="th num" data-col="orders" data-default-hidden>Orders</th>
            <th scope="col" class="th num" data-col="revenue">Revenue</th>
          </tr>
        </thead>
        <tbody>
          <% @top_products.each_with_index do |row, i| %>
            <tr>
              <td class="td text-taupe"><%= i + 1 %></td>
              <td class="td font-medium text-ink"><%= row[:name] %></td>
              <td class="td font-mono text-xs text-mocha"><%= row[:sku].presence || "—" %></td>
              <td class="td num text-mocha"><%= row[:units] || "—" %></td>
              <td class="td num text-mocha"><%= row[:orders] || "—" %></td>
              <td class="td num font-medium text-ink" data-sort-value="<%= row[:revenue] %>"><%= number_to_currency(row[:revenue]) %></td>
            </tr>
          <% end %>
          <% if @top_products.empty? %>
            <tr><td class="empty-row" colspan="6">No line-item data in this window.</td></tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'Revenue by day' %></div>
    <%= report_table 'sales-daily', label: 'Revenue by day' do %>
      <table class="table">
        <thead>
          <tr><th scope="col" class="th" data-col="day">Day</th><th scope="col" class="th num" data-col="orders">Orders</th><th scope="col" class="th num" data-col="revenue">Revenue</th><th scope="col" class="th num" data-col="average" data-default-hidden>Average order</th></tr>
        </thead>
        <tbody>
          <% @revenue_daily.sort_by { |day, _| day }.reverse_each do |day, revenue| %>
            <% count = @orders_daily.fetch(day, 0) %>
            <tr>
              <td class="td whitespace-nowrap" data-sort-value="<%= day.iso8601 %>"><%= day.strftime('%a %b %-d, %Y') %></td>
              <td class="td num"><%= count %></td>
              <td class="td num" data-sort-value="<%= revenue %>"><%= number_to_currency(revenue) %></td>
              <td class="td num" data-sort-value="<%= count.zero? ? '' : (revenue / count).round(2) %>"><%= count.zero? ? '—' : number_to_currency(revenue / count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>
