<%= render "reports/layout", title: "Inventory report", subtitle: "Stock valuation, movement, and low-stock pipeline." do %>
  <% if Current.user.can?('inventory.read') %>
    <div class="card card-pad flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-mocha"><strong class="text-ink">Store comparison</strong> — Shopify vs C-Trax stock for each item, ready to print.</p>
      <div class="flex flex-wrap gap-2">
        <%= link_to 'Download store comparison PDF', stock_comparison_path(format: :pdf), class: 'btn-primary btn-sm', data: { turbo: false } %>
        <%= link_to 'Open store comparison', stock_comparison_path, class: 'btn-ghost btn-sm' %>
      </div>
    </div>
  <% end %>
  <section class="grid grid-cols-2 gap-4 lg:grid-cols-5">
    <div class="stat">
      <div class="stat-label">Stock value (retail)<%= define('stock_value') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@valuation) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Variants<%= define('sku') %></div>
      <p class="stat-value mt-1"><%= @variants %></p>
      <p class="mt-1 text-xs text-taupe"><%= @tracked %> tracked</p>
    </div>
    <div class="stat">
      <div class="stat-label">Movements · 30d<%= define('movement') %></div>
      <p class="stat-value mt-1"><%= @movements_30d %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Low stock<%= define('threshold') %></div>
      <p class="stat-value mt-1 text-clay"><%= @low_stock %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Out of stock<%= define('mirror') %></div>
      <p class="stat-value mt-1 text-rose"><%= @out_of_stock %></p>
    </div>
  </section>

  <div class="card card-pad">
    <h2 class="font-display text-lg text-ink">Inventory movements · last 30 days</h2>
    <div class="mt-3"><%= column_chart @movement_trend, height: "220px", colors: chart_color(:olive_deep), legend: false %></div>
  </div>

  <div class="card overflow-hidden">
    <div class="border-b border-fog px-5 py-3">
      <h2 class="font-display text-lg text-ink">Low stock · on hand ≤ 5</h2>
    </div>
    <%= report_table 'inventory-low-stock', label: 'Low stock' do %>
      <table class="operations-table w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th" data-col="sku">SKU</th>
            <th scope="col" class="th" data-col="product">Product</th>
            <th scope="col" class="th" data-col="variant">Variant</th>
            <th scope="col" class="th text-right" data-col="on_hand">On hand<%= define('on_hand') %></th>
            <th scope="col" class="th text-right" data-col="price">Price</th>
            <th scope="col" class="th text-right" data-col="value" data-default-hidden>Stock value</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% @low_stock_items.each do |row| %>
            <tr class="hover:bg-cream">
              <td class="td font-mono text-xs text-mocha"><%= row[:sku].presence || "—" %></td>
              <td class="td font-medium text-ink"><%= row[:product] %></td>
              <td class="td text-mocha"><%= row[:variant] %></td>
              <td class="td text-right <%= row[:qty].zero? ? "font-semibold text-rose" : "font-semibold text-clay" %>"><%= row[:qty] %></td>
              <td class="td text-right text-mocha" data-sort-value="<%= row[:price] %>"><%= number_to_currency(row[:price]) %></td>
              <td class="td text-right text-mocha" data-sort-value="<%= row[:price] ? (row[:price].to_f * [row[:qty].to_i, 0].max).round(2) : "" %>"><%= row[:price] ? number_to_currency(row[:price].to_f * [row[:qty].to_i, 0].max) : '—' %></td>
            </tr>
          <% end %>
          <% if @low_stock_items.empty? %>
            <tr><td class="empty-row" colspan="6">No low-stock items — all good.</td></tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>
