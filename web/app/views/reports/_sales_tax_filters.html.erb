<fieldset class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-taupe">
  <legend class="sr-only">Sources</legend>
  <span>Sources</span>
  <% chosen = report.sources %>
  <% SalesTaxReport::SOURCES.each do |key, label| %>
    <label class="inline-flex items-center gap-1 text-sm text-ink"><%= check_box_tag 'sources[]', key, chosen.include?(key), id: "sources_#{key}" %> <%= label %></label>
  <% end %>
</fieldset>
<label class="text-xs text-taupe">Estimate rate %
  <%= text_field_tag :rate, report.rate&.to_s('F'), inputmode: 'decimal', placeholder: 'none', class: 'select w-24', title: 'Optional tax rate used only to estimate tax for sources that do not report it (SwipeSimple)' %>
</label>
