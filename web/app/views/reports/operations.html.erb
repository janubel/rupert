<%= render "reports/layout", title: "Operations report", subtitle: "Sync health, reconcile runs and POS cash variance for the period." do %>
  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="stat">
      <div class="stat-label">Sync success rate<%= define('sync') %></div>
      <p class="stat-value mt-1"><%= number_to_percentage(@sync_rate, precision: 1) %></p>
      <p class="mt-1 text-xs text-taupe"><%= @sync_success %> / <%= @sync_total %> runs</p>
      <%= explain_calculation(title: 'Sync success rate', id: 'sync-success-rate',
            formula: 'Successful sync runs ÷ all recorded sync runs × 100, across every source and all time.',
            rows: [['Successful runs', @sync_success], ['Failed runs', @sync_failed], ['All runs', @sync_total],
                   ['Success rate', @sync_total.to_i.zero? ? '—' : number_to_percentage(@sync_rate, precision: 1)]],
            note: 'A successful run means Rupert finished reading the source; it does not prove the source contained every expected record. Runs that are still in progress count in the total but in neither success nor failure.',
            term: 'sync', lesson: 'sync') %>
    </div>
    <div class="stat">
      <div class="stat-label">Failed syncs<%= define('freshness') %></div>
      <p class="stat-value mt-1 text-rose"><%= @sync_failed %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Reconcile runs<%= define('reconciliation') %></div>
      <p class="stat-value mt-1"><%= @reconcile_total %></p>
      <p class="mt-1 text-xs text-taupe"><%= @reconcile_success %> applied</p>
    </div>
    <div class="stat">
      <div class="stat-label">POS cash variance<%= define('cash_variance') %></div>
      <p class="stat-value mt-1 <%= @pos_variance_total.zero? ? "" : "text-clay" %>"><%= number_to_currency(@pos_variance_total) %></p>
      <p class="mt-1 text-xs text-taupe"><%= @pos_open %> register open</p>
    </div>
  </section>

  <div class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'Sync runs', hint: 'Runs started in this window, newest first (up to 200).' %></div>
    <%= report_table 'operations-sync-runs', label: 'Sync runs' do %>
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th" data-col="started">Started</th>
            <th scope="col" class="th" data-col="source">Source</th>
            <th scope="col" class="th" data-col="mode" data-default-hidden>Mode</th>
            <th scope="col" class="th" data-col="actor" data-default-hidden>Started by</th>
            <th scope="col" class="th" data-col="status">Status</th>
            <th scope="col" class="th num" data-col="duration">Duration</th>
            <th scope="col" class="th" data-col="error">Error</th>
          </tr>
        </thead>
        <tbody>
          <% @sync_runs.each do |run| %>
            <% seconds = run.finishedAt && run.startedAt ? (run.finishedAt - run.startedAt).round : nil %>
            <tr>
              <td class="td whitespace-nowrap text-mocha" data-sort-value="<%= run.startedAt&.iso8601 %>"><%= run.startedAt ? l(run.startedAt, format: :short) : '—' %></td>
              <td class="td"><%= run.source.presence || '—' %></td>
              <td class="td text-mocha"><%= run.mode %></td>
              <td class="td text-mocha"><%= run.actor %></td>
              <td class="td"><span class="<%= run.success? ? "pill-fern" : run.failed? ? "pill-rose" : "pill-taupe" %>"><%= run.status %></span></td>
              <td class="td num" data-sort-value="<%= seconds %>"><%= seconds ? "#{seconds}s" : '—' %></td>
              <td class="td text-xs text-mocha"><%= run.error.to_s.truncate(140).presence || '—' %></td>
            </tr>
          <% end %>
          <% if @sync_runs.empty? %><tr><td class="empty-row" colspan="7">No sync runs started in this window.</td></tr><% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'POS sessions', hint: 'Register sessions opened in this window (up to 200).' %></div>
    <%= report_table 'operations-pos-sessions', label: 'POS sessions' do %>
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th" data-col="register">Register</th>
            <th scope="col" class="th" data-col="opened">Opened</th>
            <th scope="col" class="th" data-col="closed" data-default-hidden>Closed</th>
            <th scope="col" class="th" data-col="status">Status</th>
            <th scope="col" class="th num" data-col="cash">Cash sales</th>
            <th scope="col" class="th num" data-col="card">Card sales</th>
            <th scope="col" class="th num" data-col="gift" data-default-hidden>Gift sales</th>
            <th scope="col" class="th num" data-col="expected" data-default-hidden>Expected cash</th>
            <th scope="col" class="th num" data-col="counted" data-default-hidden>Counted cash</th>
            <th scope="col" class="th num" data-col="variance">Variance</th>
          </tr>
        </thead>
        <tbody>
          <% cash = ->(cents) { cents.nil? ? '—' : number_to_currency(cents / 100.0) } %>
          <% @pos_sessions.each do |session| %>
            <tr>
              <td class="td font-medium text-ink"><%= session.name %></td>
              <td class="td whitespace-nowrap text-mocha" data-sort-value="<%= session.opened_at&.iso8601 %>"><%= l(session.opened_at, format: :short) %></td>
              <td class="td whitespace-nowrap text-mocha" data-sort-value="<%= session.closed_at&.iso8601 %>"><%= session.closed_at ? l(session.closed_at, format: :short) : '—' %></td>
              <td class="td"><span class="pill-taupe"><%= session.status %></span></td>
              <% [session.cash_sales_cents, session.card_sales_cents, session.gift_sales_cents, session.expected_cash_cents, session.counted_cash_cents, session.variance_cents].each do |cents| %>
                <td class="td num" data-sort-value="<%= report_sort_cents(cents) %>"><%= cash.call(cents) %></td>
              <% end %>
            </tr>
          <% end %>
          <% if @pos_sessions.empty? %><tr><td class="empty-row" colspan="10">No POS sessions opened in this window.</td></tr><% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'Reconcile runs' %></div>
    <%= report_table 'operations-reconcile-runs', label: 'Reconcile runs' do %>
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th" data-col="started">Started</th>
            <th scope="col" class="th" data-col="mode">Mode</th>
            <th scope="col" class="th" data-col="status">Status</th>
            <th scope="col" class="th num" data-col="rows">Rows</th>
            <th scope="col" class="th num" data-col="applied">Applied</th>
            <th scope="col" class="th num" data-col="failed">Failed</th>
          </tr>
        </thead>
        <tbody>
          <% @reconcile_runs.each do |run| %>
            <tr>
              <td class="td whitespace-nowrap text-mocha" data-sort-value="<%= run.startedAt&.iso8601 %>"><%= l(run.startedAt, format: :short) %></td>
              <td class="td text-mocha"><%= run.mode %></td>
              <td class="td"><span class="<%= run.status == "applied" ? "pill-fern" : run.status == "failed" ? "pill-rose" : "pill-taupe" %>"><%= run.status %></span></td>
              <td class="td num text-mocha"><%= run.totalRows %></td>
              <td class="td num text-mocha"><%= run.applied %></td>
              <td class="td num text-mocha"><%= run.failed %></td>
            </tr>
          <% end %>
          <% if @reconcile_runs.empty? %>
            <tr><td class="empty-row" colspan="6">No reconcile runs yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>
