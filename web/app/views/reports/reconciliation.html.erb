<%= render "reports/layout", title: "Inventory reconciliation", subtitle: "Side-by-side Shopify and Square stock counts from the sync mirrors, refreshed every 15 minutes." do %>
  <section class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="stat">
      <div class="stat-label">Linked SKUs<%= define('sku') %></div>
      <p class="stat-value mt-1"><%= @reconciliation.summary[:linked] %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Square only<%= define('shared_stock') %></div>
      <p class="stat-value mt-1 text-taupe"><%= @reconciliation.summary[:square_only] %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Shopify only<%= define('mirror') %></div>
      <p class="stat-value mt-1 text-taupe"><%= @reconciliation.summary[:shopify_only] %></p>
    </div>
  </section>

  <p class="text-sm text-mocha">Last successful sync:
    <span class="font-medium text-ink">Shopify <%= @reconciliation.last_syncs[:shopify]&.to_fs(:short) || "—" %></span>
    ·
    <span class="font-medium text-ink">Square <%= @reconciliation.last_syncs[:square]&.to_fs(:short) || "—" %></span>
    · snapshots reflect the latest 15-minute sync.
  </p>

  <div class="card">
    <div class="card-pad border-b border-fog"><%= section_heading "Side-by-side counts · #{pluralize(@reconciliation.rows.length, 'item')}", hint: '† Shared Square total: one Square variation is linked to more than one Shopify variant, so its quantity cannot be pinned to a single row.' %></div>
    <%= report_table 'reconciliation-counts', label: 'Side-by-side counts' do %>
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">SKU</th>
            <th scope="col" class="th">Product</th>
            <th scope="col" class="th">Shopify variant</th>
            <th scope="col" class="th">Square variation</th>
            <th scope="col" class="th num">Shopify</th>
            <th scope="col" class="th num">Square</th>
            <th scope="col" class="th">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @reconciliation.rows.each do |row| %>
            <tr>
              <td class="td font-mono text-xs text-mocha"><%= row.sku %></td>
              <td class="td font-medium text-ink"><%= row.product %></td>
              <td class="td text-mocha"><%= row.shopify_variant || "—" %></td>
              <td class="td text-mocha"><%= row.square_variation || "—" %></td>
              <td class="td num text-mocha"><%= row.shopify_qty || "—" %></td>
              <td class="td num text-mocha" data-sort-value="<%= row.square_qty %>">
                <% if row.square_qty.nil? %>
                  —
                <% elsif row.shared %>
                  <%= row.square_qty %>†<span class="sr-only"> (shared Square total — spans multiple variants)</span>
                <% else %>
                  <%= row.square_qty %>
                <% end %>
              </td>
              <td class="td">
                <% case row.status %>
                <% when "matched", "drift" %>
                  <span class="pill-fern">linked</span>
                <% when "shared" %>
                  <span class="pill-taupe" title="Square total shared across multiple variants">shared</span>
                <% when "square_only" %>
                  <span class="pill-taupe">no Shopify link</span>
                <% when "shopify_only" %>
                  <span class="pill-taupe">no Square link</span>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @reconciliation.rows.empty? %>
            <tr>
              <td class="empty-row" colspan="7">No SKU links yet — run a sync first.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'Maintenance decisions — audit trail', hint: 'Every automated write the 15-min pool sync made, for human review. Large moves or negatives are flagged.' %></div>
    <%= report_table 'reconciliation-decisions', label: 'Maintenance decisions' do %>
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Time</th>
            <th scope="col" class="th">SKU</th>
            <th scope="col" class="th">Platform</th>
            <th scope="col" class="th num">Δ</th>
            <th scope="col" class="th num">Before → After</th>
            <th scope="col" class="th">Reason</th>
            <th scope="col" class="th num">Review</th>
          </tr>
        </thead>
        <tbody>
          <% @reconciliation.decisions.each do |decision| %>
            <tr class="<%= decision[:needs_review] ? "bg-haze/40" : "" %>">
              <td class="td text-mocha" data-sort-value="<%= decision[:time].iso8601 %>"><%= decision[:time].to_fs(:short) %></td>
              <td class="td font-mono text-xs text-ink"><%= decision[:sku] %></td>
              <td class="td text-mocha"><%= decision[:platform] %></td>
              <td class="td num font-semibold <%= decision[:delta].negative? ? "text-clay" : "text-fern" %>"><%= decision[:delta] %></td>
              <td class="td num text-mocha" data-sort-value="<%= decision[:after] %>"><%= decision[:before] %> → <%= decision[:after] %></td>
              <td class="td text-mocha"><%= decision[:reason] %></td>
              <td class="td num">
                <% if decision[:needs_review] %>
                  <span class="pill-rose">review</span>
                <% else %>
                  <span class="pill-fern">ok</span>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @reconciliation.decisions.empty? %>
            <tr>
              <td class="empty-row" colspan="7">No maintenance writes yet today.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
<% end %>
