<%= render "reports/layout", title: "Financial report", subtitle: "P&L summary and tender breakdown over the last #{@days} days." do %>
  <section class="grid grid-cols-2 gap-4 lg:grid-cols-5">
    <div class="stat">
      <div class="stat-label">Gross revenue<%= define('gross') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@revenue_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Tax collected<%= define('tax_collected') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@tax_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Refunds<%= define('refund') %></div>
      <p class="stat-value mt-1 text-rose"><%= number_to_currency(@refund_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Net revenue<%= define('net_revenue') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@net_cents / 100.0) %></p>
      <%= explain_calculation(title: 'Net revenue', id: 'financial-net-revenue',
            formula: 'Gross revenue − refunds recorded in the window. Tax collected is shown separately and not subtracted.',
            rows: [['Gross revenue', number_to_currency(@revenue_cents / 100.0)], ['Refunds recorded', "− #{number_to_currency(@refund_cents / 100.0)}"],
                   ['Net revenue', number_to_currency(@net_cents / 100.0)]],
            note: (@unrecorded_refund_orders.to_i.positive? ? "#{pluralize(@unrecorded_refund_orders, 'refunded order')} with no recorded refund amount are not subtracted, so net revenue is overstated by up to #{number_to_currency(@unrecorded_refund_cents / 100.0)}." : 'Every refunded order in the window has a recorded refund amount.'),
            term: 'net_revenue', lesson: 'reports') %>
    </div>
    <div class="stat">
      <div class="stat-label">Avg order<%= define('average_sale') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@avg_order_cents / 100.0) %></p>
    </div>
  </section>

  <% if @unrecorded_refund_orders.to_i.positive? %>
    <p role="alert" class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm">
      <%= pluralize(@unrecorded_refund_orders, 'order') %> (<%= number_to_currency(@unrecorded_refund_cents / 100.0) %>) marked refunded <%= @unrecorded_refund_orders == 1 ? 'has' : 'have' %> no refund amount recorded, so Refunds above is understated.
      <%= link_to 'See which orders in Books check', books_check_path(days: @days), class: 'font-semibold underline' %>
    </p>
  <% end %>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <h2 class="font-display text-lg text-ink">Net revenue · daily</h2>
      <div class="mt-3"><%= area_chart @daily_net, height: "220px", colors: chart_color(:olive_deep), legend: false %></div>
    </div>
    <div class="card card-pad">
      <h2 class="font-display text-lg text-ink">Payment tenders</h2>
      <div class="mt-3">
        <% if @tenders.empty? %>
          <p class="rounded-xl bg-haze px-4 py-3 text-sm text-taupe">No payment data in this window.</p>
        <% else %>
          <%= pie_chart @tenders, height: "220px", colors: chart_color(:fern, :olive_deep, :clay, :butter) %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="border-b border-fog px-5 py-3">
      <h2 class="font-display text-lg text-ink">P&L summary</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr><th scope="col" class="th">Line</th><th scope="col" class="th text-right">Amount</th></tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <tr class="hover:bg-cream">
            <td class="td text-mocha">Gross revenue</td>
            <td class="td text-right font-medium text-ink"><%= number_to_currency(@revenue_cents / 100.0) %></td>
          </tr>
          <tr class="hover:bg-cream">
            <td class="td text-mocha">Tax collected</td>
            <td class="td text-right font-medium text-ink"><%= number_to_currency(@tax_cents / 100.0) %></td>
          </tr>
          <tr class="hover:bg-cream">
            <td class="td text-mocha">Refunds</td>
            <td class="td text-right font-medium text-rose"><%= number_to_currency(@refund_cents / 100.0) %></td>
          </tr>
          <tr class="hover:bg-cream">
            <td class="td font-semibold text-ink">Net revenue</td>
            <td class="td text-right font-semibold text-ink"><%= number_to_currency(@net_cents / 100.0) %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
