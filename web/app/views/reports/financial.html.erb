<%= render "reports/layout", title: "Financial report", subtitle: "Profit and loss summary and tender breakdown for the period." do %>
  <section class="grid grid-cols-2 gap-4 lg:grid-cols-5">
    <div class="stat">
      <div class="stat-label">Gross revenue<%= define('gross') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@revenue_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Tax collected<%= define('tax_collected') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@tax_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Refunds<%= define('refund') %></div>
      <p class="stat-value mt-1 text-rose"><%= number_to_currency(@refund_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <div class="stat-label">Net revenue<%= define('net_revenue') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@net_cents / 100.0) %></p>
      <%= explain_calculation(title: 'Net revenue', id: 'financial-net-revenue',
            formula: 'Gross revenue − refunds recorded in the window. Tax collected is shown separately and not subtracted.',
            rows: [['Gross revenue', number_to_currency(@revenue_cents / 100.0)], ['Refunds recorded', "− #{number_to_currency(@refund_cents / 100.0)}"],
                   ['Net revenue', number_to_currency(@net_cents / 100.0)]],
            note: (@unrecorded_refund_orders.to_i.positive? ? "#{pluralize(@unrecorded_refund_orders, 'refunded order')} with no recorded refund amount are not subtracted, so net revenue is overstated by up to #{number_to_currency(@unrecorded_refund_cents / 100.0)}." : 'Every refunded order in the window has a recorded refund amount.'),
            term: 'net_revenue', lesson: 'reports') %>
    </div>
    <div class="stat">
      <div class="stat-label">Avg order<%= define('average_sale') %></div>
      <p class="stat-value mt-1"><%= number_to_currency(@avg_order_cents / 100.0) %></p>
    </div>
  </section>

  <% if @unrecorded_refund_orders.to_i.positive? %>
    <p role="alert" class="flash flash-alert">
      <%= pluralize(@unrecorded_refund_orders, 'order') %> (<%= number_to_currency(@unrecorded_refund_cents / 100.0) %>) marked refunded <%= @unrecorded_refund_orders == 1 ? 'has' : 'have' %> no refund amount recorded, so Refunds above is understated.
      <%= link_to 'See which orders in Books check', books_check_path(days: @days), class: 'font-semibold underline' %>
    </p>
  <% end %>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <%= section_heading 'Net revenue · daily' %>
      <div class="mt-3 report-chart"><%= area_chart @daily_net, height: "220px", legend: false %></div>
    </div>
    <div class="card card-pad">
      <%= section_heading 'Payment tenders' %>
      <div class="mt-3 report-chart">
        <% if @tenders.empty? %>
          <p class="empty-state-hint">No payment data in this window.</p>
        <% else %>
          <%= bar_chart @tenders, height: "220px", legend: false %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'P&L summary' %></div>
      <%= report_table 'financial-pl', label: 'P&L summary', sortable: false do %>
        <table class="table">
          <thead>
            <tr><th scope="col" class="th" data-col="line">Line</th><th scope="col" class="th num" data-col="amount">Amount</th></tr>
          </thead>
          <tbody>
            <tr><td class="td text-mocha">Gross revenue</td><td class="td num font-medium text-ink"><%= number_to_currency(@revenue_cents / 100.0) %></td></tr>
            <tr><td class="td text-mocha">Tax collected</td><td class="td num font-medium text-ink"><%= number_to_currency(@tax_cents / 100.0) %></td></tr>
            <tr><td class="td text-mocha">Refunds</td><td class="td num font-medium text-rose"><%= number_to_currency(@refund_cents / 100.0) %></td></tr>
            <tr><td class="td font-semibold text-ink">Net revenue</td><td class="td num font-semibold text-ink"><%= number_to_currency(@net_cents / 100.0) %></td></tr>
          </tbody>
        </table>
      <% end %>
    </div>

    <div class="card">
    <div class="card-pad border-b border-fog"><%= section_heading 'Payment tenders' %><p class="card-hint">Completed payments on orders in this window; <%= link_to 'sales tax by source', sales_tax_reports_path(report_window_params), class: 'underline' %> has its own tab.</p></div>
      <% tender_total = @tenders.values.sum %>
      <%= report_table 'financial-tenders', label: 'Payment tenders' do %>
        <table class="table">
          <thead>
            <tr><th scope="col" class="th" data-col="method">Method</th><th scope="col" class="th num" data-col="amount">Amount</th><th scope="col" class="th num" data-col="share">Share</th></tr>
          </thead>
          <tbody>
            <% @tenders.sort_by { |_, amount| -amount }.each do |method, amount| %>
              <tr>
                <td class="td"><%= method.to_s.humanize.presence || 'Unknown' %></td>
                <td class="td num" data-sort-value="<%= amount %>"><%= number_to_currency(amount) %></td>
                <td class="td num"><%= tender_total.zero? ? '—' : number_to_percentage(amount * 100.0 / tender_total, precision: 1) %></td>
              </tr>
            <% end %>
            <% if @tenders.empty? %><tr><td class="empty-row" colspan="3">No payment data in this window.</td></tr><% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>
