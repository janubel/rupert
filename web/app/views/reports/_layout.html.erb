<% content_for :title, title %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title"><%= title %></h1>
      <p class="mt-1 text-sm text-mocha"><%= subtitle %></p>
    </div>
    <div class="flex max-w-full flex-wrap items-center gap-2">
      <div class="flex max-w-full items-center gap-1 overflow-x-auto rounded-full border border-fog bg-paper p-1">
        <% { "sales" => "Sales", "financial" => "Financial", "inventory" => "Inventory", "operations" => "Operations", "reconciliation" => "Reconciliation" }.each do |key, label| %>
          <%= link_to label, send("#{key}_reports_path", days: @days), class: "nav-pill #{params[:action] == key ? "nav-pill-active" : "nav-pill-idle"}", aria: { current: (params[:action] == key ? "page" : nil) } %>
        <% end %>
      </div>
      <%= form_tag url_for(action: params[:action]), method: :get, class: "flex flex-wrap items-center gap-2" do %>
        <%= select_tag :days, options_for_select([["7 days", 7], ["30 days", 30], ["90 days", 90], ["1 year", 365]], @days), class: "select" %>
        <span class="text-xs text-taupe">or</span>
        <%= text_field_tag :from, @to_date ? (@range.to_date.iso8601) : "", type: "date", class: "select", title: "Start date" %>
        <span class="text-xs text-taupe">→</span>
        <%= text_field_tag :to, @to_date&.iso8601, type: "date", class: "select", title: "End date" %>
        <%= submit_tag "Refresh", class: "btn-ghost btn-sm" %>
      <% end %>
      <%= link_to "CSV", url_for(action: params[:action], format: :csv, days: @days, from: @to_date ? @range.to_date.iso8601 : nil, to: @to_date&.iso8601), class: "btn-ghost btn-sm", data: { turbo: false } %>
    </div>
  </section>
  <%= yield %>
</div>
