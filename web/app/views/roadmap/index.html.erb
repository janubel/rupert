<%# Features & roadmap: a reading page (docs/ui-standards.md §4, Settings width). %>
<div class="page-medium space-y-6">
  <%= page_header 'Features & roadmap', subtitle: 'Available means implemented in this release; planned features are not enabled.',
                  menu: [['Competitor functionality matrix', 'https://techmore.github.io/rupert/competitors.html']] %>
  <p class="text-xs text-taupe">Your role and configured connections determine access. Reviewed <%= @catalog.fetch('reviewed') %>.</p>
  <% @catalog.fetch('phases').each do |phase| %>
    <section class="section-card">
      <%= section_heading phase.fetch('name'), hint: phase.fetch('goal') %>
      <p class="text-sm"><strong>Acceptance:</strong> <%= phase.fetch('acceptance') %></p>
    </section>
  <% end %>
  <section class="space-y-4">
    <%= section_heading 'Functionality inventory' %>
    <div class="table-region" role="region" tabindex="0" aria-label="Functionality inventory">
      <table class="table">
        <thead><tr><th class="th" scope="col">Area / feature</th><th class="th" scope="col">Status</th><th class="th" scope="col">Scope</th></tr></thead>
        <tbody>
          <% @catalog.fetch('features').each do |feature| %>
            <tr>
              <th class="td text-left font-medium" scope="row"><%= feature.fetch('area') %> / <%= feature.fetch('name') %></th>
              <td class="td"><%= feature.fetch('status') %></td>
              <td class="td"><%= feature.fetch('scope') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
