<%= form_with model: user, url: (user.persisted? ? user_path(user) : users_path), class: "space-y-6" do |f| %>
  <% if user.errors.any? %><div role="alert" class="flash flash-alert"><%= user.errors.full_messages.to_sentence %></div><% end %>
  <fieldset class="space-y-4">
    <legend class="card-title">Account</legend>
    <div>
      <%= f.label :name, "Full name", class: "field-label" %>
      <%= f.text_field :name, class: "input", placeholder: "e.g. Jamie Rivera", autocomplete: "off" %>
    </div>
    <div>
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, class: "input", placeholder: "name@example.com", autocomplete: "off" %>
    </div>
    <div>
      <%= f.label :role, "Role", class: "field-label" %>
      <% role_locked = !Current.user.super_admin? && user.persisted? && user.admin? %>
      <%= f.select :role, @roles, { selected: user.role }, class: "select w-full", disabled: role_locked %>
      <% if role_locked %>
        <p class="mt-1 text-xs text-taupe">Only the super admin can change an administrator's role.</p>
      <% end %>
      <p class="mt-1 text-xs text-taupe">Roles are tuned on the <%= link_to 'Permissions', permissions_path, class: 'text-olive hover:underline' %> page.</p>
    </div>
    <div>
      <%= f.label :password, user.persisted? ? "New password (leave blank to keep current)" : "Password", class: "field-label" %>
      <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
      <p class="mt-1 text-xs text-taupe">At least 8 characters.</p>
    </div>
  </fieldset>
  <div class="form-actions">
    <%= f.submit "Save", class: "btn-primary" %>
    <%= link_to "Cancel", users_path, class: "btn-ghost" %>
  </div>
<% end %>
