<% can_manage_accounts = Current.user.can_manage_accounts? %>
<% content_for :title, "Edit user" %>
<div class="page-medium space-y-6">
  <%= page_header 'Edit user', subtitle: "#{@user.display_name} · #{@user.email} · #{@user.role.to_s.humanize} role" %>

  <% if can_manage_accounts && (Current.user.super_admin? || !@user.super_admin?) %>
  <div class="card card-pad">
    <%= render "form", user: @user %>
  </div>

  <% if @user.employee? %>
    <section class="section-card">
      <%= section_heading 'Staff-only access' %>
      <p class="text-sm text-mocha">This account can use POS and its own time clock, timesheets, time off and personal pay reports, plus view and update its assigned tasks. It cannot access sales history, reconciliation, company financial reports, customer records or account management. Permission overrides cannot expand the staff role.</p>
    </section>
  <% end %>
  <% unless @user.super_admin? || @user.employee? %>
    <section class="section-card">
      <%= section_heading 'Per-person permissions', hint: "Optional exceptions just for #{@user.display_name}. Leave empty to use their role's permissions." do %>
        <% if @user.permission_overrides? %>
          <span class="pill-clay">Overrides active</span>
        <% else %>
          <span class="pill-taupe">Using role defaults</span>
        <% end %>
      <% end %>

      <%= form_tag update_permissions_user_path(@user), method: :post, class: "space-y-4" do %>
        <div class="table-region" role="region" tabindex="0" aria-label="Per-person permissions">
          <table class="table">
            <thead>
              <tr>
                <th scope="col" class="th">Area / permission</th>
                <th scope="col" class="th w-24 text-center">Grant</th>
              </tr>
            </thead>
            <tbody>
              <% @catalog.each do |group| %>
                <tr class="bg-haze/40">
                  <th scope="rowgroup" colspan="2" class="px-4 py-2 text-left text-xs font-semibold text-mocha"><%= group[:area] %></th>
                </tr>
                <% group[:permissions].each do |permission| %>
                  <% checked = @user.user_permissions.find_by(permission: permission)&.enabled? %>
                  <tr>
                    <td class="td">
                      <label for="perm-<%= permission.tr('.', '-') %>" class="font-medium text-ink"><%= permission.split(".").last.humanize %></label>
                      <p class="font-mono text-xs text-taupe"><%= permission %></p>
                    </td>
                    <td class="td text-center">
                      <input type="checkbox" id="perm-<%= permission.tr('.', '-') %>" name="permissions[<%= permission %>]" value="1" <%= checked ? "checked" : "" %> class="checkbox">
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="form-actions">
          <%= submit_tag "Save permissions", class: "btn-primary" %>
          <span class="text-xs text-taupe">Unchecking everything returns <%= @user.display_name %> to role defaults.</span>
        </div>
      <% end %>
    </section>
  <% end %>
  <% else %>
    <p class="text-sm text-mocha">Account access is read-only. An administrator manages roles and permissions.</p>
  <% end %>
</div>
