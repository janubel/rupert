<% can_manage_accounts = Current.user.can_manage_accounts? %>
<% content_for :title, "Users" %>
<div class="space-y-6">
  <%= page_header 'Users', subtitle: 'Login accounts for Rupert and their access level.',
        menu: [['Permissions', permissions_path, { data: { tour: 'permissions' } }]] do %>
    <% if can_manage_accounts %>
    <%= link_to "Add user", new_user_path, class: "btn-primary", data: { tour: 'add' } %>
    <% end %>
  <% end %>

  <div class="card" <%= tour_anchor('table') %>>
    <div class="table-region" role="region" tabindex="0" aria-label="Users">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">User</th>
            <th scope="col" class="th">Email</th>
            <th scope="col" class="th" <%= tour_anchor('roles') %>>Role</th>
            <th scope="col" class="th" <%= tour_anchor('status') %>>Status</th>
            <th scope="col" class="th"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @users.empty? %>
            <tr><td colspan="5" class="empty-row">No users yet. Add your first user.</td></tr>
          <% end %>
          <% @users.each do |user| %>
            <tr>
              <td class="td">
                <p class="font-medium text-ink"><%= user.display_name %><% if user == Current.user %><span class="ml-1 text-xs text-taupe">(you)</span><% end %></p>
                <%# Phones: Role, Status and Actions scroll out of view, so summarise them here. %>
                <p class="mt-1 flex flex-wrap items-center gap-2 text-xs sm:hidden">
                  <span class="pill-taupe whitespace-nowrap"><%= user.role.to_s.humanize %></span>
                  <span class="<%= user.active? ? "text-fern" : "text-clay" %>"><%= user.active? ? "Active" : "Deactivated" %></span>
                  <%= link_to can_manage_accounts ? "Edit" : "Open", edit_user_path(user), class: "font-semibold text-olive hover:underline" %>
                </p>
              </td>
              <td class="td text-mocha"><%= user.email %></td>
              <td class="td"><span class="pill-taupe"><%= user.role.to_s.humanize %></span></td>
              <td class="td">
                <% if user.active? %>
                  <span class="pill-fern">Active</span>
                <% else %>
                  <span class="pill-clay">Deactivated</span>
                <% end %>
              </td>
              <td class="td text-right">
                <div class="inline-flex flex-wrap items-center justify-end gap-1">
                  <%= link_to can_manage_accounts ? "Edit" : "Open", edit_user_path(user), class: "btn-ghost btn-sm" %>
                  <% if can_manage_accounts && (Current.user.super_admin? || !user.super_admin?) %>
                  <% if user.active? %>
                    <%= button_to "Deactivate", deactivate_user_path(user), method: :post, class: "btn-ghost btn-sm", data: { turbo_confirm: "Deactivate #{user.display_name}? They won't be able to sign in." } %>
                  <% else %>
                    <%= button_to "Reactivate", activate_user_path(user), method: :post, class: "btn-ghost btn-sm" %>
                  <% end %>
                  <% unless user == Current.user %>
                    <%= button_to "Remove", user_path(user), method: :delete, class: "btn-ghost btn-sm text-rose", data: { turbo_confirm: "Permanently remove #{user.display_name}?" } %>
                  <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <p class="text-xs text-mocha">HR records (pay, position, documents) live under Staff.</p>
</div>
