<% can_manage_accounts = Current.user.can_manage_accounts? %>
<% content_for :title, "Accounts" %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Employee accounts</h1>
      <p class="mt-1 text-sm text-mocha">Login accounts for Rupert and their access level. HR records live under Employees.</p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Permissions", permissions_path, class: "btn-ghost" %>
      <% if can_manage_accounts %>
      <%= link_to "Add account", new_user_path, class: "btn-primary" %>
      <% end %>
    </div>
  </section>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Employee</th>
            <th scope="col" class="th">Email</th>
            <th scope="col" class="th">Role</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @users.empty? %>
            <tr><td colspan="5" class="empty-row">No accounts yet — add the first one.</td></tr>
          <% end %>
          <% @users.each do |user| %>
            <tr class="hover:bg-cream">
              <td class="td">
                <p class="font-medium text-ink"><%= user.display_name %><% if user == Current.user %><span class="ml-1 text-xs text-taupe">(you)</span><% end %></p>
                <%# Phones: Role, Status and Actions scroll out of view, so summarise them here. %>
                <p class="mt-1 flex flex-wrap items-center gap-2 text-xs sm:hidden">
                  <span class="pill-taupe whitespace-nowrap capitalize"><%= user.role.to_s.humanize %></span>
                  <span class="<%= user.active? ? "text-fern" : "text-clay" %>"><%= user.active? ? "active" : "deactivated" %></span>
                  <%= link_to can_manage_accounts ? "Edit" : "View", edit_user_path(user), class: "font-semibold text-olive hover:underline" %>
                </p>
              </td>
              <td class="td text-mocha"><%= user.email %></td>
              <td class="td"><span class="pill-taupe capitalize"><%= user.role.to_s.humanize %></span></td>
              <td class="td">
                <% if user.active? %>
                  <span class="pill-fern"><span class="dot bg-fern"></span> active</span>
                <% else %>
                  <span class="pill-clay"><span class="dot bg-clay"></span> deactivated</span>
                <% end %>
              </td>
              <td class="td text-right">
                <div class="inline-flex items-center gap-2">
                  <%= link_to can_manage_accounts ? "Edit" : "View", edit_user_path(user), class: "text-xs font-semibold text-olive hover:underline" %>
                  <% if can_manage_accounts && (Current.user.super_admin? || !user.super_admin?) %>
                  <% if user.active? %>
                    <%= button_to "Deactivate", deactivate_user_path(user), method: :post, class: "text-xs font-semibold text-clay hover:underline", data: { confirm: "Deactivate #{user.display_name}? They won't be able to sign in." } %>
                  <% else %>
                    <%= button_to "Reactivate", activate_user_path(user), method: :post, class: "text-xs font-semibold text-fern hover:underline" %>
                  <% end %>
                  <% unless user == Current.user %>
                    <%= button_to "Remove", user_path(user), method: :delete, class: "text-xs font-semibold text-rose hover:underline", data: { confirm: "Permanently remove #{user.display_name}?" } %>
                  <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
