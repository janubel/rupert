<% content_for :title, 'SwipeSimple source reports' %>
<div class="space-y-6">
  <%= page_header 'SwipeSimple source reports', subtitle: 'Native Transactions and Invoices CSV exports from SwipeSimple Web, kept as source observations.' %>
  <%= fold_explainer('C-Trax remains the retail inventory reference. Approved transaction amounts are recorded payments, including any tips already in Amount. Invoice totals are separate and are never added to sales. Declined, voided, errored and canceled transactions are excluded from money totals. Approval does not verify bank settlement. Exports omit receipt PDFs, invoice documents and linked-refund relationships. Original CSVs are retained encrypted, with SHA-256, source numbers and row positions. Missing tips remain unavailable. Reports use Rupert’s Eastern business day and the latest transaction observation and latest full invoice snapshot per account. Invoice numbers can repeat; invoice rows remain separate source observations. Delivery is checked every 30 minutes when an approved feed is configured. Import a fresh native export on demand below. The export timestamp shows source freshness; checking an empty inbox does not refresh vendor data.', class: 'text-sm text-mocha') %>

  <% if Current.user.can?('sync.write') %>
    <section id="import" class="section-card">
      <%= section_heading 'Review a native export', hint: 'Export one merchant account at a time and confirm its currency, time zone and export time.' %>
      <%= fold_explainer('Do not use the download/import time of a historical file as its export time. Invoice imports must include every invoice, without date, search or status filters. Keep the vendor headers intact. Maximum 8 MiB / 10,000 rows.', class: 'text-sm text-mocha') %>
      <% if @preview %>
        <div class="flash flash-notice" role="status">
          <p>Validated <%= @preview[:rows] %> <%= @preview[:kind] %> rows. Status counts: <%= @preview[:statuses].map { |status, count| "#{status}: #{count}" }.join(', ') %>.</p>
          <% if @preview[:kind] == 'transactions' %>
            <p>Approved sales: <%= @preview[:currency] %> <%= number_with_precision(@preview[:approved_sale_cents] / 100.0, precision: 2) %>. Approved refunds: <%= @preview[:currency] %> <%= number_with_precision(@preview[:approved_refund_cents] / 100.0, precision: 2) %>. Rows without tip evidence: <%= @preview[:missing_tip_rows] %>.</p>
          <% end %>
          <p>Review these counts and amounts against SwipeSimple. Reattach the identical file and import within 15 minutes. Changes to the file or context require a new preview.</p>
        </div>
      <% end %>
      <%= form_tag(@preview_token ? swipesimple_reports_path : preview_swipesimple_reports_path, multipart: true, data: { turbo: false }, class: 'space-y-4') do %>
        <%= hidden_field_tag :preview_token, @preview_token if @preview_token %>
        <fieldset class="grid gap-3 sm:grid-cols-2">
          <div><%= label_tag 'swipesimple_export_kind', 'Export type', class: 'field-label' %><%= select_tag 'swipesimple_export[kind]', options_for_select([['Transactions', 'transactions'], ['Invoices', 'invoices']], @context['kind']), class: 'select w-full' %></div>
          <div><%= label_tag 'swipesimple_export_invoice_scope', 'Invoice export scope', class: 'field-label' %><%= select_tag 'swipesimple_export[invoice_scope]', options_for_select([['Not an invoice export', ''], ['I confirm all invoices, no filters', 'full']], @context['invoice_scope']), class: 'select w-full' %></div>
          <div><%= label_tag 'swipesimple_export_merchant_account', 'Exact merchant account', class: 'field-label' %><%= text_field_tag 'swipesimple_export[merchant_account]', @context['merchant_account'], required: true, maxlength: 200, class: 'input' %></div>
          <div><%= label_tag 'swipesimple_export_currency', 'Confirmed currency', class: 'field-label' %><%= select_tag 'swipesimple_export[currency]', options_for_select(['USD'], @context['currency']), class: 'select w-full' %></div>
          <div><%= label_tag 'swipesimple_export_source_timezone', 'Source IANA time zone', class: 'field-label' %><%= text_field_tag 'swipesimple_export[source_timezone]', @context['source_timezone'], required: true, class: 'input' %></div>
          <div><%= label_tag 'swipesimple_export_exported_at', 'File export time with offset', class: 'field-label' %><%= text_field_tag 'swipesimple_export[exported_at]', @context['exported_at'], placeholder: '2026-10-15T20:30:00-04:00', required: true, class: 'input' %></div>
          <div class="sm:col-span-2"><%= label_tag :file, 'Native CSV file', class: 'field-label' %><%= file_field_tag :file, accept: '.csv,text/csv', required: true, class: 'input' %></div>
        </fieldset>
        <div class="form-actions">
          <%= submit_tag(@preview_token ? 'Import reviewed snapshot' : 'Preview snapshot', class: 'btn-primary') %>
          <% if @preview_token %><%= link_to 'Start a new preview', swipesimple_reports_path, class: 'btn-ghost' %><% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="section-card">
    <%= section_heading 'Daily cash / card / tip totals' %>
    <%= form_tag swipesimple_reports_path, method: :get, class: 'toolbar' do %>
      <div class="toolbar-field"><%= label_tag :day, 'Business day', class: 'field-label' %><%= date_field_tag :day, @report.day, class: 'input' %></div>
      <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary' %><%= link_to 'Clear', swipesimple_reports_path, class: 'btn-ghost' %></div>
    <% end %>
    <div class="table-region" role="region" tabindex="0" aria-label="SwipeSimple daily totals">
      <table class="table">
        <thead><tr><th scope="col" class="th">Account</th><th scope="col" class="th">Currency</th><th scope="col" class="th">Tender</th><th scope="col" class="th num">Sales</th><th scope="col" class="th num">Refunds</th><th scope="col" class="th num">Net</th><th scope="col" class="th num">Sale tips (included)</th><th scope="col" class="th num">Refund tips (included)</th><th scope="col" class="th num">Missing tips</th><th scope="col" class="th num">Excluded results</th></tr></thead>
        <tbody>
          <% @totals.each do |row| %><tr>
            <td class="td"><%= row[:account] %></td><td class="td"><%= row[:currency] %></td><td class="td"><%= row[:tender] %></td>
            <% %i[sale_cents refund_cents net_cents sale_tip_cents refund_tip_cents].each do |key| %><td class="td num"><%= row[key].nil? ? 'Unavailable' : number_with_precision(row[key] / 100.0, precision: 2) %></td><% end %>
            <td class="td num"><%= row[:missing_tip_rows] %></td><td class="td num"><%= row[:excluded_rows] %></td>
          </tr><% end %>
          <% if @totals.empty? %><tr><td colspan="10" class="empty-row">No imported transaction evidence for this day. This does not establish zero sales.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </section>

  <% [['Transactions on selected day', @transactions, 'Up to 200 rows.'], ['Latest invoice observations', @invoices, 'Up to 200 rows, all dates.']].each do |title, rows, hint| %>
    <section class="section-card">
      <%= section_heading title, hint: hint %>
      <div class="table-region" role="region" tabindex="0" aria-label="<%= title %>">
        <table class="table">
          <thead><tr><th scope="col" class="th">Source number</th><th scope="col" class="th">Account</th><th scope="col" class="th">Event / created</th><th scope="col" class="th">Type</th><th scope="col" class="th">Source status</th><th scope="col" class="th">Tender</th><th scope="col" class="th num">Amount</th><th scope="col" class="th">Reference / invoice</th><th scope="col" class="th">Due</th><th scope="col" class="th">Export / row</th><th scope="col" class="th">Snapshot as of</th></tr></thead>
          <tbody>
            <% rows.each do |row| %><tr>
              <td class="td font-mono text-xs"><%= row.source_number %></td><td class="td"><%= row.swipesimple_export.merchant_account %></td><td class="td"><%= row.occurred_at.in_time_zone.iso8601 %></td>
              <td class="td"><%= row.transaction_type || 'Invoice' %></td><td class="td"><%= row.status %></td><td class="td"><%= row.tender || 'Unverified' %></td>
              <td class="td num"><%= row.swipesimple_export.currency %> <%= number_with_precision(row.amount_cents / 100.0, precision: 2) %></td>
              <td class="td"><%= row.reference_number %></td><td class="td"><%= row.due_on %></td><td class="td text-xs">#<%= row.swipesimple_export_id %> / <%= row.source_row %></td><td class="td text-xs"><%= row.swipesimple_export.exported_at.iso8601 %></td>
            </tr><% end %>
            <% if rows.empty? %><tr><td colspan="11" class="empty-row">Nothing stored yet. Import a native export above.</td></tr><% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section class="section-card">
    <%= section_heading 'Recent source documents', hint: 'Latest 20. Download requires sync-write permission because the original contains private customer and operator fields.' %>
    <p class="text-xs text-mocha">Open downloaded CSVs as text; spreadsheet applications may execute formulas present in source fields.</p>
    <% if @exports.empty? %><p class="text-sm text-mocha">No source documents yet.</p><% end %>
    <ul class="divide-y divide-fog text-sm">
      <% @exports.each do |receipt| %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
          <span class="min-w-0 break-all">#<%= receipt.id %> · <%= receipt.kind %> · <%= receipt.merchant_account %> · exported <%= receipt.exported_at.iso8601 %> · imported <%= receipt.created_at.iso8601 %> · <code class="text-xs"><%= receipt.sha256 %></code></span>
          <% if Current.user.can?('sync.write') %><%= link_to 'Download CSV', document_swipesimple_report_path(receipt), class: 'btn-ghost btn-sm' %><% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>
