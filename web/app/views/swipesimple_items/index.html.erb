<% content_for :title, 'SwipeSimple items' %>
<% pill = { 'Matched' => 'pill-fern', 'Review name match' => 'pill-clay', 'Not matched' => 'pill-rose' } %>
<% tax_text = lambda do |r|
  rate = r['tax_rate'].presence && BigDecimal(r['tax_rate'])
  if rate then "#{rate.positive? ? 'Taxable' : 'Not taxed'} · #{r['tax_label']}#{" (#{rate.to_s('F')}%)" if rate.positive?}"
  elsif r['tax_label'] then "#{r['tax_label']} (rate unknown)"
  else '—'
  end
end %>
<div class="space-y-6">
  <%= page_header 'SwipeSimple items', subtitle: 'SwipeSimple\'s item list beside the same item in Shopify, Square and C-Trax, with mismatched names called out.', menu: [['Open C-Trax stock', ctrax_stock_index_path]] do %>
    <% if @match %><%= link_to 'Download CSV', swipesimple_items_path(snapshot_id: @snapshot.id, format: :csv), class: 'btn-primary', data: { turbo: false } %><% end %>
  <% end %>
  <%= fold_explainer('Matching uses exact SKU or barcode first, then exact product words and package size (shown as “review”). Nothing is written to SwipeSimple or any other system. To make names match, rename the item in SwipeSimple using the suggested name; the match CSV doubles as a rename list. Stock figures are each system\'s own count and are never added together.', class: 'text-sm text-mocha') %>

  <% if @snapshot.nil? %>
    <%= empty_state 'No SwipeSimple item list yet', hint: 'Once SwipeSimple website access is set up, the next pull reads it automatically. Until then, upload a CSV below.' %>
  <% else %>
    <% s = @match.summary %>
    <% if @snapshots.many? %>
      <%= page_tabs(@snapshots.map { |snap| [snap.merchant_account, swipesimple_items_path(snapshot_id: snap.id), snap == @snapshot] }, label: 'Merchant accounts') %>
    <% end %>
    <% if @snapshot.automatic? %>
      <p class="text-xs text-taupe"><%= @snapshot.merchant_account %> · <%= pluralize(@snapshot.row_count, 'active item') %> · Pulled automatically at <%= l(@snapshot.captured_at, format: :long) %> (refreshed when SwipeSimple's item list changes; removed items are left out)</p>
    <% else %>
      <p class="text-xs text-taupe"><%= @snapshot.merchant_account %> · <%= pluralize(@snapshot.row_count, 'item') %> · imported <%= l(@snapshot.captured_at, format: :long) %><%= " from #{@snapshot.source_filename}" if @snapshot.source_filename %><%= " by #{@snapshot.imported_by.email}" if @snapshot.imported_by %></p>
    <% end %>

    <section class="grid grid-cols-2 gap-3 sm:grid-cols-5" aria-label="Match summary">
      <div class="stat"><p class="stat-label">SwipeSimple items</p><p class="stat-value mt-1"><%= s[:items] %></p><p class="mt-1 text-xs text-taupe"><%= s[:unknown_stock] %> with unknown stock</p></div>
      <div class="stat"><p class="stat-label">Matched</p><p class="stat-value mt-1 text-fern"><%= s[:matched] %></p><p class="mt-1 text-xs text-taupe">by SKU, barcode or ID</p></div>
      <div class="stat"><p class="stat-label">Review name match</p><p class="stat-value mt-1"><%= s[:review] %></p><p class="mt-1 text-xs text-taupe">same words and package</p></div>
      <div class="stat"><p class="stat-label">Not matched</p><p class="stat-value mt-1 <%= 'text-rose' if s[:unmatched].positive? %>"><%= s[:unmatched] %></p></div>
      <div class="stat"><p class="stat-label">Names differ</p><p class="stat-value mt-1"><%= s[:names_differ] %></p><p class="mt-1 text-xs text-taupe">suggested name shown</p></div>
    </section>

    <%= form_tag swipesimple_items_path, method: :get, class: 'toolbar' do %>
      <%= hidden_field_tag :snapshot_id, @snapshot.id %>
      <div class="toolbar-field"><%= label_tag :status, 'Match', class: 'field-label' %><%= select_tag :status, options_for_select([['All matches', '']] + SwipesimpleItemMatch::STATUSES.map { |status| [status, status] }, @status), class: 'input' %></div>
      <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary', name: nil %><%= link_to 'Clear', swipesimple_items_path(snapshot_id: @snapshot.id), class: 'btn-ghost' %></div>
    <% end %>

    <div class="card overflow-hidden">
      <%= report_table 'swipesimple-items', label: 'SwipeSimple items matched to other systems' do %>
        <table class="table">
          <thead>
            <tr>
              <th scope="col" class="th" data-col="swipesimple">SwipeSimple item</th>
              <th scope="col" class="th" data-col="sku">SKU</th>
              <th scope="col" class="th" data-col="barcode" data-default-hidden>Barcode</th>
              <th scope="col" class="th" data-col="category" data-default-hidden>Category</th>
              <th scope="col" class="th num" data-col="price" data-default-hidden>Price</th>
              <th scope="col" class="th" data-col="tax">Tax</th>
              <th scope="col" class="th num" data-col="stock">SwipeSimple stock</th>
              <th scope="col" class="th" data-col="match">Match</th>
              <th scope="col" class="th" data-col="shopify">Shopify</th>
              <th scope="col" class="th" data-col="square">Square</th>
              <th scope="col" class="th" data-col="ctrax">C-Trax</th>
              <th scope="col" class="th" data-col="name">Name</th>
              <th scope="col" class="th" data-col="suggested">Suggested SwipeSimple name</th>
              <th scope="col" class="th" data-col="notes" data-default-hidden>Notes</th>
            </tr>
          </thead>
          <tbody>
            <% rows = @status.present? ? @match.rows.select { |row| row.status == @status } : @match.rows %>
            <% rows.each do |row| %>
              <% r = row.record %>
              <tr>
                <td class="td font-medium text-ink"><%= row.swipesimple_name %></td>
                <td class="td font-mono text-xs"><%= r['sku'].presence || '—' %></td>
                <td class="td font-mono text-xs"><%= r['barcode'].presence || '—' %></td>
                <td class="td text-mocha"><%= r['category'].presence || '—' %></td>
                <td class="td num"><%= r['price'] ? number_to_currency(r['price']) : '—' %></td>
                <td class="td"><%= tax_text.call(r) %></td>
                <td class="td num"><%= r['quantity'] || 'Unknown' %></td>
                <td class="td"><span class="<%= pill[row.status] %>"><%= row.status %></span><span class="block text-xs text-mocha"><%= row.identity %></span></td>
                <td class="td"><%= row.shopify_name || '—' %><% if row.shopify_sku.present? %><span class="block font-mono text-xs text-mocha"><%= row.shopify_sku %></span><% end %></td>
                <td class="td"><%= row.square_name.presence || '—' %></td>
                <td class="td"><%= row.ctrax_name.presence || '—' %></td>
                <td class="td"><span class="<%= { 'Same name' => 'pill-fern', 'Different name' => 'pill-clay' }.fetch(row.name_status, 'pill-taupe') %>"><%= row.name_status %></span></td>
                <td class="td"><%= row.suggested_name || '—' %></td>
                <td class="td text-xs text-mocha"><%= (row.evidence + row.issues).join('; ').presence || '—' %></td>
              </tr>
            <% end %>
            <% if rows.empty? %><tr><td class="empty-row" colspan="14">No items in this filter. Clear the filter to see every item.</td></tr><% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  <% end %>

  <% if Current.user.can?('inventory.write') %>
    <section class="section-card">
      <%= section_heading 'Upload an item list by hand (fallback)', hint: 'The SwipeSimple website pull reads the item list automatically with each pull (Settings → SwipeSimple). Use this only if that pull is paused or failing.' %>
      <details class="explainer">
        <summary class="explainer-summary">How to export the list</summary>
        <ol class="mt-1 list-decimal space-y-1 pl-5 text-sm text-mocha">
          <li>In SwipeSimple, open <strong>Items</strong> (or Inventory), choose <strong>Export</strong> and save it as a CSV.</li>
          <li>Upload it here. Columns such as Name/Item, Variant/Option, SKU, Barcode/UPC, Price, Quantity/Stock and Category are recognised automatically.</li>
          <li>The whole file is checked first; if anything is wrong nothing changes. A new import replaces the previous list for that merchant account.</li>
        </ol>
      </details>
      <%= form_with url: swipesimple_items_path, method: :post, multipart: true, class: 'toolbar' do %>
        <div class="toolbar-field"><%= label_tag :file, 'SwipeSimple item CSV', class: 'field-label' %><%= file_field_tag :file, accept: '.csv,text/csv', required: true, class: 'input' %></div>
        <div class="toolbar-field"><%= label_tag :merchant_account, 'Merchant account', class: 'field-label' %><%= text_field_tag :merchant_account, @default_account, class: 'input', maxlength: 120, placeholder: 'SwipeSimple' %></div>
        <div class="toolbar-actions"><%= submit_tag 'Upload', class: 'btn-primary', name: nil %></div>
      <% end %>
    </section>
  <% end %>
</div>
