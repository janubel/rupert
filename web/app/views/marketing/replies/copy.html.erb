<% content_for :title, 'Approved reply copy' %>
<div class="page-narrow space-y-6" data-controller="copy">
  <%= page_header 'Approved reply copy', subtitle: 'Publish this exact text manually while the offer is active, then record the reply URL.', eyebrow: 'Marketing · Reply' %>
  <%= fold_explainer('Eligibility was checked when this page opened. Reopen this page if the context or offer changes; changed wording requires a new review.', class: 'text-sm text-mocha') %>
  <div class="card card-pad space-y-4">
    <div>
      <label for="approved-reply" class="field-label">Copy the full reply</label>
      <textarea id="approved-reply" readonly rows="14" class="input w-full" data-copy-target="source"><%= @copy %></textarea>
    </div>
    <div class="form-actions">
      <button type="button" class="btn-primary" data-action="copy#copy">Copy to clipboard</button>
      <span hidden data-copy-target="status" aria-live="polite" class="text-xs text-fern">Copied</span>
      <%= link_to 'Open review and publication log', marketing_reply_path(@reply), class: 'btn-ghost' %>
    </div>
  </div>
</div>
