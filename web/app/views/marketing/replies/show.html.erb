<div class="max-w-4xl space-y-5">
  <%= link_to 'Back to Marketing', marketing_path, class: 'btn-ghost' %><h1 class="text-2xl font-semibold">Review reply</h1>
  <section class="card card-pad space-y-3"><h2 class="font-semibold"><%= @reply.thread.title %> · <%= @reply.status.humanize %></h2><%= link_to 'Read original discussion', @reply.thread.url, target: '_blank', rel: 'noopener noreferrer', class: 'underline' %><p class="whitespace-pre-wrap"><%= @reply.thread.excerpt %></p><p>Group: <%= @reply.thread.community.name %></p><p class="whitespace-pre-wrap"><%= @reply.thread.community.promotion_rules %></p><%= link_to 'Read group rules', @reply.thread.community.rules_url, target: '_blank', rel: 'noopener noreferrer', class: 'underline' %></section>
  <% if Current.user.can?('marketing.write') && !%w[published removed].include?(@reply.status) %>
    <%= form_with model: @reply, scope: :reply, url: @reply.persisted? ? marketing_reply_path(@reply) : marketing_replies_path, class: 'card card-pad space-y-4' do |f| %>
      <%= f.hidden_field :thread_id %><%= f.hidden_field :lock_version if @reply.persisted? %>
      <div><%= f.label :body, 'Useful reply to this discussion', class: 'block' %><%= f.text_area :body, rows: 6, maxlength: 5000, class: 'input w-full', required: true %></div>
      <div><%= f.label :affiliation, 'Your brand affiliation disclosure', class: 'block' %><%= f.text_field :affiliation, maxlength: 300, class: 'input w-full', required: true, placeholder: 'I work with …' %></div>
      <div><%= f.label :offer_id, 'Group offer', class: 'block' %><%= f.select :offer_id, Marketing::Offer.where(community_id: @reply.thread.community_id).order(created_at: :desc).limit(200).map { |o| ["#{o.code} · #{o.shareable? ? 'ready' : 'needs verification / not active'}", o.id] }, { include_blank: 'Choose…' }, class: 'select w-full', required: true %></div>
      <p class="text-sm">The reviewed copy includes your reply, affiliation, code, terms, expiry and campaign link. Saving creates a new draft and invalidates prior approval.</p><%= f.submit 'Save draft', class: 'btn-primary' %>
    <% end %>
  <% else %><section class="card card-pad"><p class="whitespace-pre-wrap"><%= @reply.body %></p><p><%= @reply.affiliation %></p></section><% end %>
  <% if @reply.persisted? %>
    <% if @reply.snapshot_json.present? %><section class="card card-pad space-y-3"><h2 class="font-semibold">Submitted revision</h2><pre class="whitespace-pre-wrap break-words text-sm"><%= JSON.parse(@reply.snapshot_json).fetch('text') %></pre><p class="text-xs">Approval and copy actions recheck the group rules, thread context and offer against this revision.</p></section><% end %>
    <% if @reply.offer %><section class="card card-pad space-y-2"><h2 class="font-semibold">Current offer: <%= @reply.offer.code %></h2><p class="whitespace-pre-wrap"><%= @reply.offer.terms %></p><p>Expires <%= @reply.offer.ends_at.to_fs(:short) %> · <%= @reply.offer.shareable? ? 'Ready to share' : 'Verification / active dates need review' %></p><%= link_to 'Open offer destination', @reply.offer.destination_url, target: '_blank', rel: 'noopener noreferrer', class: 'underline' %><% if Current.user.can?('marketing.write') %> · <%= link_to 'Edit offer record', edit_marketing_offer_path(@reply.offer), class: 'underline' %><% end %></section><% end %>
    <section class="card card-pad space-y-3"><h2 class="font-semibold">Workflow</h2>
      <% if Current.user.can?('marketing.write') && %w[draft rejected].include?(@reply.status) %><%= button_to 'Submit for review', transition_marketing_reply_path(@reply), params: { transition: 'submit', lock_version: @reply.lock_version }, class: 'btn-primary' %><% end %>
      <% if Current.user.can?('marketing.review') && @reply.status == 'pending_review' %><%= button_to 'Approve this revision', transition_marketing_reply_path(@reply), params: { transition: 'approve', lock_version: @reply.lock_version }, class: 'btn-primary' %><%= form_with url: transition_marketing_reply_path(@reply), class: 'space-y-2' do |f| %><%= hidden_field_tag :lock_version, @reply.lock_version %><%= text_area_tag :note, nil, placeholder: 'Review note', 'aria-label': 'Review note', class: 'input w-full', maxlength: 3000, required: true %><%= select_tag :transition, options_for_select([['Request changes', 'changes'], ['Reject', 'reject']]), class: 'select' %><%= f.submit 'Record review decision', class: 'btn-ghost' %><% end %><% end %>
      <% if Current.user.can?('marketing.write') && @reply.status == 'approved' %><%= button_to 'Open approved copy', transition_marketing_reply_path(@reply), params: { transition: 'copy', lock_version: @reply.lock_version }, class: 'btn-primary' %><%= form_with url: transition_marketing_reply_path(@reply), class: 'space-y-3' do |f| %><%= hidden_field_tag :lock_version, @reply.lock_version %><%= hidden_field_tag :transition, 'publish' %><%= label_tag :published_url, 'Published reply URL' %><%= url_field_tag :published_url, nil, class: 'input w-full', required: true %><label class="block"><%= check_box_tag :exact_text, '1', false, required: true %> I published the exact approved text. Changed wording requires a new review.</label><%= f.submit 'Record manual publication', class: 'btn-ghost' %><% end %><% end %>
      <% if @reply.published_url.present? %><p><%= link_to 'Published reply', @reply.published_url, target: '_blank', rel: 'noopener noreferrer', class: 'underline' %> · <%= @reply.published_at.to_fs(:short) %></p><% end %>
      <% if Current.user.can?('marketing.write') && @reply.status == 'published' %><%= form_with url: transition_marketing_reply_path(@reply), class: 'space-y-2' do |f| %><%= hidden_field_tag :lock_version, @reply.lock_version %><%= hidden_field_tag :transition, 'remove' %><%= text_field_tag :note, nil, placeholder: 'Removal reason', 'aria-label': 'Removal reason', class: 'input', required: true %><%= f.submit 'Record removal', class: 'btn-ghost' %><% end %><% end %>
    </section>
    <section class="card card-pad space-y-3"><h2 class="font-semibold">Revision and review history</h2><p class="text-sm">Latest 50 events. Publication records are operator attestations.</p><% @reply.review_events.order(id: :desc).limit(50).each do |event| %><details><summary><%= event.action.humanize %> · actor <%= event.actor_id %> · <%= event.created_at.to_fs(:short) %></summary><pre class="whitespace-pre-wrap break-words text-xs"><%= JSON.pretty_generate(JSON.parse(event.payload_json)) %></pre></details><% end %></section>
  <% end %>
</div>
