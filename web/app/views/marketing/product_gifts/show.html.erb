<div class="space-y-6 max-w-5xl">
  <%= link_to @gift.engagement.title, marketing_engagement_path(@gift.engagement), class: 'btn-ghost' %><h1 class="text-2xl font-semibold">Product gift #<%= @gift.id %></h1>
  <section class="card card-pad space-y-3"><p><%= @gift.engagement.influencer.name %> · <%= @gift.status.humanize %></p><p class="whitespace-pre-wrap"><%= @gift.note %></p><p>Estimated products: <%= @gift.estimated_product_cents.nil? ? 'Unknown' : "#{number_with_precision(@gift.estimated_product_cents / 100.0, precision: 2)} #{@gift.currency}" %> · Estimated shipping: <%= @gift.shipping_cost_cents.nil? ? 'Unknown' : "#{number_with_precision(@gift.shipping_cost_cents / 100.0, precision: 2)} #{@gift.currency}" %></p><p class="text-sm text-mocha">Gift and shipment status are operator records. Stock, orders and financial entries are not changed by this workflow.</p><% if Current.user.can?('marketing.write') && %w[proposed approved ready_to_ship].include?(@gift.status) %><%= link_to 'Edit gift / delivery details', edit_marketing_product_gift_path(@gift), class: 'btn-ghost' %><% end %></section>
  <section class="card card-pad space-y-4"><h2 class="text-lg font-semibold">Gift products</h2>
    <% @gift.items.order(:id).each do |item| %><article class="border-b border-sand pb-3 space-y-2"><p class="font-semibold"><%= item.product_name %> · <%= item.sku.presence || 'No SKU' %></p><p class="text-sm">Shopify variant: <%= item.source_variant_id %> · Quantity <%= item.quantity %> · Estimated unit cost <%= item.unit_cost_cents.nil? ? 'Unknown' : "#{item.unit_cost_cents} cents #{@gift.currency}" %></p>
      <% if Current.user.can?('marketing.write') && @gift.status == 'proposed' %><%= form_with url: item_marketing_product_gift_path(@gift), class: 'flex flex-wrap gap-2' do |f| %><%= hidden_field_tag :lock_version, @gift.lock_version %><%= hidden_field_tag :item_action, 'update_item' %><%= hidden_field_tag :item_id, item.id %><%= number_field_tag 'gift_item[quantity]', item.quantity, min: 1, max: 10000, class: 'input', 'aria-label': 'Gift item quantity' %><%= number_field_tag 'gift_item[unit_cost_cents]', item.unit_cost_cents, min: 0, class: 'input', 'aria-label': 'Estimated unit cost in cents' %><%= f.submit 'Update product', class: 'btn-ghost' %><% end %><%= button_to 'Remove product', item_marketing_product_gift_path(@gift), params: { lock_version: @gift.lock_version, item_action: 'remove_item', item_id: item.id }, class: 'btn-ghost' %><% end %>
    </article><% end %>
    <% if @variants %><%= form_with url: marketing_product_gift_path(@gift), method: :get, class: 'flex flex-wrap gap-2' do |f| %><%= f.search_field :q, value: params[:q], placeholder: 'Search variant SKU or title', class: 'input', 'aria-label': 'Search gift products' %><%= f.submit 'Find products', class: 'btn-ghost' %><% end %>
      <%= form_with url: item_marketing_product_gift_path(@gift), class: 'space-y-3' do |f| %><%= hidden_field_tag :lock_version, @gift.lock_version %><%= hidden_field_tag :item_action, 'add_item' %><%= select_tag 'gift_item[source_variant_id]', options_for_select(@variants.first(50).map { |v| [[v.product&.title, v.title, v.sku].compact.join(' · '), v.id] }), include_blank: 'Choose a product variant', class: 'select w-full', 'aria-label': 'Product variant', required: true %><div class="flex flex-wrap gap-2"><%= number_field_tag 'gift_item[quantity]', 1, min: 1, max: 10000, class: 'input', 'aria-label': 'Quantity', required: true %><%= number_field_tag 'gift_item[unit_cost_cents]', nil, min: 0, class: 'input', placeholder: 'Unit cost cents (optional)', 'aria-label': 'Estimated unit cost cents' %><%= f.submit 'Add product', class: 'btn-primary' %></div><% end %><% if @variants.length > 50 %><p class="text-xs">First 50 matches shown. Refine the SKU/title search to find other products.</p><% end %>
    <% end %>
  </section>
  <% if Current.user.can?('marketing.contacts') %><section class="card card-pad space-y-3"><h2 class="font-semibold">Restricted recipient and tracking</h2><pre class="whitespace-pre-wrap"><%= @gift.shipping_details %></pre><p>Recipient confirmed: <%= @gift.recipient_confirmed_at&.to_fs(:short) || 'not yet' %></p><p><%= @gift.carrier %> <%= @gift.tracking_number %></p><% if @gift.tracking_url.present? %><%= link_to 'Tracking evidence', @gift.tracking_url, target: '_blank', rel: 'noopener noreferrer', class: 'underline' %><% end %></section><% end %>
  <section class="card card-pad space-y-3"><h2 class="text-lg font-semibold">Gift workflow</h2>
    <% if Current.user.can?('marketing.review') && @gift.status == 'proposed' %><%= button_to 'Approve products and budget', transition_marketing_product_gift_path(@gift), params: { lock_version: @gift.lock_version, gift_action: 'approve' }, class: 'btn-primary' %><% end %>
    <% if Current.user.can?('marketing.write') && Current.user.can?('marketing.contacts') %>
      <% if %w[proposed approved ready_to_ship].include?(@gift.status) %><%= form_with url: transition_marketing_product_gift_path(@gift), class: 'space-y-2' do |f| %><%= hidden_field_tag :lock_version, @gift.lock_version %><%= hidden_field_tag :gift_action, 'confirm_recipient' %><label><%= check_box_tag :confirmed, '1', false, required: true %> The recipient confirmed these shipping details.</label><%= f.submit 'Record recipient confirmation', class: 'btn-ghost' %><% end %><% end %>
      <% if @gift.status == 'approved' %><%= button_to 'Mark ready to ship', transition_marketing_product_gift_path(@gift), params: { lock_version: @gift.lock_version, gift_action: 'ready' }, class: 'btn-primary' %><% end %>
      <% if %w[ready_to_ship shipped].include?(@gift.status) %><%= form_with url: transition_marketing_product_gift_path(@gift), class: 'space-y-2' do |f| %><%= hidden_field_tag :lock_version, @gift.lock_version %><%= hidden_field_tag :gift_action, @gift.status == 'ready_to_ship' ? 'ship' : 'deliver' %><label><%= check_box_tag :confirmed, '1', false, required: true %> I checked the actual <%= @gift.status == 'ready_to_ship' ? 'shipment / tracking' : 'delivery' %> evidence.</label><%= f.submit @gift.status == 'ready_to_ship' ? 'Record shipped' : 'Record delivered', class: 'btn-primary' %><% end %><% end %>
    <% end %>
    <% if Current.user.can?('marketing.write') && !%w[cancelled returned].include?(@gift.status) && (!%w[shipped delivered].include?(@gift.status) || Current.user.can?('marketing.contacts')) %><%= form_with url: transition_marketing_product_gift_path(@gift), class: 'space-y-2' do |f| %><%= hidden_field_tag :lock_version, @gift.lock_version %><%= hidden_field_tag :gift_action, %w[shipped delivered].include?(@gift.status) ? 'return' : 'cancel' %><%= text_field_tag :reason, nil, placeholder: 'Cancellation / return reason', class: 'input w-full', required: true, 'aria-label': 'Cancellation or return reason' %><%= f.submit %w[shipped delivered].include?(@gift.status) ? 'Record return' : 'Cancel gift', class: 'btn-ghost' %><% end %><% end %>
    <p class="text-xs">Shipped: <%= @gift.shipped_at&.to_fs(:short) || 'not recorded' %> · Delivered: <%= @gift.delivered_at&.to_fs(:short) || 'not recorded' %> · Returned: <%= @gift.returned_at&.to_fs(:short) || 'not recorded' %></p>
  </section>
  <%= render 'marketing/cms/history', record: @gift %>
</div>
