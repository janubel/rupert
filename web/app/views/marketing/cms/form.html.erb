<% kind = @record.class.model_name.element.humanize.downcase %>
<% kind = 'collaboration' if @record.is_a?(Marketing::Engagement) %>
<% title = "#{@record.persisted? ? 'Edit' : 'Add'} #{kind}" %>
<% content_for :title, title %>
<% hints = { Marketing::Influencer => 'Use Notes for audience fit and business context. Put contact details and recipient addresses in the restricted fields. Setting Do not contact suppresses offer sharing and new gift handoffs. Follow-up dates appear in the directory; no reminder or outreach is sent automatically.',
             Marketing::Engagement => 'Choose an existing Marketing campaign and a destination on that campaign’s storefront host. Activate the collaboration when its offer and product-gifting work should proceed. Each collaboration gets its own referral URL.',
             Marketing::Offer => 'Record a code already created in your store, with its full terms, start and end dates, usage limits and merchant evidence URL. A reviewer confirms the evidence for 24 hours before sharing. Saving this form does not create or deactivate a merchant discount.',
             Marketing::ProductGift => 'Costs are estimates entered in minor currency units (100 cents = 1 USD). Leave unknown costs blank. Confirm the recipient address after saving. Approved product/budget details lock; carrier and tracking can be updated until shipment. This record does not reserve or deduct inventory.',
             Marketing::Document => 'Write a brief, instructions, agreement, disclosure or permission record here, or link to an external document. Content is displayed as plain text. Every save creates a revision and resets review. Restricted documents require contacts access. A review records an operator check; it does not sign an agreement or obtain content reuse permission.' } %>
<% hint = hints.find { |klass, _| @record.is_a?(klass) }&.last %>
<div class="page-narrow space-y-6">
  <%= page_header title, subtitle: 'Times use Rupert’s configured Eastern timezone; selectors show up to 200 workspace entries.', eyebrow: 'Marketing · Influencers' %>
  <%= fold_explainer(hint, class: 'text-sm text-mocha') if hint %>
  <div class="card card-pad">
    <%= form_with model: @record, scope: :cms_record, url: @form_url, class: 'space-y-6' do |f| %>
      <%= f.hidden_field :lock_version if @record.persisted? %>
      <% if @record.errors.any? %>
        <div role="alert" class="flash flash-alert">
          <p class="font-semibold">Please fix the following:</p>
          <ul class="mt-1 list-disc pl-5"><% @record.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>
      <fieldset class="space-y-4">
        <legend class="card-title">Details</legend>
        <% influencer_cms_fields(@record).each do |field| %>
          <div><%= f.label field, class: 'field-label' %>
            <% if (choices = influencer_cms_choices(@record, field)) %>
              <%= f.select field, choices, { include_blank: 'Choose…' }, class: 'select w-full' %>
            <% elsif %i[topics notes private_notes shipping_details deliverables terms body note].include?(field) %>
              <%= f.text_area field, rows: field == :body ? 12 : 4, maxlength: field == :body ? 20000 : 5000, class: 'input w-full' %>
            <% elsif field.to_s.end_with?('_at') %>
              <%= f.datetime_local_field field, class: 'input w-full' %>
            <% elsif field.to_s.end_with?('_url') %>
              <%= f.url_field field, maxlength: 2000, class: 'input w-full', placeholder: 'https://…' %>
            <% elsif field.to_s.end_with?('_cents') %>
              <%= f.number_field field, min: 0, max: 99999999, step: 1, class: 'input w-full' %>
            <% elsif field == :contact_email %>
              <%= f.email_field field, maxlength: 254, class: 'input w-full' %>
            <% else %>
              <%= f.text_field field, maxlength: 200, class: 'input w-full' %>
            <% end %>
          </div>
        <% end %>
      </fieldset>
      <div class="form-actions">
        <%= f.submit 'Save', class: 'btn-primary' %>
        <%= link_to 'Cancel', @back_url, class: 'btn-ghost' %>
      </div>
    <% end %>
  </div>
</div>
