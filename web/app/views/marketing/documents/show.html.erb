<% content_for :title, @document.title %>
<% can_write = Current.user.can?('marketing.write') %>
<% menu = [['Open collaboration', marketing_engagement_path(@document.engagement)]] %>
<% menu << ['Supporting document / evidence', @revision.source_url, { target: '_blank', rel: 'noopener noreferrer' }] if @revision&.source_url.present? %>
<div class="page-medium space-y-6">
  <%= page_header @document.title, subtitle: "#{@document.kind.humanize} · #{@document.visibility.humanize} · #{@document.engagement.title}", eyebrow: 'Marketing · Document', menu: menu do %>
    <span class="pill-taupe"><%= @document.status.humanize %></span>
    <% if can_write %><%= link_to 'Edit', edit_marketing_document_path(@document), class: 'btn-primary', title: 'Edit the document and add a revision' %><% end %>
  <% end %>

  <% if @revision %>
    <section class="section-card" aria-label="Current revision">
      <%= section_heading "Revision #{@revision.number} · #{@revision.title}", hint: "Recorded #{@revision.created_at.to_fs(:short)} by actor #{@revision.actor_id}." %>
      <pre class="whitespace-pre-wrap break-words font-sans text-sm"><%= @revision.body %></pre>
      <% if @revision.source_url.present? %><p class="text-sm"><%= link_to 'Supporting document / evidence', @revision.source_url, target: '_blank', rel: 'noopener noreferrer', class: 'underline' %></p><% end %>
    </section>
  <% end %>

  <section class="section-card" aria-label="Review">
    <%= section_heading 'Review', hint: 'A review records an operator check of the current revision, not a signature or externally verified consent.' do %>
      <span class="<%= @document.reviewed_at ? 'pill-fern' : 'pill-clay' %>"><%= @document.reviewed_at ? "Reviewed #{@document.reviewed_at.to_fs(:short)}" : 'Not reviewed yet' %></span>
    <% end %>
    <% if Current.user.can?('marketing.review') %><%= button_to 'Mark current revision reviewed', review_marketing_document_path(@document), params: { lock_version: @document.lock_version }, class: 'btn-ghost' %><% end %>
  </section>

  <section class="section-card" aria-label="Revision history">
    <%= section_heading 'Revision history', hint: 'Latest 50 revisions listed. Existing revisions are retained.' %>
    <ul class="divide-y divide-fog text-sm">
      <% @revisions.each do |revision| %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
          <%= link_to "Revision #{revision.number} · #{revision.title}", marketing_document_path(@document, revision: revision.id), class: 'font-medium text-olive-deep hover:underline' %>
          <span class="text-xs text-taupe"><%= revision.created_at.to_fs(:short) %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <%= render 'marketing/cms/history', record: @document %>
</div>
