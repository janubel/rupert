<div class="space-y-5 max-w-4xl"><%= link_to @document.engagement.title, marketing_engagement_path(@document.engagement), class: 'btn-ghost' %><h1 class="text-2xl font-semibold"><%= @document.title %></h1><p><%= @document.kind.humanize %> · <%= @document.visibility.humanize %> · <%= @document.status.humanize %></p>
  <% if Current.user.can?('marketing.write') %><%= link_to 'Edit / add revision', edit_marketing_document_path(@document), class: 'btn-primary' %><% end %>
  <% if @revision %><section class="card card-pad space-y-3"><h2 class="font-semibold">Revision <%= @revision.number %> · <%= @revision.title %></h2><p class="text-xs">Recorded <%= @revision.created_at.to_fs(:short) %> by actor <%= @revision.actor_id %></p><pre class="whitespace-pre-wrap break-words font-sans"><%= @revision.body %></pre><% if @revision.source_url.present? %><%= link_to 'Supporting document / evidence', @revision.source_url, target: '_blank', rel: 'noopener noreferrer', class: 'underline' %><% end %></section><% end %>
  <% if Current.user.can?('marketing.review') %><%= button_to 'Mark current revision reviewed', review_marketing_document_path(@document), params: { lock_version: @document.lock_version }, class: 'btn-ghost' %><% end %><p class="text-xs text-mocha">Reviewed: <%= @document.reviewed_at&.to_fs(:short) || 'not yet' %>. Review records an operator check of the current revision, not a signature or externally verified consent.</p>
  <section class="card card-pad space-y-3"><h2 class="font-semibold">Revision history</h2><% @revisions.each do |revision| %><p><%= link_to "Revision #{revision.number} · #{revision.title}", marketing_document_path(@document, revision: revision.id), class: 'underline' %> · <%= revision.created_at.to_fs(:short) %></p><% end %><p class="text-xs">Latest 50 revisions listed. Existing revisions are retained.</p></section><%= render 'marketing/cms/history', record: @document %>
</div>
