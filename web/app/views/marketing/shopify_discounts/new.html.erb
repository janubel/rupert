<div class="max-w-3xl space-y-5">
  <%= link_to @engagement.title, marketing_engagement_path(@engagement), class: 'btn-ghost' %>
  <h1 class="text-2xl font-semibold">Create an influencer code in Shopify</h1>
  <p><%= @engagement.influencer.name %> · <%= @engagement.campaign.name %></p>
  <p>Set the offer, save a draft, then review it before creation. Codes apply to all products and all customers on one-time purchases. They exclude subscriptions and shipping, and cannot combine with other discounts.</p>
  <%= form_with url: marketing_engagement_shopify_discounts_path(@engagement), scope: :discount, class: 'card card-pad space-y-4' do |f| %>
    <div><%= f.label :code, 'Discount code', class: 'block text-sm' %><%= f.text_field :code, value: @values[:code], required: true, maxlength: 80, pattern: '[A-Za-z0-9_-]{2,80}', class: 'input w-full' %></div>
    <div><%= f.label :kind, 'Discount type', class: 'block text-sm' %><%= f.select :kind, [['Percentage off', 'percentage'], ['Fixed amount off in the store currency', 'fixed']], { selected: @values[:kind] }, class: 'input w-full' %></div>
    <div><%= f.label :value, 'Discount value (percent or store-currency amount)', class: 'block text-sm' %><%= f.number_field :value, required: true, min: 0.01, max: 99999999, step: 0.01, class: 'input w-full' %></div>
    <div><%= f.label :minimum_subtotal, 'Minimum spend in the store currency (0 for none)', class: 'block text-sm' %><%= f.number_field :minimum_subtotal, value: @values[:minimum_subtotal], min: 0, max: 99999999, step: 0.01, required: true, class: 'input w-full' %></div>
    <div><%= f.label :usage_limit, 'Maximum total redemptions', class: 'block text-sm' %><%= f.number_field :usage_limit, value: @values[:usage_limit], required: true, min: 1, max: 1000000, step: 1, class: 'input w-full' %></div>
    <div><%= f.label :once_per_customer, 'Customer usage', class: 'block text-sm' %><%= f.select :once_per_customer, [['Once per customer', '1'], ['Allow repeat use within the total limit', '0']], { selected: @values[:once_per_customer] }, class: 'input w-full' %></div>
    <div><%= f.label :starts_at, 'Starts at', class: 'block text-sm' %><%= f.datetime_local_field :starts_at, value: @values[:starts_at].strftime('%Y-%m-%dT%H:%M'), required: true, class: 'input w-full' %></div>
    <div><%= f.label :ends_at, 'Expires at', class: 'block text-sm' %><%= f.datetime_local_field :ends_at, value: @values[:ends_at].strftime('%Y-%m-%dT%H:%M'), required: true, class: 'input w-full' %></div>
    <p class="text-sm">Times use <%= Time.zone.name %>. The review screen confirms the Shopify store and its currency. The campaign storefront must match that store’s primary domain.</p>
    <%= f.submit 'Save draft and review', class: 'btn-primary' %>
  <% end %>
</div>
