<% content_for :title, 'Add Shopify code' %>
<div class="page-narrow space-y-6">
  <%= page_header 'Add Shopify code', subtitle: "#{@engagement.influencer.name} · #{@engagement.campaign.name}", eyebrow: 'Marketing · Collaboration' %>
  <%= fold_explainer('Set the offer, save a draft, then review it before creation. Codes apply to all products and all customers on one-time purchases. They exclude subscriptions and shipping, and cannot combine with other discounts.', class: 'text-sm text-mocha') %>
  <div class="card card-pad">
    <%= form_with url: marketing_engagement_shopify_discounts_path(@engagement), scope: :discount, class: 'space-y-6' do |f| %>
      <fieldset class="space-y-4">
        <legend class="card-title">Offer</legend>
        <div><%= f.label :code, 'Discount code', class: 'field-label' %><%= f.text_field :code, value: @values[:code], required: true, maxlength: 80, pattern: '[A-Za-z0-9_\-]{2,80}', class: 'input w-full' %></div>
        <div><%= f.label :kind, 'Discount type', class: 'field-label' %><%= f.select :kind, [['Percentage off', 'percentage'], ['Fixed amount off in the store currency', 'fixed']], { selected: @values[:kind] }, class: 'select w-full' %></div>
        <div><%= f.label :value, 'Discount value (percent or store-currency amount)', class: 'field-label' %><%= f.number_field :value, required: true, min: 0.01, max: 99999999, step: 0.01, class: 'input w-full' %></div>
        <div><%= f.label :minimum_subtotal, 'Minimum spend in the store currency (0 for none)', class: 'field-label' %><%= f.number_field :minimum_subtotal, value: @values[:minimum_subtotal], min: 0, max: 99999999, step: 0.01, required: true, class: 'input w-full' %></div>
      </fieldset>
      <fieldset class="space-y-4">
        <legend class="card-title">Limits and dates</legend>
        <div><%= f.label :usage_limit, 'Maximum total redemptions', class: 'field-label' %><%= f.number_field :usage_limit, value: @values[:usage_limit], required: true, min: 1, max: 1000000, step: 1, class: 'input w-full' %></div>
        <div><%= f.label :once_per_customer, 'Customer usage', class: 'field-label' %><%= f.select :once_per_customer, [['Once per customer', '1'], ['Allow repeat use within the total limit', '0']], { selected: @values[:once_per_customer] }, class: 'select w-full' %></div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><%= f.label :starts_at, 'Starts at', class: 'field-label' %><%= f.datetime_local_field :starts_at, value: @values[:starts_at].strftime('%Y-%m-%dT%H:%M'), required: true, class: 'input w-full' %></div>
          <div><%= f.label :ends_at, 'Expires at', class: 'field-label' %><%= f.datetime_local_field :ends_at, value: @values[:ends_at].strftime('%Y-%m-%dT%H:%M'), required: true, class: 'input w-full' %></div>
        </div>
        <p class="text-xs text-taupe">Times use <%= Time.zone.name %>. The review screen confirms the Shopify store and its currency. The campaign storefront must match that store’s primary domain.</p>
      </fieldset>
      <div class="form-actions">
        <%= f.submit 'Save draft and review', class: 'btn-primary' %>
        <%= link_to 'Cancel', marketing_engagement_path(@engagement), class: 'btn-ghost' %>
      </div>
    <% end %>
  </div>
</div>
