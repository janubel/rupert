<div class="space-y-6 max-w-5xl">
  <%= link_to 'Influencer directory', marketing_influencers_path, class: 'btn-ghost' %>
  <h1 class="page-title"><%= @influencer.name %></h1>
  <section class="card card-pad space-y-3"><p><%= @influencer.platform %> <%= @influencer.handle %> · <%= @influencer.stage.humanize %></p><% if @influencer.profile_url.present? %><%= link_to 'Public profile', @influencer.profile_url, target: '_blank', rel: 'noopener noreferrer', class: 'underline' %><% end %><p>Owner: <%= @influencer.owner&.display_name || 'Unassigned' %> · Next follow-up: <%= @influencer.next_follow_up_at&.to_fs(:short) || 'Not scheduled' %></p><p class="whitespace-pre-wrap"><%= @influencer.topics %></p><p class="whitespace-pre-wrap"><%= @influencer.notes %></p>
    <% if Current.user.can?('marketing.write') %><%= link_to 'Edit prospect / relationship', edit_marketing_influencer_path(@influencer), class: 'btn-ghost' %><%= link_to 'New collaboration', new_marketing_influencer_engagement_path(@influencer), class: 'btn-primary' %><% end %>
  </section>
  <% if Current.user.can?('marketing.contacts') %><section class="card card-pad space-y-3"><h2 class="font-semibold">Restricted contact and recipient details</h2><p><%= @influencer.contact_email.presence || 'No contact email recorded' %></p><pre class="whitespace-pre-wrap"><%= @influencer.shipping_details %></pre><pre class="whitespace-pre-wrap"><%= @influencer.private_notes %></pre></section><% end %>
  <section class="card card-pad space-y-3"><h2 class="text-lg font-semibold">Collaborations</h2><% @engagements.first(30).each do |engagement| %><p><%= link_to engagement.title, marketing_engagement_path(engagement), class: 'underline' %> · <%= engagement.campaign.name %> · <%= engagement.status.humanize %> · Due <%= engagement.due_at&.to_fs(:short) || 'not set' %></p><% end %><% if @engagements.empty? %><p>No collaborations yet.</p><% end %><% if @engagements.length > 30 %><p>Latest 30 collaborations shown.</p><% end %></section>
  <% if Current.user.can?('marketing.contacts') %><section class="card card-pad space-y-4"><h2 class="text-lg font-semibold">Interaction log</h2><p class="text-sm text-mocha">Record conversations that happened outside Rupert. Nothing is sent from this form.</p>
    <% if Current.user.can?('marketing.write') %><%= form_with url: marketing_influencer_interactions_path(@influencer), scope: :interaction, class: 'space-y-3' do |f| %><%= f.select :kind, %w[email dm call meeting note].map { |k| [k.humanize, k] }, {}, class: 'select', 'aria-label': 'Interaction kind' %><%= f.datetime_local_field :occurred_at, value: Time.current.strftime('%Y-%m-%dT%H:%M'), class: 'input', 'aria-label': 'Occurred at', required: true %><%= f.text_area :body, rows: 3, maxlength: 5000, class: 'input w-full', 'aria-label': 'Interaction notes', required: true %><%= f.submit 'Record interaction', class: 'btn-primary' %><% end %><% end %>
    <% @interactions.each do |interaction| %><article><h3 class="font-semibold text-sm"><%= interaction.kind.humanize %> · <%= interaction.occurred_at.to_fs(:short) %></h3><p class="whitespace-pre-wrap text-sm"><%= interaction.body %></p></article><% end %><p class="text-xs">Latest 50 interactions shown.</p>
  </section><% end %>
  <%= render 'marketing/cms/history', record: @influencer %>
</div>
