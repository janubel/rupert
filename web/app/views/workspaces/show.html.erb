<%# Private workspace status: a short Detail page (docs/ui-standards.md §4). %>
<% content_for :title, 'Your private workspace' %>
<% status_pill = { 'ready' => 'pill-fern', 'failed' => 'pill-rose' }.fetch(@deployment.status, 'pill-clay') %>
<div class="page-narrow space-y-6">
  <%= page_header 'Your private workspace', subtitle: 'Your business records live in a separate customer instance with its own database and credentials.', eyebrow: 'Your workspace',
                  menu: [['Subscription', billing_path], ['Support access', support_access_path]] do %>
    <% if @deployment.status == 'ready' %><%= button_to 'Open my workspace', workspace_session_path, class: 'btn-primary' %><% elsif @deployment.status != 'failed' %><%= link_to 'Check setup progress', workspace_path, class: 'btn-primary' %><% end %>
  <% end %>

  <section class="section-card">
    <dl class="facts">
      <div><dt>Provisioning status</dt><dd><span class="<%= status_pill %>"><%= @deployment.status.humanize %></span></dd></div>
      <div><dt>Phase</dt><dd><%= @deployment.phase.humanize %></dd></div>
    </dl>
    <% if @deployment.status == 'ready' %>
      <p class="text-sm text-mocha">Your workspace is ready to open.</p>
    <% elsif @deployment.status == 'failed' %>
      <p class="text-sm text-mocha">Setup needs operator attention. Your free account remains available; your business workspace has not been opened.</p>
    <% else %>
      <p class="text-sm text-mocha">We are preparing your separate workspace on SER8. Reload this page to check progress.</p>
    <% end %>
  </section>
</div>
