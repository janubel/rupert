<% content_for :title, 'Your private workspace' %>
<section class="card card-pad mx-auto max-w-xl space-y-4"><h1 class="page-title">Your private workspace</h1><p>Provisioning status: <strong><%= @deployment.status %></strong> · <%= @deployment.phase.humanize %></p>
<% if @deployment.status == 'ready' %><p>Your business records live in a separate customer instance with its own SQLite database and credentials.</p><%= button_to 'Open my workspace', workspace_session_path, class: 'btn-primary' %><% elsif @deployment.status == 'failed' %><p>Setup needs operator attention. Your free account remains available; your business workspace has not been opened.</p><% else %><p>We are preparing your separate workspace on SER8. Reload this page to check progress.</p><%= link_to 'Check setup progress', workspace_path, class: 'btn-primary' %><% end %>
<%= link_to 'Subscription & billing', billing_path, class: 'btn-ghost' %><%= link_to 'Customer support permissions', support_access_path, class: 'btn-ghost' %></section>
