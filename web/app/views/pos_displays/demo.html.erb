<% content_for :title, 'Cashier and customer demo' %>
<div class="space-y-4"><header><h1 class="page-title">Two-screen POS demo</h1><p class="mt-2 text-sm text-mocha">Add products on the cashier side. Choose a tip on the customer side; the choice stays private until confirmation. Changing the cart requires a new customer confirmation. No payment, source sale or stock change is made.</p></header><div class="grid gap-4 lg:grid-cols-2"><section class="card overflow-hidden"><h2 class="card-pad font-semibold">1 · Cashier</h2><iframe title="Cashier POS demo" src="<%= ctrax_pos_path(location_id: @display.location_id, display_id: @display.id) %>" class="w-full border-0" style="height:760px"></iframe></section><section class="card overflow-hidden"><h2 class="card-pad font-semibold">2 · Customer · private tip choice</h2><iframe title="Customer tipping demo" src="<%= customer_display_path(display_token: @display.display_token) %>" class="w-full border-0" style="height:760px"></iframe></section></div><%= link_to 'Open customer view in another window', customer_display_path(display_token: @display.display_token), target: '_blank', rel: 'noopener noreferrer', class: 'btn-primary' %><%= link_to 'Return to retail', ctrax_pos_path(location_id: @display.location_id), class: 'btn-ghost' %></div>
