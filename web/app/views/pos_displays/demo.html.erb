<% content_for :title, 'Cashier and customer demo' %>
<div class="space-y-4">
  <%= page_header 'Two-screen POS demo', subtitle: 'Add products on the cashier side and choose a tip on the customer side; payments and stock movements are simulated.',
      menu: [['Open customer view in another window', customer_display_path(display_token: @display.display_token), { target: '_blank', rel: 'noopener noreferrer' }]] do %>
    <%= link_to 'Open retail POS', ctrax_pos_path(location_id: @display.location_id), class: 'btn-primary' %>
  <% end %>
  <%= fold_explainer('The tip choice stays private until confirmation. Confirm a tip, then run cash checkout or send a simulated card checkout to the customer. Changing the cart requires a new confirmation.', class: 'text-sm text-mocha') %>
  <div class="grid gap-4 lg:grid-cols-2">
    <section class="section-card !p-0 overflow-hidden"><h2 class="card-title p-4">1 · Cashier</h2><iframe title="Cashier POS demo" src="<%= ctrax_pos_path(location_id: @display.location_id, display_id: @display.id) %>" class="h-[1100px] w-full border-0"></iframe></section>
    <section class="section-card !p-0 overflow-hidden"><h2 class="card-title p-4">2 · Customer · private tip choice</h2><iframe title="Customer tipping demo" src="<%= customer_display_path(display_token: @display.display_token) %>" class="h-[1100px] w-full border-0"></iframe></section>
  </div>
</div>
