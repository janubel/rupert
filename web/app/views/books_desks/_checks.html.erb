<%= turbo_frame_tag 'books-desk-checks' do %>
  <% summary = check.summary; open = check.checks.reject(&:ok?).sort_by { |c| c.status == :fix ? 0 : 1 } %>
  <div class="card card-pad space-y-3">
    <p class="text-sm" role="status">
      <% if open.empty? %>
        <strong>All <%= summary[:total] %> checks pass</strong> for the last <%= check.window_days %> days: imports, payments, refunds, originals, the approval ledger and backups.
      <% else %>
        <strong><%= pluralize(summary[:fix], 'thing') %> to fix</strong> and <strong><%= summary[:watch] %> to watch</strong> out of <%= summary[:total] %> checks, last <%= check.window_days %> days.
      <% end %>
    </p>
    <% if open.any? %>
      <ul class="divide-y divide-fog">
        <% open.each do |c| %>
          <li class="desk-task py-3" data-state="<%= c.status == :fix ? 'overdue' : 'todo' %>">
            <span class="desk-glyph" aria-hidden="true"><%= c.status == :fix ? '!' : '○' %></span>
            <div class="min-w-0 flex-1">
              <p class="font-semibold"><%= c.title %> <span class="<%= c.status == :fix ? 'pill-rose' : 'pill-clay' %>"><%= c.status == :fix ? 'Fix' : 'Watch' %> · <%= c.count %></span></p>
              <p class="text-xs text-mocha"><%= c.detail %></p>
              <% if c.action %><p class="mt-1 text-xs"><%= c.action %></p><% end %>
              <% if c.path %><%= link_to 'Open', c.path, class: 'mt-1 inline-block text-sm font-semibold text-olive-deep underline', data: { turbo_frame: '_top' } %><% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
    <p class="text-xs text-mocha">Read-only audit. <%= link_to 'Open the full books check', books_check_path, class: 'underline', data: { turbo_frame: '_top' } %> for examples and a CSV.</p>
  </div>
<% end %>
