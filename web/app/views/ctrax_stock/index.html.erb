<% content_for :title, 'C-Trax stock' %>
<% menu = [] %>
<% menu << ['Open C-Trax connection', pos_connection_path('ctrax')] if Current.user.can?('settings.read') %>
<% menu << ['Open physical counts', inventory_counts_path] %>
<div class="space-y-6">
  <%= page_header 'C-Trax stock', subtitle: 'The retail count reference, read store by store from C-Trax.', menu: menu %>
  <%= fold_explainer('Negative stock is preserved and missing stock remains unknown. Each read replaces the local store snapshot after every page has been validated. C-Trax can change while pages are being read.', class: 'text-sm text-mocha') %>
  <% if @snapshots.empty? %>
    <section class="card">
      <%= empty_state 'No C-Trax stock imported yet', hint: 'Configure the connection, check access, then choose Sync stock.' do %>
        <% if Current.user.can?('settings.read') %><%= link_to 'Open C-Trax connection', pos_connection_path('ctrax'), class: 'btn-primary' %><% end %>
      <% end %>
    </section>
  <% end %>
  <% @snapshots.each do |snapshot| %>
    <section class="section-card">
      <%= section_heading snapshot.location.name, hint: "Store #{snapshot.store_id} · read started #{l(snapshot.captured_at, format: :long)} · #{pluralize(snapshot.records.size, 'variant')}" do %>
        <% if Current.user.can?('inventory.write') %><%= link_to 'Add physical count', new_inventory_count_path(location_id: snapshot.location_id), class: 'btn-ghost btn-sm' %><% end %>
      <% end %>
      <div class="table-region" role="region" tabindex="0" aria-label="<%= snapshot.location.name %> C-Trax stock">
        <table class="table">
          <thead><tr><th scope="col" class="th">Variant</th><th scope="col" class="th">SKU</th><th scope="col" class="th">C-Trax ID</th><th scope="col" class="th num">Stock</th></tr></thead>
          <tbody>
            <% snapshot.records.each do |record| %><tr><td class="td"><%= record['name'].presence || "Variant #{record['id']}" %></td><td class="td font-mono text-xs"><%= record['sku'].presence || 'Missing SKU' %></td><td class="td font-mono text-xs"><%= record['id'] %></td><td class="td num"><%= record['quantity'].nil? ? 'Unknown' : record['quantity'] %><%= ' · stock tracking unverified/off' unless record['manage_stock'] %></td></tr><% end %>
            <% if snapshot.records.empty? %><tr><td colspan="4" class="empty-row">No variants in this read.</td></tr><% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
