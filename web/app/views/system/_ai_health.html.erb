<%# opencode integration health. Counters and classifications only: no key, no message content. %>
<% h = ai_health %>
<% state_pill = { 'ok' => ['pill-fern', 'Healthy'], 'warning' => ['pill-clay', 'Needs attention'], 'error' => ['pill-rose', 'Not working'],
                  'not_configured' => ['pill-taupe', 'Not configured'], 'unknown' => ['pill-taupe', 'No check yet'] }.fetch(h[:state]) %>
<% key_label = { 'valid' => ['Valid', 'text-fern'], 'expired' => ['Expired', 'text-rose'], 'invalid' => ['Rejected', 'text-rose'],
                 'missing' => ['Not set', 'text-mocha'], 'unchecked' => ['Unknown', 'text-mocha'] }.fetch(h[:key][:state]) %>
<% model_label = { 'available' => ['Available', 'text-fern'], 'missing' => ['Not offered', 'text-rose'], 'unknown' => ['Unknown', 'text-mocha'] }.fetch(h[:model][:state]) %>
<% check = h[:last_check] %>
<% today = h[:tokens][:today] %>
<% trend = h[:tokens][:trend] %>
<% peak = [trend.map { |d| d[:tokens_in] + d[:tokens_out] + d[:tokens_reasoning] }.max.to_i, 1].max %>
<% checked_hint = if check[:checked_at]
                    "Checked #{time_ago_in_words(Time.zone.parse(check[:checked_at]))} ago#{" · #{check[:latency_ms]} ms" if check[:latency_ms]}"
                  else
                    'No provider check has run yet.'
                  end %>
<section class="section-card" id="ai-health" aria-label="AI health">
  <%= section_heading 'AI health · opencode', hint: checked_hint do %>
    <span class="<%= state_pill[0] %>"><%= state_pill[1] %></span>
    <%= button_to 'Check now', check_system_ai_health_path, method: :post, class: 'btn-ghost btn-sm' %>
  <% end %>

  <% if h[:warnings].any? %>
    <ul class="space-y-2" aria-label="AI health warnings">
      <% h[:warnings].each do |w| %>
        <% classes = case w[:severity]
                     when 'error' then 'flash-alert'
                     when 'info' then 'border-fog bg-haze text-mocha'
                     else 'border-warn-edge bg-warn-bg text-warn' end %>
        <li class="flash <%= classes %>" <%= 'role=alert' if w[:severity] == 'error' %>>
          <span class="font-semibold"><%= { 'error' => 'Problem:', 'info' => 'Note:' }.fetch(w[:severity], 'Warning:') %></span>
          <%= w[:message] %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <dl class="facts">
    <div>
      <dt>API key</dt>
      <dd class="stat-value-sm <%= key_label[1] %>"><%= key_label[0] %></dd>
      <% if h[:key][:code] %><dd class="text-xs text-taupe"><%= h[:key][:code] %></dd><% end %>
    </div>
    <div>
      <dt>Free models</dt>
      <dd class="stat-value-sm <%= h[:free_models][:count].positive? ? '' : 'text-clay' %>"><%= h[:free_models][:count] %></dd>
      <dd class="text-xs text-taupe">listed live by opencode</dd>
    </div>
    <div>
      <dt>Agent model</dt>
      <dd class="stat-value-sm <%= model_label[1] %>"><%= model_label[0] %></dd>
      <dd class="text-xs text-taupe"><%= h[:model][:id] %> · <%= h[:model][:provider] == 'go' ? 'OpenCode Go' : 'Zen' %></dd>
    </div>
    <div>
      <dt>Rate-limit hits</dt>
      <% hits = h[:rate_limits][:runs_24h] + h[:rate_limits][:checks_24h] %>
      <dd class="stat-value-sm <%= hits.positive? ? 'text-clay' : '' %>"><%= hits %></dd>
      <dd class="text-xs text-taupe">last 24 h · <%= h[:rate_limits][:runs_7d] %> agent runs in 7 d</dd>
    </div>
  </dl>

  <div class="grid gap-3 lg:grid-cols-2">
    <div class="stat">
      <p class="stat-label">Tokens today</p>
      <p class="stat-value-sm mt-1">
        <%= number_with_delimiter(today[:tokens_in]) %> <span class="text-sm text-mocha">in</span>
        · <%= number_with_delimiter(today[:tokens_out]) %> <span class="text-sm text-mocha">out</span>
      </p>
      <p class="mt-1 text-xs text-taupe">
        <%= pluralize(today[:runs], 'agent run') %> today
        <% if today[:tokens_reasoning].positive? %> · <%= number_with_delimiter(today[:tokens_reasoning]) %> reasoning<% end %>
        <% if today[:cache_read_tokens].positive? %> · <%= number_with_delimiter(today[:cache_read_tokens]) %> cached<% end %>
        · last run <%= h[:agent][:last_run_at] ? "#{time_ago_in_words(Time.zone.parse(h[:agent][:last_run_at]))} ago (#{h[:agent][:last_outcome]})" : 'never recorded' %>
      </p>
    </div>
    <div class="stat">
      <p class="stat-label">Tokens, last 7 days <span class="text-taupe">· <%= number_with_delimiter(h[:tokens][:week_total]) %></span></p>
      <div class="mt-2 flex h-16 items-end gap-1.5" role="img"
           aria-label="Tokens per day, last 7 days: <%= trend.map { |d| "#{Date.parse(d[:date]).strftime('%a')} #{d[:tokens_in] + d[:tokens_out] + d[:tokens_reasoning]}" }.join(', ') %>">
        <% trend.each do |d| %>
          <% total = d[:tokens_in] + d[:tokens_out] + d[:tokens_reasoning] %>
          <div class="flex h-full flex-1 flex-col items-center justify-end gap-1" title="<%= Date.parse(d[:date]).strftime('%b %-d') %>: <%= number_with_delimiter(total) %> tokens, <%= d[:runs] %> runs">
            <div class="w-full rounded-t bg-olive" style="height: <%= total.zero? ? 2 : [(total * 100.0 / peak).round, 4].max %>%"></div>
          </div>
        <% end %>
      </div>
      <div class="mt-1 flex gap-1.5 text-xs text-taupe" aria-hidden="true">
        <% trend.each do |d| %><span class="flex-1 text-center"><%= Date.parse(d[:date]).strftime('%a')[0, 2] %></span><% end %>
      </div>
    </div>
  </div>

  <details class="explainer text-sm">
    <summary class="explainer-summary"><%= h[:free_models][:ids].any? ? 'Free models right now' : 'About these figures' %></summary>
    <% if h[:free_models][:ids].any? %>
      <ul class="mt-2 flex flex-wrap gap-2">
        <% h[:free_models][:ids].each do |id| %><li class="pill-taupe font-mono"><%= id %></li><% end %>
      </ul>
    <% end %>
    <p class="mt-2 text-xs text-taupe"><%= h[:usage_api][:note] %> Free models have IP-level limits; the key and message content are never shown or stored here.</p>
  </details>
</section>
