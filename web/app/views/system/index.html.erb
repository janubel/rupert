<%# System health: an Overview page (docs/ui-standards.md §4). Stats first, then one card per subsystem. %>
<div class="space-y-6">
  <%= page_header 'System health',
                  subtitle: "Uptime #{distance_of_time_in_words(@system.uptime_seconds)} on #{@system.cpu_count} cores.",
                  menu: [["Updates · #{BuildInfo.current.label}", system_updates_path], ['Reload', system_path]] %>

  <% load1 = @system.load_averages[0].to_f %>
  <% load_color = load1 < @system.cpu_count ? "text-fern" : load1 < @system.cpu_count * 1.5 ? "text-clay" : "text-rose" %>
  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4" aria-label="Server resources">
    <div class="stat">
      <p class="stat-label">Load average</p>
      <p class="stat-value mt-1 <%= load_color %>"><%= load1 %></p>
      <p class="mt-1 text-xs text-taupe"><%= @system.cpu_count %> cores · <%= @system.load_averages.map { |l| l.round(2) }.join(" / ") %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Memory</p>
      <p class="stat-value mt-1"><%= @system.mem_used_mb %> MB</p>
      <p class="mt-1 text-xs text-taupe">of <%= @system.mem_total_mb %> MB used · <%= @system.mem_available_mb %> MB free</p>
      <% if @system.mem_available_mb < 200 %>
        <p class="mt-1 text-xs font-semibold text-rose">Low memory: check swap and processes</p>
      <% end %>
    </div>
    <div class="stat">
      <p class="stat-label">Swap</p>
      <p class="stat-value mt-1 <%= @system.swap_used_mb > 0 ? "text-clay" : "text-ink" %>"><%= @system.swap_used_mb %> MB</p>
      <p class="mt-1 text-xs text-taupe">of <%= @system.swap_total_mb %> MB</p>
    </div>
    <div class="stat">
      <p class="stat-label">Disk</p>
      <p class="stat-value mt-1"><%= @system.disk_used_pct %>%</p>
      <p class="mt-1 text-xs text-taupe"><%= number_with_precision(@system.disk_free_gb, precision: 1) %> GB free</p>
    </div>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div class="section-card">
      <%= section_heading 'Web server' %>
      <dl class="facts">
        <div><dt>Puma memory</dt><dd class="stat-value-sm"><%= @system.puma_rss_mb %> MB</dd></div>
        <div><dt>Puma threads</dt><dd class="stat-value-sm"><%= @system.puma_threads %></dd></div>
      </dl>
      <p class="text-xs text-taupe">If memory is tight, stop duplicate <code>rails server</code> instances; each runs a full app copy.</p>
    </div>

    <div class="section-card">
      <%= section_heading 'Background jobs' %>
      <dl class="facts">
        <div><dt>Ready</dt><dd class="stat-value-sm"><%= @system.job_pending %></dd></div>
        <div><dt>Scheduled</dt><dd class="stat-value-sm"><%= @system.job_queued %></dd></div>
        <div><dt>Failed</dt><dd class="stat-value-sm <%= @system.job_failed.positive? ? "text-rose" : "" %>"><%= @system.job_failed %></dd></div>
      </dl>
      <p class="text-xs text-taupe">Sync success rate: <span class="font-semibold text-ink"><%= @system.sync_success_rate %>%</span></p>
    </div>
  </section>

  <%= render 'system/ops_activity', activity: @ops_activity %>

  <%= render 'system/backups', backups: @backups %>

  <%= render 'system/ai_health', ai_health: @ai_health %>

  <section class="section-card">
    <%= section_heading 'Database' %>
    <dl class="facts">
      <div><dt>Connections</dt><dd class="stat-value-sm"><%= @system.db_connections %> / <%= @system.db_max_connections %></dd></div>
      <div><dt>Size</dt><dd class="stat-value-sm"><%= @system.db_size_mb %> MB</dd></div>
      <div><dt>App cache</dt><dd><%= @system.cache_entries || "n/a" %> entries · <%= @system.cache_dir_mb %> MB on disk</dd></div>
    </dl>
    <% if @sqlite[:supported] %>
      <dl class="facts">
        <div><dt>SQLite</dt><dd>Library <%= @sqlite[:sqlite_version] %> · journal <%= @sqlite[:journal_mode] %></dd></div>
        <div><dt>Lock wait</dt><dd><%= @sqlite[:configured_timeout_ms] %> ms configured</dd></div>
        <div><dt>WAL</dt><dd><%= number_to_human_size(@sqlite[:wal_bytes]) %></dd></div>
        <div><dt>Reusable space</dt><dd><%= number_to_human_size(@sqlite[:free_bytes]) %></dd></div>
      </dl>
      <p class="text-xs text-taupe"><%= link_to 'SQLite tuning, backup and scaling guide', 'https://techmore.github.io/rupert/sqlite-incus.html', class: 'underline' %></p>
    <% end %>
  </section>
</div>
