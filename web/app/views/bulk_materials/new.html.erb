<% content_for :title, 'Add material' %>
<div class="page-narrow space-y-6">
  <%= page_header 'Add material', subtitle: 'A raw material tracked by lot in Rupert\'s local ledger.' %>
  <% if @material.errors.any? %><div role="alert" class="flash flash-alert"><%= @material.errors.full_messages.to_sentence %></div><% end %>
  <%= form_with model: @material, class: 'card card-pad space-y-4' do |form| %>
    <fieldset class="space-y-4">
      <legend class="card-title">Material</legend>
      <div><%= form.label :name, class: 'field-label' %><%= form.text_field :name, required: true, maxlength: 120, class: 'input' %></div>
      <div><%= form.label :unit, 'Preferred display unit', class: 'field-label' %><%= form.select :unit, BulkMass::FACTORS.keys, {}, class: 'input' %><p class="mt-1 text-xs text-taupe">Every receipt and movement can use mg, g, kg, oz or lb. Stored balances always use integer milligrams.</p></div>
    </fieldset>
    <div class="form-actions"><%= form.submit 'Save', class: 'btn-primary', name: nil %><%= link_to 'Cancel', bulk_materials_path, class: 'btn-ghost' %></div>
  <% end %>
</div>
