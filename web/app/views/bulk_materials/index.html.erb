<% content_for :title, 'Bulk materials' %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div><h1 class="page-title">Bulk materials</h1><p class="mt-1 text-sm text-mocha">Track local bulk stock by material and lot, with receipts, consumption and an append-only movement ledger.</p></div>
    <div class="flex flex-wrap gap-3"><%= link_to 'Export ledger CSV', export_bulk_materials_path, class: 'btn-ghost' %><% if Current.user.can?('inventory.write') %><%= link_to 'New material', new_bulk_material_path, class: 'btn-primary' %><% end %></div>
  </section>
  <div class="card card-pad text-sm text-mocha">This ledger tracks bulk material inside Rupert. It does not change Shopify or Square quantities or SKUs. Weights use integer milligrams; decimal inputs round once to the nearest milligram. Automatic sale-to-gram mappings and Google Sheets synchronization are pending. Export the ledger CSV for manual import into Sheets.</div>
  <div class="card overflow-x-auto"><table class="w-full text-sm">
    <thead class="border-b border-fog bg-haze/60"><tr><th class="th" scope="col">Material</th><th class="th" scope="col">Lots</th><th class="th" scope="col">Remaining</th><th class="th" scope="col"></th></tr></thead>
    <tbody class="divide-y divide-fog">
      <% @materials.each do |material| %><tr><td class="td font-medium"><%= material.name %></td><td class="td"><%= @lot_counts.fetch(material.id, 0) %></td><td class="td"><%= bulk_mass_label(@balances.fetch(material.id, 0), material.unit) %></td><td class="td"><%= link_to 'View lots', bulk_material_path(material), class: 'text-olive hover:underline' %></td></tr><% end %>
      <% if @materials.empty? %><tr><td class="td py-8 text-center text-taupe" colspan="4">No bulk materials yet. Add a material, then receive its first lot.</td></tr><% end %>
    </tbody>
  </table></div>
  <% if @pagy.pages > 1 %><%== pagy_nav(@pagy) %><% end %>
</div>
