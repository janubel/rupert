#!/bin/sh
set -eu

app_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$app_root"

database_setting=${RUPERT_SQLITE_DATABASE_PRODUCTION-storage/production.sqlite3}
if [ -z "$database_setting" ]; then
  echo 'Refusing to run db:prepare: RUPERT_SQLITE_DATABASE_PRODUCTION is empty.' >&2
  echo 'Set it to a database file path, or explicitly set RUPERT_INITIALIZE_DATABASE=1 for a fresh installation.' >&2
  exit 1
fi

case "$database_setting" in
  /*) database_file=$database_setting ;;
  *) database_file=$app_root/$database_setting ;;
esac

if [ "${RUPERT_INITIALIZE_DATABASE:-}" = '1' ]; then
  exec "$app_root/bin/rails" db:prepare
fi

if [ ! -f "$database_file" ] || [ ! -s "$database_file" ]; then
  echo "Refusing to run db:prepare: production SQLite database is missing or empty at $database_file." >&2
  echo 'Supply a verified SQLite database copy at that path, or explicitly set RUPERT_INITIALIZE_DATABASE=1 for a fresh installation.' >&2
  exit 1
fi

header=$(dd if="$database_file" bs=1 count=15 2>/dev/null || true)
header_nul=$(dd if="$database_file" bs=1 skip=15 count=1 2>/dev/null | od -An -tu1 | tr -d '[:space:]')
if [ "$header" != 'SQLite format 3' ] || [ "$header_nul" != '0' ]; then
  echo "Refusing to run db:prepare: $database_file does not have a SQLite database header." >&2
  echo 'Supply a verified SQLite database copy, or explicitly set RUPERT_INITIALIZE_DATABASE=1 for a fresh installation.' >&2
  exit 1
fi

exec "$app_root/bin/rails" db:prepare
