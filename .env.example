# Copy to .env and fill in real values. Never commit .env.

# --- Shopify custom app credentials (sync engine) ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP_DOMAIN=m11u0i-sb.myshopify.com

# --- Shopify embedded app (OAuth) — from `shopify app info --web-env` ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_orders,read_customers
SHOPIFY_APP_URL=http://localhost:3000
HOST=http://localhost:3000

# --- Square ---
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
SQUARE_LOCATION_ID=

# --- Shopify ---
# Optional: pin the primary selling location (gid). When unset, the sync flags
# the first ACTIVE Shopify location as primary. Check Location ids on the
# Locations page or via `bin/rails runner "puts Location.where(source: 'shopify').pluck(:name, :externalId)"`.
SHOPIFY_LOCATION_ID=

# Square sandbox (optional, for testing)
# SQUARE_SANDBOX_APPLICATION_ID=
# SQUARE_SANDBOX_ACCESS_TOKEN=

# --- Authorize.net (warehouse-sale card payments) ---
AUTHORIZE_NET_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_CLIENT_KEY=
AUTHORIZE_NET_SANDBOX=1

# --- Operations ---
SYNC_MINUTES=15

# --- Platform write confirmation ---
# Sync mirrors are read-only. Outbound stock/SKU changes require explicit owner
# confirmation; legacy freeze/window values are informational, not enforcement.

# --- SQLite / queue (SER8 production selects SQLite explicitly) ---
# RUPERT_DB_ADAPTER=sqlite3
# RUPERT_SQLITE_DATABASE_PRODUCTION=/opt/rupert/web/storage/production.sqlite3
# SQLITE_BUSY_TIMEOUT_MS=5000
# JOB_THREADS=1             # default on SQLite; PostgreSQL defaults to 3
# JOB_CONCURRENCY=1

# --- Rails ---
RAILS_ENV=production
SECRET_KEY_BASE=                    # `bin/rails secret`
RAILS_ENCRYPTION_PRIMARY_KEY=       # `bin/rails db:encryption:init` — keep stable!
RAILS_ENCRYPTION_DETERMINISTIC_KEY=
RAILS_ENCRYPTION_KEY_DERIVATION_SALT=
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=1

# --- PostgreSQL ---
POSTGRES_HOST=localhost             # db inside docker-compose
POSTGRES_PORT=5432
POSTGRES_USER=rupert
POSTGRES_PASSWORD=rupert            # change in production!
POSTGRES_DB=rupert_production

# Rupert subscriptions — CSP Cyber Security Pilot Stripe account only.
# Keep disabled until test-mode checkout/webhook acceptance and rollout review.
RUPERT_BILLING_ENABLED=false
RUPERT_PUBLIC_ORIGIN=https://rupertpos.com
CSP_STRIPE_SECRET_KEY=
CSP_STRIPE_ACCOUNT_ID=
CSP_STRIPE_MONTHLY_PRICE_ID=
CSP_STRIPE_REFERRAL_COUPON_ID=
CSP_STRIPE_WEBHOOK_SECRET=
# Dedicated portal configuration; no plan changes/cancellation during commitments.
CSP_STRIPE_PORTAL_CONFIGURATION_ID=

# Comma-separated owner-approved Google mailboxes; configure privately.
# Linking these to an existing platform administrator requires the operator task.
RUPERT_OWNER_GOOGLE_EMAILS=

# SER8 control plane: enable only after installing and testing the host worker.
RUPERT_PROVISION_WORKSPACES=false
RUPERT_WORKSPACE_BASE_DOMAIN=workspaces.rupertpos.com
RUPERT_PROVISIONER_TOKEN=
# Per-customer instance values are generated by the host worker, never shared.
RUPERT_NODE_MODE=
RUPERT_WORKSPACE_ID=
RUPERT_TENANT_ID=
RUPERT_INSTANCE_HOSTNAME=
RUPERT_INSTANCE_SECRET=
RUPERT_CONTROL_PLANE_ORIGIN=
