#!/usr/bin/env bash
# Prepare a SQLite copy of the live PostgreSQL Rupert database. Read-only against PostgreSQL: it never changes the
# source, and it never switches the app over (see docs/ops/sqlite-migration.md for the cutover and rollback).
#
#   ./bin/migrate-to-sqlite
#
# Run it with the app and job worker STOPPED so the copy is a consistent point in time. Needs the production .env
# (POSTGRES_* and the RAILS_ENCRYPTION_* keys), the sqlite3 CLI, and free disk for ~2x the database.
set -euo pipefail
umask 077

cd "$(dirname "$0")/../web"
# Environment comes from ENV_FILE (e.g. /etc/rupert.env) or ../.env; if neither is readable by this user, export
# the variables yourself (the script then uses what is already in the environment).
set -a
# shellcheck disable=SC1090
for f in "${ENV_FILE:-}" ../.env; do [ -n "$f" ] && [ -r "$f" ] && { source "$f"; break; }; done
set +a

: "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}"
export RAILS_ENV=production
TARGET="${RUPERT_SQLITE_DATABASE_PRODUCTION:-storage/production.sqlite3}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/rupert}"
PGURL="postgres://${POSTGRES_USER:-rupert}:${POSTGRES_PASSWORD}@${POSTGRES_HOST:-localhost}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-rupert_production}"

command -v sqlite3 >/dev/null || { echo "install the sqlite3 CLI first (apt install sqlite3)" >&2; exit 1; }
[ -e "$TARGET" ] && { echo "$TARGET already exists; move it aside first. Nothing was changed." >&2; exit 1; }

if pgrep -f '[p]uma|[s]olid_queue|[b]in/jobs' >/dev/null 2>&1; then
  echo "WARNING: Rupert web/job processes appear to be running. Stop them for a consistent copy." >&2
  [ "${ALLOW_RUNNING:-}" = "1" ] || { echo "Re-run with ALLOW_RUNNING=1 to override (rehearsal only)." >&2; exit 1; }
fi

echo "1/4 safety dump of PostgreSQL -> $BACKUP_DIR"
install -d -m 0700 "$BACKUP_DIR"
DUMP="$BACKUP_DIR/pre-sqlite-$(date +%Y%m%d-%H%M).dump"
PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -h "${POSTGRES_HOST:-localhost}" -p "${POSTGRES_PORT:-5432}" \
  -U "${POSTGRES_USER:-rupert}" -Fc -f "$DUMP" "${POSTGRES_DB:-rupert_production}"
echo "    $(du -h "$DUMP" | cut -f1) written"

echo "2/4 creating empty SQLite database with the app schema"
export RUPERT_DB_ADAPTER=sqlite3
bundle exec bin/rails db:prepare

echo "3/4 copying rows (counts are verified; any mismatch aborts)"
if ! SOURCE_DATABASE_URL="$PGURL" bundle exec bin/rails db:postgres_to_sqlite; then
  echo "Copy failed; removing the partial SQLite file. PostgreSQL is untouched." >&2
  rm -f "$TARGET" "$TARGET-wal" "$TARGET-shm"
  exit 1
fi

echo "4/4 integrity check"
[ "$(sqlite3 "$TARGET" 'PRAGMA integrity_check')" = "ok" ] || { echo "integrity_check failed" >&2; exit 1; }

cat <<MSG

Done. $TARGET is ready; the app is still configured for PostgreSQL.
To switch: add RUPERT_DB_ADAPTER=sqlite3 to .env and start the app + jobs.
To roll back: remove that line and start again (PostgreSQL was not modified).
Safety dump kept at $DUMP
MSG
