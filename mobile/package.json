{
  "name": "rupert-employee",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android",
    "test": "node --test tests/*.test.mjs",
    "check:dependencies": "expo install --check",
    "check": "npm run check:dependencies && npm run typecheck && npm test"
  },
  "dependencies": {
    "expo": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
