{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_RUPERT_URL": "https://rupert.stoverparc.org"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_RUPERT_URL": "https://rupert.stoverparc.org"
      },
      "credentialsSource": "remote",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_RUPERT_URL": "https://rupert.stoverparc.org"
      },
      "credentialsSource": "remote",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
